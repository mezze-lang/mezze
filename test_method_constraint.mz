# Test that method-level constraint works
use std::effects::log::{println, Log, Console}

ability Show 'a where {
    show: {val: 'a} -> Str
}

impl Show Int where {
    show = {val} -> "Int"
}

# Ability with method-level constraint
ability Printer 'a where {
    print: {prefix: 'a, item: 'b} with Show 'b -> Str
}

impl Printer Str where {
    print = {prefix, item} -> "$(prefix): $(Show.show {val = item})"
}

# This should WORK - Int implements Show
let main = {} -> perform Console in do
    let result = Printer.print {prefix = "Value", item = 42}
    println {msg = result}
