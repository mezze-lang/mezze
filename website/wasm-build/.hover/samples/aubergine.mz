use std::effects::log::{ Console, println }

# An interface your own types can implement.
ability Money for 'a where {
  cents: { it: 'a } -> Int
}

type Eur = { amount: Int }

impl Money for Eur where {
  cents = { it } -> it.amount
}

let main = {} -> perform Console in
  println { msg = { amount = 1299 }.cents {}.to_str {} }