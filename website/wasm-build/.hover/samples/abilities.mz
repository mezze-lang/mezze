use std::effects::log::{ Console, println }
use std::int

ability Priced for 'a where {
  cents: { it: 'a } -> Int
}

type Book = { price: Int }

impl Priced for Book where {
  cents = { it } -> it.price
}

let main = {} -> perform Console in
  println { msg = int::to_str {n = { price = 1299 }.cents {}} }