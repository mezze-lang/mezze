---
import Base from '../layouts/Base.astro'
import Mascot from '../components/Mascot.astro'
import Tag from '../components/Tag.astro'
import Prose from '../components/Prose.astro'
import { hero, topics, playground, features } from '../data/content'
import { highlight } from '../lib/highlight'
---
<Base title="Mezze">
  <div class="shell">
    <div class="page">

      <section class="hero">
        <div>
          <Prose as="h1" text={hero.headline} />
          <p class="lede">{hero.lede}</p>
          <div class="cta">
            <a class="btn btn-primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
          </div>
          <p class="micro">{hero.footnote}</p>
        </div>
        <div class="hero-mascot"><Mascot size={168} /></div>
      </section>

      <section class="tags">
        {topics.map((t) => <Tag colour={t.colour}>{t.label}</Tag>)}
      </section>

      <section class="play">
        <div class="playbar">
          <span class="tabs">
            {playground.tabs.map((t, i) => (
              <button class:list={['tab', { on: i === 0 }]} data-idx={i}>{t.label}</button>
            ))}
          </span>
          <button class="run">▶ Run</button>
        </div>
        <pre class="code"><code id="panel-code" set:html={highlight(playground.tabs[0].code)} /></pre>
        <div class="out"><span class="dot"></span><span id="panel-msg">Press Run.</span></div>
      </section>

      <section class="feats">
        {features.map((f) => (
          <article>
            <Prose as="h3" text={f.title} />
            <p>{f.body}</p>
          </article>
        ))}
      </section>

      <section class="states">
        <span class="st ok">✓ 3 tests passed</span>
        <span class="st warn">! LoomAsync not available in the browser</span>
        <span class="st note">◆ 2 effects handled</span>
        <span class="st err">✕ Cannot use '+' with Str, Int</span>
        <span class="st info">ⓘ typechecked in 34ms</span>
        <span class="st dbg">⟐ inferred Str -> Int</span>
      </section>


    </div>
  </div>

  <script>
    import { playground } from '../data/content'
    import { highlight } from '../lib/highlight'
    import { prewarmMezze } from '../scripts/mezze-runtime'
    import hovers from '../data/hovers.json'

    // Nothing here needs the runtime, but the tour is one click away.
    prewarmMezze()

    // The panel replays each sample's recorded output rather than compiling.
    // Every one of these was run through the real compiler; the tour is where
    // code is actually editable and executed.
    const codeEl = document.getElementById('panel-code') as HTMLElement
    const msgEl = document.getElementById('panel-msg') as HTMLElement
    const runBtn = document.querySelector('.run') as HTMLButtonElement
    const tabs = Array.from(document.querySelectorAll('.tab')) as HTMLElement[]

    let current = 0
    const IDLE = 'Press Run.'

    const select = (i: number) => {
      current = i
      codeEl.innerHTML = highlight(playground.tabs[i].code)
      msgEl.textContent = IDLE
    }

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('on'))
        tab.classList.add('on')
        select(Number(tab.dataset.idx))
      }),
    )

    // ---- hover types ------------------------------------------------------
    // Types were extracted at build time by wasm-build/hovers.sh, using the
    // same lookup the tour does — so the landing page gets real inferred types
    // without downloading the runtime.
    const tip = document.createElement('div')
    tip.className = 'hover-tip'
    tip.hidden = true
    document.body.appendChild(tip)

    // Must match the sample filenames hovers.sh writes, which come from the
    // tab labels lowercased.
    const TAB_KEYS = playground.tabs.map((t) => t.label.toLowerCase())
    const hideTip = () => { tip.hidden = true }

    /**
     * 1-based (line, col) under the pointer, or null.
     *
     * Asks the browser which character is under the cursor rather than doing
     * the arithmetic: the highlighter wraps tokens in spans and the <pre> has
     * padding, so measuring from the element box lands on the wrong column.
     */
    const posAt = (x: number, y: number): [number, number] | null => {
      const doc = document as Document & {
        caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null
      }
      const caret = doc.caretPositionFromPoint?.(x, y)
      if (!caret || !codeEl.contains(caret.offsetNode)) return null

      // Count text before this node to recover the offset into the whole sample.
      const walker = document.createTreeWalker(codeEl, NodeFilter.SHOW_TEXT)
      let offset = 0
      let node: Node | null
      while ((node = walker.nextNode())) {
        if (node === caret.offsetNode) {
          offset += caret.offset
          break
        }
        offset += node.textContent?.length ?? 0
      }
      if (!node) return null

      const before = (codeEl.textContent ?? '').slice(0, offset)
      const line = before.split('\n').length
      const col = offset - before.lastIndexOf('\n')
      return [line, col]
    }

    codeEl.addEventListener('mousemove', (e) => {
      const p = posAt(e.clientX, e.clientY)
      if (!p) return hideTip()
      const map = (hovers as Record<string, Record<string, string>>)[TAB_KEYS[current]]
      const t = map?.[p[0] + ':' + p[1]]
      if (!t) return hideTip()
      const i = t.indexOf(' : ')
      // The type is Mezze, so run it through the same highlighter as the code.
      tip.innerHTML = i > 0
        ? `<code class="ht-name">${t.slice(0, i)}</code>` +
          `<code class="ht-sep"> : </code>` +
          `<code>${highlight(t.slice(i + 3))}</code>`
        : `<code>${highlight(t)}</code>`
      tip.style.left = e.clientX + 12 + 'px'
      tip.style.top = e.clientY + 18 + 'px'
      tip.hidden = false
    })
    codeEl.addEventListener('mouseleave', hideTip)

    runBtn.disabled = false
    runBtn.addEventListener('click', () => {
      msgEl.textContent = 'running…'
      // A beat of delay so pressing Run feels like it did something.
      setTimeout(() => {
        msgEl.textContent = playground.tabs[current].output
      }, 180)
    })
  </script>
</Base>
