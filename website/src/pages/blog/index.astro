---
/** Blog index. Drafts show in dev only — see lib/posts. */
import { posts } from '../../lib/posts'
import Base from '../../layouts/Base.astro'

const entries = await posts()

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---
<Base title="Blog — Mezze" description="Notes on building Mezze.">
  <div class="page blog-index">
    <header class="blog-head">
      <h1>Blog</h1>
      <p class="lede">Notes on building the language.</p>
    </header>

    {entries.length === 0 && <p class="micro">Nothing published yet.</p>}

    <ul class="post-list">
      {entries.map((p) => (
        <li class="post-card" style={p.data.colour ? `--c: var(--${p.data.colour})` : undefined}>
          <a href={`/blog/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <h2>{p.data.title}</h2>
            <p>{p.data.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<script>
  // The taste is one click away and needs a 55MB runtime. Start filling the
  // HTTP cache now so it is warm on arrival.
  import { prewarmMezze } from '../../scripts/mezze-runtime'
  // A post may embed an editor, so aiming at one is a signal of intent — as is
  // aiming at the taste from the nav.
  prewarmMezze('a[href^="/taste"], a[href^="/blog/"]')
</script>
