---
/**
 * The Mezze mascot — the olive.
 *
 * The site's identity is fixed to the olive. The mascot is decorative: it does
 * not cycle and clicking does nothing. (The full dish set still lives in
 * data/dishes as the icon/palette registry; the hero just no longer walks it.)
 *
 *   <Mascot />            inline, 22px
 *   <Mascot size={168} /> hero
 *
 * `static` is accepted for call-site compatibility and has no effect — every
 * mascot is static now.
 */
import { dishes } from '../data/dishes'

interface Props {
  size?: number
  static?: boolean
  class?: string
}
const { size = 22, class: cls = '' } = Astro.props
const olive = dishes[0]
---
<span
  class:list={['mascot', 'is-static', cls]}
  style={`--s:${size}px`}
  aria-hidden="true"
>
  <img src={olive.icon} alt="" data-dish={olive.key} class="on" loading="eager" />
</span>
