---
/**
 * The Mezze mascot.
 *
 * All six dishes are rendered; one is shown at a time. A dish is chosen at
 * random on load, and clicking advances to the next — the primary colour
 * changes with it, so the character and the interface always match.
 *
 *   <Mascot />            inline, 22px
 *   <Mascot size={120} /> hero
 *   <Mascot static />     no click handler (decorative use)
 */
import { dishes } from '../data/dishes'

interface Props {
  size?: number
  static?: boolean
  class?: string
}
const { size = 22, static: isStatic = false, class: cls = '' } = Astro.props
const Tag = isStatic ? 'span' : 'button'
---
<!-- A span when static: nesting a <button> inside the header <a> is invalid
     HTML, and the button swallowed the click so the brand never navigated. -->
<Tag
  class:list={['mascot', cls, { 'is-static': isStatic }]}
  style={`--s:${size}px`}
  type={isStatic ? undefined : 'button'}
  data-mascot
  aria-label={isStatic ? undefined : 'Change the dish'}
  title={isStatic ? undefined : 'Click for a different dish'}
  aria-hidden={isStatic ? 'true' : undefined}
>
  {dishes.map((d, i) => (
    <img src={d.icon} alt={isStatic ? '' : d.label} data-dish={d.key} data-idx={i}
         class:list={{ on: i === 0 }} loading="eager" />
  ))}
</Tag>

{/* Generated from the dish list so the pre-paint state and the palette cannot
    drift apart. The inline script in Base sets data-dish before first paint;
    these rules make that visible without waiting for hydration. */}
<style is:global set:html={dishes.map((d, i) =>
  i === 0 ? "" : `
    :root[data-dish="${i}"] { --primary: ${d.primary}; --on-primary: ${d.onPrimary}; }
    :root[data-dish="${i}"] .mascot img[data-idx="0"] { opacity: 0; }
    :root[data-dish="${i}"] .mascot img[data-idx="${i}"] { opacity: 1; }
  `).join("")} />

