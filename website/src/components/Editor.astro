---
/**
 * A Mezze editor: toolbar, highlighted source, output pane.
 *
 * Self-contained — it loads the runtime, wires its own buttons, and exposes
 * the element via a `mezze-editor` CustomEvent so a host page can set the
 * source without reaching into its internals.
 *
 * Controls stay disabled until the runtime actually reports in, so nothing is
 * clickable while the 55MB bundle is still arriving.
 */
interface Props {
  /** Initial source. A host page can replace it later via setSource(). */
  code?: string
  /** Shown in the output pane before the runtime is up. */
  placeholder?: string
  /**
   * Lock the source. The snippet still runs and checks, but the reader cannot
   * change it — for places where the text around it describes the exact code
   * on screen and an edit would make the prose wrong. Format is hidden too,
   * since there is nothing to reformat.
   */
  readonly?: boolean
}
const { code = '', placeholder = 'Waiting for the Mezze runtime…', readonly = false } = Astro.props
---
<div class:list={["ed", readonly && "ed-readonly"]} data-editor>
  <div class="ed-bar">
    <button data-act="run" disabled>Run</button>
    <button data-act="check" disabled>Check</button>
    {!readonly && <button data-act="fmt" disabled>Format</button>}
    <span class="ed-status">loading runtime…</span>
  </div>
  <div class="ed-editor">
    <pre class="ed-hl" aria-hidden="true"><code class="ed-code"></code></pre>
    <textarea class="ed-src" spellcheck="false" autocomplete="off"
              autocorrect="off" autocapitalize="off" readonly={readonly}>{code}</textarea>
  </div>
  <pre class="ed-out">{placeholder}</pre>
</div>

<style is:global>
  /* Global rather than scoped: the hover tooltip is appended to <body>,
     outside this component's DOM, so a scoped rule would not reach it. */
  /* Overlay scrollbars: the track sits over the content and fades in while
     scrolling rather than reserving a permanent gutter. Matters on macOS with
     "always show scrollbars", where a classic bar is visible even at rest and
     the two stacked layers reserve different widths, shifting them apart. */
  .ed ::-webkit-scrollbar { width: 8px; height: 8px; }
  .ed ::-webkit-scrollbar-track { background: transparent; }
  .ed ::-webkit-scrollbar-thumb { background: transparent; border-radius: 4px; }
  .ed:hover ::-webkit-scrollbar-thumb,
  .ed :focus-within::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--soft) 45%, transparent); }
  .ed ::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--soft) 70%, transparent); }
  /* Firefox has no overlay mode; thin + transparent track is the closest. */
  .ed .ed-src, .ed .ed-hl, .ed .ed-out { scrollbar-width: thin; scrollbar-color: transparent transparent; }
  .ed:hover .ed-src, .ed:hover .ed-hl, .ed:hover .ed-out { scrollbar-color: color-mix(in srgb, var(--soft) 45%, transparent) transparent; }

  .ed { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; min-width: 0; border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; background: var(--panel); }
  /* Wraps: three buttons plus the status text do not fit a phone's width, and
     an unwrapped row pushed "loading runtime…" off the edge — exactly the
     message that explains why the buttons are not usable yet. */
  .ed-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; padding: .55rem .75rem; border-bottom: 1px solid var(--rule); flex: none; }
  .ed-bar button { font: inherit; font-size: .88rem; padding: .25rem .85rem; border: 1px solid color-mix(in srgb, var(--primary) 32%, var(--rule)); border-radius: 5px; background: var(--ground); color: var(--primary); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
  .ed-bar button:hover:not(:disabled) { background: color-mix(in srgb, var(--primary) 10%, var(--ground)); border-color: var(--primary); }
  .ed-bar button[data-act="run"] { background: var(--primary); border-color: var(--primary); color: var(--on-primary); font-weight: 600; }
  .ed-bar button[data-act="run"]:hover:not(:disabled) { background: color-mix(in srgb, var(--primary) 86%, #000); }
  /* Not just faded: pointer-events off so a tap cannot land on a control that
     does nothing yet. On a phone there is no hover to reinforce the state and
     .45 alpha reads as "dim", not "off", so the greying is stronger too and
     the button loses its accent colour while the runtime is still arriving. */
  .ed-bar button:disabled {
    opacity: .38;
    cursor: default;
    pointer-events: none;
    background: var(--ground);
    border-color: var(--rule);
    color: var(--soft);
  }
  .ed-bar button[data-act="run"]:disabled {
    background: var(--ground);
    border-color: var(--rule);
    color: var(--soft);
  }
  .ed-status { margin-left: auto; font-size: .8rem; color: var(--soft); }
  /* Once the bar wraps, margin-left:auto would strand the status on its own
     line hard right. Let it sit under the buttons instead. */
  @media (max-width: 460px) {
    .ed-status { margin-left: 0; width: 100%; }
  }

  /* min-height holds the panel open so switching tabs does not resize it.
     Sized to the longest sample. Without it, every sample had to be padded
     with trailing blank lines to a common length, which put stray whitespace
     into the code the reader sees. 21 lines at line-height 1.6 on .84rem
     text, plus the .9rem padding above and below. */
  .ed-editor { position: relative; flex: 1 1 auto; min-height: calc(21 * 1.6 * .84rem + 1.8rem); min-width: 0; }

  /* CRITICAL: both layers must agree on every metric that affects glyph
     position, or the highlight drifts from the text. No word-break — that
     wraps the two layers differently. */
  .ed-hl, .ed-src {
    margin: 0;
    padding: .9rem 1rem;
    border: 0;
    font-family: var(--mono);
    font-size: .84rem;
    line-height: 1.6;
    tab-size: 2;
    /* Wrap rather than scroll sideways — but only at whitespace. break-word
       splits mid-token, which makes a long string literal look cut in half. */
    white-space: pre-wrap;
    overflow-wrap: normal;
    letter-spacing: 0;
  }
  .ed-hl { position: absolute; inset: 0; overflow-y: auto; overflow-x: hidden; pointer-events: none; color: var(--ink); }
  .ed-hl code { font: inherit; background: none; padding: 0; }
  .ed-src {
    position: absolute; inset: 0; width: 100%; height: 100%;
    resize: none; background: transparent; color: transparent;
    caret-color: var(--ink); overflow-y: auto; overflow-x: hidden;
  }
  .ed-src:focus { outline: none; }
  .ed-src::selection { background: color-mix(in srgb, var(--primary) 30%, transparent); }



  .ed-out {
    margin: 0; padding: .85rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--surface);
    font-family: var(--mono);
    font-size: .82rem; line-height: 1.55;
    white-space: pre-wrap; color: var(--soft);
    overflow: auto;
    flex: none; height: 9.5rem;
  }
  .ed-out.ok { color: var(--ok); }
  .ed-out.err { color: var(--err); }
  .ed-out.warn { color: var(--warn); }</style>

<script>
  // Ships with the component so an editor works wherever it is embedded — a
  // blog post does not have to know to wire it up. Pages that drive the editor
  // (the taste) call mountEditor themselves; this skips anything already mounted.
  import { autoMountEditors } from '../scripts/editor'
  autoMountEditors()
</script>
