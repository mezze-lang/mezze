---
interface Props {
  title: string
  description?: string
}
const { title, description = 'Mezze — a statically typed functional language with algebraic effects.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header>
      <a href="/" class="brand">Mezze</a>
      <nav>
        <a href="/tour">Tour</a>
        <a href="/docs">Docs</a>
        <a href="/blog">Blog</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Mezze</footer>

    <style is:global>
      /* Catppuccin Latte (light) / Macchiato (dark).
         Values taken verbatim from catppuccin/palette. */
      :root {
        --bg:      #eff1f5;  /* base */
        --panel:   #e6e9ef;  /* mantle */
        --fg:      #4c4f69;  /* text */
        --muted:   #6c6f85;  /* subtext0 */
        --line:    #ccd0da;  /* surface0 */
        --accent:  #8839ef;  /* mauve */
        --ok:      #40a02b;  /* green */
        --err:     #d20f39;  /* red */
        --warn:    #df8e1d;  /* yellow */

        /* syntax */
        --syn-kw:   #8839ef;  /* mauve   — keywords */
        --syn-str:  #40a02b;  /* green   — strings */
        --syn-num:  #fe640b;  /* peach   — numbers */
        --syn-bool: #fe640b;  /* peach   — True/False */
        --syn-com:  #9ca0b0;  /* overlay0 — comments */
        --syn-ctor: #df8e1d;  /* yellow  — types & constructors */
        --syn-tv:   #179299;  /* teal    — 'typevars */
        --syn-eff:  #ea76cb;  /* pink    — effect rows */
        --syn-fn:   #1e66f5;  /* blue    — bindings */
        --syn-mth:    #1e66f5;  /* blue     — .dot_methods */
        --syn-fld:    #7287fd;  /* lavender — record fields */
        --syn-interp: #ea76cb;  /* pink     — $( ) delimiters */
      }

      :root:not([data-theme='light']) {
        @media (prefers-color-scheme: dark) {
          --bg:      #24273a;  /* base */
          --panel:   #1e2030;  /* mantle */
          --fg:      #cad3f5;  /* text */
          --muted:   #a5adcb;  /* subtext0 */
          --line:    #363a4f;  /* surface0 */
          --accent:  #c6a0f6;  /* mauve */
          --ok:      #a6da95;  /* green */
          --err:     #ed8796;  /* red */
          --warn:    #eed49f;  /* yellow */

          --syn-kw:   #c6a0f6;
          --syn-str:  #a6da95;
          --syn-num:  #f5a97f;
          --syn-bool: #f5a97f;
          --syn-com:  #6e738d;
          --syn-ctor: #eed49f;
          --syn-tv:   #8bd5ca;
          --syn-eff:  #f5bde6;
          --syn-fn:   #8aadf4;
          --syn-mth:    #8aadf4;
          --syn-fld:    #b7bdf8;
          --syn-interp: #f5bde6;
        }
      }

      :root[data-theme='dark'] {
        --bg:      #24273a;
        --panel:   #1e2030;
        --fg:      #cad3f5;
        --muted:   #a5adcb;
        --line:    #363a4f;
        --accent:  #c6a0f6;
        --ok:      #a6da95;
        --err:     #ed8796;
        --warn:    #eed49f;

        --syn-kw:   #c6a0f6;
        --syn-str:  #a6da95;
        --syn-num:  #f5a97f;
        --syn-bool: #f5a97f;
        --syn-com:  #6e738d;
        --syn-ctor: #eed49f;
        --syn-tv:   #8bd5ca;
        --syn-eff:  #f5bde6;
        --syn-fn:   #8aadf4;
        --syn-mth:    #8aadf4;
        --syn-fld:    #b7bdf8;
        --syn-interp: #f5bde6;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
        line-height: 1.6;
      }
      header {
        display: flex;
        align-items: baseline;
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem;
      }
      .brand { font-weight: 600; font-size: 1.15rem; text-decoration: none; color: var(--fg); }
      header nav { margin-left: auto; display: flex; gap: 1.25rem; }
      header nav a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
      header nav a:hover { color: var(--accent); }
      main { max-width: 1100px; margin: 0 auto; padding: 0 1.25rem 4rem; }
      footer {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.25rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.85rem;
      }
      h1 { font-size: 2.1rem; line-height: 1.2; margin: 1rem 0 0.5rem; }
      h2 { font-size: 1.25rem; margin: 2.5rem 0 0.75rem; }
      p.lede { font-size: 1.1rem; color: var(--muted); margin: 0 0 2rem; max-width: 46rem; }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
    </style>
  </body>
</html>
