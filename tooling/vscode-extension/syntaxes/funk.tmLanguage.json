{
  "name": "Funk",
  "scopeName": "source.funk",
  "fileTypes": ["funk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#module-declarations" },
    { "include": "#let-binding" },
    { "include": "#type-declaration" },
    { "include": "#effect-declaration" },
    { "include": "#ability-declaration" },
    { "include": "#impl-declaration" },
    { "include": "#impl-ability-declaration" },
    { "include": "#match-expression" },
    { "include": "#lambda-expression" },
    { "include": "#do-expression" },
    { "include": "#perform-expression" },
    { "include": "#if-expression" },
    { "include": "#control-keywords" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#qualified-identifier" },
    { "include": "#constructor-names" },
    { "include": "#type-variables" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.funk",
      "match": "#.*$"
    },
    "module-declarations": {
      "patterns": [
        {
          "match": "\\b(use|pub)\\s+([a-z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)*)(?:\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.funk" },
            "2": { "name": "entity.name.namespace.funk" },
            "3": { "name": "keyword.control.as.funk" },
            "4": { "name": "entity.name.type.alias.funk" }
          }
        }
      ]
    },
    "let-binding": {
      "begin": "\\b(pub\\s+)?(let)\\s+([a-z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.funk" },
        "2": { "name": "keyword.declaration.let.funk" },
        "3": { "name": "entity.name.function.funk" }
      },
      "end": "(?=\\n(?!\\s))|(?=^[a-z])|(?=^(pub\\s+)?(let|type|effect|ability|impl)\\s)",
      "patterns": [
        { "include": "#type-annotation" },
        { "include": "#comments" },
        { "include": "#expression-contents" }
      ]
    },
    "type-declaration": {
      "begin": "\\b(pub\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)\\s*('(?:[a-zA-Z][a-zA-Z0-9_]*))*\\s*(=)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.funk" },
        "2": { "name": "keyword.declaration.type.funk" },
        "3": { "name": "entity.name.type.funk" },
        "4": { "name": "variable.parameter.type.funk" },
        "5": { "name": "keyword.operator.assignment.funk" }
      },
      "end": "(?=\\n(?!\\s))|(?=^[a-zA-Z])",
      "patterns": [
        { "include": "#type-variables" },
        { "include": "#variant-type" },
        { "include": "#record-type" },
        { "include": "#comments" }
      ]
    },
    "variant-type": {
      "begin": "\\|",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.variant.begin.funk" }
      },
      "end": "\\|",
      "endCaptures": {
        "0": { "name": "punctuation.definition.variant.end.funk" }
      },
      "patterns": [
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.constructor.funk" }
          }
        },
        { "include": "#record-type" },
        { "include": "#comments" },
        {
          "name": "punctuation.separator.variant.funk",
          "match": ","
        },
        {
          "name": "keyword.operator.spread.funk",
          "match": "\\.\\.\\."
        }
      ]
    },
    "effect-declaration": {
      "begin": "\\b(pub\\s+)?(effect)\\s+([A-Z][a-zA-Z0-9_]*)\\s*({)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.funk" },
        "2": { "name": "keyword.declaration.effect.funk" },
        "3": { "name": "entity.name.type.effect.funk" },
        "4": { "name": "punctuation.definition.block.begin.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.funk" }
      },
      "patterns": [
        { "include": "#effect-operation" },
        { "include": "#comments" }
      ]
    },
    "effect-operation": {
      "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "entity.name.function.effect-operation.funk" },
        "2": { "name": "punctuation.separator.type.funk" }
      }
    },
    "ability-declaration": {
      "begin": "\\b(pub\\s+)?(ability)\\s+([A-Z][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.funk" },
        "2": { "name": "keyword.declaration.ability.funk" },
        "3": { "name": "entity.name.type.ability.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.funk" }
      },
      "patterns": [
        { "include": "#type-variables" },
        { "include": "#ability-dependencies" },
        { "include": "#ability-operation" },
        { "include": "#comments" },
        {
          "match": "\\b(where)\\s*({)",
          "captures": {
            "1": { "name": "keyword.control.where.funk" },
            "2": { "name": "punctuation.definition.block.begin.funk" }
          }
        }
      ]
    },
    "ability-dependencies": {
      "begin": "\\b(with)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.with.funk" }
      },
      "end": "(?=where|{)",
      "patterns": [
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.ability.funk" }
          }
        },
        { "include": "#type-variables" },
        { "include": "#comments" }
      ]
    },
    "ability-operation": {
      "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "entity.name.function.ability-operation.funk" },
        "2": { "name": "punctuation.separator.type.funk" }
      }
    },
    "impl-declaration": {
      "begin": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)\\s+(for)\\s+([A-Z][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.impl.funk" },
        "2": { "name": "entity.name.type.effect.funk" },
        "3": { "name": "keyword.control.for.funk" },
        "4": { "name": "entity.name.type.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.funk" }
      },
      "patterns": [
        { "include": "#performer-operation" },
        { "include": "#comments" },
        {
          "match": "\\b(where)\\s*({)",
          "captures": {
            "1": { "name": "keyword.control.where.funk" },
            "2": { "name": "punctuation.definition.block.begin.funk" }
          }
        }
      ]
    },
    "impl-ability-declaration": {
      "begin": "\\b(impl)\\s+([A-Z][a-zA-Z0-9_]*)\\s+([A-Z][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.impl.funk" },
        "2": { "name": "entity.name.type.ability.funk" },
        "3": { "name": "entity.name.type.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.funk" }
      },
      "patterns": [
        { "include": "#performer-operation" },
        { "include": "#comments" },
        {
          "match": "\\b(where)\\s*({)",
          "captures": {
            "1": { "name": "keyword.control.where.funk" },
            "2": { "name": "punctuation.definition.block.begin.funk" }
          }
        }
      ]
    },
    "performer-operation": {
      "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
      "captures": {
        "1": { "name": "entity.name.function.performer-operation.funk" },
        "2": { "name": "punctuation.separator.type.funk" }
      }
    },
    "match-expression": {
      "begin": "\\b(match)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.match.funk" }
      },
      "end": "(?=\\n(?!\\s*[A-Z_a-z|]))",
      "patterns": [
        {
          "match": "\\b(is)\\b",
          "name": "keyword.control.is.funk"
        },
        {
          "match": "\\b(if)\\b",
          "name": "keyword.control.if.funk"
        },
        { "include": "#pattern" },
        { "include": "#expression-contents" }
      ]
    },
    "pattern": {
      "patterns": [
        {
          "name": "constant.language.wildcard.funk",
          "match": "\\b_\\b"
        },
        {
          "match": "([A-Z][a-zA-Z0-9_]*)(?=\\s*{)",
          "captures": {
            "1": { "name": "entity.name.type.constructor.pattern.funk" }
          }
        },
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.constructor.funk" }
          }
        },
        { "include": "#record-pattern" }
      ]
    },
    "record-pattern": {
      "begin": "{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.record.begin.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.record.end.funk" }
      },
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.field.funk" },
            "2": { "name": "keyword.operator.assignment.funk" }
          }
        },
        { "include": "#pattern" },
        { "include": "#comments" }
      ]
    },
    "lambda-expression": {
      "patterns": [
        {
          "match": "(->)",
          "captures": {
            "1": { "name": "storage.type.function.arrow.funk" }
          }
        }
      ]
    },
    "do-expression": {
      "begin": "\\b(do)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.do.funk" }
      },
      "end": "(?=\\n(?!\\s))",
      "patterns": [
        { "include": "#expression-contents" }
      ]
    },
    "perform-expression": {
      "begin": "\\b(perform)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.perform.funk" }
      },
      "end": "\\b(in)\\b",
      "endCaptures": {
        "1": { "name": "keyword.control.in.funk" }
      },
      "patterns": [
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.effect.funk" }
          }
        },
        { "include": "#expression-contents" }
      ]
    },
    "if-expression": {
      "patterns": [
        {
          "match": "\\b(if|then|else)\\b",
          "name": "keyword.control.conditional.funk"
        }
      ]
    },
    "control-keywords": {
      "name": "keyword.control.funk",
      "match": "\\b(if|then|else|match|is|do|in)\\b"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.funk",
          "match": "\\b(let|type|effect|impl|ability)\\b"
        },
        {
          "name": "storage.modifier.visibility.funk",
          "match": "\\b(pub)\\b"
        },
        {
          "name": "keyword.control.funk",
          "match": "\\b(for|where|perform|with|as|use)\\b"
        }
      ]
    },
    "type-annotation": {
      "begin": ":",
      "beginCaptures": {
        "0": { "name": "punctuation.separator.type.funk" }
      },
      "end": "(?==)|(?=\\n(?!\\s*->|\\s*<|\\s*with))",
      "patterns": [
        { "include": "#type-signature" }
      ]
    },
    "type-signature": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.funk",
          "match": "->"
        },
        {
          "name": "keyword.operator.double-slash.funk",
          "match": "//"
        },
        { "include": "#effect-row" },
        { "include": "#ability-constraints" },
        { "include": "#record-type" },
        { "include": "#array-type" },
        {
          "name": "entity.name.type.funk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        { "include": "#type-variables" },
        {
          "name": "punctuation.definition.typeparameters.funk",
          "match": "[{}\\[\\](),|]"
        },
        { "include": "#comments" }
      ]
    },
    "effect-row": {
      "begin": "<",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.effect-row.begin.funk" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.effect-row.end.funk" }
      },
      "patterns": [
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.effect.funk" }
          }
        },
        {
          "name": "punctuation.separator.effect.funk",
          "match": ","
        }
      ]
    },
    "ability-constraints": {
      "begin": "\\b(with)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.with.funk" }
      },
      "end": "(?=\\n|=)",
      "patterns": [
        {
          "match": "([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.ability.funk" }
          }
        },
        { "include": "#type-variables" },
        {
          "name": "punctuation.separator.ability.funk",
          "match": ","
        }
      ]
    },
    "record-type": {
      "begin": "{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.record.begin.funk" }
      },
      "end": "}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.record.end.funk" }
      },
      "patterns": [
        {
          "match": "([a-z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.field.funk" },
            "2": { "name": "punctuation.separator.type.funk" }
          }
        },
        {
          "name": "keyword.operator.spread.funk",
          "match": "\\.\\.\\."
        },
        { "include": "#type-signature" },
        { "include": "#comments" }
      ]
    },
    "array-type": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.funk" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.funk" }
      },
      "patterns": [
        { "include": "#type-signature" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.funk",
          "match": "->"
        },
        {
          "name": "keyword.operator.double-colon.funk",
          "match": "::"
        },
        {
          "name": "keyword.operator.pipe.funk",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.funk",
          "match": "==|!=|<=|>=|<(?!>)|>(?!<)"
        },
        {
          "name": "keyword.operator.assignment.funk",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.funk",
          "match": "\\+\\+|\\+|(?<!-)\\*|/(?!/)|//|%"
        },
        {
          "name": "keyword.operator.logical.funk",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.spread.funk",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.placeholder.funk",
          "match": "@"
        },
        {
          "name": "keyword.operator.wildcard.funk",
          "match": "\\b_\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.funk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.funk",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.funk",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.funk",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.funk",
      "match": "\\b(true|false)\\b"
    },
    "qualified-identifier": {
      "match": "\\b([a-z_][a-zA-Z0-9_]*)((?:::[a-zA-Z_][a-zA-Z0-9_]*)+)",
      "captures": {
        "1": { "name": "entity.name.namespace.funk" },
        "2": { "name": "entity.name.function.qualified.funk" }
      }
    },
    "constructor-names": {
      "name": "entity.name.type.constructor.funk",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "type-variables": {
      "name": "variable.parameter.type.funk",
      "match": "'[a-zA-Z][a-zA-Z0-9_]*\\b"
    },
    "identifiers": {
      "name": "variable.other.funk",
      "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
    },
    "expression-contents": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#operators" },
        { "include": "#qualified-identifier" },
        { "include": "#constructor-names" },
        { "include": "#type-variables" },
        { "include": "#identifiers" }
      ]
    }
  }
}
