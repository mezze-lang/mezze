{
  "name": "funk-language",
  "displayName": "Funk Language Support",
  "description": "Syntax highlighting and language support for the Funk programming language",
  "version": "0.1.0",
  "publisher": "funk-lang",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Syntax Highlighters"
  ],
  "keywords": [
    "funk",
    "functional",
    "effects",
    "programming",
    "language"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "funk",
        "aliases": [
          "Funk",
          "funk"
        ],
        "extensions": [
          ".funk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/funk-light.svg",
          "dark": "./icons/funk-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "funk",
        "scopeName": "source.funk",
        "path": "./syntaxes/funk.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Funk Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/funk-dark.json"
      },
      {
        "label": "Funk Light", 
        "uiTheme": "vs",
        "path": "./themes/funk-light.json"
      }
    ],
    "snippets": [
      {
        "language": "funk",
        "path": "./snippets/funk.json"
      }
    ],
    "commands": [
      {
        "command": "funk.showExamples",
        "title": "Show Funk Examples",
        "category": "Funk"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:funk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/funk-lang/funk"
  },
  "bugs": {
    "url": "https://github.com/funk-lang/funk/issues"
  },
  "homepage": "https://github.com/funk-lang/funk#readme",
  "license": "MIT",
  "devDependencies": {},
  "dependencies": {}
}

