{
  "name": "mezze-language",
  "displayName": "Mezze Language Support",
  "description": "Comprehensive syntax highlighting and language support for the Mezze functional programming language with algebraic effects",
  "version": "0.3.1",
  "publisher": "mezze-lang",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "mezze",
    "functional",
    "effects",
    "algebraic-effects",
    "type-inference",
    "pattern-matching",
    "string-interpolation"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mezze",
        "aliases": [
          "Mezze",
          "mezze"
        ],
        "extensions": [
          ".mezze"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mezze",
        "scopeName": "source.mezze",
        "path": "./syntaxes/mezze.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "mezze",
        "path": "./snippets/mezze.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mezze-lang/mezze"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mezze-lang/mezze/issues"
  },
  "homepage": "https://github.com/mezze-lang/mezze#readme"
}

