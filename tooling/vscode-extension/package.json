{
  "name": "funk-language",
  "displayName": "Funk Language Support",
  "description": "Syntax highlighting and language support for the Funk programming language",
  "version": "0.1.0",
  "publisher": "funk-lang",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "funk",
    "functional",
    "effects"
  ],
  "contributes": {
    "languages": [
      {
        "id": "funk",
        "aliases": [
          "Funk",
          "funk"
        ],
        "extensions": [
          ".funk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "funk",
        "scopeName": "source.funk",
        "path": "./syntaxes/funk.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/funk-lang/funk"
  },
  "license": "MIT"
}

