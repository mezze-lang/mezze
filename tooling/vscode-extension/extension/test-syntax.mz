# ==========================================
# Mezze Syntax Highlighting Test File
# ==========================================

# Module imports
use std::io
use std::effects::log::{println, Console}
use math::geometry::{area, perimeter}
pub std::collections::list

# ==========================================
# Type Declarations
# ==========================================

# Simple type alias
type Point = {x: Int, y: Int}

# Parameterized types
type Option 'a = | Some {value: 'a}, None |
type Result 'e 'a = | Ok {value: 'a}, Err {error: 'e} |

# Variant types
type Color = | Red, Green, Blue, Custom {r: Int, g: Int, b: Int} |

# Open variant (extensible)
type ExtensibleEnum = | A, B, C, ... |

# Newtype declarations
newtype Email = Email String
pub newtype UserId = UserId Int
newtype Point3D = Point3D { x: Float, y: Float, z: Float }

# ==========================================
# Effect Declarations
# ==========================================

effect Log where {
    info: {msg: String} -> {} <Log>,
    warn: {msg: String} -> {} <Log>
}

effect State having 'state where {
    get: {} -> 'state <State>,
    put: {value: 'state} -> {} <State>
}

effect IO where {
    print: {message: String} -> {} <IO>,
    read: {} -> String <IO>
}

# ==========================================
# Ability Declarations
# ==========================================

ability Eq 'a where {
    eq: {left: 'a, right: 'a} -> Bool
}

ability Ord 'a with Eq 'a where {
    compare: {left: 'a, right: 'a} -> Int
}

ability Show 'a where {
    show: {val: 'a} -> String
}

ability Encoder 'a having 'output where {
    encode: {val: 'a} -> 'output
}

# ==========================================
# Effect Implementations
# ==========================================

impl Log for ConsoleLogger where {
    info = {msg} -> {},
    warn = {msg} -> {}
}

impl State for Counter having 'state = Int where {
    get = {} -> 0,
    put = {value} -> {}
}

# ==========================================
# Ability Implementations
# ==========================================

impl Eq Int where {
    eq = {left, right} -> left == right
}

impl Show Int where {
    show = {val} -> "Int"
}

impl Show String where {
    show = {val} -> val
}

# ==========================================
# Let Bindings
# ==========================================

# Simple values
let simpleValue = 42
pub let publicValue = "Hello, Mezze!"
let typedValue: Int = 100

# Numeric literals
let integer = 42
let negative = -10
let float = 3.14159
let scientific = 1.5e10
let fraction = 1//2
let anotherFrac = 22//7
let natural = 42n
let bigNat = 1_000_000n

# Boolean literals (capital T/F)
let truthy = True
let falsy = False

# ==========================================
# Lambda Expressions
# ==========================================

# Untyped lambdas
let add = {x, y} -> x + y
let triple = {x} -> x * 3
let identity = {x} -> x
let noParams = {} -> 42

# Typed lambdas
let typedAdd: {x: Int, y: Int} -> Int = {x, y} -> x + y

# Lambda with effects
let withEffects: {x: Int} -> Int <State> = {x} ->
    do
        let current = get {}
        put {value = current + x}
        current + x

# Lambda with ability constraints
let genericAdd: {x: 'a, y: 'a} -> 'a with Eq 'a = {x, y} ->
    x

# Lambda with performed marker
let effectful: {} -> {} <Log, *> = {} ->
    info {msg = "Hello"}

# ==========================================
# Pattern Matching
# ==========================================

let optionToInt = {opt} ->
    match opt is
        Some {value = x} -> x
        None -> 0

let colorToString = {color} ->
    match color is
        Red -> "Red"
        Green -> "Green"
        Blue -> "Blue"
        Custom {r, g, b} -> "Custom RGB"
        _ -> "Unknown"

# Pattern matching with guards
let classify = {x} ->
    match x is
        n if n < 0 -> "negative"
        0 -> "zero"
        n if n > 0 -> "positive"
        _ -> "unknown"

# Array patterns
let head = {arr} ->
    match arr is
        [] -> None
        [x] -> Some {value = x}
        [x, ...rest] -> Some {value = x}

# Literal patterns
let describeFrac = {f} ->
    match f is
        1//2 -> "half"
        1//4 -> "quarter"
        _ -> "other"

# ==========================================
# If Expressions
# ==========================================

let max = {x, y} ->
    if x > y
    then x
    else y

let classify2 = {age} ->
    if age < 18 then "minor" else "adult"

# ==========================================
# Do Expressions
# ==========================================

let computation = {x} ->
    do
        let a = x + 1
        let b = a * 2
        let c = b - 3
        c

# ==========================================
# Perform Expressions
# ==========================================

let runWithHandler = {value} ->
    perform Console in
        println {msg = "Hello World"}

let multiHandler = {value} ->
    perform Console, Counter in
        do
            let x = get {}
            println {msg = "Value"}
            x

# ==========================================
# Record Literals
# ==========================================

let point = {x = 10, y = 20}
let point3d = {x = 1, y = 2, z = 3}

# Record with spread
let updatedPoint = {...point, y = 30}
let extendedPoint = {...point, z = 0}

# Record punning
let x = 5
let y = 10
let punnedPoint = {x, y}

# ==========================================
# Array Literals
# ==========================================

let numbers = [1, 2, 3, 4, 5]
let strings = ["hello", "world"]
let empty = []
let nested = [[1, 2], [3, 4]]

# ==========================================
# Pipe Operator
# ==========================================

let piped = 10
    |> {x} -> x + 5
    |> {x} -> x * 2
    |> {x} -> x - 3

# With placeholder
let result = 5 |> add {x = @, y = 3}

# ==========================================
# Qualified Identifiers
# ==========================================

let area = math::geometry::area {width = 10, height = 20}
let stringified = std::int::to_str {n = 42}

# ==========================================
# String Interpolation
# ==========================================

let firstName = "John"
let lastName = "Doe"
let fullName = "$(firstName) $(lastName)"
let greeting = "Hello, $(firstName)!"
let escaped = "Use \$(var) for interpolation"
let nested = "outer: $(firstName)"
let computed = "Result: $(add {x = 1, y = 2})"

# String escapes
let withNewline = "Hello\nWorld"
let withTab = "Col1\tCol2"
let withQuote = "She said \"Hello\""
let withBackslash = "C:\\Users\\mezze"

# ==========================================
# Let Destructuring
# ==========================================

let { x, y } = point
let { x = px, y = py } = point
let { x, ... } = {x = 1, y = 2, z = 3}

# ==========================================
# Operators
# ==========================================

let arithmetic = 1 + 2 - 3 * 4 / 2 % 3
let comparison = 5 == 5 && 10 != 20 || 3 < 4 && 7 >= 6 && 8 <= 9 && 9 > 8
let logical = True && False || !True
let fractionOp = 1//2 + 1//4

# ==========================================
# Type Annotations
# ==========================================

# With effect rows
let stateful: {x: Int} -> Int <State> = {x} -> x + 1
let multiEffect: {x: Int} -> Int <State, IO> = {x} -> x
let polymorphicEffect: {x: Int} -> Int <...> = {x} -> x
let purePerformed: {} -> {} <*> = {} -> {}
let effectPerformed: {} -> {} <Log, *> = {} -> {}

# With ability constraints
let constrained: {x: 'a} -> 'a with Eq 'a = {x} -> x
let multiConstrained: {x: 'a, y: 'b} -> 'a with Eq 'a, Show 'b = {x, y} -> x

# Open records in types
let processUser: {user: {name: String, age: Int, ...}} -> String =
    {user} -> user.name

# ==========================================
# Ability Method Calls
# ==========================================

let showInt = Show.show {val = 42}
let eqResult = Eq.eq {left = 1, right = 2}

