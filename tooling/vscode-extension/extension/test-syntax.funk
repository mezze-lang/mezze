# Module imports
use std::io
use math::geometry::{area, perimeter} as geo
pub std::collections::list

# Type declarations
type Option 'a = | Some {value: 'a}, None |
type Result 'e 'a = | Ok {value: 'a}, Err {error: 'e} |
type Point = {x: Int, y: Int}
type Color = | Red, Green, Blue, Custom {r: Int, g: Int, b: Int} |

# Effect declarations
effect State {
  get: {} -> Int <>
  put: {value: Int} -> {} <>
}

effect IO {
  print: {message: String} -> {} <>
  read: {} -> String <>
}

# Ability declarations
ability NumAdd 'a where {
  add: {left: 'a, right: 'a} -> 'a
}

ability NumAdd 'a with Eq 'a where {
  add: {left: 'a, right: 'a} -> 'a
}

# Implementation - Effect
impl State for Counter where {
  get: {} -> Int = {} -> state
  put: {value: Int} -> {} = {value} -> value
}

# Implementation - Ability
impl NumAdd Int where {
  add: {left: Int, right: Int} -> Int = {left, right} -> left + right
}

# Let bindings
let simpleValue = 42
pub let publicValue = "Hello, Funk!"
let typedValue: Int = 100

# Lambda expressions - untyped
let add = {x, y} -> x + y
let triple = {x} -> x * 3
let identity = {x} -> x

# Lambda expressions - typed
let typedAdd: {x: Int, y: Int} -> Int = {x, y} -> x + y
let withEffects: {x: Int} -> Int <State> = {x} ->
  do
    let current = get {}
    put {value = current + x}
    current + x

# Lambda with ability constraints
let genericAdd: {x: 'a, y: 'a} -> 'a with NumAdd 'a = {x, y} ->
  add {left = x, right = y}

# Function application with named parameters
let result1 = add {x = 5, y = 3}
let result2 = typedAdd {x = 10, y = 20}

# Pattern matching
let optionToInt = {opt: Option Int} -> Int =
  {opt} ->
    match opt is
      Some {value = x} -> x
      None -> 0

let colorToString = {color: Color} -> String =
  {color} ->
    match color is
      Red -> "Red"
      Green -> "Green"
      Blue -> "Blue"
      Custom {r, g, b} -> "Custom RGB"

# Pattern matching with guards
let classify = {x: Int} -> String =
  {x} ->
    match x is
      n if n < 0 -> "negative"
      0 -> "zero"
      n if n > 0 -> "positive"
      _ -> "unknown"

# If expressions
let max = {x: Int, y: Int} -> Int =
  {x, y} ->
    if x > y
    then x
    else y

# Do expressions
let computation = {x: Int} -> Int <State> =
  {x} ->
    do
      let a = get {}
      put {value = a + 1}
      let b = get {}
      b + x

# Perform expressions
let runWithHandler = {value: Int} -> Int =
  {value} ->
    perform StateHandler {initial = 0} in
      computation {x = value}

# Record literals
let point = {x = 10, y = 20}
let point3d = {x = 1, y = 2, z = 3}

# Record with spread
let updatedPoint = {...point, y = 30}
let extendedPoint = {...point, z = 0}

# Array literals
let numbers = [1, 2, 3, 4, 5]
let strings = ["hello", "world"]
let empty = []

# Pipe operator
let piped = 10
  |> {x} -> x + 5
  |> {x} -> x * 2
  |> {x} -> x - 3

# Qualified identifiers
let area = geo::area {width = 10, height = 20}
let result = math::operations::multiply {x = 5, y = 6}

# String interpolation
let firstName = "John"
let lastName = "Doe"
let fullName = "$(firstName) $(lastName)"
let greeting = "Hello, $(firstName)!"
let escaped = "Use \$(var) for interpolation"
let nested = "outer: $("inner $(firstName)")"
let multiInterp = "$(firstName) is $(lastName)"

# Let destructuring
let point = {x = 10, y = 20}
let { x, y } = point
let { x = px, y = py } = point
let { x, ... } = {x = 1, y = 2, z = 3}

# Operators showcase
let arithmetic = 1 + 2 - 3 * 4 / 2 % 3
let comparison = 5 == 5 && 10 != 20 || 3 < 4 && 7 >= 6 && 8 <= 9 && 9 > 8
let logical = true && false || !true
let spread = {...record, ...otherRecord}
let placeholder = numbers |> map @ |> filter @

# Type annotations with effect rows
let stateful: {x: Int} -> Int <State> = {x} -> x + 1
let multiEffect: {x: Int} -> Int <State, IO> = {x} ->
  do
    print {message = "Computing"}
    x + 1

# Type annotations with ability constraints
let constrained: {x: 'a} -> 'a with Eq 'a = {x} -> x
let multiConstrained: {x: 'a, y: 'b} -> 'a with NumAdd 'a, Eq 'b = {x, y} -> x

# Complex nested patterns
let complexMatch = {value: Result String (Option Int)} -> Int =
  {value} ->
    match value is
      Ok {value = Some {value = x}} -> x
      Ok {value = None} -> 0
      Err {error = msg} -> -1

# Variant with trailing comma and spread
type ExtensibleEnum = | A, B, C, ... |

# Comments
# This is a single-line comment
# Multi-line comments can be
# written like this

# Bool literals
let truthy = true
let falsy = false

# Numeric literals
let integer = 42
let float = 3.14159
let scientific = 1.5e10
let fraction = 1//2
let anotherFrac = 3//4

# String literals with escapes
let greeting = "Hello, \"World\"!\n"
let path = "C:\\Users\\funk\\file.txt"

# Ability method calls
let showInt = Show.show { val = 42 }
let addResult = NumOps.add { l = 1, r = 2 }
let logMsg = Log.println { msg = "Hello" }

# Type variables in different contexts
type Functor 'f where {
  map: {'a -> 'b, 'f 'a} -> 'f 'b
}

type Monad 'm with Functor 'm where {
  bind: {'m 'a, 'a -> 'm 'b} -> 'm 'b
  pure: {'a} -> 'm 'a
}

# End of test file
