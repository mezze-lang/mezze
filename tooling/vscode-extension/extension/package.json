{
  "name": "mezze-language",
  "displayName": "Mezze Language Support",
  "description": "Full language support for Mezze: syntax highlighting, type information, diagnostics, go to definition, and more",
  "version": "0.5.0",
  "publisher": "mezze-lang",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "mezze",
    "functional",
    "effects",
    "algebraic-effects",
    "type-inference",
    "pattern-matching"
  ],
  "activationEvents": [
    "onLanguage:mezze",
    "onDebugResolve:mezze",
    "onDebugDynamicConfigurations:mezze"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mezze",
        "aliases": [
          "Mezze",
          "mezze"
        ],
        "extensions": [
          ".mz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./file-icons/mezze-file-icon.svg",
          "dark": "./file-icons/mezze-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mezze",
        "scopeName": "source.mezze",
        "path": "./syntaxes/mezze.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[mezze]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.suggestOnTriggerCharacters": true
      }
    },
    "snippets": [
      {
        "language": "mezze",
        "path": "./snippets/mezze.json"
      }
    ],
    "iconThemes": [
      {
        "id": "mezze-icons",
        "label": "Mezze File Icons",
        "path": "./file-icons/mezze-icon-theme.json"
      }
    ],
    "configuration": [
      {
        "title": "Mezze",
        "order": 1,
        "properties": {
          "mezze.executablePath": {
            "type": "string",
            "default": "mez",
            "order": 1,
            "description": "Path to the mez executable. If not absolute, it's resolved relative to the workspace root."
          },
          "mezze.inlayHints.enabled": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "Show inline type/parameter/effect hints."
          },
          "mezze.codeLens.enabled": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "Show reference / implementation / performer counts above declarations."
          }
        }
      },
      {
        "title": "Advanced",
        "order": 2,
        "properties": {
          "mezze.debounceMs": {
            "type": "number",
            "default": 250,
            "minimum": 0,
            "maximum": 5000,
            "order": 1,
            "markdownDescription": "Milliseconds to wait after the last keystroke before re-analyzing a document. Lower feels snappier; higher reduces CPU on large files."
          },
          "mezze.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "enumDescriptions": [
              "No tracing.",
              "Log the method name of each request/response.",
              "Log the full JSON-RPC payloads (very noisy — for debugging only)."
            ],
            "default": "off",
            "order": 2,
            "markdownDescription": "Traces the communication between VS Code and the Mezze language server. Leave `off` for normal use."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "mezze.restartServer",
        "title": "Mezze: Restart Language Server"
      },
      {
        "command": "mezze.clearCacheCommand",
        "title": "Mezze: Clear Analysis Cache"
      },
      {
        "command": "mezze.resetServerState",
        "title": "Mezze: Reset Server State"
      }
    ],
    "breakpoints": [
      {
        "language": "mezze"
      }
    ],
    "debuggers": [
      {
        "type": "mezze",
        "label": "Mezze",
        "languages": [
          "mezze"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Mezze program (.mz) or project directory to run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command-line arguments passed to the program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Suspend on the first statement so breakpoints can be set before anything runs.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Working directory. Defaults to the workspace folder.",
                "default": "${workspaceFolder}"
              },
              "port": {
                "type": "number",
                "description": "Port the mez DAP server listens on. Defaults to 4711.",
                "default": 4711
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mezze",
            "request": "launch",
            "name": "Debug Mezze File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Mezze: Launch Current File",
            "description": "Run and debug the currently open .mz file",
            "body": {
              "type": "mezze",
              "request": "launch",
              "name": "Debug ${1:Mezze File}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "test:syntax": "node test/tmgrammar.test.js",
    "test:snippets": "node test/snippets.test.js",
    "test": "npm run test:syntax && npm run test:snippets"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mezze-lang/mezze"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mezze-lang/mezze/issues"
  },
  "homepage": "https://github.com/mezze-lang/mezze#readme"
}
