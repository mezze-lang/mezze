{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mezze",
      "camelcase": "Mezze",
      "scope": "source.mezze",
      "path": ".",
      "file-types": ["mz"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^mezze$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Mezze language",
    "authors": [
      { "name": "Shriyans Bhatnagar" }
    ],
    "links": {
      "repository": "https://github.com/shriyansbhatnagar/funk"
    },
    "namespace": "tree-sitter"
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
