effect Log {
  print : {msg: String} -> {}
}

effect Random {
  nextInt : {min: Int, max: Int} -> Int
}

impl Log for Console where {
  print : {msg: String} -> {} = {msg} -> native_print {msg = msg}
}

impl Random for MathRandom where {
  nextInt : {min: Int, max: Int} -> Int = {min, max} -> native_random {min = min, max = max}
}

let complexFunction = {name} -> do
  let randomNum = Random.nextInt {min = 1, max = 100}
  Log.print {msg = "Hello " ++ name ++ ", your number is " ++ intToString {val = randomNum}}
  randomNum

let result = perform Console, MathRandom do complexFunction {name = "Alice"}
