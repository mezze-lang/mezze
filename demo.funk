# Simple demo with effects, variants and pattern matching

# ========================================
# Part 1: Variants and Pattern Matching
# ========================================

type Result = | Success { value: String }, Failure { error: String } |

# Function without effects - pure pattern matching
let simpleHandle = {result} -> match result is
  Success { value } -> "Got: " ++ value
  Failure { error } -> "Error: " ++ error

# Test the pattern matching
let test1 = simpleHandle { result = Success { value = "test" } }

# ========================================
# Part 2: Effects System
# ========================================

# Define a custom State effect
effect State {
  get: {} -> Int,
  put: { value: Int } -> {}
}

# A computation that uses the State effect
let counter = {} -> do
  let current = State.get {}
  State.put { value = current + 1 }
  current

# Implement the State effect with an integer store
impl State for IntStore { initial: Int } where {
  get: {} -> Int = {} -> initial,
  put: { value: Int } -> {} = { value } -> {}
}

# Use the State effect with a handler
let countTest = perform IntStore { initial = 0 } in counter {}

# ========================================
# Part 3: Multiple Effects
# ========================================

# Define a Logging effect
effect Logger {
  log: { msg: String } -> {}
}

# Function that uses both State and Logger effects
let loggedCounter = {} -> do
  Logger.log { msg = "Starting count" }
  let current = State.get {}
  Logger.log { msg = "Current value: " ++ toString { n = current } }
  State.put { value = current + 1 }
  Logger.log { msg = "Incremented to: " ++ toString { n = current + 1 } }
  current

# Implement Logger with console output
impl Logger for ConsoleLogger where {
  log: { msg: String } -> {} = { msg } -> __native_console_println { msg = msg }
}

# Use both effects together
let multiEffectTest =
  perform ConsoleLogger in
  perform IntStore { initial = 5 } in
  loggedCounter {}

# ========================================
# Part 4: Effect Polymorphism
# ========================================

# A function that works with any Result-returning computation
let safeMap = { f, result } -> match result is
    Success { value } -> Success { value = f { x = value } }
    Failure { error } -> Failure { error = error }

# Helper to convert Int to String
let toString = { n } -> __native_int_to_string { n = n }

# Map a function over a result
let mapped = safeMap {
  f = { x } -> x ++ " (mapped)",
  result = Success { value = "data" }
}

# ========================================
# Main: Run all examples
# ========================================

do
  # Test 1: Simple pattern matching
  let result1 = simpleHandle { result = Success { value = "Hello, World!" } }

  # Test 2: State effect
  let result2 = countTest

  # Test 3: Multiple effects
  let result3 = multiEffectTest

  # Test 4: Result mapping
  let result4 = match mapped is
    Success { value } -> "Mapped: " ++ value
    Failure { error } -> "Failed: " ++ error

  result4
