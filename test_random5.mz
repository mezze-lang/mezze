# Test simpler - just call function twice within same perform

use std::effects::log::{Log, Console, println}
use std::effects::random::{Random, SeededRandom, random_int}
use std::int

let get_random = {} -> random_int {min = 1, max = 10}

pub let main: {} -> {} <*> = {} ->
    perform Console in
    perform SeededRandom {seed = 42} in do
        println {msg = "First call:"}
        let r1 = get_random {}
        println {msg = "r1 = $(int::to_str {n = r1})"}

        println {msg = "Second call:"}
        let r2 = get_random {}
        println {msg = "r2 = $(int::to_str {n = r2})"}

        println {msg = "Done"}
