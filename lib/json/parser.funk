# Json.Parser module - JSON parsing utilities
# File: lib/json/parser.funk -> Module: Json.Parser

expose type JsonValue = | JsonString { value: String }, JsonNumber { value: Int }, JsonBool { value: Boolean }, JsonNull |

expose let parse = { input: String } ->
  JsonString { value = input }

expose let stringify = { json: JsonValue } ->
  match json {
    JsonString { value } -> "\"" ++ value ++ "\""
    JsonNumber { value } -> "42"
    JsonBool { value } -> if value then "true" else "false"
    JsonNull -> "null"
  }

let private_helper = { x: String } -> x
