# Simple JavaScript Compiler Test

# Basic types and literals
let number = 42
let text = "hello"
let flag = true

# Records
let person = { name = "Alice", age = 30 }
let updated = person { age = 31 }

# Simple variants
expose type Color = | Red, Blue, Green |
let red = Red
let blue = Blue

# Functions
let add = { x, y } -> x + y
let multiply = { x: Int, y: Int } -> x * y

# Simple pattern matching
let colorName = match red {
  Red -> "red"
  Blue -> "blue" 
  Green -> "green"
}

# If expressions
let result = if true then "yes" else "no"

# Do expressions
let computation = do
  let x = 10
  let y = 20
  x + y

# Binary operations
let arithmetic = 10 + 5 * 2
let comparison = 10 > 5
let stringConcat = "Hello" ++ " World"

# Function calls
let sum = add { x = 5, y = 3 }

# Member access
let personName = person.name
