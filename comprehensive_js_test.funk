# Comprehensive JavaScript Compiler Test - All Fixed Features

# Basic types and literals
let number = 42
let text = "hello"
let flag = true

# Records and operations
let person = { name = "Alice", age = 30 }
let updated = person { age = 31 }
let personName = person.name

# Simple variants (working)
expose type Color = | Red, Blue, Green |
let red = Red
let blue = Blue

# Functions with proper parameter destructuring
let add = { x, y } -> x + y
let multiply = { x: Int, y: Int } -> x * y

# Pattern matching with proper runtime matching
let colorName = match red {
  Red -> "red"
  Blue -> "blue" 
  Green -> "green"
}

# If expressions
let result = if true then "yes" else "no"

# Do expressions
let computation = do
  let x = 10
  let y = 20
  x + y

# Block expressions (using do instead)
let blockResult = do
  let a = 5
  let b = 10
  a * b

# Pipe expressions (improved)
let double = { x } -> x * 2
let addOne = { x } -> x + 1
let piped1 = 10 |> double
let piped2 = 5 |> double |> addOne

# Binary operations
let arithmetic = 10 + 5 * 2
let comparison = 10 > 5
let stringConcat = "Hello" ++ " " ++ "World"

# Function calls
let sum = add { x = 5, y = 3 }
let product = multiply { x = 4, y = 6 }
