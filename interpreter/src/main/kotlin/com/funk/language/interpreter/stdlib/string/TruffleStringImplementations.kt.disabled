package com.funk.language.interpreter.stdlib.string

import com.funk.language.interpreter.*

/**
 * Truffle runtime implementations for string abilities
 */
object TruffleStringImplementations {
    
    /**
     * Register all string runtime implementations
     */
    fun registerAll(context: MutableMap<String, FunkValue>) {
        registerStringOperations(context)
        registerHiddenStringOperations(context)
    }
    
    /**
     * String manipulation operations
     */
    private fun registerStringOperations(context: MutableMap<String, FunkValue>) {
        // Length operation
        context["length"] = NativeFunkFunction("length") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("length", "expects 'str' as String")
            FunkInt(str.value.length.toLong())
        }
        
        // Keep backward compatibility
        context["stringLength"] = context["length"]!!
        
        // Substring operation
        context["substring"] = NativeFunkFunction("substring") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("substring", "expects 'str' as String")
            val start = record.fields["start"] as? FunkInt ?: throw NativeFunctionException("substring", "expects 'start' as Int")
            val end = record.fields["end"] as? FunkInt ?: throw NativeFunctionException("substring", "expects 'end' as Int")
            
            val startInt = start.value.toInt().coerceAtLeast(0)
            val endInt = end.value.toInt().coerceAtMost(str.value.length)
            
            val result = if (startInt <= endInt) {
                str.value.substring(startInt, endInt)
            } else {
                ""
            }
            
            FunkString(result)
        }
        
        // Keep backward compatibility
        context["stringSubstring"] = context["substring"]!!
        
        // Case conversion operations
        context["toUpperCase"] = NativeFunkFunction("toUpperCase") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("toUpperCase", "expects 'str' as String")
            FunkString(str.value.uppercase())
        }
        
        context["toLowerCase"] = NativeFunkFunction("toLowerCase") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("toLowerCase", "expects 'str' as String")
            FunkString(str.value.lowercase())
        }
        
        // Keep backward compatibility
        context["stringToUpperCase"] = context["toUpperCase"]!!
        context["stringToLowerCase"] = context["toLowerCase"]!!
        
        // Concatenation operation
        context["concat"] = NativeFunkFunction("concat") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("concat", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("concat", "expects 'right' as String")
            FunkString(left.value + right.value)
        }
    }
    
    /**
     * Hidden string operations (prefixed with __native_)
     * These are used by the stdlib modules and hidden from user code
     */
    private fun registerHiddenStringOperations(context: MutableMap<String, FunkValue>) {
        // String comparison operations
        context["__native_string_equals"] = NativeFunkFunction("__native_string_equals") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("__native_string_equals", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("__native_string_equals", "expects 'right' as String")
            FunkBoolean(left.value == right.value)
        }
        
        context["__native_string_less_than"] = NativeFunkFunction("__native_string_less_than") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("__native_string_less_than", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("__native_string_less_than", "expects 'right' as String")
            FunkBoolean(left.value < right.value)
        }
        
        context["__native_string_greater_than"] = NativeFunkFunction("__native_string_greater_than") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("__native_string_greater_than", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("__native_string_greater_than", "expects 'right' as String")
            FunkBoolean(left.value > right.value)
        }
        
        context["__native_string_compare"] = NativeFunkFunction("__native_string_compare") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("__native_string_compare", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("__native_string_compare", "expects 'right' as String")
            val result = left.value.compareTo(right.value)
            when {
                result < 0 -> FunkVariant("Less", null)
                result > 0 -> FunkVariant("Greater", null)
                else -> FunkVariant("Equal", null)
            }
        }
        
        // String manipulation operations
        context["__native_string_length"] = NativeFunkFunction("__native_string_length") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_length", "expects 'str' as String")
            FunkInt(str.value.length.toLong())
        }
        
        context["__native_string_concat"] = NativeFunkFunction("__native_string_concat") { args ->
            val record = args[0] as FunkRecord
            val left = record.fields["left"] as? FunkString ?: throw NativeFunctionException("__native_string_concat", "expects 'left' as String")
            val right = record.fields["right"] as? FunkString ?: throw NativeFunctionException("__native_string_concat", "expects 'right' as String")
            FunkString(left.value + right.value)
        }
        
        context["__native_string_substring"] = NativeFunkFunction("__native_string_substring") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_substring", "expects 'str' as String")
            val start = record.fields["start"] as? FunkInt ?: throw NativeFunctionException("__native_string_substring", "expects 'start' as Int")
            val end = record.fields["end"] as? FunkInt ?: throw NativeFunctionException("__native_string_substring", "expects 'end' as Int")
            
            val startInt = start.value.toInt().coerceAtLeast(0)
            val endInt = end.value.toInt().coerceAtMost(str.value.length)
            
            val result = if (startInt <= endInt) {
                str.value.substring(startInt, endInt)
            } else {
                ""
            }
            
            FunkString(result)
        }
        
        context["__native_string_to_upper"] = NativeFunkFunction("__native_string_to_upper") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_to_upper", "expects 'str' as String")
            FunkString(str.value.uppercase())
        }
        
        context["__native_string_to_lower"] = NativeFunkFunction("__native_string_to_lower") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_to_lower", "expects 'str' as String")
            FunkString(str.value.lowercase())
        }
        
        context["__native_string_trim"] = NativeFunkFunction("__native_string_trim") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_trim", "expects 'str' as String")
            FunkString(str.value.trim())
        }
        
        context["__native_string_contains"] = NativeFunkFunction("__native_string_contains") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_contains", "expects 'str' as String")
            val substring = record.fields["substring"] as? FunkString ?: throw NativeFunctionException("__native_string_contains", "expects 'substring' as String")
            FunkBoolean(str.value.contains(substring.value))
        }
        
        context["__native_string_starts_with"] = NativeFunkFunction("__native_string_starts_with") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_starts_with", "expects 'str' as String")
            val prefix = record.fields["prefix"] as? FunkString ?: throw NativeFunctionException("__native_string_starts_with", "expects 'prefix' as String")
            FunkBoolean(str.value.startsWith(prefix.value))
        }
        
        context["__native_string_ends_with"] = NativeFunkFunction("__native_string_ends_with") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_ends_with", "expects 'str' as String")
            val suffix = record.fields["suffix"] as? FunkString ?: throw NativeFunctionException("__native_string_ends_with", "expects 'suffix' as String")
            FunkBoolean(str.value.endsWith(suffix.value))
        }
        
        context["__native_string_replace"] = NativeFunkFunction("__native_string_replace") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_replace", "expects 'str' as String")
            val old = record.fields["old"] as? FunkString ?: throw NativeFunctionException("__native_string_replace", "expects 'old' as String")
            val new = record.fields["new"] as? FunkString ?: throw NativeFunctionException("__native_string_replace", "expects 'new' as String")
            FunkString(str.value.replace(old.value, new.value))
        }
        
        context["__native_string_split"] = NativeFunkFunction("__native_string_split") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_split", "expects 'str' as String")
            val delimiter = record.fields["delimiter"] as? FunkString ?: throw NativeFunctionException("__native_string_split", "expects 'delimiter' as String")
            val parts = str.value.split(delimiter.value)
            val funkParts = parts.map { FunkString(it) }
            FunkArrayList(ArrayList(funkParts))
        }
        
        // String conversion operations
        context["__native_string_to_int"] = NativeFunkFunction("__native_string_to_int") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_to_int", "expects 'str' as String")
            try {
                FunkInt(str.value.toLong())
            } catch (e: NumberFormatException) {
                throw FunkException("Cannot convert '${str.value}' to Int")
            }
        }
        
        context["__native_string_to_float"] = NativeFunkFunction("__native_string_to_float") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_to_float", "expects 'str' as String")
            try {
                FunkFloat(str.value.toDouble())
            } catch (e: NumberFormatException) {
                throw FunkException("Cannot convert '${str.value}' to Float")
            }
        }
        
        context["__native_string_to_nat"] = NativeFunkFunction("__native_string_to_nat") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_to_nat", "expects 'str' as String")
            try {
                val value = str.value.toLong()
                if (value < 0) throw FunkException("Cannot convert negative number '${str.value}' to Nat")
                FunkNat(value)
            } catch (e: NumberFormatException) {
                throw FunkException("Cannot convert '${str.value}' to Nat")
            }
        }
        
        // String formatting (simplified implementation)
        context["__native_string_format"] = NativeFunkFunction("__native_string_format") { args ->
            val record = args[0] as FunkRecord
            val template = record.fields["template"] as? FunkString ?: throw NativeFunctionException("__native_string_format", "expects 'template' as String")
            val argsArray = record.fields["args"] as? FunkArrayList ?: throw NativeFunctionException("__native_string_format", "expects 'args' as ArrayList")
            
            // Simple string formatting - replace {} with arguments in order
            var result = template.value
            argsArray.elements.forEachIndexed { index, arg ->
                result = result.replaceFirst("{}", arg.getDisplayString())
            }
            FunkString(result)
        }
        
        context["__native_string_join"] = NativeFunkFunction("__native_string_join") { args ->
            val record = args[0] as FunkRecord
            val strings = record.fields["strings"] as? FunkArrayList ?: throw NativeFunctionException("__native_string_join", "expects 'strings' as ArrayList")
            val separator = record.fields["separator"] as? FunkString ?: throw NativeFunctionException("__native_string_join", "expects 'separator' as String")
            
            val stringValues = strings.elements.map { 
                when (it) {
                    is FunkString -> it.value
                    else -> it.getDisplayString()
                }
            }
            FunkString(stringValues.joinToString(separator.value))
        }
        
        // Additional string operations for new modules
        context["__native_string_index_of"] = NativeFunkFunction("__native_string_index_of") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_index_of", "expects 'str' as String")
            val substring = record.fields["substring"] as? FunkString ?: throw NativeFunctionException("__native_string_index_of", "expects 'substring' as String")
            FunkInt(str.value.indexOf(substring.value).toLong())
        }
        
        context["__native_string_last_index_of"] = NativeFunkFunction("__native_string_last_index_of") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_last_index_of", "expects 'str' as String")
            val substring = record.fields["substring"] as? FunkString ?: throw NativeFunctionException("__native_string_last_index_of", "expects 'substring' as String")
            FunkInt(str.value.lastIndexOf(substring.value).toLong())
        }
        
        // String formatting operations
        context["__native_string_interpolate"] = NativeFunkFunction("__native_string_interpolate") { args ->
            val record = args[0] as FunkRecord
            val template = record.fields["template"] as? FunkString ?: throw NativeFunctionException("__native_string_interpolate", "expects 'template' as String")
            val values = record.fields["values"] as? FunkArrayList ?: throw NativeFunctionException("__native_string_interpolate", "expects 'values' as ArrayList")
            
            var result = template.value
            values.elements.forEach { pair ->
                val pairRecord = pair as FunkRecord
                val key = pairRecord.fields["_1"] as? FunkString ?: return@forEach
                val value = pairRecord.fields["_2"] as? FunkString ?: return@forEach
                result = result.replace("{{${key.value}}}", value.value)
            }
            FunkString(result)
        }
        
        context["__native_string_pad_left"] = NativeFunkFunction("__native_string_pad_left") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_left", "expects 'str' as String")
            val width = record.fields["width"] as? FunkInt ?: throw NativeFunctionException("__native_string_pad_left", "expects 'width' as Int")
            val padChar = record.fields["pad_char"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_left", "expects 'pad_char' as String")
            
            val widthInt = width.value.toInt()
            val padCharStr = if (padChar.value.isEmpty()) " " else padChar.value.first().toString()
            FunkString(str.value.padStart(widthInt, padCharStr.first()))
        }
        
        context["__native_string_pad_right"] = NativeFunkFunction("__native_string_pad_right") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_right", "expects 'str' as String")
            val width = record.fields["width"] as? FunkInt ?: throw NativeFunctionException("__native_string_pad_right", "expects 'width' as Int")
            val padChar = record.fields["pad_char"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_right", "expects 'pad_char' as String")
            
            val widthInt = width.value.toInt()
            val padCharStr = if (padChar.value.isEmpty()) " " else padChar.value.first().toString()
            FunkString(str.value.padEnd(widthInt, padCharStr.first()))
        }
        
        context["__native_string_pad_center"] = NativeFunkFunction("__native_string_pad_center") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_center", "expects 'str' as String")
            val width = record.fields["width"] as? FunkInt ?: throw NativeFunctionException("__native_string_pad_center", "expects 'width' as Int")
            val padChar = record.fields["pad_char"] as? FunkString ?: throw NativeFunctionException("__native_string_pad_center", "expects 'pad_char' as String")
            
            val widthInt = width.value.toInt()
            val padCharStr = if (padChar.value.isEmpty()) " " else padChar.value.first().toString()
            val totalPadding = (widthInt - str.value.length).coerceAtLeast(0)
            val leftPadding = totalPadding / 2
            val rightPadding = totalPadding - leftPadding
            
            val result = padCharStr.repeat(leftPadding) + str.value + padCharStr.repeat(rightPadding)
            FunkString(result)
        }
        
        context["__native_string_repeat"] = NativeFunkFunction("__native_string_repeat") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_string_repeat", "expects 'str' as String")
            val count = record.fields["count"] as? FunkInt ?: throw NativeFunctionException("__native_string_repeat", "expects 'count' as Int")
            FunkString(str.value.repeat(count.value.toInt().coerceAtLeast(0)))
        }
        
        // Number formatting
        context["__native_format_decimal"] = NativeFunkFunction("__native_format_decimal") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["value"] as? FunkFloat ?: throw NativeFunctionException("__native_format_decimal", "expects 'value' as Float")
            val precision = record.fields["precision"] as? FunkInt ?: throw NativeFunctionException("__native_format_decimal", "expects 'precision' as Int")
            val formatted = String.format("%.${precision.value}f", value.value)
            FunkString(formatted)
        }
        
        context["__native_format_percentage"] = NativeFunkFunction("__native_format_percentage") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["value"] as? FunkFloat ?: throw NativeFunctionException("__native_format_percentage", "expects 'value' as Float")
            val precision = record.fields["precision"] as? FunkInt ?: throw NativeFunctionException("__native_format_percentage", "expects 'precision' as Int")
            val formatted = String.format("%.${precision.value}f%%", value.value * 100)
            FunkString(formatted)
        }
        
        context["__native_format_currency"] = NativeFunkFunction("__native_format_currency") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["value"] as? FunkFloat ?: throw NativeFunctionException("__native_format_currency", "expects 'value' as Float")
            val currency = record.fields["currency"] as? FunkString ?: throw NativeFunctionException("__native_format_currency", "expects 'currency' as String")
            val formatted = String.format("%.2f %s", value.value, currency.value)
            FunkString(formatted)
        }
        
        // Type conversion helpers
        context["__native_int_to_string"] = NativeFunkFunction("__native_int_to_string") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["val"] as? FunkInt ?: throw NativeFunctionException("__native_int_to_string", "expects 'val' as Int")
            FunkString(value.value.toString())
        }
        
        context["__native_float_to_string"] = NativeFunkFunction("__native_float_to_string") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["val"] as? FunkFloat ?: throw NativeFunctionException("__native_float_to_string", "expects 'val' as Float")
            FunkString(value.value.toString())
        }
        
        context["__native_boolean_to_string"] = NativeFunkFunction("__native_boolean_to_string") { args ->
            val record = args[0] as FunkRecord
            val value = record.fields["val"] as? FunkBoolean ?: throw NativeFunctionException("__native_boolean_to_string", "expects 'val' as Boolean")
            FunkString(value.value.toString())
        }
        
        // Regex operations (basic implementations)
        context["__native_regex_matches"] = NativeFunkFunction("__native_regex_matches") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_matches", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_matches", "expects 'pattern' as String")
            try {
                FunkBoolean(str.value.matches(Regex(pattern.value)))
            } catch (e: Exception) {
                FunkBoolean(false)
            }
        }
        
        context["__native_regex_find"] = NativeFunkFunction("__native_regex_find") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_find", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_find", "expects 'pattern' as String")
            try {
                val result = Regex(pattern.value).find(str.value)
                if (result != null) {
                    FunkVariant("Some", FunkRecord(mapOf("value" to FunkString(result.value)))
                } else {
                    FunkVariant("None", null)
                }
            } catch (e: Exception) {
                FunkVariant("None", null)
            }
        }
        
        context["__native_regex_find_all"] = NativeFunkFunction("__native_regex_find_all") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_find_all", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_find_all", "expects 'pattern' as String")
            try {
                val matches = Regex(pattern.value).findAll(str.value).map { FunkString(it.value) }.toList()
                FunkArrayList(ArrayList(matches))
            } catch (e: Exception) {
                FunkArrayList(ArrayList())
            }
        }
        
        context["__native_regex_replace_first"] = NativeFunkFunction("__native_regex_replace_first") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_first", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_first", "expects 'pattern' as String")
            val replacement = record.fields["replacement"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_first", "expects 'replacement' as String")
            try {
                FunkString(str.value.replaceFirst(Regex(pattern.value), replacement.value))
            } catch (e: Exception) {
                FunkString(str.value)
            }
        }
        
        context["__native_regex_replace_all"] = NativeFunkFunction("__native_regex_replace_all") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_all", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_all", "expects 'pattern' as String")
            val replacement = record.fields["replacement"] as? FunkString ?: throw NativeFunctionException("__native_regex_replace_all", "expects 'replacement' as String")
            try {
                FunkString(str.value.replace(Regex(pattern.value), replacement.value))
            } catch (e: Exception) {
                FunkString(str.value)
            }
        }
        
        context["__native_regex_split"] = NativeFunkFunction("__native_regex_split") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_split", "expects 'str' as String")
            val pattern = record.fields["pattern"] as? FunkString ?: throw NativeFunctionException("__native_regex_split", "expects 'pattern' as String")
            try {
                val parts = str.value.split(Regex(pattern.value)).map { FunkString(it) }
                FunkArrayList(ArrayList(parts))
            } catch (e: Exception) {
                FunkArrayList(ArrayList(listOf(FunkString(str.value))))
            }
        }
        
        context["__native_regex_escape"] = NativeFunkFunction("__native_regex_escape") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_escape", "expects 'str' as String")
            FunkString(Regex.escape(str.value))
        }
        
        context["__native_regex_unescape"] = NativeFunkFunction("__native_regex_unescape") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_regex_unescape", "expects 'str' as String")
            // Simple unescape - remove backslashes before special characters
            val unescaped = str.value.replace("\\\\(.)", "$1")
            FunkString(unescaped)
        }
        
        // Unicode operations (basic implementations using Java's built-in Unicode support)
        context["__native_unicode_length"] = NativeFunkFunction("__native_unicode_length") { args ->
            val record = args[0] as FunkRecord
            val str = record.fields["str"] as? FunkString ?: throw NativeFunctionException("__native_unicode_length", "expects 'str' as String")
            FunkInt(str.value.codePointCount(0, str.value.length).toLong())
        }
        
