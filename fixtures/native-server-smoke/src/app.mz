# Native-image smoke test for the WEB story.
#
# A server binds a real socket, a route matches a path parameter, the query
# decodes into a typed record, and the client in the same process fetches it.
# Every piece has to survive native-image: Helidon WebServer's service
# registry, the Truffle-owned worker threads, and the codec's derived impls.
#
# Run:  mez build --native && ./.build/server_smoke-native

use std::effects::log::{ println, Console }
use std::effects::http::{ Request, Response, request, format_error, body_str, with_query, ToQuery, Method, HttpClient, SimpleHttpClient, HttpDownload, SimpleHttpDownload, default_http_config, HttpServer, HelidonHttpServerWith, ServerConfig, route, routes, otherwise, Matched, FromQuery, BadInput, sse, sse_event, SseEvent, events, Message, Socket, WebSocket, NativeWebSocket, SocketClient, HelidonSocketClient, router, messages }
use std::collections::map
use std::collections::bytes
use std::int

let reply: { code: Int, text: Str, url: Str } -> Response = { code, text, url } -> {
    status = code,
    headers = map::empty {},
    body = bytes::from_str { s = text },
    url = url,
    chunks = None,
  }

let not_found: { req: Request } -> Response = { req } ->
    reply { code = 404, text = "nope", url = req.url }

# Server-Sent Events both ways: the route streams two events; `events` folds them on the client.
let ticks = route { method = Get, path = "/ticks", handler = { m } -> sse { f = { send } -> do
    send { ev = sse_event { data = "tick" } }
    send { ev = { data = "tock", event = Some { val = "named" }, id = None } } } }

# A WebSocket echo endpoint: the handler folds incoming messages and sends each back.
let echo = router { path = "" }.websocket { path = "/echo", handler = { m, socket } ->
    messages { socket = socket, init = {}, f = { acc, msg } -> do
        let _ = WebSocket.send { socket = socket, msg = msg }
        {} } }

let table = routes { of = [echo.table {}, ticks, route { method = Get, path = "/hello/:name", handler = { m } -> do
        let who = m.param_or { name = "name", default = "?" }
        let q: Result { times: Int } BadInput = m.query_as {}
        match q is
            Ok { val } -> reply {
                code = 200,
                text = "hi $(who) x$(int::to_str { n = val.times })",
                url = m.req.url,
            }
            Err { error = e } -> reply { code = 400, text = e.message, url = m.req.url }
    }] }

let fetch: { url: Str } -> Str <HttpClient> = { url } ->
    match request { url = url }.send {} is
        Ok { val } -> match body_str { resp = val } is
            Ok { val = s } -> s
            Err { error = e } -> format_error { err = e }
        Err { error = e } -> format_error { err = e }

let any_port: ServerConfig = { port = 0, host = "127.0.0.1", workers = 2, stream_bodies = False, helidon_print_log = Off }

let main = {} -> perform Console in
    perform HelidonHttpServerWith { config = any_port } in
        perform SimpleHttpClient in perform SimpleHttpDownload in
        perform NativeWebSocket in perform HelidonSocketClient in do
            let h = match HttpServer.serve_routes { routes = table, fallback = not_found } is
              Ok { val = hh } -> hh
              Err { error = _ } -> { stop = {} -> {}, port = 0 - 1 }
            let base = "http://127.0.0.1:$(int::to_str { n = h.port })"
            let hit = fetch {
                url = request { url = "$(base)/hello/world" }
                    .with_query { params = { times = 3 } }
                    .url,
            }
            let missed = fetch { url = "$(base)/nothing" }
            let streamed = match events {
                req = request { url = "$(base)/ticks" }, config = default_http_config,
                init = "", f = { acc, ev } -> "$(acc)[$(match ev.event is
                    Some { val } -> val
                    None -> "-"):$(ev.data)]",
            } is
                Ok { val } -> val
                Err { error = e } -> format_error { err = e }
            let echoed = match SocketClient.connect { url = "ws://127.0.0.1:$(int::to_str { n = h.port })/echo", config = default_http_config } is
                Err { error = _ } -> "connect-failed"
                Ok { val = s } -> do
                    let _ = WebSocket.send { socket = s, msg = Text { text = "ws-ok" } }
                    let got = match WebSocket.receive { socket = s } is
                        Some { val = Text { text } } -> text
                        Some { val = Binary { bytes = _ } } -> "binary"
                        None -> "closed"
                    WebSocket.close { socket = s }
                    got
            h.stop {}
            println { msg = "server-smoke: port>0=$(if h.port > 0 then "yes" else "no") hit=$(hit) missed=$(missed) sse=$(streamed) ws=$(echoed)" }
