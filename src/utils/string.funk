expose let capitalize = { text: String } -> 
  if text == "" then "" else text

expose let uppercase = { text: String } -> text

expose let lowercase = { text: String } -> text  

expose let length = { text: String } -> 42  # Placeholder implementation

let private_trim = { text: String } -> text  # Private helper
