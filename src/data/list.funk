# Data.List module - List operations  
# File: src/data/list.funk -> Module: Data.List

expose type IntList = | Empty, Cons { head: Int, tail: IntList } |

expose let empty = Empty

expose let isEmpty = { list: IntList } ->
  match list {
    Empty -> true
    Cons { head, tail } -> false
  }

expose let head = { list: IntList } ->
  match list {
    Empty -> 0
    Cons { head, tail } -> head
  }

let private_length = { list: IntList } -> 42  # Private helper
