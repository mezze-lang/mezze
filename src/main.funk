# Main module demonstrating module system
# File: src/main.funk -> Module: Main

access Utils.String.{ capitalize, length }
access Data.List.{ List, map, empty }  
access Json.Parser.{ parse, JsonValue }

let demo = do
  let text = "hello world"
  let capitalized = capitalize { text }
  let textLength = length { text }
  
  let numbers = Data.List.Cons { head = 1, tail = Data.List.Cons { head = 2, tail = Data.List.empty } }
  let doubled = map { f = { item } -> item * 2, list = numbers }
  
  let jsonResult = parse { input = "{\"name\": \"Alice\"}" }
  
  { 
    original = text, 
    capitalized, 
    length = textLength,
    json = jsonResult
  }
