use std::effects::log::{ Console, println }
use std::int::{ to_str }

ability Money for 'a where {
  cents: { it: 'a } -> Int
}

type Eur = | Eur { amount: Int } |
type Usd = | Usd { amount: Int } |

impl Money for Eur where {
  cents = { it } -> match it is
    Eur { amount } -> amount
}

impl Money for Usd where {
  cents = { it } -> match it is
    Usd { amount } -> amount
}

let main = {} -> perform Console in do
  # ONLY calls the Eur impl — the Usd impl merely exists.
  let a = Eur { amount = 4200 }
  println { msg = "$(a.cents {}.to_str {}) cents" }
