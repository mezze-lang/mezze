# Pattern Matching Test

expose type Color = | Red, Blue, Green |
expose type Result = | Success { value: Int }, Error { message: String } |

let red = Red
let success = Success { value = 42 }
let person = { name = "Alice", age = 30 }

# Variable pattern binding
let colorVar = match red {
  color -> "matched color"
}

# Record pattern matching
let personInfo = match person {
  { name, age } -> name ++ " is " ++ "years old"
}

# Variant with data pattern matching  
let resultValue = match success {
  Success { value } -> value
  Error { message } -> 0
}

# Wildcard pattern
let isRed = match red {
  Red -> true
  _ -> false
}
