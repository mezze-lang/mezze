# Dockerfile for testing Mezze CLI portability
FROM ubuntu:24.04

# Install basic utilities and Java 24 dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install GraalVM 24.0.2 to match local environment
# Detect architecture and download appropriate version
RUN mkdir -p /opt/graalvm && \
    cd /opt/graalvm && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        GRAAL_ARCH="x64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        GRAAL_ARCH="aarch64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    wget -q "https://download.oracle.com/graalvm/24/archive/graalvm-jdk-24.0.2_linux-${GRAAL_ARCH}_bin.tar.gz" && \
    tar -xzf graalvm-jdk-24.0.2_linux-${GRAAL_ARCH}_bin.tar.gz && \
    rm graalvm-jdk-24.0.2_linux-${GRAAL_ARCH}_bin.tar.gz && \
    ln -s /opt/graalvm/graalvm-jdk-24.0.2+11.1 /opt/graalvm/current

ENV JAVA_HOME=/opt/graalvm/current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# No additional dependencies needed! mez build uses only javac + jar (included in GraalVM)

# Create a test user (not root)
RUN useradd -m -s /bin/bash mezzeuser

# Create test project directory
WORKDIR /home/mezzeuser/test_project

# Copy test project files
COPY docker-test-project/ /home/mezzeuser/test_project/

# Set ownership
RUN chown -R mezzeuser:mezzeuser /home/mezzeuser

# Switch to test user
USER mezzeuser

# This will be the location where we copy the CLI
# We'll copy it to /home/mezzeuser/mezze-cli during testing
ENV PATH="/home/mezzeuser/mezze-cli/bin:${PATH}"

# Default command
CMD ["/bin/bash"]
