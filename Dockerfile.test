# Dockerfile for testing Funk CLI portability
FROM ubuntu:24.04

# Install basic utilities and Java 24 dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install GraalVM 24.0.2 to match local environment
# This includes java, javac, and jar - everything we need for funk build!
RUN mkdir -p /opt/graalvm && \
    cd /opt/graalvm && \
    wget -q https://download.oracle.com/graalvm/24/archive/graalvm-jdk-24.0.2_linux-aarch64_bin.tar.gz && \
    tar -xzf graalvm-jdk-24.0.2_linux-aarch64_bin.tar.gz && \
    rm graalvm-jdk-24.0.2_linux-aarch64_bin.tar.gz && \
    ln -s /opt/graalvm/graalvm-jdk-24.0.2+11.1 /opt/graalvm/current

ENV JAVA_HOME=/opt/graalvm/current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# No additional dependencies needed! funk build uses only javac + jar (included in GraalVM)

# Create a test user (not root)
RUN useradd -m -s /bin/bash funkuser

# Create test project directory
WORKDIR /home/funkuser/test_project

# Copy test project files
COPY docker-test-project/ /home/funkuser/test_project/

# Set ownership
RUN chown -R funkuser:funkuser /home/funkuser

# Switch to test user
USER funkuser

# This will be the location where we copy the CLI
# We'll copy it to /home/funkuser/funk-cli during testing
ENV PATH="/home/funkuser/funk-cli/bin:${PATH}"

# Default command
CMD ["/bin/bash"]
