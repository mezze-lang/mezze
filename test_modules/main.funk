# Main module demonstrating Rust-style imports
# File: test_modules/main.funk

# Declare modules
mod utils
mod data

# Import specific items
access utils::add
access utils::multiply
access data::Point

# Use imported items
let sum = add { x = 5, y = 3 }
let product = multiply { x = 4, y = 6 }

let point1 = { x = 0, y = 0 }
let point2 = { x = 3, y = 4 }
