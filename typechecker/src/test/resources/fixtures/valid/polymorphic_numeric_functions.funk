# Polymorphic numeric functions using Num 'a
let addTwo = { x } -> x + x        # expected: addTwo : { x: Num 'b } -> Num 'b
let square = { x } -> x * x        # expected: square : { x: Num 'b } -> Num 'b  
let isPositive = { x } -> x > 0    # expected: isPositive : { x: Int } -> Boolean

# Using with different numeric types (Int is default)
let intResult = addTwo { x = 21 }           # expected: intResult : Num 'a
let floatResult = addTwo { x = 3.14 }       # expected: floatResult : Num 'a
let fracResult = addTwo { x = 1/2 }         # expected: fracResult : Num 'a

# Using Nat requires explicit constraint
let natFunction = { x: Nat } -> x + x       # Function that forces Nat
let natResult = natFunction { x = 21 }      # expected: natResult : Nat

# Square function
let intSquare = square { x = 7 }            # expected: intSquare : Num 'a
let fracSquare = square { x = 3/4 }         # expected: fracSquare : Num 'a

# Comparison function
let intPositive = isPositive { x = 42 }     # expected: intPositive : Boolean
let intZero = isPositive { x = 0 }          # expected: intZero : Boolean

intResult
