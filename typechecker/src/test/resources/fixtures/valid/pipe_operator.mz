# Pipe operator tests
# Basic pipe operator
let square = { x } -> x * x  # expected: square : { x: 'a } with NumMul 'a 'a having 'out = 'b -> 'b

# `add_ten` is now polymorphic in its result (class-param `having 'out` stays a
# var until the receiver is pinned), consistent with `add`/`square` below — the
# result no longer freezes to Int just because the literal `10` fixes one operand.
let add_ten = { x } -> x + 10  # expected: add_ten : { x: 'a } with NumAdd Int 'a having 'out = 'b -> 'b

let result1 = 5 |> square { x = @ }  # expected: result1 : Int

# `add_ten`'s deferred `having 'out` chained into `square`'s own deferred `having
# 'out` leaves the pipe result polymorphic (a class-param `having 'out` chained
# through a pipe is not eagerly resolved — same as result3/result4).
let result2 = 5 |> add_ten { x = @ } |> square { x = @ }  # expected: result2 : 'a

# Pipe with partial application
let add = { x, y } -> x + y  # expected: add : { x: 'a, y: 'b } with NumAdd 'b 'a having 'out = 'c -> 'c

let multiply = { x, y } -> x * y  # expected: multiply : { x: 'a, y: 'b } with NumMul 'b 'a having 'out = 'c -> 'c

let double = multiply { x = 2 }  # expected: double : { y: 'a } with NumMul 'a Int having 'out = 'b -> 'b

# `double` is now polymorphic (NumMul 'a Int having 'out), so piping a deferred
# result through it leaves the pipe result polymorphic (same as result4 — a
# class-param `having 'out` chained through a pipe is not eagerly resolved).
let result3 = 7 |> add { x = @, y = 3 } |> double { y = @ }  # expected: result3 : 'a

# Pipe with arithmetic precedence. `5 + 3` feeds a deferred NumAdd `having 'out`
# result into `square`, whose own NumMul `having 'out` stays deferred too, so the
# pipe result is left polymorphic (same as the NumAdd `having 'out` behavior — a
# class-param `having 'out` chained through a pipe is not eagerly resolved).
let result4 = 5 + 3 |> square { x = @ }  # expected: result4 : 'a

result1
