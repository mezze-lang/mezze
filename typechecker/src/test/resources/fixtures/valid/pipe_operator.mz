# Pipe operator tests
# Basic pipe operator
let square = { x } -> x * x  # expected: square : { x: 'a } with NumMul 'a 'a having 'out = 'b -> 'b

# `add_ten` is polymorphic in its RESULT (the class-param `having 'out` stays a var
# until the receiver is pinned), consistent with `add`/`square` below — the signature
# does not freeze to Int just because the literal `10` fixes one operand.
let add_ten = { x } -> x + 10  # expected: add_ten : { x: 'a } with NumAdd Int 'a having 'out = 'b -> 'b

let result1 = 5 |> square { x = @ }  # expected: result1 : Int

# A polymorphic `having 'out` signature does NOT mean a polymorphic call RESULT.
# Chaining one deferred `having 'out` into another resolves: the inner NumAdd settles
# first, which makes the outer NumMul's class-arg tuple concrete, and the associated
# result follows. (This used to infer `'a` — finalizeDeferredAbilities made a single
# pass, so the outer resolution was never retried after the inner one landed.)
let result2 = 5 |> add_ten { x = @ } |> square { x = @ }  # expected: result2 : Int

# Pipe with partial application
let add = { x, y } -> x + y  # expected: add : { x: 'a, y: 'b } with NumAdd 'b 'a having 'out = 'c -> 'c

let multiply = { x, y } -> x * y  # expected: multiply : { x: 'a, y: 'b } with NumMul 'b 'a having 'out = 'c -> 'c

let double = multiply { x = 2 }  # expected: double : { y: 'a } with NumMul 'a Int having 'out = 'b -> 'b

# `double` keeps a polymorphic signature (NumMul 'a Int having 'out), and piping a
# deferred result through it still resolves — every operand here is an Int literal.
let result3 = 7 |> add { x = @, y = 3 } |> double { y = @ }  # expected: result3 : Int

# Pipe with arithmetic precedence. `5 + 3` feeds a deferred NumAdd `having 'out`
# into `square`'s own deferred NumMul `having 'out`; both settle, innermost first.
let result4 = 5 + 3 |> square { x = @ }  # expected: result4 : Int

result1
