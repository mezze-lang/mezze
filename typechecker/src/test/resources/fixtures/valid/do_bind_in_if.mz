# Design doc 3d: `<-` inside the outer do, with an `if` choosing between
# two values. The if's two branches must agree in type — both are `Str`
# here — and the outer do wraps the chosen value in Ok {val = ...}.

type User = { id: Int, active: Bool, name: Str }
type Err = | NotFound |

let find_user : { id: Int } -> Result User Err = { id } ->
  if id > 0 then Ok { val = { id = id, active = True, name = "u" } }
  else Err { error = NotFound }

let foo = { x } -> do
  user <- find_user { id = x }
  if user.active then user.name else "inactive"
