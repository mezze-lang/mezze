# Design doc 3e: `<-` inside one arm of a `match`. Match arms must all
# agree in type. Here the `Some` arm uses a nested do-with-`<-` producing
# Int; the `None` arm returns Int. Outer do wraps in Ok at the end.

let process : { v: Int } -> Option Int = { v } -> Some { val = v * 2 }

let foo = { x } -> do
  let result <- match x is
    Some { val = v } -> process { v = v }
    None -> Some { val = 0 }
  result
