# Record Update Tests - Valid Cases

# Basic record update
let person = {name = "Alice", age = 30, city = "London"}
let updatedPerson = {person | age = 31, city = "Paris"}
# expected: updatedPerson : { name: String, age: Int, city: String }

# Single field update
let singleUpdate = {person | name = "Bob"}
# expected: singleUpdate : { name: String, age: Int, city: String }

# Empty update (should work and return same type)
let emptyUpdate = {person | }
# expected: emptyUpdate : { name: String, age: Int, city: String }

# Nested record update
let nested = { x = 1, y = { z = 2, w = 3 } }
let nestedUpdate1 = { nested | x = 10 }
# expected: nestedUpdate1 : { x: Int, y: { z: Int, w: Int } }

let nestedUpdate2 = { nested | y.z = 42 }
# expected: nestedUpdate2 : { x: Int, y: { z: Int, w: Int } }

let nestedUpdate3 = { nested | y.w = nested.x + 5 }
# expected: nestedUpdate3 : { x: Int, y: { z: Int, w: Int } }

# Multiple nested updates
let multipleNested = { nested | x = 99, y.z = 100, y.w = 200 }
# expected: multipleNested : { x: Int, y: { z: Int, w: Int } }

# Record update with expressions
let calc = {a = 10, b = 20}
let calcUpdate = {calc | a = calc.b * 2, b = calc.a + calc.b}
# expected: calcUpdate : { a: Int, b: Int }
