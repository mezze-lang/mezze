# Design doc 3c: Mixed Option and Result in same do-block. The Exception
# row's 'error parameter unifies across both — HttpError (variant) and
# NoneOpt (synthetic variant from Option) row-union into the resulting
# Result _ | HttpError, NoneOpt |.

type User = { id: Int, email: Option Str }
type HttpError = | NotFound |

let find_user : { id: Int } -> Result User HttpError = { id } ->
  if id > 0 then Ok { val = { id = id, email = Some { val = "a@b.c" } } }
  else Err { error = NotFound }

let fetch_email = { id } -> do
  user  <- find_user { id = id }
  email <- user.email
  email
