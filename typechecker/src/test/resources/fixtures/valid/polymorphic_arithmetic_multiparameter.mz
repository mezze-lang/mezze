# Test polymorphic arithmetic with 3+ parameters
let complex = { x, y, z } -> x + y  # expected: complex : { x: 'a, y: 'b, z: 'c } with NumAdd 'b 'a having 'out = 'd -> 'd

let fourParam = { x, y, z, w } -> x + y  # expected: fourParam : { x: 'a, y: 'b, z: 'c, w: 'd } with NumAdd 'b 'a having 'out = 'e -> 'e

let recordResult = { x, y, z } -> { result = x + y, other = z }  # expected: recordResult : { x: 'a, y: 'b, z: 'c } with NumAdd 'b 'a having 'out = 'd -> { result: 'd, other: 'c }

# Test do expressions with bidirectional type checking
let doMultiple = { x, y, z } -> do
  let sum = x + y
  let product = sum * z
  product

let intResult = complex { x = 21, y = 42, z = "test" }  # expected: intResult : Int

let floatResult = complex { x = 21.5, y = 42.5, z = True }  # expected: floatResult : Float

let doResult = doMultiple { x = 1, y = 2, z = 3 }  # expected: doResult : Int
