# Open record types (structural typing)
let processUser: { user: { name: String, age: Int, ... } } -> String = {user} -> user.name ++ " is " ++ intToString {val = user.age}

let user1 = {name = "Alice", age = 30, city = "NYC"}
let user2 = {name = "Bob", age = 25, email = "bob@test.com"}

let result1 = processUser {user = user1}
let result2 = processUser {user = user2}

result1
