# Test type variable unification across match branches with constraints
# Simple parameter unification
let unifySimple = { x, y } -> match True is
  True -> x + y
  False -> x - y


let unifyVariantParam = { v, x } -> match v is
  Val { a } -> a + x


let unifyMultiField = { v1, v2 } -> match v1 is
  A { x } -> match v2 is
    B { y } -> x + y


let unifyRecord = { r, x } -> r.field + x  # expected: unifyRecord : { r: { field: 'a }, x: 'a } with NumAdd 'a -> 'a

# Unify across nested matches
let unifyNested = { outer, x } -> match outer is
  Outer { inner } -> match inner is
    Inner { val } -> val + x


let unifyChain = { a, b, c, d } -> match True is
  True -> a + b
  False -> c + d


let unifyAll = { v, r, x, y } -> match v is
  Val { z } -> z + r.field + x + y


let multiOp = { x, y } -> match True is
  True -> x + y - x * y
  False -> x


let transitive = { a, b, c } -> match True is
  True -> a + b
  False -> b + c


let unifyCompare = { x, y, z } -> match x < y is
  True -> z
  False -> x


let deepNest = { v } -> match v is
  A { b } -> match b is
    B { c } -> match c is
      C { d } -> d + 1


let preserveConstraint = { mode, x, y, z } -> match mode is
  One -> x + y
  Two -> y + z
  Three -> x + z


preserveConstraint { mode = One, x = 1, y = 2, z = 3 }
