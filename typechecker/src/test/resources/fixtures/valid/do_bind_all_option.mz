# Design doc 3b: All-Option chain. Both binds throw NoneOpt; the do-block
# produces Result _ | NoneOpt | — the synthetic variant wraps every None.

let get_first : { xs: [Int] } -> Option Int = { xs } ->
  if xs.size {} > 0 then Some { val = 1 } else None

let halve : { n: Int } -> Option Int = { n } ->
  if n > 0 then Some { val = n / 2 } else None

let lookup = { xs } -> do
  cache <- get_first { xs = xs }
  value <- halve { n = cache }
  value
