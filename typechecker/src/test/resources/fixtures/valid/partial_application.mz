# Partial application (currying) tests
# Basic partial application with closed records
let add = { x, y } -> x + y  # expected: add : { x: 'a, y: 'b } with NumAdd 'b 'a having 'out = 'c -> 'c

# Heterogeneous `+`: fixing the left operand to Int no longer forces the right
# operand (or result) to Int — the NumAdd constraint stays open on the right.
let add_five = add { x = 5 }  # expected: add_five : { y: 'a } with NumAdd 'a Int having 'out = 'b -> 'b

let result1 = add_five { y = 10 }  # expected: result1 : Int

# Partial application with different parameter order
let sub = { x, y } -> x - y  # expected: sub : { x: 'a, y: 'b } with NumSub 'b 'a having 'out = 'c -> 'c

# Heterogeneous `-`: fixing the right operand to Int leaves the left operand open
# (multiple NumSub impls have r = Int); the result stays polymorphic (`having 'out`
# is not eagerly resolved while the left operand is still a var).
let sub_from_10 = sub { y = 10 }  # expected: sub_from_10 : { x: 'a } with NumSub Int 'a having 'out = 'b -> 'b

let result2 = sub_from_10 { x = 15 }  # expected: result2 : Int

# Chained partial application
let add3 = { x, y, z } -> x + y + z  # expected: add3 : { x: 'a, y: 'b, z: 'c } with NumAdd 'b 'a having 'out = 'e, NumAdd 'c 'e having 'out = 'd -> 'd

let add_x = add3 { x = 1 }  # expected: add_x : { y: 'a, z: 'b } with NumAdd 'a Int having 'out = 'd, NumAdd 'b 'd having 'out = 'c -> 'c

let add_xy = add_x { y = 2 }  # expected: add_xy : { z: 'a } with NumAdd 'a Int having 'out = 'b -> 'b

let result3 = add_xy { z = 3 }  # expected: result3 : Int

# Partial application with string types
let concat3 = { a, b, c } -> "$(a)$(b)$(c)"  # expected: concat3 : { a: Str, b: Str, c: Str } -> Str

let with_hello = concat3 { a = "hello" }  # expected: with_hello : { b: Str, c: Str } -> Str

let with_hello_world = with_hello { b = " world" }  # expected: with_hello_world : { c: Str } -> Str

let result4 = with_hello_world { c = "!" }  # expected: result4 : Str

# Partial application with polymorphic function
let first = { x, y } -> x  # expected: first : { x: 'a, y: 'b } -> 'a

let get_5 = first { x = 5 }  # expected: get_5 : { y: 'a } -> Int

let result5 = get_5 { y = "ignored" }  # expected: result5 : Int

result1
