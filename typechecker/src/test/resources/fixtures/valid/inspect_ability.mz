# Test Inspect ability for built-in types
# Inspect is available for all primitive types.
# After #218, inferred ability constraints from the body propagate to the
# function's arrow type so the monomorphizer can resolve them at call sites.
let inspectInt = { x } -> x.to_dbg_str {}  # expected: inspectInt : { x: 'a } with Inspect 'a -> Str

let inspectBool = { b } -> b.to_dbg_str {}  # expected: inspectBool : { b: 'a } with Inspect 'a -> Str

let inspectStr = { s } -> s.to_dbg_str {}  # expected: inspectStr : { s: 'a } with Inspect 'a -> Str

let inspectFloat = { f } -> f.to_dbg_str {}  # expected: inspectFloat : { f: 'a } with Inspect 'a -> Str

let inspectNat = { n } -> n.to_dbg_str {}  # expected: inspectNat : { n: 'a } with Inspect 'a -> Str

let inspectFrac = { fr } -> fr.to_dbg_str {}  # expected: inspectFrac : { fr: 'a } with Inspect 'a -> Str

let polyInspect = { x } -> x.to_dbg_str {}  # expected: polyInspect : { x: 'a } with Inspect 'a -> Str

# Using inspect in a match expression
let inspectMatch = { opt } -> match opt is
  Some { val } -> val.to_dbg_str {}
  None -> "none"


let inspectCond = { flag, x, y } -> if flag then x.to_dbg_str {} else y.to_dbg_str {}  # expected: inspectCond : { flag: Bool, x: 'a, y: 'b } with Inspect 'a, Inspect 'b -> Str

# Combined with NumAdd: both constraints surface.
let inspectAndAdd = { x, y } -> (x + y).to_dbg_str {}  # expected: inspectAndAdd : { x: 'a, y: 'a } with NumAdd 'a, Inspect 'a -> Str

let inspectField = { r } -> r.value.to_dbg_str {}  # expected: inspectField : { r: { value: 'a } } with Inspect 'a -> Str

# Inspect with pattern matching on variants with data - Inspect is implicit
let inspectVariantData = { v } -> match v is
  Value { x } -> x.to_dbg_str {}
  Empty -> "empty"


let multiInspect = { a, b, c } -> "$(a.to_dbg_str {})$(b.to_dbg_str {})$(c.to_dbg_str {})"  # expected: multiInspect : { a: 'a, b: 'b, c: 'c } with Inspect 'a, Inspect 'b, Inspect 'c -> Str

# Inspect with list elements - Inspect is implicit
let inspectListHead = { lst } -> match lst is
  Cons { head, tail } -> head.to_dbg_str {}
  Nil -> "empty"


inspectInt { x = 42 }
