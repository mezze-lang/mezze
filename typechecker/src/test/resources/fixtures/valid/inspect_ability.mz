# Test Inspect ability for built-in types
# Inspect is available for all primitive types
# Inspect with Int (polymorphic, Inspect is implicit)
let inspectInt = { x } -> x.to_dbg_str {}  # expected: inspectInt : { x: 'a } -> Str

# Inspect with Bool (polymorphic, Inspect is implicit)
let inspectBool = { b } -> b.to_dbg_str {}  # expected: inspectBool : { b: 'a } -> Str

# Inspect with String (polymorphic, Inspect is implicit)
let inspectStr = { s } -> s.to_dbg_str {}  # expected: inspectStr : { s: 'a } -> Str

# Inspect with Float (polymorphic, Inspect is implicit)
let inspectFloat = { f } -> f.to_dbg_str {}  # expected: inspectFloat : { f: 'a } -> Str

# Inspect with Nat (polymorphic, Inspect is implicit)
let inspectNat = { n } -> n.to_dbg_str {}  # expected: inspectNat : { n: 'a } -> Str

# Inspect with Frac (polymorphic, Inspect is implicit)
let inspectFrac = { fr } -> fr.to_dbg_str {}  # expected: inspectFrac : { fr: 'a } -> Str

# Polymorphic inspect - Inspect is implicit, no constraint shown
let polyInspect = { x } -> x.to_dbg_str {}  # expected: polyInspect : { x: 'a } -> Str

# Using inspect in a match expression - Inspect is implicit
let inspectMatch = { opt } -> match opt is
  Some { val } -> val.to_dbg_str {}
  None -> "none"


let inspectCond = { flag, x, y } -> if flag then x.to_dbg_str {} else y.to_dbg_str {}  # expected: inspectCond : { flag: Bool, x: 'a, y: 'b } -> Str

# Inspect in combination with other abilities - only NumAdd shown (Inspect is implicit)
let inspectAndAdd = { x, y } -> (x + y).to_dbg_str {}  # expected: inspectAndAdd : { x: 'a, y: 'a } with NumAdd 'a -> Str

# Inspect with record field access - Inspect is implicit
let inspectField = { r } -> r.value.to_dbg_str {}  # expected: inspectField : { r: { value: 'a } } -> Str

# Inspect with pattern matching on variants with data - Inspect is implicit
let inspectVariantData = { v } -> match v is
  Value { x } -> x.to_dbg_str {}
  Empty -> "empty"


let multiInspect = { a, b, c } -> "$(a.to_dbg_str {})$(b.to_dbg_str {})$(c.to_dbg_str {})"  # expected: multiInspect : { a: 'a, b: 'b, c: 'c } -> Str

# Inspect with list elements - Inspect is implicit
let inspectListHead = { lst } -> match lst is
  Cons { head, tail } -> head.to_dbg_str {}
  Nil -> "empty"


inspectInt { x = 42 }
