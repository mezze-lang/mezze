# Should fail: an AUTHOR-WRITTEN closed record rejects extra fields.
# (An inferred param is now OPEN and would accept the extras — see
# InferredParamOpenTest; the closed rejection needs an explicit annotation.)
let processUser: { user: { name: Str, age: Int } } -> Str = { user } -> user.name

let user1 = { name = "Alice", age = 30, city = "NYC" }

let result = processUser { user = user1 }

result
