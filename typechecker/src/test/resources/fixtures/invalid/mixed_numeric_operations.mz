# Frac does NOT participate in numeric coercion: it has only a diagonal
# `NumAdd Frac for Frac` impl, so mixing Frac with any other numeric type is a
# type error. (Int + Float now coerces to Float and is NOT an error, so it is
# deliberately not tested here.)
use std::frac::{ from_int }

let floatVal = 3.14  # expected: floatVal : Float

let fracVal = from_int { n = 1 }  # expected: fracVal : Frac

# Type error: no `NumAdd Float for Frac` impl (Frac is coercion-isolated).
let mixed = floatVal + fracVal

mixed
