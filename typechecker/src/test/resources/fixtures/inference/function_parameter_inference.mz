use std::int

let add = { x, y } -> x + y  # expected: add : { x: 'a, y: 'b } with NumAdd 'b 'a having 'out = 'c -> 'c

let getAge = { person } -> person.age  # expected: getAge : { person: { age: 'a } } -> 'a

let processUser = { user } -> "$(user.name) is $(int::to_str { n = user.age })"  # expected: processUser : { user: { name: Str, age: Int } } -> Str

