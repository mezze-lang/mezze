use std::int

# Complex type inference with nested structures
let calculator = {operation, x, y} -> match operation is
  Add -> x + y
  Multiply -> x * y
  Divide -> if y == 0 then 0 else x / y

let formatResult = {calc, op, a, b} -> "Result: $(int::to_string {n = calc {operation = op, x = a, y = b} })"

formatResult
