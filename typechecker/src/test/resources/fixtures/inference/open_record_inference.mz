# Simple nested inference
let simpleNested = {data = {count = 5, active = False}, meta = {version = 1, timestamp = 0}, ...}
# expected: simpleNested : { data: { count: Int, active: Bool }, meta: { version: Int, timestamp: Int }, ... }

