# Mix of explicit and inferred types
let explicitAdd : { x: Int, y: Int } -> Int = { x, y } -> x + y

let inferredMultiply = { x, y } -> x * y

let combine : { f: { x: Int, y: Int } -> Int, g: { x: Int, y: Int } -> Int, a: Int, b: Int } -> Int = { f, g, a, b } ->
  f { x = a, y = b } + g { x = a, y = b }

let result = combine { f = explicitAdd, g = inferredMultiply, a = 5, b = 3 }

result
