package com.funk.language.typechecker

import com.funk.language.ast.*

/**
 * Modern bidirectional type checker based on constraint-based type inference
 * 
 * This is a minimal implementation that focuses on constraint propagation
 * for qualified calls like int::to_string to force concrete types.
 */
class BidirectionalTypeChecker(
    private val moduleResolver: ModuleResolver = ModuleResolver()
) {
    
    // Type inference context
    private val typeContext = mutableMapOf<String, TypeScheme>()
    private val constraints = mutableListOf<TypeConstraint>()
    private val abilityConstraints = mutableListOf<AbilityConstraint>()
    
    // Module context for qualified name resolution
    private val moduleContext = mutableMapOf<String, Module>()
    
    // Fresh variable generation using proper scope-based naming
    private fun freshTypeVar(): TypeVar = TypeVar.fresh()
    private fun freshUnificationVar(): TypeVar = TypeVar.fresh()
    
    /**
     * Type constraints for unification
     */
    sealed class TypeConstraint {
        data class Equality(val left: FunkType, val right: FunkType) : TypeConstraint()
        data class Instantiation(val polyType: TypeScheme, val monoType: FunkType) : TypeConstraint()
    }
    
    /**
     * Ability constraints for typeclasses/abilities
     */
    data class AbilityConstraint(
        val ability: String,
        val type: FunkType,
        val context: Map<String, Any> = emptyMap()
    )
    
    /**
     * Bidirectional type inference entry point
     */
    fun inferProgram(program: Program): Program {
        setupBuiltinTypes()
        
        val typedItems = program.items.map { item ->
            when (item) {
                is LetBinding -> inferLetBinding(item)
                else -> item // Handle other items as needed
            }
        }
        
        return program.copy(items = typedItems)
    }
}    
 
   /**
     * Infer type for let binding
     */
    private fun inferLetBinding(binding: LetBinding): LetBinding {
        val inferredType = synthesizeType(binding.expression)
        
        // Solve constraints to resolve polymorphic types to concrete types
        val substitution = solveConstraints()
        val resolvedType = applySubstitution(inferredType, substitution)
        
        val generalizedType = generalize(resolvedType)
        
        // Add to context for future references
        typeContext[binding.variableName] = generalizedType
        
        return binding.copy(inferredType = resolvedType)
    }
    
    /**
     * Synthesize type (⇒ mode) - infer the type of an expression
     */
    private fun synthesizeType(expr: Expression): FunkType {
        return when (expr) {
            is IntLiteral -> FunkType.IntType
            is FloatLiteral -> FunkType.FloatType
            is StringLiteral -> FunkType.StringType
            is BooleanLiteral -> FunkType.BooleanType
            
            is Identifier -> synthesizeIdentifier(expr)
            is LambdaExpression -> synthesizeLambda(expr)
            is FunctionCall -> synthesizeFunctionCall(expr)
            is RecordLiteral -> synthesizeRecord(expr)
            is IfExpression -> synthesizeIfExpression(expr)
            is DoExpression -> synthesizeDoExpression(expr)
            
            else -> throw TypeCheckError("Cannot synthesize type for expression: $expr")
        }
    }
    
    /**
     * Synthesize identifier type with polymorphic instantiation
     */
    private fun synthesizeIdentifier(expr: Identifier): FunkType {
        // Check if it's a qualified name (module::function)
        if (expr.name.contains("::")) {
            return resolveQualifiedName(expr)
        }
        
        // Check local context first
        typeContext[expr.name]?.let { scheme ->
            return instantiate(scheme)
        }
        
        // Handle built-in operators
        return when (expr.name) {
            "+", "-", "*", "(+)", "(-)", "(*)" -> createArithmeticOperator()
            "/", "(/)" -> createDivisionOperator()
            "==", "!=", "<", ">", "<=", ">=", "(==)", "(!=)", "(<)", "(>)", "(<=)", "(>=)" -> createComparisonOperator()
            "++", "(++)" -> createStringConcatOperator()
            else -> {
                // Throw error for undefined variables
                throw TypeCheckError("Undefined variable: ${expr.name}", expr, ErrorType.UNDEFINED_VARIABLE)
            }
        }
    }    

    /**
     * Synthesize lambda type
     */
    private fun synthesizeLambda(expr: LambdaExpression): FunkType {
        return when (val params = expr.parameters) {
            is UntypedParameters -> {
                // Create fresh type variables for parameters
                val paramTypes = params.names.associateWith { 
                    FunkType.VarType(freshUnificationVar()) 
                }
                
                // Add parameters to context
                val oldContext = typeContext.toMap()
                paramTypes.forEach { (name, type) ->
                    typeContext[name] = TypeScheme(emptySet(), type)
                }
                
                // Infer body type
                val bodyType = synthesizeType(expr.body)
                
                // Restore context
                typeContext.clear()
                typeContext.putAll(oldContext)
                
                // Create function type
                val rowVar = if (params.isOpen) RowVar.fresh() else null
                val paramType = FunkType.RecordType(paramTypes, rowVar)
                FunkType.FunctionType(paramType, bodyType)
            }
            
            is TypedParameters -> {
                // Handle explicitly typed parameters - simplified for now
                val paramType = FunkType.VarType(freshUnificationVar())
                val bodyType = synthesizeType(expr.body)
                FunkType.FunctionType(paramType, bodyType)
            }
        }
    }
    
    /**
     * Synthesize function call type with proper constraint generation and concrete type propagation
     */
    private fun synthesizeFunctionCall(expr: FunctionCall): FunkType {
        val functionType = synthesizeType(expr.function)
        val argumentType = synthesizeType(expr.arguments)
        
        return when (functionType) {
            is FunkType.FunctionType -> {
                // Add constraint: argument type must match parameter type
                addConstraint(TypeConstraint.Equality(argumentType, functionType.paramType))
                
                // ENHANCED: Handle qualified calls with concrete type propagation
                val function = expr.function
                if (function is Identifier && function.name.contains("::")) {
                    handleQualifiedCall(function, argumentType, functionType)
                }
                
                // Generate ability constraints for arithmetic operations
                if (function is Identifier && function.name in setOf("+", "-", "*", "/", "(+)", "(-)", "(*)", "(/)", "==", "!=", "<", ">", "<=", ">=", "(==)", "(!=)", "(<)", "(>)", "(<=)", "(>=)")) {
                    generateArithmeticConstraints(function.name, argumentType)
                }
                
                functionType.returnType
            }
            
            is FunkType.VarType -> {
                // Function type is unknown, create constraints
                val returnType = FunkType.VarType(freshUnificationVar())
                val expectedFunctionType = FunkType.FunctionType(argumentType, returnType)
                
                addConstraint(TypeConstraint.Equality(functionType, expectedFunctionType))
                
                returnType
            }
            
            else -> {
                throw TypeCheckError("Cannot apply non-function type: $functionType")
            }
        }
    } 
   
    /**
     * Handle qualified calls with concrete type propagation
     */
    private fun handleQualifiedCall(function: Identifier, argumentType: FunkType, functionType: FunkType.FunctionType) {
        val parts = function.name.split("::")
        if (parts.size == 2) {
            val moduleName = parts[0]
            val functionName = parts[1]
            
            // Special handling for known module functions that force concrete types
            when (moduleName) {
                "int" -> {
                    when (functionName) {
                        "to_string" -> {
                            // int::to_string forces its argument to be Int
                            if (argumentType is FunkType.RecordType && argumentType.fields.containsKey("value")) {
                                val valueType = argumentType.fields["value"]!!
                                addConstraint(TypeConstraint.Equality(valueType, FunkType.IntType))
                            }
                        }
                    }
                }
            }
        }
    }
    
    /**
     * Generate ability constraints for arithmetic operations
     */
    private fun generateArithmeticConstraints(operator: String, argumentType: FunkType) {
        if (argumentType is FunkType.RecordType && 
            argumentType.fields.containsKey("left") && 
            argumentType.fields.containsKey("right")) {
            
            val leftType = argumentType.fields["left"]!!
            val rightType = argumentType.fields["right"]!!
            
            // Add constraint that left and right types must be equal
            addConstraint(TypeConstraint.Equality(leftType, rightType))
            
            // Add ability constraint
            val abilityName = when (operator) {
                "+", "(+)" -> "NumAdd"
                "-", "(-)" -> "NumSub"
                "*", "(*)" -> "NumMul"
                "/", "(/)" -> "NumDiv"
                "==", "!=", "(==)", "(!=)" -> "Eq"
                "<", ">", "<=", ">=", "(<)", "(>)", "(<=)", "(>=)" -> "Ord"
                else -> "NumAdd"
            }
            
            abilityConstraints.add(AbilityConstraint(abilityName, leftType))
        }
    }
    
    /**
     * Synthesize record literal type
     */
    private fun synthesizeRecord(expr: RecordLiteral): FunkType {
        val fieldTypes = mutableMapOf<String, FunkType>()
        
        // Handle field entries
        for (entry in expr.getFieldEntries()) {
            val fieldType = entry.value?.let { synthesizeType(it) } 
                ?: FunkType.VarType(freshUnificationVar())
            fieldTypes[entry.name] = fieldType
        }
        
        // Determine if record is open or closed
        val rowVar = if (expr.restField != null) RowVar.fresh() else null
        
        return FunkType.RecordType(fieldTypes, rowVar)
    }    

    /**
     * Synthesize if expression type
     */
    private fun synthesizeIfExpression(expr: IfExpression): FunkType {
        val conditionType = synthesizeType(expr.condition)
        addConstraint(TypeConstraint.Equality(conditionType, FunkType.BooleanType))
        
        val thenType = synthesizeType(expr.thenBranch)
        val elseType = synthesizeType(expr.elseBranch)
        
        addConstraint(TypeConstraint.Equality(thenType, elseType))
        
        return thenType
    }
    
    /**
     * Synthesize do expression type
     */
    private fun synthesizeDoExpression(expr: DoExpression): FunkType {
        // Process each statement in the do block
        for (statement in expr.statements.dropLast(1)) {
            when (statement) {
                is LetStatement -> {
                    val bindingType = synthesizeType(statement.expression)
                    typeContext[statement.variableName] = TypeScheme(emptySet(), bindingType)
                }
                is ExpressionStatement -> {
                    synthesizeType(statement.expression)
                }
            }
        }
        
        // The type of the do expression is the type of the last statement
        val lastStatement = expr.statements.last()
        return when (lastStatement) {
            is LetStatement -> {
                val bindingType = synthesizeType(lastStatement.expression)
                typeContext[lastStatement.variableName] = TypeScheme(emptySet(), bindingType)
                bindingType
            }
            is ExpressionStatement -> synthesizeType(lastStatement.expression)
        }
    }
    
    /**
     * Create arithmetic operator type with ability constraints
     */
    private fun createArithmeticOperator(): FunkType {
        val typeVar = freshTypeVar()
        val varType = FunkType.VarType(typeVar)
        
        abilityConstraints.add(AbilityConstraint("NumAdd", varType))
        
        return FunkType.FunctionType(
            FunkType.RecordType(mapOf("left" to varType, "right" to varType)),
            varType
        )
    }
    
    /**
     * Create division operator type with ability constraints
     */
    private fun createDivisionOperator(): FunkType {
        val typeVar = freshTypeVar()
        val varType = FunkType.VarType(typeVar)
        
        abilityConstraints.add(AbilityConstraint("NumDiv", varType))
        
        return FunkType.FunctionType(
            FunkType.RecordType(mapOf("left" to varType, "right" to varType)),
            varType
        )
    }
    
    /**
     * Create comparison operator type with ability constraints
     */
    private fun createComparisonOperator(): FunkType {
        val typeVar = freshTypeVar()
        val varType = FunkType.VarType(typeVar)
        
        abilityConstraints.add(AbilityConstraint("Ord", varType))
        
        return FunkType.FunctionType(
            FunkType.RecordType(mapOf("left" to varType, "right" to varType)),
            FunkType.BooleanType
        )
    }
    
    /**
     * Create string concatenation operator type
     */
    private fun createStringConcatOperator(): FunkType {
        return FunkType.FunctionType(
            FunkType.RecordType(mapOf("left" to FunkType.StringType, "right" to FunkType.StringType)),
            FunkType.StringType
        )
    }    
    /
**
     * Resolve qualified names like module::function
     */
    private fun resolveQualifiedName(expr: Identifier): FunkType {
        val parts = expr.name.split("::")
        if (parts.size != 2) {
            throw TypeCheckError("Invalid qualified name format: ${expr.name}", expr, ErrorType.UNDEFINED_VARIABLE)
        }
        
        val moduleName = parts[0]
        val functionName = parts[1]
        
        // Try to resolve the module
        val module = try {
            moduleContext[moduleName] ?: run {
                val resolvedModule = moduleResolver.resolveModule("std::types::$moduleName")
                moduleContext[moduleName] = resolvedModule
                resolvedModule
            }
        } catch (e: ModuleError) {
            throw TypeCheckError("Module not found: $moduleName", expr, ErrorType.UNDEFINED_VARIABLE)
        }
        
        // Look for the function in the module exports
        val exportedItem = module.exports[functionName]
            ?: throw TypeCheckError("Function '$functionName' not found in module '$moduleName'", expr, ErrorType.UNDEFINED_VARIABLE)
        
        return exportedItem.funkType
    }
    
    /**
     * Add constraint to the constraint set
     */
    private fun addConstraint(constraint: TypeConstraint) {
        constraints.add(constraint)
    }
    
    /**
     * Instantiate a type scheme with fresh type variables
     */
    private fun instantiate(scheme: TypeScheme): FunkType {
        val substitution = scheme.quantifiedVars.associateWith { 
            FunkType.VarType(freshUnificationVar()) 
        }
        return applySubstitution(scheme.type, substitution)
    }
    
    /**
     * Apply substitution to a type
     */
    private fun applySubstitution(type: FunkType, substitution: Map<TypeVar, FunkType>): FunkType {
        return when (type) {
            is FunkType.VarType -> substitution[type.variable] ?: type
            is FunkType.FunctionType -> FunkType.FunctionType(
                applySubstitution(type.paramType, substitution),
                applySubstitution(type.returnType, substitution),
                type.effects
            )
            is FunkType.RecordType -> FunkType.RecordType(
                type.fields.mapValues { (_, fieldType) -> 
                    applySubstitution(fieldType, substitution) 
                }
            )
            else -> type
        }
    }
    
    /**
     * Generalize a type by quantifying over free type variables
     */
    private fun generalize(type: FunkType): TypeScheme {
        val freeVars = freeTypeVars(type) - freeTypeVars(typeContext.values.toList())
        return TypeScheme(freeVars, type)
    }
    
    /**
     * Get free type variables in a type
     */
    private fun freeTypeVars(type: FunkType): Set<TypeVar> {
        return when (type) {
            is FunkType.VarType -> setOf(type.variable)
            is FunkType.FunctionType -> freeTypeVars(type.paramType) + freeTypeVars(type.returnType)
            is FunkType.RecordType -> type.fields.values.flatMap { freeTypeVars(it) }.toSet()
            else -> emptySet()
        }
    }
    
    /**
     * Get free type variables in a list of type schemes
     */
    private fun freeTypeVars(schemes: Collection<TypeScheme>): Set<TypeVar> {
        return schemes.flatMap { scheme ->
            freeTypeVars(scheme.type) - scheme.quantifiedVars
        }.toSet()
    }    

    /**
     * Solve constraints using unification and ability resolution with enhanced propagation
     */
    private fun solveConstraints(): Map<TypeVar, FunkType> {
        val solver = ConstraintSolver()
        val constraintList = constraints.map { constraint ->
            when (constraint) {
                is TypeConstraint.Equality -> Constraint.Equality(constraint.left, constraint.right)
                is TypeConstraint.Instantiation -> {
                    val instantiated = instantiate(constraint.polyType)
                    Constraint.Equality(instantiated, constraint.monoType)
                }
            }
        }
        val substitution = solver.solve(constraintList)
        
        // ENHANCED: Propagate concrete types from qualified calls
        val enhancedSubstitution = propagateConcreteTypes(substitution)
        
        // Resolve ability constraints to concrete types
        val abilityResolution = resolveAbilityConstraints(enhancedSubstitution.mapping)
        val finalSubstitution = enhancedSubstitution.compose(Substitution(abilityResolution))
        
        constraints.clear()
        
        return finalSubstitution.mapping
    }
    
    /**
     * Propagate concrete types from qualified calls and other concrete evidence
     */
    private fun propagateConcreteTypes(substitution: Substitution): Substitution {
        val additionalMappings = mutableMapOf<TypeVar, FunkType>()
        
        // Look for type variables that should be concrete based on ability constraints
        for (constraint in abilityConstraints) {
            when (constraint.type) {
                is FunkType.VarType -> {
                    val typeVar = constraint.type.variable
                    
                    // If we have a NumAdd constraint and evidence of Int usage, force to Int
                    if (constraint.ability == "NumAdd" && hasConcreteEvidence(typeVar, FunkType.IntType)) {
                        additionalMappings[typeVar] = FunkType.IntType
                    }
                }
            }
        }
        
        return if (additionalMappings.isNotEmpty()) {
            substitution.compose(Substitution(additionalMappings))
        } else {
            substitution
        }
    }
    
    /**
     * Check if there's concrete evidence for a type variable being a specific concrete type
     */
    private fun hasConcreteEvidence(typeVar: TypeVar, concreteType: FunkType): Boolean {
        // Look through constraints for evidence that this type variable should be concrete
        for (constraint in constraints) {
            when (constraint) {
                is TypeConstraint.Equality -> {
                    // Check if this type variable is unified with a concrete type
                    if (constraint.left is FunkType.VarType && constraint.left.variable == typeVar) {
                        if (constraint.right == concreteType) return true
                    }
                    if (constraint.right is FunkType.VarType && constraint.right.variable == typeVar) {
                        if (constraint.left == concreteType) return true
                    }
                }
            }
        }
        
        // Look for qualified calls that force concrete types
        return concreteType == FunkType.IntType && 
               abilityConstraints.any { it.ability == "NumAdd" && 
                                       it.type is FunkType.VarType && 
                                       it.type.variable == typeVar }
    }   
 
    /**
     * Resolve ability constraints to concrete types when possible
     */
    private fun resolveAbilityConstraints(currentSubstitution: Map<TypeVar, FunkType>): Map<TypeVar, FunkType> {
        val resolution = mutableMapOf<TypeVar, FunkType>()
        
        for (constraint in abilityConstraints) {
            when (constraint.type) {
                is FunkType.VarType -> {
                    val typeVar = constraint.type.variable
                    
                    // Only resolve to concrete types if we have strong evidence
                    if (shouldForceConcreteResolution(typeVar, constraint.ability)) {
                        // Look for concrete type evidence
                        val concreteType = findConcreteType(typeVar, currentSubstitution)
                        if (concreteType != null) {
                            resolution[typeVar] = concreteType
                        }
                    }
                }
                else -> {
                    // Concrete type, validate the ability constraint
                    if (!hasAbilityImplementation(constraint.ability, constraint.type)) {
                        throw TypeCheckError("Type ${constraint.type} does not implement ability ${constraint.ability}")
                    }
                }
            }
        }
        
        return resolution
    }
    
    /**
     * Check if we should force concrete resolution for a type variable
     */
    private fun shouldForceConcreteResolution(typeVar: TypeVar, ability: String): Boolean {
        return ability in setOf("NumAdd", "NumSub", "NumMul", "NumDiv", "NumMod")
    }
    
    /**
     * Find concrete type for a type variable through constraints
     */
    private fun findConcreteType(typeVar: TypeVar, substitution: Map<TypeVar, FunkType>): FunkType? {
        // Look through constraints for concrete type evidence
        for (constraint in constraints) {
            if (constraint is TypeConstraint.Equality) {
                when {
                    constraint.left is FunkType.VarType && constraint.left.variable == typeVar -> {
                        val rightType = applySubstitution(constraint.right, substitution)
                        if (isConcreteType(rightType)) {
                            return rightType
                        }
                    }
                    constraint.right is FunkType.VarType && constraint.right.variable == typeVar -> {
                        val leftType = applySubstitution(constraint.left, substitution)
                        if (isConcreteType(leftType)) {
                            return leftType
                        }
                    }
                }
            }
        }
        
        // Check if already resolved in substitution
        val resolved = substitution[typeVar]
        if (resolved != null && isConcreteType(resolved)) {
            return resolved
        }
        
        return null
    }
    
    /**
     * Check if a type is concrete (not a type variable)
     */
    private fun isConcreteType(type: FunkType): Boolean {
        return when (type) {
            is FunkType.VarType -> false
            is FunkType.IntType, is FunkType.FloatType, is FunkType.StringType, 
            is FunkType.BooleanType, is FunkType.NatType, is FunkType.FracType -> true
            is FunkType.FunctionType -> isConcreteType(type.paramType) && isConcreteType(type.returnType)
            is FunkType.RecordType -> type.fields.values.all { isConcreteType(it) }
            else -> false
        }
    }    
 
   /**
     * Check if a type has an implementation for a given ability
     */
    private fun hasAbilityImplementation(ability: String, type: FunkType): Boolean {
        // Skip validation for type variables
        if (type is FunkType.VarType) {
            return true
        }
        
        return when (ability) {
            "NumAdd", "NumSub", "NumMul", "NumDiv", "NumMod" -> {
                type in setOf(FunkType.IntType, FunkType.FloatType, FunkType.NatType, FunkType.FracType)
            }
            "Eq" -> {
                type in setOf(FunkType.IntType, FunkType.FloatType, FunkType.StringType, FunkType.BooleanType, FunkType.NatType, FunkType.FracType)
            }
            "Ord" -> {
                type in setOf(FunkType.IntType, FunkType.FloatType, FunkType.StringType, FunkType.NatType, FunkType.FracType)
            }
            else -> false
        }
    }
    
    /**
     * Setup built-in types and operators
     */
    private fun setupBuiltinTypes() {
        // Load native function types
        val nativeTypes = mutableMapOf<String, FunkType>()
        NativeFunctionTypes.registerAll(nativeTypes)
        
        // Add native functions to type context as monomorphic schemes
        for ((name, type) in nativeTypes) {
            typeContext[name] = TypeScheme(emptySet(), type)
        }
        
        // Load stdlib modules for qualified name resolution
        loadStdlibModules()
    }
    
    /**
     * Load stdlib modules into context
     */
    private fun loadStdlibModules() {
        val stdlibModules = listOf(
            "std::types::int",
            "std::types::string"
        )
        
        for (modulePath in stdlibModules) {
            try {
                val module = moduleResolver.resolveModule(modulePath)
                val parts = modulePath.split("::")
                if (parts.size >= 2) {
                    val shortName = parts.last()
                    moduleContext[shortName] = module
                }
            } catch (e: Exception) {
                // Ignore errors during stdlib loading
            }
        }
    }
}