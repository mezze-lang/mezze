// Comprehensive integration test combining all features
let comprehensive_example = do
  // Define helper functions
  let add = { x, y } -> x + y
  let multiply = { x, y } -> x * y
  let greet = { person } -> "Hello, " ++ person.name ++ "!"
  
  // Create data structures
  let alice = { name = "Alice", age = 30, role = Admin }
  let bob = { name = "Bob", age = 25, role = User }
  let charlie = { name = "Charlie", age = 35, role = Moderator }
  
  // Process data with functions
  let process_user = { user } -> do
    let greeting = greet { person = user }
    let age_category = if user.age >= 30 then "senior" else "junior"
    let processed = {
      original = user,
      greeting = greeting,
      category = age_category,
      permissions = user.role
    }
    processed
  
  // Apply processing
  let alice_processed = process_user { user = alice }
  
  // Create result with variants
  let result = Success {
    processed_user = alice_processed,
    timestamp = 1234567890,
    metadata = {
      version = "1.0.0",
      processor = "funk-lang"
    }
  }
  
  result
