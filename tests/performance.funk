// Performance and stress tests
let large_computation = do
  let factorial = { n } -> if n <= 1 then 1 else n * factorial { n = n - 1 }
  factorial { n = 5 }

let deep_nesting = do
  let level1 = { value = 1 }
  let level2 = { prev = level1, value = 2 }
  let level3 = { prev = level2, value = 3 }
  let level4 = { prev = level3, value = 4 }
  let level5 = { prev = level4, value = 5 }
  level5.prev.prev.prev.value

let many_operations = do
  let a = 1 + 2 + 3 + 4 + 5
  let b = 10 * 9 * 8 * 7 * 6
  let c = 100 - 90 - 80 - 70 - 60
  let d = a + b + c
  d

let complex_string_ops = do
  let part1 = "Hello" ++ " " ++ "beautiful"
  let part2 = " " ++ "world" ++ "!"
  let full = part1 ++ part2
  full
