// Test complex combinations of features
let complex_example = do
  let add = { x, y } -> x + y
  let person = { name = "Alice", age = 25 }
  let result = if person.age > 18 then "adult" else "minor"
  let status = Ok { 
    user = person, 
    classification = result,
    timestamp = 1234567890
  }
  status

let nested_functions = do
  let multiply = { x, y } -> x * y
  let square = { n } -> multiply { x = n, y = n }
  let calculate = { base } -> do
    let squared = square { n = base }
    let doubled = squared * 2
    doubled
  calculate { base = 5 }

let variant_processing = do
  let success_case = Success { value = 42, message = "OK" }
  let error_case = Error { code = 404, message = "Not Found" }
  let results = { success = success_case, error = error_case }
  results
