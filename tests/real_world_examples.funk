// Real-world example scenarios
let user_authentication = do
  let user = { 
    id = 123, 
    username = "alice", 
    email = "alice@example.com",
    active = true 
  }
  let credentials = { username = "alice", password = "secret123" }
  let auth_result = if user.active then 
    Authenticated { user = user, token = "abc123" }
  else 
    Rejected { reason = "User inactive" }
  auth_result

let api_response = do
  let data = { 
    users = [
      { name = "Alice", role = "admin" },
      { name = "Bob", role = "user" }
    ],
    total = 2,
    page = 1
  }
  let response = Success {
    status = 200,
    data = data,
    timestamp = 1234567890
  }
  response

let configuration_system = do
