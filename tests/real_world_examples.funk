    host = "localhost",
    port = 5432,
    database = "myapp",
    ssl = true
  }
  let cache_config = {
    enabled = true,
    ttl = 3600,
    max_size = 1000
  }
  let app_config = {
    name = "MyApp",
    version = "1.0.0",
    database = database_config,
    cache = cache_config,
    debug = false
  }
