// Test do expressions
let simple_do = do
  42

let do_with_bindings = do
  let x = 5
  let y = 10
  x + y

let complex_do = do
  let name = "Alice"
  let age = 30
  let greeting = "Hello, " ++ name
  let person = { name = name, age = age }
  person

let nested_do = do
  let outer = 10
  let inner_result = do
    let inner = 5
    outer + inner
  inner_result * 2
