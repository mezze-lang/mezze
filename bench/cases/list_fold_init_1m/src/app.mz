## list_fold_init_1m: list_fold_1m with a NON-ZERO init: the fold must reach the long
## pipeline through its folder's Int slots, not through a zero-init sum (#194).
use std::effects::log::{println, Console}
use std::effects::time::{Time, SystemTime, monotonic}
use std::datetime::{duration_to_nanos, sub_duration}
use std::collections::list

let build_list : {n: Int, acc: List Int} -> List Int = {n, acc} -> if n == 0
    then acc
    else build_list {n = n - 1, acc = list::cons {head = n, tail = acc}}

let time_fold = {xs} -> perform SystemTime in do
    let t0 = monotonic {}
    let s = list::fold_left {xs = xs, init = 10, f = {acc, x} -> acc + x}
    let t1 = monotonic {}
    { r = s, ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } } }

let loop_iters : {xs: List Int, k: Int, i: Int, warmup: Bool} -> Int <*> = {xs, k, i, warmup} -> perform Console in perform SystemTime in
    if i == k
        then 0
        else do
            let out = time_fold {xs = xs}
            let tag = if warmup then "warmup" else "measure"
            println { msg = "  [$(tag)] iter=$(i.to_str{}) ns=$(out.ns.to_str{})" }
            loop_iters {xs = xs, k = k, i = i + 1, warmup = warmup}

let main = {} -> perform Console in perform SystemTime in do
    let n = 1000000
    println { msg = "== list_fold_init N=$(n.to_str{}) 3 warmup + 5 measured ==" }
    let xs = build_list {n = n, acc = list::empty {}}
    let _w = loop_iters {xs = xs, k = 3, i = 0, warmup = True}
    let _m = loop_iters {xs = xs, k = 5, i = 0, warmup = False}
    println { msg = "== done ==" }
