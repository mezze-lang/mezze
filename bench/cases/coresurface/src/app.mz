## WHAT THE UNMEASURED SURFACE COSTS.
##
## Everything measured so far has been records, bindings, calls and loops. Three
## parts of the language have never been benchmarked at all, and until they are
## there is no way to rank them against the ~230 ps/iter a positional tail loop
## costs. The risk this case exists to retire: that a session spent on records
## left something STRUCTURAL in effects costing 100x.
##
## Every kernel computes the SAME checksum as kernel 1 — n*(n+1)/2 — so a kernel
## that looks fast because it dropped work shows up as a different number.
## Reported in picoseconds per iteration, one kernel per process.
use std::collections::seq
use std::effects::log::{ println, Console }
use std::effects::time::{ SystemTime, monotonic }
use std::datetime::{ duration_to_nanos, sub_duration }
use std::effects::args::{ SystemArgs, argv }
use std::int

let arg_at = { args, i, def } -> match seq::get { xs = args, i = i } is
  Some { val } -> match int::from_str { s = val } is
    Some { val = v } -> v
    None -> def
  None -> def

let time_it = { f } -> perform SystemTime in do
  let t0 = monotonic {}
  let r = f {}
  let t1 = monotonic {}
  { result = r, ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } } }

## 1. CONTROL: a positional tail loop, which §1 brought to ~230 ps/iter.
let k_control = { n } -> do
  let go = { i, acc } ->
    if i <= 0 then acc
    else go { i = i - 1, acc = acc + i }
  go { i = n, acc = 0 }

## 2. ONE EFFECT OPERATION per iteration. The handler is installed OUTSIDE the
##    loop and the operation is trivial, so what this measures is the cost of
##    reaching a handler — not the work it does. If effects are cliff-shaped
##    like everything else so far, this lands near the control; if they need a
##    real continuation capture per operation, it will not, and that is a
##    different kind of problem from anything fixed so far.
effect Unit1 where {
  one: {} -> Int <Unit1>
}

impl Unit1 for Ones {} where {
  one = {} -> 1
}

let k_effect = { n } -> perform Ones {} in do
  let go = { i, acc } ->
    if i <= 0 then acc
    else go { i = i - Unit1.one {}, acc = acc + i }
  go { i = n, acc = 0 }

## 3. A VARIANT CONSTRUCTED AND MATCHED per iteration, using the prelude's
##    Option. Two constructors, one payload field — the shape every `Option`
##    -returning stdlib call produces, so this is the common case rather than a
##    synthetic one.
let k_option = { n } -> do
  let go = { i, acc } ->
    if i <= 0 then acc
    else match Some { val = i } is
      Some { val } -> go { i = i - 1, acc = acc + val }
      None -> acc
  go { i = n, acc = 0 }

## 4. A THREE-CONSTRUCTOR USER VARIANT, matched with all three arms present but
##    only one ever taken. Isolates match DISPATCH from the payload: the
##    constructor is the same every iteration, so a decision tree should pick it
##    without looking at the others.
type Tag = | A { n: Int }, B { n: Int }, C { n: Int } |

let k_variant = { n } -> do
  let go = { i, acc } ->
    if i <= 0 then acc
    else match A { n = i } is
      A { n } -> go { i = i - 1, acc = acc + n }
      B { ... } -> acc
      C { ... } -> acc
  go { i = n, acc = 0 }

## 5. TIER CONTROL — and this kernel is why the others can be read at all.
##    The same loop, kept OFF the fused tail-loop tier for a reason that has
##    nothing to do with effects or variants: the decrement comes from a helper
##    too big to inline, so the tier's "every update is arithmetic over params"
##    test fails exactly as it does for a `perform`. `heavy_one` returns 1, so
##    the checksum is unchanged.
##
##    Without this, kernel 2's number is uninterpretable: it mixes the cost of
##    an effect operation with the cost of the loop leaving tier 1, and the
##    trace says it does leave ("tier-1 declined"). k5 - k1 is the tier; k2 - k5
##    is the effect operation.
let heavy_one = { i } -> i * 0 + 1 + 0 + 0 + 0 + 0 + 0 + 0 + 0

let k_tier = { n } -> do
  let go = { i, acc } ->
    if i <= 0 then acc
    else go { i = i - heavy_one { i = i }, acc = acc + i }
  go { i = n, acc = 0 }

## 6. A PLAIN TOP-LEVEL FUNCTION called once per iteration, in the
##    accumulator. `plain` is as small as a function can be, so if this costs
##    more than kernel 8 the difference is dispatch and not work.
let plain = { x } -> x + 1

let k_direct = { n } -> do
  let go = { i, acc } ->
    if i <= 0 then acc
    else go { i = i - 1, acc = acc + plain { x = i } - 1 }
  go { i = n, acc = 0 }

## 7. THE SAME CALL, TO A LOCAL CLOSURE. A closure is built eagerly and is
##    never a lazy stub, which is the known tell from the stub-bypass work: when
##    the simpler thing is slower, suspect a decision cached too early.
let k_closure = { n } -> do
  let bump = { x } -> x + 1
  let go = { i, acc } ->
    if i <= 0 then acc
    else go { i = i - 1, acc = acc + bump { x = i } - 1 }
  go { i = n, acc = 0 }

## 8. AN ABILITY METHOD ON A CONCRETE RECEIVER. The impl is knowable at the
##    call, and BytecodeCompiler lowers this to an indirect call through the
##    dictionary field that CallIndirect caches and force-inlines.
ability Step for 'c where {
  step: { it: 'c, x: Int } -> Int,
}

pub type Cfg = { bump: Int }

impl Step for Cfg where {
  step = { it, x } -> x + 1,
}

let cfg: Cfg = { bump = 1 }

let k_ability = { n } -> do
  let go = { c, i, acc } ->
    if i <= 0 then acc
    else go { c = c, i = i - 1, acc = acc + c.step { x = i } - 1 }
  go { c = cfg, i = n, acc = 0 }

## 9. THE SAME ABILITY METHOD THROUGH A `with` CONSTRAINT, so the impl arrives
##    as evidence rather than being known at the call.
let via_dict: { c: 'c, x: Int } with Step 'c -> Int = { c, x } -> c.step { x = x }

let k_dict = { n } -> do
  let go = { c, i, acc } ->
    if i <= 0 then acc
    else go { c = c, i = i - 1, acc = acc + via_dict { c = c, x = i } - 1 }
  go { c = cfg, i = n, acc = 0 }

## 10. ROW 9 WITH THE LOOP AT TOP LEVEL, which is how `ability_dispatch`
##     spells it — and that bench sees no gap at all here. Every other kernel in
##     this file wraps its loop in a do-block `let`, and a do-block let lambda
##     generalizes where a top-level one specializes, so row 10 minus row 9 is
##     the SPELLING and row 9 minus row 8 is only a dictionary if row 10 is slow
##     too.
let go_dict_top: { c: Cfg, i: Int, acc: Int } -> Int =
  { c, i, acc } ->
    if i <= 0 then acc
    else go_dict_top { c = c, i = i - 1, acc = acc + via_dict { c = c, x = i } - 1 }

let k_dict_top = { n } -> go_dict_top { c = cfg, i = n, acc = 0 }

## 11. ROW 9 WITH AN ANNOTATION on the do-block loop, nothing else changed.
let k_dict_annot = { n } -> do
  let go: { c: Cfg, i: Int, acc: Int } -> Int =
    { c, i, acc } ->
      if i <= 0 then acc
      else go { c = c, i = i - 1, acc = acc + via_dict { c = c, x = i } - 1 }
  go { c = cfg, i = n, acc = 0 }

## 12. ROW 10 WITHOUT its annotation, nothing else changed.
let go_dict_bare =
  { c, i, acc } ->
    if i <= 0 then acc
    else go_dict_bare { c = c, i = i - 1, acc = acc + via_dict { c = c, x = i } - 1 }

let k_dict_bare = { n } -> go_dict_bare { c = cfg, i = n, acc = 0 }

let report = { name, n, r } ->
  println { msg = "$(name)  $(int::to_str { n = r.ns * 1000 / n }) ps/iter  sum=$(int::to_str { n = r.result })" }

pub let main = {} -> perform Console in perform SystemArgs in perform SystemTime in do
  let args = argv {}
  let k = arg_at { args = args, i = 0, def = 1 }
  let n = arg_at { args = args, i = 1, def = 20000000 }
  if k == 1 then do
    k_control { n = n }
    k_control { n = n }
    k_control { n = n }
    report { name = "1 control      ", n = n, r = time_it { f = {} -> k_control { n = n } } }
    report { name = "1 control      ", n = n, r = time_it { f = {} -> k_control { n = n } } }
    report { name = "1 control      ", n = n, r = time_it { f = {} -> k_control { n = n } } }
  else if k == 2 then do
    k_effect { n = n }
    k_effect { n = n }
    k_effect { n = n }
    report { name = "2 effect op    ", n = n, r = time_it { f = {} -> k_effect { n = n } } }
    report { name = "2 effect op    ", n = n, r = time_it { f = {} -> k_effect { n = n } } }
    report { name = "2 effect op    ", n = n, r = time_it { f = {} -> k_effect { n = n } } }
  else if k == 3 then do
    k_option { n = n }
    k_option { n = n }
    k_option { n = n }
    report { name = "3 option match ", n = n, r = time_it { f = {} -> k_option { n = n } } }
    report { name = "3 option match ", n = n, r = time_it { f = {} -> k_option { n = n } } }
    report { name = "3 option match ", n = n, r = time_it { f = {} -> k_option { n = n } } }
  else if k == 4 then do
    k_variant { n = n }
    k_variant { n = n }
    k_variant { n = n }
    report { name = "4 variant match", n = n, r = time_it { f = {} -> k_variant { n = n } } }
    report { name = "4 variant match", n = n, r = time_it { f = {} -> k_variant { n = n } } }
    report { name = "4 variant match", n = n, r = time_it { f = {} -> k_variant { n = n } } }
  else if k == 5 then do
    k_tier { n = n }
    k_tier { n = n }
    k_tier { n = n }
    report { name = "5 tier control ", n = n, r = time_it { f = {} -> k_tier { n = n } } }
    report { name = "5 tier control ", n = n, r = time_it { f = {} -> k_tier { n = n } } }
    report { name = "5 tier control ", n = n, r = time_it { f = {} -> k_tier { n = n } } }
  else if k == 6 then do
    k_direct { n = n }
    k_direct { n = n }
    k_direct { n = n }
    report { name = "6 direct call  ", n = n, r = time_it { f = {} -> k_direct { n = n } } }
    report { name = "6 direct call  ", n = n, r = time_it { f = {} -> k_direct { n = n } } }
    report { name = "6 direct call  ", n = n, r = time_it { f = {} -> k_direct { n = n } } }
  else if k == 7 then do
    k_closure { n = n }
    k_closure { n = n }
    k_closure { n = n }
    report { name = "7 closure call ", n = n, r = time_it { f = {} -> k_closure { n = n } } }
    report { name = "7 closure call ", n = n, r = time_it { f = {} -> k_closure { n = n } } }
    report { name = "7 closure call ", n = n, r = time_it { f = {} -> k_closure { n = n } } }
  else if k == 8 then do
    k_ability { n = n }
    k_ability { n = n }
    k_ability { n = n }
    report { name = "8 ability call ", n = n, r = time_it { f = {} -> k_ability { n = n } } }
    report { name = "8 ability call ", n = n, r = time_it { f = {} -> k_ability { n = n } } }
    report { name = "8 ability call ", n = n, r = time_it { f = {} -> k_ability { n = n } } }
  else if k == 9 then do
    k_dict { n = n }
    k_dict { n = n }
    k_dict { n = n }
    report { name = "9 dict call    ", n = n, r = time_it { f = {} -> k_dict { n = n } } }
    report { name = "9 dict call    ", n = n, r = time_it { f = {} -> k_dict { n = n } } }
    report { name = "9 dict call    ", n = n, r = time_it { f = {} -> k_dict { n = n } } }
  else if k == 10 then do
    k_dict_top { n = n }
    k_dict_top { n = n }
    k_dict_top { n = n }
    report { name = "10 dict, top-level loop", n = n, r = time_it { f = {} -> k_dict_top { n = n } } }
    report { name = "10 dict, top-level loop", n = n, r = time_it { f = {} -> k_dict_top { n = n } } }
    report { name = "10 dict, top-level loop", n = n, r = time_it { f = {} -> k_dict_top { n = n } } }
  else if k == 11 then do
    k_dict_annot { n = n }
    k_dict_annot { n = n }
    k_dict_annot { n = n }
    report { name = "11 dict, do-block + annotation", n = n, r = time_it { f = {} -> k_dict_annot { n = n } } }
    report { name = "11 dict, do-block + annotation", n = n, r = time_it { f = {} -> k_dict_annot { n = n } } }
    report { name = "11 dict, do-block + annotation", n = n, r = time_it { f = {} -> k_dict_annot { n = n } } }
  else if k == 12 then do
    k_dict_bare { n = n }
    k_dict_bare { n = n }
    k_dict_bare { n = n }
    report { name = "12 dict, top-level, no annotation", n = n, r = time_it { f = {} -> k_dict_bare { n = n } } }
    report { name = "12 dict, top-level, no annotation", n = n, r = time_it { f = {} -> k_dict_bare { n = n } } }
    report { name = "12 dict, top-level, no annotation", n = n, r = time_it { f = {} -> k_dict_bare { n = n } } }
  else println { msg = "unknown kernel" }
