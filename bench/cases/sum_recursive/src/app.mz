use std::effects::log::{println, Console}

## Top-level tail-recursion — canonical shape mono+inliner should turn
## generic user code into. Full 10M iters.
let go = {i: Int, n: Int, acc: Int} ->
  if i >= n then acc
  else go {i = i + 1, n = n, acc = acc + i}

let main = {} -> perform Console in do
  let c = go {i = 0, n = 1000000, acc = 0}
  println { msg = "sum 0..1M = $(c.to_str{})" }
  let d = go {i = 0, n = 10000000, acc = 0}
  println { msg = "sum 0..10M = $(d.to_str{})" }
