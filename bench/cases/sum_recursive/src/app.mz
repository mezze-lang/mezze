use std::effects::log::{println, Console}

## Hand-written imperative-style sum via tail-recursion — no fold, no
## abstraction, no seq allocation. This is the ceiling for what pure
## user code can do: pure Int arithmetic in a straight loop shape.

let sum_to = {n: Int} -> do
  let go = {i: Int, acc: Int} ->
    if i >= n then acc
    else go {i = i + 1, acc = acc + i}
  go {i = 0, acc = 0}

let main = {} -> perform Console in do
  let c = sum_to {n = 1000000}
  println { msg = "sum 0..1M = $(c.to_str{})" }
  let d = sum_to {n = 10000000}
  println { msg = "sum 0..10M = $(d.to_str{})" }
