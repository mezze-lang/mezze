## WHICH COMPOUND FOLD BODIES CAN FUSE WITHOUT REASSOCIATING.
##
## `fusegaps` 14 reads 726 ps/elem against an 84 ps floor, 8.6x, with no
## allocation -- so it is pure codegen. Its body is
##
##     { acc, x } -> acc + x * 2 - 1
##
## which parses as `(acc + x*2) - 1`: the accumulator is combined and THEN
## adjusted. Expressing that as an element transform plus a fold op needs
## `(acc + f(x)) - k` == `acc + (f(x) - k)`, and that reassociation is NOT
## sound in Mezze -- `Int` overflow RAISES, so moving the subtraction changes
## WHICH operation overflows. The generic loop emits the body as written for
## exactly that reason.
##
## The PARENTHESISED form needs no reassociation at all:
##
##     { acc, x } -> acc + (x * 2 - 1)
##
## is literally `acc <ADD> f(x)` where f is a two-op chain over x alone. The
## element-transform slot holds ONE op, so this falls off too -- but it could
## ride the extra-map table, which already carries a chain, with no algebra.
##
## This case separates the two so the safe subset can be sized on its own.
## Kernel 3 is the control: ONE element op, which already fuses.
use std::collections::iter
use std::collections::seq
use std::effects::log::{ println, Console }
use std::effects::time::{ SystemTime, monotonic }
use std::datetime::{ duration_to_nanos, sub_duration }
use std::effects::args::{ SystemArgs, argv }
use std::int

let time_it = { f } -> perform SystemTime in do
  let t0 = monotonic {}
  let r = f {}
  let t1 = monotonic {}
  { ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } }, result = r }

let report = { name, n, r } ->
  println { msg = "$(name)  $(int::to_str { n = r.ns * 1000 / n }) ps/elem  sum=$(int::to_str { n = r.result })" }

let arg_at = { args, i, def } -> match seq::get { xs = args, i = i } is
  Some { val } -> match int::from_str { s = val } is
    Some { val = v } -> v
    None -> def
  None -> def

## 1. Needs reassociation. `(acc + x*2) - 1`.
let k_assoc = { n } -> iter::range { start = 0, end = n }
  .map { f = { x } -> x * 3 }
  .fold { init = 0, f = { acc, x } -> acc + x * 2 - 1 }

## 2. A PURE element chain, no algebra required. `acc + (x*2 - 1)`.
let k_chain = { n } -> iter::range { start = 0, end = n }
  .map { f = { x } -> x * 3 }
  .fold { init = 0, f = { acc, x } -> acc + (x * 2 - 1) }

## 3. Control: ONE element op, which the single slot already takes.
let k_one = { n } -> iter::range { start = 0, end = n }
  .map { f = { x } -> x * 3 }
  .fold { init = 0, f = { acc, x } -> acc + x * 2 }

pub let main = {} -> perform Console in perform SystemArgs in perform SystemTime in do
  let args = argv {}
  let k = arg_at { args = args, i = 0, def = 1 }
  let n = arg_at { args = args, i = 1, def = 20000000 }
  if k == 1 then do
    k_assoc { n = n }
    k_assoc { n = n }
    k_assoc { n = n }
    k_assoc { n = n }
    k_assoc { n = n }
    report { name = "1 (acc+x*2)-1    ", n = n, r = time_it { f = {} -> k_assoc { n = n } } }
    report { name = "1 (acc+x*2)-1    ", n = n, r = time_it { f = {} -> k_assoc { n = n } } }
    report { name = "1 (acc+x*2)-1    ", n = n, r = time_it { f = {} -> k_assoc { n = n } } }
    report { name = "1 (acc+x*2)-1    ", n = n, r = time_it { f = {} -> k_assoc { n = n } } }
    report { name = "1 (acc+x*2)-1    ", n = n, r = time_it { f = {} -> k_assoc { n = n } } }
  else if k == 2 then do
    k_chain { n = n }
    k_chain { n = n }
    k_chain { n = n }
    k_chain { n = n }
    k_chain { n = n }
    report { name = "2 acc+(x*2-1)    ", n = n, r = time_it { f = {} -> k_chain { n = n } } }
    report { name = "2 acc+(x*2-1)    ", n = n, r = time_it { f = {} -> k_chain { n = n } } }
    report { name = "2 acc+(x*2-1)    ", n = n, r = time_it { f = {} -> k_chain { n = n } } }
    report { name = "2 acc+(x*2-1)    ", n = n, r = time_it { f = {} -> k_chain { n = n } } }
    report { name = "2 acc+(x*2-1)    ", n = n, r = time_it { f = {} -> k_chain { n = n } } }
  else do
    k_one { n = n }
    k_one { n = n }
    k_one { n = n }
    k_one { n = n }
    k_one { n = n }
    report { name = "3 acc+x*2 (ctl)  ", n = n, r = time_it { f = {} -> k_one { n = n } } }
    report { name = "3 acc+x*2 (ctl)  ", n = n, r = time_it { f = {} -> k_one { n = n } } }
    report { name = "3 acc+x*2 (ctl)  ", n = n, r = time_it { f = {} -> k_one { n = n } } }
    report { name = "3 acc+x*2 (ctl)  ", n = n, r = time_it { f = {} -> k_one { n = n } } }
    report { name = "3 acc+x*2 (ctl)  ", n = n, r = time_it { f = {} -> k_one { n = n } } }
