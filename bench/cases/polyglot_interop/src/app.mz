# polyglot_interop — how much does ONE crossing into a guest language cost?
#
# Every workload here is a tight loop whose body is a single interop message,
# so the number that comes out is the per-crossing cost and not the guest's own
# work: the JS side is a plain property read or a one-expression function.
#
# It also runs the SAME workload written two ways — the flat dot-chain and the
# explicitly-matched form. Those are supposed to be two spellings of one thing,
# so their times are supposed to match. A gap between them is a finding.
#
# Baseline for tasks #86-#92. Run via bench/scripts/run.sh on the NATIVE binary.
#
# MEASURED 2026-09-22, JVM dev path, GraalJS, iters = 4M, timed IN-PROCESS,
# each of the first three rows the BEST OF 5 timed runs:
#
#   control (no guest)   252 ns/iter   <- READ THIS ROW FIRST
#   read  (matched)      424 ns/iter
#   read  (chain)        509 ns/iter
#   index                544 ns/iter
#   invoke               855 ns/iter
#   eval (same source)     6 us/iter
#   guest init             1 ms
#
# WHAT THE CONTROL ROW IS FOR. It runs the same SHAPE with no guest at all —
# two natives returning a variant, two matches, one recursive call. So:
#
#   loop machinery, no interop whatsoever ....... 252 ns   (59% of a read)
#   + two interop messages ...................... 172 ns   (~86 ns each)
#   + writing it as a dot-chain .................  85 ns
#
# THE DOT-CHAIN COSTS ABOUT ONE INTEROP MESSAGE — one extra call frame through
# the provider's Result-threading forwarder, which is a perfectly ordinary price
# for a function call. There is no pathology here to remove.
#
# THIS FILE HAS NOW BEEN WRONG ABOUT THAT NUMBER TWICE, both times from taking a
# single timed run as a measurement:
#
#   "~307 ns per interop message" was a loop total divided by an ASSUMED message
#   count, which attributed all of the loop machinery to interop. Two fixes aimed
#   at it failed to move anything (scalar ABI instead of record ABI; a cached
#   InteropLibrary instead of getUncached) because neither was where the time was.
#
#   "187 ns to write it as a chain — more than every interop message combined"
#   came from one run of each loop. Best-of-5 puts it at 85 ns. Two more fixes
#   were aimed at THAT number and also moved nothing: a variant-match fold that
#   fired zero times, and widening TrivialWrapperInliner to accept bodies that
#   bind locals, which fired but changed no time and broke 10 gate tests (#93,
#   #94). The chain's call site is an ability dispatch, and CallIndirect already
#   inline-caches and force-inlines it (#92) — so there was never an un-inlined
#   CallTarget to find.
#
# So: do not divide a loop total by a message count, and do not compare two
# single runs. Both mistakes invented a bottleneck that four separate changes
# then failed to fix. Measure against the control, best-of-N.

use std::effects::log::{println, Console, Log}
use std::effects::time::{ monotonic, Time, SystemTime }
use std::datetime::{ Duration, sub_duration, duration_to_nanos }
use std::polyglot::core::{ InteropError }
use mezze_js::js::{ Js, GraalJs, JsForeign }
use std::int
use std::str

let iters = 4000000

## eval is ~12x a member read even warm, and needs its own warm-up: at 200
## iterations it reads 89 us, at 20000 it reads 6 us. That difference is
## warm-up, NOT a missing parse cache — a first measurement at 200 looked like
## `eval` re-parsed its source every call, and it does not.
let eval_iters = 20000

## ---- member read, DOT-CHAIN spelling ----
## `.property{...}.int{}` — the read yields the foreign value, and `.int` is the
## one crossing that can fail, so it alone returns a Result.
let read_chain: { obj: JsForeign, n: Int, acc: Int } -> Int <Js> =
  { obj, n, acc } ->
    if n <= 0 then acc
    else do
      let got = match obj.property { name = "v" }.int {} is
        Ok { val = i } -> i
        Err { error = _ } -> 0
      read_chain { obj = obj, n = n - 1, acc = acc + got }

## ---- member read, MATCHED spelling ----
## Same two messages, bound between them instead of chained.
let read_matched: { obj: JsForeign, n: Int, acc: Int } -> Int <Js> =
  { obj, n, acc } ->
    if n <= 0 then acc
    else do
      let f = obj.property { name = "v" }
      let got = match f.int {} is
        Ok { val = i } -> i
        Err { error = _ } -> 0
      read_matched { obj = obj, n = n - 1, acc = acc + got }

## ---- method invoke ----
## `obj.get()` on the guest side: one invoke_member per iteration.
let invoke_loop: { obj: JsForeign, n: Int, acc: Int } -> Int <Js> =
  { obj, n, acc } ->
    if n <= 0 then acc
    else do
      let got = match obj.method { name = "get", args = [] }.int {} is
        Ok { val = i } -> i
        Err { error = _ } -> 0
      invoke_loop { obj = obj, n = n - 1, acc = acc + got }

## ---- indexed element read ----
## Walks a guest array element by element — this is the ForeignContainers path,
## where an N-element consumer pays N crossings.
## Wraps around a 1000-element array so it runs `n` times, not 1000 — a
## 1000-iteration loop never warms up and reports cold-start cost, which in an
## otherwise-warm table reads as though indexing were 10x worse than a read.
let index_loop: { arr: JsForeign, i: Int, n: Int, acc: Int } -> Int <Js> =
  { arr, i, n, acc } ->
    if i >= n then acc
    else do
      let got = match arr.index { i = i % 1000 }.int {} is
        Ok { val = v } -> v
        Err { error = _ } -> 0
      index_loop { arr = arr, i = i + 1, n = n, acc = acc + got }

## ns per iteration, measured INSIDE the process so ~4s of startup and the
## run-to-run noise that came with it are not part of the number. Measuring the
## whole process could not resolve a 5% change; the spread between three
## identical 4M runs was 0.67s, wider than the effect being looked for.
## Re-evaluates the SAME guest source n times.
let eval_loop: { n: Int, src: Str } -> Int <Js> =
  { n, src } ->
    if n <= 0 then 0
    else do
      let _ = Js.eval { source = src }
      eval_loop { n = n - 1, src = src }

## CONTROL — the same SHAPE with no guest at all: two natives that return a
## variant, two matches on it, one recursive call. Whatever this costs is what
## the loop machinery costs; interop's real share is the difference between it
## and `read (matched)`. Without this row, dividing total loop time by an
## assumed message count attributes ALL of it to interop, which is how the
## earlier "~307 ns per interop message" figure came out wrong.
let control_loop: { s: Str, n: Int, acc: Int } -> Int =
  { s, n, acc } ->
    if n <= 0 then acc
    else do
      let got = match str::index_of { s = s, sub = "l" } is
        Some { val = i } -> match str::char_at { s = s, i = i } is
          Some { val = _ } -> 1
          None -> 0
        None -> 0
      control_loop { s = s, n = n - 1, acc = acc + got }

let report: { label: Str, got: Int, n: Int, t0: Duration, t1: Duration } -> {} <Log> =
  { label, got, n, t0, t1 } -> do
    let ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } }
    let per = if n <= 0 then 0 else ns / n
    println { msg = "  $(label)  $(int::to_str { n = per }) ns/iter   (got $(int::to_str { n = got }))" }

## ---- repeat-and-take-min -----------------------------------------------
##
## ONE TIMED RUN PER ROW CANNOT RESOLVE THE CHAIN-VS-MATCHED GAP. A sibling
## bench (bench/cases/ability_dispatch) ran four loops that differ only in how
## one call dispatches and produced rows that contradict each other — a loop
## with a call beat the same loop with the call inlined away, by 30 ns. So on
## this harness two structurally similar loops differ by tens of ns for reasons
## that have nothing to do with what is being compared, and the chain penalty
## being chased is only ~187 ns.
##
## Min over repeats is the right statistic: every source of noise here — a
## late-arriving compilation, an OSR transition, a GC pause — makes a run
## SLOWER, never faster, so the minimum is the closest thing to the steady state
## and the noise cannot manufacture a gap that is not there.
let min_int: { a: Int, b: Int } -> Int = { a, b } -> if a < b then a else b

let ns_per: { n: Int, t0: Duration, t1: Duration } -> Int =
  { n, t0, t1 } ->
    if n <= 0 then 0
    else duration_to_nanos { d = sub_duration { a = t1, b = t0 } } / n

## Best of `reps` timed runs of the dot-chain loop.
let best_chain: { obj: JsForeign, reps: Int, acc: Int } -> Int <Js, Time> =
  { obj, reps, acc } ->
    if reps <= 0 then acc
    else do
      let t0 = monotonic {}
      let _r = read_chain { obj = obj, n = iters, acc = 0 }
      let t1 = monotonic {}
      best_chain { obj = obj, reps = reps - 1, acc = min_int { a = acc, b = ns_per { n = iters, t0 = t0, t1 = t1 } } }

## Best of `reps` timed runs of the matched loop.
let best_matched: { obj: JsForeign, reps: Int, acc: Int } -> Int <Js, Time> =
  { obj, reps, acc } ->
    if reps <= 0 then acc
    else do
      let t0 = monotonic {}
      let _r = read_matched { obj = obj, n = iters, acc = 0 }
      let t1 = monotonic {}
      best_matched { obj = obj, reps = reps - 1, acc = min_int { a = acc, b = ns_per { n = iters, t0 = t0, t1 = t1 } } }

## Best of `reps` timed runs of the no-guest control.
let best_control: { reps: Int, acc: Int } -> Int <Time> =
  { reps, acc } ->
    if reps <= 0 then acc
    else do
      let t0 = monotonic {}
      let _r = control_loop { s = "hello", n = iters, acc = 0 }
      let t1 = monotonic {}
      best_control { reps = reps - 1, acc = min_int { a = acc, b = ns_per { n = iters, t0 = t0, t1 = t1 } } }

let main = {} -> perform Console in perform SystemTime in perform GraalJs in do
  println { msg = "polyglot_interop: $(int::to_str { n = iters }) iterations per workload" }

  let e0 = monotonic {}
  let warm = Js.eval { source = "1" }
  let e1 = monotonic {}
  let _ = println { msg = "  guest init (first eval)       $(int::to_str { n = duration_to_nanos { d = sub_duration { a = e1, b = e0 } } / 1000000 }) ms" }
  # Same source 200x: if parsed Sources are cached, this is ~free after the
  # first. If it re-parses every call, each one pays full JS parse+compile.
  let e2 = monotonic {}
  let _r1 = eval_loop { n = eval_iters, src = "1 + 1" }
  let e3 = monotonic {}
  let _ = println { msg = "  eval (same source)          $(int::to_str { n = duration_to_nanos { d = sub_duration { a = e3, b = e2 } } / (eval_iters * 1000) }) us/iter" }

  match Js.eval { source = "({ v: 7, get: function () { return 7; } })" } is
    Ok { val = obj } -> do
      # The dot-chain against the matched spelling — that comparison IS #92 —
      # each as the BEST of 5 timed runs, interleaved with the no-guest control
      # so all three see the same machine. A single run each cannot tell a real
      # 187 ns gap from this harness's own variance; see `best_chain` above.
      let big = 1000000000
      let chain_ns   = best_chain   { obj = obj, reps = 5, acc = big }
      let matched_ns = best_matched { obj = obj, reps = 5, acc = big }
      let control_ns = best_control { reps = 5, acc = big }
      let _ = println { msg = "  -- best of 5 timed runs each --" }
      let _ = println { msg = "  control (no guest)  $(int::to_str { n = control_ns }) ns/iter" }
      let _ = println { msg = "  read  (matched)     $(int::to_str { n = matched_ns }) ns/iter" }
      let _ = println { msg = "  read  (chain)       $(int::to_str { n = chain_ns }) ns/iter" }
      let _ = println { msg = "  chain - matched     $(int::to_str { n = chain_ns - matched_ns }) ns/iter" }

      let i0 = monotonic {}
      let c  = invoke_loop { obj = obj, n = iters, acc = 0 }
      let i1 = monotonic {}
      report { label = "invoke         ", got = c, n = iters, t0 = i0, t1 = i1 }
    Err { error = _ } -> println { msg = "  eval of the test object FAILED" }

  # (the control row is reported above, inside the best-of-5 block, so that it
  # is measured under the same conditions as the two rows it is subtracted from)

  match Js.eval { source = "Array.from({length: 1000}, function (_, i) { return i; })" } is
    Ok { val = arr } -> do
      let x0 = monotonic {}
      let d  = index_loop { arr = arr, i = 0, n = iters, acc = 0 }
      let x1 = monotonic {}
      report { label = "index          ", got = d, n = iters, t0 = x0, t1 = x1 }
    Err { error = _ } -> println { msg = "  eval of the test array FAILED" }
