## Recursion & function call overhead benchmark
use std::effects::log::{println, Console}
use std::effects::time::{Time, SystemTime, monotonic}
use std::datetime::{duration_to_nanos, sub_duration}

## 1. Simple recursive fibonacci (exponential — measures call overhead)
let fib: { n: Int } -> Int = { n } ->
  if n <= 1 then n
  else fib { n = n - 1 } + fib { n = n - 2 }

## 2. Tail-recursive sum (linear — measures trampoline overhead)
let sum_tr: { n: Int, acc: Int } -> Int = { n, acc } ->
  if n <= 0 then acc
  else sum_tr { n = n - 1, acc = acc + n }

## 3. Tail-recursive countdown (pure call overhead, no arithmetic load)
let countdown: { n: Int } -> Int = { n } ->
  if n <= 0 then 0
  else countdown { n = n - 1 }

## 4. Mutual recursion (even/odd)
let is_even: { n: Int } -> Bool = { n } ->
  if n == 0 then True
  else is_odd { n = n - 1 }

let is_odd: { n: Int } -> Bool = { n } ->
  if n == 0 then False
  else is_even { n = n - 1 }

## 5. Higher-order function call (measures callback dispatch)
let apply_n: { n: Int, f: { x: Int } -> Int, x: Int } -> Int = { n, f, x } ->
  if n <= 0 then x
  else apply_n { n = n - 1, f = f, x = f { x = x } }

let time_it = { label: Str, f: {} -> Int } -> perform Console in perform SystemTime in do
    let w0 = f {}
    let w1 = f {}
    let w2 = f {}
    let t0 = monotonic {}
    let r0 = f {}
    let e0 = duration_to_nanos { d = sub_duration { a = monotonic {}, b = t0 } }
    let t1 = monotonic {}
    let r1 = f {}
    let e1 = duration_to_nanos { d = sub_duration { a = monotonic {}, b = t1 } }
    let t2 = monotonic {}
    let r2 = f {}
    let e2 = duration_to_nanos { d = sub_duration { a = monotonic {}, b = t2 } }
    let t3 = monotonic {}
    let r3 = f {}
    let e3 = duration_to_nanos { d = sub_duration { a = monotonic {}, b = t3 } }
    let t4 = monotonic {}
    let r4 = f {}
    let e4 = duration_to_nanos { d = sub_duration { a = monotonic {}, b = t4 } }
    let avg = (e0 + e1 + e2 + e3 + e4) / 5
    let avg_ms = avg / 1000000
    let avg_ns = avg
    println { msg = "$(label): avg=$(avg_ms.to_str{})ms ($(avg_ns.to_str{})ns)  [$(e0.to_str{}) $(e1.to_str{}) $(e2.to_str{}) $(e3.to_str{}) $(e4.to_str{})]ns  r=$(r0.to_str{})" }

let main = {} -> perform Console in perform SystemTime in do
    println { msg = "== Recursion Perf ==" }

    let _1 = time_it { label = "fib(30)         ", f = {} -> fib { n = 30 } }
    let _2 = time_it { label = "fib(35)         ", f = {} -> fib { n = 35 } }
    let _3 = time_it { label = "sum_tr(1M)      ", f = {} -> sum_tr { n = 1000000, acc = 0 } }
    let _4 = time_it { label = "sum_tr(10M)     ", f = {} -> sum_tr { n = 10000000, acc = 0 } }
    let _5 = time_it { label = "countdown(1M)   ", f = {} -> countdown { n = 1000000 } }
    let _6 = time_it { label = "countdown(10M)  ", f = {} -> countdown { n = 10000000 } }
    let _7 = time_it { label = "is_even(100)    ", f = {} -> match is_even { n = 100 } is
        True -> 1
        False -> 0 }
    let _8 = time_it { label = "apply_n(100K,+1)", f = {} -> apply_n { n = 100000, f = { x } -> x + 1, x = 0 } }

    println { msg = "== done ==" }
