use std::effects::log::{println, Console}
use std::collections::seq

let sum_to = {n: Int} -> seq::range { start = 0, end = n }
    .fold {init = 0, f = {acc, x} -> acc + x}

let main = {} -> perform Console in do
  let a = sum_to {n = 1000000}
  println { msg = "sum 0..1M = $(a.to_str{})" }
  let b = sum_to {n = 10000000}
  println { msg = "sum 0..10M = $(b.to_str{})" }
