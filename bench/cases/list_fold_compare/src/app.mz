# In-process timing of user-recursive List fold. Strips JVM boot + println
# init from the measurement — we time only the fold loop itself.
#
# Warmup: 3 folds to let JIT compile the recursive functions.
# Measured: 10 folds, report min/median/max in µs per fold.
use std::effects::log::{println, Console}
use std::effects::time::{Time, SystemTime, monotonic}
use std::datetime::{duration_to_nanos, sub_duration}
use std::collections::list
use std::collections::seq

let user_fold = {xs, init, f} -> match list::uncons {xs = xs} is
    None -> init
    Some {val = {head, tail}} -> user_fold {xs = tail, init = f {acc = init, x = head}, f = f}

let build = {n, acc} -> if n == 0
    then acc
    else build {n = n - 1, acc = list::cons {head = n, tail = acc}}

# Time one fold, return {sum, ns}
let time_one = {xs} -> perform SystemTime in do
    let t0 = monotonic {}
    let s = user_fold {xs = xs, init = 0, f = {acc, x} -> acc + x}
    let t1 = monotonic {}
    let ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } }
    { sum = s, ns = ns }

# Run k timed folds, collect their ns into a Seq
let time_k = {xs, k, acc} -> if k == 0
    then acc
    else do
      let r = time_one {xs = xs}
      time_k {xs = xs, k = k - 1, acc = seq::push {xs = acc, x = r.ns}}

let main = {} -> perform Console in perform SystemTime in do
    let n = 1000000
    let xs = build {n = n, acc = list::empty {}}

    # Warmup — 3 folds, discard timing
    let _w = time_k {xs = xs, k = 3, acc = []}

    # Measured — 10 folds
    let times = time_k {xs = xs, k = 10, acc = []}
    let sorted = seq::sort {xs = times}
    let n_times = seq::size {xs = sorted}

    let min_ns = match seq::get {xs = sorted, i = 0} is
        Some {val} -> val
        None -> 0
    let med_ns = match seq::get {xs = sorted, i = n_times / 2} is
        Some {val} -> val
        None -> 0
    let max_ns = match seq::get {xs = sorted, i = n_times - 1} is
        Some {val} -> val
        None -> 0

    println { msg = "list-recursive fold N=$(n.to_str{}) — per-fold ns min/med/max:" }
    println { msg = "  min = $(min_ns.to_str{})" }
    println { msg = "  med = $(med_ns.to_str{})" }
    println { msg = "  max = $(max_ns.to_str{})" }
