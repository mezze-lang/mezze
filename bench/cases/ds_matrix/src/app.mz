# Phase G0 (#481) baseline bench matrix.
#
# Per-op × per-collection. The regression gate for the Phase G storage and Iter
# tickets, which is why how it reports matters as much as what it measures.
#
# EVERY NUMBER IS A RATIO TO A CONTROL MEASURED IN THIS SAME PROCESS, and that
# is the whole design. A bare counted loop over the same arithmetic is timed
# alongside the collection ops; each op prints `xNNN` against it, hundredths.
# Absolute nanoseconds cannot be compared between two builds of the compiler on
# a machine that drifts — tried repeatedly, and every cross-build figure taken
# that way turned out to be wrong, by factors up to 500x. A ratio to a control
# that the change under test cannot affect does survive, because the drift
# divides out.
#
# IT ALSO REFUSES TO BE MISREAD. When a median sits more than twice its own
# minimum the row is marked `UNDER-WARMED`, because that is what a measurement
# short of steady state looks like and it reads exactly like a real regression.
# At N=10 000 every row here was under-warmed and the figures were ~500x the
# steady-state cost: `seq::filter+size` read 117-151 ns/elem where it actually
# costs well under one. A target was picked off those numbers that did not
# exist.
#
# N defaults high for the same reason. The old default of 10 000 was kept
# because `list::map`/`filter` were "100-644x slower than seq counterparts" and
# larger N hung; neither holds — list is comparable or faster, and both are
# sub-nanosecond per element once warm.
use std::effects::log::{println, Console}
use std::effects::time::{Time, SystemTime, monotonic}
use std::datetime::{duration_to_nanos, sub_duration}
use std::collections::seq
use std::collections::list
use std::effects::args::{ SystemArgs, argv }
use std::int

# --- builders ---

let build_list = {n, acc} -> if n == 0
    then acc
    else build_list {n = n - 1, acc = list::cons {head = n, tail = acc}}

# --- timing wrapper ---

# THE RESULT IS CARRIED OUT, and that is not bookkeeping. `let r = thunk {}`
# with `r` unused leaves the whole row DELETABLE, and it was being deleted:
# `seq::map+size` read ratios of 1, 10, 1, 74, 1 over five runs at n=2e6 — a
# ratio of 1/100 is the row costing a hundredth of the control, which no
# allocating map does. `size(map(xs, f))` is provably `size(xs)` for a loop
# -invariant `xs`, so with nothing consuming it there is nothing to compute.
#
# Every sibling case states this as a rule — "EVERY ROW CHECKSUMS: a kernel that
# got fast by not doing the work shows up as a different number instead of a
# better one" — and this one, the Phase G regression gate, was the one that did
# not. Threading the value to a `println` makes it escape.
let time_one = {thunk} -> perform SystemTime in do
    let t0 = monotonic {}
    let r = thunk {}
    let t1 = monotonic {}
    { ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } }, sum = r }

let time_k_go = {thunk, k, acc, last} -> if k == 0
    then { times = acc, sum = last }
    else do
        let o = time_one {thunk = thunk}
        time_k_go {thunk = thunk, k = k - 1, acc = seq::push {xs = acc, x = o.ns}, last = o.sum}

# The FLOOR: visit n values and add them, with no collection in the way. Timed
# by the same path as every op below, so the ratio is apples to apples.
let control_loop = {i, acc} -> if i <= 0 then acc else control_loop {i = i - 1, acc = acc + i}

# Pulled out so `min_of` can end on a record literal: a trailing `match` arm
# swallows the do-block's result expression.
let nth_or_zero = {xs, i} -> match seq::get {xs = xs, i = i} is
    Some {val} -> val
    None -> 0

let min_of = {thunk, warm, k} -> do
    time_k_go {thunk = thunk, k = warm, acc = [], last = 0}
    let run = time_k_go {thunk = thunk, k = k, acc = [], last = 0}
    let sorted = seq::sort {xs = run.times}
    let half = seq::size {xs = sorted} / 2
    { min = nth_or_zero {xs = sorted, i = 0}, med = nth_or_zero {xs = sorted, i = half},
      sum = run.sum }

# ONE OP PER PROCESS when `sel` says so, and that is not a convenience.
#
# `sel = 0` RUNS THEM ALL IN ONE PROCESS AND ITS NUMBERS DO NOT COMPARE. Read
# across the rows of one such run and you get published-looking nonsense:
# `list::map+size` reads 1 776 ps/elem there and 3 790 on its own, which turns
# a parity against `seq::map+size` into a 3x, and `seq::count` reads 153 —
# below the control, for a scan with a guest predicate per element — against
# 3 646 alone. Both were believed for a while. The banner below says so on the
# way past; the per-row ratio is the only figure that survives, and only from a
# process that ran one row.
# Building a 1M cons list and a 1M seq in the same process GCs while the timer
# runs: the control stayed flagged UNDER-WARMED at every N, and `seq::count`
# swung 149 -> 4465 ps/elem between two runs of the same binary. A seq-only
# bench in a fresh process was stable to within 40% over eight reps. So the
# driver below runs each row on its own, and `sel = 0` keeps the old
# all-in-one-process behaviour for a quick look.
let report = {idx, sel, label, thunk, floor_ns, n, warm, k} -> perform Console in perform SystemTime in
  if sel != 0 && sel != idx then {} else do
    let t = min_of {thunk = thunk, warm = warm, k = k}
    let ps_per_elem = (t.min * 1000) / n
    let ratio_x100 = if floor_ns == 0 then 0 else (t.min * 100) / floor_ns
    # A median past twice the minimum is not a slow op, it is an unfinished
    # measurement. Say so on the row rather than leaving a reader to divide.
    let warn = if t.med > (t.min * 2) then "   UNDER-WARMED (raise N or passes)" else ""
    println { msg = "  $(label): $(ps_per_elem.to_str{}) ps/elem  x$(ratio_x100.to_str{})/100 floor  sum=$(t.sum.to_str{})$(warn)" }

# --- main ---

# N from the command line, defaulting to the original 10 000 so an existing
# invocation reads the same. The header kept it small because list::map and
# list::filter were 100-644x slower than their seq counterparts and a larger N
# hung; list is now comparable, so the per-element cost is worth seeing at a
# size where per-call overhead and warmup do not dominate. At 10 000 the median
# runs 2-10x the min, which is what an under-warmed measurement looks like.
let arg_at_i = { args, i, def } -> match seq::get { xs = args, i = i } is
    Some { val } -> match int::from_str { s = val } is
        Some { val = v } -> v
        None -> def
    None -> def

let arg_n = { args, def } -> match seq::get { xs = args, i = 0 } is
    Some { val } -> match int::from_str { s = val } is
        Some { val = v } -> v
        None -> def
    None -> def

let main = {} -> perform Console in perform SystemArgs in perform SystemTime in do
    let n = arg_n { args = argv {}, def = 200000 }
    let sel = arg_at_i { args = argv {}, i = 1, def = 0 }
    let warm = 5
    let k = 12
    let floor = min_of {thunk = {} -> control_loop {i = n, acc = 0}, warm = warm, k = k}
    let floor_ps = (floor.min * 1000) / n
    println { msg = "Phase G0 baseline (N=$(n.to_str{})): $(warm.to_str{}) warmup + $(k.to_str{}) measured, MIN per row" }
    println { msg = "control: a counted loop, no collection = $(floor_ps.to_str{}) ps/elem. Every row below is xNNN/100 of it." }
    if floor.med > (floor.min * 2) then
        println { msg = "!! the CONTROL is under-warmed, so every ratio below is suspect — raise N" }
    else
        println { msg = "" }
    let seq_ns = seq::range {start = 0, end = n}
    let list_ns = build_list {n = n, acc = list::empty {}}

    # SEQ (native fused, reference)
    println { msg = "" }
    println { msg = "-- SEQ (reference) --" }
    report {idx = 1, sel = sel, label = "seq::fold        (sum)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::fold {xs = seq_ns, init = 0, f = {acc, x} -> acc + x}}
    report {idx = 2, sel = sel, label = "seq::sum         (native)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::sum {xs = seq_ns}}
    report {idx = 3, sel = sel, label = "seq::map+size    (alloc)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::size {xs = seq::map {xs = seq_ns, f = {x} -> x + 1}}}
    report {idx = 4, sel = sel, label = "seq::filter+size (alloc)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::size {xs = seq::filter {xs = seq_ns, p = {x} -> x % 2 == 0}}}
    report {idx = 5, sel = sel, label = "seq::any (miss)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> if seq::any {xs = seq_ns, p = {x} -> x == (0 - 1)} then 1 else 0}
    report {idx = 6, sel = sel, label = "seq::count", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::count {xs = seq_ns, p = {x} -> x % 2 == 0}}

    # LIST (Mezze recursion for HOFs, native storage)
    println { msg = "" }
    println { msg = "-- LIST (Mezze HOFs) --" }
    report {idx = 7, sel = sel, label = "list::fold_left  (sum)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> list::fold_left {xs = list_ns, init = 0, f = {acc, x} -> acc + x}}
    report {idx = 8, sel = sel, label = "list::map+size   (alloc)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> list::size {xs = list::map {xs = list_ns, f = {x} -> x + 1}}}
    report {idx = 9, sel = sel, label = "list::filter+size(alloc)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> list::size {xs = list::filter {xs = list_ns, p = {x} -> x % 2 == 0}}}
    report {idx = 10, sel = sel, label = "list::any (miss)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> if list::any {xs = list_ns, p = {x} -> x == (0 - 1)} then 1 else 0}
    report {idx = 11, sel = sel, label = "list::count", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> list::count {xs = list_ns, p = {x} -> x % 2 == 0}}
    # THE MISSING CONTROL. `seq` has a native-sum row and `list` did not, so
    # nothing separated the two things a List row pays: walking the cons cells,
    # and calling back into guest code per element. `list::sum` walks and takes
    # no callback, so `fold_left - sum` is the callback and `sum` is the walk.
    report {idx = 13, sel = sel, label = "list::sum        (native)", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> list::sum {xs = list_ns}}

    # RANGE fusion
    println { msg = "" }
    println { msg = "-- RANGE.fold (fusion target) --" }
    report {idx = 12, sel = sel, label = "range.fold direct", floor_ns = floor.min, n = n, warm = warm, k = k, thunk = {} -> seq::fold {xs = seq::range {start = 0, end = n}, init = 0, f = {acc, x} -> acc + x}}
