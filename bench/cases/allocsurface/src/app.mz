## WHAT ALLOCATES, PER ITERATION.
##
## Young-collection counts do NOT care about CPU contention, which makes them
## the one kind of evidence that survives a loaded machine — and the one that
## caught three findings in this effort already. So this case asks only "does it
## allocate", across shapes the ledger had as UNKNOWN, and leaves the
## picoseconds for a quiet box.
##
## READ IT AS: kernel 1's collection count is the floor. A kernel near it
## allocates nothing per iteration; a kernel far above it allocates, and the
## multiple is roughly how much.
##
##   MEZZE_JAVA_OPTS=-Xlog:gc ./.build/allocsurface <k> <n> 2>&1 | grep -c "Pause Young"
##
## Every kernel computes a checksum that depends on the operation, so none of
## them can be folded away — but the checksums DIFFER between kernels here,
## unlike every other case in this directory, because the operations are not
## interchangeable. Each kernel's expected value is stated beside it.
use std::collections::seq
use std::collections::map
use std::collections::list
use std::collections::set
use std::effects::log::{ println, Console }
use std::effects::time::{ SystemTime, monotonic }
use std::datetime::{ duration_to_nanos, sub_duration }
use std::effects::args::{ SystemArgs, argv }
use std::str
use std::int

let arg_at = { args, i, def } -> match seq::get { xs = args, i = i } is
  Some { val } -> match int::from_str { s = val } is
    Some { val = v } -> v
    None -> def
  None -> def

let time_it = { f } -> perform SystemTime in do
  let t0 = monotonic {}
  let r = f {}
  let t1 = monotonic {}
  { result = r, ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } } }

## 1. CONTROL — nothing allocates. sum = n*(n+1)/2.
let go_c = { i, acc } ->
  if i <= 0 then acc
  else go_c { i = i - 1, acc = acc + i }
let k_control = { n } -> go_c { i = n, acc = 0 }

## 2. RECORD UPDATE per iteration: `{ ...r, a = … }` where the record OUTLIVES
##    the expression, so none of the record passes can erase it. This is the
##    shape every "update one field of my state" writes.
let go_u = { i, acc, r } ->
  if i <= 0 then acc + r.a
  else go_u { i = i - 1, acc = acc + r.a, r = { ...r, a = i } }
let k_update = { n } -> go_u { i = n, acc = 0, r = { a = 0, b = 7 } }

## 3. STRING CONCAT per iteration. Two fixed strings, so the result is the same
##    every time and only the allocation varies. sum = n (one per length-2).
let go_s = { i, acc } ->
  if i <= 0 then acc
  else go_s { i = i - 1, acc = acc + str::size { s = str::concat { l = "a", r = "b" } } }
let k_concat = { n } -> go_s { i = n, acc = 0 }

## 4. STRING INTERPOLATION per iteration — the same two characters, built the
##    way a program actually builds strings.
let go_p = { i, acc } ->
  if i <= 0 then acc
  else go_p { i = i - 1, acc = acc + str::size { s = "a$("b")" } }
let k_interp = { n } -> go_p { i = n, acc = 0 }

## 5. MAP GET per iteration against a map built ONCE. A lookup should allocate
##    nothing except the `Option` it returns — which, per the variant fold, is
##    exactly the shape that should now disappear.
let go_m = { i, acc, m } ->
  if i <= 0 then acc
  else go_m { i = i - 1, acc = acc + (match map::get { m = m, k = 1 } is
                                       Some { val } -> val
                                       None -> 0), m = m }
let k_map_get = { n } -> go_m { i = n, acc = 0, m = map::insert { m = map::empty {}, k = 1, v = 1 } }

## 6. MAP INSERT per iteration, each one producing a new map. A persistent map
##    must allocate here; the question is how much.
let go_i = { i, acc } ->
  if i <= 0 then acc
  else go_i { i = i - 1, acc = acc + map::size { m = map::insert { m = map::empty {}, k = i, v = i } } }
let k_map_insert = { n } -> go_i { i = n, acc = 0 }

## 7. SEQ INDEX per iteration against a seq built once. Should allocate nothing
##    beyond the Option.
let go_g = { i, acc, xs } ->
  if i <= 0 then acc
  else go_g { i = i - 1, acc = acc + (match seq::get { xs = xs, i = 0 } is
                                        Some { val } -> val
                                        None -> 0), xs = xs }
let k_seq_get = { n } -> go_g { i = n, acc = 0, xs = seq::range { start = 1, end = 3 } }

## 8. MAP CONTAINS_KEY per iteration — the DISCRIMINATOR for kernel 5. Same map,
##    same key, same hash-and-probe native; the only difference is that this one
##    returns a Bool where `get` returns an `Option`. If this sits at the control
##    and kernel 5 does not, the allocation in kernel 5 is the Option and not the
##    lookup.
let go_k = { i, acc, m } ->
  if i <= 0 then acc
  else go_k { i = i - 1, acc = acc + (if map::contains_key { m = m, k = 1 } then 1 else 0), m = m }
let k_map_has = { n } -> go_k { i = n, acc = 0, m = map::insert { m = map::empty {}, k = 1, v = 1 } }

## 9. MAP SIZE per iteration — a native call that does NO lookup and returns an
##    Int. This is the "does calling a native in a loop allocate at all" control,
##    so that kernel 8 reading low cannot be mistaken for the call being free
##    while kernel 5 reading high is blamed on the wrong thing.
let go_z = { i, acc, m } ->
  if i <= 0 then acc
  else go_z { i = i - 1, acc = acc + map::size { m = m }, m = m }
let k_map_size = { n } -> go_z { i = n, acc = 0, m = map::insert { m = map::empty {}, k = 1, v = 1 } }

## 10. TIER CONTROL — the arity cliff, isolated.
##
## Kernel 1 is on the FUSED tail-loop tier: the whole loop runs as Java with no
## per-iteration bytecode. Every kernel from 2 onwards is off that tier, so
## "kernel N minus kernel 1" charges the tier gap to whatever N was testing. This
## kernel is off the tier too, for a reason that has nothing to do with anything
## else here: it takes FOUR parameters, and `BytecodeCompiler` dispatches the
## fused tier only for paramCount 1, 2 and 3. Its body is pure arithmetic over
## its own parameters — no call, no native, no record, no string, nothing that
## can allocate — and `MEZZE_TRACE_SELFTAIL` confirms it compiles to exactly
## FOUR params, so nothing else differs from kernel 1.
##
## MEASURED: 568 ps/iter against kernel 1's 216, and 3 young collections against
## 2. So the arity cliff costs ~2.6x in TIME and nothing in allocation. An
## off-fused-tier loop does NOT allocate per iteration.
##
## sum = n*(n+1)/2, the same as kernel 1.
let go_4 = { i, acc, p, q } ->
  if i <= 0 then acc
  else go_4 { i = i - 1, acc = acc + i, p = p, q = q }
let k_tier = { n } -> go_4 { i = n, acc = 0, p = 0, q = 0 }

## 11. THE SAME LOOP, with TWO MORE ADDS IN THE BASE CASE. Nothing else changes:
##     same four parameters, same condition, same per-iteration updates. The only
##     edit is `then acc` becoming `then acc + p + q`, in the branch that runs
##     ONCE, after the loop is over.
##
## MEASURED: 29 178 ps/iter and 33 young collections, against kernel 10's 568 ps
## and 3. Fifty-two times slower and eleven times the allocation, decided by a
## branch that executes once.
##
## WHY. `MEZZE_TRACE_SELFTAIL` reports `go_5 params=6` where the source declares
## four. The two extra are `__dict_` parameters: the extra adds raise more
## `NumAdd` constraints than monomorphisation discharges, the function stays
## dictionary-passing, and a dictionary-passing loop allocates per iteration and
## loses every tier. Kernel 10 with the single add compiles to params=4 and no
## dictionaries.
##
## This pair is why the case has a kernel 10 at all. The first version of kernel
## 10 WAS this kernel — the base case was written `acc + p + q` without a
## thought — and its 33 collections were read as "the off-tier loop allocates
## per iteration", which then explained every other row in the case. It was the
## dictionaries. Both spellings are kept here so the difference is a measurement
## rather than a memory.
##
## sum = n*(n+1)/2, the same as kernel 1, because p and q are 0.
let go_5 = { i, acc, p, q } ->
  if i <= 0 then acc + p + q
  else go_5 { i = i - 1, acc = acc + i, p = p, q = q }
let k_dict = { n } -> go_5 { i = n, acc = 0, p = 0, q = 0 }

## 12. THE SAME SHAPE AS KERNEL 9, ON THE SCALAR NATIVE ABI. `str::size` of a
##     string carried as a loop parameter: a native call returning an Int that
##     allocates nothing, exactly like `map::size` in kernel 9. The ONLY
##     difference is which ABI the call uses.
##
## `__native_string_size` is declared in the NativeOp DSL, so
## `NativeSignatures.signatureOf` returns a signature and `TypedASTCompiler`
## emits `CallNativeIR(arg=UnitLitIR, args=[s], argKinds=[OBJECT])` — positional,
## typed, no record. `__native_map_size` is NOT declared (the table holds 128
## signatures: float, int, string, nat, char, bool, and nothing for map, seq,
## list or set), so kernel 9 emits
## `CallNativeIR(arg=MakeRecordIR(...), args=[], argKinds=[])` — a MezzeRecord
## allocated per call and looked up by field name.
##
## Kernel 9 minus kernel 12 is therefore the cost of the argument record, with
## everything else held equal. Both are semantically allocation-free, so kernel
## 12 should sit near the off-tier control at 3 collections.
##
## sum = n, the same as kernel 9, because the string is one character.
let go_y = { i, acc, s } ->
  if i <= 0 then acc
  else go_y { i = i - 1, acc = acc + str::size { s = s }, s = s }
## THE STRING MUST NOT BE A LITERAL, and this is the whole point of the kernel.
##
## The first version passed `s = "a"`. A literal is a compile-time constant and
## `__native_string_size` is declared `pure`, so the entire call folded to 1 and
## the kernel stopped measuring a native call at all: it read 577 ps and 3 young
## collections, sitting exactly on the off-tier control, and that reading was
## written up as "a native call on the scalar ABI is free" — and a 13x record-ABI
## penalty derived from it. A no-op probe handler proved the error: with a handler
## that touched nothing, `map::size` still read 13 collections while this kernel
## read 3, which cannot be true of the shared machinery.
##
## `n` arrives from argv, so `int::to_str { n = n }` is opaque to the compiler;
## taking one character keeps the size 1 and the checksum n, as kernel 9.
let k_str_size = { n } -> go_y {
  i = n, acc = 0,
  s = str::substring { s = int::to_str { n = n }, start = 0, end = 1 },
}

## 13. LIST GET per iteration against a list built ONCE. Same shape as kernel 7
##     (`seq::get`): a lookup returning an `Option`, nothing it must allocate.
##     `list::get` routes to `__native_list_get`, whose declared field is
##     `index` rather than `i` — a positional port that guessed `i` would miss
##     the all-params-present check and fall back to the record path in silence,
##     so this kernel is also what proves the field name right.
let go_l = { i, acc, xs } ->
  if i <= 0 then acc
  else go_l { i = i - 1, acc = acc + (match list::get { xs = xs, index = 0 } is
                                        Some { val } -> val
                                        None -> 0), xs = xs }
let k_list_get = { n } -> go_l { i = n, acc = 0, xs = list::from_seq { xs = seq::range { start = 1, end = 3 } } }

## 14. SET CONTAINS per iteration against a set built ONCE. Returns a `Bool`, so
##     like kernel 8 it has no `Option` in the way, and nothing it must allocate.
let go_st = { i, acc, s } ->
  if i <= 0 then acc
  else go_st { i = i - 1, acc = acc + (if set::contains { s = s, x = 1 } then 1 else 0), s = s }
let k_set_has = { n } -> go_st { i = n, acc = 0, s = set::from_seq { xs = seq::range { start = 1, end = 2 } } }

let report = { name, n, r } ->
  println { msg = "$(name)  $(int::to_str { n = r.ns * 1000 / n }) ps/iter  sum=$(int::to_str { n = r.result })" }

pub let main = {} -> perform Console in perform SystemArgs in do
  let args = argv {}
  let k = arg_at { args = args, i = 0, def = 1 }
  let n = arg_at { args = args, i = 1, def = 20000000 }
  if k == 1 then do
    k_control { n = n }
    report { name = "1 control      ", n = n, r = time_it { f = {} -> k_control { n = n } } }
    report { name = "1 control      ", n = n, r = time_it { f = {} -> k_control { n = n } } }
  else if k == 2 then do
    k_update { n = n }
    report { name = "2 record update", n = n, r = time_it { f = {} -> k_update { n = n } } }
    report { name = "2 record update", n = n, r = time_it { f = {} -> k_update { n = n } } }
  else if k == 3 then do
    k_concat { n = n }
    report { name = "3 str concat   ", n = n, r = time_it { f = {} -> k_concat { n = n } } }
    report { name = "3 str concat   ", n = n, r = time_it { f = {} -> k_concat { n = n } } }
  else if k == 4 then do
    k_interp { n = n }
    report { name = "4 str interp   ", n = n, r = time_it { f = {} -> k_interp { n = n } } }
    report { name = "4 str interp   ", n = n, r = time_it { f = {} -> k_interp { n = n } } }
  else if k == 5 then do
    k_map_get { n = n }
    report { name = "5 map get      ", n = n, r = time_it { f = {} -> k_map_get { n = n } } }
    report { name = "5 map get      ", n = n, r = time_it { f = {} -> k_map_get { n = n } } }
  else if k == 6 then do
    k_map_insert { n = n }
    report { name = "6 map insert   ", n = n, r = time_it { f = {} -> k_map_insert { n = n } } }
    report { name = "6 map insert   ", n = n, r = time_it { f = {} -> k_map_insert { n = n } } }
  else if k == 7 then do
    k_seq_get { n = n }
    report { name = "7 seq get      ", n = n, r = time_it { f = {} -> k_seq_get { n = n } } }
    report { name = "7 seq get      ", n = n, r = time_it { f = {} -> k_seq_get { n = n } } }
  else if k == 8 then do
    k_map_has { n = n }
    report { name = "8 map has      ", n = n, r = time_it { f = {} -> k_map_has { n = n } } }
    report { name = "8 map has      ", n = n, r = time_it { f = {} -> k_map_has { n = n } } }
  else if k == 9 then do
    k_map_size { n = n }
    report { name = "9 map size     ", n = n, r = time_it { f = {} -> k_map_size { n = n } } }
    report { name = "9 map size     ", n = n, r = time_it { f = {} -> k_map_size { n = n } } }
  else if k == 10 then do
    k_tier { n = n }
    report { name = "10 tier control", n = n, r = time_it { f = {} -> k_tier { n = n } } }
    report { name = "10 tier control", n = n, r = time_it { f = {} -> k_tier { n = n } } }
  else if k == 11 then do
    k_dict { n = n }
    report { name = "11 dict-passing", n = n, r = time_it { f = {} -> k_dict { n = n } } }
    report { name = "11 dict-passing", n = n, r = time_it { f = {} -> k_dict { n = n } } }
  else if k == 12 then do
    k_str_size { n = n }
    report { name = "12 str size    ", n = n, r = time_it { f = {} -> k_str_size { n = n } } }
    report { name = "12 str size    ", n = n, r = time_it { f = {} -> k_str_size { n = n } } }
  else if k == 13 then do
    k_list_get { n = n }
    report { name = "13 list get    ", n = n, r = time_it { f = {} -> k_list_get { n = n } } }
    report { name = "13 list get    ", n = n, r = time_it { f = {} -> k_list_get { n = n } } }
  else if k == 14 then do
    k_set_has { n = n }
    report { name = "14 set has     ", n = n, r = time_it { f = {} -> k_set_has { n = n } } }
    report { name = "14 set has     ", n = n, r = time_it { f = {} -> k_set_has { n = n } } }
  else println { msg = "unknown kernel" }
