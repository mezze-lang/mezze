## THE TEST `mezze-benchmark/RESULTS.md` ASKED FOR AND MARKED UNVERIFIED.
##
## That file measures mandelbrot at 2 212.5 ns/px against Scala's 18.1, Kotlin's
## 22.2 and C's 22.9 — 122x, where eight of ten languages land within 1.8x of
## each other. Its stated hypothesis:
##
##   "the escape loop carries unresolved `NumMul 'd 'd having 'out = 'f`, and a
##    `NumSub Float 'a having 'out = Float` leaks all the way out to main's
##    signature. If `Float * Float` is not monomorphising to a native float
##    multiply, every operation stays a generic ability call and no amount of
##    JIT fixes it. **Unverified** — it is a hypothesis with a clear test, and it
##    lives in the mezze repo, not here."
##
## This is that test. Both kernels are the SAME escape loop, byte for byte,
## except that kernel 2's parameters carry their types. Un-annotated, `zr * zr`
## is `NumMul 'a 'a having 'out = 'b` and the function takes dictionaries;
## annotated, it is a Float multiply. Same arithmetic, same checksum, same
## recursion — the only difference is whether the operations are concrete.
##
## It is NOT a recommendation to annotate. An annotation that changes
## performance means inference is leaving something on the table; the point of
## measuring it is to size that, and `bench/cases/defunc` already puts the same
## effect at 57x for a callback passed as a value.
use std::effects::log::{ println, Console }
use std::effects::time::{ SystemTime, monotonic }
use std::datetime::{ duration_to_nanos, sub_duration }
use std::effects::args::{ SystemArgs, argv }
use std::collections::seq
use std::collections::iter
use std::float
use std::int

let arg_at = { args, i, def } -> match seq::get { xs = args, i = i } is
  Some { val } -> match int::from_str { s = val } is
    Some { val = v } -> v
    None -> def
  None -> def

let time_it = { f } -> perform SystemTime in do
  let t0 = monotonic {}
  let r = f {}
  let t1 = monotonic {}
  { result = r, ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } } }

let limit = 50

## ── 1. AS THE BENCHMARK HAS IT: no annotations anywhere.
let escape_poly = { cr, ci, zr, zi, i } ->
  if i >= limit then i
  else do
    let zr2 = zr * zr
    let zi2 = zi * zi
    if zr2 + zi2 > 4.0 then i
    else escape_poly {
      cr = cr,
      ci = ci,
      zr = zr2 - zi2 + cr,
      zi = 2.0 * zr * zi + ci,
      i = i + 1,
    }

let pixel_poly = { p, side, span } -> do
  let px = float::from_int { n = p % side }
  let py = float::from_int { n = p / side }
  escape_poly {
    cr = px * 3.0 / span - 2.0,
    ci = py * 3.0 / span - 1.5,
    zr = 0.0,
    zi = 0.0,
    i = 0,
  }

## ── 2. THE SAME LOOP with its types written down. Nothing else differs.
let escape_mono: { cr: Float, ci: Float, zr: Float, zi: Float, i: Int } -> Int =
  { cr, ci, zr, zi, i } ->
    if i >= limit then i
    else do
      let zr2 = zr * zr
      let zi2 = zi * zi
      if zr2 + zi2 > 4.0 then i
      else escape_mono {
        cr = cr,
        ci = ci,
        zr = zr2 - zi2 + cr,
        zi = 2.0 * zr * zi + ci,
        i = i + 1,
      }

let pixel_mono: { p: Int, side: Int, span: Float } -> Int = { p, side, span } -> do
  let px = float::from_int { n = p % side }
  let py = float::from_int { n = p / side }
  escape_mono {
    cr = px * 3.0 / span - 2.0,
    ci = py * 3.0 / span - 1.5,
    zr = 0.0,
    zi = 0.0,
    i = 0,
  }

## The grid walk is `iter::range().fold()` in both — the shape
## `mezze-benchmark/mezze/src/mandelbrot.mz` uses, so these numbers sit beside
## its 2 212.5 ns/px directly rather than needing a translation.
##
## A plain tail loop was tried here first and the POLY side would not compile:
## `[BDSL] compile failed for lambda reason=unsupported
## (node=CallDirectIR:target-not-compiled)`. That is its own bug — a shape that
## type-checks and does not compile — and it is recorded rather than chased,
## because it is not what this bench is for.
let grid_poly = { side, span } ->
  iter::range { start = 0, end = side * side }
    .fold { init = 0, f = { acc, x } -> acc + pixel_poly { p = x, side = side, span = span } }

let grid_mono = { side, span } ->
  iter::range { start = 0, end = side * side }
    .fold { init = 0, f = { acc, x } -> acc + pixel_mono { p = x, side = side, span = span } }

let report = { name, px, r } ->
  println { msg = "$(name)  $(int::to_str { n = r.ns / px }) ns/px  sum=$(int::to_str { n = r.result })" }

pub let main = {} -> perform Console in perform SystemArgs in do
  let args = argv {}
  let k = arg_at { args = args, i = 0, def = 1 }
  let side = arg_at { args = args, i = 1, def = 400 }
  let span = float::from_int { n = side }
  let px = side * side
  if k == 1 then do
    grid_poly { side = 40, span = float::from_int { n = 40 } }
    report { name = "1 escape POLY (no annot)", px = px, r = time_it { f = {} -> grid_poly { side = side, span = span } } }
    report { name = "1 escape POLY (no annot)", px = px, r = time_it { f = {} -> grid_poly { side = side, span = span } } }
  else do
    grid_mono { side = 40, span = float::from_int { n = 40 } }
    report { name = "2 escape MONO (annot)   ", px = px, r = time_it { f = {} -> grid_mono { side = side, span = span } } }
    report { name = "2 escape MONO (annot)   ", px = px, r = time_it { f = {} -> grid_mono { side = side, span = span } } }
