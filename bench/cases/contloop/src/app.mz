## WHAT A PARK COSTS — the yield path, measured on the branch only (CoopAsync
## does not exist on main). Same block structure and checksum as contsurface.
##
##   1 control          a counted loop and an add
##   2 loop spawn+await CoopAsync: spawn + await per element — one park, one
##                      resume, one task switch each
##   3 loop yield_now   CoopAsync: yield_now per element — a park whose predicate
##                      is already true: the pure suspend/resume cost
##   4 loop park True   CoopAsync: park on `{} -> True` per element
##   5 loom spawn+await LoomAsync, in this case for a same-process reference
##   6 loop seq fold    CoopAsync: seq::fold whose callback spawns and awaits —
##                      a park THROUGH the resumable native, per element
##   7 loop iter        CoopAsync: the same through iter map -> fold (cursor route)
##   8 loop list fold   CoopAsync: the same through list::fold_left
##   9 loop fan-out     CoopAsync: spawn m tasks, then await them all (the
##                      realistic shape: m parks that mostly find settled promises)
use std::effects::log::{ println, Console }
use std::effects::args::{ SystemArgs, argv }
use std::effects::time::{ SystemTime, monotonic }
use std::datetime::{ duration_to_nanos, sub_duration }
use std::effects::async::{ Async, LoomAsync, CoopAsync, await, yield_now, park }
use std::collections::seq
use std::collections::iter
use std::collections::list
use std::result
use std::int

let arg_at = { args, i, def } -> match seq::get { xs = args, i = i } is
  Some { val } -> match int::from_str { s = val } is
    Some { val = v } -> v
    None -> def
  None -> def

let time_it = { f } -> perform SystemTime in do
  let t0 = monotonic {}
  let r = f {}
  let t1 = monotonic {}
  { ns = duration_to_nanos { d = sub_duration { a = t1, b = t0 } }, result = r }

let m = 1000
let m7 = { i } -> i - (i / 7) * 7
let outer = { b, acc, body } -> if b <= 0 then acc else outer { b = b - 1, acc = body { acc = acc }, body = body }
let xs = seq::range { start = 1, end = m + 1 }
let lst = list::from_seq { xs = xs }

## 1
let go_ctrl = { i, acc } -> if i <= 0 then acc else go_ctrl { i = i - 1, acc = acc + m7 { i = i } }
let k_control = { n } -> outer { b = n / m, acc = 0, body = { acc } -> go_ctrl { i = m, acc = acc } }

## 2 / 5
let go_spawn = { i, acc } -> if i <= 0 then acc else do
  let p = Async.spawn { f = {} -> m7 { i = i } }
  go_spawn { i = i - 1, acc = acc + result::get_or { result = await { p = p }, def = 0 } }
let k_loop_spawn = { n } -> perform CoopAsync in outer { b = n / m, acc = 0, body = { acc } -> go_spawn { i = m, acc = acc } }
let k_loom_spawn = { n } -> perform LoomAsync in outer { b = n / m, acc = 0, body = { acc } -> go_spawn { i = m, acc = acc } }

## 3
let go_yield = { i, acc } -> if i <= 0 then acc else do
  yield_now {}
  go_yield { i = i - 1, acc = acc + m7 { i = i } }
let k_loop_yield = { n } -> perform CoopAsync in outer { b = n / m, acc = 0, body = { acc } -> go_yield { i = m, acc = acc } }

## 4
let go_park = { i, acc } -> if i <= 0 then acc else do
  park { predicate = {} -> True }
  go_park { i = i - 1, acc = acc + m7 { i = i } }
let k_loop_park = { n } -> perform CoopAsync in outer { b = n / m, acc = 0, body = { acc } -> go_park { i = m, acc = acc } }

## 6..8 — the callback parks inside the native
let await_of = { x } -> result::get_or { result = await { p = Async.spawn { f = {} -> m7 { i = x } } }, def = 0 }
let k_loop_seq = { n } -> perform CoopAsync in outer { b = n / m, acc = 0,
  body = { acc } -> seq::fold { xs = xs, init = acc, f = { acc, x } -> acc + await_of { x = x } } }
let k_loop_iter = { n } -> perform CoopAsync in outer { b = n / m, acc = 0,
  body = { acc } -> iter::fold { it = iter::map { it = iter::from_seq { xs = xs }, f = { x } -> await_of { x = x } }, init = acc, f = { acc, x } -> acc + x } }
let k_loop_list = { n } -> perform CoopAsync in outer { b = n / m, acc = 0,
  body = { acc } -> list::fold_left { xs = lst, init = acc, f = { acc, x } -> acc + await_of { x = x } } }

## 9
let k_loop_fanout = { n } -> perform CoopAsync in outer { b = n / m, acc = 0,
  body = { acc } -> do
    let ps = seq::map { xs = xs, f = { x } -> Async.spawn { f = {} -> m7 { i = x } } }
    seq::fold { xs = ps, init = acc, f = { acc, x } -> acc + result::get_or { result = await { p = x }, def = 0 } } }

let report = { name, n, r } ->
  println { msg = "$(name)  $(int::to_str { n = r.ns * 1000 / n }) ps/iter  sum=$(int::to_str { n = r.result })" }

let bench = { name, n, f } -> do
  f {}
  f {}
  f {}
  report { name = name, n = n, r = time_it { f = f } }
  report { name = name, n = n, r = time_it { f = f } }
  report { name = name, n = n, r = time_it { f = f } }

pub let main = {} -> perform Console in perform SystemArgs in perform SystemTime in do
  let args = argv {}
  let k = arg_at { args = args, i = 0, def = 1 }
  let n = arg_at { args = args, i = 1, def = 100000 }
  if k == 1 then bench { name = "1 control         ", n = n, f = {} -> k_control { n = n } }
  else if k == 2 then bench { name = "2 loop spawn+await", n = n, f = {} -> k_loop_spawn { n = n } }
  else if k == 3 then bench { name = "3 loop yield_now  ", n = n, f = {} -> k_loop_yield { n = n } }
  else if k == 4 then bench { name = "4 loop park True  ", n = n, f = {} -> k_loop_park { n = n } }
  else if k == 5 then bench { name = "5 loom spawn+await", n = n, f = {} -> k_loom_spawn { n = n } }
  else if k == 6 then bench { name = "6 loop seq fold   ", n = n, f = {} -> k_loop_seq { n = n } }
  else if k == 7 then bench { name = "7 loop iter       ", n = n, f = {} -> k_loop_iter { n = n } }
  else if k == 8 then bench { name = "8 loop list fold  ", n = n, f = {} -> k_loop_list { n = n } }
  else if k == 9 then bench { name = "9 loop fan-out    ", n = n, f = {} -> k_loop_fanout { n = n } }
  else println { msg = "unknown kernel" }
