# Staged build outputs for the WASM image — regenerated by wasm-build/build.sh
# on every run, ~75MB of jars whose names carry a build timestamp, so each run
# would otherwise add a fresh copy to history.
website/wasm-build/.jars/
website/wasm-build/.classpath-hovers
website/wasm-build/.hover/

# wrangler's local cache
.wrangler/

# Brotli-compressed copies for R2, rebuilt on every deploy.
website/public/wasm/.br/
.claude/

