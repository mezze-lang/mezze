# Test case 1: Simple case that works
let add = {x, y} -> x + y

# Test case 2: Simple match that should infer x and y as same type
let simple = {color, x, y} ->
  match color is
    Red -> x + y
    Green -> x - y

# Test case 3: Full case with three operations
let sumColor = {color, x, y} ->
  match color is
    Red {z} -> x + y + z
    Green -> x - y
    Blue -> x * y
