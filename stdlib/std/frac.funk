# std/types/frac.funk - Fraction type operations

# Fraction type is implemented natively as a ratio of two integers
# Fractions are automatically reduced to lowest terms

# === ARITHMETIC OPERATIONS ===

# Add two fractions
pub let add = { left, right } -> __native_frac_add { left = left, right = right }

# Subtract two fractions  
pub let subtract = { left, right } -> __native_frac_subtract { left = left, right = right }

# Multiply two fractions
pub let multiply = { left, right } -> __native_frac_multiply { left = left, right = right }

# Divide two fractions
pub let divide = { left, right } -> __native_frac_divide { left = left, right = right }

# === COMPARISON OPERATIONS ===

# Check if two fractions are equal
pub let equals = { left, right } -> __native_frac_equals { left = left, right = right }

# Check if left fraction is less than right
pub let less_than = { left, right } -> __native_frac_less_than { left = left, right = right }

# Check if left fraction is greater than right
pub let greater_than = { left, right } -> __native_frac_greater_than { left = left, right = right }

# === CONVERSION OPERATIONS ===

# Convert fraction to float
pub let to_float = { frac } -> __native_frac_to_float { frac = frac }

# Convert fraction to string representation
pub let to_string = { frac } -> __native_frac_to_string { frac = frac }

# Create fraction from two integers (numerator, denominator)
pub let make = { numerator, denominator } -> __native_make_frac { numerator = numerator, denominator = denominator }

# Convert integer to fraction
pub let from_int = { int } -> __native_int_to_frac { int = int }

# Convert natural number to fraction
pub let from_nat = { nat } -> __native_nat_to_frac { nat = nat }

# === UTILITY OPERATIONS ===

# Get numerator of fraction
pub let numerator = { frac } -> __native_frac_numerator { frac = frac }

# Get denominator of fraction
pub let denominator = { frac } -> __native_frac_denominator { frac = frac }

# Reduce fraction to lowest terms (fractions are automatically reduced, but this is explicit)
pub let reduce = { frac } -> __native_reduce_frac { frac = frac }

# Get absolute value of fraction
pub let abs = { frac } -> __native_abs_frac { frac = frac }

# Negate fraction
pub let negate = { frac } -> __native_negate_frac { frac = frac }