use std::abilities::default
use std::abilities::inspect
## Tryable ability for `<-` do-bind syntax. The `ExceptionToResult`
## performer used by the synthetic perform is NOT in the prelude — it's
## injected surgically by the typechecker when desugaring `<-`, so users
## don't have it in their namespace.
use std::abilities::tryable
use std::int
use std::float
use std::nat
use std::frac
use std::bool
use std::str
use std::char
use std::option
use std::result
use std::collections::seq
use std::collections::list
use std::collections::map
use std::collections::set
use std::collections::deque
use std::collections::sorted_map
use std::collections::sorted_set
use std::collections::nonemptylist
use std::collections::bytes
