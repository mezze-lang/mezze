# Natural number utility functions
# This module provides utility functions for working with natural numbers
# Note: The Nat type and basic operations are now built-in

# Special subtraction that returns Int (since Nat - Nat can be negative)
pub let subtract_to_int = { l: Nat, r: Nat } ->
    __native_nat_subtract_to_int { l = l, r = r }

# Type conversions
pub let from_int = { n: Int } ->
    __native_nat_from_int { n = n }

pub let from_float = { n: Float } ->
    __native_nat_from_float { n = n }

pub let from_string = { s: String } ->
    __native_nat_from_string { s = s }

# Utility functions
pub let min = { l: Nat, r: Nat } ->
    __native_nat_min { l = l, r = r }

pub let max = { l: Nat, r: Nat } ->
    __native_nat_max { l = l, r = r }

pub let is_zero = { n: Nat } ->
    n == 0n

pub let is_even = { n: Nat } ->
    (n % 2n) == 0n

pub let is_odd = { n: Nat } ->
    if is_even { n = n } then False else True

# Convert Nat to Int (always succeeds since all naturals are valid integers)
# Example: to_int {n = 5n} -> 5
pub let to_int = { n: Nat } ->
    __native_nat_to_int { n = n }

# Convert Nat to String
# Example: to_string {n = 42n} -> "42"
pub let to_string = { n: Nat } ->
    __native_nat_to_string { n = n }

# Clamp value to range [min, max]
# Example: clamp {n = 15n, min = 0n, max = 10n} -> 10n
pub let clamp = { n: Nat, min: Nat, max: Nat } ->
    __native_nat_clamp { n = n, min = min, max = max }