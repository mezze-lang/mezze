use std::abilities::numeric::{ NumAdd, NumSub, NumMul, NumDiv, NumMod, NumZero, NumOne }
use std::abilities::compare::{ Eq, Ord }
use std::abilities::convert::{ Into, TryInto }
use std::abilities::default::{ Default }
use std::int
use std::float

impl NumAdd Nat for Nat having 'out = Nat where {
  add = { it, r } -> __native_nat_add { l = it, r = r }
}

## Nat + Int -> Int (widen the Nat receiver).
impl NumAdd Int for Nat having 'out = Int where {
  add = { it, r } -> std::int::from_nat { n = it } + r
}

## Nat + Float -> Float (widen the Nat receiver).
impl NumAdd Float for Nat having 'out = Float where {
  add = { it, r } -> std::float::from_nat { n = it } + r
}

## Nat - Nat -> Int (subtraction can underflow, so the result widens to Int).
impl NumSub Nat for Nat having 'out = Int where {
  sub = { it, r } -> subtract_to_int { l = it, r = r }
}

## Nat - Int -> Int (widen the Nat receiver).
impl NumSub Int for Nat having 'out = Int where {
  sub = { it, r } -> std::int::from_nat { n = it } - r
}

## Nat - Float -> Float (widen the Nat receiver).
impl NumSub Float for Nat having 'out = Float where {
  sub = { it, r } -> std::float::from_nat { n = it } - r
}

impl NumMul Nat for Nat having 'out = Nat where {
  mul = { it, r } -> __native_nat_multiply { l = it, r = r }
}

## Nat * Int -> Int (widen the Nat receiver).
impl NumMul Int for Nat having 'out = Int where {
  mul = { it, r } -> std::int::from_nat { n = it } * r
}

## Nat * Float -> Float (widen the Nat receiver).
impl NumMul Float for Nat having 'out = Float where {
  mul = { it, r } -> std::float::from_nat { n = it } * r
}

impl NumDiv Nat for Nat having 'out = Nat where {
  div = { it, r } -> __native_nat_divide { l = it, r = r }
}

## Nat / Int -> Int (widen the Nat receiver; still truncating integer division).
impl NumDiv Int for Nat having 'out = Int where {
  div = { it, r } -> std::int::from_nat { n = it } / r
}

## Nat / Float -> Float (widen the Nat receiver to exact division).
impl NumDiv Float for Nat having 'out = Float where {
  div = { it, r } -> std::float::from_nat { n = it } / r
}

impl NumMod Nat for Nat having 'out = Nat where {
  mod = { it, r } -> __native_nat_modulo { l = it, r = r }
}

## Nat % Int -> Int (widen the Nat receiver; still an integer remainder).
impl NumMod Int for Nat having 'out = Int where {
  mod = { it, r } -> std::int::from_nat { n = it } % r
}

## Nat % Float -> Float (widen the Nat receiver to a float remainder).
impl NumMod Float for Nat having 'out = Float where {
  mod = { it, r } -> std::float::from_nat { n = it } % r
}

impl Eq for Nat where {
  eq = { it, r } -> __native_nat_eq { l = it, r = r },
  neq = { it, r } -> __native_nat_neq { l = it, r = r },
}

impl Ord for Nat where {
  lt = { it, r } -> __native_nat_lt { l = it, r = r },
  le = { it, r } -> __native_nat_le { l = it, r = r },
  gt = { it, r } -> __native_nat_gt { l = it, r = r },
  ge = { it, r } -> __native_nat_ge { l = it, r = r },
}

impl Into Int for Nat where {
  into = { it } -> __native_nat_to_int { n = it }
}

impl Into Str for Nat where {
  into = { it } -> __native_nat_to_str { n = it }
}

impl Into Float for Nat where {
  into = { it } -> __native_float_from_nat { n = it }
}

impl TryInto Nat | ConversionError { msg: Str } | for Str where {
  try_into = { it } -> match __native_nat_from_string { s = it } is
    Some { val } -> Ok { val = val }
    None -> Err { error = ConversionError { msg = "invalid nat" } }

}

impl NumZero for Nat where {
  zero = {} -> 0n,
  is_zero = { it } -> it == 0n,
}

impl NumOne for Nat where {
  one = {} -> 1n
}

impl Default for Nat where {
  default = {} -> 0n
}

## Subtract two Nats, returning an Int (result may be negative).
pub let subtract_to_int: { l: Nat, r: Nat } -> Int = { l, r } -> __native_nat_subtract_to_int { l = l, r = r }

## Convert an Int to a Nat. Returns None if negative.
pub let from_int: { n: Int } -> Option Nat = { n } -> __native_nat_from_int { n = n }

## Convert a Float to a Nat. Returns None if negative or non-integer.
pub let from_float: { n: Float } -> Option Nat = { n } -> __native_nat_from_float { n = n }

## Parse a string as a Nat. Returns None on failure.
pub let from_string: { s: Str } -> Option Nat = { s } -> __native_nat_from_string { s = s }

## Return the smaller of two Nats.
pub let min: { l: Nat, r: Nat } -> Nat = { l, r } -> __native_nat_min { l = l, r = r }

## Return the larger of two Nats.
pub let max: { l: Nat, r: Nat } -> Nat = { l, r } -> __native_nat_max { l = l, r = r }

## True if n is zero.
pub let is_zero: { n: Nat } -> Bool = { n } -> n == 0n

## True if n is even.
pub let is_even: { n: Nat } -> Bool = { n } -> (n % 2n) == 0n

## True if n is odd.
pub let is_odd: { n: Nat } -> Bool = { n } -> if is_even { n = n } then False else True

## Convert a Nat to an Int (always succeeds).
pub let to_int: { n: Nat } -> Int = { n } -> __native_nat_to_int { n = n }

## Convert a Nat to a string.
pub let to_str: { n: Nat } -> Str = { n } -> __native_nat_to_str { n = n }

## Clamp n to the range [min, max].
pub let clamp: { n: Nat, min: Nat, max: Nat } -> Nat = { n, min, max } ->
  __native_nat_clamp { n = n, min = min, max = max }

impl Nat where {
  to_int = { it } -> __native_nat_to_int { n = it },
  to_str = { it } -> __native_nat_to_str { n = it },
  clamp = { it, min, max } -> __native_nat_clamp { n = it, min = min, max = max },
  min = { it, r } -> __native_nat_min { l = it, r = r },
  max = { it, r } -> __native_nat_max { l = it, r = r },
  is_zero = { it } -> it == 0n,
  is_even = { it } -> __native_nat_to_int { n = it } % 2 == 0,
  is_odd = { it } -> __native_nat_to_int { n = it } % 2 != 0,
  subtract_to_int = { it, r } -> __native_nat_subtract_to_int { l = it, r = r },
}
