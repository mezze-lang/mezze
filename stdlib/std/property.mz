## Property checks over generated inputs, with shrinking.
##
##     use std::property::{ check }
##     use std::abilities::arbitrary::{ Arbitrary }
##
##     check { gen = { } -> Arbitrary.arbitrary {}, holds = { x } -> x * 2 >= x, runs = 100, seed = 7 }
##
## On the first input that fails, the input is SHRUNK to a simpler one that still
## fails, so the report is a small counterexample rather than whatever a random
## draw happened to produce.
##
## ## How shrinking works, and why it needs nothing per type
##
## Every generated value bottoms out in `Sample.choose`, and 0 is always the
## simplest draw — the premise of the `Sample` effect. So a run IS its sequence of
## draws, and a simpler input is a simpler sequence replayed: a shorter one, or one
## with a draw zeroed, halved or decremented. Any change that still fails is kept.
## That works for any type `Arbitrary` can generate, with no shrinker written for it.
##
## A replayed draw is clamped below its bound and is 0 past the end of the
## sequence, and what was ANSWERED is what is kept — so a sequence is always
## canonical, and each kept step is strictly simpler (shorter, or smaller in
## order). Shrinking cannot cycle, and stops after a fixed number of steps anyway.

use std::int
use std::nat::{ Nat }
use std::nat
use std::effects::sample::{ Sample, Sampler, default_size }

## What a check found.
pub type Verdict 'a = | Passed { runs: Int }, Failed { input: 'a, original: 'a, shrinks: Int } |

## The most simplifications a failure is given.
pub let max_shrinks = 500

## The size budget of a check's LAST run. Runs grow from 0 to this, as in
## QuickCheck: early inputs are small and readable, and the later ones reach every
## type's extremes — `int_max`, the hostile strings — which `Arbitrary` keeps for
## sizes from `stress_size` up. Twice the stress size twice over, because a
## container draws its elements at half its own size: an `Int` inside a list
## reaches its extremes from run size 100, an `Int` inside a list of lists from 200. So a check still hunts overflows, just not on
## every other run, and a sample (which stays at the default size) reads normally.
pub let max_check_size: Int = 200

## The size of run `i` of `runs`: evenly from 0 to [max_check_size].
let size_of_run: { i: Int, runs: Int } -> Nat = { i, runs } ->
  match nat::from_int { n = (i * max_check_size) / int::max { l = runs - 1, r = 1 } } is
    Some { val } -> val
    None -> default_size

## Draw from the seeded stream, recording each draw under `key`.
impl Sample for Recording { seed: Int, key: Int, size: Nat } where {
  initialize_scope = {} -> do
    __native_reset_seeded_random { seed = seed }
    __native_draw_log_reset { key = key }
    {},
  finalize_scope = {} -> {},
  choose = { bound } ->
    if bound <= 1 then __native_draw_log_append { key = key, value = 0 }
    else __native_draw_log_append { key = key, value = __native_seeded_random_int { seed = seed, min = 0, max = bound - 1 } },
  size = {} -> size,
  resize = { n, call } -> perform RecordingAt { seed = seed, key = key, size = n } in call {},
}

## [Recording] continued inside a resized draw: the same run, so no reset.
impl Sample for RecordingAt { seed: Int, key: Int, size: Nat } where {
  choose = { bound } ->
    if bound <= 1 then __native_draw_log_append { key = key, value = 0 }
    else __native_draw_log_append { key = key, value = __native_seeded_random_int { seed = seed, min = 0, max = bound - 1 } },
  size = {} -> size,
  resize = { n, call } -> perform RecordingAt { seed = seed, key = key, size = n } in call {},
}

## Answer each draw from `draws`, in order — recording what was answered.
impl Sample for Replay { draws: [Int], key: Int, size: Nat } where {
  initialize_scope = {} -> do
    __native_draw_log_reset { key = key }
    {},
  finalize_scope = {} -> {},
  choose = { bound } -> __native_draw_log_replay { draws = draws, key = key, bound = bound },
  size = {} -> size,
  resize = { n, call } -> perform ReplayAt { draws = draws, key = key, size = n } in call {},
}

## [Replay] continued inside a resized draw: the same run, so no reset.
impl Sample for ReplayAt { draws: [Int], key: Int, size: Nat } where {
  choose = { bound } -> __native_draw_log_replay { draws = draws, key = key, bound = bound },
  size = {} -> size,
  resize = { n, call } -> perform ReplayAt { draws = draws, key = key, size = n } in call {},
}

## Check that `holds` is true of `runs` inputs drawn by `gen`, the i-th from
## `seed + i`. On the first that fails, shrink it.
pub let check: { gen: Sampler 'a, holds: { x: 'a } -> Bool, runs: Int, seed: Int } -> Verdict 'a <*> =
  { gen, holds, runs, seed } -> run_from { gen = gen, holds = holds, runs = runs, seed = seed, i = 0 }

## [check], but first on each of `first`, in order: the values already known to
## matter — one per branch of the code under test, say, as `mez sample` pins its
## leading rows. A failure among them is reported as given, unshrunk: it was
## chosen, not drawn, so there are no draws to simplify. A pass counts them.
pub let check_from: { first: ['a], gen: Sampler 'a, holds: { x: 'a } -> Bool, runs: Int, seed: Int } -> Verdict 'a <*> =
  { first, gen, holds, runs, seed } -> first_then_draw { first = first, gen = gen, holds = holds, runs = runs, seed = seed, i = 0 }

let first_then_draw: { first: ['a], gen: Sampler 'a, holds: { x: 'a } -> Bool, runs: Int, seed: Int, i: Int } -> Verdict 'a <*> =
  { first, gen, holds, runs, seed, i } ->
    match __native_seq_get { xs = first, i = i } is
      Some { val } ->
        if holds { x = val } then first_then_draw { first = first, gen = gen, holds = holds, runs = runs, seed = seed, i = i + 1 }
        else Failed { input = val, original = val, shrinks = 0 }
      None -> match check { gen = gen, holds = holds, runs = runs, seed = seed } is
        Passed { runs = drawn } -> Passed { runs = drawn + i }
        Failed { input, original, shrinks } -> Failed { input = input, original = original, shrinks = shrinks }

let run_from: { gen: Sampler 'a, holds: { x: 'a } -> Bool, runs: Int, seed: Int, i: Int } -> Verdict 'a <*> =
  { gen, holds, runs, seed, i } ->
    if i >= runs then Passed { runs = runs }
    else do
      let size = size_of_run { i = i, runs = runs }
      let x = perform Recording { seed = seed + i, key = 0, size = size } in gen {}
      if holds { x = x } then run_from { gen = gen, holds = holds, runs = runs, seed = seed, i = i + 1 }
      ## Shrinking replays at the SAME size: the size shapes how draws are read
      ## (a length's range, a magnitude's width), so the draws only mean the
      ## failing input under the size they were made at.
      else shrink { gen = gen, holds = holds, size = size, draws = __native_draw_log { key = 0 }, best = x, original = x, steps = 0 }

## Keep taking the first simpler sequence that still fails, until none does.
let shrink: { gen: Sampler 'a, holds: { x: 'a } -> Bool, size: Nat, draws: [Int], best: 'a, original: 'a, steps: Int } -> Verdict 'a <*> =
  { gen, holds, size, draws, best, original, steps } ->
    if steps >= max_shrinks then Failed { input = best, original = original, shrinks = steps }
    else match simpler_failure { gen = gen, holds = holds, size = size, current = draws, candidates = __native_shrink_candidates { draws = draws }, i = 0 } is
      Some { val } -> shrink { gen = gen, holds = holds, size = size, draws = val.draws, best = val.x, original = original, steps = steps + 1 }
      None -> Failed { input = best, original = original, shrinks = steps }

## The first candidate whose replay still fails AND is strictly simpler than
## `current` — the second condition is what makes shrinking terminate.
let simpler_failure: { gen: Sampler 'a, holds: { x: 'a } -> Bool, size: Nat, current: [Int], candidates: [[Int]], i: Int } -> Option { draws: [Int], x: 'a } <*> =
  { gen, holds, size, current, candidates, i } ->
    match __native_seq_get { xs = candidates, i = i } is
      None -> None
      Some { val = draws } -> do
        let x = perform Replay { draws = draws, key = 1, size = size } in gen {}
        let answered = __native_draw_log { key = 1 }
        let next = { } -> simpler_failure { gen = gen, holds = holds, size = size, current = current, candidates = candidates, i = i + 1 }
        if holds { x = x } then next {}
        else if __native_draws_simpler { a = answered, b = current } then Some { val = { draws = answered, x = x } }
        else next {}
