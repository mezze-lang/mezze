# Compile-time evaluation.

use std::abilities::embed::{ Embeddable }

# `eval {}` in the impl body is a run-time fallback with the same meaning, used if reduction is disabled.
## Evaluate `eval` at compile time and replace this call site with the result.
## The result must be `Embeddable`; the thunk must be closed, handle all its own effects, and be called directly.
## Runs during `mez build`/`dev`/`exec`, never `mez check`: a crashing comptime passes `check`, fails `build`.
effect Comptime where {
  comptime: { eval: {} -> 'a <*> } with Embeddable 'a -> 'a <Comptime>,
  # `run` reaches the compiler through natives that answer only while compiling.
  ## Ask the compiler about the codebase being compiled; fails at run time.
  ## Called by `std::codebase`'s handlers, not directly.
  codebase: { run: {} -> 'a } -> 'a <Comptime>
}

# The body is the run-time fallback for sites the reduction pass left alone.
# A bare value is an implicit resume, measured ~14 ns/op vs ~34 ns for explicit
# `cont.resume` (which hits a @TruffleBoundary ThreadLocal lookup).
## Handler for `Comptime`; must be installed at `main` to allow build-time code to run.
impl Comptime for ComptimeEval where {
  comptime = { eval } -> __native_comptime_eval { eval = eval },
  codebase = { run } -> run {}
}

## Fail the build with `msg`, reported at the `comptime` call site.
## Outside a comptime block it is an ordinary function that raises.
pub let compile_error: { msg: Str } -> 'a = { msg } ->
  __native_comptime_compile_error { msg = msg }
