use std::abilities::numeric::{NumAdd, NumSub, NumMul, NumDiv, NumMod}
use std::abilities::compare::{Eq, Ord}
use std::abilities::convert::{Into, TryInto}

impl NumAdd for Int where { add = {r} -> __native_int_add {l = it, r = r} }
impl NumSub for Int where { sub = {r} -> __native_int_subtract {l = it, r = r}, neg = {} -> __native_int_neg {n = it} }
impl NumMul for Int where { mul = {r} -> __native_int_multiply {l = it, r = r} }
impl NumDiv for Int where { div = {r} -> __native_int_divide {l = it, r = r} }
impl NumMod for Int where { mod = {r} -> __native_int_modulo {l = it, r = r} }
impl Eq for Int where { eq = {r} -> __native_int_eq {l = it, r = r}, neq = {r} -> __native_int_neq {l = it, r = r} }
impl Ord for Int where { lt = {r} -> __native_int_lt {l = it, r = r}, le = {r} -> __native_int_le {l = it, r = r}, gt = {r} -> __native_int_gt {l = it, r = r}, ge = {r} -> __native_int_ge {l = it, r = r} }
impl Into Str for Int where { into = {} -> __native_int_to_str {n = it} }
impl Into Float for Int where { into = {} -> __native_int_to_float {n = it} }
impl Into Frac for Int where { into = {} -> __native_int_to_frac {n = it} }
impl TryInto Nat |ConversionError {msg: Str}| for Int where {
    try_into = {} -> match __native_int_to_nat {n = it} is
        Some {val} -> Ok {val = val}
        None -> Err {error = ConversionError {msg = "negative integer cannot convert to Nat"}}
}
impl TryInto Int |ConversionError {msg: Str}| for Str where {
    try_into = {} -> match __native_int_from_string {s = it} is
        Some {val} -> Ok {val = val}
        None -> Err {error = ConversionError {msg = "invalid integer"}}
}

# Integer utility functions
# This module provides utility functions for working with integers
# Note: The Int type and basic operations are now built-in
# Built-in ability implementations (NumAdd, NumSub, NumMul, NumDiv, Eq, Inspect) are automatically available

# Basic arithmetic operations (for qualified calls)
pub let add = { l: Int, r: Int } ->
    __native_int_add { l = l, r = r }

pub let subtract = { l: Int, r: Int } ->
    __native_int_subtract { l = l, r = r }

pub let multiply = { l: Int, r: Int } ->
    __native_int_multiply { l = l, r = r }

pub let divide = { l: Int, r: Int } ->
    __native_int_divide { l = l, r = r }

pub let modulo = { l: Int, r: Int } ->
    __native_int_modulo { l = l, r = r }

pub let to_str = { n: Int } ->
    __native_int_to_str { n = n }

pub let from_string = { s: Str } ->
    __native_int_from_string { s = s }

pub let from_nat = { n: Nat } ->
    __native_int_from_nat { n = n }

# Utility functions for integers
pub let abs = { n: Int } ->
    __native_int_abs { n = n }

pub let max = { l: Int, r: Int } ->
    __native_int_max { l = l, r = r }

pub let min = { l: Int, r: Int } ->
    __native_int_min { l = l, r = r }

pub let sign = { n: Int } ->
    if n > 0 then 1
    else if n < 0 then -1
    else 0

pub let is_even = { n: Int } ->
    (n % 2) == 0

pub let is_odd = { n: Int } ->
    (n % 2) != 0

pub let pow = { base: Int, exp: Int } ->
    if exp == 0 then 1
    else if exp == 1 then base
    else if is_even { n = exp }
        then pow { base = base, exp = exp / 2 } * pow { base = base, exp = exp / 2 }
        else base * pow { base = base, exp = exp - 1 }

pub let gcd = { l: Int, r: Int } ->
    if r == 0 then abs { n = l }
    else gcd { l = r, r = l % r }

pub let lcm = { l: Int, r: Int } ->
    abs { n = (l * r) / gcd { l = l, r = r } }

# Clamp value to range [min, max]
# Example: clamp {n = 15, min = 0, max = 10} -> 10
pub let clamp = { n: Int, min: Int, max: Int } ->
    __native_int_clamp { n = n, min = min, max = max }

# Convert Int to Nat, returns None if negative
# Example: to_nat {n = 5} -> Some {val = 5n}
# Example: to_nat {n = -1} -> None
pub let to_nat = { n: Int } ->
    __native_int_to_nat { n = n }

impl Int where {
    to_float = {} -> __native_int_to_float {n = it},
    to_str = {} -> __native_int_to_str {n = it},
    abs = {} -> __native_int_abs {n = it},
    sign = {} -> __native_int_sign {n = it},
    is_even = {} -> __native_int_is_even {n = it},
    is_odd = {} -> __native_int_is_odd {n = it},
    clamp = {min, max} -> __native_int_clamp {n = it, min = min, max = max},
    pow = {exp} -> __native_int_pow {base = it, exp = exp},
    min = {r} -> __native_int_min {l = it, r = r},
    max = {r} -> __native_int_max {l = it, r = r},
    to_nat = {} -> __native_int_to_nat {n = it},
    gcd = {r} -> __native_int_gcd {l = it, r = r},
    lcm = {r} -> __native_int_lcm {l = it, r = r}
}