use std::abilities::numeric::{ NumAdd, NumSub, NumMul, NumDiv, NumMod, NumZero, NumOne }
use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::convert::{ Into, TryInto }
use std::abilities::default::{ Default }
use std::float

impl NumAdd Int for Int having 'out = Int where {
  add = { it, r } -> __native_int_add { l = it, r = r }
}

impl NumAdd Float for Int having 'out = Float where {
  add = { it, r } -> it.to_float {} + r
}

impl NumAdd Nat for Int having 'out = Int where {
  add = { it, r } -> it + from_nat { n = r }
}

impl NumSub Int for Int having 'out = Int where {
  sub = { it, r } -> __native_int_subtract { l = it, r = r }
}

impl NumSub Float for Int having 'out = Float where {
  sub = { it, r } -> it.to_float {} - r
}

impl NumSub Nat for Int having 'out = Int where {
  sub = { it, r } -> it - from_nat { n = r }
}

impl NumMul Int for Int having 'out = Int where {
  mul = { it, r } -> __native_int_multiply { l = it, r = r }
}

impl NumMul Float for Int having 'out = Float where {
  mul = { it, r } -> it.to_float {} * r
}

impl NumMul Nat for Int having 'out = Int where {
  mul = { it, r } -> it * from_nat { n = r }
}

impl NumDiv Int for Int having 'out = Int where {
  div = { it, r } -> __native_int_divide { l = it, r = r }
}

impl NumDiv Float for Int having 'out = Float where {
  div = { it, r } -> it.to_float {} / r
}

impl NumDiv Nat for Int having 'out = Int where {
  div = { it, r } -> it / from_nat { n = r }
}

impl NumMod Int for Int having 'out = Int where {
  mod = { it, r } -> __native_int_modulo { l = it, r = r }
}

impl NumMod Float for Int having 'out = Float where {
  mod = { it, r } -> it.to_float {} % r
}

impl NumMod Nat for Int having 'out = Int where {
  mod = { it, r } -> it % from_nat { n = r }
}

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.


impl Ord for Int where {
  lt = { it, r } -> __native_int_lt { l = it, r = r },
  le = { it, r } -> __native_int_le { l = it, r = r },
  gt = { it, r } -> __native_int_gt { l = it, r = r },
  ge = { it, r } -> __native_int_ge { l = it, r = r },
}

impl Into Str for Int where {
  into = { it } -> __native_int_to_str { n = it }
}

impl Into Float for Int where {
  into = { it } -> __native_int_to_float { n = it }
}

impl Into Frac for Int where {
  into = { it } -> __native_int_to_frac { n = it }
}

impl TryInto Nat | ConversionError { msg: Str } | for Int where {
  try_into = { it } -> match __native_int_to_nat { n = it } is
    Some { val } -> Ok { val = val }
    None -> Err {
      error = ConversionError { msg = "negative integer cannot convert to Nat" },
    }

}

impl TryInto Int | ConversionError { msg: Str } | for Str where {
  try_into = { it } -> match __native_int_from_string { s = it } is
    Some { val } -> Ok { val = val }
    None -> Err { error = ConversionError { msg = "invalid integer" } }

}

impl NumZero for Int where {
  zero = {} -> 0,
  is_zero = { it } -> it == 0,
}

impl NumOne for Int where {
  one = {} -> 1
}

impl Default for Int where {
  default = {} -> 0
}

## Add two integers.
pub let add: { l: Int, r: Int } -> Int = { l, r } -> __native_int_add { l = l, r = r }

## Subtract r from l.
pub let subtract: { l: Int, r: Int } -> Int = { l, r } -> __native_int_subtract { l = l, r = r }

## Multiply two integers.
pub let multiply: { l: Int, r: Int } -> Int = { l, r } -> __native_int_multiply { l = l, r = r }

## Integer division (truncates toward zero).
pub let divide: { l: Int, r: Int } -> Int = { l, r } -> __native_int_divide { l = l, r = r }

## Remainder after integer division.
pub let modulo: { l: Int, r: Int } -> Int = { l, r } -> __native_int_modulo { l = l, r = r }

## Convert an integer to a string.
pub let to_str: { n: Int } -> Str = { n } -> __native_int_to_str { n = n }

## Parse a string as an integer. Returns None on failure.
pub let from_str: { s: Str } -> Option Int = { s } -> __native_int_from_string { s = s }

## Convert a Nat to an Int.
pub let from_nat: { n: Nat } -> Int = { n } -> __native_int_from_nat { n = n }

## Absolute value.
pub let abs: { n: Int } -> Int = { n } -> __native_int_abs { n = n }

## Return the larger of two integers.
pub let max: { l: Int, r: Int } -> Int = { l, r } -> __native_int_max { l = l, r = r }

## Return the smaller of two integers.
pub let min: { l: Int, r: Int } -> Int = { l, r } -> __native_int_min { l = l, r = r }

## Sign of n: returns -1, 0, or 1.
pub let sign: { n: Int } -> Int = { n } -> if n > 0 then 1 else if n < 0 then -1 else 0

## True if n is even.
pub let is_even: { n: Int } -> Bool = { n } -> (n % 2) == 0

## True if n is odd.
pub let is_odd: { n: Int } -> Bool = { n } -> (n % 2) != 0

## Raise base to the power exp.
pub let pow: { base: Int, exp: Int } -> Int = { base, exp } -> if exp == 0 then 1 else if exp == 1 then base else if is_even { n = exp } then pow { base = base, exp = exp / 2 } * pow { base = base, exp = exp / 2 } else base * pow { base = base, exp = exp - 1 }

## Greatest common divisor.
pub let gcd: { l: Int, r: Int } -> Int = { l, r } -> if r == 0 then abs { n = l } else gcd { l = r, r = l % r }

## Least common multiple.
pub let lcm: { l: Int, r: Int } -> Int = { l, r } -> abs { n = (l * r) / gcd { l = l, r = r } }

## Clamp n to the range [min, max].
pub let clamp: { n: Int, min: Int, max: Int } -> Int = { n, min, max } ->
  __native_int_clamp { n = n, min = min, max = max }

## Convert to Nat. Returns None if negative.
pub let to_nat: { n: Int } -> Option Nat = { n } -> __native_int_to_nat { n = n }

impl Int where {
  neg: { it: Int } -> Int = { it } -> __native_int_neg { n = it },
  to_float: { it: Int } -> Float = { it } -> __native_int_to_float { n = it },
  to_str = { it } -> __native_int_to_str { n = it },
  abs = { it } -> __native_int_abs { n = it },
  sign = { it } -> __native_int_sign { n = it },
  is_even = { it } -> __native_int_is_even { n = it },
  is_odd = { it } -> __native_int_is_odd { n = it },
  clamp = { it, min, max } -> __native_int_clamp { n = it, min = min, max = max },
  pow = { it, exp } -> __native_int_pow { base = it, exp = exp },
  min = { it, r } -> __native_int_min { l = it, r = r },
  max = { it, r } -> __native_int_max { l = it, r = r },
  to_nat = { it } -> __native_int_to_nat { n = it },
  gcd = { it, r } -> __native_int_gcd { l = it, r = r },
  lcm = { it, r } -> __native_int_lcm { l = it, r = r },
}
