# Integer utility functions
# This module provides utility functions for working with integers
# Note: The Int type and basic operations are now built-in
# Built-in ability implementations (NumAdd, NumSub, NumMul, NumDiv, Eq, Inspect) are automatically available

# Basic arithmetic operations (for qualified calls)
pub let add = { l: Int, r: Int } ->
    __native_int_add { l = l, r = r }

pub let subtract = { l: Int, r: Int } ->
    __native_int_subtract { l = l, r = r }

pub let multiply = { l: Int, r: Int } ->
    __native_int_multiply { l = l, r = r }

pub let divide = { l: Int, r: Int } ->
    __native_int_divide { l = l, r = r }

pub let modulo = { l: Int, r: Int } ->
    __native_int_modulo { l = l, r = r }

pub let to_string = { n: Int } ->
    __native_int_to_string { n = n }

pub let from_string = { s: String } ->
    __native_int_from_string { s = s }

pub let from_nat = { n: Nat } ->
    __native_int_from_nat { n = n }

# Utility functions for integers
pub let abs = { n: Int } ->
    __native_int_abs { n = n }

pub let max = { l: Int, r: Int } ->
    __native_int_max { l = l, r = r }

pub let min = { l: Int, r: Int } ->
    __native_int_min { l = l, r = r }

pub let sign = { n: Int } ->
    if n > 0 then 1
    else if n < 0 then -1
    else 0

pub let is_even = { n: Int } ->
    (n % 2) == 0

pub let is_odd = { n: Int } ->
    (n % 2) != 0

pub let pow = { base: Int, exp: Int } ->
    if exp == 0 then 1
    else if exp == 1 then base
    else if is_even { n = exp }
        then pow { base = base, exp = exp / 2 } * pow { base = base, exp = exp / 2 }
        else base * pow { base = base, exp = exp - 1 }

pub let gcd = { l: Int, r: Int } ->
    if r == 0 then abs { n = l }
    else gcd { l = r, r = l % r }

pub let lcm = { l: Int, r: Int } ->
    abs { n = (l * r) / gcd { l = l, r = r } }