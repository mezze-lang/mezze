## WebAssembly codec — encode Mezze numeric scalars as `WasmForeign`
## and decode them back.
##
## Wasm's value boundary is deliberately narrow: only i32, i64, f32, f64
## cross. There are no native strings, bools, records, lists, options,
## variants, or maps in the wasm value model — those things live in
## linear memory and are addressed by integer offsets that the caller
## marshals through `WasmForeign.memory_read{}` / `.memory_write{}`.
##
## So this codec only wires up `Format` + `EncodeScalar` + `DecodeScalar`
## for the numeric primitives (Int, Float, Frac, Nat). Every other shape
## (Str, Bool, Record, List, Option, Variant, Map) is deliberately absent
## — a program that reaches for `to_wasm` on a `Str` gets a Tier-3
## auto-derivation error at the offending field, per
## `docs/codec/redesign-2026-09.md`.
use std::codec::core::{
  Format,
  EncodeScalar,
  DecodeScalar,
  Encode, Decode,
  CodecCtx, SharedConfig, DecodeError,
  default_shared,
  decode_error
}
use std::polyglot::wasm::{ WasmForeign, from_int, from_float }
use std::char
use std::float
use std::int
use std::nat

## Config for the wasm codec. Empty knobs — every wasm scalar has
## exactly one natural representation. Kept as a record for future
## extension (i32-vs-i64 preferences, f32-vs-f64 preferences).
pub type WasmC = {
  shared: SharedConfig,
}

## Default wasm codec — identity field-name transform (moot for a
## scalar-only codec, but keeps the shape uniform with `JsC` / `PyC`).
pub let wasm_default: WasmC = { shared = default_shared }

## ---- Format link -------------------------------------------------------

impl Format for WasmC having 'out = WasmForeign where {
}

## ---- Tier 2: encode ----------------------------------------------------

## Numeric scalars encode natively. `Bool` folds to i32 0/1 — the
## conventional wasm ABI encoding. `Char` folds to its i32 code point.
## `Str` and `Bytes` have no first-class wasm representation, so their
## encoders produce a placeholder i32 0 — the caller who tries to
## round-trip a string / byte buffer through the wasm value boundary
## should marshal it through linear memory instead (see
## `WasmForeign.memory_write{}`), and the decoders reject those
## shapes with a `DecodeError` explaining the marshalling requirement.
impl EncodeScalar for WasmC having 'out = WasmForeign where {
  encode_int   = { it, val, ctx } -> from_int   { val = val },
  encode_float = { it, val, ctx } -> from_float { val = val },
  encode_str   = { it, val, ctx } -> from_int   { val = 0 },
  encode_bool  = { it, val, ctx } -> from_int   { val = if val then 1 else 0 },
  encode_frac  = { it, val, ctx } -> from_float { val = __native_frac_to_float { n = val } },
  encode_bytes = { it, val, ctx } -> from_int   { val = 0 },
  encode_char  = { it, val, ctx } -> from_int   { val = char::to_int { c = val } },
  encode_nat   = { it, val, ctx } -> from_int   { val = nat::to_int { n = val } },
}

## ---- Tier 2: decode ----------------------------------------------------

impl DecodeScalar for WasmC having 'in = WasmForeign where {
  decode_int = { it, val, ctx } -> match val.as_int{} is
    Ok { val = n } -> Ok { val = n }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Int",
      expected = "Int",
      found = Some { val = val.type_name{} },
    },
  decode_float = { it, val, ctx } -> match val.as_float{} is
    Ok { val = n } -> Ok { val = n }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Float",
      expected = "Float",
      found = Some { val = val.type_name{} },
    },
  decode_str = { it, val, ctx } -> decode_error {
    path = ctx.path,
    message = "Str is not representable at the wasm value boundary — marshal via linear memory (WasmForeign.memory_read{})",
    expected = "Str",
    found = Some { val = val.type_name{} },
  },
  decode_bool = { it, val, ctx } -> match val.as_int{} is
    Ok { val = n } -> Ok { val = if n == 0 then False else True }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to i32 0/1",
      expected = "Bool",
      found = Some { val = val.type_name{} },
    },
  decode_frac = { it, val, ctx } -> match val.as_float{} is
    Ok { val = f } -> Ok { val = __native_float_to_frac { f = f } }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Frac",
      expected = "Frac",
      found = Some { val = val.type_name{} },
    },
  decode_bytes = { it, val, ctx } -> decode_error {
    path = ctx.path,
    message = "Bytes is not representable at the wasm value boundary — marshal via linear memory (WasmForeign.memory_read{})",
    expected = "Bytes",
    found = Some { val = val.type_name{} },
  },
  decode_char = { it, val, ctx } -> match val.as_int{} is
    Ok { val = n } -> match char::from_int { code = n } is
      Some { val = c } -> Ok { val = c }
      None -> decode_error {
        path = ctx.path,
        message = "Expected valid Unicode code point",
        expected = "Char",
        found = Some { val = "out-of-range integer" },
      }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to i32 code point",
      expected = "Char",
      found = Some { val = val.type_name{} },
    },
  decode_nat = { it, val, ctx } -> match val.as_int{} is
    Ok { val = n } -> match nat::from_int { n = n } is
      Some { val = k } -> Ok { val = k }
      None -> decode_error {
        path = ctx.path,
        message = "Expected non-negative integer",
        expected = "Nat",
        found = Some { val = "negative integer" },
      }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Nat",
      expected = "Nat",
      found = Some { val = val.type_name{} },
    },
}

## ---- Tier 4: sugar abilities + blankets --------------------------------

## Encode any scalar-shaped value to a `WasmForeign` via `.to_wasm{}`.
## Types containing Str / Bool / Records / Lists / Options / Variants
## fail Tier-3 auto-derivation at the offending field.
ability ToWasm for 'a where {
  to_wasm:      { it: 'a }                -> WasmForeign,
  to_wasm_with: { it: 'a, config: WasmC } -> WasmForeign,
}

impl ToWasm for 'a where {
  to_wasm:      { it: 'a }                with Encode WasmC 'a -> WasmForeign = { it }         -> it.encode { config = wasm_default },
  to_wasm_with: { it: 'a, config: WasmC } with Encode WasmC 'a -> WasmForeign = { it, config } -> it.encode { config = config },
}

## Decode a target scalar type from a `WasmForeign` via `Type.from_wasm{}`.
ability FromWasm 'a for 'in where {
  from_wasm:      { it: 'in }                -> Result 'a DecodeError,
  from_wasm_with: { it: 'in, config: WasmC } -> Result 'a DecodeError,
}

impl FromWasm 'a for WasmForeign where {
  from_wasm:      { it: WasmForeign }                with Decode WasmC 'a -> Result 'a DecodeError = { it }         -> it.decode { config = wasm_default },
  from_wasm_with: { it: WasmForeign, config: WasmC } with Decode WasmC 'a -> Result 'a DecodeError = { it, config } -> it.decode { config = config },
}
