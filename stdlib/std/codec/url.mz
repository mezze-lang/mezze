## URL codec — query-parameter encoding to `Str`.
##
## `UrlC` is a partial-capability format: only scalars and no-payload
## variants render as a single URL query value. Records, lists, maps,
## and payloaded variants aren't representable — the format author omits
## the corresponding Tier-2 impls, and any containing type gets a compile
## error at the offending field path (see `docs/codec/redesign-2026-09.md`
## §"Partial-capability formats").
##
## The `Url` type + `parse` / `render` sit above the ability layer — they
## are format-neutral native primitives, unchanged by the codec redesign.
use std::codec::core::{
  Format,
  EncodeScalar, EncodeVariant, EncodeOption,
  DecodeScalar, DecodeVariant, DecodeOption,
  Encode, Decode,
  CodecCtx, SharedConfig, FieldTransform, DecodeError,
  default_shared
}
use std::int
use std::float
use std::nat
use std::char
use std::str

## ---- Structured URL (native-backed) ------------------------------------

## Structured URL. Produced by `parse`, consumed by `render`. Absent
## components (no scheme, no userinfo, no port, etc.) are `None`. `path`
## is `""` when the URI has no path component (RFC 3986 §3.3 allows this).
##
## The record shape is fixed by `interpreter/.../io/UrlNatives.java` and
## must not drift from it.
pub type Url = {
  scheme: Option Str,
  user_info: Option Str,
  host: Option Str,
  port: Option Int,
  path: Str,
  query: Option Str,
  fragment: Option Str,
}

## Percent-encode a single URL component (path segment or query value).
## Matches JS `encodeURIComponent` / RFC 3986 unreserved set.
pub let url_encode_component: { s: Str } -> Str = { s } ->
  __native_url_encode_component { s = s }

## Inverse of `url_encode_component`. Decodes %xx sequences and `+`
## (form-encoded space) back to their UTF-8 source.
pub let url_decode_component: { s: Str } -> Str = { s } ->
  __native_url_decode_component { s = s }

## Parse a URL string into a `Url` record. Backed by `java.net.URI` which
## follows RFC 2396 with the RFC 3986 clarifications the JDK adds.
pub let parse
  : { s: Str }
  -> Result Url { path: [Str], reason: Str, input_ref: Option Str }
  = { s } -> __native_url_parse { s = s }

## Render a `Url` record back to a string. Inverse of `parse` for
## well-formed inputs — normalises escaping / case but preserves scheme,
## host, port, path, query, and fragment identity.
pub let render: { url: Url } -> Str = { url } -> __native_url_render { url = url }

## ---- Config type -------------------------------------------------------

## URL query-parameter config. The output type is `Str` — a single URL
## parameter value. Values are NOT percent-encoded here; encoding happens
## at the consumer (e.g. `with_query` in http.mz) so the same value can
## also be embedded in path segments or other contexts that handle escaping
## differently.
pub type UrlC = {
  shared: SharedConfig,
}

pub let url_default: UrlC = {
  shared = { field_transform = Identity },
}

## ---- Format link -------------------------------------------------------

impl Format for UrlC having 'out = Str where {
}

## ---- Tier 2: encode ----------------------------------------------------

impl EncodeScalar for UrlC having 'out = Str where {
  encode_int   = { it, val, ctx } -> int::to_str { n = val },
  encode_float = { it, val, ctx } -> float::to_str { n = val },
  encode_str   = { it, val, ctx } -> val,
  encode_bool  = { it, val, ctx } -> if val then "true" else "false",
  encode_frac  = { it, val, ctx } -> float::to_str { n = __native_frac_to_float { n = val } },
  encode_bytes = { it, val, ctx } -> "",
  encode_char  = { it, val, ctx } -> char::to_str { c = val },
  encode_nat   = { it, val, ctx } -> nat::to_str { n = val },
}

impl EncodeVariant for UrlC having 'out = Str where {
  encode_variant = { it, tag, payload, ctx } -> match payload is
    None -> tag
    Some { val = _ } -> tag,
}

impl EncodeOption for UrlC having 'out = Str where {
  encode_option = { it, val, ctx } -> match val is
    Some { val = v } -> v
    None -> "",
}

## No `EncodeRecord`, `EncodeSequence`, `EncodeMapping` for `UrlC` — a single URL
## parameter value can't carry structure. Types containing those shapes
## will fail auto-derivation at the offending field path.

## ---- Tier 2: decode ----------------------------------------------------

impl DecodeScalar for UrlC having 'in = Str where {
  decode_int = { it, val, ctx } -> match int::from_str { s = val } is
    Some { val = n } -> Ok { val = n }
    None -> Err { error = {
      path = ctx.path,
      message = "Expected integer",
      expected = "Int",
      found = Some { val = val },
    } },
  decode_float = { it, val, ctx } -> match float::from_str { s = val } is
    Some { val = f } -> Ok { val = f }
    None -> Err { error = {
      path = ctx.path,
      message = "Expected float",
      expected = "Float",
      found = Some { val = val },
    } },
  decode_str = { it, val, ctx } -> Ok { val = val },
  decode_bool = { it, val, ctx } -> match val is
    "true" -> Ok { val = True }
    "false" -> Ok { val = False }
    "1" -> Ok { val = True }
    "0" -> Ok { val = False }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected boolean",
      expected = "Bool",
      found = Some { val = val },
    } },
  decode_frac = { it, val, ctx } -> match float::from_str { s = val } is
    Some { val = f } -> Ok { val = __native_float_to_frac { f = f } }
    None -> Err { error = {
      path = ctx.path,
      message = "Expected fraction (number)",
      expected = "Frac",
      found = Some { val = val },
    } },
  decode_bytes = { it, val, ctx } -> Err { error = {
    path = ctx.path,
    message = "Bytes can't be decoded from a URL parameter value",
    expected = "Bytes",
    found = Some { val = val },
  } },
  decode_char = { it, val, ctx } -> match char::from_str { s = val } is
    Some { val = c } -> Ok { val = c }
    None -> Err { error = {
      path = ctx.path,
      message = "Expected single character",
      expected = "Char",
      found = Some { val = val },
    } },
  decode_nat = { it, val, ctx } -> match nat::from_str { s = val } is
    Some { val = n } -> Ok { val = n }
    None -> Err { error = {
      path = ctx.path,
      message = "Expected non-negative integer",
      expected = "Nat",
      found = Some { val = val },
    } },
}

impl DecodeVariant for UrlC having 'in = Str where {
  decode_variant = { it, val, ctx } -> Ok { val = { tag = val, payload = None } },
}

impl DecodeOption for UrlC having 'in = Str where {
  decode_option = { it, val, ctx } ->
    if str::is_empty { s = val } then Ok { val = None }
    else Ok { val = Some { val = val } },
}

## ---- Tier 4: sugar abilities + blankets --------------------------------

## Encode any scalar-shaped value to a URL query-parameter string.
ability ToUrl for 'a where {
  url:      { it: 'a }               -> Str,
  url_with: { it: 'a, config: UrlC } -> Str,
}

impl ToUrl for 'a where {
  url:      { it: 'a }               with Encode UrlC 'a -> Str = { it }         -> it.encode { config = url_default },
  url_with: { it: 'a, config: UrlC } with Encode UrlC 'a -> Str = { it, config } -> it.encode { config = config },
}

## Decode a value from a URL query-parameter string via inherent method
## syntax (`Type.from_url { it = raw }`).
ability FromUrl 'a for 'in where {
  from_url:      { it: 'in }               -> Result 'a DecodeError,
  from_url_with: { it: 'in, config: UrlC } -> Result 'a DecodeError,
}

impl FromUrl 'a for Str where {
  from_url:      { it: Str }               with Decode UrlC 'a -> Result 'a DecodeError = { it }         -> it.decode { config = url_default },
  from_url_with: { it: Str, config: UrlC } with Decode UrlC 'a -> Result 'a DecodeError = { it, config } -> it.decode { config = config },
}
