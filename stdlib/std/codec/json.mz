## JSON codec — variant-tree output (`JsonC`) and byte-string output (`JsonUtf8C`).
##
## Users touch Tier 4 sugar:
##
##   user.json {}                                # default config, variant tree
##   user.json_with { config = json_pretty }     # explicit preset
##   user.json_utf8 {}                            # bytes directly
##   User.from_json { it = raw }                  # decode
##
## Format authors: everything below is boilerplate. The moving parts are the
## `impl EncodeScalar`/`impl DecodeScalar` bodies — they define the wire shape.
##
## See `docs/codec/redesign-2026-09.md`, "Format author's job — JSON example".
use std::collections::seq
use std::collections::list
use std::collections::set
use std::collections::map
use std::collections::bytes
use std::str
use std::float
use std::int
use std::char
use std::nat
use std::codec::core::{
  Format,
  EncodeScalar, EncodeRecord, EncodeVariant, EncodeList, EncodeMap, EncodeOption,
  DecodeScalar, DecodeRecord, DecodeVariant, DecodeList, DecodeMap, DecodeOption,
  Encode, Decode,
  CodecCtx, SharedConfig, FieldTransform, DecodeError,
  default_shared,
  apply_field_transform,
  transform_field_name, inverse_transform_field_name
}

## ---- Intermediate representation ---------------------------------------

## JSON value — the intermediate representation produced by `JsonC`.
pub type Json = |
  JNull,
  JBool { val: Bool },
  JInt { val: Int },
  JFloat { val: Float },
  JString { val: Str },
  JArray { items: [Json] },
  JObject { fields: [{ key: Str, value: Json }] },
|

## ---- Config types ------------------------------------------------------

## How to render `Option None` at emit time.
pub type NullHandling = | OmitNull, IncludeNull |

## JSON config — variant-tree path. The output type this config picks is
## `Json` (see `impl Format for JsonC having 'out = Json`).
pub type JsonC = {
  shared: SharedConfig,
  pretty: Bool,
  indent: Option Int,
  null_handling: NullHandling,
  sort_keys: Bool,
}

## JSON config — direct-to-bytes path. Same knobs, different output shape
## (`Bytes` — see `impl Format for JsonUtf8C having 'out = Bytes`). Carries
## a distinct `emits_bytes: Bool` marker field: Mezze records are structural,
## so JsonC and JsonUtf8C would otherwise be the same type — that would
## break format-dispatch on `'config`.
pub type JsonUtf8C = {
  shared: SharedConfig,
  pretty: Bool,
  indent: Option Int,
  null_handling: NullHandling,
  sort_keys: Bool,
  emits_bytes: Bool,
}

## ---- Preset configs ----------------------------------------------------

pub let json_default: JsonC = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
}

pub let json_pretty: JsonC = {
  shared = { field_transform = Identity },
  pretty = True,
  indent = Some { val = 2 },
  null_handling = IncludeNull,
  sort_keys = False,
}

pub let json_strict: JsonC = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = OmitNull,
  sort_keys = True,
}

pub let json_utf8_default: JsonUtf8C = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
  emits_bytes = True,
}

pub let json_utf8_camel: JsonUtf8C = {
  shared = { field_transform = CamelCase },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
  emits_bytes = True,
}

