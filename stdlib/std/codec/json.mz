## JSON codec: `Json` tree output (`JsonC`) and UTF-8 byte output (`JsonUtf8C`).
## Use `x.to_json {}`, `x.to_json_with { config }`, `x.to_json_utf8 {}` and `Type.from_json { it }`.
use std::collections::seq
use std::collections::list
use std::collections::set
use std::collections::map
use std::collections::bytes
use std::str
use std::float
use std::int
use std::char
use std::nat
use std::codec::core::{
  Format,
  EncodeScalar, EncodeRecord, EncodeVariant, EncodeSequence, EncodeMapping, EncodeOption,
  DecodeScalar, DecodeRecord, DecodeVariant, DecodeSequence, DecodeMapping, DecodeOption,
  Encode, Decode,
  CodecCtx, SharedConfig, FieldTransform, DecodeError,
  default_shared,
  apply_field_transform,
  transform_field_name, inverse_transform_field_name
}
# See `docs/codec/redesign-2026-09.md`, "Format author's job — JSON example".

# Intermediate representation

## JSON value — the intermediate representation produced by `JsonC`.
pub type Json = |
  JNull,
  JBool { val: Bool },
  JInt { val: Int },
  JFloat { val: Float },
  JString { val: Str },
  JArray { items: [Json] },
  JObject { fields: [{ key: Str, value: Json }] },
|

# Config types

## How to render `Option None` at emit time.
pub type NullHandling = | OmitNull, IncludeNull |

## JSON config producing a `Json` tree.
pub type JsonC = {
  shared: SharedConfig,
  pretty: Bool,
  indent: Option Int,
  null_handling: NullHandling,
  sort_keys: Bool,
}

## JSON config producing `Bytes`; its `emits_bytes` marker keeps it a distinct type from `JsonC`.
pub type JsonUtf8C = {
  shared: SharedConfig,
  pretty: Bool,
  indent: Option Int,
  null_handling: NullHandling,
  sort_keys: Bool,
  emits_bytes: Bool,
}

# Preset configs

pub let json_default: JsonC = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
}

pub let json_pretty: JsonC = {
  shared = { field_transform = Identity },
  pretty = True,
  indent = Some { val = 2 },
  null_handling = IncludeNull,
  sort_keys = False,
}

pub let json_strict: JsonC = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = OmitNull,
  sort_keys = True,
}

pub let json_utf8_default: JsonUtf8C = {
  shared = { field_transform = Identity },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
  emits_bytes = True,
}

pub let json_utf8_camel: JsonUtf8C = {
  shared = { field_transform = CamelCase },
  pretty = False,
  indent = None,
  null_handling = IncludeNull,
  sort_keys = False,
  emits_bytes = True,
}

