use std::collections::seq
use std::collections::list
use std::collections::set
use std::collections::map
use std::collections::bytes
use std::str
use std::float
use std::int
use std::char
use std::nat
use std::codec::core::{ Format, DecodeFormat, EncodeError, DecodeError, CodecConfig }

# ============================================================================
# JSON FORMAT MARKER TYPE
# ============================================================================
# Marker type for JSON format - used as the 'fmt parameter in Format/DecodeFormat
# Use `json_fmt` as the format value when calling Encode/Decode
pub type JsonFmt = {}

pub let json_fmt : JsonFmt = {}

# ============================================================================
# JSON INTERMEDIATE REPRESENTATION
# ============================================================================
# The Json type represents any JSON value
# Note: JArray and JObject use Seq for efficient construction with [...] literals
# Using anonymous record {key: Str, value: Json} for structural compatibility with codec
pub type Json = |
  JNull,
  JBool { val: Bool },
  JInt { val: Int },
  JFloat { val: Float },
  JString { val: Str },
  JArray { items: [Json] },
  JObject { fields: [{ key: Str, value: Json }] },
|

use std::codec::core::{ FieldTransform }

# JSON encoding configuration
pub type JsonConfig = {
  pretty: Bool,
  indent: Int,
  field_transform: FieldTransform,
  skip_null: Bool,
}

# Default JSON configuration
pub let default_config : JsonConfig = {
  pretty = False,
  indent = 2,
  field_transform = Identity,
  skip_null = False,
}

# Create a config with custom settings
pub let config = { pretty: Bool, indent: Int, field_transform: FieldTransform, skip_null: Bool } ->
  {
    pretty = pretty,
    indent = indent,
    field_transform = field_transform,
    skip_null = skip_null,
  }

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================
# Get the type name of a Json value (for error messages)
let json_type_name : { json: Json } -> Str = { json } -> match json is
  JNull -> "null"
  JBool { val } -> "boolean"
  JInt { val } -> "integer"
  JFloat { val } -> "float"
  JString { val } -> "string"
  JArray { items } -> "array"
  JObject { fields } -> "object"


pub let serialize_to_str : { json: Json, config: JsonConfig } -> Str = { json, config } ->
  match __native_json_serialize { json = json, pretty = config.pretty } is
    Ok { val } -> val
    Err { error } -> ""


pub let to_str : { json: Json } -> Str = { json } -> match __native_json_serialize { json = json, pretty = False } is
  Ok { val } -> val
  Err { error } -> ""


let serialize_compact : { json: Json } -> Str = { json } -> match json is
  JNull -> "null"
  JBool { val } -> if val then "true" else "false"
  JInt { val } -> int::to_str { n = val }
  JFloat { val } -> float::to_str { n = val }
  JString { val } -> "\"$(escape_string { s = val })\""
  JArray { items } -> do
    let inner = seq::map { xs = items, f = { x } -> serialize_compact { json = x } }
    "[$(str::join { strings = inner, separator = "," })]"
  JObject { fields } -> do
    let inner = seq::map { xs = fields, f = { x } -> "\"$(escape_string { s = x.key })\":$(serialize_compact { json = x.value })" }
    "{$(str::join { strings = inner, separator = "," })}"


let serialize_pretty : { json: Json, indent: Int, indent_size: Int } -> Str = { json, indent, indent_size } ->
  do
    let indent_str = str::repeat { s = " ", n = indent }
    let next_indent = indent + indent_size
    let next_indent_str = str::repeat { s = " ", n = next_indent }
    match json is
      JNull -> "null"
      JBool { val } -> if val then "true" else "false"
      JInt { val } -> int::to_str { n = val }
      JFloat { val } -> float::to_str { n = val }
      JString { val } -> "\"$(escape_string { s = val })\""
      JArray { items } -> if seq::is_empty { xs = items } then "[]" else do
        let inner = seq::map { xs = items, f = { x } -> "$(next_indent_str)$(serialize_pretty {
          json = x,
          indent = next_indent,
          indent_size = indent_size,
        })" }
        "[\n$(str::join { strings = inner, separator = ",\n" })\n$(indent_str)]"
      JObject { fields } -> if seq::is_empty { xs = fields } then "{}" else do
        let inner = seq::map { xs = fields, f = { x } -> do
          let val_str = serialize_pretty {
            json = x.value,
            indent = next_indent,
            indent_size = indent_size,
          }
          "$(next_indent_str)\"$(escape_string { s = x.key })\": $(val_str)" }
        "{\n$(str::join { strings = inner, separator = ",\n" })\n$(indent_str)}"


let escape_string : { s: Str } -> Str = { s } -> s

pub let parse = { bytes } -> __native_json_parse_bytes { bytes = bytes }

pub let parse_str = { s: Str } -> __native_json_parse { s = s }

pub let transform_field_name = { name: Str, transform: FieldTransform } -> match transform is
  Identity -> name
  SnakeCase -> str::to_snake_case { s = name }
  CamelCase -> str::to_camel_case { s = name }
  KebabCase -> str::to_kebab_case { s = name }
  ScreamingSnakeCase -> str::to_screaming_snake_case { s = name }


pub let inverse_transform_field_name = { name: Str, transform: FieldTransform } ->
  match transform is
    Identity -> name
    SnakeCase -> str::to_camel_case { s = name }
    CamelCase -> str::to_snake_case { s = name }
    KebabCase -> str::to_camel_case { s = name }
    ScreamingSnakeCase -> str::to_camel_case { s = name }


pub let transform_fields : { json: Json, transform: FieldTransform } -> Json = { json, transform } ->
  match transform is
    Identity -> json
    _ -> transform_fields_impl { j = json, t = transform }


let transform_fields_impl : { j: Json, t: FieldTransform } -> Json = { j, t } ->
  match j is
    JNull -> JNull
    JBool { val } -> JBool { val = val }
    JInt { val } -> JInt { val = val }
    JFloat { val } -> JFloat { val = val }
    JString { val } -> JString { val = val }
    JArray { items } -> JArray {
      items = seq::map { xs = items, f = { x } -> transform_fields_impl { j = x, t = t } },
    }
    JObject { fields } -> JObject {
      fields = seq::map { xs = fields, f = { x } ->
        {
          key = transform_field_name { name = x.key, transform = t },
          value = transform_fields_impl { j = x.value, t = t },
        } },
    }


pub let inverse_transform_fields : { json: Json, transform: FieldTransform } -> Json = { json, transform } ->
  match transform is
    Identity -> json
    _ -> inverse_transform_fields_impl { j = json, t = transform }


let inverse_transform_fields_impl : { j: Json, t: FieldTransform } -> Json = { j, t } ->
  match j is
    JNull -> JNull
    JBool { val } -> JBool { val = val }
    JInt { val } -> JInt { val = val }
    JFloat { val } -> JFloat { val = val }
    JString { val } -> JString { val = val }
    JArray { items } -> JArray {
      items = seq::map { xs = items, f = { x } -> inverse_transform_fields_impl { j = x, t = t } },
    }
    JObject { fields } -> JObject {
      fields = seq::map { xs = fields, f = { x } ->
        {
          key = inverse_transform_field_name { name = x.key, transform = t },
          value = inverse_transform_fields_impl { j = x.value, t = t },
        } },
    }


impl Format for Json JsonFmt where {
  encode_int = { val, config, path } -> Ok { val = JInt { val = val } },
  encode_float = { val, config, path } -> Ok { val = JFloat { val = val } },
  encode_string = { val, config, path } -> Ok { val = JString { val = val } },
  encode_bool = { val, config, path } -> Ok { val = JBool { val = val } },
  encode_frac = { val, config, path } -> do
    let f = __native_frac_to_float { n = val }
    Ok { val = JFloat { val = f } },
  encode_bytes = { val, config, path } -> do
    let b64 = bytes::to_base64 { b = val }
    Ok { val = JString { val = b64 } },
  encode_char = { val, config, path } ->
    Ok { val = JString { val = char::to_str { c = val } } },
  encode_nat = { val, config, path } -> Ok { val = JInt { val = nat::to_int { n = val } } },
  encode_record = { fields, config, path } -> Ok { val = JObject { fields = fields } },
  encode_variant = { tag, payload, config, path } -> do
    let fields = match payload is
      Some { val = p } -> [
        { key = "tag", value = JString { val = tag } },
        { key = "value", value = p },
      ]
      None -> [{ key = "tag", value = JString { val = tag } }]

    Ok { val = JObject { fields = fields } },
  encode_list = { elems, config, path } -> Ok { val = JArray { items = elems } },
  encode_set = { elems, config, path } -> do
    Ok { val = JArray { items = set::to_seq { s = elems } } },
  encode_map = { entries, config, path } -> do
    let items = seq::map { xs = entries, f = { x } -> JObject { fields = [
      { key = "key", value = x.key },
      { key = "value", value = x.value },
    ] } }
    Ok { val = JArray { items = items } },
  encode_option = { val, config, path } -> match val is
    Some { val = v } -> Ok { val = v }
    None -> Ok { val = JNull },
  transform_field = { name, config } ->
    transform_field_name { name = name, transform = config.field_transform },
}

impl DecodeFormat for Json JsonFmt where {
  decode_int = { val, config, path } -> match val is
    JInt { val = v } -> Ok { val = v }
    _ -> Err {
      error = {
        path = path,
        message = "Expected integer",
        expected = "Int",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_float = { val, config, path } -> match val is
    JFloat { val = v } -> Ok { val = v }
    JInt { val = v } -> Ok { val = __native_int_to_float { n = v } }
    _ -> Err {
      error = {
        path = path,
        message = "Expected float",
        expected = "Float",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_string = { val, config, path } -> match val is
    JString { val = v } -> Ok { val = v }
    _ -> Err {
      error = {
        path = path,
        message = "Expected string",
        expected = "String",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_bool = { val, config, path } -> match val is
    JBool { val = v } -> Ok { val = v }
    _ -> Err {
      error = {
        path = path,
        message = "Expected boolean",
        expected = "Bool",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_frac = { val, config, path } -> match val is
    JFloat { val = v } -> do
      let f = __native_float_to_frac { f = v }
      Ok { val = f }
    JInt { val = v } -> do
      let f = __native_int_to_frac { n = v }
      Ok { val = f }
    _ -> Err {
      error = {
        path = path,
        message = "Expected fraction (number)",
        expected = "Frac",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_bytes = { val, config, path } -> match val is
    JString { val = v } -> match bytes::from_base64 { s = v } is
      Some { val = b } -> Ok { val = b }
      None -> Err {
        error = {
          path = path,
          message = "Invalid base64 encoding",
          expected = "Bytes (base64)",
          found = Some { val = "invalid base64" },
        },
      }
    _ -> Err {
      error = {
        path = path,
        message = "Expected string (base64 encoded bytes)",
        expected = "Bytes",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_char = { val, config, path } -> match val is
    JString { val = v } -> match char::from_string { s = v } is
      Some { val = c } -> Ok { val = c }
      None -> Err {
        error = {
          path = path,
          message = "Expected single character string",
          expected = "Char",
          found = Some { val = json_type_name { json = val } },
        },
      }
    _ -> Err {
      error = {
        path = path,
        message = "Expected string (single character)",
        expected = "Char",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_nat = { val, config, path } -> match val is
    JInt { val = v } -> match nat::from_int { n = v } is
      Some { val = n } -> Ok { val = n }
      None -> Err {
        error = {
          path = path,
          message = "Expected non-negative integer",
          expected = "Nat",
          found = Some { val = "negative integer" },
        },
      }
    _ -> Err {
      error = {
        path = path,
        message = "Expected non-negative integer",
        expected = "Nat",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_record_field = { val, key, config, path } -> match val is
    JObject { fields } -> find_field { fields = fields, key = key, path = path }
    _ -> Err {
      error = {
        path = path,
        message = "Expected object",
        expected = "Object",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_variant = { val, config, path } -> match val is
    JObject { fields } -> do
      match find_field_value { fields = fields, key = "tag", idx = 0 } is
        Some { val = tag_json } -> match tag_json is
          JString { val = tag } -> do
            let payload = find_field_value { fields = fields, key = "value", idx = 0 }
            Ok { val = { tag = tag, payload = payload } }
          _ -> Err {
            error = {
              path = path,
              message = "Variant tag must be a string",
              expected = "String",
              found = Some { val = json_type_name { json = tag_json } },
            },
          }
        None -> Err {
          error = {
            path = path,
            message = "Variant object missing 'tag' field",
            expected = "Object with 'tag'",
            found = Some { val = "Object without 'tag'" },
          },
        }
    _ -> Err {
      error = {
        path = path,
        message = "Expected variant object",
        expected = "Object",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_list = { val, config, path } -> match val is
    JArray { items } -> Ok { val = items }
    _ -> Err {
      error = {
        path = path,
        message = "Expected array",
        expected = "Seq",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_set = { val, config, path } -> match val is
    JArray { items } -> Ok { val = set::from_seq { xs = items } }
    _ -> Err {
      error = {
        path = path,
        message = "Expected array (for set)",
        expected = "Seq",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_map = { val, config, path } -> match val is
    JObject { fields } -> do
      let converted = seq::map { xs = fields, f = { x } ->
        { key = JString { val = x.key }, value = x.value } }
      Ok { val = converted }
    _ -> Err {
      error = {
        path = path,
        message = "Expected object (for map)",
        expected = "Object",
        found = Some { val = json_type_name { json = val } },
      },
    },
  decode_option = { val, config, path } -> match val is
    JNull -> Ok { val = None }
    _ -> Ok { val = Some { val = val } },
  transform_field = { name, config } ->
    inverse_transform_field_name { name = name, transform = config.field_transform },
}

let find_field = { fields, key, path } -> do
  match find_field_value { fields = fields, key = key, idx = 0 } is
    Some { val = v } -> Ok { val = v }
    None -> Err {
      error = {
        path = path,
        message = "Missing field: $(key)",
        expected = key,
        found = None,
      },
    }


let find_field_value = { fields, key, idx } -> if idx >= seq::size { xs = fields } then None else match seq::get { xs = fields, i = idx } is
  Some { val = entry } -> if entry.key == key then Some { val = entry.value } else find_field_value { fields = fields, key = key, idx = idx + 1 }
  None -> None
