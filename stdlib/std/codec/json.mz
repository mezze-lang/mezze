# Native primitives (format-neutral)

# Backed by the JSON parser native.
## Parse UTF-8 bytes to a `Json` tree.
pub let parse
  : { bytes: Bytes }
  -> Result Json { path: [Str], reason: Str, input_ref: Option Str }
  = { bytes } -> __native_json_parse_bytes { bytes = bytes }

## Parse a string to a `Json` tree.
pub let parse_str
  : { s: Str }
  -> Result Json { path: [Str], reason: Str, input_ref: Option Str }
  = { s } -> __native_json_parse { s = s }

# Used to answer `""` on error, turning a bad encode into a 200 with an empty body.
## Serialize a `Json` tree to text; cannot fail.
pub let to_str: { json: Json } -> Str = { json } ->
  __native_json_serialize { json = json, pretty = False }

## Serialize a `Json` tree honouring the config's `pretty` flag.
pub let serialize_to_str: { json: Json, config: JsonC } -> Str = { json, config } ->
  __native_json_serialize { json = json, pretty = config.pretty }

## Serialize a `Json` tree straight to UTF-8 bytes.
pub let to_bytes: { json: Json } -> Bytes = { json } ->
  __native_json_serialize_bytes { json = json, pretty = False }

# Internal helpers

let json_type_name: { json: Json } -> Str = { json } -> match json is
  JNull -> "null"
  JBool { val } -> "boolean"
  JInt { val } -> "integer"
  JFloat { val } -> "float"
  JString { val } -> "string"
  JArray { items } -> "array"
  JObject { fields } -> "object"

let find_field_value = { fields: [{ key: Str, value: Json }], key: Str, idx: Int } ->
  if idx >= seq::size { xs = fields } then None else match seq::get { xs = fields, i = idx } is
    Some { val = entry } ->
      if entry.key == key then Some { val = entry.value }
      else find_field_value { fields = fields, key = key, idx = idx + 1 }
    None -> None

let missing_field_error = { path: [Str], key: Str } -> Err {
  error = {
    path = path,
    message = "Missing field: $(key)",
    expected = key,
    found = None,
  },
}

# Tier 2: JsonC — variant-tree encode

impl EncodeScalar for JsonC having 'out = Json where {
  encode_int   = { it, val, ctx } -> JInt   { val = val },
  encode_float = { it, val, ctx } -> JFloat { val = val },
  encode_str   = { it, val, ctx } -> JString   { val = val },
  encode_bool  = { it, val, ctx } -> JBool  { val = val },
  encode_frac  = { it, val, ctx } -> JFloat { val = __native_frac_to_float { n = val } },
  encode_bytes = { it, val, ctx } -> JString   { val = bytes::to_base64 { b = val } },
  encode_char  = { it, val, ctx } -> JString   { val = char::to_str { c = val } },
  encode_nat   = { it, val, ctx } -> JInt   { val = nat::to_int { n = val } },
}

impl EncodeRecord for JsonC having 'out = Json where {
  encode_record = { it, fields, ctx } -> JObject { fields = fields },
}

impl EncodeVariant for JsonC having 'out = Json where {
  encode_variant = { it, tag, payload, ctx } -> match payload is
    Some { val = p } -> JObject {
      fields = [
        { key = "tag", value = JString { val = tag } },
        { key = "value", value = p },
      ],
    }
    None -> JObject {
      fields = [{ key = "tag", value = JString { val = tag } }],
    },
}

impl EncodeSequence for JsonC having 'out = Json where {
  encode_sequence = { it, elems, ctx } -> JArray { items = elems },
}

impl EncodeMapping for JsonC having 'out = Json where {
  encode_mapping = { it, entries, ctx } -> JArray {
    items = seq::map { xs = entries, f = { x } -> JObject {
      fields = [
        { key = "key", value = x.key },
        { key = "value", value = x.value },
      ],
    } },
  },
}

impl EncodeOption for JsonC having 'out = Json where {
  encode_option = { it, val, ctx } -> match val is
    None -> JNull
    Some { val = v } -> v,
}

# Tier 2: JsonC — decode

impl DecodeScalar for JsonC having 'in = Json where {
  decode_int = { it, val, ctx } -> match val is
    JInt { val = v } -> Ok { val = v }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected integer",
      expected = "Int",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_float = { it, val, ctx } -> match val is
    JFloat { val = v } -> Ok { val = v }
    JInt { val = v } -> Ok { val = __native_int_to_float { n = v } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected float",
      expected = "Float",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_str = { it, val, ctx } -> match val is
    JString { val = v } -> Ok { val = v }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected string",
      expected = "Str",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_bool = { it, val, ctx } -> match val is
    JBool { val = v } -> Ok { val = v }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected boolean",
      expected = "Bool",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_frac = { it, val, ctx } -> match val is
    JFloat { val = v } -> Ok { val = __native_float_to_frac { f = v } }
    JInt { val = v } -> Ok { val = __native_int_to_frac { n = v } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected fraction (number)",
      expected = "Frac",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_bytes = { it, val, ctx } -> match val is
    JString { val = v } -> match bytes::from_base64 { s = v } is
      Some { val = b } -> Ok { val = b }
      None -> Err { error = {
        path = ctx.path,
        message = "Invalid base64 encoding",
        expected = "Bytes (base64)",
        found = Some { val = "invalid base64" },
      } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected string (base64 encoded bytes)",
      expected = "Bytes",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_char = { it, val, ctx } -> match val is
    JString { val = v } -> match char::from_str { s = v } is
      Some { val = c } -> Ok { val = c }
      None -> Err { error = {
        path = ctx.path,
        message = "Expected single character string",
        expected = "Char",
        found = Some { val = json_type_name { json = val } },
      } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected string (single character)",
      expected = "Char",
      found = Some { val = json_type_name { json = val } },
    } },
  decode_nat = { it, val, ctx } -> match val is
    JInt { val = v } -> match nat::from_int { n = v } is
      Some { val = n } -> Ok { val = n }
      None -> Err { error = {
        path = ctx.path,
        message = "Expected non-negative integer",
        expected = "Nat",
        found = Some { val = "negative integer" },
      } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected non-negative integer",
      expected = "Nat",
      found = Some { val = json_type_name { json = val } },
    } },
}

impl DecodeRecord for JsonC having 'in = Json where {
  decode_record_field = { it, val, key, ctx } -> match val is
    JObject { fields } -> match find_field_value { fields = fields, key = key, idx = 0 } is
      Some { val = v } -> Ok { val = v }
      None -> missing_field_error { path = ctx.path, key = key }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected object",
      expected = "Object",
      found = Some { val = json_type_name { json = val } },
    } },
}

impl DecodeVariant for JsonC having 'in = Json where {
  decode_variant = { it, val, ctx } -> match val is
    JObject { fields } -> match find_field_value { fields = fields, key = "tag", idx = 0 } is
      Some { val = tag_json } -> match tag_json is
        JString { val = tag } -> Ok { val = {
          tag = tag,
          payload = find_field_value { fields = fields, key = "value", idx = 0 },
        } }
        _ -> Err { error = {
          path = ctx.path,
          message = "Variant tag must be a string",
          expected = "String",
          found = Some { val = json_type_name { json = tag_json } },
        } }
      None -> Err { error = {
        path = ctx.path,
        message = "Variant object missing 'tag' field",
        expected = "Object with 'tag'",
        found = Some { val = "Object without 'tag'" },
      } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected variant object",
      expected = "Object",
      found = Some { val = json_type_name { json = val } },
    } },
}

impl DecodeSequence for JsonC having 'in = Json where {
  decode_sequence = { it, val, ctx } -> match val is
    JArray { items } -> Ok { val = items }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected array",
      expected = "Array",
      found = Some { val = json_type_name { json = val } },
    } },
}

## Split one encoded map entry `{ "key", "value" }` back apart; None if malformed.
let map_entry_of: { j: Json } -> Option { key: Json, value: Json } = { j } -> match j is
  JObject { fields } -> match find_field_value { fields = fields, key = "key", idx = 0 } is
    Some { val = k } -> match find_field_value { fields = fields, key = "value", idx = 0 } is
      Some { val = v } -> Some { val = { key = k, value = v } }
      None -> None
    None -> None
  _ -> None

## Every map entry, or None if any one is malformed.
let read_map_entries:
  { items: [Json], idx: Int, acc: [{ key: Json, value: Json }] }
  -> Option [{ key: Json, value: Json }] =
  { items, idx, acc } ->
    if idx >= seq::size { xs = items } then Some { val = acc }
    else match seq::get { xs = items, i = idx } is
      Some { val = item } -> match map_entry_of { j = item } is
        Some { val = entry } ->
          read_map_entries { items = items, idx = idx + 1, acc = seq::add { xs = acc, x = entry } }
        None -> None
      None -> None

impl DecodeMapping for JsonC having 'in = Json where {
  # Used to expect a JObject, so a map never round-tripped through JSON.
  ## Reads back what `encode_mapping` writes: a JArray of `{ "key", "value" }` objects.
  ## The array form is what lets non-string keys survive.
  decode_mapping = { it, val, ctx } -> match val is
    JArray { items } -> match read_map_entries { items = items, idx = 0, acc = [] } is
      Some { val = entries } -> Ok { val = entries }
      None -> Err { error = {
        path = ctx.path,
        message = "Expected every map entry to be an object with 'key' and 'value'",
        expected = "Array of { key, value }",
        found = Some { val = json_type_name { json = val } },
      } }
    _ -> Err { error = {
      path = ctx.path,
      message = "Expected array (for map)",
      expected = "Array",
      found = Some { val = json_type_name { json = val } },
    } },
}

impl DecodeOption for JsonC having 'in = Json where {
  decode_option = { it, val, ctx } -> match val is
    JNull -> Ok { val = None }
    _ -> Ok { val = Some { val = val } },
}

# Tier 2: JsonUtf8C — build the `Json` tree, then serialize once at the entry point.
# Streaming straight to bytes was measured slower (199.6k vs 235.8k req/s;
# closures 149.2k): per-node guest dispatch costs more than the tree.

impl EncodeScalar for JsonUtf8C having 'out = Json where {
  encode_int   = { it, val, ctx } -> JInt    { val = val },
  encode_float = { it, val, ctx } -> JFloat  { val = val },
  encode_str   = { it, val, ctx } -> JString { val = val },
  encode_bool  = { it, val, ctx } -> JBool   { val = val },
  encode_frac  = { it, val, ctx } -> JFloat  { val = __native_frac_to_float { n = val } },
  encode_bytes = { it, val, ctx } -> JString { val = bytes::to_base64 { b = val } },
  encode_char  = { it, val, ctx } -> JString { val = char::to_str { c = val } },
  encode_nat   = { it, val, ctx } -> JInt    { val = nat::to_int { n = val } },
}

impl EncodeRecord for JsonUtf8C having 'out = Json where {
  encode_record = { it, fields, ctx } -> JObject { fields = fields },
}

impl EncodeVariant for JsonUtf8C having 'out = Json where {
  encode_variant = { it, tag, payload, ctx } -> match payload is
    Some { val = p } -> JObject {
      fields = [
        { key = "tag", value = JString { val = tag } },
        { key = "value", value = p },
      ],
    }
    None -> JObject {
      fields = [{ key = "tag", value = JString { val = tag } }],
    },
}

impl EncodeSequence for JsonUtf8C having 'out = Json where {
  encode_sequence = { it, elems, ctx } -> JArray { items = elems },
}

impl EncodeMapping for JsonUtf8C having 'out = Json where {
  encode_mapping = { it, entries, ctx } -> JArray {
    items = seq::map { xs = entries, f = { x } -> JObject {
      fields = [
        { key = "key", value = x.key },
        { key = "value", value = x.value },
      ],
    } },
  },
}

impl EncodeOption for JsonUtf8C having 'out = Json where {
  encode_option = { it, val, ctx } -> match val is
    None -> JNull
    Some { val = v } -> v,
}

# Tier 4: sugar abilities + blankets

## Encode any value to a `Json` tree via `.json{}` / `.json_with{}`.
ability ToJson for 'a where {
  to_json:          { it: 'a }                -> Json,
  to_json_with:     { it: 'a, config: JsonC } -> Json,
  to_json_str:      { it: 'a }                -> Str,
  to_json_str_with: { it: 'a, config: JsonC } -> Str,
}

impl ToJson for 'a where {
  to_json:          { it: 'a }                with Encode JsonC 'a -> Json = { it }         -> it.encode { config = json_default },
  to_json_with:     { it: 'a, config: JsonC } with Encode JsonC 'a -> Json = { it, config } -> it.encode { config = config },
  to_json_str:      { it: 'a }                with Encode JsonC 'a -> Str  = { it }         -> to_str { json = it.encode { config = json_default } },
  to_json_str_with: { it: 'a, config: JsonC } with Encode JsonC 'a -> Str  = { it, config } -> serialize_to_str { json = it.encode { config = config }, config = config },
}

## Encode any value directly to UTF-8 bytes.
ability ToJsonUtf8 for 'a where {
  to_json_utf8:      { it: 'a }                    -> Bytes,
  to_json_utf8_with: { it: 'a, config: JsonUtf8C } -> Bytes,
}

impl ToJsonUtf8 for 'a where {
  to_json_utf8:      { it: 'a }                    with Encode JsonUtf8C 'a -> Bytes = { it }         -> to_bytes { json = it.encode { config = json_utf8_default } },
  to_json_utf8_with: { it: 'a, config: JsonUtf8C } with Encode JsonUtf8C 'a -> Bytes = { it, config } -> to_bytes { json = it.encode { config = config } },
}

## Decode a value from a `Json` tree via `Type.from_json{}`; the target type drives dispatch.
ability FromJson 'a for 'in where {
  from_json:      { it: 'in }                  -> Result 'a DecodeError,
  from_json_with: { it: 'in, config: JsonC }   -> Result 'a DecodeError,
}

## Decode straight from JSON text; parse errors become a `DecodeError`.
impl FromJson 'a for Str where {
  from_json: { it: Str } with Decode JsonC 'a Json -> Result 'a DecodeError = { it } ->
    match parse_str { s = it } is
      Ok { val } -> val.decode { config = json_default }
      Err { error } -> Err { error = { path = error.path, message = error.reason, expected = "valid JSON", found = error.input_ref } },
  from_json_with: { it: Str, config: JsonC } with Decode JsonC 'a Json -> Result 'a DecodeError = { it, config } ->
    match parse_str { s = it } is
      Ok { val } -> val.decode { config = config }
      Err { error } -> Err { error = { path = error.path, message = error.reason, expected = "valid JSON", found = error.input_ref } },
}

impl FromJson 'a for Json where {
  from_json:      { it: Json }                with Decode JsonC 'a Json -> Result 'a DecodeError = { it }         -> it.decode { config = json_default },
  from_json_with: { it: Json, config: JsonC } with Decode JsonC 'a Json -> Result 'a DecodeError = { it, config } -> it.decode { config = config },
}
