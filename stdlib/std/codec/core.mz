use std::str
use std::int
use std::collections::seq
use std::collections::bytes
use std::abilities::convert::{ Into, TryInto }

## Error returned when encoding fails.
pub type EncodeError = { path: [Str], message: Str }

## Error returned when decoding fails.
pub type DecodeError = {
  path: [Str],
  message: Str,
  expected: Str,
  found: Option Str,
}

## Field name transformation strategies for codecs.
pub type FieldTransform = |
  Identity,
  SnakeCase,
  CamelCase,
  KebabCase,
  ScreamingSnakeCase,
|

## How to handle null/None values during encoding.
pub type NullHandling = | OmitNull, IncludeNull |

## Configuration for encoding and decoding.
pub type CodecConfig = {
  field_transform: FieldTransform,
  null_handling: NullHandling,
  sort_keys: Bool,
  indent: Option Int,
}

## Default codec configuration (identity transform, include nulls, compact).
pub let default_config : CodecConfig = {
  field_transform = Identity,
  null_handling = IncludeNull,
  sort_keys = False,
  indent = None,
}

## Format ability — implement once per serialization format (JSON, CSV, etc).
ability Format 'repr for 'fmt where {
  encode_int: { val: Int, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_float: { val: Float, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_string: { val: Str, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_bool: { val: Bool, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_frac: { val: Frac, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_bytes: { val: Bytes, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_char: { val: Char, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_nat: { val: Nat, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_record: { fields: [{ key: Str, value: 'repr }], config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_variant: { tag: Str, payload: Option 'repr, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_list: { elems: ['repr], config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_set: { elems: Set 'repr, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_map: { entries: [{ key: 'repr, value: 'repr }], config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  encode_option: { val: Option 'repr, config: CodecConfig, path: [Str] } -> Result 'repr EncodeError,
  transform_field: { name: Str, config: CodecConfig } -> Str
}

## Decode format ability — extract values from an intermediate representation.
ability DecodeFormat 'repr for 'fmt where {
  decode_int: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Int DecodeError,
  decode_float: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Float DecodeError,
  decode_string: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Str DecodeError,
  decode_bool: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Bool DecodeError,
  decode_frac: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Frac DecodeError,
  decode_bytes: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Bytes DecodeError,
  decode_char: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Char DecodeError,
  decode_nat: { val: 'repr, config: CodecConfig, path: [Str] } -> Result Nat DecodeError,
  decode_record_field: { val: 'repr, key: Str, config: CodecConfig, path: [Str] } -> Result 'repr DecodeError,
  decode_variant: { val: 'repr, config: CodecConfig, path: [Str] } -> Result { tag: Str, payload: Option 'repr } DecodeError,
  decode_list: { val: 'repr, config: CodecConfig, path: [Str] } -> Result ['repr] DecodeError,
  decode_set: { val: 'repr, config: CodecConfig, path: [Str] } -> Result (Set 'repr) DecodeError,
  decode_map: { val: 'repr, config: CodecConfig, path: [Str] } -> Result [{ key: 'repr, value: 'repr }] DecodeError,
  decode_option: { val: 'repr, config: CodecConfig, path: [Str] } -> Result (Option 'repr) DecodeError,
  transform_field: { name: Str, config: CodecConfig } -> Str
}

## Encode a value to an intermediate representation.
ability EncodeRepr for 'a where {
  encode_repr: { fmt: 'fmt, config: CodecConfig } -> Result 'repr EncodeError
}

## Encode a value directly to an output type (Bytes, Str, etc).
ability Encode for 'a where {
  encode: { fmt: 'fmt, config: CodecConfig } -> Result 'out EncodeError
}

## Decode a value from an intermediate representation.
ability DecodeRepr 'a for 'repr where {
  decode_repr: { fmt: 'fmt, config: CodecConfig } -> Result 'a DecodeError
}

## Decode a value from an input type (Bytes, Str, etc).
ability Decode 'a for 'in where {
  decode: { fmt: 'fmt, config: CodecConfig } -> Result 'a DecodeError
}

## Streaming format — writes directly to ByteBuffer without intermediate AST.
ability StreamFormat for 'fmt where {
  stream_int: { val: Int, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_float: { val: Float, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_string: { val: Str, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_bool: { val: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_frac: { val: Frac, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_bytes: { val: Bytes, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_char: { val: Char, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_nat: { val: Nat, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_record_start: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_record_field: { key: Str, is_first: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_record_end: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_variant_start: { tag: Str, has_payload: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_variant_end: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_list_start: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_list_elem: { is_first: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_list_end: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_set_start: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_set_elem: { is_first: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_set_end: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_map_start: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_map_entry: { is_first: Bool, buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_map_end: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_option_none: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  stream_option_some: { buffer: ByteBuffer, config: CodecConfig, path: [Str] } -> Result ByteBuffer EncodeError,
  transform_field: { name: Str, config: CodecConfig } -> Str
}

## Streaming decode format — reads directly from Bytes.
ability StreamDecodeFormat for 'fmt where {
  stream_decode_int: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Int, offset: Int } DecodeError,
  stream_decode_float: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Float, offset: Int } DecodeError,
  stream_decode_string: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Str, offset: Int } DecodeError,
  stream_decode_bool: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Bool, offset: Int } DecodeError,
  stream_decode_frac: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Frac, offset: Int } DecodeError,
  stream_decode_bytes: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Bytes, offset: Int } DecodeError,
  stream_decode_char: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Char, offset: Int } DecodeError,
  stream_decode_nat: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Nat, offset: Int } DecodeError,
  stream_decode_record_start: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { offset: Int } DecodeError,
  stream_decode_record_field: { bytes: Bytes, offset: Int, key: Str, config: CodecConfig, path: [Str] } -> Result { value: Bytes, offset: Int } DecodeError,
  stream_decode_variant: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { tag: Str, payload: Option Bytes, offset: Int } DecodeError,
  stream_decode_list_start: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { offset: Int } DecodeError,
  stream_decode_list_next: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Option Bytes, offset: Int } DecodeError,
  stream_decode_set_start: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { offset: Int } DecodeError,
  stream_decode_set_next: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Option Bytes, offset: Int } DecodeError,
  stream_decode_map_start: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { offset: Int } DecodeError,
  stream_decode_map_next: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { entry: Option { key: Bytes, value: Bytes }, offset: Int } DecodeError,
  stream_decode_option: { bytes: Bytes, offset: Int, config: CodecConfig, path: [Str] } -> Result { value: Option Bytes, offset: Int } DecodeError,
  transform_field: { name: Str, config: CodecConfig } -> Str
}

## Streaming encode — writes a value directly to a ByteBuffer.
ability StreamEncode for 'a where {
  stream_encode: { fmt: 'fmt, buffer: ByteBuffer, config: CodecConfig } -> Result ByteBuffer EncodeError
}

## Streaming decode — reads a value directly from Bytes.
ability StreamDecode 'a for 'bytes where {
  stream_decode: { offset: Int, fmt: 'fmt, config: CodecConfig } -> Result { value: 'a, offset: Int } DecodeError
}

## Empty path for top-level encoding/decoding.
pub let empty_path : [Str] = []

## Appends a field name to a codec path.
pub let append_path = { path: [Str], field: Str } -> seq::add { xs = path, x = field }

## Appends an index to a codec path.
pub let append_index = { path: [Str], index: Int } ->
  seq::add { xs = path, x = int::to_str { n = index } }

## Formats a codec path as a dotted string.
pub let format_path = { path: [Str] } -> if seq::is_empty { xs = path } then "<root>" else str::join { strings = path, separator = "." }

## Creates an encode error Result.
pub let encode_error = { path: [Str], message: Str } ->
  Err { error = { path = path, message = message } }

## Creates a decode error Result.
pub let decode_error = { path: [Str], message: Str, expected: Str, found: Option Str } ->
  Err {
    error = {
      path = path,
      message = message,
      expected = expected,
      found = found,
    },
  }

impl TryInto Str DecodeError for Bytes where {
  try_into = { it } -> match bytes::to_str { b = it } is
    Ok { val = s } -> Ok { val = s }
    Err { error = e } -> Err {
      error = {
        path = [],
        message = e,
        expected = "valid UTF-8",
        found = None,
      },
    }

}
