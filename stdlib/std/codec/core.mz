## Codec core — 4-tier ability system for serialization / deserialization.
##
## Users touch Tier 4 (per-format sugar, `x.json{}` / `Type.from_json{}`) which
## lives in each format module. Everything below is the machinery:
##
##   Tier 1 — `Format`                     : config → output-type link
##   Tier 2 — `Encode<Shape>` / `Decode<Shape>` : per-shape primitives (6 + 6)
##   Tier 3 — `Encode 'config for 'a`      : one-shot encode/decode ability
##            `Decode 'config 'a for 'in`   the compiler auto-derives per pair
##
## Format authors write Tier 1 + Tier 2 impls for their config type. The
## compiler synthesizes Tier 3 by walking value shape and composing Tier 2.
## Tier 4 in the format module wraps Tier 3 with a blanket impl per format.
##
## See `docs/codec/redesign-2026-09.md` for the full design.
use std::str
use std::int
use std::collections::seq
use std::collections::bytes

## Field-name transformation strategies applied uniformly at emit time.
pub type FieldTransform = |
  Identity,
  SnakeCase,
  CamelCase,
  KebabCase,
  ScreamingSnakeCase,
|

## Cross-format shared config. Every format's config type embeds this as a
## `shared` field so HTTP / FileSystem integration can pass field-transform
## preferences uniformly.
pub type SharedConfig = { field_transform: FieldTransform }

## Context threaded through encode / decode walks. `path` accumulates
## record / list positions for error reporting; `shared` carries the
## cross-format knobs. Records are structural in Mezze, so encode and
## decode share the single type — direction-specific knobs will need
## nominal wrappers (newtype) or extra discriminating fields when they
## are added.
pub type CodecCtx = { path: [Str], shared: SharedConfig }

## Structured decode error. `path` locates the field / index, `message`
## is human-readable, `expected` / `found` describe the mismatch.
pub type DecodeError = {
  path: [Str],
  message: Str,
  expected: Str,
  found: Option Str,
}

## Default shared config — no field-name transform.
pub let default_shared: SharedConfig = { field_transform = Identity }

## ---- Tier 1 — Format identity ------------------------------------------
##
## Associates a config type with the output type its encoders produce.
## One tiny impl per (config, output) pair — the sole point where format
## identity is declared to the codec system.
ability Format for 'config having 'out where {
}

## ---- Tier 2 — Per-shape encode (6 abilities) ---------------------------

## Encode primitive scalars. Every format must implement these to encode
## anything; missing means "format can't produce output at all".
ability EncodeScalar for 'config having 'out where {
  encode_int:   { it: 'config, val: Int,   ctx: CodecCtx } -> 'out,
  encode_float: { it: 'config, val: Float, ctx: CodecCtx } -> 'out,
  encode_str:   { it: 'config, val: Str,   ctx: CodecCtx } -> 'out,
  encode_bool:  { it: 'config, val: Bool,  ctx: CodecCtx } -> 'out,
  encode_frac:  { it: 'config, val: Frac,  ctx: CodecCtx } -> 'out,
  encode_bytes: { it: 'config, val: Bytes, ctx: CodecCtx } -> 'out,
  encode_char:  { it: 'config, val: Char,  ctx: CodecCtx } -> 'out,
  encode_nat:   { it: 'config, val: Nat,   ctx: CodecCtx } -> 'out,
}

## Encode a record shape given per-field key/value pairs already encoded
## to `'out` by the walker.
ability EncodeRecord for 'config having 'out where {
  encode_record: { it: 'config, fields: [{ key: Str, value: 'out }], ctx: CodecCtx } -> 'out,
}

## Encode a variant shape given tag and optional payload already encoded.
ability EncodeVariant for 'config having 'out where {
  encode_variant: { it: 'config, tag: Str, payload: Option 'out, ctx: CodecCtx } -> 'out,
}

## Encode a list / sequence given per-element output already encoded.
## Sets flow through this after `set::to_seq`.
ability EncodeList for 'config having 'out where {
  encode_list: { it: 'config, elems: ['out], ctx: CodecCtx } -> 'out,
}

## Encode a list of PRIMITIVES without encoding each element first.
##
## `EncodeList` receives its elements ALREADY encoded, so a container of N
## primitives costs N calls into the format before the list is built. For a
## polyglot format that is N crossings into the guest — measured at ~0.25 ms
## per 1000 elements, which made `[1..1000].to_js{}` slower than printing the
## list into guest source and parsing it back.
##
## A format implements this when its own representation can hold Mezze
## primitives directly, so the walk can be skipped entirely. One op per
## primitive rather than one polymorphic op, mirroring `EncodeScalar` — that
## keeps every impl monomorphic, which a `'a`-parameterised ability could not.
##
## OPTIONAL. A format that does not implement it simply does not get the fast
## path; auto-derivation falls back to `EncodeList` exactly as before.
ability EncodeRawList for 'config having 'out where {
  encode_int_list:   { it: 'config, elems: [Int],   ctx: CodecCtx } -> 'out,
  encode_float_list: { it: 'config, elems: [Float], ctx: CodecCtx } -> 'out,
  encode_str_list:   { it: 'config, elems: [Str],   ctx: CodecCtx } -> 'out,
  encode_bool_list:  { it: 'config, elems: [Bool],  ctx: CodecCtx } -> 'out,
}

## Encode a map given per-entry key/value output already encoded.
ability EncodeMap for 'config having 'out where {
  encode_map: { it: 'config, entries: [{ key: 'out, value: 'out }], ctx: CodecCtx } -> 'out,
}

## Encode an option — `Some` wraps its inner encoded value, `None`
## renders however the format prefers (JSON null, absent field, etc.).
ability EncodeOption for 'config having 'out where {
  encode_option: { it: 'config, val: Option 'out, ctx: CodecCtx } -> 'out,
}

## ---- Tier 2 — Per-shape decode (6 abilities) ---------------------------

## Decode primitive scalars from the format's input representation.
ability DecodeScalar for 'config having 'in where {
  decode_int:   { it: 'config, val: 'in, ctx: CodecCtx } -> Result Int   DecodeError,
  decode_float: { it: 'config, val: 'in, ctx: CodecCtx } -> Result Float DecodeError,
  decode_str:   { it: 'config, val: 'in, ctx: CodecCtx } -> Result Str   DecodeError,
  decode_bool:  { it: 'config, val: 'in, ctx: CodecCtx } -> Result Bool  DecodeError,
  decode_frac:  { it: 'config, val: 'in, ctx: CodecCtx } -> Result Frac  DecodeError,
  decode_bytes: { it: 'config, val: 'in, ctx: CodecCtx } -> Result Bytes DecodeError,
  decode_char:  { it: 'config, val: 'in, ctx: CodecCtx } -> Result Char  DecodeError,
  decode_nat:   { it: 'config, val: 'in, ctx: CodecCtx } -> Result Nat   DecodeError,
}

## Decode a single record field by key from the input, leaving the walker
## to further descend into the returned sub-value.
ability DecodeRecord for 'config having 'in where {
  decode_record_field: { it: 'config, val: 'in, key: Str, ctx: CodecCtx } -> Result 'in DecodeError,
}

## Decode a variant: pull tag + optional payload out of the input.
ability DecodeVariant for 'config having 'in where {
  decode_variant: { it: 'config, val: 'in, ctx: CodecCtx } -> Result { tag: Str, payload: Option 'in } DecodeError,
}

## Decode a list into per-element input values; the walker recurses on each.
ability DecodeList for 'config having 'in where {
  decode_list: { it: 'config, val: 'in, ctx: CodecCtx } -> Result ['in] DecodeError,
}

## Decode a map into per-entry input pairs; the walker recurses on each side.
ability DecodeMap for 'config having 'in where {
  decode_map: { it: 'config, val: 'in, ctx: CodecCtx } -> Result [{ key: 'in, value: 'in }] DecodeError,
}

## Decode an option — `None` for absent / null, `Some` for present.
ability DecodeOption for 'config having 'in where {
  decode_option: { it: 'config, val: 'in, ctx: CodecCtx } -> Result (Option 'in) DecodeError,
}

## ---- Tier 3 — Encode / Decode primitives -------------------------------
##
## The compiler auto-derives `impl Encode 'config for 'a having 'out`
## per (config, value-type) pair by walking the shape and composing Tier
## 2 impls. User-facing API is the Tier-4 sugar in each format module
## (`x.json{}` etc.); direct `.encode { config = ... }` works but is the
## escape hatch, not the default.

## One-shot encode of a value to a format's output type.
ability Encode 'config for 'a having 'out where {
  encode: { it: 'a, config: 'config } -> 'out,
}

## One-shot decode of a format's input to a target value type.
## `'a` appears only in the return position; dispatch is target-driven,
## typically via LHS type annotation or inherent method syntax
## (`Type.decode { ... }`).
ability Decode 'config 'a for 'in where {
  decode: { it: 'in, config: 'config } -> Result 'a DecodeError,
}

## ---- Path helpers ------------------------------------------------------

## Empty path for top-level encoding/decoding.
pub let empty_path: [Str] = []

## Appends a field name to a codec path.
pub let append_path = { path: [Str], field: Str } -> seq::add { xs = path, x = field }

## Appends an index to a codec path.
pub let append_index = { path: [Str], index: Int } ->
  seq::add { xs = path, x = int::to_str { n = index } }

## Formats a codec path as a dotted string. `<root>` when empty.
pub let format_path = { path: [Str] } ->
  if seq::is_empty { xs = path } then "<root>" else str::join { strings = path, separator = "." }

## Constructs a `DecodeError` Result — helper for Tier-2 impl bodies.
pub let decode_error
  : { path: [Str], message: Str, expected: Str, found: Option Str }
  -> Result 'a DecodeError
  = { path, message, expected, found } -> Err { error = {
      path = path,
      message = message,
      expected = expected,
      found = found,
    } }

## ---- Field-name transforms ---------------------------------------------

## Encode-side transform: source name → wire name.
pub let transform_field_name = { name: Str, transform: FieldTransform } -> match transform is
  Identity -> name
  SnakeCase -> str::to_snake_case { s = name }
  CamelCase -> str::to_camel_case { s = name }
  KebabCase -> str::to_kebab_case { s = name }
  ScreamingSnakeCase -> str::to_screaming_snake_case { s = name }

## Decode-side transform: wire name → source name. `SnakeCase` inverts
## to camel; the rest normalise onto camel identifiers.
pub let inverse_transform_field_name = { name: Str, transform: FieldTransform } -> match transform is
  Identity -> name
  SnakeCase -> str::to_camel_case { s = name }
  CamelCase -> str::to_snake_case { s = name }
  KebabCase -> str::to_camel_case { s = name }
  ScreamingSnakeCase -> str::to_camel_case { s = name }

## Convenience for the compiler-emitted encode walker: apply the
## configured field transform against the shared config alone.
pub let apply_field_transform = { name: Str, shared: SharedConfig } ->
  transform_field_name { name = name, transform = shared.field_transform }
