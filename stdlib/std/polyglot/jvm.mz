# JVM host-language access.
#
# `JvmForeign` wraps a Java host object and is a "try": a live handle or a
# carried `InteropError`. Value verbs return a `JvmForeign` and short-circuit an
# errored one, so a chain flows with no `Result` between steps —
#
#     jvm::class { name = "java.util.ArrayList" }
#       .new { args = [] }
#       .method { name = "add", args = [from_int { val = 7 }] }
#       .len {}        # a crossing: JvmForeign -> Result Int, where an error surfaces
#
# A `Result` appears only when a value is pulled back into Mezze (the coercions,
# `is_null`, `type_name`, `len`, `to_seq`, `has`). This is the in-tree reference
# for the two-layer design: verbs delegate down via `perform Runtime in
# Polyglot.<op>`, so no verb calls a native. Requires the Context to allow host
# class lookup (`allowAllAccess(true)` in test/dev).
use std::polyglot::core::{ InteropError, Polyglot, Runtime, Foreign }
use std::codec::core::{
  Format,
  EncodeScalar, EncodeOption, EncodeSequence, EncodeMapping, EncodeRecord, EncodeVariant,
  DecodeScalar, DecodeOption, DecodeSequence, DecodeMapping, DecodeRecord, DecodeVariant,
  EncodeScalarSequence, DecodeScalarSequence,
  Encode, Decode,
  CodecCtx, SharedConfig, DecodeError,
  default_shared,
  decode_error
}
use std::collections::seq
use std::float
use std::int
use std::char
use std::nat

## Opaque handle to a JVM host object (or a carried error). Wraps the public
## `Foreign` handle (never the internal `__NativeForeign` primitive); the newtype
## gives Mezze-level type safety against mixing JVM and non-JVM Foreigns.
pub newtype JvmForeign = Foreign

## JVM host effect. `class` performs a fully-qualified host class lookup — the
## returned Foreign is a Java `Class` interop object, instantiable (`.new{}`) and
## member-invocable (`.method{}`). This is the JVM's entry point (the analogue of
## `eval` for a guest language): it mints the first `JvmForeign`. A miss (class not
## found / lookup disallowed) yields an ERRORED `JvmForeign`, which the next verb
## short-circuits and a coercion surfaces as `Err`.
effect Jvm where {
  class: { name: Str } -> JvmForeign <Jvm>
}

## Default JVM host — delegates to whatever host class lookup the surrounding
## polyglot Context permits. Host class lookup is JVM-specific, so it calls the one
## JVM native directly rather than a generic `Polyglot` op. The handler type is
## introduced by the impl itself (the stdlib idiom); no separate `type` is needed.
impl Jvm for JvmHost where {
  class = { name } -> __native_jvm_class { name = name }
}

## The complete verb set on a JvmForeign. Value verbs bury their own
## `perform Runtime` and return a `JvmForeign` (chains flow with no `Result`);
## crossings return a `Result`. An errored receiver short-circuits every value verb
## untouched, and a guest throw is caught into an errored `JvmForeign`.
impl JvmForeign where {
  ## object protocol (yield a JvmForeign)

  ## Read a member (Java field, static, enum constant, `INSTANCE` singleton).
  get    = { it, name } ->
    perform Runtime in Polyglot.read_member { on = it, name = name },
  ## Write a member; fluent — yields the receiver.
  set    = { it, name, val } ->
    perform Runtime in Polyglot.write_member { on = it, name = name, val = val },
  ## Call a callable Foreign (a function / lambda / bound method).
  call   = { it, args } ->
    perform Runtime in Polyglot.execute { on = it, args = args },
  ## Read a member and call it — the everyday `obj.name(args)`.
  method = { it, name, args } ->
    perform Runtime in Polyglot.invoke_member { on = it, name = name, args = args },
  ## Instantiate a class Foreign — `new Klass(args)`.
  new    = { it, args } ->
    perform Runtime in Polyglot.instantiate { on = it, args = args },

  ## containers

  ## Read an array element by index (yields a JvmForeign). For BULK numeric data
  ## prefer `to_ints`/`to_floats` (or `to_seq` / `read_bytes`): a per-element `at{}`
  ## loop costs one boundary crossing per element, the bulk verbs cost ONE total.
  at      = { it, index } ->
    perform Runtime in Polyglot.read_array { on = it, index = index },
  ## Write an array element by index; fluent.
  set_at  = { it, index, val } ->
    perform Runtime in Polyglot.write_array { on = it, index = index, val = val },
  ## Read a mapping entry by key. The key may be a Foreign or a bare Mezze value.
  key     = { it, of } ->
    perform Runtime in Polyglot.read_hash { on = it, key = of },
  ## Write a mapping entry; fluent.
  set_key = { it, of, val } ->
    perform Runtime in Polyglot.write_hash { on = it, key = of, val = val },
  ## Every mapping entry as a Foreign holding a seq of two-element `[key, value]`
  ## Foreigns — the shape a codec's `decode_mapping` walks. Yields a JvmForeign.
  entries = { it } ->
    perform Runtime in Polyglot.hash_entries { on = it },

  ## crossings: pull a value back into Mezze → Result

  ## Surface a carried error without extracting a value: `Ok {}` if live, `Err` if
  ## this foreign errored. Use it to check a fire-and-forget call, or to probe
  ## presence (`.key{}.ok{}` tells a missing entry from a real one).
  ok     = { it } ->
    perform Runtime in Polyglot.check { on = it },
  ## True iff a member of this name is readable — `hasattr`, without a read.
  has    = { it, name } ->
    perform Runtime in Polyglot.has_member { on = it, name = name },
  ## Length — array elements or mapping entries (the guest's `len`).
  len    = { it } ->
    perform Runtime in Polyglot.size { on = it },
  ## Drain any iterable into a Mezze seq of Foreigns in ONE crossing.
  to_seq  = { it } ->
    perform Runtime in Polyglot.to_seq { on = it },
  ## Bulk-drain a NUMERIC array/iterable to a Mezze `[Int]` / `[Float]` in ONE
  ## crossing (the element loop AND coercion stay host-side). THE bulk path for
  ## numeric data — prefer over a per-element `at{}` + `int{}` chain, which costs
  ## one boundary hit per element.
  to_ints   = { it } -> perform Runtime in Polyglot.to_int_seq   { on = it },
  to_floats = { it } -> perform Runtime in Polyglot.to_float_seq { on = it },
  ## Bulk-drain a STRING / BOOLEAN array to a Mezze `[Str]` / `[Bool]` in ONE crossing.
  to_strs   = { it } -> perform Runtime in Polyglot.to_str_seq   { on = it },
  to_bools  = { it } -> perform Runtime in Polyglot.to_bool_seq  { on = it },
  ## Coerce a numeric Foreign to Int.
  int       = { it } -> perform Runtime in Polyglot.as_int    { on = it },
  ## Coerce a numeric Foreign to Float.
  float     = { it } -> perform Runtime in Polyglot.as_float  { on = it },
  ## Coerce a string Foreign to Str.
  str       = { it } -> perform Runtime in Polyglot.as_str    { on = it },
  ## Coerce a boolean Foreign to Bool.
  bool      = { it } -> perform Runtime in Polyglot.as_bool   { on = it },
  ## True iff this Foreign is the guest-language null (`Ok True`); `Err` if the
  ## foreign is itself a carried error.
  is_null   = { it } -> perform Runtime in Polyglot.is_null   { on = it },
  ## Meta name of the underlying guest type (`type(x).__name__`).
  type_name = { it } -> perform Runtime in Polyglot.type_name { on = it },
}

## Constructors — lift a Mezze primitive into a JvmForeign so it can be passed as
## an argument to `.method{}` / `.new{}` / `.call{}`. These box a pure Mezze value —
## no guest interaction — so they call the box native directly (JVM is first-party
## stdlib) and stay PURE, usable at module top level. A caller writes
## `from_int { val = 5 }`, never a `lang` string. For containers and records,
## prefer the codec (`x.to_jvm {}`).
pub let from_int:   { val: Int   } -> JvmForeign = { val } ->
  __native_polyglot_box_int   { val = val, lang = "jvm" }
pub let from_float: { val: Float } -> JvmForeign = { val } ->
  __native_polyglot_box_float { val = val, lang = "jvm" }
pub let from_str:   { val: Str   } -> JvmForeign = { val } ->
  __native_polyglot_box_str   { val = val, lang = "jvm" }
pub let from_bool:  { val: Bool  } -> JvmForeign = { val } ->
  __native_polyglot_box_bool  { val = val, lang = "jvm" }
pub let null_val:   {}            -> JvmForeign = {} ->
  __native_polyglot_box_null  { lang = "jvm" }

## Build a Java-visible list from already-wrapped Foreign elements — an interop
## view over the elements, not a copy. Backs a codec's `encode_sequence`.
pub let jvm_list: { elems: [JvmForeign] } -> JvmForeign = { elems } ->
  __native_polyglot_box_list { elems = elems, lang = "jvm" }

## Bulk numeric WRITE: box a whole `[Int]` / `[Float]` into a Java-visible array in
## ONE crossing — no per-element `from_int`. Companion to `jvm_list` for numeric
## data; the raw scalars cross directly.
pub let jvm_ints:   { vals: [Int] }   -> JvmForeign = { vals } ->
  __native_polyglot_box_int_seq   { vals = vals, lang = "jvm" }
pub let jvm_floats: { vals: [Float] } -> JvmForeign = { vals } ->
  __native_polyglot_box_float_seq { vals = vals, lang = "jvm" }
pub let jvm_strs:   { vals: [Str] }   -> JvmForeign = { vals } ->
  __native_polyglot_box_str_seq   { vals = vals, lang = "jvm" }
pub let jvm_bools:  { vals: [Bool] }  -> JvmForeign = { vals } ->
  __native_polyglot_box_bool_seq  { vals = vals, lang = "jvm" }

## Build a Java-visible mapping from parallel key and value sequences. Companion
## to `jvm_list`, backing a codec's `encode_mapping` / `encode_record`. Keys keep the
## order they were given in.
pub let jvm_dict: { keys: [JvmForeign], vals: [JvmForeign] } -> JvmForeign = { keys, vals } ->
  __native_polyglot_box_dict { keys = keys, vals = vals, lang = "jvm" }

## Convenience: look up a host class outside a `perform Jvm` scope — uses the
## enclosing Env's host-lookup permissions directly. Yields an errored JvmForeign
## on a miss, like `Jvm.class`.
pub let class: { name: Str } -> JvmForeign = { name } ->
  __native_jvm_class { name = name }

## ─────────────────────────────────────────────────────────────────────
## JVM codec — encode any Mezze value to a JvmForeign and back (`x.to_jvm {}`,
## `Type.from_jvm {}`). Lives here so all JVM interop is one import.
## ─────────────────────────────────────────────────────────────────────

## Config for the JVM codec. Empty knobs — every JVM Foreign has one
## natural representation. Kept as a record for future extension
## (name-transform, wrap-primitives-as-boxed, etc.).
pub type JvmC = {
  shared: SharedConfig,
}

## Default JVM codec — identity field-name transform.
pub let jvm_default: JvmC = { shared = default_shared }

## Format link

impl Format for JvmC having 'out = JvmForeign where {
}

## Tier 2: encode

impl EncodeScalar for JvmC having 'out = JvmForeign where {
  encode_int   = { it, val, ctx } -> from_int   { val = val },
  encode_float = { it, val, ctx } -> from_float { val = val },
  encode_str   = { it, val, ctx } -> from_str   { val = val },
  encode_bool  = { it, val, ctx } -> from_bool  { val = val },
  encode_frac  = { it, val, ctx } -> from_float { val = __native_frac_to_float { n = val } },
  encode_bytes = { it, val, ctx } -> from_str   { val = "" },
  encode_char  = { it, val, ctx } -> from_str   { val = char::to_str { c = val } },
  encode_nat   = { it, val, ctx } -> from_int   { val = nat::to_int { n = val } },
}

impl EncodeOption for JvmC having 'out = JvmForeign where {
  encode_option = { it, val, ctx } -> match val is
    Some { val = v } -> v
    None -> null_val {},
}

## Tier 2: encode, container shapes
##
## These used to be absent, on the reasoning that a Foreign "doesn't naturally
## carry those shapes without a specific Java container choice (ArrayList vs
## LinkedList vs int[], HashMap vs LinkedHashMap, …)". That dilemma is gone:
## `jvm_list` / `jvm_dict` do not pick a Java class at all. They build an
## interop VIEW over the already-encoded elements, which the guest reads on
## demand — so there is no container to choose, and no copy to pay for.
##
## The cost of not having them was not just an unsupported shape, it was a slow
## one: with no `EncodeSequence`, `[1, 2, 3].to_jvm {}` failed to auto-derive, and
## the only way to hand a guest a sequence was to PRINT IT INTO GUEST SOURCE and
## have the guest parse it back — O(n) string building plus an O(n) parse, about
## 19 us fixed and 0.085 us per element (bench/cases/polyglot_seq_crossing).
## Through the view it is O(1): nothing is converted until the guest asks.

impl EncodeSequence for JvmC having 'out = JvmForeign where {
  encode_sequence = { it, elems, ctx } -> jvm_list { elems = elems },
}

## BULK scalar-sequence fast path (optional Tier-2): box a whole `[Int]`/`[Float]`/
## `[Str]`/`[Bool]` into a guest array in ONE crossing, instead of boxing each
## element and building a list. The auto-derived `Encode JvmC [Int]` routes here
## when this impl is present; other element types stay on `EncodeSequence`.
impl EncodeScalarSequence for JvmC having 'out = JvmForeign where {
  encode_int_seq   = { it, vals, ctx } -> jvm_ints   { vals = vals },
  encode_float_seq = { it, vals, ctx } -> jvm_floats { vals = vals },
  encode_str_seq   = { it, vals, ctx } -> jvm_strs   { vals = vals },
  encode_bool_seq  = { it, vals, ctx } -> jvm_bools  { vals = vals },
}

impl EncodeMapping for JvmC having 'out = JvmForeign where {
  encode_mapping = { it, entries, ctx } -> jvm_dict {
    keys = seq::map { xs = entries, f = { x } -> x.key },
    vals = seq::map { xs = entries, f = { x } -> x.value },
  },
}

## A record becomes a dict keyed by FIELD NAME. The walker hands the keys over
## as `Str` rather than as `'out`, so unlike the values they are encoded here.
impl EncodeRecord for JvmC having 'out = JvmForeign where {
  encode_record = { it, fields, ctx } -> jvm_dict {
    keys = seq::map { xs = fields, f = { x } -> from_str { val = x.key } },
    vals = seq::map { xs = fields, f = { x } -> x.value },
  },
}

## A variant becomes `{ tag }` or `{ tag, value }` — the same two-key shape the
## JSON codec uses, so a value that crosses as JSON and a value that crosses as
## a Foreign agree on where the tag lives.
impl EncodeVariant for JvmC having 'out = JvmForeign where {
  encode_variant = { it, tag, payload, ctx } -> match payload is
    Some { val = p } -> jvm_dict {
      keys = [from_str { val = "tag" }, from_str { val = "value" }],
      vals = [from_str { val = tag }, p],
    }
    None -> jvm_dict {
      keys = [from_str { val = "tag" }],
      vals = [from_str { val = tag }],
    },
}

## Tier 2: decode

## The guest type name for an error message, or "foreign" if the value is itself
## an errored foreign. `f` is concretely `JvmForeign`, so `type_name` dispatches
## statically and the `match` avoids chaining on the `Result` crossing.
let type_name_or: { f: JvmForeign } -> Str = { f } -> match f.type_name {} is
  Ok  { val = n }   -> n
  Err { error = _ } -> "foreign"

impl DecodeScalar for JvmC having 'in = JvmForeign where {
  decode_int = { it, val, ctx } -> match val.int{} is
    Ok { val = n } -> Ok { val = n }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Int",
      expected = "Int",
      found = Some { val = type_name_or { f = val } },
    },
  decode_float = { it, val, ctx } -> match val.float{} is
    Ok { val = n } -> Ok { val = n }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Float",
      expected = "Float",
      found = Some { val = type_name_or { f = val } },
    },
  decode_str = { it, val, ctx } -> match val.str{} is
    Ok { val = s } -> Ok { val = s }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Str",
      expected = "Str",
      found = Some { val = type_name_or { f = val } },
    },
  decode_bool = { it, val, ctx } -> match val.bool{} is
    Ok { val = b } -> Ok { val = b }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Bool",
      expected = "Bool",
      found = Some { val = type_name_or { f = val } },
    },
  decode_frac = { it, val, ctx } -> match val.float{} is
    Ok { val = f } -> Ok { val = __native_float_to_frac { f = f } }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Frac",
      expected = "Frac",
      found = Some { val = type_name_or { f = val } },
    },
  decode_bytes = { it, val, ctx } -> decode_error {
    path = ctx.path,
    message = "Bytes not supported by JvmC decoder",
    expected = "Bytes",
    found = Some { val = type_name_or { f = val } },
  },
  decode_char = { it, val, ctx } -> match val.str{} is
    Ok { val = s } -> match char::from_str { s = s } is
      Some { val = c } -> Ok { val = c }
      None -> decode_error {
        path = ctx.path,
        message = "Expected single-character Foreign",
        expected = "Char",
        found = Some { val = s },
      }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Char",
      expected = "Char",
      found = Some { val = type_name_or { f = val } },
    },
  decode_nat = { it, val, ctx } -> match val.int{} is
    Ok { val = n } -> match nat::from_int { n = n } is
      Some { val = k } -> Ok { val = k }
      None -> decode_error {
        path = ctx.path,
        message = "Expected non-negative integer",
        expected = "Nat",
        found = Some { val = "negative integer" },
      }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected Foreign coercible to Nat",
      expected = "Nat",
      found = Some { val = type_name_or { f = val } },
    },
}

impl DecodeOption for JvmC having 'in = JvmForeign where {
  decode_option = { it, val, ctx } ->
    # is_null is a crossing (Result Bool); an errored foreign reads as non-null so
    # the carried error surfaces when the inner value is decoded. `match` avoids
    # chaining `get_or` on the Result crossing.
    match val.is_null {} is
      Ok  { val = True }  -> Ok { val = None }
      Ok  { val = False } -> Ok { val = Some { val = val } }
      Err { error = _ }   -> Ok { val = Some { val = val } },
}

## Tier 2: decode, container shapes
##
## The mirror of the four encode impls above. Note the asymmetry in what they
## read: a list is ARRAY-shaped and a dict is HASH-shaped, and interop models
## those separately — a dict is not reachable through `get_member`, which is why
## the record and map decoders go through `key` / `entries` rather than
## the member vocabulary the rest of this file uses.

## One `[key, value]` pair Foreign, as the entry shape `decode_mapping` returns.
## The pair itself is a two-element array, so it crosses in one read.
let pair_entry_of: { p: JvmForeign } -> Option { key: JvmForeign, value: JvmForeign } =
  { p } -> match p.to_seq {} is
    Ok { val = kv } -> match seq::get { xs = kv, i = 0 } is
      Some { val = k } -> match seq::get { xs = kv, i = 1 } is
        Some { val = v } -> Some { val = { key = k, value = v } }
        None -> None
      None -> None
    Err { error = _ } -> None

## Every pair, or None if any one is malformed — a half-read map is worse than a
## reported failure.
let read_pairs:
  { pairs: [JvmForeign], idx: Int, acc: [{ key: JvmForeign, value: JvmForeign }] }
  -> Option [{ key: JvmForeign, value: JvmForeign }] =
  { pairs, idx, acc } ->
    if idx >= seq::size { xs = pairs } then Some { val = acc }
    else match seq::get { xs = pairs, i = idx } is
      Some { val = p } -> match pair_entry_of { p = p } is
        Some { val = entry } ->
          read_pairs { pairs = pairs, idx = idx + 1, acc = seq::add { xs = acc, x = entry } }
        None -> None
      None -> None

## The whole array crosses in ONE call rather than one per element — see
## `to_seq`. The old index walk cost a native call and a `Result` per
## element while `jvm_list` sends a seq the other way in O(1).
impl DecodeSequence for JvmC having 'in = JvmForeign where {
  decode_sequence = { it, val, ctx } -> match val.to_seq {} is
    Ok { val = es } -> Ok { val = es }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected an array-shaped Foreign",
      expected = "List",
      found = Some { val = type_name_or { f = val } },
    },
}

## BULK scalar-sequence fast path (optional Tier-2): drain + coerce a whole numeric /
## string / boolean guest array to a Mezze `[Int]`/`[Float]`/`[Str]`/`[Bool]` in ONE
## crossing (the element loop + coercion stay host-side). The auto-derived
## `Decode JvmC [Int]` routes here when present; other element types stay on
## `DecodeSequence` + per-element `DecodeScalar`.
impl DecodeScalarSequence for JvmC having 'in = JvmForeign where {
  decode_int_seq = { it, val, ctx } -> match val.to_ints {} is
    Ok { val = xs } -> Ok { val = xs }
    Err { error = _ } -> decode_error {
      path = ctx.path, message = "Expected an array of Int-coercible Foreigns",
      expected = "[Int]", found = Some { val = type_name_or { f = val } },
    },
  decode_float_seq = { it, val, ctx } -> match val.to_floats {} is
    Ok { val = xs } -> Ok { val = xs }
    Err { error = _ } -> decode_error {
      path = ctx.path, message = "Expected an array of Float-coercible Foreigns",
      expected = "[Float]", found = Some { val = type_name_or { f = val } },
    },
  decode_str_seq = { it, val, ctx } -> match val.to_strs {} is
    Ok { val = xs } -> Ok { val = xs }
    Err { error = _ } -> decode_error {
      path = ctx.path, message = "Expected an array of Str-coercible Foreigns",
      expected = "[Str]", found = Some { val = type_name_or { f = val } },
    },
  decode_bool_seq = { it, val, ctx } -> match val.to_bools {} is
    Ok { val = xs } -> Ok { val = xs }
    Err { error = _ } -> decode_error {
      path = ctx.path, message = "Expected an array of Bool-coercible Foreigns",
      expected = "[Bool]", found = Some { val = type_name_or { f = val } },
    },
}

impl DecodeMapping for JvmC having 'in = JvmForeign where {
  # `entries` yields a (list-shaped) FOREIGN; `to_seq` is the crossing that yields
  # a Result — an errored `entries` (not hash-shaped) surfaces as Err here.
  decode_mapping = { it, val, ctx } -> match val.entries {}.to_seq {} is
    Ok { val = pairs } -> match read_pairs { pairs = pairs, idx = 0, acc = [] } is
      Some { val = es } -> Ok { val = es }
      None -> decode_error {
        path = ctx.path,
        message = "Expected every map entry to be a two-element key/value pair",
        expected = "Map",
        found = Some { val = type_name_or { f = val } },
      }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected a hash-shaped Foreign",
      expected = "Map",
      found = Some { val = type_name_or { f = val } },
    },
}

impl DecodeRecord for JvmC having 'in = JvmForeign where {
  # `key` yields a FOREIGN (errored if the field is absent); `.ok{}` probes it so a
  # missing field is a clean decode_error rather than surfacing later.
  decode_record_field = { it, val, key, ctx } ->
    match val.key { of = key }.ok {} is
      Ok  { val = _ } -> Ok { val = val.key { of = key } }
      Err { error = _ } -> decode_error {
        path = ctx.path,
        message = "Missing field: $(key)",
        expected = key,
        found = None,
      },
}

## Reads back the `{ tag }` / `{ tag, value }` shape `encode_variant` writes.
## A missing `value` is a payload-free constructor, not an error — that is the
## only reading available, since the two are encoded as exactly that difference.
impl DecodeVariant for JvmC having 'in = JvmForeign where {
  # `key` yields a FOREIGN. The tag is read then crossed with `.str{}`; the optional
  # `value` entry's presence is probed with `.ok{}` (absent → payload-free ctor).
  decode_variant = { it, val, ctx } -> match val.key { of = "tag" }.str {} is
    Ok { val = tag } -> match val.key { of = "value" }.ok {} is
      Ok  { val = _ } -> Ok { val = { tag = tag, payload = Some { val = val.key { of = "value" } } } }
      Err { error = _ } -> Ok { val = { tag = tag, payload = None } }
    Err { error = _ } -> decode_error {
      path = ctx.path,
      message = "Expected a Foreign with a string 'tag' entry",
      expected = "Variant",
      found = Some { val = type_name_or { f = val } },
    },
}

## Tier 4: sugar abilities + blankets

## Encode any scalar-shaped value to a `JvmForeign` via `.to_jvm{}`.
ability ToJvm for 'a where {
  to_jvm:      { it: 'a }               -> JvmForeign,
  to_jvm_with: { it: 'a, config: JvmC } -> JvmForeign,
}

impl ToJvm for 'a where {
  to_jvm:      { it: 'a }               with Encode JvmC 'a -> JvmForeign = { it }         -> it.encode { config = jvm_default },
  to_jvm_with: { it: 'a, config: JvmC } with Encode JvmC 'a -> JvmForeign = { it, config } -> it.encode { config = config },
}

## Decode a target type from a `JvmForeign` via `Type.from_jvm{}`.
ability FromJvm 'a for 'in where {
  from_jvm:      { it: 'in }                -> Result 'a DecodeError,
  from_jvm_with: { it: 'in, config: JvmC }  -> Result 'a DecodeError,
}

impl FromJvm 'a for JvmForeign where {
  from_jvm:      { it: JvmForeign }                with Decode JvmC 'a -> Result 'a DecodeError = { it }         -> it.decode { config = jvm_default },
  from_jvm_with: { it: JvmForeign, config: JvmC }  with Decode JvmC 'a -> Result 'a DecodeError = { it, config } -> it.decode { config = config },
}
