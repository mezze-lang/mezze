# Polyglot interop — shared kernel.
#
# The polyglot layer bridges Mezze values to guest-language objects via the
# Truffle InteropLibrary. It is split into two layers:
#
#   1. `Polyglot` (this module) — the raw, language-agnostic capability. Its
#      ops are the interop primitives (member read/write, call/invoke/construct,
#      array/hash access, the coercions, guest `eval`, value boxing), and its
#      SOLE handler `Runtime` is the ONLY thing in the whole system that calls a
#      `__native_*`. `Polyglot` is a *gated* capability: an op is reachable only
#      where `Runtime` is performed, so raw interop is never ambient authority.
#      This layer is first-party (stdlib) only.
#
#   2. A per-language effect (`Jvm`, and out-of-tree `Py`/`Js`/… providers) —
#      the idiomatic, typed surface a user actually calls. Each language handler
#      delegates DOWN to `Polyglot` via `perform Runtime in Polyglot.<op> …`, so
#      the language layer writes NO natives and the user performs only the
#      language handler (`Runtime` stays buried inside it).
#
# This is what lets a third party add any GraalVM language (Ruby, R, …) in pure
# Mezze, in their own repo, with no Java: they define a `<Lang>Foreign` newtype
# (type-safe against mixing foreigns) and a small effect whose handler performs
# `Polyglot` ops. Only this repo ever writes `__native_*`.
#
# The polyglot Context is managed inside the runtime by the effect handler
# machinery — user code never sees the underlying Truffle Context.
use std::result
use std::collections::bytes

## The opaque guest-object handle every language's foreign wraps. This is the
## PUBLIC face of the runtime's native foreign primitive — the one name a provider
## may newtype over (`pub newtype PyForeign = Foreign`), so the internal
## `__NativeForeign` primitive stays sealed inside this module exactly like the
## `__native_*` calls do. All `<Lang>Foreign` newtypes share this representation,
## so per-language tagging is a compile-time distinction with zero runtime cost.
pub type Foreign = __NativeForeign

## Errors returned by every fallible interop operation.
##
## - NotFound       — the requested member / binding does not exist.
## - TypeError      — the guest value did not accept the requested op.
## - GuestError     — the guest language raised an exception; message
##                    and stack are propagated verbatim.
## - ArityMismatch  — execute/invoke arg count mismatched the target.
## - UnsupportedMessage — the underlying Truffle message is not
##                    supported by the receiver.
pub type InteropError = |
  NotFound { name: Str },
  TypeError { message: Str },
  GuestError { message: Str, guest_stack: Str },
  ArityMismatch { expected: Int, actual: Int },
  UnsupportedMessage,
|

## The low-level polyglot capability effect. For polyglot LIBRARY implementers
## only — end users go through a per-language effect (`Jvm`, `Py`, `Js`, …) whose
## handler delegates here. The foreign type is the associated type `'f` (like
## `Exception having 'error`), so a per-language newtype (`JvmForeign`,
## `PyForeign`, …) threads through unchanged and stays type-safe. Only `Runtime`
## (below) calls the natives — nothing else in the system does.
##
## The error-carrying-foreign model. A foreign `'f` is a "try": either a live guest
## handle or a carried `InteropError`. Ops split by WHAT THEY YIELD:
##   - a FOREIGN → return `'f` directly (no `Result`). An errored `'f` short-circuits
##     the op untouched, and a guest throw is caught INTO an errored `'f`. So a chain
##     `a.get{}.method{}` never allocates a `Result` between steps.
##   - a MEZZE VALUE (a coercion, `is_null`, `type_name`, `size`, `to_seq`, `read_bytes`,
##     `has_member`) → return `Result … InteropError`. This is the ONE crossing where a
##     carried error finally becomes a Mezze `Result`.
## Producers (`eval_raw`, `eval_bytes`, `box_*`) also yield a foreign → `'f`.
effect Polyglot having 'f where {
  ## ---- value ops: yield a foreign (error-carrying, no Result) ----
  read_member:   { on: 'f, name: Str }              -> 'f <Polyglot>,
  write_member:  { on: 'f, name: Str, val: 'f }     -> 'f <Polyglot>,
  invoke_member: { on: 'f, name: Str, args: ['f] }  -> 'f <Polyglot>,
  execute:       { on: 'f, args: ['f] }             -> 'f <Polyglot>,
  instantiate:   { on: 'f, args: ['f] }             -> 'f <Polyglot>,
  read_array:    { on: 'f, index: Int }             -> 'f <Polyglot>,
  write_array:   { on: 'f, index: Int, val: 'f }    -> 'f <Polyglot>,
  # hash `key` is a per-op free var `'k`, not `'f` — a mapping key may be a Foreign
  # OR a bare Mezze value (a codec passes a Str field name); the native unwraps a
  # Foreign and passes a bare value through unchanged.
  read_hash:     { on: 'f, key: 'k }                -> 'f <Polyglot>,
  write_hash:    { on: 'f, key: 'k, val: 'f }       -> 'f <Polyglot>,
  hash_entries:  { on: 'f }                         -> 'f <Polyglot>,

  ## ---- crossings: yield a Mezze value → Result (error surfaces HERE) ----
  has_member:    { on: 'f, name: Str }              -> Result Bool InteropError <Polyglot>,
  size:          { on: 'f }                         -> Result Int InteropError <Polyglot>,
  to_seq:        { on: 'f }                         -> Result ['f] InteropError <Polyglot>,
  ## Bulk drain + coerce: a whole guest numeric array/iterable → `[Int]` / `[Float]`
  ## in ONE crossing — the element loop AND the scalar coercion stay host-side, so N
  ## numbers cost one boundary hit, not N. THE bulk path for numeric data; prefer it
  ## over element-by-element `read_array` + `as_int`/`as_float`.
  to_int_seq:    { on: 'f }                         -> Result [Int] InteropError <Polyglot>,
  to_float_seq:  { on: 'f }                         -> Result [Float] InteropError <Polyglot>,
  as_int:        { on: 'f }                         -> Result Int InteropError <Polyglot>,
  as_float:      { on: 'f }                         -> Result Float InteropError <Polyglot>,
  as_str:        { on: 'f }                         -> Result Str InteropError <Polyglot>,
  as_bool:       { on: 'f }                         -> Result Bool InteropError <Polyglot>,
  is_null:       { on: 'f }                         -> Result Bool InteropError <Polyglot>,
  type_name:     { on: 'f }                         -> Result Str InteropError <Polyglot>,
  read_bytes:    { on: 'f, offset: Int, length: Int } -> Result Bytes InteropError <Polyglot>,
  ## Surface an errored foreign WITHOUT extracting a value — `Ok {}` if live, `Err`
  ## if it carries an error. Backs `.ok{}` (the fire-and-forget check) and a codec's
  ## presence probe (missing field / absent payload vs a real one).
  check:         { on: 'f }                         -> Result {} InteropError <Polyglot>,

  ## ---- producers: mint a foreign in language `lang` (error-carrying) ----
  ## ENTRY ONLY. `eval_raw` gets your FIRST foreign — import a module or fetch a
  ## function, ONCE. It is NOT the working API and must never sit in a hot loop: it
  ## re-runs (and rebuilds) the whole source every call. Once you hold a foreign, use
  ## the object API (read_member / invoke_member / execute) to call it, and the CODEC
  ## (`to_<lang>` / `from_<lang>`) to move DATA across in one crossing — never eval a
  ## data string, never cross element-by-element.
  eval_raw:      { lang: Str, source: Str }         -> 'f <Polyglot>,
  ## Binary module eval (wasm, …) — a source string cannot express a wasm module.
  eval_bytes:    { lang: Str, bytes: Bytes, name: Str } -> 'f <Polyglot>,
  ## Bulk write into a guest byte-buffer; fluent — yields the receiver foreign.
  write_bytes:   { on: 'f, offset: Int, bytes: Bytes } -> 'f <Polyglot>,
  ## 32-bit-typed int (wasm i32 ABI); the generic i64 form is `box_int`.
  box_i32:       { val: Int, lang: Str }            -> 'f <Polyglot>,
  box_int:       { val: Int, lang: Str }            -> 'f <Polyglot>,
  box_float:     { val: Float, lang: Str }          -> 'f <Polyglot>,
  box_str:       { val: Str, lang: Str }            -> 'f <Polyglot>,
  box_bool:      { val: Bool, lang: Str }           -> 'f <Polyglot>,
  box_null:      { lang: Str }                      -> 'f <Polyglot>,
  box_list:      { elems: ['f], lang: Str }         -> 'f <Polyglot>,
  box_dict:      { keys: ['f], vals: ['f], lang: Str } -> 'f <Polyglot>,
  ## Bulk numeric WRITE: a whole `[Int]`/`[Float]` → a guest array in ONE crossing
  ## (counterpart of `to_int_seq`/`to_float_seq`). Skips the N per-element `box_int`/
  ## `box_float` crossings a `box_list` of wrapped foreigns would cost.
  box_int_seq:   { vals: [Int], lang: Str }         -> 'f <Polyglot>,
  box_float_seq: { vals: [Float], lang: Str }       -> 'f <Polyglot>,

  ## ---- sandboxed inner contexts ----
  # Open a configured INNER context (isolated globals + access restricted BELOW the
  # permissive parent). Yields a foreign HANDLE (error-carrying). `config` is a
  # structural record of the Context.Builder sandbox knobs — a `GraalXWith` handler
  # builds it from its own defaults. `eval_in` runs a scalar in the context and
  # crosses the result back as a Str; `close_context` tears it down at scope end.
  open_context:  { lang: Str, config: { allow_io: Bool, allow_native: Bool, allow_create_thread: Bool, allow_create_process: Bool, allow_host_class_loading: Bool, allow_host_lookup: Bool, allow_polyglot_access: Bool } } -> 'f <Polyglot>,
  eval_in:       { ctx: 'f, source: Str }           -> Result Str InteropError <Polyglot>,
  close_context: { ctx: 'f }                         -> Result {} InteropError <Polyglot>,
}

## The sole handler of `Polyglot`, and the sole caller of `__native_*`. Binds the
## associated foreign type to a fresh var — generic over any foreign, exactly as
## `impl Exception for … having 'error = 'e`. A language provider never writes any
## of these lines; it performs the ops above through this handler. The handler
## type is introduced by the impl itself — no separate `type` declaration.
impl Polyglot for Runtime having 'f = 'g where {
  read_member   = { on, name }       -> __native_polyglot_read_member   { val = on, name = name },
  write_member  = { on, name, val }  -> __native_polyglot_write_member  { val = on, name = name, new_val = val },
  has_member    = { on, name }       -> __native_polyglot_has_member    { val = on, name = name },
  invoke_member = { on, name, args } -> __native_polyglot_invoke_member { val = on, name = name, args = args },
  execute       = { on, args }       -> __native_polyglot_execute       { val = on, args = args },
  instantiate   = { on, args }       -> __native_polyglot_instantiate   { val = on, args = args },
  read_array    = { on, index }      -> __native_polyglot_read_array    { val = on, index = index },
  write_array   = { on, index, val } -> __native_polyglot_write_array   { val = on, index = index, new_val = val },
  read_hash     = { on, key }        -> __native_polyglot_read_hash     { val = on, key = key },
  write_hash    = { on, key, val }   -> __native_polyglot_write_hash    { val = on, key = key, new_val = val },
  hash_entries  = { on }             -> __native_polyglot_hash_entries  { val = on },
  size          = { on }             -> __native_polyglot_size          { val = on },
  to_seq        = { on }             -> __native_polyglot_to_seq        { val = on },
  to_int_seq    = { on }             -> __native_polyglot_to_int_seq    { val = on },
  to_float_seq  = { on }             -> __native_polyglot_to_float_seq  { val = on },
  as_int        = { on }             -> __native_polyglot_as_long       { val = on },
  as_float      = { on }             -> __native_polyglot_as_double     { val = on },
  as_str        = { on }             -> __native_polyglot_as_string     { val = on },
  as_bool       = { on }             -> __native_polyglot_as_boolean    { val = on },
  is_null       = { on }             -> __native_polyglot_is_null       { val = on },
  type_name     = { on }             -> __native_polyglot_type_name     { val = on },
  check         = { on }             -> __native_polyglot_check         { val = on },

  eval_raw      = { lang, source }   -> __native_polyglot_eval          { lang = lang, source = source },
  eval_bytes    = { lang, bytes, name } -> __native_polyglot_eval_bytes { lang = lang, bytes = bytes, name = name },
  read_bytes    = { on, offset, length } -> __native_polyglot_read_bytes { val = on, offset = offset, length = length },
  write_bytes   = { on, offset, bytes } -> __native_polyglot_write_bytes { val = on, offset = offset, bytes = bytes },
  box_i32       = { val, lang }      -> __native_polyglot_box_i32       { val = val, lang = lang },
  box_int       = { val, lang }      -> __native_polyglot_box_int       { val = val, lang = lang },
  box_float     = { val, lang }      -> __native_polyglot_box_float     { val = val, lang = lang },
  box_str       = { val, lang }      -> __native_polyglot_box_str       { val = val, lang = lang },
  box_bool      = { val, lang }      -> __native_polyglot_box_bool      { val = val, lang = lang },
  box_null      = { lang }           -> __native_polyglot_box_null      { lang = lang },
  box_list      = { elems, lang }    -> __native_polyglot_box_list      { elems = elems, lang = lang },
  box_dict      = { keys, vals, lang } -> __native_polyglot_box_dict    { keys = keys, vals = vals, lang = lang },
  box_int_seq   = { vals, lang }     -> __native_polyglot_box_int_seq   { vals = vals, lang = lang },
  box_float_seq = { vals, lang }     -> __native_polyglot_box_float_seq { vals = vals, lang = lang },

  open_context  = { lang, config } -> __native_polyglot_open_context {
    lang = lang, allow_io = config.allow_io, allow_native = config.allow_native,
    allow_create_thread = config.allow_create_thread, allow_create_process = config.allow_create_process,
    allow_host_class_loading = config.allow_host_class_loading, allow_host_lookup = config.allow_host_lookup,
    allow_polyglot_access = config.allow_polyglot_access },
  eval_in       = { ctx, source } -> __native_polyglot_eval_in    { val = ctx, source = source },
  close_context = { ctx }         -> __native_polyglot_close_context { val = ctx },
}

## Lift an error-carrying PRODUCER foreign into a Mezze `Result`: `Ok { val }` for a
## live handle, `Err { error }` for one that carries an interop error. This is the
## ONE place a producer's foreign (`eval_raw` / `eval_bytes` / an `execute` result)
## becomes a `Result` — a typed language entry point (`Js.eval`, `Python.import`, …)
## calls it ONCE at entry, then the object API keeps chaining on the bare foreign.
## Without it, an entry point returning `eval_raw`'s bare foreign under a `Result`
## signature hands callers a non-variant that `match … is Ok/Err` cannot destructure.
pub let lift: { on: 'f } -> Result 'f InteropError <Polyglot> = { on } ->
  match Polyglot.check { on = on } is
    Ok  { val = _ }   -> Ok { val = on }
    Err { error = e } -> Err { error = e }
