# WebAssembly host-language access (GraalWasm).
#
# WebAssembly's interop model is deliberately narrow: a wasm module is
# a compiled binary blob with named function/memory/global/table
# exports, and every value crossing the boundary is a numeric primitive
# (i32, i64, f32, f64). There is no source-level `eval`, no OOP, no
# per-object methods — everything is a top-level export.
#
# The Mezze surface mirrors that shape: `perform GraalWasm in do ...`
# yields `Wasm.load_module` / `Wasm.load_file`, which return a
# `WasmForeign` wrapping the compiled module instance. From there the
# inherent methods on `WasmForeign` give you `get_export`, `call`,
# `call_export`, and byte-oriented linear-memory access.
#
# Because wasm cannot represent strings/records/lists/variants natively,
# the codec surface (`std::codec::wasm`) is limited to scalar numeric
# encode/decode — records / collections must be marshalled by the caller
# through linear memory using the memory_read / memory_write primitives.
use std::polyglot::core::{ InteropError }

## Opaque handle to a wasm module instance or exported value (function,
## memory, global). Runtime: the same `MezzeForeign` Java class every
## language uses; the newtype gives Mezze-level type safety against
## mixing wasm and non-wasm Foreigns.
pub newtype WasmForeign = __NativeForeign

## WebAssembly host effect. Two module-loading paths are exposed:
## `load_module` accepts a raw byte buffer (the caller compiled or
## fetched the wasm binary themselves), and `load_file` reads from
## the local filesystem via the Context's IO policy. Both return the
## compiled module instance — its exports are reachable via
## `get_export` / `call_export`.
effect Wasm where {
  load_module: { bytes: Bytes, name: Str } -> Result WasmForeign InteropError <Wasm>,
  load_file:   { path: Str,   name: Str } -> Result WasmForeign InteropError <Wasm>,
}

## Default WebAssembly host — routes all ops through the ambient
## Truffle Env's GraalWasm interpreter. Zero-field: the polyglot
## Context is managed by the runtime from `Mezze.toml [polyglot.wasm]`;
## the handler carries no user-visible configuration.
pub type GraalWasm = {}

impl Wasm for GraalWasm where {
  load_module = { bytes, name } -> __native_wasm_load_module { bytes = bytes, name = name },
  load_file   = { path,  name } -> __native_wasm_load_file   { path  = path,  name = name },
}

## Inherent methods on WasmForeign — the wasm-idiomatic vocabulary
## plus the small universal InteropLibrary surface that makes sense
## for wasm (numeric coercion + null / type inspection). Every op
## routes through the same `__native_polyglot_*` / `__native_wasm_*`
## natives every language shares.
impl WasmForeign where {
  ## ---- Exports ----

  ## Look up an exported function / memory / global by name.
  ## Returns the export itself as a `WasmForeign` — a function is
  ## executable via `.call{}`, memory is byte-addressable via
  ## `.memory_read{}` / `.memory_write{}`, a global is a numeric
  ## coercible via `.as_int{}` / `.as_float{}`.
  get_export = { it, name } ->
    __native_wasm_get_export { val = it, name = name },

  ## Invoke a callable Foreign (typically an exported function) with
  ## a list of numeric-primitive arguments. Wasm accepts only i32,
  ## i64, f32, f64 — the caller must lift Mezze scalars through
  ## `from_int` / `from_float` before passing.
  call = { it, args } ->
    __native_polyglot_execute { val = it, args = args },

  ## Convenience: look up an export by name AND invoke it in one call.
  ## Fast path for the common case `module.call_export { name = "f", args = [...] }`.
  call_export = { it, name, args } -> match __native_wasm_get_export { val = it, name = name } is
    Ok { val = f } -> __native_polyglot_execute { val = f, args = args }
    Err { error } -> Err { error = error },

  ## ---- Linear memory ----

  ## Read `length` bytes from linear memory starting at `offset`.
  ## The receiver must be the module's memory export (typically
  ## `module.get_export { name = "memory" }`). Errors on out-of-range.
  memory_read = { it, offset, length } ->
    __native_wasm_memory_read { val = it, offset = offset, length = length },

  ## Write a byte buffer into linear memory at `offset`. The receiver
  ## must be a writable memory export. Errors on out-of-range.
  memory_write = { it, offset, bytes } ->
    __native_wasm_memory_write { val = it, offset = offset, bytes = bytes },

  ## Total size (in bytes) of a memory export. Wasm memory grows in
  ## 64 KiB pages; this returns the current byte count, not the page
  ## count.
  memory_size = { it } ->
    __native_wasm_memory_size { val = it },

  ## ---- Universal vocabulary (numeric + null + meta) ----

  ## Coerce a numeric Foreign to Int.
  as_int    = { it } -> __native_polyglot_as_long    { val = it },
  ## Coerce a numeric Foreign to Float.
  as_float  = { it } -> __native_polyglot_as_double  { val = it },
  ## True iff this Foreign is the guest-language null. Wasm has no
  ## native null but the InteropLibrary predicate is universally safe.
  is_null   = { it } -> __native_polyglot_is_null    { val = it },
  ## Debug name of the underlying wasm type (function, memory,
  ## global, table, i32, f64, …).
  type_name = { it } -> __native_polyglot_type_name  { val = it },
}

## Constructors — lift a Mezze numeric primitive into a WasmForeign
## so it can be passed as an argument to `.call{}` / `.call_export{}`.
## Wasm has no native string / bool boundary types, so those
## constructors are deliberately absent — a caller who needs to hand
## structured data to a wasm module writes it into linear memory and
## passes the offset as an Int.
pub let from_int:   { val: Int   } -> WasmForeign = { val } -> __native_wasm_from_int   { val = val }
pub let from_float: { val: Float } -> WasmForeign = { val } -> __native_wasm_from_float { val = val }
