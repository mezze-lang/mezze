# std/core/option.funk - Safe Option type for optional values

# Core Option type definition with correct variant syntax
type Option 'a = | Some { val: 'a }, None |

# === SAFE UTILITY FUNCTIONS ===

# Map a function over the Option value
let map = { opt, f } -> match opt is
    Some { val } -> Some { val = f { val } }
    None -> None

# Get the value or return a default
let get_or_else = { opt, default } -> match opt is
    Some { val } -> val
    None -> default

# Check if Option contains a value
let is_some = { opt } -> match opt is
    Some { val } -> true
    None -> false

# Check if Option is empty
let is_none = { opt } -> match opt is
    Some { val } -> false
    None -> true

# Filter Option based on predicate
let filter = { opt, pred } -> match opt is
    Some { val } -> if (pred { val }) then Some { val = val } else None
    None -> None

# Chain operations that return Options
let flat_map = { opt, f } -> match opt is
    Some { val } -> f { val }
    None -> None

# Return the first Some value, or None if both are None
let or_else = { opt1, opt2 } -> match opt1 is
    Some { val } -> opt1
    None -> opt2

# === COMBINING OPTIONS ===

# Combine two Options with a function
let map2 = { opt_a, opt_b, f } -> match opt_a is
    Some { val = a } -> match opt_b is
        Some { val = b } -> Some { val = f { a = a, b = b } }
        None -> None
    None -> None

# === CONDITIONAL OPERATIONS ===

# Execute an action if Option contains a value
let if_some = { opt, action } -> match opt is
    Some { val } -> action { val }
    None -> {}

# Execute an action if Option is None
let if_none = { opt, action } -> match opt is
    Some { val } -> {}
    None -> action {}

# Execute different actions based on Option state
let fold = { opt, on_none, on_some } -> match opt is
    Some { val } -> on_some { val }
    None -> on_none {}