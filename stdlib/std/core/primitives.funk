# std/core/primitives.funk - Primitive type implementations always imported

# Int implementations (using simplified native functions)
impl NumAdd Int where {
    add: { left: Int, right: Int } -> Int = { left, right } -> add_int { left = left, right = right }
}

impl NumSub Int where {
    subtract: { left: Int, right: Int } -> Int = { left, right } -> subtract_int { left = left, right = right }
}

impl NumMul Int where {
    multiply: { left: Int, right: Int } -> Int = { left, right } -> multiply_int { left = left, right = right }
}

# NumDiv removed for Int to avoid ambiguity with special case operator
# Int division now uses special case that returns Frac

impl NumMod Int where {
    modulo: { left: Int, right: Int } -> Int = { left, right } -> modulo_int { left = left, right = right }
}

impl Eq Int where {
    equals: { left: Int, right: Int } -> Boolean = { left, right } -> equal_int { left = left, right = right }
}

impl Ord Int where {
    compare: { left: Int, right: Int } -> Ordering = { left, right } -> compare_int { left = left, right = right }
    less_than: { left: Int, right: Int } -> Boolean = { left, right } -> less_than_int { left = left, right = right }
    greater_than: { left: Int, right: Int } -> Boolean = { left, right } -> greater_than_int { left = left, right = right }
}

impl Show Int where {
    to_string: { value: Int } -> String = { value } -> __native_int_to_string { value = value }
}

# Float implementations (using hidden native functions)
impl NumAdd Float where {
    add = { left, right } -> __native_float_add { left = left, right = right }
}

impl NumSub Float where {
    subtract = { left, right } -> __native_float_subtract { left = left, right = right }
}

impl NumMul Float where {
    multiply = { left, right } -> __native_float_multiply { left = left, right = right }
}

impl NumDiv Float where {
    divide = { left, right } -> __native_float_divide { left = left, right = right }
}

impl NumMod Float where {
    modulo = { left, right } -> __native_float_modulo { left = left, right = right }
}

impl Eq Float where {
    equals = { left, right } -> __native_float_equals { left = left, right = right }
}

impl Ord Float where {
    compare = { left, right } -> __native_float_compare { left = left, right = right },
    less_than = { left, right } -> __native_float_less_than { left = left, right = right },
    greater_than = { left, right } -> __native_float_greater_than { left = left, right = right }
}

impl Show Float where {
    to_string = { value } -> __native_float_to_string { value = value }
}

# String implementations
impl Eq String where {
    equals = { left, right } -> equal_string { left = left, right = right }
}

impl Ord String where {
    compare = { left, right } -> compare_string { left = left, right = right },
    less_than = { left, right } -> less_than_string { left = left, right = right },
    greater_than = { left, right } -> greater_than_string { left = left, right = right }
}

impl Show String where {
    to_string = { value } -> value
}

# Boolean implementations
impl Eq Boolean where {
    equals = { left, right } -> __native_boolean_equals { left = left, right = right }
}

impl Show Boolean where {
    to_string = { value } -> __native_boolean_to_string { value = value }
}

# Nat implementations (using hidden native functions)
impl NumAdd Nat where {
    add = { left, right } -> __native_nat_add { left = left, right = right }
}

# Note: Nat does not implement NumSub because subtraction can result in negative numbers
# Use natToInt first if subtraction is needed: (natToInt left) - (natToInt right)

impl NumMul Nat where {
    multiply = { left, right } -> __native_nat_multiply { left = left, right = right }
}

impl NumDiv Nat where {
    divide = { left, right } -> __native_nat_divide { left = left, right = right }
}

impl NumMod Nat where {
    modulo = { left, right } -> __native_nat_modulo { left = left, right = right }
}

impl Eq Nat where {
    equals = { left, right } -> __native_nat_equals { left = left, right = right }
}

impl Ord Nat where {
    compare = { left, right } -> __native_nat_compare { left = left, right = right },
    less_than = { left, right } -> __native_nat_less_than { left = left, right = right },
    greater_than = { left, right } -> __native_nat_greater_than { left = left, right = right }
}

impl Show Nat where {
    to_string = { value } -> __native_nat_to_string { value = value }
}

# === SYSTEM FUNCTIONS ===

# Crash function for unrecoverable errors - exits the program
let crash = { msg } -> __native_crash { msg = msg }