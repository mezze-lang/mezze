use std::abilities::numeric::{ NumAdd, NumSub, NumMul, NumDiv, NumMod, NumZero, NumOne }
use std::abilities::compare::{ Eq, Ord }
use std::abilities::convert::{ Into, TryInto }
use std::abilities::default::{ Default }

impl NumAdd Float for Float having 'out = Float where {
  add = { it, r } -> __native_float_add { l = it, r = r }
}

## Float + Int -> Float (widen the Int operand).
impl NumAdd Int for Float having 'out = Float where {
  add = { it, r } -> it + r.to_float {}
}

## Float + Nat -> Float (widen the Nat operand).
impl NumAdd Nat for Float having 'out = Float where {
  add = { it, r } -> it + from_nat { n = r }
}

impl NumSub Float for Float having 'out = Float where {
  sub = { it, r } -> __native_float_subtract { l = it, r = r }
}

## Float - Int -> Float (widen the Int operand).
impl NumSub Int for Float having 'out = Float where {
  sub = { it, r } -> it - r.to_float {}
}

## Float - Nat -> Float (widen the Nat operand).
impl NumSub Nat for Float having 'out = Float where {
  sub = { it, r } -> it - from_nat { n = r }
}

impl NumMul for Float where {
  mul = { it, r } -> __native_float_multiply { l = it, r = r }
}

impl NumDiv for Float where {
  div = { it, r } -> __native_float_divide { l = it, r = r }
}

impl NumMod for Float where {
  mod = { it, r } -> __native_float_mod { l = it, r = r }
}

impl Eq for Float where {
  eq = { it, r } -> __native_float_eq { l = it, r = r },
  neq = { it, r } -> __native_float_neq { l = it, r = r },
}

impl Ord for Float where {
  lt = { it, r } -> __native_float_lt { l = it, r = r },
  le = { it, r } -> __native_float_le { l = it, r = r },
  gt = { it, r } -> __native_float_gt { l = it, r = r },
  ge = { it, r } -> __native_float_ge { l = it, r = r },
}

impl Into Str for Float where {
  into = { it } -> __native_float_to_str { n = it }
}

impl TryInto Int | ConversionError { msg: Str } | for Float where {
  try_into = { it } -> match __native_float_to_int { n = it } is
    Some { val } -> Ok { val = val }
    None -> Err {
      error = ConversionError { msg = "float cannot be exactly converted to Int" },
    }

}

impl TryInto Float | ConversionError { msg: Str } | for Str where {
  try_into = { it } -> match __native_float_from_string { s = it } is
    Some { val } -> Ok { val = val }
    None -> Err { error = ConversionError { msg = "invalid float" } }

}

impl NumZero for Float where {
  zero = {} -> 0.0,
  is_zero = { it } -> it == 0.0,
}

impl NumOne for Float where {
  one = {} -> 1.0
}

impl Default for Float where {
  default = {} -> 0.0
}

## Convert a float to its string representation.
pub let to_str: { n: Float } -> Str = { n } -> __native_float_to_str { n = n }

## Convert an Int to a Float.
pub let from_int: { n: Int } -> Float = { n } -> __native_float_from_int { n = n }

## Convert a Nat to a Float.
pub let from_nat: { n: Nat } -> Float = { n } -> __native_float_from_nat { n = n }

## Parse a string as a float. Returns None on failure.
pub let from_string: { s: Str } -> Option Float = { s } -> __native_float_from_string { s = s }

## Absolute value.
pub let abs: { n: Float } -> Float = { n } -> __native_float_abs { n = n }

## Return the smaller of two floats.
pub let min: { l: Float, r: Float } -> Float = { l, r } -> __native_float_min { l = l, r = r }

## Return the larger of two floats.
pub let max: { l: Float, r: Float } -> Float = { l, r } -> __native_float_max { l = l, r = r }

## True if the value is NaN.
pub let is_nan: { n: Float } -> Bool = { n } -> __native_float_is_nan { n = n }

## True if the value is positive or negative infinity.
pub let is_infinite: { n: Float } -> Bool = { n } -> __native_float_is_infinite { n = n }

## True if the value is neither NaN nor infinite.
pub let is_finite: { n: Float } -> Bool = { n } -> __native_float_is_finite { n = n }

## Sign of the float: -1.0, 0.0, or 1.0. Returns NaN for NaN input.
pub let sign: { n: Float } -> Float = { n } -> __native_float_sign { n = n }

## Clamp n to the range [min, max].
pub let clamp: { n: Float, min: Float, max: Float } -> Float = { n, min, max } ->
  __native_float_clamp { n = n, min = min, max = max }

## Truncate toward zero. Returns None for NaN or infinity.
pub let to_int: { n: Float } -> Option Int = { n } -> __native_float_to_int { n = n }

impl Float where {
  neg: { it: Float } -> Float = { it } -> __native_float_neg { n = it },
  to_int = { it } -> __native_float_to_int { n = it },
  to_str = { it } -> __native_float_to_str { n = it },
  abs = { it } -> __native_float_abs { n = it },
  sign = { it } -> __native_float_sign { n = it },
  clamp = { it, min, max } -> __native_float_clamp { n = it, min = min, max = max },
  min = { it, r } -> __native_float_min { l = it, r = r },
  max = { it, r } -> __native_float_max { l = it, r = r },
  is_nan = { it } -> __native_float_is_nan { n = it },
  ceil: { it: Float } -> Float = { it } -> __native_float_ceil { n = it },
  floor: { it: Float } -> Float = { it } -> __native_float_floor { n = it },
  round: { it: Float } -> Float = { it } -> __native_float_round { n = it },
  is_infinite = { it } -> __native_float_is_infinite { n = it },
  is_finite = { it } -> __native_float_is_finite { n = it },
  sqrt: { it: Float } -> Float = { it } -> __native_float_sqrt { n = it },
}
