use std::abilities::numeric::{NumAdd, NumSub, NumMul, NumDiv, NumMod, NumZero, NumOne}
use std::abilities::compare::{Eq, Ord}
use std::abilities::convert::{Into, TryInto}
use std::abilities::default::{Default}

impl NumAdd for Float where { add = {it, r} -> __native_float_add {l = it, r = r} }
impl NumSub for Float where { sub = {it, r} -> __native_float_subtract {l = it, r = r}, neg = {it} -> 0.0 - it }
impl NumMul for Float where { mul = {it, r} -> __native_float_multiply {l = it, r = r} }
impl NumDiv for Float where { div = {it, r} -> __native_float_divide {l = it, r = r} }
impl NumMod for Float where { mod = {it, r} -> __native_float_mod {l = it, r = r} }
impl Eq for Float where { eq = {it, r} -> __native_float_eq {l = it, r = r}, neq = {it, r} -> __native_float_neq {l = it, r = r} }
impl Ord for Float where { lt = {it, r} -> __native_float_lt {l = it, r = r}, le = {it, r} -> __native_float_le {l = it, r = r}, gt = {it, r} -> __native_float_gt {l = it, r = r}, ge = {it, r} -> __native_float_ge {l = it, r = r} }
impl Into Str for Float where { into = {it} -> __native_float_to_str {n = it} }
impl TryInto Int |ConversionError {msg: Str}| for Float where {
    try_into = {it} -> match __native_float_to_int {n = it} is
        Some {val} -> Ok {val = val}
        None -> Err {error = ConversionError {msg = "float cannot be exactly converted to Int"}}
}
impl TryInto Float |ConversionError {msg: Str}| for Str where {
    try_into = {it} -> match __native_float_from_string {s = it} is
        Some {val} -> Ok {val = val}
        None -> Err {error = ConversionError {msg = "invalid float"}}
}
impl NumZero for Float where { zero = {} -> 0.0, is_zero = {it} -> it == 0.0 }
impl NumOne for Float where { one = {} -> 1.0 }
impl Default for Float where { default = {} -> 0.0 }

# Float utility functions
# This module provides utility functions for working with floats
# Note: The Float type and basic operations are now built-in
# Built-in ability implementations (NumAdd, NumSub, NumMul, NumDiv, Eq, Inspect) are automatically available
# Note: Mathematical functions like min, max, pow, sqrt, floor, ceil, round are in std::math::core

# Type conversions
pub let to_str = { n: Float } ->
    __native_float_to_str { n = n }

pub let from_int = { n: Int } ->
    __native_float_from_int { n = n }

pub let from_nat = { n: Nat } ->
    __native_float_from_nat { n = n }

pub let from_string = { s: Str } ->
    __native_float_from_string { s = s }

pub let abs = { n: Float } ->
    __native_float_abs { n = n }

pub let min = { l: Float, r: Float } ->
    __native_float_min { l = l, r = r }

pub let max = { l: Float, r: Float } ->
    __native_float_max { l = l, r = r }

# =============================================================================
# Float Classification
# =============================================================================

# Check if value is NaN (Not a Number)
# Example: is_nan {n = 0.0 / 0.0} -> True
pub let is_nan = { n: Float } ->
    __native_float_is_nan { n = n }

# Check if value is infinite (positive or negative)
# Example: is_infinite {n = 1.0 / 0.0} -> True
pub let is_infinite = { n: Float } ->
    __native_float_is_infinite { n = n }

# Check if value is finite (not NaN and not infinite)
# Example: is_finite {n = 3.14} -> True
pub let is_finite = { n: Float } ->
    __native_float_is_finite { n = n }

# =============================================================================
# Float Utilities
# =============================================================================

# Get sign of float (-1.0, 0.0, or 1.0)
# Returns NaN if input is NaN
# Example: sign {n = -5.5} -> -1.0
pub let sign = { n: Float } ->
    __native_float_sign { n = n }

# Clamp value to range [min, max]
# Example: clamp {n = 15.5, min = 0.0, max = 10.0} -> 10.0
pub let clamp = { n: Float, min: Float, max: Float } ->
    __native_float_clamp { n = n, min = min, max = max }

# Convert float to int (truncate towards zero)
# Returns None for NaN or Infinity
# Example: to_int {n = 3.7} -> Some {val = 3}
# Example: to_int {n = 1.0 / 0.0} -> None
pub let to_int = { n: Float } ->
    __native_float_to_int { n = n }

impl Float where {
    to_int = {it} -> __native_float_to_int {n = it},
    to_str = {it} -> __native_float_to_str {n = it},
    abs = {it} -> __native_float_abs {n = it},
    sign = {it} -> __native_float_sign {n = it},
    clamp = {it, min, max} -> __native_float_clamp {n = it, min = min, max = max},
    min = {it, r} -> __native_float_min {l = it, r = r},
    max = {it, r} -> __native_float_max {l = it, r = r},
    is_nan = {it} -> __native_float_is_nan {n = it},
    ceil = {it} -> __native_float_ceil {n = it},
    floor = {it} -> __native_float_floor {n = it},
    round = {it} -> __native_float_round {n = it},
    is_infinite = {it} -> __native_float_is_infinite {n = it},
    is_finite = {it} -> __native_float_is_finite {n = it},
    sqrt = {it} -> __native_float_sqrt {n = it}
}