# std/collections/sorted_set.funk - Immutable sorted set operations
#
# SortedSet is a persistent sorted set backed by a balanced tree.
# Elements are maintained in sorted order for efficient min/max operations.
#
# Performance characteristics:
# - add, remove, contains: O(log n)
# - min, max: O(log n)
# - size, is_empty: O(1)
#
# All operations are immutable and return new sets.

# === Construction ===

# Create an empty sorted set
pub let empty = {} ->
    __native_sorted_set_empty {}

# Create a sorted set with one element
pub let singleton = { x } ->
    __native_sorted_set_singleton { x = x }

# Create a sorted set from a list
pub let from_list = { list } ->
    __native_sorted_set_from_list { list = list }

# === Basic Operations ===

# Add an element, returns new set
pub let add = { s, x } ->
    __native_sorted_set_add { s = s, x = x }

# Remove an element, returns new set
pub let remove = { s, x } ->
    __native_sorted_set_remove { s = s, x = x }

# Check if element exists
pub let contains = { s, x } ->
    __native_sorted_set_contains { s = s, x = x }

# === Query ===

# Get number of elements
pub let size = { s } ->
    __native_sorted_set_size { s = s }

# Check if set is empty
pub let is_empty = { s } ->
    __native_sorted_set_is_empty { s = s }

# === Set Operations ===

# Union of two sorted sets
pub let union = { s1, s2 } ->
    __native_sorted_set_union { s1 = s1, s2 = s2 }

# Intersection of two sorted sets
pub let intersect = { s1, s2 } ->
    __native_sorted_set_intersect { s1 = s1, s2 = s2 }

# Difference of two sorted sets (s1 - s2)
pub let difference = { s1, s2 } ->
    __native_sorted_set_difference { s1 = s1, s2 = s2 }

# === Min/Max Operations ===

# Get minimum element, returns Option
pub let min = { s } ->
    __native_sorted_set_min { s = s }

# Get maximum element, returns Option
pub let max = { s } ->
    __native_sorted_set_max { s = s }

# === Conversions ===

# Convert to list (in sorted order)
pub let to_list = { s } ->
    __native_sorted_set_to_list { s = s }

# Convert from regular Set to SortedSet
pub let from_set = { s } ->
    __native_sorted_set_from_set { s = s }

# Convert SortedSet to regular Set
pub let to_set = { s } ->
    __native_sorted_set_to_set { s = s }

# === Equality ===

# Check if two sorted sets are equal
pub let equals = { s1, s2 } ->
    __native_sorted_set_equals { s1 = s1, s2 = s2 }
