# std/collections/map.funk - Map operations using HashMap

# Map 'k 'v is a built-in type implemented using HashMap internally
# No explicit type definition needed - handled by native runtime

# Basic map operations
pub let empty = {} -> Map 'k 'v
    __native_map_empty {}

pub let insert = { map: Map 'k 'v, key: 'k, value: 'v } -> Map 'k 'v where { Eq 'k }
    __native_map_insert { map = map, key = key, value = value }

pub let get = { map: Map 'k 'v, key: 'k } -> Option 'v where { Eq 'k }
    __native_map_get { map = map, key = key }

pub let remove = { map: Map 'k 'v, key: 'k } -> Map 'k 'v where { Eq 'k }
    __native_map_remove { map = map, key = key }

pub let contains_key = { map: Map 'k 'v, key: 'k } -> Boolean where { Eq 'k }
    __native_map_contains_key { map = map, key = key }

pub let size = { map: Map 'k 'v } -> Int
    __native_map_size { map = map }

pub let is_empty = { map: Map 'k 'v } -> Boolean
    size { map = map } == 0

# Map queries and utilities
pub let keys = { map: Map 'k 'v } -> ['k]
    __native_map_keys { map = map }

pub let values = { map: Map 'k 'v } -> ['v]
    __native_map_values { map = map }

pub let entries = { map: Map 'k 'v } -> [('k, 'v)]
    __native_map_entries { map = map }

# Higher-order functions
pub let map_values = { map: Map 'k 'v, func: 'v -> 'w } -> Map 'k 'w where { Eq 'k }
    __native_map_map_values { map = map, func = func }

pub let filter = { map: Map 'k 'v, predicate: { key: 'k, value: 'v } -> Boolean } -> Map 'k 'v where { Eq 'k }
    __native_map_filter { map = map, predicate = predicate }

pub let fold = { map: Map 'k 'v, initial: 'acc, func: { acc: 'acc, key: 'k, value: 'v } -> 'acc } -> 'acc
    __native_map_fold { map = map, initial = initial, func = func }

# Map construction helpers
pub let from_entries = { entries: [('k, 'v)] } -> Map 'k 'v where { Eq 'k }
    __native_map_from_entries { entries = entries }

pub let from_keys = { keys: ['k], value_func: 'k -> 'v } -> Map 'k 'v where { Eq 'k }
    let entries = map { list = keys, func = { key: 'k } -> ('k, 'v)
        (key, value_func { key })
    }
    from_entries { entries = entries }

# Map operations
pub let merge = { map1: Map 'k 'v, map2: Map 'k 'v } -> Map 'k 'v where { Eq 'k }
    __native_map_merge { map1 = map1, map2 = map2 }

pub let merge_with = { map1: Map 'k 'v, map2: Map 'k 'v, merge_func: { left: 'v, right: 'v } -> 'v } -> Map 'k 'v where { Eq 'k }
    __native_map_merge_with { map1 = map1, map2 = map2, merge_func = merge_func }

# Lookup with default
pub let get_or_default = { map: Map 'k 'v, key: 'k, default: 'v } -> 'v where { Eq 'k }
    match get { map = map, key = key } is
        Some { value } -> value
        None -> default

# Update operations
pub let update = { map: Map 'k 'v, key: 'k, update_func: Option 'v -> Option 'v } -> Map 'k 'v where { Eq 'k }
    let current = get { map = map, key = key }
    let new_value = update_func { current }
    match new_value is
        Some { value } -> insert { map = map, key = key, value = value }
        None -> remove { map = map, key = key }

# Convenience functions
pub let insert_all = { map: Map 'k 'v, entries: [('k, 'v)] } -> Map 'k 'v where { Eq 'k }
    fold { 
        list = entries, 
        initial = map, 
        func = { acc: Map 'k 'v, item: ('k, 'v) } -> Map 'k 'v
            let (key, value) = item
            insert { map = acc, key = key, value = value }
    }

pub let remove_all = { map: Map 'k 'v, keys: ['k] } -> Map 'k 'v where { Eq 'k }
    fold { 
        list = keys, 
        initial = map, 
        func = { acc: Map 'k 'v, key: 'k } -> Map 'k 'v
            remove { map = acc, key = key }
    }