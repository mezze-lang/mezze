use std::abilities::compare::{ Eq, Ord }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::int

## Default SortedSet is the empty sorted set.
impl Default for SortedSet 'a where {
  default = {} -> empty {}
}

## Structural equality for sorted sets.
impl Eq for SortedSet 'a where {
  eq = { it, r } -> __native_sorted_set_equals { s1 = it, s2 = r },
  neq = { it, r } -> if __native_sorted_set_equals { s1 = it, s2 = r } then False else True,
}

## Lexicographic ordering for sorted sets.
impl Ord for SortedSet 'a where {
  lt: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } == (0 - 1),
  le: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } != 1,
  gt: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } == 1,
  ge: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } != (0 - 1),
}

## Creates an empty sorted set.
pub let empty: {} -> SortedSet 'a = {} -> __native_sorted_set_empty {}

## Creates a sorted set with one element.
pub let singleton: { x: 'a } with Ord 'a -> SortedSet 'a = { x } ->
  __native_sorted_set_singleton { x = x }

## Creates a sorted set from a list.
pub let from_list: { xs: List 'a } with Ord 'a -> SortedSet 'a = { xs } ->
  __native_sorted_set_from_list { xs = xs }

## Adds an element, returning a new set.
pub let add: { s: SortedSet 'a, x: 'a } with Ord 'a -> SortedSet 'a = { s, x } ->
  __native_sorted_set_add { s = s, x = x }

## Removes an element, returning a new set.
pub let remove: { s: SortedSet 'a, x: 'a } with Ord 'a -> SortedSet 'a = { s, x } ->
  __native_sorted_set_remove { s = s, x = x }

## Returns True if the element is in the set.
pub let contains: { s: SortedSet 'a, x: 'a } with Ord 'a -> Bool = { s, x } ->
  __native_sorted_set_contains { s = s, x = x }

## Returns the number of elements.
pub let size: { s: SortedSet 'a } -> Int = { s } -> __native_sorted_set_size { s = s }

## Returns True if the set has no elements.
pub let is_empty: { s: SortedSet 'a } -> Bool = { s } -> __native_sorted_set_is_empty { s = s }

## Returns elements in either set.
pub let union: { s1: SortedSet 'a, s2: SortedSet 'a } -> SortedSet 'a = { s1, s2 } ->
  __native_sorted_set_union { s1 = s1, s2 = s2 }

## Returns elements in both sets.
pub let intersect
  : { s1: SortedSet 'a, s2: SortedSet 'a }
  -> SortedSet 'a
  = { s1, s2 } -> __native_sorted_set_intersect { s1 = s1, s2 = s2 }

## Returns elements in s1 but not in s2.
pub let difference
  : { s1: SortedSet 'a, s2: SortedSet 'a }
  -> SortedSet 'a
  = { s1, s2 } -> __native_sorted_set_difference { s1 = s1, s2 = s2 }

## Returns the minimum element, or None if empty.
pub let min: { s: SortedSet 'a } -> Option 'a = { s } -> __native_sorted_set_min { s = s }

## Returns the maximum element, or None if empty.
pub let max: { s: SortedSet 'a } -> Option 'a = { s } -> __native_sorted_set_max { s = s }

## Converts to a List in sorted order.
pub let to_list: { s: SortedSet 'a } -> List 'a = { s } -> __native_sorted_set_to_list { s = s }

## Creates a SortedSet from a regular Set.
pub let from_set: { s: Set 'a } with Ord 'a -> SortedSet 'a = { s } ->
  __native_sorted_set_from_set { s = s }

## Converts to a regular Set.
pub let to_set: { s: SortedSet 'a } -> Set 'a = { s } -> __native_sorted_set_to_set { s = s }

## Returns True if the two sorted sets are equal.
pub let equals: { s1: SortedSet 'a, s2: SortedSet 'a } -> Bool = { s1, s2 } ->
  __native_sorted_set_equals { s1 = s1, s2 = s2 }

## Splits into elements matching and not matching the predicate.
pub let partition
  : { s: SortedSet 'a, p: { val: 'a } -> Bool <...> }
  -> { pass: SortedSet 'a, fail: SortedSet 'a } <...>
  = { s, p } -> __native_sorted_set_partition { s = s, p = p }

## Returns the minimum element by a key function, or None.
pub let min_by: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } -> Option 'a <...> = { s, f } ->
  __native_sorted_set_min_by { s = s, f = f }

## Returns the maximum element by a key function, or None.
pub let max_by: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } -> Option 'a <...> = { s, f } ->
  __native_sorted_set_max_by { s = s, f = f }

## Takes the first n elements in sorted order.
pub let take: { s: SortedSet 'a, n: Int } -> SortedSet 'a = { s, n } ->
  __native_sorted_set_take { s = s, n = n }

## Drops the first n elements in sorted order.
pub let drop: { s: SortedSet 'a, n: Int } -> SortedSet 'a = { s, n } ->
  __native_sorted_set_drop { s = s, n = n }

## Returns elements in range [lo, hi] inclusive.
pub let range: { s: SortedSet 'a, lo: 'a, hi: 'a } with Ord 'a -> SortedSet 'a = { s, lo, hi } ->
  __native_sorted_set_range { s = s, lo = lo, hi = hi }

## Returns elements in either set but not both.
pub let symmetric_difference
  : { s1: SortedSet 'a, s2: SortedSet 'a }
  -> SortedSet 'a
  = { s1, s2 } -> __native_sorted_set_symmetric_difference { s1 = s1, s2 = s2 }

## Returns elements strictly less than the given element.
pub let head_set: { s: SortedSet 'a, to: 'a } with Ord 'a -> SortedSet 'a = { s, to } ->
  __native_sorted_set_head_set { s = s, to = to }

## Returns elements >= the given element.
pub let tail_set: { s: SortedSet 'a, from: 'a } with Ord 'a -> SortedSet 'a = { s, from } ->
  __native_sorted_set_tail_set { s = s, from = from }

## Maps elements with f, collecting only Some results into a SortedSet.
pub let filter_map
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> }
  -> SortedSet 'b <...>
  = { set, f } -> __native_sorted_set_filter_map { set = set, f = f }

## Maps elements with f, collecting only Some results into a Seq.
pub let collect_seq
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> }
  -> ['b] <...>
  = { set, f } -> __native_sorted_set_collect_seq { set = set, f = f }

## Maps elements with f, collecting only Some results into a List.
pub let collect_list
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> }
  -> List 'b <...>
  = { set, f } -> __native_sorted_set_collect_list { set = set, f = f }

## Keeps only elements for which the predicate returns True.
pub let filter
  : { s: SortedSet 'a, p: { val: 'a } -> Bool <...> }
  -> SortedSet 'a <...>
  = { s, p } -> __native_sorted_set_filter { s = s, p = p }

## Transforms each element using f (duplicates removed).
pub let map: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } -> SortedSet 'b <...> = { s, f } ->
  __native_sorted_set_map { s = s, f = f }

## Folds over elements in sorted order.
pub let fold
  : { s: SortedSet 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> 'acc <...>
  = { s, init, f } -> __native_sorted_set_fold { s = s, init = init, f = f }

## Returns True if any element matches the predicate.
pub let any: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_any { s = s, p = p }

## Returns True if all elements match the predicate.
pub let all: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_all { s = s, p = p }

## Returns True if no element matches the predicate.
pub let none: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_none { s = s, p = p }

## Returns the first element matching the predicate, or None.
pub let find: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Option 'a <...> = { s, p } ->
  __native_sorted_set_find { s = s, p = p }

## Counts elements matching the predicate.
pub let count: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Int <...> = { s, p } ->
  __native_sorted_set_count { s = s, p = p }

## Reduces elements to a single value, or returns None if empty.
pub let reduce
  : { s: SortedSet 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { s, f } -> __native_sorted_set_reduce { s = s, f = f }

## Sums all integer elements.
pub let sum: { s: SortedSet Int } -> Int = { s } -> __native_sorted_set_sum { s = s }

## Sums all float elements.
pub let sum_float: { s: SortedSet Float } -> Float = { s } ->
  __native_sorted_set_sum_float { s = s }

## Returns the product of all integer elements.
pub let product: { s: SortedSet Int } -> Int = { s } -> __native_sorted_set_product { s = s }

## Returns the product of all float elements.
pub let product_float: { s: SortedSet Float } -> Float = { s } ->
  __native_sorted_set_product_float { s = s }

## Converts to a Seq in sorted order.
pub let to_seq: { s: SortedSet 'a } -> ['a] = { s } -> __native_sorted_set_to_seq { s = s }

## Creates a sorted set from a Seq.
pub let from_seq: { xs: ['a] } -> SortedSet 'a = { xs } ->
  __native_sorted_set_from_seq { xs = xs }

## Executes f for each element, for side effects only.
pub let for_each: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } -> {} <...> = { s, f } ->
  __native_sorted_set_for_each { s = s, f = f }

## Method implementations for SortedSet.
impl SortedSet 'a where {
  add = { it, x } -> add { s = it, x = x },
  remove = { it, x } -> remove { s = it, x = x },
  contains = { it, x } -> contains { s = it, x = x },
  union = { it, s2 } -> union { s1 = it, s2 = s2 },
  intersect = { it, s2 } -> intersect { s1 = it, s2 = s2 },
  difference = { it, s2 } -> difference { s1 = it, s2 = s2 },
  min = { it } -> min { s = it },
  max = { it } -> max { s = it },
  filter = { it, p } -> filter { s = it, p = p },
  map = { it, f } -> map { s = it, f = f },
  fold = { it, init, f } -> fold { s = it, init = init, f = f },
  any = { it, p } -> any { s = it, p = p },
  all = { it, p } -> all { s = it, p = p },
  find = { it, p } -> find { s = it, p = p },
  to_list = { it } -> to_list { s = it },
  to_set = { it } -> to_set { s = it },
  to_seq = { it } -> to_seq { s = it },

  ## dot-chain parity: an inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` always works.
  partition = { it, p } -> partition { s = it, p = p },
  min_by = { it, f } -> min_by { s = it, f = f },
  max_by = { it, f } -> max_by { s = it, f = f },
  take = { it, n } -> take { s = it, n = n },
  drop = { it, n } -> drop { s = it, n = n },
  range = { it, lo, hi } -> range { s = it, lo = lo, hi = hi },
  head_set = { it, to } -> head_set { s = it, to = to },
  tail_set = { it, from } -> tail_set { s = it, from = from },
  filter_map = { it, f } -> filter_map { set = it, f = f },
  collect_seq = { it, f } -> collect_seq { set = it, f = f },
  collect_list = { it, f } -> collect_list { set = it, f = f },
  none = { it, p } -> none { s = it, p = p },
  count = { it, p } -> count { s = it, p = p },
  reduce = { it, f } -> reduce { s = it, f = f },
  sum = { it } -> sum { s = it },
  sum_float = { it } -> sum_float { s = it },
  product = { it } -> product { s = it },
  product_float = { it } -> product_float { s = it },
  for_each = { it, f } -> for_each { s = it, f = f },
}

impl Sized for SortedSet 'a where {
  size = { it } -> size { s = it },
  is_empty = { it } -> is_empty { s = it },
}
