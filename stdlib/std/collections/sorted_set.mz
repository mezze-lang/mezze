use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::abilities::iter::{ Iterable }
use std::collections::iter
use std::int

## Default SortedSet is the empty sorted set.
impl Default for SortedSet 'a where {
  default = {} -> empty {}
}

## Structural equality for sorted sets.
## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for SortedSet 'a where {
  hash: { it: SortedSet 'a } -> Int = { it } -> structural_hash { it = it }
}

## Element-wise equality in sorted order, threading the ELEMENT's Eq. Asked of `Eq`
## and not of the ordering the set carries: they are separate abilities and a type
## may implement them independently.
let sorted_set_equals_with_eq
  : { s1: SortedSet 'a, s2: SortedSet 'a, eq: { a: 'a, b: 'a } -> Bool } -> Bool = { s1, s2, eq } ->
  __native_sorted_set_equals { s1 = s1, s2 = s2, eq = eq }

impl Eq for SortedSet 'a where {
  eq: { it: SortedSet 'a, r: SortedSet 'a } with Eq 'a -> Bool = { it, r } ->
    sorted_set_equals_with_eq { s1 = it, s2 = r, eq = { a, b } -> a == b },
  neq: { it: SortedSet 'a, r: SortedSet 'a } with Eq 'a -> Bool = { it, r } ->
    if sorted_set_equals_with_eq { s1 = it, s2 = r, eq = { a, b } -> a == b } then False else True,
}

## Lexicographic ordering for sorted sets.
impl Ord for SortedSet 'a where {
  lt: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } == (0 - 1),
  le: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } != 1,
  gt: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } == 1,
  ge: { it: SortedSet 'a, r: SortedSet 'a } with Ord 'a -> Bool = { it, r } ->
    __native_sorted_set_compare { s1 = it, s2 = r } != (0 - 1),
}

## Creates an empty sorted set.
pub let empty: {} -> SortedSet 'a = {} -> __native_sorted_set_empty {}

## Creates a sorted set with one element.
## Sorted containers keep their ordering INSIDE the structure, so they are handed
## the element's own comparator at CONSTRUCTION and reuse it for every later
## insert, lookup and range query. Each helper's `cmp` param is DECLARED so it ties
## to the element type var — an inline lambda would mint its own (seq's #23 trick).
let singleton_with_cmp: { x: 'a, cmp: { a: 'a, b: 'a } -> Int } -> SortedSet 'a = { x, cmp } ->
  __native_sorted_set_singleton { x = x, cmp = cmp }

pub let singleton: { x: 'a } with Ord 'a -> SortedSet 'a = { x } ->
  singleton_with_cmp { x = x, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Creates a sorted set from a list.
let from_list_with_cmp: { xs: List 'a, cmp: { a: 'a, b: 'a } -> Int } -> SortedSet 'a = { xs, cmp } ->
  __native_sorted_set_from_list { xs = xs, cmp = cmp }

pub let from_list: { xs: List 'a } with Ord 'a -> SortedSet 'a = { xs } ->
  from_list_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Adds an element, returning a new set.
##
## THE SEARCH HAPPENS HERE, the insertion in the native, and NEITHER path
## reaches the native's own search any more. That search ran a comparator
## closure in host code and so paid a guest callback per comparison — 307 000 ps
## against the 15 060 the same search costs in `contains` since it moved into
## guest code.
##
## Adding an element already present is a pure SEARCH: the set comes back
## unchanged, so `find_index` finding it IS the whole operation. Adding one that
## is absent needs the position, and `find_index` already returns it as
## `-(insertPos + 1)`, so `add_at` can copy the array without comparing
## anything. This used to search twice — once here, once in the native — which
## is the second search named in the note that asked for an insert-at-index
## native.
##
## Separate helper for the branch because `add` cannot bind the search result to
## a `do`-block `let` without detaching its `Ord`; see the note above
## `find_index`.
let add_at_slot: { s: SortedSet 'a, x: 'a, idx: Int } -> SortedSet 'a = { s, x, idx } ->
  if idx < 0
    then __native_sorted_set_add_at { s = s, i = 0 - idx - 1, x = x }
    else s

pub let add: { s: SortedSet 'a, x: 'a } with Ord 'a -> SortedSet 'a = { s, x } ->
  add_at_slot { s = s, x = x,
                idx = find_index { s = s, x = x, lo = 0,
                                   hi = __native_sorted_set_size { s = s } - 1 } }

## Removes an element, returning a new set.
##
## The search runs HERE, like `contains`'s and `add`'s. Removing an element that
## is NOT there is a pure SEARCH, so that case never reaches a native.
let remove_at_slot: { s: SortedSet 'a, idx: Int } -> SortedSet 'a = { s, idx } ->
  if idx < 0
    then s
    else __native_sorted_set_remove_at { s = s, i = idx }

pub let remove: { s: SortedSet 'a, x: 'a } with Ord 'a -> SortedSet 'a = { s, x } ->
  remove_at_slot { s = s,
                   idx = find_index { s = s, x = x, lo = 0,
                                      hi = __native_sorted_set_size { s = s } - 1 } }

## Returns True if the element is in the set.
## ── THE MEMBERSHIP TEST RUNS HERE, NOT IN THE NATIVE ──────────────────────
##
## A SortedSet is a sorted array, so `contains` is a binary search. It used to
## run inside the native, which put the COMPARISON in host code and so called
## back into guest code once per comparison — measured at ~310 ns against the
## hash `set::contains`'s 4.8. Host code is past the boundary, so Graal can
## never inline a guest function into it; running the search HERE makes the
## comparison an ordinary `<` that inlines and reduces the native's whole job to
## an array read. The identical change on `sorted_map` was worth 18-20x.
##
## The index must stay in [0, size); `find_index` maintains that, which is why
## `element_at` is private.
let element_at: { s: SortedSet 'a, i: Int } -> 'a = { s, i } ->
  __native_sorted_set_element_at { s = s, i = i }

## The position of `x` in sort order, or a negative number if absent.
##
## NO `do`-BLOCK BINDING AND NO ANNOTATION, both for the reasons recorded on
## `sorted_map`'s copy of this search. Binding the probed element first —
## `let mx = element_at { … }` — generalizes it, so the `Ord` the comparison
## raises lands on a fresh variable and the annotation is refused; annotating a
## RECURSIVE helper is refused for the same reason; and dropping the caller's
## annotation instead leaves a variable unbound at the end of elaboration, which
## `ElaborationInvariantGateTest` catches. Hence `element_at` called inside the
## comparison, `(lo + hi) / 2` spelled out, and `found_at` to pin the result to
## `Int` so `>=` raises nothing the caller cannot name.
##
## STORED element on the left, probe on the right — the order the native
## comparator was handed, so an `Ord` that is not symmetric orders the array the
## same way whichever side does the search.
##
## A miss returns `-(insertPos + 1)` rather than a bare -1, where `insertPos` is
## the index that keeps the array sorted — the encoding a Java binary search
## uses, so that one search tells `add` both that the element is absent and
## where it goes. `contains` only tests the sign.
let find_index = { s, x, lo, hi } ->
  if lo > hi then 0 - lo - 1
  else if element_at { s = s, i = (lo + hi) / 2 } < x
    then find_index { s = s, x = x, lo = (lo + hi) / 2 + 1, hi = hi }
  else if x < element_at { s = s, i = (lo + hi) / 2 }
    then find_index { s = s, x = x, lo = lo, hi = (lo + hi) / 2 - 1 }
  else (lo + hi) / 2

let found_at: { idx: Int } -> Bool = { idx } -> idx >= 0

pub let contains: { s: SortedSet 'a, x: 'a } with Ord 'a -> Bool = { s, x } ->
  found_at { idx = find_index { s = s, x = x, lo = 0,
                                hi = __native_sorted_set_size { s = s } - 1 } }

## Returns the number of elements.
pub let size: { s: SortedSet 'a } -> Int = { s } -> __native_sorted_set_size { s = s }

## Returns True if the set has no elements.
pub let is_empty: { s: SortedSet 'a } -> Bool = { s } -> __native_sorted_set_is_empty { s = s }

## ── THE MERGES TAKE THE ORDER, THEY DO NOT ASK THE SET ────────────────────
##
## A SortedSet cannot be relied on to know its own order. `from_seq` threads a
## comparator built from the element's `Ord`, so a set built that way does. But
## `empty {}` threads none, and `add` places elements by a GUEST binary search
## using the author's `Ord` — so that set's ELEMENTS are in the author's order
## while its comparator says natural. Correct array, wrong label.
##
## A native that asked the set therefore merged a descending array as if it
## ascended, which CONCATENATED rather than merged and left a result whose own
## `contains` could not find half its elements. known-bugs.md BUG 44.
##
## So `with Ord 'a` here, and the comparison travels with the call — the same
## reason `contains` and `add` do their comparison in guest code. Where the
## element is provably directly comparable the compiler DROPS the `cmp`
## operand, so an Int or Str set merges with no comparator at all and keeps the
## native fast paths.

let union_with_cmp
  : { s1: SortedSet 'a, s2: SortedSet 'a, cmp: { a: 'a, b: 'a } -> Int }
  -> SortedSet 'a
  = { s1, s2, cmp } -> __native_sorted_set_union { s1 = s1, s2 = s2, cmp = cmp }

## Returns elements in either set.
pub let union: { s1: SortedSet 'a, s2: SortedSet 'a } with Ord 'a -> SortedSet 'a = { s1, s2 } ->
  union_with_cmp { s1 = s1, s2 = s2, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let intersect_with_cmp
  : { s1: SortedSet 'a, s2: SortedSet 'a, cmp: { a: 'a, b: 'a } -> Int }
  -> SortedSet 'a
  = { s1, s2, cmp } -> __native_sorted_set_intersect { s1 = s1, s2 = s2, cmp = cmp }

## Returns elements in both sets.
pub let intersect
  : { s1: SortedSet 'a, s2: SortedSet 'a } with Ord 'a
  -> SortedSet 'a
  = { s1, s2 } -> intersect_with_cmp { s1 = s1, s2 = s2, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let difference_with_cmp
  : { s1: SortedSet 'a, s2: SortedSet 'a, cmp: { a: 'a, b: 'a } -> Int }
  -> SortedSet 'a
  = { s1, s2, cmp } -> __native_sorted_set_difference { s1 = s1, s2 = s2, cmp = cmp }

## Returns elements in s1 but not in s2.
pub let difference
  : { s1: SortedSet 'a, s2: SortedSet 'a } with Ord 'a
  -> SortedSet 'a
  = { s1, s2 } -> difference_with_cmp { s1 = s1, s2 = s2, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns the minimum element, or None if empty.
pub let min: { s: SortedSet 'a } -> Option 'a = { s } -> __native_sorted_set_min { s = s }

## Returns the maximum element, or None if empty.
pub let max: { s: SortedSet 'a } -> Option 'a = { s } -> __native_sorted_set_max { s = s }

## Converts to a List in sorted order.
pub let to_list: { s: SortedSet 'a } -> List 'a = { s } -> __native_sorted_set_to_list { s = s }

## Creates a SortedSet from a regular Set.
let from_set_with_cmp: { s: Set 'a, cmp: { a: 'a, b: 'a } -> Int } -> SortedSet 'a = { s, cmp } ->
  __native_sorted_set_from_set { s = s, cmp = cmp }

## Creates a SortedSet from a regular Set.
##
## The `Ord 'a` was declared here long before it was PASSED ON: the body called
## the native bare, which built the set with no comparator, so the result came
## out naturally ordered whatever the element's `Ord` said. `from_list` has had
## the right shape all along. See known-bugs.md BUG 45.
pub let from_set: { s: Set 'a } with Ord 'a -> SortedSet 'a = { s } ->
  from_set_with_cmp { s = s, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Converts to a regular Set.
pub let to_set: { s: SortedSet 'a } -> Set 'a = { s } -> __native_sorted_set_to_set { s = s }

## Returns True if the two sorted sets are equal.
pub let equals: { s1: SortedSet 'a, s2: SortedSet 'a } with Eq 'a -> Bool = { s1, s2 } ->
  sorted_set_equals_with_eq { s1 = s1, s2 = s2, eq = { a, b } -> a == b }

## Splits into elements matching and not matching the predicate.
pub let partition
  : { s: SortedSet 'a, p: { val: 'a } -> Bool <...> }
  -> { pass: SortedSet 'a, fail: SortedSet 'a } <...>
  = { s, p } -> __native_sorted_set_partition { s = s, p = p }

## Returns the minimum element by a key function, or None.
let min_by_with_cmp
  : { s: SortedSet 'a, f: { val: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int } -> Option 'a <...>
  = { s, f, cmp } -> __native_sorted_set_min_by { s = s, f = f, cmp = cmp }

pub let min_by: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } with Ord 'b -> Option 'a <...> = { s, f } ->
  min_by_with_cmp { s = s, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns the maximum element by a key function, or None.
let max_by_with_cmp
  : { s: SortedSet 'a, f: { val: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int } -> Option 'a <...>
  = { s, f, cmp } -> __native_sorted_set_max_by { s = s, f = f, cmp = cmp }

pub let max_by: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } with Ord 'b -> Option 'a <...> = { s, f } ->
  max_by_with_cmp { s = s, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Takes the first n elements in sorted order.
pub let take: { s: SortedSet 'a, n: Int } -> SortedSet 'a = { s, n } ->
  __native_sorted_set_slice { s = s, from = 0, to = n }

## Drops the first n elements in sorted order.
pub let drop: { s: SortedSet 'a, n: Int } -> SortedSet 'a = { s, n } ->
  __native_sorted_set_slice { s = s, from = n, to = __native_sorted_set_size { s = s } }

## ── THE SLICES RUN HERE TOO ───────────────────────────────────────────────
## These three take NO comparator and searched with the one stored on the set,
## which nothing installs since `add` started taking its position from the guest
## search. See the long note on the same six in `std::collections::sorted_map`:
## a slice is index arithmetic over a search the guest already does.
let count_below: { idx: Int } -> Int = { idx } -> if idx < 0 then 0 - idx - 1 else idx

let count_upto: { idx: Int } -> Int = { idx } -> if idx < 0 then 0 - idx - 1 else idx + 1

## One native for every slice; see the note in `std::collections::sorted_map`.
let slice: { s: SortedSet 'a, from: Int, to: Int } -> SortedSet 'a = { s, from, to } ->
  __native_sorted_set_slice { s = s, from = from, to = to }

## Returns elements in range [lo, hi] inclusive.
pub let range: { s: SortedSet 'a, lo: 'a, hi: 'a } with Ord 'a -> SortedSet 'a = { s, lo, hi } ->
  slice { s = s,
          from = count_below { idx = find_index { s = s, x = lo, lo = 0, hi = __native_sorted_set_size { s = s } - 1 } },
          to = count_upto { idx = find_index { s = s, x = hi, lo = 0, hi = __native_sorted_set_size { s = s } - 1 } } }

let symmetric_difference_with_cmp
  : { s1: SortedSet 'a, s2: SortedSet 'a, cmp: { a: 'a, b: 'a } -> Int }
  -> SortedSet 'a
  = { s1, s2, cmp } ->
      __native_sorted_set_symmetric_difference { s1 = s1, s2 = s2, cmp = cmp }

## Returns elements in either set but not both. See the note on `union` for why
## the order travels with the call.
pub let symmetric_difference
  : { s1: SortedSet 'a, s2: SortedSet 'a } with Ord 'a
  -> SortedSet 'a
  = { s1, s2 } -> symmetric_difference_with_cmp { s1 = s1, s2 = s2, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns elements strictly less than the given element.
pub let head_set: { s: SortedSet 'a, to: 'a } with Ord 'a -> SortedSet 'a = { s, to } ->
  slice { s = s, from = 0,
    to = count_below { idx = find_index { s = s, x = to, lo = 0, hi = __native_sorted_set_size { s = s } - 1 } } }

## Returns elements >= the given element.
pub let tail_set: { s: SortedSet 'a, from: 'a } with Ord 'a -> SortedSet 'a = { s, from } ->
  slice { s = s, to = __native_sorted_set_size { s = s },
    from = count_below { idx = find_index { s = s, x = from, lo = 0, hi = __native_sorted_set_size { s = s } - 1 } } }

## Maps elements with f, collecting only Some results into a SortedSet.
let filter_map_with_cmp
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...>, cmp: { a: 'b, b: 'b } -> Int }
  -> SortedSet 'b <...>
  = { set, f, cmp } -> __native_sorted_set_filter_map { set = set, f = f, cmp = cmp }

## Maps and keeps the Somes. `Ord 'b` for the reason `map` carries it: the
## result's elements are `'b`, so the source's order says nothing about them.
pub let filter_map
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> } with Ord 'b
  -> SortedSet 'b <...>
  = { set, f } -> filter_map_with_cmp { set = set, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Maps elements with f, collecting only Some results into a Seq.
pub let collect_seq
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> }
  -> ['b] <...>
  = { set, f } -> __native_sorted_set_collect_seq { set = set, f = f }

## Maps elements with f, collecting only Some results into a List.
pub let collect_list
  : { set: SortedSet 'a, f: { val: 'a } -> Option 'b <...> }
  -> List 'b <...>
  = { set, f } -> __native_sorted_set_collect_list { set = set, f = f }

## Keeps only elements for which the predicate returns True.
pub let filter
  : { s: SortedSet 'a, p: { val: 'a } -> Bool <...> }
  -> SortedSet 'a <...>
  = { s, p } -> __native_sorted_set_filter { s = s, p = p }

let map_with_cmp
  : { s: SortedSet 'a, f: { val: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int }
  -> SortedSet 'b <...>
  = { s, f, cmp } -> __native_sorted_set_map { s = s, f = f, cmp = cmp }

## Transforms each element using f (duplicates removed).
##
## `Ord 'b`, NOT `Ord 'a`: the result's elements are `'b`, so the SOURCE's order
## says nothing about how to order them. Without it the result came out
## naturally ordered whatever `'b`'s `Ord` was — mapping a plain Int set into a
## descending newtype gave `1, 3, 5` and a `contains` that could not find two of
## the three. known-bugs.md BUG 44's sibling, reached by construction rather
## than by merging.
pub let map
  : { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } with Ord 'b
  -> SortedSet 'b <...>
  = { s, f } -> map_with_cmp { s = s, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Folds over elements in sorted order.
pub let fold
  : { s: SortedSet 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> 'acc <...>
  = { s, init, f } -> __native_sorted_set_fold { s = s, init = init, f = f }

## Returns True if any element matches the predicate.
pub let any: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_any { s = s, p = p }

## Returns True if all elements match the predicate.
pub let all: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_all { s = s, p = p }

## Returns True if no element matches the predicate.
pub let none: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Bool <...> = { s, p } ->
  __native_sorted_set_none { s = s, p = p }

## Returns the first element matching the predicate, or None.
pub let find: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Option 'a <...> = { s, p } ->
  __native_sorted_set_find { s = s, p = p }

## Counts elements matching the predicate.
pub let count: { s: SortedSet 'a, p: { val: 'a } -> Bool <...> } -> Int <...> = { s, p } ->
  __native_sorted_set_count { s = s, p = p }

## Reduces elements to a single value, or returns None if empty.
pub let reduce
  : { s: SortedSet 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { s, f } -> __native_sorted_set_reduce { s = s, f = f }

## Sums all integer elements.
pub let sum: { s: SortedSet Int } -> Int = { s } -> __native_sorted_set_sum { s = s }

## Sums all float elements.
pub let sum_float: { s: SortedSet Float } -> Float = { s } ->
  __native_sorted_set_sum_float { s = s }

## Returns the product of all integer elements.
pub let product: { s: SortedSet Int } -> Int = { s } -> __native_sorted_set_product { s = s }

## Returns the product of all float elements.
pub let product_float: { s: SortedSet Float } -> Float = { s } ->
  __native_sorted_set_product_float { s = s }

## Converts to a Seq in sorted order.
pub let to_seq: { s: SortedSet 'a } -> ['a] = { s } -> __native_sorted_set_to_seq { s = s }

## Creates a sorted set from a Seq.
let from_seq_with_cmp: { xs: ['a], cmp: { a: 'a, b: 'a } -> Int } -> SortedSet 'a = { xs, cmp } ->
  __native_sorted_set_from_seq { xs = xs, cmp = cmp }

pub let from_seq: { xs: ['a] } with Ord 'a -> SortedSet 'a = { xs } ->
  from_seq_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Executes f for each element, for side effects only.
pub let for_each: { s: SortedSet 'a, f: { val: 'a } -> 'b <...> } -> {} <...> = { s, f } ->
  __native_sorted_set_for_each { s = s, f = f }

## Method implementations for SortedSet.
impl SortedSet 'a where {
  add = { it, x } -> add { s = it, x = x },
  remove = { it, x } -> remove { s = it, x = x },
  contains = { it, x } -> contains { s = it, x = x },
  union = { it, s2 } -> union { s1 = it, s2 = s2 },
  intersect = { it, s2 } -> intersect { s1 = it, s2 = s2 },
  difference = { it, s2 } -> difference { s1 = it, s2 = s2 },
  min = { it } -> min { s = it },
  max = { it } -> max { s = it },
  filter = { it, p } -> filter { s = it, p = p },
  map = { it, f } -> map { s = it, f = f },
  fold = { it, init, f } -> fold { s = it, init = init, f = f },
  any = { it, p } -> any { s = it, p = p },
  all = { it, p } -> all { s = it, p = p },
  find = { it, p } -> find { s = it, p = p },
  to_list = { it } -> to_list { s = it },
  to_set = { it } -> to_set { s = it },
  to_seq = { it } -> to_seq { s = it },

  ## dot-chain parity: an inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` always works.
  partition = { it, p } -> partition { s = it, p = p },
  min_by = { it, f } -> min_by { s = it, f = f },
  max_by = { it, f } -> max_by { s = it, f = f },
  take = { it, n } -> take { s = it, n = n },
  drop = { it, n } -> drop { s = it, n = n },
  range = { it, lo, hi } -> range { s = it, lo = lo, hi = hi },
  head_set = { it, to } -> head_set { s = it, to = to },
  tail_set = { it, from } -> tail_set { s = it, from = from },
  filter_map = { it, f } -> filter_map { set = it, f = f },
  collect_seq = { it, f } -> collect_seq { set = it, f = f },
  collect_list = { it, f } -> collect_list { set = it, f = f },
  none = { it, p } -> none { s = it, p = p },
  count = { it, p } -> count { s = it, p = p },
  reduce = { it, f } -> reduce { s = it, f = f },
  sum = { it } -> sum { s = it },
  sum_float = { it } -> sum_float { s = it },
  product = { it } -> product { s = it },
  product_float = { it } -> product_float { s = it },
  for_each = { it, f } -> for_each { s = it, f = f },
}

impl Sized for SortedSet 'a where {
  size = { it } -> size { s = it },
  is_empty = { it } -> is_empty { s = it },
}

## Collects an `Iter` into a SortedSet.
##
## `Iter` has seven ways IN -- `range`, `from_seq`, `from_list`, `unfold`,
## `once`, `empty`, and `.to_iter{}` on any of the seven types implementing
## `Iterable` -- and had only `to_seq`/`to_list` out, so reaching any other
## collection meant spelling the intermediate yourself.
##
## This is ERGONOMICS, not speed: it is what you would have written. `to_seq`
## hands its buffer to the sequence without copying it, so the intermediate is
## a wrapper around the buffer the sink had to fill anyway.
##
## Lives here rather than in `iter` because `sorted_set` imports `iter` for its
## `Iterable` impl, so the dependency only runs this way.
pub let from_iter: { it: Iter 'a } with Ord 'a -> SortedSet 'a = { it } ->
  from_seq { xs = iter::to_seq { it = it } }

impl Iterable for SortedSet 'a having 'elem = 'a where {
  to_iter = { it } -> iter::from_seq { xs = to_seq { s = it } }
}
