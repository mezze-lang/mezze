# std/collections/buffer.mezze - Mutable byte buffer for efficient streaming
#
# ByteBuffer is a mutable buffer for efficient streaming/building of binary data.
# It presents a functional API (returning the buffer) but mutates internally
# for O(1) amortized appends.
#
# Common use cases:
# - Streaming JSON serialization (avoids 2x memory peak)
# - Building binary protocols incrementally
# - Efficient concatenation of many byte sequences
#
# Performance characteristics:
# - new/empty: O(1)
# - write/write_byte/write_string: O(1) amortized
# - to_bytes: O(n) - copies to immutable Bytes
# - size/is_empty: O(1)
# - clear: O(1)
# === Construction ===
# Create a new buffer with the specified initial capacity
pub let new = { capacity } -> __native_buffer_new { capacity = capacity }
# Create an empty buffer with default capacity

pub let empty = {} -> __native_buffer_empty {}
# === Writing ===
# Write bytes to the buffer

pub let write = { buf, bytes } -> __native_buffer_write { buf = buf, bytes = bytes }
# Write a single byte (0-255) to the buffer

pub let write_byte = { buf, b } -> __native_buffer_write_byte { buf = buf, b = b }
# Write a UTF-8 string to the buffer

pub let write_string = { buf, s } -> __native_buffer_write_string { buf = buf, s = s }
# === Conversion ===
# Convert buffer contents to immutable Bytes
# This copies the data - the buffer can continue to be used

pub let to_bytes = { buf } -> __native_buffer_to_bytes { buf = buf }
# === Query ===
# Get the current size of the buffer in bytes

pub let size = { buf } -> __native_buffer_size { buf = buf }
# Check if the buffer is empty

pub let is_empty = { buf } -> __native_buffer_is_empty { buf = buf }
# === Mutation ===
# Clear the buffer (reset to empty state)
# The buffer can be reused after clearing

pub let clear = { buf } -> __native_buffer_clear { buf = buf }
