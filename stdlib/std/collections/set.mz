# std/collections/set.mezze - Set operations using HashSet

# Set 'a is a built-in type implemented using HashSet internally  
# No explicit type definition needed - handled by native runtime

# Basic set operations
pub let empty: {} -> Set 'a = {} ->
    __native_set_empty {}

pub let insert: { s: Set 'a, x: 'a } -> Set 'a = { s, x } ->
    __native_set_insert { s = s, x = x }

pub let remove: { s: Set 'a, x: 'a } -> Set 'a= { s, x } ->
    __native_set_remove { s = s, x = x }

pub let contains: { s: Set 'a, x: 'a } -> Bool= { s, x } ->
    __native_set_contains { s = s, x = x }

pub let size = { s: Set 'a } ->
    __native_set_size { s = s }

pub let is_empty = { s: Set 'a } ->
    size { s = s } == 0

# Set operations
pub let union: { s1: Set 'a, s2: Set 'a } -> Set 'a= {s1, s2} ->
    __native_set_union { s1 = s1, s2 = s2 }

pub let intersection: { s1: Set 'a, s2: Set 'a } -> Set 'a= {s1, s2} ->
    __native_set_intersection { s1 = s1, s2 = s2 }

pub let difference: { s1: Set 'a, s2: Set 'a } -> Set 'a= {s1, s2} ->
    __native_set_difference { s1 = s1, s2 = s2 }

# Set queries
pub let is_subset: { s1: Set 'a, s2: Set 'a } -> Bool= {s1, s2} ->
    __native_set_is_subset { s1 = s1, s2 = s2 }

pub let is_superset: { s1: Set 'a, s2: Set 'a } -> Bool= {s1, s2} ->
    is_subset { s1 = s2, s2 = s1 }

pub let is_disjoint: { s1: Set 'a, s2: Set 'a } -> Bool= {s1, s2} ->
    is_empty { s = intersection { s1 = s1, s2 = s2 } }

# Conversion functions - Array
pub let to_array: { s: Set 'a } -> ['a] = {s} ->
    __native_set_to_array { s = s }

pub let from_array: { xs: ['a] } -> Set 'a = { xs } ->
    __native_set_from_array { xs = xs }

# Conversion functions - List
pub let to_list: { s: Set 'a } -> (List 'a) = {s} ->
    __native_set_to_list { s = s }

pub let from_list: { xs: (List 'a) } -> Set 'a = { xs } ->
    __native_set_from_list { xs = xs }

# Higher-order functions
pub let filter: { s: Set 'a, p: { val: 'a } -> Bool } -> Set 'a = {s, p} ->
    __native_set_filter { s = s, p = p }

pub let map: { s: Set 'a, f: { val: 'a } -> 'b } -> Set 'b = {s, f} ->
    __native_set_map { s = s, f = f }

pub let fold: { s: Set 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc } -> 'acc = {s, init, f} ->
    __native_set_fold { s = s, init = init, f = f }

# Utility functions
pub let singleton: { x: 'a } -> Set 'a= {x} -> 
    insert { s = empty {}, x = x }

pub let insert_all: { s: Set 'a, xs: ['a] } -> Set 'a= {s, xs} ->
    __native_set_insert_all { s = s, xs = xs }

pub let remove_all: { s: Set 'a, xs: ['a] } -> Set 'a= {s, xs} ->
    __native_set_remove_all { s = s, xs = xs }

# Equality
pub let equals: { s1: Set 'a, s2: Set 'a } -> Bool = {s1, s2} ->
    __native_set_equals { s1 = s1, s2 = s2 }