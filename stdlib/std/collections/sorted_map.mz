use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::abilities::iter::{ Iterable }
use std::collections::iter
use std::int

## Default SortedMap is the empty sorted map.
impl Default for SortedMap 'k 'v where {
  default = {} -> empty {}
}

## Structural equality for sorted maps.
## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for SortedMap 'k 'v where {
  hash: { it: SortedMap 'k 'v } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for SortedMap 'k 'v where {
  eq = { it, r } -> __native_sorted_map_equals { m1 = it, m2 = r },
  neq = { it, r } -> if __native_sorted_map_equals { m1 = it, m2 = r } then False else True,
}

## Lexicographic ordering for sorted maps.
impl Ord for SortedMap 'k 'v where {
  lt: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    __native_sorted_map_compare { m1 = it, m2 = r } == (0 - 1),
  le: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    __native_sorted_map_compare { m1 = it, m2 = r } != 1,
  gt: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    __native_sorted_map_compare { m1 = it, m2 = r } == 1,
  ge: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    __native_sorted_map_compare { m1 = it, m2 = r } != (0 - 1),
}

## Creates an empty sorted map.
pub let empty: {} -> SortedMap 'k 'v = {} -> __native_sorted_map_empty {}

## Creates a sorted map with a single entry.
## Sorted containers carry the KEY's comparator from construction — see the note
## in sorted_set.mz. Each helper's  param is DECLARED so it ties to 'k.
let singleton_with_cmp
  : { k: 'k, v: 'v, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { k, v, cmp } ->
  __native_sorted_map_singleton { k = k, v = v, cmp = cmp }

pub let singleton: { k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { k, v } ->
  singleton_with_cmp { k = k, v = v, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Inserts a key-value pair, returning a new map.
let insert_with_cmp
  : { m: SortedMap 'k 'v, k: 'k, v: 'v, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { m, k, v, cmp } ->
  __native_sorted_map_insert { m = m, k = k, v = v, cmp = cmp }

pub let insert: { m: SortedMap 'k 'v, k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { m, k, v } ->
  insert_with_cmp { m = m, k = k, v = v, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns the value for the given key, or None.
let get_with_cmp
  : { m: SortedMap 'k 'v, k: 'k, cmp: { a: 'k, b: 'k } -> Int } -> Option 'v = { m, k, cmp } ->
  __native_sorted_map_get { m = m, k = k, cmp = cmp }

pub let get: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'v = { m, k } ->
  get_with_cmp { m = m, k = k, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Removes a key, returning a new map.
let remove_with_cmp
  : { m: SortedMap 'k 'v, k: 'k, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { m, k, cmp } ->
  __native_sorted_map_remove { m = m, k = k, cmp = cmp }

pub let remove: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> SortedMap 'k 'v = { m, k } ->
  remove_with_cmp { m = m, k = k, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns True if the key exists.
let contains_key_with_cmp
  : { m: SortedMap 'k 'v, k: 'k, cmp: { a: 'k, b: 'k } -> Int } -> Bool = { m, k, cmp } ->
  __native_sorted_map_contains_key { m = m, k = k, cmp = cmp }

pub let contains_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Bool = { m, k } ->
  contains_key_with_cmp { m = m, k = k, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns the number of entries.
pub let size: { m: SortedMap 'k 'v } -> Int = { m } -> __native_sorted_map_size { m = m }

## Returns True if the map has no entries.
pub let is_empty: { m: SortedMap 'k 'v } -> Bool = { m } -> __native_sorted_map_is_empty { m = m }

## Returns all keys in sorted order.
pub let keys: { m: SortedMap 'k 'v } -> List 'k = { m } -> __native_sorted_map_keys { m = m }

## Returns all values in key-sorted order.
pub let values: { m: SortedMap 'k 'v } -> List 'v = { m } -> __native_sorted_map_values { m = m }

## Returns all entries as {key, value} records in sorted order.
pub let entries: { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_entries { m = m }

## Returns the minimum key, or None if empty.
pub let min_key: { m: SortedMap 'k 'v } -> Option 'k = { m } ->
  __native_sorted_map_min_key { m = m }

## Returns the maximum key, or None if empty.
pub let max_key: { m: SortedMap 'k 'v } -> Option 'k = { m } ->
  __native_sorted_map_max_key { m = m }

## Returns the minimum entry as {key, value}, or None if empty.
pub let min_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_min_entry { m = m }

## Returns the maximum entry as {key, value}, or None if empty.
pub let max_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_max_entry { m = m }

## Creates a SortedMap from a regular Map.
let from_map_with_cmp
  : { m: Map 'k 'v, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { m, cmp } ->
  __native_sorted_map_from_map { m = m, cmp = cmp }

pub let from_map: { m: Map 'k 'v } with Ord 'k -> SortedMap 'k 'v = { m } ->
  from_map_with_cmp { m = m, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Converts to a regular Map.
pub let to_map: { m: SortedMap 'k 'v } -> Map 'k 'v = { m } ->
  __native_sorted_map_to_map { m = m }

## Returns True if the two sorted maps are equal.
pub let equals: { m1: SortedMap 'k 'v, m2: SortedMap 'k 'v } -> Bool = { m1, m2 } ->
  __native_sorted_map_equals { m1 = m1, m2 = m2 }

## Splits into entries matching and not matching the predicate.
pub let partition
  : { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> }
  -> { pass: SortedMap 'k 'v, fail: SortedMap 'k 'v } <...>
  = { m, p } -> __native_sorted_map_partition { m = m, p = p }

## Returns entries with keys in range [lo, hi] inclusive.
pub let range: { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k -> SortedMap 'k 'v = { m, lo, hi } ->
  __native_sorted_map_range { m = m, lo = lo, hi = hi }

## Returns the greatest key <= the given key, or None.
pub let floor_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } ->
  __native_sorted_map_floor_key { m = m, k = k }

## Returns the least key >= the given key, or None.
pub let ceiling_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } ->
  __native_sorted_map_ceiling_key { m = m, k = k }

## Returns entries with keys strictly less than the given key.
pub let head_map: { m: SortedMap 'k 'v, to: 'k } with Ord 'k -> SortedMap 'k 'v = { m, to } ->
  __native_sorted_map_head_map { m = m, to = to }

## Returns entries with keys >= the given key.
pub let tail_map: { m: SortedMap 'k 'v, from: 'k } with Ord 'k -> SortedMap 'k 'v = { m, from } ->
  __native_sorted_map_tail_map { m = m, from = from }

## Returns entries with keys in range [lo, hi).
pub let sub_map
  : { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k
  -> SortedMap 'k 'v
  = { m, lo, hi } -> __native_sorted_map_sub_map { m = m, lo = lo, hi = hi }

## Takes the first n entries in key-sorted order.
pub let take: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } ->
  __native_sorted_map_take { m = m, n = n }

## Drops the first n entries in key-sorted order.
pub let drop: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } ->
  __native_sorted_map_drop { m = m, n = n }

## Keeps only entries for which the predicate returns True.
pub let filter
  : { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter { m = m, p = p }

## Folds over entries in key-sorted order.
pub let fold
  : { m: SortedMap 'k 'v, init: 'acc, f: { acc: 'acc, k: 'k, v: 'v } -> 'acc <...> }
  -> 'acc <...>
  = { m, init, f } -> __native_sorted_map_fold { m = m, init = init, f = f }

## Transforms all values using f.
pub let map_values
  : { m: SortedMap 'k 'v, f: { val: 'v } -> 'w <...> }
  -> SortedMap 'k 'w <...>
  = { m, f } -> __native_sorted_map_map_values { m = m, f = f }

## Transforms all keys using f.
pub let map_keys
  : { m: SortedMap 'k 'v, f: { val: 'k } -> 'k2 <...> } with Ord 'k2
  -> SortedMap 'k2 'v <...>
  = { m, f } -> __native_sorted_map_map_keys { m = m, f = f }

## Keeps only entries where the key matches the predicate.
pub let filter_keys
  : { m: SortedMap 'k 'v, p: { val: 'k } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter_keys { m = m, p = p }

## Keeps only entries where the value matches the predicate.
pub let filter_values
  : { m: SortedMap 'k 'v, p: { val: 'v } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter_values { m = m, p = p }

## Swaps keys and values.
pub let invert: { m: SortedMap 'k 'v } with Ord 'v -> SortedMap 'v 'k = { m } ->
  __native_sorted_map_invert { m = m }

## Converts to a List of {k, v} records.
pub let to_list: { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_to_list { m = m }

## Creates a SortedMap from a List of {k, v} records.
let from_list_with_cmp
  : { xs: List { k: 'k, v: 'v }, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { xs, cmp } ->
  __native_sorted_map_from_list { xs = xs, cmp = cmp }

pub let from_list: { xs: List { k: 'k, v: 'v } } with Ord 'k -> SortedMap 'k 'v = { xs } ->
  from_list_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Method implementations for SortedMap.
impl SortedMap 'k 'v where {
  get = { it, k } -> get { m = it, k = k },
  insert = { it, k, v } -> insert { m = it, k = k, v = v },
  remove = { it, k } -> remove { m = it, k = k },
  contains_key = { it, k } -> contains_key { m = it, k = k },
  keys = { it } -> keys { m = it },
  values = { it } -> values { m = it },
  min_key = { it } -> min_key { m = it },
  max_key = { it } -> max_key { m = it },
  filter = { it, p } -> filter { m = it, p = p },
  fold = { it, init, f } -> fold { m = it, init = init, f = f },
  map_values = { it, f } -> map_values { m = it, f = f },
  to_map = { it } -> to_map { m = it },
  to_list = { it } -> to_list { m = it },

  ## dot-chain parity: an inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` always works.
  entries = { it } -> entries { m = it },
  min_entry = { it } -> min_entry { m = it },
  max_entry = { it } -> max_entry { m = it },
  partition = { it, p } -> partition { m = it, p = p },
  range = { it, lo, hi } -> range { m = it, lo = lo, hi = hi },
  floor_key = { it, k } -> floor_key { m = it, k = k },
  ceiling_key = { it, k } -> ceiling_key { m = it, k = k },
  head_map = { it, to } -> head_map { m = it, to = to },
  tail_map = { it, from } -> tail_map { m = it, from = from },
  sub_map = { it, lo, hi } -> sub_map { m = it, lo = lo, hi = hi },
  take = { it, n } -> take { m = it, n = n },
  drop = { it, n } -> drop { m = it, n = n },
  map_keys = { it, f } -> map_keys { m = it, f = f },
  filter_keys = { it, p } -> filter_keys { m = it, p = p },
  filter_values = { it, p } -> filter_values { m = it, p = p },
  invert = { it } -> invert { m = it },
}

impl Sized for SortedMap 'k 'v where {
  size = { it } -> size { m = it },
  is_empty = { it } -> is_empty { m = it },
}

impl Iterable for SortedMap 'k 'v having 'elem = { k: 'k, v: 'v } where {
  to_iter = { it } -> iter::from_list { xs = to_list { m = it } }
}
