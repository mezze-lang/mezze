use std::abilities::compare::{ Eq, Ord }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::int

## Default SortedMap is the empty sorted map.
impl Default for SortedMap 'k 'v where {
  default = {} -> empty {}
}

## Structural equality for sorted maps.
impl Eq 'k 'v for SortedMap 'k 'v where {
  eq = { it, r } -> __native_sorted_map_equals { m1 = it, m2 = r },
  neq = { it, r } -> if __native_sorted_map_equals { m1 = it, m2 = r } then False else True,
}

## Lexicographic ordering for sorted maps.
impl Ord 'k 'v for SortedMap 'k 'v where {
  lt = { it, r } -> __native_sorted_map_compare { m1 = it, m2 = r } == (0 - 1),
  le = { it, r } -> __native_sorted_map_compare { m1 = it, m2 = r } != 1,
  gt = { it, r } -> __native_sorted_map_compare { m1 = it, m2 = r } == 1,
  ge = { it, r } -> __native_sorted_map_compare { m1 = it, m2 = r } != (0 - 1),
}

## Creates an empty sorted map.
pub let empty: {} -> SortedMap 'k 'v = {} -> __native_sorted_map_empty {}

## Creates a sorted map with a single entry.
pub let singleton: { k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { k, v } -> __native_sorted_map_singleton { k = k, v = v }

## Inserts a key-value pair, returning a new map.
pub let insert: { m: SortedMap 'k 'v, k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { m, k, v } -> __native_sorted_map_insert { m = m, k = k, v = v }

## Returns the value for the given key, or None.
pub let get: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'v = { m, k } -> __native_sorted_map_get { m = m, k = k }

## Removes a key, returning a new map.
pub let remove: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> SortedMap 'k 'v = { m, k } -> __native_sorted_map_remove { m = m, k = k }

## Returns True if the key exists.
pub let contains_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Bool = { m, k } -> __native_sorted_map_contains_key { m = m, k = k }

## Returns the number of entries.
pub let size: { m: SortedMap 'k 'v } -> Int = { m } -> __native_sorted_map_size { m = m }

## Returns True if the map has no entries.
pub let is_empty: { m: SortedMap 'k 'v } -> Bool = { m } -> __native_sorted_map_is_empty { m = m }

## Returns all keys in sorted order.
pub let keys: { m: SortedMap 'k 'v } -> List 'k = { m } -> __native_sorted_map_keys { m = m }

## Returns all values in key-sorted order.
pub let values: { m: SortedMap 'k 'v } -> List 'v = { m } -> __native_sorted_map_values { m = m }

## Returns all entries as {key, value} records in sorted order.
pub let entries: { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } -> __native_sorted_map_entries { m = m }

## Returns the minimum key, or None if empty.
pub let min_key: { m: SortedMap 'k 'v } -> Option 'k = { m } -> __native_sorted_map_min_key { m = m }

## Returns the maximum key, or None if empty.
pub let max_key: { m: SortedMap 'k 'v } -> Option 'k = { m } -> __native_sorted_map_max_key { m = m }

## Returns the minimum entry as {key, value}, or None if empty.
pub let min_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } -> __native_sorted_map_min_entry { m = m }

## Returns the maximum entry as {key, value}, or None if empty.
pub let max_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } -> __native_sorted_map_max_entry { m = m }

## Creates a SortedMap from a regular Map.
pub let from_map: { m: Map 'k 'v } with Ord 'k -> SortedMap 'k 'v = { m } -> __native_sorted_map_from_map { m = m }

## Converts to a regular Map.
pub let to_map: { m: SortedMap 'k 'v } -> Map 'k 'v = { m } -> __native_sorted_map_to_map { m = m }

## Returns True if the two sorted maps are equal.
pub let equals: { m1: SortedMap 'k 'v, m2: SortedMap 'k 'v } -> Bool = { m1, m2 } -> __native_sorted_map_equals { m1 = m1, m2 = m2 }

## Splits into entries matching and not matching the predicate.
pub let partition: { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> { pass: SortedMap 'k 'v, fail: SortedMap 'k 'v } <...> = { m, p } -> __native_sorted_map_partition { m = m, p = p }

## Returns entries with keys in range [lo, hi] inclusive.
pub let range: { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k -> SortedMap 'k 'v = { m, lo, hi } -> __native_sorted_map_range { m = m, lo = lo, hi = hi }

## Returns the greatest key <= the given key, or None.
pub let floor_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } -> __native_sorted_map_floor_key { m = m, k = k }

## Returns the least key >= the given key, or None.
pub let ceiling_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } -> __native_sorted_map_ceiling_key { m = m, k = k }

## Returns entries with keys strictly less than the given key.
pub let head_map: { m: SortedMap 'k 'v, to: 'k } with Ord 'k -> SortedMap 'k 'v = { m, to } -> __native_sorted_map_head_map { m = m, to = to }

## Returns entries with keys >= the given key.
pub let tail_map: { m: SortedMap 'k 'v, from: 'k } with Ord 'k -> SortedMap 'k 'v = { m, from } -> __native_sorted_map_tail_map { m = m, from = from }

## Returns entries with keys in range [lo, hi).
pub let sub_map: { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k -> SortedMap 'k 'v = { m, lo, hi } -> __native_sorted_map_sub_map { m = m, lo = lo, hi = hi }

## Takes the first n entries in key-sorted order.
pub let take: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } -> __native_sorted_map_take { m = m, n = n }

## Drops the first n entries in key-sorted order.
pub let drop: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } -> __native_sorted_map_drop { m = m, n = n }

## Keeps only entries for which the predicate returns True.
pub let filter : { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> SortedMap 'k 'v <...> = { m, p } ->
  __native_sorted_map_filter { m = m, p = p }

## Folds over entries in key-sorted order.
pub let fold : { m: SortedMap 'k 'v, init: 'acc, f: { acc: 'acc, k: 'k, v: 'v } -> 'acc <...> } -> 'acc <...> = { m, init, f } ->
  __native_sorted_map_fold { m = m, init = init, f = f }

## Transforms all values using f.
pub let map_values : { m: SortedMap 'k 'v, f: { val: 'v } -> 'w <...> } -> SortedMap 'k 'w <...> = { m, f } ->
  __native_sorted_map_map_values { m = m, f = f }

## Transforms all keys using f.
pub let map_keys : { m: SortedMap 'k 'v, f: { val: 'k } -> 'k2 <...> } with Ord 'k2 -> SortedMap 'k2 'v <...> = { m, f } ->
  __native_sorted_map_map_keys { m = m, f = f }

## Keeps only entries where the key matches the predicate.
pub let filter_keys : { m: SortedMap 'k 'v, p: { val: 'k } -> Bool <...> } -> SortedMap 'k 'v <...> = { m, p } ->
  __native_sorted_map_filter_keys { m = m, p = p }

## Keeps only entries where the value matches the predicate.
pub let filter_values : { m: SortedMap 'k 'v, p: { val: 'v } -> Bool <...> } -> SortedMap 'k 'v <...> = { m, p } ->
  __native_sorted_map_filter_values { m = m, p = p }

## Swaps keys and values.
pub let invert : { m: SortedMap 'k 'v } with Ord 'v -> SortedMap 'v 'k = { m } ->
  __native_sorted_map_invert { m = m }

## Converts to a List of {k, v} records.
pub let to_list : { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_to_list { m = m }

## Creates a SortedMap from a List of {k, v} records.
pub let from_list : { xs: List { k: 'k, v: 'v } } with Ord 'k -> SortedMap 'k 'v = { xs } ->
  __native_sorted_map_from_list { xs = xs }

## Method implementations for SortedMap.
impl SortedMap 'k 'v where {
  get = { it, k } -> get { m = it, k = k },
  insert = { it, k, v } -> insert { m = it, k = k, v = v },
  remove = { it, k } -> remove { m = it, k = k },
  contains_key = { it, k } -> contains_key { m = it, k = k },
  size = { it } -> size { m = it },
  is_empty = { it } -> is_empty { m = it },
  keys = { it } -> keys { m = it },
  values = { it } -> values { m = it },
  min_key = { it } -> min_key { m = it },
  max_key = { it } -> max_key { m = it },
  filter = { it, p } -> filter { m = it, p = p },
  fold = { it, init, f } -> fold { m = it, init = init, f = f },
  map_values = { it, f } -> map_values { m = it, f = f },
  to_map = { it } -> to_map { m = it },
  to_list = { it } -> to_list { m = it },
}

impl Sized 'k 'v for SortedMap 'k 'v where {
  size = { it } -> size { m = it },
  is_empty = { it } -> is_empty { m = it },
}
