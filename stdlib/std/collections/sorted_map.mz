use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::abilities::iter::{ Iterable }
use std::collections::iter
use std::int

## Default SortedMap is the empty sorted map.
impl Default for SortedMap 'k 'v where {
  default = {} -> empty {}
}

# `Eq` and `Hash` are written together: a hash disagreeing with equality keeps a value twice.
## Structural hash for sorted maps, paired with the `Eq` below.
impl Hash for SortedMap 'k 'v where {
  hash: { it: SortedMap 'k 'v } -> Int = { it } -> structural_hash { it = it }
}

## Entry-wise equality: keys by the map's ordered lookup, values by the threaded `eq`.
let sorted_map_equals_with_eq
  : { m1: SortedMap 'k 'v, m2: SortedMap 'k 'v, eq: { a: 'v, b: 'v } -> Bool } -> Bool = { m1, m2, eq } ->
  __native_sorted_map_equals { m1 = m1, m2 = m2, eq = eq }

## Structural equality for sorted maps.
impl Eq for SortedMap 'k 'v where {
  eq: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Eq 'k, Eq 'v -> Bool = { it, r } ->
    sorted_map_equals_with_eq { m1 = it, m2 = r, eq = { a, b } -> a == b },
  neq: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Eq 'k, Eq 'v -> Bool = { it, r } ->
    if sorted_map_equals_with_eq { m1 = it, m2 = r, eq = { a, b } -> a == b } then False else True,
}

## Lexicographic comparison: keys by the map's own ordering, values by the threaded `cmp`.
let sorted_map_compare_with_cmp
  : { m1: SortedMap 'k 'v, m2: SortedMap 'k 'v, cmp: { a: 'v, b: 'v } -> Int } -> Int = { m1, m2, cmp } ->
  __native_sorted_map_compare { m1 = m1, m2 = m2, cmp = cmp }

## Lexicographic ordering for sorted maps.
impl Ord for SortedMap 'k 'v where {
  lt: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    sorted_map_compare_with_cmp { m1 = it, m2 = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == (0 - 1),
  le: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    sorted_map_compare_with_cmp { m1 = it, m2 = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != 1,
  gt: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    sorted_map_compare_with_cmp { m1 = it, m2 = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == 1,
  ge: { it: SortedMap 'k 'v, r: SortedMap 'k 'v } with Ord 'k, Ord 'v -> Bool = { it, r } ->
    sorted_map_compare_with_cmp { m1 = it, m2 = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != (0 - 1),
}

## Creates an empty sorted map.
pub let empty: {} -> SortedMap 'k 'v = {} -> __native_sorted_map_empty {}

# Sorted containers carry the key's comparator from construction; the param is declared to tie it to 'k.
let singleton_with_cmp
  : { k: 'k, v: 'v, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { k, v, cmp } ->
  __native_sorted_map_singleton { k = k, v = v, cmp = cmp }

## Creates a sorted map with a single entry.
pub let singleton: { k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { k, v } ->
  singleton_with_cmp { k = k, v = v, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

# Finishes `insert` from one guest search (`find_index`: index, or `-(insertPos + 1)`).
# A separate helper because a `do`-block `let` would detach `insert`'s `Ord` (see `find_index`).
let insert_at_slot: { m: SortedMap 'k 'v, k: 'k, v: 'v, idx: Int } -> SortedMap 'k 'v = { m, k, v, idx } ->
  if idx < 0
    then __native_sorted_map_insert_at { m = m, i = 0 - idx - 1, k = k, v = v }
    else __native_sorted_map_set_at { m = m, i = idx, v = v }

## Returns a new map with the entry inserted; an existing key's value is replaced.
pub let insert: { m: SortedMap 'k 'v, k: 'k, v: 'v } with Ord 'k -> SortedMap 'k 'v = { m, k, v } ->
  insert_at_slot { m = m, k = k, v = v,
                   idx = find_index { m = m, k = k, lo = 0,
                                      hi = __native_sorted_map_size { m = m } - 1 } }

# ── Ordered lookups run in the guest, not the native ──
# A native search calls back into the guest per comparison (~300 ns a lookup); a guest `<` inlines.
# Index must stay in [0, size), which `find_index` maintains — hence private.
let key_at: { m: SortedMap 'k 'v, i: Int } -> 'k = { m, i } ->
  __native_sorted_map_key_at { m = m, i = i }

let value_at: { m: SortedMap 'k 'v, i: Int } -> 'v = { m, i } ->
  __native_sorted_map_value_at { m = m, i = i }

# Index of `k`, or `-(insertPos + 1)` if absent (Java binarySearch encoding). NO `do`-block `let`:
# it generalizes the probed key so `Ord` misses `'k` and the annotation is refused; hence
# `(lo + hi) / 2` written out. Stored key on the left, probe on the right, as the native did.
let find_index = { m, k, lo, hi } ->
  if lo > hi then 0 - lo - 1
  else if key_at { m = m, i = (lo + hi) / 2 } < k
    then find_index { m = m, k = k, lo = (lo + hi) / 2 + 1, hi = hi }
  else if k < key_at { m = m, i = (lo + hi) / 2 }
    then find_index { m = m, k = k, lo = lo, hi = (lo + hi) / 2 - 1 }
  else (lo + hi) / 2

# Separate from `get`: a `do`-block `let` would detach its `Ord` (see `find_index`).
## Turns a search result into an Option.
let value_or_none: { m: SortedMap 'k 'v, idx: Int } -> Option 'v = { m, idx } ->
  if idx < 0 then None else Some { val = value_at { m = m, i = idx } }

## Returns the value for the given key, or None.
pub let get: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'v = { m, k } ->
  value_or_none { m = m,
                  idx = find_index { m = m, k = k, lo = 0,
                                     hi = __native_sorted_map_size { m = m } - 1 } }

# Guest search; an absent key never reaches the native. Separate helper as for `insert_at_slot`.
let remove_at_slot: { m: SortedMap 'k 'v, idx: Int } -> SortedMap 'k 'v = { m, idx } ->
  if idx < 0
    then m
    else __native_sorted_map_remove_at { m = m, i = idx }

## Returns a new map without the key; an absent key returns the map unchanged.
pub let remove: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> SortedMap 'k 'v = { m, k } ->
  remove_at_slot { m = m,
                   idx = find_index { m = m, k = k, lo = 0,
                                      hi = __native_sorted_map_size { m = m } - 1 } }

# Pins the search result to Int; otherwise `>= 0` raises an Ord on a numeric type variable
# that `contains_key`'s annotation cannot name.
let found_at: { idx: Int } -> Bool = { idx } -> idx >= 0

## Returns True if the key exists.
pub let contains_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Bool = { m, k } ->
  found_at { idx = find_index { m = m, k = k, lo = 0,
                                hi = __native_sorted_map_size { m = m } - 1 } }

## Returns the number of entries.
pub let size: { m: SortedMap 'k 'v } -> Int = { m } -> __native_sorted_map_size { m = m }

## Returns True if the map has no entries.
pub let is_empty: { m: SortedMap 'k 'v } -> Bool = { m } -> __native_sorted_map_is_empty { m = m }

## Returns all keys in sorted order.
pub let keys: { m: SortedMap 'k 'v } -> List 'k = { m } -> __native_sorted_map_keys { m = m }

## Returns all values in key-sorted order.
pub let values: { m: SortedMap 'k 'v } -> List 'v = { m } -> __native_sorted_map_values { m = m }

## Returns all entries as {key, value} records in sorted order.
pub let entries: { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_entries { m = m }

## Returns the minimum key, or None if empty.
pub let min_key: { m: SortedMap 'k 'v } -> Option 'k = { m } ->
  __native_sorted_map_min_key { m = m }

## Returns the maximum key, or None if empty.
pub let max_key: { m: SortedMap 'k 'v } -> Option 'k = { m } ->
  __native_sorted_map_max_key { m = m }

## Returns the minimum entry as {key, value}, or None if empty.
pub let min_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_min_entry { m = m }

## Returns the maximum entry as {key, value}, or None if empty.
pub let max_entry: { m: SortedMap 'k 'v } -> Option { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_max_entry { m = m }

let from_map_with_cmp
  : { m: Map 'k 'v, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { m, cmp } ->
  __native_sorted_map_from_map { m = m, cmp = cmp }

## Creates a SortedMap from a regular Map.
pub let from_map: { m: Map 'k 'v } with Ord 'k -> SortedMap 'k 'v = { m } ->
  from_map_with_cmp { m = m, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

# `Eq 'k, Hash 'k`: the result is hashed, so the key's own equality applies, not `Ord`.
## Converts to a regular Map, whose keys are compared by their `Eq` and `Hash`.
pub let to_map: { m: SortedMap 'k 'v } with Eq 'k, Hash 'k -> Map 'k 'v = { m } ->
  __native_sorted_map_to_map { m = m }

pub let to_map_with_evidence:
  { m: SortedMap 'k 'v, hash: { it: 'k } -> Int, eq: { it: 'k, r: 'k } -> Bool }
  -> Map 'k 'v =
  { m, hash, eq } -> __native_sorted_map_to_map_with_evidence { m = m, hash = hash, eq = eq }

## Returns True if the two sorted maps are equal.
pub let equals: { m1: SortedMap 'k 'v, m2: SortedMap 'k 'v } with Eq 'k, Eq 'v -> Bool = { m1, m2 } ->
  sorted_map_equals_with_eq { m1 = m1, m2 = m2, eq = { a, b } -> a == b }

## Splits into entries matching and not matching the predicate.
pub let partition
  : { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> }
  -> { pass: SortedMap 'k 'v, fail: SortedMap 'k 'v } <...>
  = { m, p } -> __native_sorted_map_partition { m = m, p = p }

# ── Slices and neighbours: index arithmetic over the guest search ──
# The map stores no usable comparator (a user `Ord` threw ClassCastException; SortedOrderOpsOrdTest).
let count_below: { idx: Int } -> Int = { idx } -> if idx < 0 then 0 - idx - 1 else idx

let count_upto: { idx: Int } -> Int = { idx } -> if idx < 0 then 0 - idx - 1 else idx + 1

# One native copies a contiguous run with no comparison, clamping its own ends.
## Entries at positions `[from, to)` of the sort order; empty when the ends cross.
let slice: { m: SortedMap 'k 'v, from: Int, to: Int } -> SortedMap 'k 'v = { m, from, to } ->
  __native_sorted_map_slice { m = m, from = from, to = to }

let key_at_or_none: { m: SortedMap 'k 'v, n: Int } -> Option 'k = { m, n } ->
  if n < 0 then None
  else if n >= __native_sorted_map_size { m = m } then None
  else Some { val = key_at { m = m, i = n } }

## Returns entries with keys in range [lo, hi] inclusive.
pub let range: { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k -> SortedMap 'k 'v = { m, lo, hi } ->
  slice { m = m,
          from = count_below { idx = find_index { m = m, k = lo, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } },
          to = count_upto { idx = find_index { m = m, k = hi, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } }

## Returns the greatest key <= the given key, or None.
pub let floor_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } ->
  key_at_or_none { m = m,
                   n = count_upto { idx = find_index { m = m, k = k, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } - 1 }

## Returns the least key >= the given key, or None.
pub let ceiling_key: { m: SortedMap 'k 'v, k: 'k } with Ord 'k -> Option 'k = { m, k } ->
  key_at_or_none { m = m,
                   n = count_below { idx = find_index { m = m, k = k, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } }

## Returns entries with keys strictly less than the given key.
pub let head_map: { m: SortedMap 'k 'v, to: 'k } with Ord 'k -> SortedMap 'k 'v = { m, to } ->
  slice { m = m, from = 0,
    to = count_below { idx = find_index { m = m, k = to, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } }

## Returns entries with keys >= the given key.
pub let tail_map: { m: SortedMap 'k 'v, from: 'k } with Ord 'k -> SortedMap 'k 'v = { m, from } ->
  slice { m = m, to = __native_sorted_map_size { m = m },
    from = count_below { idx = find_index { m = m, k = from, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } }

## Returns entries with keys in range [lo, hi).
pub let sub_map
  : { m: SortedMap 'k 'v, lo: 'k, hi: 'k } with Ord 'k
  -> SortedMap 'k 'v
  = { m, lo, hi } ->
  slice { m = m,
          from = count_below { idx = find_index { m = m, k = lo, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } },
          to = count_below { idx = find_index { m = m, k = hi, lo = 0, hi = __native_sorted_map_size { m = m } - 1 } } }

## Takes the first n entries in key-sorted order.
pub let take: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } ->
  slice { m = m, from = 0, to = n }

## Drops the first n entries in key-sorted order.
pub let drop: { m: SortedMap 'k 'v, n: Int } -> SortedMap 'k 'v = { m, n } ->
  slice { m = m, from = n, to = __native_sorted_map_size { m = m } }

## Keeps only entries for which the predicate returns True.
pub let filter
  : { m: SortedMap 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter { m = m, p = p }

# `FoldToSumRewriter` targets this for `fold { init = 0, f = { acc, k, v } -> acc + v }`,
# removing the per-element guest call (95% of the fold's cost).
## Sums the values.
pub let sum_values: { m: SortedMap 'k Int } -> Int = { m } ->
  __native_sorted_map_sum_values { m = m }

## Folds over entries in key-sorted order.
pub let fold
  : { m: SortedMap 'k 'v, init: 'acc, f: { acc: 'acc, k: 'k, v: 'v } -> 'acc <...> }
  -> 'acc <...>
  = { m, init, f } -> __native_sorted_map_fold { m = m, init = init, f = f }

## Transforms all values using f.
pub let map_values
  : { m: SortedMap 'k 'v, f: { val: 'v } -> 'w <...> }
  -> SortedMap 'k 'w <...>
  = { m, f } -> __native_sorted_map_map_values { m = m, f = f }

## Transforms all keys using f.
let map_keys_with_cmp
  : { m: SortedMap 'k 'v, f: { val: 'k } -> 'k2 <...>, cmp: { a: 'k2, b: 'k2 } -> Int }
  -> SortedMap 'k2 'v <...>
  = { m, f, cmp } -> __native_sorted_map_map_keys { m = m, f = f, cmp = cmp }

# The keys are a new type, so `Ord 'k2` must be threaded, not just declared
# (when not passed on, the result was naturally ordered and `get` missed keys).
## Transforms all keys using f. The result is ordered by the new keys' `Ord`.
pub let map_keys
  : { m: SortedMap 'k 'v, f: { val: 'k } -> 'k2 <...> } with Ord 'k2
  -> SortedMap 'k2 'v <...>
  = { m, f } -> map_keys_with_cmp { m = m, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Keeps only entries where the key matches the predicate.
pub let filter_keys
  : { m: SortedMap 'k 'v, p: { val: 'k } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter_keys { m = m, p = p }

## Keeps only entries where the value matches the predicate.
pub let filter_values
  : { m: SortedMap 'k 'v, p: { val: 'v } -> Bool <...> }
  -> SortedMap 'k 'v <...>
  = { m, p } -> __native_sorted_map_filter_values { m = m, p = p }

## Swaps keys and values.
let invert_with_cmp
  : { m: SortedMap 'k 'v, cmp: { a: 'v, b: 'v } -> Int } -> SortedMap 'v 'k
  = { m, cmp } -> __native_sorted_map_invert { m = m, cmp = cmp }

# As `map_keys`: the new keys are the old values, so `Ord 'v` is threaded.
## Swaps keys and values. The result is ordered by the values' `Ord`.
pub let invert: { m: SortedMap 'k 'v } with Ord 'v -> SortedMap 'v 'k = { m } ->
  invert_with_cmp { m = m, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Converts to a List of {k, v} records.
pub let to_list: { m: SortedMap 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_sorted_map_to_list { m = m }

let from_list_with_cmp
  : { xs: List { k: 'k, v: 'v }, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { xs, cmp } ->
  __native_sorted_map_from_list { xs = xs, cmp = cmp }

## Creates a SortedMap from a List of {k, v} records.
pub let from_list: { xs: List { k: 'k, v: 'v } } with Ord 'k -> SortedMap 'k 'v = { xs } ->
  from_list_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Method implementations for SortedMap.
impl SortedMap 'k 'v where {
  get = { it, k } -> get { m = it, k = k },
  insert = { it, k, v } -> insert { m = it, k = k, v = v },
  remove = { it, k } -> remove { m = it, k = k },
  contains_key = { it, k } -> contains_key { m = it, k = k },
  keys = { it } -> keys { m = it },
  values = { it } -> values { m = it },
  min_key = { it } -> min_key { m = it },
  max_key = { it } -> max_key { m = it },
  filter = { it, p } -> filter { m = it, p = p },
  fold = { it, init, f } -> fold { m = it, init = init, f = f },
  map_values = { it, f } -> map_values { m = it, f = f },
  to_map = { it } -> to_map { m = it },
  to_list = { it } -> to_list { m = it },

  # dot-chain parity: an inherent method for every receiver-taking free
  # function not already covered by an ability, so `x.op {}` always works.
  entries = { it } -> entries { m = it },
  min_entry = { it } -> min_entry { m = it },
  max_entry = { it } -> max_entry { m = it },
  partition = { it, p } -> partition { m = it, p = p },
  range = { it, lo, hi } -> range { m = it, lo = lo, hi = hi },
  floor_key = { it, k } -> floor_key { m = it, k = k },
  ceiling_key = { it, k } -> ceiling_key { m = it, k = k },
  head_map = { it, to } -> head_map { m = it, to = to },
  tail_map = { it, from } -> tail_map { m = it, from = from },
  sub_map = { it, lo, hi } -> sub_map { m = it, lo = lo, hi = hi },
  take = { it, n } -> take { m = it, n = n },
  drop = { it, n } -> drop { m = it, n = n },
  map_keys = { it, f } -> map_keys { m = it, f = f },
  filter_keys = { it, p } -> filter_keys { m = it, p = p },
  filter_values = { it, p } -> filter_values { m = it, p = p },
  invert = { it } -> invert { m = it },
}

impl Sized for SortedMap 'k 'v where {
  size = { it } -> size { m = it },
  is_empty = { it } -> is_empty { m = it },
}

# Ergonomics, not speed. Lives here, not in `iter`, since `sorted_map` already imports `iter`.
## Collects an `Iter` of {k, v} records into a SortedMap.
pub let from_iter: { it: Iter { k: 'k, v: 'v } } with Ord 'k -> SortedMap 'k 'v = { it } ->
  from_list { xs = iter::to_list { it = it } }

impl Iterable for SortedMap 'k 'v having 'elem = { k: 'k, v: 'v } where {
  to_iter = { it } -> iter::from_list { xs = to_list { m = it } }
}
