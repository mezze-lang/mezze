# std/collections/array.mezze - Array operations
# Note: Arrays (['a]) use ArrayList at runtime with native arraylist functions

# Basic array operations (defined first for use by other functions)
pub let length = {xs} ->
    __native_arraylist_length { xs = xs }

pub let get = {xs, i} ->
    __native_arraylist_get { xs = xs, i = i }

pub let set = {xs, i, x} ->
    __native_arraylist_set { xs = xs, i = i, x = x }

pub let add = {xs, x} ->
    __native_arraylist_add { xs = xs, x = x }

pub let remove = {xs, i} ->
    __native_arraylist_remove { xs = xs, i = i }

pub let concat = {xs, ys} ->
    __native_arraylist_concat { xs = xs, ys = ys }

# Array construction (uses add and concat above)
pub let of = {x, xs} ->
    concat { xs = add { xs = [], x = x }, ys = xs }

pub let is_empty = {xs} ->
    __native_arraylist_is_empty { xs = xs }

# Higher-order functions
pub let map = {xs, f} ->
    __native_arraylist_map { xs = xs, f = f }

pub let filter = {xs, p} ->
    __native_arraylist_filter { xs = xs, p = p }

pub let fold = {xs, init, f} ->
    __native_arraylist_fold { xs = xs, init = init, f = f }

pub let reduce = {xs, f} ->
    __native_arraylist_reduce { xs = xs, f = f }

# Utility functions
pub let find = {xs, p} ->
    __native_arraylist_find { xs = xs, p = p }

pub let contains = {xs, x} ->
    __native_arraylist_contains { xs = xs, x = x }

pub let index_of = {xs, x} ->
    __native_arraylist_index_of { xs = xs, x = x }

pub let reverse = {xs} ->
    __native_arraylist_reverse { xs = xs }

pub let sort = {xs} ->
    __native_arraylist_sort { xs = xs }

pub let sort_by = {xs, cmp} ->
    __native_arraylist_sort_by { xs = xs, cmp = cmp }

# Slicing operations
pub let slice = {xs, start, end} ->
    __native_arraylist_slice { xs = xs, start = start, end = end }

pub let take = {xs, n} ->
    slice { xs = xs, start = 0, end = n }

pub let drop = {xs, n} ->
    slice { xs = xs, start = n, end = length { xs = xs } }

pub let head = {xs} ->
    get { xs = xs, i = 0 }

pub let tail = {xs} ->
    drop { xs = xs, n = 1 }

# Equality
pub let equals = {l, r} ->
    __native_arraylist_equals { l = l, r = r }

# =============================================================================
# Zip Operations
# =============================================================================

# Zip two arrays together into array of records {fst, snd}
# Truncates to the shorter array length
# Example: zip {xs = [1, 2], ys = ["a", "b"]} -> [{fst = 1, snd = "a"}, {fst = 2, snd = "b"}]
pub let zip = {xs, ys} ->
    __native_arraylist_zip { xs = xs, ys = ys }

# Unzip array of records into two arrays
# Example: unzip {xs = [{fst = 1, snd = "a"}]} -> {fsts = [1], snds = ["a"]}
pub let unzip = {xs} ->
    __native_arraylist_unzip { xs = xs }

# =============================================================================
# Flatten
# =============================================================================

# Flatten nested arrays into a single array
# Example: flatten {xss = [[1, 2], [3, 4]]} -> [1, 2, 3, 4]
pub let flatten = {xss} ->
    __native_arraylist_flatten { xss = xss }

# =============================================================================
# Predicate Functions
# =============================================================================

# Check if any element matches the predicate
# Example: any {xs = [1, 2, 3], p = {x} -> x > 2} -> True
pub let any = {xs, p} ->
    __native_arraylist_any { xs = xs, p = p }

# Check if all elements match the predicate
# Example: all {xs = [2, 4, 6], p = {x} -> x % 2 == 0} -> True
pub let all = {xs, p} ->
    __native_arraylist_all { xs = xs, p = p }

# =============================================================================
# Partition
# =============================================================================

# Partition array into matching and non-matching elements
# Example: partition {xs = [1, 2, 3, 4], p = {x} -> x > 2} -> {matching = [3, 4], not_matching = [1, 2]}
pub let partition = {xs, p} ->
    __native_arraylist_partition { xs = xs, p = p }

# =============================================================================
# Index Operations
# =============================================================================

# Find index of first element matching predicate
# Example: find_index {xs = [1, 2, 3], p = {x} -> x > 1} -> Some {val = 1}
pub let find_index = {xs, p} ->
    __native_arraylist_find_index { xs = xs, p = p }

# =============================================================================
# Additional Accessors
# =============================================================================

# Get last element of array
# Example: last {xs = [1, 2, 3]} -> Some {val = 3}
pub let last = {xs} ->
    __native_arraylist_last { xs = xs }

# Get all elements except the last
# Example: init {xs = [1, 2, 3]} -> [1, 2]
pub let init = {xs} ->
    __native_arraylist_init { xs = xs }

# =============================================================================
# Deduplication
# =============================================================================

# Remove duplicate elements (keeps first occurrence)
# Example: unique {xs = [1, 2, 1, 3, 2]} -> [1, 2, 3]
pub let unique = {xs} ->
    __native_arraylist_unique { xs = xs }
