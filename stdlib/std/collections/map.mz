use std::abilities::compare::{ Eq }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::int

## Default Map is the empty map.
impl Default for Map 'k 'v where {
  default = {} -> empty {}
}

## Structural equality for maps.
impl Eq for Map 'k 'v where {
  eq = { it, r } -> __native_map_equals { m1 = it, m2 = r },
  neq = { it, r } -> if __native_map_equals { m1 = it, m2 = r } then False else True,
}

## Creates an empty map.
pub let empty : {} -> Map 'k 'v = {} -> __native_map_empty {}

## Inserts a key-value pair, returning a new map.
pub let insert : { m: Map 'k 'v, k: 'k, v: 'v } -> Map 'k 'v = { m, k, v } ->
  __native_map_insert { m = m, k = k, v = v }

## Returns the value for the given key, or None.
pub let get : { m: Map 'k 'v, k: 'k } -> Option 'v = { m, k } -> __native_map_get { m = m, k = k }

## Removes a key, returning a new map.
pub let remove : { m: Map 'k 'v, k: 'k } -> Map 'k 'v = { m, k } ->
  __native_map_remove { m = m, k = k }

## Returns True if the key exists in the map.
pub let contains_key : { m: Map 'k 'v, k: 'k } -> Bool = { m, k } ->
  __native_map_contains_key { m = m, k = k }

## Returns the number of entries.
pub let size : { m: Map 'k 'v } -> Int = { m } -> __native_map_size { m = m }

## Returns True if the map has no entries.
pub let is_empty : { m: Map 'k 'v } -> Bool = { m } -> size { m = m } == 0

## Returns all keys as a List.
pub let keys : { m: Map 'k 'v } -> List 'k = { m } -> __native_map_keys { m = m }

## Returns all values as a List.
pub let values : { m: Map 'k 'v } -> List 'v = { m } -> __native_map_values { m = m }

## Transforms all values using f.
pub let map_values : { m: Map 'k 'v, f: { val: 'v } -> 'w <...> } -> Map 'k 'w <...> = { m, f } ->
  __native_map_map_values { m = m, f = f }

## Keeps only entries for which the predicate returns True.
pub let filter : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Map 'k 'v <...> = { m, p } ->
  __native_map_filter { m = m, p = p }

## Folds over all entries with an accumulator.
pub let fold : { m: Map 'k 'v, init: 'acc, f: { acc: 'acc, k: 'k, v: 'v } -> 'acc <...> } -> 'acc <...> = { m, init, f } ->
  __native_map_fold { m = m, init = init, f = f }

## Builds a map from a list of keys using f to compute values.
pub let from_keys : { ks: List 'k, f: { val: 'k } -> 'v <...> } -> Map 'k 'v <...> = { ks, f } ->
  __native_map_from_keys { ks = ks, f = f }

## Merges two maps; values from m2 override m1 on key conflict.
pub let merge : { m1: Map 'k 'v, m2: Map 'k 'v } -> Map 'k 'v = { m1, m2 } ->
  __native_map_merge { m1 = m1, m2 = m2 }

## Merges two maps, using f to resolve conflicting keys.
pub let merge_with : { m1: Map 'k 'v, m2: Map 'k 'v, f: { l: 'v, r: 'v } -> 'v <...> } -> Map 'k 'v <...> = { m1, m2, f } ->
  __native_map_merge_with { m1 = m1, m2 = m2, f = f }

## Updates the value for key k using f; removes if f returns None.
pub let update : { m: Map 'k 'v, k: 'k, f: { x: Option 'v } -> Option 'v <...> } -> Map 'k 'v <...> = { m, k, f } ->
  do
    let current = get { m = m, k = k }
    let new_val = f { x = current }
    match new_val is
      Some { val } -> insert { m = m, k = k, v = val }
      None -> remove { m = m, k = k }


## Removes all keys in the given list.
pub let remove_all : { m: Map 'k 'v, ks: List 'k } -> Map 'k 'v = { m, ks } ->
  __native_map_remove_all { m = m, ks = ks }

## Returns True if the two maps are equal.
pub let equals : { m1: Map 'k 'v, m2: Map 'k 'v } -> Bool = { m1, m2 } ->
  __native_map_equals { m1 = m1, m2 = m2 }

## Returns True if any entry matches the predicate.
pub let any : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Bool <...> = { m, p } ->
  __native_map_any { m = m, p = p }

## Returns True if all entries match the predicate.
pub let all : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Bool <...> = { m, p } ->
  __native_map_all { m = m, p = p }

## Returns True if no entry matches the predicate.
pub let none : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Bool <...> = { m, p } ->
  __native_map_none { m = m, p = p }

## Returns the first entry matching the predicate, or None.
pub let find : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Option { k: 'k, v: 'v } <...> = { m, p } ->
  __native_map_find { m = m, p = p }

## Counts entries matching the predicate.
pub let count : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> Int <...> = { m, p } ->
  __native_map_count { m = m, p = p }

## Returns True if the map contains the given value.
pub let contains_value : { m: Map 'k 'v, v: 'v } -> Bool = { m, v } ->
  __native_map_contains_value { m = m, v = v }

## Returns the value for key k, or def if not found.
pub let get_or : { m: Map 'k 'v, k: 'k, def: 'v } -> 'v = { m, k, def } ->
  match get { m = m, k = k } is
    Some { val } -> val
    None -> def

## Creates a single-entry map.
pub let singleton : { k: 'k, v: 'v } -> Map 'k 'v = { k, v } ->
  __native_map_singleton { k = k, v = v }

## Returns all entries as a seq of {k, v} records.
pub let to_seq : { m: Map 'k 'v } -> [{ k: 'k, v: 'v }] = { m } -> __native_map_to_seq { m = m }

## Returns all keys as a seq.
pub let keys_seq : { m: Map 'k 'v } -> ['k] = { m } -> __native_map_keys_seq { m = m }

## Returns all values as a seq.
pub let values_seq : { m: Map 'k 'v } -> ['v] = { m } -> __native_map_values_seq { m = m }

## Splits into entries matching and not matching the predicate.
pub let partition : { m: Map 'k 'v, p: { k: 'k, v: 'v } -> Bool <...> } -> { pass: Map 'k 'v, fail: Map 'k 'v } <...> = { m, p } ->
  __native_map_partition { m = m, p = p }

## Returns the minimum key, or None if empty.
pub let min_key : { m: Map 'k 'v } -> Option 'k = { m } -> __native_map_min_key { m = m }

## Returns the maximum key, or None if empty.
pub let max_key : { m: Map 'k 'v } -> Option 'k = { m } -> __native_map_max_key { m = m }

## Returns the minimum value, or None if empty.
pub let min_value : { m: Map 'k 'v } -> Option 'v = { m } -> __native_map_min_value { m = m }

## Returns the maximum value, or None if empty.
pub let max_value : { m: Map 'k 'v } -> Option 'v = { m } -> __native_map_max_value { m = m }

## Swaps keys and values. Duplicate values keep one arbitrary key.
pub let invert : { m: Map 'k 'v } -> Map 'v 'k = { m } -> __native_map_invert { m = m }

## Keeps only the specified keys.
pub let select_keys : { m: Map 'k 'v, ks: ['k] } -> Map 'k 'v = { m, ks } ->
  __native_map_select_keys { m = m, ks = ks }

## Removes the specified keys.
pub let reject_keys : { m: Map 'k 'v, ks: ['k] } -> Map 'k 'v = { m, ks } ->
  __native_map_reject_keys { m = m, ks = ks }

## Reduces entries to a single entry, or None if empty.
pub let reduce : { m: Map 'k 'v, f: { acc: { k: 'k, v: 'v }, entry: { k: 'k, v: 'v } } -> { k: 'k, v: 'v } <...> } -> Option { k: 'k, v: 'v } <...> = { m, f } ->
  __native_map_reduce { m = m, f = f }

## Groups keys by their values.
pub let group_by_value : { m: Map 'k 'v } -> Map 'v (List 'k) = { m } ->
  __native_map_group_by_value { m = m }

## Transforms all keys using f.
pub let map_keys : { m: Map 'k 'v, f: { val: 'k } -> 'k2 <...> } -> Map 'k2 'v <...> = { m, f } ->
  __native_map_map_keys { m = m, f = f }

## Keeps only entries where the key matches the predicate.
pub let filter_keys : { m: Map 'k 'v, p: { val: 'k } -> Bool <...> } -> Map 'k 'v <...> = { m, p } ->
  __native_map_filter_keys { m = m, p = p }

## Keeps only entries where the value matches the predicate.
pub let filter_values : { m: Map 'k 'v, p: { val: 'v } -> Bool <...> } -> Map 'k 'v <...> = { m, p } ->
  __native_map_filter_values { m = m, p = p }

## Zips two maps by keys present in both.
pub let zip_maps : { m1: Map 'k 'v1, m2: Map 'k 'v2 } -> Map 'k { fst: 'v1, snd: 'v2 } = { m1, m2 } ->
  __native_map_zip_maps { m1 = m1, m2 = m2 }

## Returns keys in m1 but not in m2.
pub let diff_maps : { m1: Map 'k 'v, m2: Map 'k 'v } -> Map 'k 'v = { m1, m2 } ->
  __native_map_diff_maps { m1 = m1, m2 = m2 }

## Returns keys present in both maps (values from m1).
pub let intersect_maps : { m1: Map 'k 'v, m2: Map 'k 'v } -> Map 'k 'v = { m1, m2 } ->
  __native_map_intersect_maps { m1 = m1, m2 = m2 }

## Returns keys in either map but not both.
pub let symmetric_diff_maps : { m1: Map 'k 'v, m2: Map 'k 'v } -> Map 'k 'v = { m1, m2 } ->
  __native_map_symmetric_diff_maps { m1 = m1, m2 = m2 }

## Converts to a List of {k, v} records.
pub let to_list : { m: Map 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_map_to_list { m = m }

## Creates a map from a List of {k, v} records.
pub let from_list : { xs: List { k: 'k, v: 'v } } -> Map 'k 'v = { xs } ->
  __native_map_from_list { xs = xs }

## Maps each entry to a Map and merges all results.
pub let flat_map : { m: Map 'k 'v, f: { k: 'k, v: 'v } -> Map 'k2 'v2 <...> } -> Map 'k2 'v2 <...> = { m, f } ->
  __native_map_flat_map { m = m, f = f }

## Converts to a SortedMap (keys must be comparable).
pub let to_sorted_map : { m: Map 'k 'v } -> SortedMap 'k 'v = { m } ->
  __native_map_to_sorted_map { m = m }

## Method implementations for Map.
impl Map 'k 'v where {
  get = { it, k } -> get { m = it, k = k },
  insert = { it, k, v } -> insert { m = it, k = k, v = v },
  remove = { it, k } -> remove { m = it, k = k },
  contains_key = { it, k } -> contains_key { m = it, k = k },
  keys = { it } -> keys { m = it },
  values = { it } -> values { m = it },
  map_values = { it, f } -> map_values { m = it, f = f },
  filter = { it, p } -> filter { m = it, p = p },
  fold = { it, init, f } -> fold { m = it, init = init, f = f },
  merge = { it, m2 } -> merge { m1 = it, m2 = m2 },
  get_or = { it, k, def } -> get_or { m = it, k = k, def = def },
  any = { it, p } -> any { m = it, p = p },
  all = { it, p } -> all { m = it, p = p },
  find = { it, p } -> find { m = it, p = p },
  count = { it, p } -> count { m = it, p = p },
  to_seq = { it } -> to_seq { m = it },
  to_list = { it } -> to_list { m = it },
}

impl Sized for Map 'k 'v where {
  size = { it } -> size { m = it },
  is_empty = { it } -> is_empty { m = it },
}
