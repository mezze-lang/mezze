## Converts to a SortedSet.
pub let to_sorted_set: { xs: ['a] } -> SortedSet 'a = { xs } ->
  __native_seq_to_sorted_set { xs = xs }

## Converts a seq of {k, v} records to a Map.
pub let to_map: { xs: [{ k: 'k, v: 'v }] } -> Map 'k 'v = { xs } ->
  __native_seq_to_map { xs = xs }

## Converts a seq of {k, v} records to a SortedMap.
pub let to_sorted_map: { xs: [{ k: 'k, v: 'v }] } -> SortedMap 'k 'v = { xs } ->
  __native_seq_to_sorted_map { xs = xs }

## Creates a seq from a List.
pub let from_list: { xs: List 'a } -> ['a] = { xs } -> __native_seq_from_list { xs = xs }

## Creates a seq from a Set.
pub let from_set: { s: Set 'a } -> ['a] = { s } -> __native_seq_from_set { s = s }

## Creates a seq from a Deque.
pub let from_deque: { d: Deque 'a } -> ['a] = { d } -> __native_seq_from_deque { d = d }

## Creates a seq from a SortedSet.
pub let from_sorted_set: { s: SortedSet 'a } -> ['a] = { s } ->
  __native_seq_from_sorted_set { s = s }

## Creates a seq from a Map (as {k, v} records).
pub let from_map: { m: Map 'k 'v } -> [{ k: 'k, v: 'v }] = { m } ->
  __native_seq_from_map { m = m }

## Creates a seq from a SortedMap (as {k, v} records).
pub let from_sorted_map: { m: SortedMap 'k 'v } -> [{ k: 'k, v: 'v }] = { m } ->
  __native_seq_from_sorted_map { m = m }

## Returns the minimum float element, or None if empty.
pub let min_float: { xs: [Float] } -> Option Float = { xs } -> __native_seq_min_float { xs = xs }

## Returns the maximum float element, or None if empty.
pub let max_float: { xs: [Float] } -> Option Float = { xs } -> __native_seq_max_float { xs = xs }

## Method implementations for Seq.
impl Seq 'a where {
  get = { it, i } -> get { xs = it, i = i },
  set = { it, i, x } -> set { xs = it, i = i, x = x },
  add = { it, x } -> add { xs = it, x = x },
  push = { it, x } -> push { xs = it, x = x },
  push_front = { it, x } -> push_front { xs = it, x = x },
  concat = { it, ys } -> concat { xs = it, ys = ys },
  head = { it } -> head { xs = it },
  first = { it } -> first { xs = it },
  last = { it } -> last { xs = it },
  tail = { it } -> tail { xs = it },
  take = { it, n } -> take { xs = it, n = n },
  drop = { it, n } -> drop { xs = it, n = n },
  slice = { it, start, end } -> slice { xs = it, start = start, end = end },
  contains = { it, x } -> contains { xs = it, x = x },
  find = { it, p } -> find { xs = it, p = p },
  map = { it, f } -> map { xs = it, f = f },
  filter = { it, p } -> filter { xs = it, p = p },
  flat_map = { it, f } -> flat_map { xs = it, f = f },
  fold = { it, init, f } -> fold { xs = it, init = init, f = f },
  reduce = { it, f } -> reduce { xs = it, f = f },
  any = { it, p } -> any { xs = it, p = p },
  all = { it, p } -> all { xs = it, p = p },
  none = { it, p } -> none { xs = it, p = p },
  count = { it, p } -> count { xs = it, p = p },
  reverse = { it } -> reverse { xs = it },
  sort = { it } -> sort { xs = it },
  sort_by = { it, cmp } -> sort_by { xs = it, cmp = cmp },
  unique = { it } -> unique { xs = it },
  flatten = { it } -> flatten { xss = it },
  zip = { it, ys } -> zip { xs = it, ys = ys },
  enumerate = { it } -> enumerate { xs = it },
  for_each = { it, f } -> for_each { xs = it, f = f },
  join = { it, sep } -> join { xs = it, sep = sep },
  partition = { it, p } -> partition { xs = it, p = p },
  min = { it } -> min { xs = it },
  max = { it } -> max { xs = it },
  sum = { it } -> sum { xs = it },
  to_list = { it } -> to_list { xs = it },
  to_set = { it } -> to_set { xs = it },

  ## dot-chain parity: an inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` always works.
  remove = { it, i } -> remove { xs = it, i = i },
  init = { it } -> init { xs = it },
  take_while = { it, p } -> take_while { xs = it, p = p },
  drop_while = { it, p } -> drop_while { xs = it, p = p },
  index_of = { it, x } -> index_of { xs = it, x = x },
  find_index = { it, p } -> find_index { xs = it, p = p },
  distinct = { it } -> distinct { xs = it },
  zip_with_index = { it } -> zip_with_index { xs = it },
  unzip = { it } -> unzip { xs = it },
  intersperse = { it, sep } -> intersperse { xs = it, sep = sep },
  chunk = { it, size } -> chunk { xs = it, size = size },
  sliding = { it, size } -> sliding { xs = it, size = size },
  equals = { it, r } -> equals { l = it, r = r },
  min_by = { it, f } -> min_by { xs = it, f = f },
  max_by = { it, f } -> max_by { xs = it, f = f },
  sum_float = { it } -> sum_float { xs = it },
  product = { it } -> product { xs = it },
  product_float = { it } -> product_float { xs = it },
  group_by = { it, f } -> group_by { xs = it, f = f },
  scan = { it, init, f } -> scan { xs = it, init = init, f = f },
  split_at = { it, i } -> split_at { xs = it, i = i },
  span = { it, p } -> span { xs = it, p = p },
  dedup = { it } -> dedup { xs = it },
  dedup_by = { it, f } -> dedup_by { xs = it, f = f },
  nth = { it, i } -> nth { xs = it, i = i },
  group_consecutive = { it } -> group_consecutive { xs = it },
  group_consecutive_by = { it, f } -> group_consecutive_by { xs = it, f = f },
  windows = { it, size } -> windows { xs = it, size = size },
  chunks_exact = { it, size } -> chunks_exact { xs = it, size = size },
  rotate_left = { it, n } -> rotate_left { xs = it, n = n },
  rotate_right = { it, n } -> rotate_right { xs = it, n = n },
  binary_search = { it, x } -> binary_search { xs = it, x = x },
  binary_search_by = { it, x, cmp } -> binary_search_by { xs = it, x = x, cmp = cmp },
  sort_by_key = { it, f } -> sort_by_key { xs = it, f = f },
  last_index_of = { it, x } -> last_index_of { xs = it, x = x },
  replace = { it, old, new_val } -> replace { xs = it, old = old, new_val = new_val },
  replace_all = { it, old, new_val } -> replace_all { xs = it, old = old, new_val = new_val },
  insert_at = { it, i, x } -> insert_at { xs = it, i = i, x = x },
  swap = { it, i, j } -> swap { xs = it, i = i, j = j },
  starts_with = { it, prefix } -> starts_with { xs = it, prefix = prefix },
  ends_with = { it, suffix } -> ends_with { xs = it, suffix = suffix },
  zip_with = { it, ys, f } -> zip_with { xs = it, ys = ys, f = f },
  cartesian_product = { it, ys } -> cartesian_product { xs = it, ys = ys },
  permutations = { it } -> permutations { xs = it },
  combinations = { it, k } -> combinations { xs = it, k = k },
  subsequences = { it } -> subsequences { xs = it },
  average = { it } -> average { xs = it },
  variance = { it } -> variance { xs = it },
  stddev = { it } -> stddev { xs = it },
  median = { it } -> median { xs = it },
  is_sorted = { it } -> is_sorted { xs = it },
  is_sorted_by = { it, f } -> is_sorted_by { xs = it, f = f },
  is_sorted_descending = { it } -> is_sorted_descending { xs = it },
  compare = { it, ys } -> compare { xs = it, ys = ys },
  binary_search_insert_point = { it, x } -> binary_search_insert_point { xs = it, x = x },
  lower_bound = { it, x } -> lower_bound { xs = it, x = x },
  upper_bound = { it, x } -> upper_bound { xs = it, x = x },
  equal_range = { it, x } -> equal_range { xs = it, x = x },
  count_element = { it, x } -> count_element { xs = it, x = x },
  update = { it, i, f } -> update { xs = it, i = i, f = f },
  remove_at = { it, i } -> remove_at { xs = it, i = i },
  split = { it, sep } -> split { xs = it, sep = sep },
  to_deque = { it } -> to_deque { xs = it },
  to_sorted_set = { it } -> to_sorted_set { xs = it },
  to_map = { it } -> to_map { xs = it },
  to_sorted_map = { it } -> to_sorted_map { xs = it },
  min_float = { it } -> min_float { xs = it },
  max_float = { it } -> max_float { xs = it },
}

impl Sized for ['a] where {
  size = { it } -> size { xs = it },
  is_empty = { it } -> is_empty { xs = it },
}

## Wrap any value in a one-element Seq via method syntax:
## `x.seq {}` → `[x]`. Generic — covers every type.
ability Seqable for 'a where {
  seq: { it: 'a } -> ['a]
}

impl Seqable for 'a where {
  seq = { it } -> singleton { x = it }
}
