  -> { l: ['a], r: ['a] }
  = { xs, i } -> __native_seq_split_at { xs = xs, i = i }

## Splits into prefix where predicate holds and the rest.
pub let span
  : { xs: ['a], p: { x: 'a } -> Bool <...> }
  -> { l: ['a], r: ['a] } <...>
  = { xs, p } -> __native_seq_span { xs = xs, p = p }

