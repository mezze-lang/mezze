## Sorts using a key extraction function.
pub let sort_by_key: { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['a] <...> = { xs, f } ->
  __native_seq_sort_by_key { xs = xs, f = f }

## Returns the index of the last occurrence, or None.
pub let last_index_of: { xs: ['a], x: 'a } -> Option Int = { xs, x } ->
  __native_seq_last_index_of { xs = xs, x = x }

## Replaces the first occurrence of old with new_val.
