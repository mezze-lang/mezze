use std::abilities::compare::{ Eq, Ord }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::int

## Default Seq is the empty sequence.
impl Default for ['a] where {
  default = {} -> []
}

## Structural equality for sequences.
impl Eq for ['a] where {
  eq = { it, r } -> __native_seq_equals { l = it, r = r },
  neq = { it, r } -> if __native_seq_equals { l = it, r = r } then False else True,
}

## Lexicographic ordering for sequences, requiring the element to be Ord.
## `__native_seq_compare` compares elements, so the `with Ord 'a` preconditions
## are load-bearing: without them `[T] < [T]` would type-check for a T with no
## Ord and crash at runtime (#224). The native-delegating body can't infer this.
impl Ord for ['a] where {
  lt: { it: ['a], r: ['a] } with Ord 'a -> Bool = { it, r } ->
    __native_seq_compare { xs = it, ys = r } == (0 - 1),
  le: { it: ['a], r: ['a] } with Ord 'a -> Bool = { it, r } ->
    __native_seq_compare { xs = it, ys = r } != 1,
  gt: { it: ['a], r: ['a] } with Ord 'a -> Bool = { it, r } ->
    __native_seq_compare { xs = it, ys = r } == 1,
  ge: { it: ['a], r: ['a] } with Ord 'a -> Bool = { it, r } ->
    __native_seq_compare { xs = it, ys = r } != (0 - 1),
}

## Returns the number of elements.
pub let size: { xs: ['a] } -> Int = { xs } -> __native_seq_size { xs = xs }

## Returns True if the sequence has no elements.
pub let is_empty: { xs: ['a] } -> Bool = { xs } -> __native_seq_is_empty { xs = xs }

## Returns the element at index i, or None if out of bounds.
pub let get: { xs: ['a], i: Int } -> Option 'a = { xs, i } -> __native_seq_get { xs = xs, i = i }

## Returns a new sequence with the element at index i replaced, or None if out of bounds.
pub let set: { xs: ['a], i: Int, x: 'a } -> Option ['a] = { xs, i, x } ->
  __native_seq_set { xs = xs, i = i, x = x }

## Appends an element to the end.
pub let add: { xs: ['a], x: 'a } -> ['a] = { xs, x } -> __native_seq_add { xs = xs, x = x }

## Appends an element to the end (alias for add).
pub let push: { xs: ['a], x: 'a } -> ['a] = { xs, x } -> __native_seq_push { xs = xs, x = x }

## Prepends an element to the front.
pub let push_front: { xs: ['a], x: 'a } -> ['a] = { xs, x } ->
  __native_seq_push_front { xs = xs, x = x }

## Removes the element at index i, or returns None if out of bounds.
pub let remove: { xs: ['a], i: Int } -> Option ['a] = { xs, i } ->
  __native_seq_remove { xs = xs, i = i }

## Concatenates two sequences.
pub let concat: { xs: ['a], ys: ['a] } -> ['a] = { xs, ys } ->
  __native_seq_concat { xs = xs, ys = ys }

## Returns the first element, or None if empty.
pub let head: { xs: ['a] } -> Option 'a = { xs } -> __native_seq_head { xs = xs }

## Alias for head.
pub let first: { xs: ['a] } -> Option 'a = { xs } -> __native_seq_first { xs = xs }

## Returns the last element, or None if empty.
pub let last: { xs: ['a] } -> Option 'a = { xs } -> __native_seq_last { xs = xs }

## Returns all elements except the first.
pub let tail: { xs: ['a] } -> ['a] = { xs } -> __native_seq_tail { xs = xs }

## Returns all elements except the last.
pub let init: { xs: ['a] } -> ['a] = { xs } -> __native_seq_init { xs = xs }

## Returns a slice from start (inclusive) to end (exclusive).
pub let slice: { xs: ['a], start: Int, end: Int } -> ['a] = { xs, start, end } ->
  __native_seq_slice { xs = xs, start = start, end = end }

## Returns the first n elements.
pub let take: { xs: ['a], n: Int } -> ['a] = { xs, n } -> __native_seq_take { xs = xs, n = n }

## Drops the first n elements.
pub let drop: { xs: ['a], n: Int } -> ['a] = { xs, n } -> __native_seq_drop { xs = xs, n = n }

## Takes elements from the front while the predicate holds.
pub let take_while
  : { xs: ['a], p: { x: 'a } -> Bool <...> }
  -> ['a] <...>
  = { xs, p } -> __native_seq_take_while { xs = xs, p = p }

## Drops elements from the front while the predicate holds.
pub let drop_while
  : { xs: ['a], p: { x: 'a } -> Bool <...> }
  -> ['a] <...>
  = { xs, p } -> __native_seq_drop_while { xs = xs, p = p }

## Returns True if the sequence contains the element.
pub let contains: { xs: ['a], x: 'a } -> Bool = { xs, x } ->
  __native_seq_contains { xs = xs, x = x }

## Returns the index of the first occurrence, or None.
pub let index_of: { xs: ['a], x: 'a } -> Option Int = { xs, x } ->
  __native_seq_index_of { xs = xs, x = x }

## Returns the first element matching the predicate, or None.
pub let find: { xs: ['a], p: { x: 'a } -> Bool <...> } -> Option 'a <...> = { xs, p } ->
  __native_seq_find { xs = xs, p = p }

## Returns the index of the first element matching the predicate, or None.
pub let find_index
  : { xs: ['a], p: { x: 'a } -> Bool <...> }
  -> Option Int <...>
  = { xs, p } -> __native_seq_find_index { xs = xs, p = p }

## Applies f to each element, returning a new sequence of results.
pub let map: { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <...> = { xs, f } ->
  __native_seq_map { xs = xs, f = f }

## Keeps only elements for which the predicate returns True.
pub let filter: { xs: ['a], p: { x: 'a } -> Bool <...> } -> ['a] <...> = { xs, p } ->
  __native_seq_filter { xs = xs, p = p }

## Applies f to each element and flattens the resulting sequences.
pub let flat_map
  : { xs: ['a], f: { x: 'a } -> ['b] <...> }
  -> ['b] <...>
  = { xs, f } -> __native_seq_flat_map { xs = xs, f = f }

## Left fold with an initial accumulator value.
##
## Implemented in Mezze on top of `__native_seq_get_unchecked` so mono can
## specialize on the concrete folder lambda at each call site (#409/#416).
## Once monomorphized, the folder inlines into the loop and the whole
## `xs.fold {init=0, f={acc,x}->acc+x}` collapses to the same shape as
## a hand-written for-loop over the sequence.
let fold_go
  : { xs: ['a], i: Int, n: Int, acc: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> 'b <...>
  = { xs, i, n, acc, f } -> if i >= n then acc else fold_go {
    xs = xs,
    i = i + 1,
    n = n,
    acc = f {
      acc = acc,
      x = __native_seq_get_unchecked { xs = xs, i = i },
    },
    f = f,
  }

pub let fold
  : { xs: ['a], init: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> 'b <...>
  = { xs, init, f } ->
    __native_seq_fold { xs = xs, init = init, f = f }

## Reduces elements using f, returning None if empty.
pub let reduce
  : { xs: ['a], f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { xs, f } -> __native_seq_reduce { xs = xs, f = f }

## Returns True if any element matches the predicate.
pub let any: { xs: ['a], p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_seq_any { xs = xs, p = p }

## Returns True if all elements match the predicate.
pub let all: { xs: ['a], p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_seq_all { xs = xs, p = p }

## Returns True if no element matches the predicate.
pub let none: { xs: ['a], p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_seq_none { xs = xs, p = p }

## Counts elements matching the predicate.
pub let count: { xs: ['a], p: { x: 'a } -> Bool <...> } -> Int <...> = { xs, p } ->
  __native_seq_count { xs = xs, p = p }

## Reverses the sequence.
pub let reverse: { xs: ['a] } -> ['a] = { xs } -> __native_seq_reverse { xs = xs }

## Sorts elements in ascending order.
pub let sort: { xs: ['a] } -> ['a] = { xs } -> __native_seq_sort { xs = xs }

## Sorts using a `less-or-equal` comparator: `cmp { a, b }` returns True when `a`
## should come before `b`. Matches how ordering is expressed everywhere else in
## the language (`Ord`'s `lt`/`le`, the `<`/`<=` operators) — no three-way Int.
pub let sort_by
  : { xs: ['a], cmp: { a: 'a, b: 'a } -> Bool <...> }
  -> ['a] <...>
  = { xs, cmp } -> __native_seq_sort_by { xs = xs, cmp = { a, b } -> if cmp { a = a, b = b } then 0 - 1 else 1 }

## Removes duplicate elements, keeping the first occurrence.
pub let unique: { xs: ['a] } -> ['a] = { xs } -> __native_seq_unique { xs = xs }

## Alias for unique.
pub let distinct: { xs: ['a] } -> ['a] = { xs } -> __native_seq_distinct { xs = xs }

## Flattens a sequence of sequences into a single sequence.
pub let flatten: { xss: [['a]] } -> ['a] = { xss } -> __native_seq_flatten { xs = xss }

## Splits into elements matching and not matching the predicate.
pub let partition
  : { xs: ['a], p: { x: 'a } -> Bool <...> }
  -> { pass: ['a], fail: ['a] } <...>
  = { xs, p } -> __native_seq_partition { xs = xs, p = p }

## Pairs elements from two sequences into records of {fst, snd}.
pub let zip: { xs: ['a], ys: ['b] } -> [{ fst: 'a, snd: 'b }] = { xs, ys } ->
  __native_seq_zip { xs = xs, ys = ys }

## Pairs each element with its index.
pub let zip_with_index: { xs: ['a] } -> [{ value: 'a, index: Int }] = { xs } ->
  __native_seq_zip_with_index { xs = xs }

## Splits a sequence of {fst, snd} pairs into two sequences.
pub let unzip
  : { xs: [{ fst: 'a, snd: 'b }] }
  -> { fsts: ['a], snds: ['b] }
  = { xs } -> __native_seq_unzip { xs = xs }

## Inserts a separator between every pair of elements.
pub let intersperse: { xs: ['a], sep: 'a } -> ['a] = { xs, sep } ->
  __native_seq_intersperse { xs = xs, sep = sep }

## Splits into chunks of the given size; last chunk may be smaller.
pub let chunk: { xs: ['a], size: Int } -> [['a]] = { xs, size } ->
  __native_seq_chunk { xs = xs, size = size }

## Returns all sliding windows of the given size.
pub let sliding: { xs: ['a], size: Int } -> [['a]] = { xs, size } ->
  __native_seq_sliding { xs = xs, size = size }

## Creates an integer range [start, end).
pub let range: { start: Int, end: Int } -> [Int] = { start, end } ->
  __native_seq_range { start = start, end = end }

## Creates an integer range [start, end) with a step.
pub let range_step: { start: Int, end: Int, step: Int } -> [Int] = { start, end, step } ->
  __native_seq_range_step { start = start, end = end, step = step }

## Returns True if the two sequences are equal.
pub let equals: { l: ['a], r: ['a] } -> Bool = { l, r } -> __native_seq_equals { l = l, r = r }

## Creates an empty sequence.
pub let empty: {} -> ['a] = {} -> __native_seq_empty {}

## Constructs a sequence with x at the front of xs.
pub let of: { x: 'a, xs: ['a] } -> ['a] = { x, xs } -> push_front { xs = xs, x = x }

## Returns the minimum element, or None if empty.
pub let min: { xs: ['a] } -> Option 'a = { xs } -> __native_seq_min { xs = xs }

## Returns the maximum element, or None if empty.
pub let max: { xs: ['a] } -> Option 'a = { xs } -> __native_seq_max { xs = xs }

## Returns the minimum element by a key function, or None if empty.
pub let min_by: { xs: ['a], f: { x: 'a } -> 'b <...> } -> Option 'a <...> = { xs, f } ->
  __native_seq_min_by { xs = xs, f = f }

## Returns the maximum element by a key function, or None if empty.
pub let max_by: { xs: ['a], f: { x: 'a } -> 'b <...> } -> Option 'a <...> = { xs, f } ->
  __native_seq_max_by { xs = xs, f = f }

## Sums all integer elements.
pub let sum: { xs: [Int] } -> Int = { xs } -> __native_seq_sum { xs = xs }

## Sums all float elements.
pub let sum_float: { xs: [Float] } -> Float = { xs } -> __native_seq_sum_float { xs = xs }

## Returns the product of all integer elements.
pub let product: { xs: [Int] } -> Int = { xs } -> __native_seq_product { xs = xs }

## Returns the product of all float elements.
pub let product_float: { xs: [Float] } -> Float = { xs } -> __native_seq_product_float { xs = xs }

## Groups elements by a key function into records of {key, values}.
pub let group_by: { xs: ['a], f: { x: 'a } -> 'k <...> } -> [{ key: 'k, values: ['a] }] <...> = { xs, f } ->
  __native_seq_group_by { xs = xs, f = f }

## Pairs each element with its index (same as zip_with_index).
pub let enumerate: { xs: ['a] } -> [{ value: 'a, index: Int }] = { xs } ->
  __native_seq_enumerate { xs = xs }

## Executes f for each element, for side effects only.
pub let for_each: { xs: ['a], f: { x: 'a } -> 'b <...> } -> {} <...> = { xs, f } ->
  __native_seq_for_each { xs = xs, f = f }

## Like fold, but returns all intermediate accumulator values.
pub let scan
  : { xs: ['a], init: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> ['b] <...>
  = { xs, init, f } -> __native_seq_scan { xs = xs, init = init, f = f }

## Splits at index i into {l, r}.
