  __native_seq_fill_with { n = n, f = f }

## Groups consecutive equal elements into sub-sequences.
pub let group_consecutive: { xs: ['a] } -> [['a]] = { xs } ->
  __native_seq_group_consecutive { xs = xs }

## Groups consecutive elements by a key function.
pub let group_consecutive_by
  : { xs: ['a], f: { x: 'a } -> 'b <...> }
  -> [['a]] <...>
  = { xs, f } -> __native_seq_group_consecutive_by { xs = xs, f = f }

## Returns all sliding windows of the given size (alias for sliding).
pub let windows: { xs: ['a], size: Int } -> [['a]] = { xs, size } ->
  __native_seq_windows { xs = xs, size = size }

## Splits into exact chunks of the given size, dropping any remainder.
