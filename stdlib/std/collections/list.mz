use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::abilities::iter::{ Iterable }
use std::collections::iter
use std::int

## Default List is the empty list.
impl Default for List 'a where {
  default = {} -> empty {}
}

# Elementwise equality via a declared `eq` param, which ties the comparator to the element type
# (a let's `with Eq 'a` doesn't reach body annotations), instead of JVM structural equality.
let list_equals_with_eq
  : { xs: List 'a, ys: List 'a, eq: { a: 'a, b: 'a } -> Bool } -> Bool = { xs, ys, eq } ->
  __native_list_equals { xs = xs, ys = ys, eq = eq }

# Lexicographic list comparison, threading an element comparator `cmp` (-1/0/1).
# Same tying trick as above; delegates to the existing comparator-taking native.
let list_compare_with_cmp
  : { xs: List 'a, ys: List 'a, cmp: { a: 'a, b: 'a } -> Int } -> Int = { xs, ys, cmp } ->
  __native_list_lexicographic_compare { xs = xs, ys = ys, cmp = cmp }

# Eq and Hash are written together or not at all: a hash disagreeing with Eq duplicates entries.
## Structural hash for lists, consistent with their `Eq`.
impl Hash for List 'a where {
  hash: { it: List 'a } -> Int = { it } -> structural_hash { it = it }
}

# Was structural and ignored a custom element Eq. `with Eq 'a` is load-bearing:
# without it `List T == List T` would type-check for a T with no Eq.
## Equality for lists, elementwise via the element's Eq impl.
impl Eq for List 'a where {
  eq: { it: List 'a, r: List 'a } with Eq 'a -> Bool = { it, r } ->
    list_equals_with_eq { xs = it, ys = r, eq = { a, b } -> a == b },
  neq: { it: List 'a, r: List 'a } with Eq 'a -> Bool = { it, r } ->
    if list_equals_with_eq { xs = it, ys = r, eq = { a, b } -> a == b } then False else True,
}

# `with Ord 'a` is load-bearing (#224); the threaded comparator honours a user Ord impl, where
# the old native fell back to identityHashCode for records (wrong AND unstable).
## Lexicographic ordering for lists, using the element's own Ord impl.
impl Ord for List 'a where {
  lt: { it: List 'a, r: List 'a } with Ord 'a -> Bool = { it, r } ->
    list_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == (0 - 1),
  le: { it: List 'a, r: List 'a } with Ord 'a -> Bool = { it, r } ->
    list_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != 1,
  gt: { it: List 'a, r: List 'a } with Ord 'a -> Bool = { it, r } ->
    list_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == 1,
  ge: { it: List 'a, r: List 'a } with Ord 'a -> Bool = { it, r } ->
    list_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != (0 - 1),
}

## Creates an empty list.
pub let empty: {} -> List 'a = {} -> __native_list_empty {}

## Constructs a list by prepending head to tail.
pub let cons: { head: 'a, tail: List 'a } -> List 'a = { head, tail } ->
  __native_list_cons { head = head, tail = tail }

## Prepends x to the front of xs.
pub let push: { x: 'a, xs: List 'a } -> List 'a = { x, xs } ->
  __native_list_cons { head = x, tail = xs }

## Returns True if the list has no elements.
pub let is_empty: { xs: List 'a } -> Bool = { xs } -> __native_list_is_empty { xs = xs }

## Returns the first element, or None if empty.
pub let head: { xs: List 'a } -> Option 'a = { xs } -> __native_list_head { xs = xs }

## Returns all elements except the first, or None if empty.
pub let tail: { xs: List 'a } -> Option (List 'a) = { xs } -> __native_list_tail { xs = xs }

## Returns the number of elements.
pub let size: { xs: List 'a } -> Int = { xs } -> __native_list_size { xs = xs }

## Deconstructs into {head, tail}, or returns None if empty.
pub let uncons: { xs: List 'a } -> Option { head: 'a, tail: List 'a } = { xs } ->
  __native_list_uncons { xs = xs }

## Creates a single-element list.
pub let singleton: { x: 'a } -> List 'a = { x } -> cons { head = x, tail = empty {} }

## Prepends x to the front (alias for push).
pub let prepend: { x: 'a, xs: List 'a } -> List 'a = { x, xs } -> cons { head = x, tail = xs }

# Guest fold (reverse xs onto ys), not the native concat: measured no faster.
# `__native_list_append` appends ONE element, not a list.
## Concatenates two lists: the elements of `xs` followed by those of `ys`.
pub let append: { xs: List 'a, ys: List 'a } -> List 'a = { xs, ys } ->
  fold_left {
    xs = reverse { xs = xs },
    init = ys,
    f = { acc, x } -> cons { head = x, tail = acc },
  }

## Returns the element at index, or None if out of bounds.
pub let get: { xs: List 'a, index: Int } -> Option 'a = { xs, index } ->
  __native_list_get { xs = xs, index = index }

# Take n elements from front — build reverse-accum, reverse at end.
## Returns the first n elements.
pub let take: { xs: List 'a, n: Int } -> List 'a = { xs, n } ->
  __native_list_take { xs = xs, n = n }

## Drops the first n elements.
pub let drop: { xs: List 'a, n: Int } -> List 'a = { xs, n } ->
  __native_list_drop { xs = xs, n = n }

## Applies f to each element, returning a new list.
pub let map: { xs: List 'a, f: { x: 'a } -> 'b <...> } -> List 'b <...> = { xs, f } ->
  __native_list_map { xs = xs, f = f }

## Keeps only elements for which the predicate returns True.
pub let filter: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> List 'a <...> = { xs, p } ->
  __native_list_filter { xs = xs, p = p }

# Delegates to native O(n) toArray() loop — avoids recursive dispatch overhead.
## Left fold with an initial accumulator value.
pub let fold_left
  : { xs: List 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> 'acc <...>
  = { xs, init, f } -> __native_list_fold_left { xs = xs, init = init, f = f }

# Delegates to native — single reverse + fold in Java.
## Right fold with an initial accumulator value.
pub let fold_right
  : { xs: List 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> 'acc <...>
  = { xs, init, f } -> __native_list_fold_right { xs = xs, init = init, f = f }

## Reduces elements using f, returning None if empty. Uses head as init.
pub let reduce
  : { xs: List 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { xs, f } -> __native_list_reduce { xs = xs, f = f }


# Delegates to native — O(n) head/tail walk with short-circuit.
## Returns True if any element matches the predicate. Stops at the first match.
pub let any: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_list_any { xs = xs, p = p }

## Returns True if all elements match the predicate.
pub let all: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_list_all { xs = xs, p = p }

## Returns True if the list contains the element, by the element's Eq impl.
pub let contains: { xs: List 'a, x: 'a } with Eq 'a -> Bool = { xs, x } -> do
  let target = x
  any { xs = xs, p = { x } -> x == target }

## Reverses the list.
pub let reverse: { xs: List 'a } -> List 'a = { xs } -> __native_list_reverse { xs = xs }

## Flattens a list of lists into a single list.
pub let concat: { xss: List (List 'a) } -> List 'a = { xss } -> __native_list_concat { xss = xss }

## Applies f to each element and flattens the resulting lists.
pub let flat_map: { xs: List 'a, f: { x: 'a } -> List 'b <...> } -> List 'b <...> = { xs, f } ->
  concat { xss = map { xs = xs, f = f } }

# Walks both lists in parallel, stopping at the shorter one.
# Builds in reverse-accum then reverses once at end.
let zip_go
  : { xs: List 'a, ys: List 'b, acc: List { fst: 'a, snd: 'b } }
  -> List { fst: 'a, snd: 'b }
  = { xs, ys, acc } -> match uncons { xs = xs } is
    None -> acc
    Some { val = { head = hx, tail = tx } } -> match uncons { xs = ys } is
      None -> acc
      Some { val = { head = hy, tail = ty } } -> zip_go {
        xs = tx,
        ys = ty,
        acc = cons { head = { fst = hx, snd = hy }, tail = acc },
      }


# Native: the guest uncons recursion + reverse measured 10.6x list::reverse; it takes no callback.
## Pairs elements from two lists into records of {fst, snd}.
pub let zip: { xs: List 'a, ys: List 'b } -> List { fst: 'a, snd: 'b } = { xs, ys } ->
  __native_list_zip { xs = xs, ys = ys }

# WAS a single fold_left into two accumulators plus two reverses — 6.4x
# `list::reverse`. The native returns `{fsts, snds}` directly.
## Splits a list of {fst, snd} pairs into two lists.
pub let unzip
  : { xs: List { fst: 'a, snd: 'b } }
  -> { fsts: List 'a, snds: List 'b }
  = { xs } -> __native_list_unzip { xs = xs }

## Converts to a Seq.
pub let to_seq: { xs: List 'a } -> ['a] = { xs } -> __native_list_to_seq { xs = xs }

## Creates a list from a Seq.
pub let from_seq: { xs: ['a] } -> List 'a = { xs } -> __native_list_from_seq { xs = xs }

## Creates an integer range [start, end).
pub let range: { start: Int, end: Int } -> List Int = { start, end } ->
  __native_list_range { start = start, end = end }

let repeat_go: { x: 'a, n: Int, acc: List 'a } -> List 'a = { x, n, acc } -> if n <= 0 then acc else repeat_go {
  x = x,
  n = n - 1,
  acc = cons { head = x, tail = acc },
}

## Creates a list of n copies of x.
pub let repeat: { x: 'a, n: Int } -> List 'a = { x, n } ->
  repeat_go { x = x, n = n, acc = empty {} }

# WAS fold_left plus a final reverse — two passes (each element prefixed by sep
# except the first, then reversed). 4.8x `list::reverse`.
## Inserts a separator between every pair of elements.
pub let intersperse: { xs: List 'a, sep: 'a } -> List 'a = { xs, sep } ->
  __native_list_intersperse { xs = xs, sep = sep }


# Private and single-caller (like seq's twin): for a directly comparable 'a the compiler rewrites
# this to __native_list_sort and DROPS `le`, so another comparator would be silently discarded.
let sort_by_ord: { xs: List 'a, le: { it: 'a, r: 'a } -> Bool } with Ord 'a -> List 'a
  = { xs, le } -> __native_list_sort_by_ord { xs = xs, le = le }

# The comparator must be typed by sort_by_ord's signature; an inline lambda handed to the untyped
# native sees fresh variables and is refused. NaN-last comes from Double.compareTo's total order.
## Sorts in ascending order using the element's Ord impl.
## Floats: NaN sorts last, as in `seq::sort`; the operators are unchanged (`NaN <= x` is False).
pub let sort: { xs: List 'a } with Ord 'a -> List 'a = { xs } ->
  sort_by_ord { xs = xs, le = { it, r } -> it <= r }

## Sorts with a less-or-equal comparator: `cmp { a, b }` is True when `a` comes before `b`.
pub let sort_by
  : { xs: List 'a, cmp: { a: 'a, b: 'a } -> Bool <...> }
  -> List 'a <...>
  = { xs, cmp } -> __native_list_sort_by { xs = xs, cmp = { a, b } -> if cmp { a = a, b = b } then 0 - 1 else 1 }

## Returns the first element matching the predicate, or None.
pub let find: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Option 'a <...> = { xs, p } ->
  __native_list_find { xs = xs, p = p }

## Returns the index of the first element matching the predicate, or None.
pub let find_index: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Option Int <...> = { xs, p } ->
  __native_list_find_index { xs = xs, p = p }

## Splits into elements matching and not matching the predicate.
pub let partition
  : { xs: List 'a, p: { x: 'a } -> Bool <...> }
  -> { pass: List 'a, fail: List 'a } <...>
  = { xs, p } -> __native_list_partition { xs = xs, p = p }

## Returns the last element, or None if empty.
pub let last: { xs: List 'a } -> Option 'a = { xs } -> __native_list_last { xs = xs }


# fold_left accumulates every element except the current head-of-tail's None case.
# Simpler: reverse, drop head, reverse back.
## Returns all elements except the last.
pub let init: { xs: List 'a } -> List 'a = { xs } -> __native_list_init { xs = xs }


## Returns the minimum element, or None if empty.
pub let min: { xs: List 'a } with Ord 'a -> Option 'a = { xs } ->
  reduce { xs = xs, f = { acc, x } -> if x < acc then x else acc }

## Returns the maximum element, or None if empty.
pub let max: { xs: List 'a } with Ord 'a -> Option 'a = { xs } ->
  reduce { xs = xs, f = { acc, x } -> if x > acc then x else acc }

## Returns the minimum element by a key function, or None if empty.
let min_by_with_cmp
  : { xs: List 'a, f: { x: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int } -> Option 'a <...>
  = { xs, f, cmp } -> __native_list_min_by { xs = xs, f = f, cmp = cmp }

## Returns the minimum element by a key function (keys ordered by their Ord), or None.
pub let min_by: { xs: List 'a, f: { x: 'a } -> 'b <...> } with Ord 'b -> Option 'a <...> = { xs, f } ->
  min_by_with_cmp { xs = xs, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Returns the maximum element by a key function, or None if empty.
let max_by_with_cmp
  : { xs: List 'a, f: { x: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int } -> Option 'a <...>
  = { xs, f, cmp } -> __native_list_max_by { xs = xs, f = f, cmp = cmp }

## Returns the maximum element by a key function (keys ordered by their Ord), or None.
pub let max_by: { xs: List 'a, f: { x: 'a } -> 'b <...> } with Ord 'b -> Option 'a <...> = { xs, f } ->
  max_by_with_cmp { xs = xs, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }


## Sums all integer elements.
pub let sum: { xs: List Int } -> Int = { xs } -> __native_list_sum { xs = xs }

## Sums all float elements.
pub let sum_float: { xs: List Float } -> Float = { xs } -> __native_list_sum_float { xs = xs }

## Returns the product of all integer elements.
pub let product: { xs: List Int } -> Int = { xs } -> __native_list_product { xs = xs }

## Returns the product of all float elements.
pub let product_float: { xs: List Float } -> Float = { xs } ->
  __native_list_product_float { xs = xs }

## Groups elements by a key function.
pub let group_by
  : { xs: List 'a, f: { x: 'a } -> 'k <...> } with Eq 'k, Hash 'k
  -> List { key: 'k, values: List 'a } <...>
  = { xs, f } -> __native_list_group_by { xs = xs, f = f }

# Native: the guest fold + reverse measured 4.5x list::reverse; it takes no callback.
## Pairs each element with its index.
pub let enumerate: { xs: List 'a } -> List { value: 'a, index: Int } = { xs } ->
  __native_list_enumerate { xs = xs }

## Pairs each element with its index (alias for enumerate).
pub let zip_with_index
  : { xs: List 'a }
  -> List { value: 'a, index: Int }
  = { xs } -> enumerate { xs = xs }

## Executes f for each element, for side effects only.
pub let for_each: { xs: List 'a, f: { x: 'a } -> 'b <...> } -> {} <...> = { xs, f } ->
  __native_list_for_each { xs = xs, f = f }

## Like fold_left, but returns all intermediate accumulator values.
pub let scan
  : { xs: List 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> List 'acc <...>
  = { xs, init, f } -> __native_list_scan { xs = xs, init = init, f = f }

# Reuses take / drop.
## Splits at index i into {l, r}.
pub let split_at
  : { xs: List 'a, i: Int }
  -> { l: List 'a, r: List 'a }
  = { xs, i } -> {
    l = take { xs = xs, n = i },
    r = drop { xs = xs, n = i },
  }

# Reuses take_while / drop_while.
## Splits into prefix where predicate holds and the rest.
pub let span
  : { xs: List 'a, p: { x: 'a } -> Bool <...> }
  -> { l: List 'a, r: List 'a } <...>
  = { xs, p } -> {
    l = take_while { xs = xs, p = p },
    r = drop_while { xs = xs, p = p },
  }

let dedup_with_eq: { xs: List 'a, eq: { a: 'a, b: 'a } -> Bool } -> List 'a = { xs, eq } ->
  __native_list_dedup { xs = xs, eq = eq }

## Removes consecutive duplicate elements, by the element's Eq impl.
pub let dedup: { xs: List 'a } with Eq 'a -> List 'a = { xs } ->
  dedup_with_eq { xs = xs, eq = { a, b } -> a == b }

let dedup_by_with_eq
  : { xs: List 'a, f: { x: 'a } -> 'b <...>, eq: { a: 'b, b: 'b } -> Bool } -> List 'a <...>
  = { xs, f, eq } -> __native_list_dedup_by { xs = xs, f = f, eq = eq }

## Removes consecutive duplicates by a key function (keys compared by their Eq).
pub let dedup_by: { xs: List 'a, f: { x: 'a } -> 'b <...> } with Eq 'b -> List 'a <...> = { xs, f } ->
  dedup_by_with_eq { xs = xs, f = f, eq = { a, b } -> a == b }

## Returns the nth element, or None if out of bounds (alias for get).
pub let nth: { xs: List 'a, i: Int } -> Option 'a = { xs, i } ->
  __native_list_nth { xs = xs, i = i }

## Creates a list of n copies of x.
pub let fill: { n: Int, x: 'a } -> List 'a = { n, x } -> __native_list_fill { n = n, x = x }

## Creates a list of n elements using a generator function.
pub let fill_with: { n: Int, f: { i: Int } -> 'a <...> } -> List 'a <...> = { n, f } ->
  __native_list_fill_with { n = n, f = f }

let group_consecutive_with_eq
  : { xs: List 'a, eq: { a: 'a, b: 'a } -> Bool } -> List (List 'a) = { xs, eq } ->
  __native_list_group_consecutive { xs = xs, eq = eq }

## Groups consecutive equal elements into sub-lists, by the element's Eq impl.
pub let group_consecutive: { xs: List 'a } with Eq 'a -> List (List 'a) = { xs } ->
  group_consecutive_with_eq { xs = xs, eq = { a, b } -> a == b }

let group_consecutive_by_with_eq
  : { xs: List 'a, f: { x: 'a } -> 'b <...>, eq: { a: 'b, b: 'b } -> Bool }
  -> List (List 'a) <...>
  = { xs, f, eq } -> __native_list_group_consecutive_by { xs = xs, f = f, eq = eq }

## Groups consecutive elements by a key function (keys compared by their Eq).
pub let group_consecutive_by
  : { xs: List 'a, f: { x: 'a } -> 'b <...> } with Eq 'b
  -> List (List 'a) <...>
  = { xs, f } -> group_consecutive_by_with_eq { xs = xs, f = f, eq = { a, b } -> a == b }

## Takes elements from the front while the predicate holds.
pub let take_while: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> List 'a <...> = { xs, p } ->
  __native_list_take_while { xs = xs, p = p }

## Drops elements from the front while the predicate holds.
pub let drop_while: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> List 'a <...> = { xs, p } ->
  __native_list_drop_while { xs = xs, p = p }

## Returns True if no element matches the predicate.
pub let none: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_list_none { xs = xs, p = p }

## Counts elements matching the predicate.
pub let count: { xs: List 'a, p: { x: 'a } -> Bool <...> } -> Int <...> = { xs, p } ->
  __native_list_count { xs = xs, p = p }

# Constrained so a hand-written Eq is honoured (it was deduped structurally); no speed change.
## Removes duplicates, keeping the first occurrence, by the element's Eq/Hash impls. O(n).
pub let unique: { xs: List 'a } with Eq 'a, Hash 'a -> List 'a = { xs } ->
  __native_list_unique { xs = xs }

# Shares its native: `__native_list_distinct` existed only to delegate.
## Alias for unique.
pub let distinct: { xs: List 'a } with Eq 'a, Hash 'a -> List 'a = { xs } ->
  __native_list_unique { xs = xs }

## Flattens a list of lists into a single list (alias for concat).
pub let flatten: { xss: List (List 'a) } -> List 'a = { xss } -> concat { xss = xss }

## Returns True if the two lists are equal.
pub let equals: { xs: List 'a, ys: List 'a } with Eq 'a -> Bool = { xs, ys } ->
  list_equals_with_eq { xs = xs, ys = ys, eq = { a, b } -> a == b }

## Returns the index of the first occurrence, or None.
pub let index_of: { xs: List 'a, x: 'a } with Eq 'a -> Option Int = { xs, x } -> do
  let target = x
  find_index { xs = xs, p = { x } -> x == target }

# The comparator param is DECLARED so it ties to the element type; the public
# wrapper then passes the element's own `==`. Same trick as seq (#23).
let last_index_of_with_eq
  : { xs: List 'a, x: 'a, eq: { a: 'a, b: 'a } -> Bool } -> Option Int = { xs, x, eq } ->
  __native_list_last_index_of { xs = xs, x = x, eq = eq }

## Returns the index of the last occurrence, or None.
pub let last_index_of: { xs: List 'a, x: 'a } with Eq 'a -> Option Int = { xs, x } ->
  last_index_of_with_eq { xs = xs, x = x, eq = { a, b } -> a == b }

## Returns a slice from start (inclusive) to end (exclusive).
pub let slice: { xs: List 'a, start: Int, end: Int } -> List 'a = { xs, start, end } ->
  __native_list_slice { xs = xs, start = start, end = end }

## Splits into chunks of the given size; last chunk may be smaller.
pub let chunk: { xs: List 'a, size: Int } -> List (List 'a) = { xs, size } ->
  __native_list_chunk { xs = xs, size = size }

## Returns all sliding windows of the given size.
pub let windows: { xs: List 'a, size: Int } -> List (List 'a) = { xs, size } ->
  __native_list_windows { xs = xs, size = size }

## Returns sliding windows with a given step.
pub let sliding: { xs: List 'a, size: Int, step: Int } -> List (List 'a) = { xs, size, step } ->
  __native_list_sliding { xs = xs, size = size, step = step }

## Splits into exact chunks, dropping any incomplete final chunk.
pub let chunks_exact: { xs: List 'a, size: Int } -> List (List 'a) = { xs, size } ->
  __native_list_chunks_exact { xs = xs, size = size }

## Sorts using a key extraction function.
let sort_by_key_with_cmp
  : { xs: List 'a, f: { x: 'a } -> 'b <...>, cmp: { a: 'b, b: 'b } -> Int } -> List 'a <...>
  = { xs, f, cmp } -> __native_list_sort_by_key { xs = xs, f = f, cmp = cmp }

## Sorts using a key extraction function (keys ordered by their Ord impl).
pub let sort_by_key: { xs: List 'a, f: { x: 'a } -> 'b <...> } with Ord 'b -> List 'a <...> = { xs, f } ->
  sort_by_key_with_cmp { xs = xs, f = f, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Rotates elements left by n positions.
pub let rotate_left: { xs: List 'a, n: Int } -> List 'a = { xs, n } ->
  __native_list_rotate_left { xs = xs, n = n }

## Rotates elements right by n positions.
pub let rotate_right: { xs: List 'a, n: Int } -> List 'a = { xs, n } ->
  __native_list_rotate_right { xs = xs, n = n }

# The Eq/Hash constraint stops bucketing by representation, which ignored a hand-written Eq.
## Converts to a Set, using the element's own `Eq`/`Hash` impls.
pub let to_set: { xs: List 'a } with Eq 'a, Hash 'a -> Set 'a = { xs } ->
  __native_list_to_set { xs = xs }

pub let to_set_with_evidence:
  { xs: List 'a, hash: { it: 'a } -> Int, eq: { it: 'a, r: 'a } -> Bool } -> Set 'a =
  { xs, hash, eq } -> __native_list_to_set_with_evidence { xs = xs, hash = hash, eq = eq }

## Converts to a Deque.
pub let to_deque: { xs: List 'a } -> Deque 'a = { xs } -> __native_list_to_deque { xs = xs }

let to_sorted_set_with_cmp
  : { xs: List 'a, cmp: { a: 'a, b: 'a } -> Int } -> SortedSet 'a = { xs, cmp } ->
  __native_list_to_sorted_set { xs = xs, cmp = cmp }

## Converts to a SortedSet, ordered by the element's Ord impl.
pub let to_sorted_set: { xs: List 'a } with Ord 'a -> SortedSet 'a = { xs } ->
  to_sorted_set_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

# Without the constraint the keys bucketed by REPRESENTATION — two keys a
# hand-written `Eq` calls one key stayed apart.
## Converts a list of {k, v} records to a Map, using the key's own `Eq`/`Hash` impls.
pub let to_map: { xs: List { k: 'k, v: 'v } } with Eq 'k, Hash 'k -> Map 'k 'v = { xs } ->
  __native_list_to_map { xs = xs }

pub let to_map_with_evidence:
  { xs: List { k: 'k, v: 'v }, hash: { it: 'k } -> Int, eq: { it: 'k, r: 'k } -> Bool }
  -> Map 'k 'v =
  { xs, hash, eq } -> __native_list_to_map_with_evidence { xs = xs, hash = hash, eq = eq }

let to_sorted_map_with_cmp
  : { xs: List { k: 'k, v: 'v }, cmp: { a: 'k, b: 'k } -> Int } -> SortedMap 'k 'v = { xs, cmp } ->
  __native_list_to_sorted_map { xs = xs, cmp = cmp }

## Converts a list of {k, v} records to a SortedMap, ordered by the key's Ord impl.
pub let to_sorted_map: { xs: List { k: 'k, v: 'v } } with Ord 'k -> SortedMap 'k 'v = { xs } ->
  to_sorted_map_with_cmp { xs = xs, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Creates a list from a Set.
pub let from_set: { xs: Set 'a } -> List 'a = { xs } -> __native_list_from_set { xs = xs }

## Creates a list from a Deque.
pub let from_deque: { xs: Deque 'a } -> List 'a = { xs } -> __native_list_from_deque { xs = xs }

## Creates a list from a SortedSet (in sorted order).
pub let from_sorted_set: { xs: SortedSet 'a } -> List 'a = { xs } ->
  __native_list_from_sorted_set { xs = xs }

## Creates a list of {k, v} records from a Map.
pub let from_map: { m: Map 'k 'v } -> List { k: 'k, v: 'v } = { m } ->
  __native_list_from_map { m = m }

## Creates a list of {k, v} records from a SortedMap (in sorted key order).
pub let from_sorted_map
  : { m: SortedMap 'k 'v }
  -> List { k: 'k, v: 'v }
  = { m } -> __native_list_from_sorted_map { m = m }

## Returns the arithmetic mean, or None if empty.
pub let average: { xs: List Float } -> Option Float = { xs } -> __native_list_average { xs = xs }

## Returns the population variance, or None if empty.
pub let variance: { xs: List Float } -> Option Float = { xs } ->
  __native_list_variance { xs = xs }

## Returns the standard deviation, or None if empty.
pub let stddev: { xs: List Float } -> Option Float = { xs } -> __native_list_stddev { xs = xs }

## Returns the median value, or None if empty.
pub let median: { xs: List Float } -> Option Float = { xs } -> __native_list_median { xs = xs }

## Lexicographic comparison; returns -1, 0, or 1.
pub let compare: { xs: List 'a, ys: List 'a } with Ord 'a -> Int = { xs, ys } ->
  list_compare_with_cmp { xs = xs, ys = ys, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Lexicographic comparison with a custom comparator.
pub let lexicographic_compare
  : { xs: List 'a, ys: List 'a, cmp: { a: 'a, b: 'a } -> Int <...> }
  -> Int <...>
  = { xs, ys, cmp } -> __native_list_lexicographic_compare { xs = xs, ys = ys, cmp = cmp }

## Adjacent-pair walk with short-circuit on first out-of-order pair.
let is_sorted_by_go
  : { prev: 'a, rest: List 'a, cmp: { a: 'a, b: 'a } -> Bool <...> }
  -> Bool <...>
  = { prev, rest, cmp } -> match uncons { xs = rest } is
    None -> True
    Some { val = { head, tail } } -> if cmp { a = prev, b = head } then is_sorted_by_go { prev = head, rest = tail, cmp = cmp } else False


## True if sorted by the less-or-equal `cmp` (`cmp { a, b }` is True when `a` comes before `b`).
pub let is_sorted_by
  : { xs: List 'a, cmp: { a: 'a, b: 'a } -> Bool <...> }
  -> Bool <...>
  = { xs, cmp } -> match uncons { xs = xs } is
    None -> True
    Some { val = { head, tail } } -> is_sorted_by_go { prev = head, rest = tail, cmp = cmp }


## Returns True if elements are in ascending order.
pub let is_sorted: { xs: List 'a } with Ord 'a -> Bool = { xs } ->
  is_sorted_by { xs = xs, cmp = { a, b } -> a <= b }

## Returns True if elements are in descending order.
pub let is_sorted_descending: { xs: List 'a } with Ord 'a -> Bool = { xs } ->
  is_sorted_by { xs = xs, cmp = { a, b } -> a >= b }

let binary_search_with_cmp
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int } -> Option Int = { xs, target, cmp } ->
  __native_list_binary_search { xs = xs, target = target, cmp = cmp }

## Binary search in a sorted list, returning the index or None.
pub let binary_search: { xs: List 'a, target: 'a } with Ord 'a -> Option Int = { xs, target } ->
  binary_search_with_cmp { xs = xs, target = target, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let binary_search_insert_point_with_cmp
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int } -> Int = { xs, target, cmp } ->
  __native_list_binary_search_insert_point { xs = xs, target = target, cmp = cmp }

## Returns the insertion point to maintain sorted order.
pub let binary_search_insert_point: { xs: List 'a, target: 'a } with Ord 'a -> Int = { xs, target } ->
  binary_search_insert_point_with_cmp { xs = xs, target = target, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let lower_bound_with_cmp
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int } -> Int = { xs, target, cmp } ->
  __native_list_lower_bound { xs = xs, target = target, cmp = cmp }

## Returns the first index where element >= target in a sorted list.
pub let lower_bound: { xs: List 'a, target: 'a } with Ord 'a -> Int = { xs, target } ->
  lower_bound_with_cmp { xs = xs, target = target, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let upper_bound_with_cmp
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int } -> Int = { xs, target, cmp } ->
  __native_list_upper_bound { xs = xs, target = target, cmp = cmp }

## Returns the first index where element > target in a sorted list.
pub let upper_bound: { xs: List 'a, target: 'a } with Ord 'a -> Int = { xs, target } ->
  upper_bound_with_cmp { xs = xs, target = target, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

let equal_range_with_cmp
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int }
  -> { start: Int, end: Int }
  = { xs, target, cmp } -> __native_list_equal_range { xs = xs, target = target, cmp = cmp }

## Returns {start, end} bounds for target in a sorted list.
pub let equal_range
  : { xs: List 'a, target: 'a } with Ord 'a
  -> { start: Int, end: Int }
  = { xs, target } -> equal_range_with_cmp { xs = xs, target = target, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 }

## Binary search with a custom comparator.
pub let binary_search_by
  : { xs: List 'a, target: 'a, cmp: { a: 'a, b: 'a } -> Int <...> }
  -> Option Int <...>
  = { xs, target, cmp } -> __native_list_binary_search_by { xs = xs, target = target, cmp = cmp }

## Method implementations for List.
impl List 'a where {
  head = { it } -> head { xs = it },
  tail = { it } -> tail { xs = it },
  push = { it, x } -> push { x = x, xs = it },
  append = { it, ys } -> append { xs = it, ys = ys },
  get = { it, index } -> get { xs = it, index = index },
  take = { it, n } -> take { xs = it, n = n },
  drop = { it, n } -> drop { xs = it, n = n },
  map = { it, f } -> map { xs = it, f = f },
  filter = { it, p } -> filter { xs = it, p = p },
  fold_left = { it, init, f } -> fold_left { xs = it, init = init, f = f },
  reduce = { it, f } -> reduce { xs = it, f = f },
  flat_map = { it, f } -> flat_map { xs = it, f = f },
  any = { it, p } -> any { xs = it, p = p },
  all = { it, p } -> all { xs = it, p = p },
  contains = { it, x } -> contains { xs = it, x = x },
  reverse = { it } -> reverse { xs = it },
  sort = { it } -> sort { xs = it },
  sort_by = { it, cmp } -> sort_by { xs = it, cmp = cmp },
  find = { it, p } -> find { xs = it, p = p },
  last = { it } -> last { xs = it },
  zip = { it, ys } -> zip { xs = it, ys = ys },
  for_each = { it, f } -> for_each { xs = it, f = f },
  partition = { it, p } -> partition { xs = it, p = p },
  unique = { it } -> unique { xs = it },
  flatten = { it } -> flatten { xss = it },
  enumerate = { it } -> enumerate { xs = it },
  min = { it } -> min { xs = it },
  max = { it } -> max { xs = it },
  sum = { it } -> sum { xs = it },
  to_seq = { it } -> to_seq { xs = it },
  to_set = { it } -> to_set { xs = it },

  # dot-chain parity: an inherent method for every receiver-taking free
  # function not already covered by an ability, so `x.op {}` always works.
  uncons = { it } -> uncons { xs = it },
  fold_right = { it, init, f } -> fold_right { xs = it, init = init, f = f },
  concat = { it } -> concat { xss = it },
  unzip = { it } -> unzip { xs = it },
  intersperse = { it, sep } -> intersperse { xs = it, sep = sep },
  find_index = { it, p } -> find_index { xs = it, p = p },
  init = { it } -> init { xs = it },
  min_by = { it, f } -> min_by { xs = it, f = f },
  max_by = { it, f } -> max_by { xs = it, f = f },
  sum_float = { it } -> sum_float { xs = it },
  product = { it } -> product { xs = it },
  product_float = { it } -> product_float { xs = it },
  group_by = { it, f } -> group_by { xs = it, f = f },
  zip_with_index = { it } -> zip_with_index { xs = it },
  scan = { it, init, f } -> scan { xs = it, init = init, f = f },
  split_at = { it, i } -> split_at { xs = it, i = i },
  span = { it, p } -> span { xs = it, p = p },
  dedup = { it } -> dedup { xs = it },
  dedup_by = { it, f } -> dedup_by { xs = it, f = f },
  nth = { it, i } -> nth { xs = it, i = i },
  group_consecutive = { it } -> group_consecutive { xs = it },
  group_consecutive_by = { it, f } -> group_consecutive_by { xs = it, f = f },
  take_while = { it, p } -> take_while { xs = it, p = p },
  drop_while = { it, p } -> drop_while { xs = it, p = p },
  none = { it, p } -> none { xs = it, p = p },
  count = { it, p } -> count { xs = it, p = p },
  distinct = { it } -> distinct { xs = it },
  equals = { it, ys } -> equals { xs = it, ys = ys },
  index_of = { it, x } -> index_of { xs = it, x = x },
  last_index_of = { it, x } -> last_index_of { xs = it, x = x },
  slice = { it, start, end } -> slice { xs = it, start = start, end = end },
  chunk = { it, size } -> chunk { xs = it, size = size },
  windows = { it, size } -> windows { xs = it, size = size },
  sliding = { it, size, step } -> sliding { xs = it, size = size, step = step },
  chunks_exact = { it, size } -> chunks_exact { xs = it, size = size },
  sort_by_key = { it, f } -> sort_by_key { xs = it, f = f },
  rotate_left = { it, n } -> rotate_left { xs = it, n = n },
  rotate_right = { it, n } -> rotate_right { xs = it, n = n },
  to_deque = { it } -> to_deque { xs = it },
  to_sorted_set = { it } -> to_sorted_set { xs = it },
  to_map = { it } -> to_map { xs = it },
  to_sorted_map = { it } -> to_sorted_map { xs = it },
  average = { it } -> average { xs = it },
  variance = { it } -> variance { xs = it },
  stddev = { it } -> stddev { xs = it },
  median = { it } -> median { xs = it },
  compare = { it, ys } -> compare { xs = it, ys = ys },
  lexicographic_compare = { it, ys, cmp } -> lexicographic_compare { xs = it, ys = ys, cmp = cmp },
  is_sorted_by = { it, cmp } -> is_sorted_by { xs = it, cmp = cmp },
  is_sorted = { it } -> is_sorted { xs = it },
  is_sorted_descending = { it } -> is_sorted_descending { xs = it },
  binary_search = { it, target } -> binary_search { xs = it, target = target },
  binary_search_insert_point = { it, target } -> binary_search_insert_point { xs = it, target = target },
  lower_bound = { it, target } -> lower_bound { xs = it, target = target },
  upper_bound = { it, target } -> upper_bound { xs = it, target = target },
  equal_range = { it, target } -> equal_range { xs = it, target = target },
  binary_search_by = { it, target, cmp } -> binary_search_by { xs = it, target = target, cmp = cmp },
}

impl Sized for List 'a where {
  size = { it } -> size { xs = it },
  is_empty = { it } -> is_empty { xs = it },
}

impl Iterable for List 'a having 'elem = 'a where {
  to_iter = { it } -> iter::from_list { xs = it }
}

## Wrap any value in a one-element linked List: `x.list {}`.
ability Listable for 'a where {
  list: { it: 'a } -> List 'a
}

impl Listable for 'a where {
  list = { it } -> singleton { x = it }
}
