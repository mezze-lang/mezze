use std::abilities::compare::{ Eq, Ord }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::abilities::iter::{ Iterable }
use std::collections::iter
use std::collections::seq
use std::int

## Default Deque is the empty deque.
impl Default for Deque 'a where {
  default = {} -> empty {}
}

## Structural equality for deques.
impl Eq for Deque 'a where {
  eq = { it, r } -> __native_deque_equals { d1 = it, d2 = r },
  neq = { it, r } -> if __native_deque_equals { d1 = it, d2 = r } then False else True,
}

## Lexicographic ordering for deques.
impl Ord for Deque 'a where {
  lt: { it: Deque 'a, r: Deque 'a } with Ord 'a -> Bool = { it, r } ->
    __native_deque_compare { d1 = it, d2 = r } == (0 - 1),
  le: { it: Deque 'a, r: Deque 'a } with Ord 'a -> Bool = { it, r } ->
    __native_deque_compare { d1 = it, d2 = r } != 1,
  gt: { it: Deque 'a, r: Deque 'a } with Ord 'a -> Bool = { it, r } ->
    __native_deque_compare { d1 = it, d2 = r } == 1,
  ge: { it: Deque 'a, r: Deque 'a } with Ord 'a -> Bool = { it, r } ->
    __native_deque_compare { d1 = it, d2 = r } != (0 - 1),
}

## Creates an empty deque.
pub let empty: {} -> Deque 'a = {} -> __native_deque_empty {}

## Creates a single-element deque.
pub let singleton: { x: 'a } -> Deque 'a = { x } -> __native_deque_singleton { x = x }

## Creates a deque from a List.
pub let from_list: { xs: List 'a } -> Deque 'a = { xs } -> __native_deque_from_list { xs = xs }

## Adds an element to the front. O(1) amortized.
pub let push_front: { d: Deque 'a, x: 'a } -> Deque 'a = { d, x } ->
  __native_deque_push_front { d = d, x = x }

## Adds an element to the back. O(1) amortized.
pub let push_back: { d: Deque 'a, x: 'a } -> Deque 'a = { d, x } ->
  __native_deque_push_back { d = d, x = x }

## Removes and returns the front element as {head, tail}, or None if empty.
pub let pop_front
  : { d: Deque 'a }
  -> Option { head: 'a, tail: Deque 'a }
  = { d } -> __native_deque_pop_front { d = d }

## Removes and returns the back element as {init, last}, or None if empty.
pub let pop_back
  : { d: Deque 'a }
  -> Option { init: Deque 'a, last: 'a }
  = { d } -> __native_deque_pop_back { d = d }

## Returns the front element without removing it, or None.
pub let peek_front: { d: Deque 'a } -> Option 'a = { d } -> __native_deque_peek_front { d = d }

## Returns the back element without removing it, or None.
pub let peek_back: { d: Deque 'a } -> Option 'a = { d } -> __native_deque_peek_back { d = d }

## Returns True if the deque has no elements.
pub let is_empty: { d: Deque 'a } -> Bool = { d } -> __native_deque_is_empty { d = d }

## Returns the number of elements.
pub let size: { d: Deque 'a } -> Int = { d } -> __native_deque_size { d = d }

## Converts to a List.
pub let to_list: { d: Deque 'a } -> List 'a = { d } -> __native_deque_to_list { d = d }

## Converts to a Seq.
pub let to_seq: { d: Deque 'a } -> ['a] = { d } -> __native_deque_to_seq { d = d }

## Creates a deque from a Seq.
pub let from_seq: { xs: ['a] } -> Deque 'a = { xs } -> __native_deque_from_seq { xs = xs }

## Applies f to each element, returning a new deque.
pub let map: { d: Deque 'a, f: { x: 'a } -> 'b <...> } -> Deque 'b <...> = { d, f } ->
  __native_deque_map { d = d, f = f }

## Keeps only elements for which the predicate returns True.
pub let filter: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Deque 'a <...> = { d, p } ->
  __native_deque_filter { d = d, p = p }

## Folds over elements with an accumulator.
pub let fold
  : { d: Deque 'a, init: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> 'b <...>
  = { d, init, f } -> __native_deque_fold { d = d, init = init, f = f }

## Reverses the deque.
pub let reverse: { d: Deque 'a } -> Deque 'a = { d } -> __native_deque_reverse { d = d }

## Concatenates two deques.
pub let concat: { d1: Deque 'a, d2: Deque 'a } -> Deque 'a = { d1, d2 } ->
  __native_deque_concat { d1 = d1, d2 = d2 }

## Adds to the back (FIFO enqueue).
pub let enqueue: { d: Deque 'a, x: 'a } -> Deque 'a = { d, x } -> push_back { d = d, x = x }

## Removes from the front (FIFO dequeue).
pub let dequeue
  : { d: Deque 'a }
  -> Option { head: 'a, tail: Deque 'a }
  = { d } -> pop_front { d = d }

## Adds to the front (LIFO push).
pub let push: { d: Deque 'a, x: 'a } -> Deque 'a = { d, x } -> push_front { d = d, x = x }

## Removes from the front (LIFO pop).
pub let pop: { d: Deque 'a } -> Option { head: 'a, tail: Deque 'a } = { d } -> pop_front { d = d }

## Returns True if the two deques are equal.
pub let equals: { d1: Deque 'a, d2: Deque 'a } -> Bool = { d1, d2 } ->
  __native_deque_equals { d1 = d1, d2 = d2 }

## Returns the minimum element by a key function, or None.
pub let min_by: { d: Deque 'a, f: { val: 'a } -> 'b <...> } -> Option 'a <...> = { d, f } ->
  __native_deque_min_by { d = d, f = f }

## Returns the maximum element by a key function, or None.
pub let max_by: { d: Deque 'a, f: { val: 'a } -> 'b <...> } -> Option 'a <...> = { d, f } ->
  __native_deque_max_by { d = d, f = f }

## Returns the element at index i, or None.
pub let get: { d: Deque 'a, i: Int } -> Option 'a = { d, i } ->
  __native_deque_get { d = d, i = i }

## Returns a slice from start (inclusive) to end (exclusive).
pub let slice: { d: Deque 'a, start: Int, end: Int } -> Deque 'a = { d, start, end } ->
  __native_deque_slice { d = d, start = start, end = end }

## Returns the index of the first occurrence, or None.
pub let index_of: { d: Deque 'a, x: 'a } -> Option Int = { d, x } ->
  __native_deque_index_of { d = d, x = x }

## Returns the index of the first element matching the predicate, or None.
pub let find_index
  : { d: Deque 'a, p: { val: 'a } -> Bool <...> }
  -> Option Int <...>
  = { d, p } -> __native_deque_find_index { d = d, p = p }

## Takes elements from the front while the predicate holds.
pub let take_while: { d: Deque 'a, p: { val: 'a } -> Bool <...> } -> Deque 'a <...> = { d, p } ->
  __native_deque_take_while { d = d, p = p }

## Drops elements from the front while the predicate holds.
pub let drop_while: { d: Deque 'a, p: { val: 'a } -> Bool <...> } -> Deque 'a <...> = { d, p } ->
  __native_deque_drop_while { d = d, p = p }

## Splits at index i into {l, r}.
pub let split_at
  : { d: Deque 'a, i: Int }
  -> { l: Deque 'a, r: Deque 'a }
  = { d, i } -> __native_deque_split_at { d = d, i = i }

## Splits into prefix where predicate holds and the rest.
pub let span
  : { d: Deque 'a, p: { val: 'a } -> Bool <...> }
  -> { l: Deque 'a, r: Deque 'a } <...>
  = { d, p } -> __native_deque_span { d = d, p = p }

## Like fold, but returns all intermediate accumulator values.
pub let scan
  : { d: Deque 'a, init: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> Deque 'b <...>
  = { d, init, f } -> __native_deque_scan { d = d, init = init, f = f }

## Removes consecutive duplicate elements.
pub let dedup: { d: Deque 'a } -> Deque 'a = { d } -> __native_deque_dedup { d = d }

## Removes consecutive duplicates by a key function.
pub let dedup_by: { d: Deque 'a, f: { val: 'a } -> 'b <...> } -> Deque 'a <...> = { d, f } ->
  __native_deque_dedup_by { d = d, f = f }

## Inserts a separator between every pair of elements.
pub let intersperse: { d: Deque 'a, sep: 'a } -> Deque 'a = { d, sep } ->
  __native_deque_intersperse { d = d, sep = sep }

## Pairs elements from two deques into records of {fst, snd}.
pub let zip
  : { d1: Deque 'a, d2: Deque 'b }
  -> Deque { fst: 'a, snd: 'b }
  = { d1, d2 } -> __native_deque_zip { d1 = d1, d2 = d2 }

## Pairs each element with its index.
pub let zip_with_index: { d: Deque 'a } -> Deque { val: 'a, idx: Int } = { d } ->
  __native_deque_zip_with_index { d = d }

## Rotates elements left by n positions.
pub let rotate_left: { d: Deque 'a, n: Int } -> Deque 'a = { d, n } ->
  __native_deque_rotate_left { d = d, n = n }

## Rotates elements right by n positions.
pub let rotate_right: { d: Deque 'a, n: Int } -> Deque 'a = { d, n } ->
  __native_deque_rotate_right { d = d, n = n }

## Converts to a Set.
pub let to_set: { d: Deque 'a } -> Set 'a = { d } -> __native_deque_to_set { d = d }

## Converts to a SortedSet.
pub let to_sorted_set: { d: Deque 'a } -> SortedSet 'a = { d } ->
  __native_deque_to_sorted_set { d = d }

## Converts a deque of {key, value} records to a Map.
pub let to_map: { d: Deque { k: 'k, v: 'v } } -> Map 'k 'v = { d } ->
  __native_deque_to_map { d = d }

## Converts a deque of {key, value} records to a SortedMap.
pub let to_sorted_map: { d: Deque { k: 'k, v: 'v } } -> SortedMap 'k 'v = { d } ->
  __native_deque_to_sorted_map { d = d }

## Creates a deque from a Set.
pub let from_set: { s: Set 'a } -> Deque 'a = { s } -> __native_deque_from_set { s = s }

## Creates a deque from a SortedSet (in sorted order).
pub let from_sorted_set: { s: SortedSet 'a } -> Deque 'a = { s } ->
  __native_deque_from_sorted_set { s = s }

## Creates a deque from a Map (as {key, value} records).
pub let from_map: { m: Map 'k 'v } -> Deque { k: 'k, v: 'v } = { m } ->
  __native_deque_from_map { m = m }

## Creates a deque from a SortedMap (as {key, value} records, in sorted key order).
pub let from_sorted_map
  : { m: SortedMap 'k 'v }
  -> Deque { k: 'k, v: 'v }
  = { m } -> __native_deque_from_sorted_map { m = m }

## Takes the first n elements.
pub let take: { d: Deque 'a, n: Int } -> Deque 'a = { d, n } ->
  __native_deque_take { d = d, n = n }

## Drops the first n elements.
pub let drop: { d: Deque 'a, n: Int } -> Deque 'a = { d, n } ->
  __native_deque_drop { d = d, n = n }

## Splits into elements matching and not matching the predicate.
pub let partition
  : { d: Deque 'a, p: { val: 'a } -> Bool <...> }
  -> { pass: Deque 'a, fail: Deque 'a } <...>
  = { d, p } -> __native_deque_partition { d = d, p = p }

## Removes duplicate elements, keeping the first occurrence.
pub let unique: { d: Deque 'a } -> Deque 'a = { d } -> __native_deque_unique { d = d }

## Sorts elements in ascending order.
pub let sort: { d: Deque 'a } with Ord 'a -> Deque 'a = { d } ->
  from_seq { xs = seq::sort { xs = to_seq { d = d } } }

## Returns True if any element matches the predicate.
pub let any: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { d, p } ->
  __native_deque_any { d = d, p = p }

## Returns True if all elements match the predicate.
pub let all: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { d, p } ->
  __native_deque_all { d = d, p = p }

## Returns True if no element matches the predicate.
pub let none: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { d, p } ->
  __native_deque_none { d = d, p = p }

## Returns the first element matching the predicate, or None.
pub let find: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Option 'a <...> = { d, p } ->
  __native_deque_find { d = d, p = p }

## Counts elements matching the predicate.
pub let count: { d: Deque 'a, p: { x: 'a } -> Bool <...> } -> Int <...> = { d, p } ->
  __native_deque_count { d = d, p = p }

## Reduces elements using f, returning None if empty.
pub let reduce
  : { d: Deque 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { d, f } -> __native_deque_reduce { d = d, f = f }

## Sums all integer elements.
pub let sum: { d: Deque Int } -> Int = { d } -> __native_deque_sum { d = d }

## Returns the product of all integer elements.
pub let product: { d: Deque Int } -> Int = { d } -> __native_deque_product { d = d }

## Returns the minimum element, or None if empty.
pub let min: { d: Deque 'a } with Ord 'a -> Option 'a = { d } ->
  reduce { d = d, f = { acc, x } -> if x < acc then x else acc }

## Returns the maximum element, or None if empty.
pub let max: { d: Deque 'a } with Ord 'a -> Option 'a = { d } ->
  reduce { d = d, f = { acc, x } -> if x > acc then x else acc }

## Returns True if the deque contains the element.
pub let contains: { d: Deque 'a, x: 'a } with Eq 'a -> Bool = { d, x } ->
  __native_deque_contains { d = d, x = x }

## Executes f for each element, for side effects only.
pub let for_each: { d: Deque 'a, f: { x: 'a } -> 'b <...> } -> {} <...> = { d, f } ->
  __native_deque_for_each { d = d, f = f }

## Returns the first element, or None if empty.
pub let first: { d: Deque 'a } -> Option 'a = { d } -> __native_deque_first { d = d }

## Returns the last element, or None if empty.
pub let last: { d: Deque 'a } -> Option 'a = { d } -> __native_deque_last { d = d }

## Applies f to each element and flattens the resulting deques.
pub let flat_map: { d: Deque 'a, f: { x: 'a } -> Deque 'b <...> } -> Deque 'b <...> = { d, f } ->
  __native_deque_flat_map { d = d, f = f }

## Sums all float elements.
pub let sum_float: { d: Deque Float } -> Float = { d } -> __native_deque_sum_float { d = d }

## Returns the product of all float elements.
pub let product_float: { d: Deque Float } -> Float = { d } ->
  __native_deque_product_float { d = d }

## Method implementations for Deque.
impl Deque 'a where {
  push_front = { it, x } -> push_front { d = it, x = x },
  push_back = { it, x } -> push_back { d = it, x = x },
  pop_front = { it } -> pop_front { d = it },
  pop_back = { it } -> pop_back { d = it },
  peek_front = { it } -> peek_front { d = it },
  peek_back = { it } -> peek_back { d = it },
  map = { it, f } -> map { d = it, f = f },
  filter = { it, p } -> filter { d = it, p = p },
  fold = { it, init, f } -> fold { d = it, init = init, f = f },
  reverse = { it } -> reverse { d = it },
  concat = { it, d2 } -> concat { d1 = it, d2 = d2 },
  take = { it, n } -> take { d = it, n = n },
  drop = { it, n } -> drop { d = it, n = n },
  sort = { it } -> sort { d = it },
  unique = { it } -> unique { d = it },
  to_list = { it } -> to_list { d = it },
  to_seq = { it } -> to_seq { d = it },

  ## dot-chain parity: an inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` always works.
  enqueue = { it, x } -> enqueue { d = it, x = x },
  dequeue = { it } -> dequeue { d = it },
  push = { it, x } -> push { d = it, x = x },
  pop = { it } -> pop { d = it },
  min_by = { it, f } -> min_by { d = it, f = f },
  max_by = { it, f } -> max_by { d = it, f = f },
  get = { it, i } -> get { d = it, i = i },
  slice = { it, start, end } -> slice { d = it, start = start, end = end },
  index_of = { it, x } -> index_of { d = it, x = x },
  find_index = { it, p } -> find_index { d = it, p = p },
  take_while = { it, p } -> take_while { d = it, p = p },
  drop_while = { it, p } -> drop_while { d = it, p = p },
  split_at = { it, i } -> split_at { d = it, i = i },
  span = { it, p } -> span { d = it, p = p },
  scan = { it, init, f } -> scan { d = it, init = init, f = f },
  dedup = { it } -> dedup { d = it },
  dedup_by = { it, f } -> dedup_by { d = it, f = f },
  intersperse = { it, sep } -> intersperse { d = it, sep = sep },
  zip_with_index = { it } -> zip_with_index { d = it },
  rotate_left = { it, n } -> rotate_left { d = it, n = n },
  rotate_right = { it, n } -> rotate_right { d = it, n = n },
  to_set = { it } -> to_set { d = it },
  to_sorted_set = { it } -> to_sorted_set { d = it },
  to_map = { it } -> to_map { d = it },
  to_sorted_map = { it } -> to_sorted_map { d = it },
  partition = { it, p } -> partition { d = it, p = p },
  any = { it, p } -> any { d = it, p = p },
  all = { it, p } -> all { d = it, p = p },
  none = { it, p } -> none { d = it, p = p },
  find = { it, p } -> find { d = it, p = p },
  count = { it, p } -> count { d = it, p = p },
  reduce = { it, f } -> reduce { d = it, f = f },
  sum = { it } -> sum { d = it },
  product = { it } -> product { d = it },
  min = { it } -> min { d = it },
  max = { it } -> max { d = it },
  contains = { it, x } -> contains { d = it, x = x },
  for_each = { it, f } -> for_each { d = it, f = f },
  first = { it } -> first { d = it },
  last = { it } -> last { d = it },
  flat_map = { it, f } -> flat_map { d = it, f = f },
  sum_float = { it } -> sum_float { d = it },
  product_float = { it } -> product_float { d = it },
}

impl Sized for Deque 'a where {
  size = { it } -> size { d = it },
  is_empty = { it } -> is_empty { d = it },
}

impl Iterable for Deque 'a having 'elem = 'a where {
  to_iter = { it } -> iter::from_seq { xs = to_seq { d = it } }
}
