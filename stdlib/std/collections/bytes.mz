use std::abilities::compare::{ Eq, Ord }
use std::abilities::sized::{ Sized }
use std::abilities::default::{ Default }
use std::int

## Default Bytes is the empty byte sequence.
impl Default for Bytes where {
  default = {} -> empty {}
}

## Structural equality for byte sequences.
impl Eq for Bytes where {
  eq = { it, r } -> __native_bytes_equals { b1 = it, b2 = r },
  neq = { it, r } -> if __native_bytes_equals { b1 = it, b2 = r } then False else True,
}

## Lexicographic ordering for byte sequences.
impl Ord for Bytes where {
  lt = { it, r } -> __native_bytes_compare { b1 = it, b2 = r } == (0 - 1),
  le = { it, r } -> __native_bytes_compare { b1 = it, b2 = r } != 1,
  gt = { it, r } -> __native_bytes_compare { b1 = it, b2 = r } == 1,
  ge = { it, r } -> __native_bytes_compare { b1 = it, b2 = r } != (0 - 1),
}

## Creates an empty byte sequence.
pub let empty: {} -> Bytes = {} -> __native_bytes_empty {}

## Creates bytes from a UTF-8 string.
pub let from_string: { s: Str } -> Bytes = { s } -> __native_bytes_from_string { s = s }

## Creates bytes from a seq of integers (0-255).
pub let from_seq: { arr: [Int] } -> Bytes = { arr } -> __native_bytes_from_seq { arr = arr }

## Creates bytes from a hex string (e.g., "48656c6c6f"), or None on invalid input.
pub let from_hex: { s: Str } -> Option Bytes = { s } -> __native_bytes_from_hex { s = s }

## Creates bytes from a base64-encoded string, or None on invalid input.
pub let from_base64: { s: Str } -> Option Bytes = { s } -> __native_bytes_from_base64 { s = s }

## Returns the number of bytes.
pub let size: { b: Bytes } -> Int = { b } -> __native_bytes_size { b = b }

## Returns True if the byte sequence is empty.
pub let is_empty: { b: Bytes } -> Bool = { b } -> __native_bytes_is_empty { b = b }

## Returns the byte at index i as an unsigned int (0-255), or None.
pub let get: { b: Bytes, i: Int } -> Option Int = { b, i } -> __native_bytes_get { b = b, i = i }

## Returns a slice from start (inclusive) to end (exclusive).
pub let slice: { b: Bytes, start: Int, end: Int } -> Bytes = { b, start, end } -> __native_bytes_slice { b = b, start = start, end = end }

## Takes the first n bytes.
pub let take: { b: Bytes, n: Int } -> Bytes = { b, n } -> __native_bytes_take { b = b, n = n }

## Drops the first n bytes.
pub let drop: { b: Bytes, n: Int } -> Bytes = { b, n } -> __native_bytes_drop { b = b, n = n }

## Concatenates two byte sequences.
pub let concat: { b1: Bytes, b2: Bytes } -> Bytes = { b1, b2 } -> __native_bytes_concat { b1 = b1, b2 = b2 }

## Concatenates multiple byte sequences efficiently.
pub let concat_all: { bs: [Bytes] } -> Bytes = { bs } -> __native_bytes_concat_all { bs = bs }

## Repeats the byte sequence n times.
pub let repeat: { b: Bytes, n: Int } -> Bytes = { b, n } -> __native_bytes_repeat { b = b, n = n }

## Returns the index of the first occurrence of pattern, or None.
pub let index_of: { b: Bytes, pattern: Bytes } -> Option Int = { b, pattern } -> __native_bytes_index_of { b = b, pattern = pattern }

## Returns True if the byte sequence contains the pattern.
pub let contains: { b: Bytes, pattern: Bytes } -> Bool = { b, pattern } -> __native_bytes_contains { b = b, pattern = pattern }

## Returns True if the byte sequence starts with the given prefix.
pub let starts_with: { b: Bytes, prefix: Bytes } -> Bool = { b, prefix } -> __native_bytes_starts_with { b = b, prefix = prefix }

## Returns True if the byte sequence ends with the given suffix.
pub let ends_with: { b: Bytes, suffix: Bytes } -> Bool = { b, suffix } -> __native_bytes_ends_with { b = b, suffix = suffix }

## Reverses the byte order.
pub let reverse: { b: Bytes } -> Bytes = { b } -> __native_bytes_reverse { b = b }

## Maps a function over each byte (function receives and returns 0-255).
pub let map: { b: Bytes, f: { x: Int } -> Int } -> Bytes = { b, f } -> __native_bytes_map { b = b, f = f }

## Folds over bytes from left to right.
pub let fold: { b: Bytes, init: 'a, f: { acc: 'a, byte: Int } -> 'a } -> 'a = { b, init, f } -> __native_bytes_fold { b = b, init = init, f = f }

## Decodes as a UTF-8 string, returning a Result.
pub let to_str: { b: Bytes } -> Result Str Str = { b } -> __native_bytes_to_str { b = b }

## Converts to a seq of integers (0-255).
pub let to_seq: { b: Bytes } -> [Int] = { b } -> __native_bytes_to_seq { b = b }

## Converts to a lowercase hexadecimal string.
pub let to_hex: { b: Bytes } -> Str = { b } -> __native_bytes_to_hex { b = b }

## Converts to a base64-encoded string.
pub let to_base64: { b: Bytes } -> Str = { b } -> __native_bytes_to_base64 { b = b }

## Method implementations for Bytes.
impl Bytes where {
  size = { it } -> size { b = it },
  is_empty = { it } -> is_empty { b = it },
  get = { it, i } -> get { b = it, i = i },
  slice = { it, start, end } -> slice { b = it, start = start, end = end },
  take = { it, n } -> take { b = it, n = n },
  drop = { it, n } -> drop { b = it, n = n },
  concat = { it, b2 } -> concat { b1 = it, b2 = b2 },
  contains = { it, pattern } -> contains { b = it, pattern = pattern },
  reverse = { it } -> reverse { b = it },
  map = { it, f } -> map { b = it, f = f },
  fold = { it, init, f } -> fold { b = it, init = init, f = f },
  to_str = { it } -> to_str { b = it },
  to_seq = { it } -> to_seq { b = it },
  to_hex = { it } -> to_hex { b = it },
  to_base64 = { it } -> to_base64 { b = it },
}

impl Sized for Bytes where {
  size = { it } -> size { b = it },
  is_empty = { it } -> is_empty { b = it },
}
