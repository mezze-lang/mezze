use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::sized::{ Sized }
use std::int

## Structural equality for non-empty lists.
## The declared `eq`/`cmp` params tie the comparator to the element type var, so
## the impls below dispatch the ELEMENT's own instance rather than comparing
## structurally in Java (seq's #23 pattern).
let nel_equals_with_eq
  : { xs: NonEmptyList 'a, ys: NonEmptyList 'a, eq: { a: 'a, b: 'a } -> Bool } -> Bool
  = { xs, ys, eq } -> __native_nel_equals { xs = xs, ys = ys, eq = eq }

let nel_compare_with_cmp
  : { xs: NonEmptyList 'a, ys: NonEmptyList 'a, cmp: { a: 'a, b: 'a } -> Int } -> Int
  = { xs, ys, cmp } -> __native_nel_compare { xs = xs, ys = ys, cmp = cmp }

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for NonEmptyList 'a where {
  hash: { it: NonEmptyList 'a } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for NonEmptyList 'a where {
  eq: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Eq 'a -> Bool = { it, r } ->
    nel_equals_with_eq { xs = it, ys = r, eq = { a, b } -> a == b },
  neq: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Eq 'a -> Bool = { it, r } ->
    if nel_equals_with_eq { xs = it, ys = r, eq = { a, b } -> a == b } then False else True,
}

## Lexicographic ordering for non-empty lists.
impl Ord for NonEmptyList 'a where {
  lt: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Ord 'a -> Bool = { it, r } ->
    nel_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == (0 - 1),
  le: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Ord 'a -> Bool = { it, r } ->
    nel_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != 1,
  gt: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Ord 'a -> Bool = { it, r } ->
    nel_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } == 1,
  ge: { it: NonEmptyList 'a, r: NonEmptyList 'a } with Ord 'a -> Bool = { it, r } ->
    nel_compare_with_cmp { xs = it, ys = r, cmp = { a, b } -> if a < b then 0 - 1 else if b < a then 1 else 0 } != (0 - 1),
}

## Creates a single-element non-empty list.
pub let singleton: { x: 'a } -> NonEmptyList 'a = { x } -> __native_nel_singleton { x = x }

## Creates a non-empty list from a head and tail.
pub let from_head_tail: { head: 'a, tail: List 'a } -> NonEmptyList 'a = { head, tail } ->
  __native_nel_from_head_tail { head = head, tail = tail }

## Returns the first element (always succeeds).
pub let head: { xs: NonEmptyList 'a } -> 'a = { xs } -> __native_nel_head { xs = xs }

## Returns all elements except the first.
pub let tail: { xs: NonEmptyList 'a } -> List 'a = { xs } -> __native_nel_tail { xs = xs }

## Returns the number of elements.
pub let size: { xs: NonEmptyList 'a } -> Int = { xs } -> __native_nel_size { xs = xs }

## Prepends an element to the front.
pub let cons: { x: 'a, xs: NonEmptyList 'a } -> NonEmptyList 'a = { x, xs } ->
  __native_nel_cons { x = x, xs = xs }

## Concatenates two non-empty lists.
pub let append
  : { xs: NonEmptyList 'a, ys: NonEmptyList 'a }
  -> NonEmptyList 'a
  = { xs, ys } -> __native_nel_append { xs = xs, ys = ys }

## Creates a non-empty list from a List prefix and a guaranteed element.
pub let prepend_list: { xs: List 'a, y: 'a } -> NonEmptyList 'a = { xs, y } ->
  __native_nel_prepend_list { xs = xs, y = y }

## Appends a List to a non-empty list.
pub let append_list
  : { xs: NonEmptyList 'a, ys: List 'a }
  -> NonEmptyList 'a
  = { xs, ys } -> __native_nel_append_list { xs = xs, ys = ys }

## Returns the element at the given index, or None if out of range.
pub let get: { xs: NonEmptyList 'a, index: Int } -> Option 'a = { xs, index } ->
  __native_nel_get { xs = xs, index = index }

## Returns the last element (always succeeds).
pub let last: { xs: NonEmptyList 'a } -> 'a = { xs } -> __native_nel_last { xs = xs }

## Applies f to each element, returning a new non-empty list.
pub let map
  : { xs: NonEmptyList 'a, f: { x: 'a } -> 'b <...> }
  -> NonEmptyList 'b <...>
  = { xs, f } -> __native_nel_map { xs = xs, f = f }

## Applies f to each element and flattens the resulting non-empty lists.
pub let flat_map
  : { xs: NonEmptyList 'a, f: { x: 'a } -> NonEmptyList 'b <...> }
  -> NonEmptyList 'b <...>
  = { xs, f } -> __native_nel_flat_map { xs = xs, f = f }

## Left fold with an initial accumulator value.
pub let fold_left
  : { xs: NonEmptyList 'a, init: 'acc, f: { acc: 'acc, x: 'a } -> 'acc <...> }
  -> 'acc <...>
  = { xs, init, f } -> __native_nel_fold_left { xs = xs, init = init, f = f }

## Right fold with an initial accumulator value.
pub let fold_right
  : { xs: NonEmptyList 'a, init: 'acc, f: { x: 'a, acc: 'acc } -> 'acc <...> }
  -> 'acc <...>
  = { xs, init, f } -> __native_nel_fold_right { xs = xs, init = init, f = f }

## Reduces elements using f (always succeeds since non-empty).
pub let reduce
  : { xs: NonEmptyList 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> 'a <...>
  = { xs, f } -> __native_nel_reduce { xs = xs, f = f }

## Returns True if any element matches the predicate.
pub let any: { xs: NonEmptyList 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_nel_any { xs = xs, p = p }

## Returns True if all elements match the predicate.
pub let all: { xs: NonEmptyList 'a, p: { x: 'a } -> Bool <...> } -> Bool <...> = { xs, p } ->
  __native_nel_all { xs = xs, p = p }

## Returns True if the list contains the element.
pub let contains: { xs: NonEmptyList 'a, x: 'a } with Eq 'a -> Bool = { xs, x } -> do
  let target = x
  any { xs = xs, p = { x } -> x == target }

## Reverses the non-empty list.
pub let reverse: { xs: NonEmptyList 'a } -> NonEmptyList 'a = { xs } ->
  __native_nel_reverse { xs = xs }

## Pairs elements from two non-empty lists.
pub let zip
  : { xs: NonEmptyList 'a, ys: NonEmptyList 'b }
  -> NonEmptyList { fst: 'a, snd: 'b }
  = { xs, ys } -> __native_nel_zip { xs = xs, ys = ys }

## Inserts a separator between every pair of elements.
pub let intersperse: { xs: NonEmptyList 'a, sep: 'a } -> NonEmptyList 'a = { xs, sep } ->
  __native_nel_intersperse { xs = xs, sep = sep }

## Converts to a List.
pub let to_list: { xs: NonEmptyList 'a } -> List 'a = { xs } -> __native_nel_to_list { xs = xs }

## Creates a NonEmptyList from a List. Returns None if the list is empty.
pub let from_list: { xs: List 'a } -> Option (NonEmptyList 'a) = { xs } ->
  __native_nel_from_list { xs = xs }

## Converts to a Seq.
pub let to_seq: { xs: NonEmptyList 'a } -> ['a] = { xs } -> __native_nel_to_seq { xs = xs }

## Creates a NonEmptyList from a Seq. Returns None if the seq is empty.
pub let from_seq: { xs: ['a] } -> Option (NonEmptyList 'a) = { xs } -> __native_nel_from_seq { xs = xs }

## Sorts elements in ascending order.
pub let sort: { xs: NonEmptyList 'a } with Ord 'a -> NonEmptyList 'a = { xs } ->
  sort_by { xs = xs, cmp = { l, r } -> l <= r }

## Sorts using a `less-or-equal` comparator: `cmp { l, r }` returns True when `l`
## should come before `r` (matches `Ord`'s `lt`/`le` and the `<`/`<=` operators).
pub let sort_by
  : { xs: NonEmptyList 'a, cmp: { l: 'a, r: 'a } -> Bool <...> }
  -> NonEmptyList 'a <...>
  = { xs, cmp } -> __native_nel_sort_by { xs = xs, cmp = { l, r } -> if cmp { l = l, r = r } then 0 - 1 else 1 }

## Method implementations for NonEmptyList.
impl NonEmptyList 'a where {
  head = { it } -> head { xs = it },
  tail = { it } -> tail { xs = it },
  last = { it } -> last { xs = it },
  map = { it, f } -> map { xs = it, f = f },
  flat_map = { it, f } -> flat_map { xs = it, f = f },
  fold_left = { it, init, f } -> fold_left { xs = it, init = init, f = f },
  reduce = { it, f } -> reduce { xs = it, f = f },
  any = { it, p } -> any { xs = it, p = p },
  all = { it, p } -> all { xs = it, p = p },
  contains = { it, x } -> contains { xs = it, x = x },
  reverse = { it } -> reverse { xs = it },
  sort = { it } -> sort { xs = it },
  sort_by = { it, cmp } -> sort_by { xs = it, cmp = cmp },
  to_list = { it } -> to_list { xs = it },
  to_seq = { it } -> to_seq { xs = it },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  append = { it, ys } -> append { xs = it, ys = ys },
  append_list = { it, ys } -> append_list { xs = it, ys = ys },
  get = { it, index } -> get { xs = it, index = index },
  fold_right = { it, init, f } -> fold_right { xs = it, init = init, f = f },
  zip = { it, ys } -> zip { xs = it, ys = ys },
  intersperse = { it, sep } -> intersperse { xs = it, sep = sep },
}

## NonEmptyList is never empty, so is_empty always returns False.
impl Sized for NonEmptyList 'a where {
  size = { it } -> size { xs = it },
  is_empty = { it } -> False,
}

## Wrap any value in a singleton NonEmptyList via method syntax:
## `x.nel {}` → single-element `NonEmptyList 'a`. Generic — covers every type.
ability NonEmptyListable for 'a where {
  nel: { it: 'a } -> NonEmptyList 'a
}

impl NonEmptyListable for 'a where {
  nel = { it } -> singleton { x = it }
}
