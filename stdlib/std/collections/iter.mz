## Lazy Iter — universal iteration pipeline.
##
## `Iter 'a` is opaque: stages allocate only immutable descriptor nodes
## and no user code runs until a terminal sink walks the chain. Known
## sources (range, from_seq, from_list) fuse at compile time into a single
## tight loop; user-defined sources via `unfold` fuse at JIT time through
## Truffle PE — same driver loop, same combinator surface.
##
## Types that want `.to_iter{}` dot-syntax implement the `Iterable` ability
## (see `std::abilities::iter`). Collections with their own fused HOFs
## (Seq, List, Set, SortedSet, Deque) keep those — `Iter` is for cross-
## collection pipelines, unfused collections (Map, SortedMap), and user
## types.
use std::int

## The step result returned by an `unfold` step function.
##
## - `Yield` — produced an element; `next` is the updated state.
## - `Skip`  — no element this step (e.g. filter); `next` advances state.
## - `Done`  — iteration finished.
pub type Step 'elem 'state = |
  Yield { val: 'elem, next: 'state },
  Skip { next: 'state },
  Done,
|

# Constructors

## Creates a lazy range `[start, end)` stepped by 1.
pub let range: { start: Int, end: Int } -> Iter Int = { start, end } ->
  __native_iter_range { start = start, end = end }

## Creates a lazy range `[start, end)` with a custom step.
pub let range_step: { start: Int, end: Int, step: Int } -> Iter Int = { start, end, step } ->
  __native_iter_range_step { start = start, end = end, step = step }

## Creates a lazy iterator from a Seq.
pub let from_seq: { xs: ['a] } -> Iter 'a = { xs } ->
  __native_iter_from_seq { xs = xs }

## Creates a lazy iterator from a List.
pub let from_list: { xs: List 'a } -> Iter 'a = { xs } ->
  __native_iter_from_list { xs = xs }

## Universal iterator constructor. Takes an initial state and a step
## function that advances it. This is the entry point for user-defined
## iteration — trees, file handles, database cursors, paginated APIs.
##
##     iter::unfold {
##       state = 0,
##       step = { s } ->
##         if s >= 10 then Done {}
##         else Yield { val = s * s, next = s + 1 }
##     }
pub let unfold
  : { state: 's, step: { s: 's } -> Step 'a 's <...> }
  -> Iter 'a <...>
  = { state, step } -> __native_iter_unfold { state = state, step = step }

## Single-element iterator.
pub let once: { val: 'a } -> Iter 'a = { val } ->
  __native_iter_once { val = val }

## Empty iterator.
pub let empty: {} -> Iter 'a = {} ->
  __native_iter_empty {}

# Stages (lazy — return Iter)

## Applies `f` lazily to each element. Deferred until a sink runs.
pub let map: { it: Iter 'a, f: { x: 'a } -> 'b <...> } -> Iter 'b <...> = { it, f } ->
  __native_iter_map { it = it, f = f }

## Keeps only elements for which `p` returns True. Deferred until a sink runs.
pub let filter: { it: Iter 'a, p: { x: 'a } -> Bool <...> } -> Iter 'a <...> = { it, p } ->
  __native_iter_filter { it = it, p = p }

## Takes the first `n` elements from the iterator (lazy).
pub let take: { it: Iter 'a, n: Int } -> Iter 'a = { it, n } ->
  __native_iter_take { it = it, n = n }

## Drops the first `n` elements from the iterator (lazy).
pub let drop: { it: Iter 'a, n: Int } -> Iter 'a = { it, n } ->
  __native_iter_drop { it = it, n = n }

## Takes elements while `p` holds.
pub let take_while
  : { it: Iter 'a, p: { x: 'a } -> Bool <...> } -> Iter 'a <...>
  = { it, p } -> __native_iter_take_while { it = it, p = p }

## Drops elements while `p` holds, then yields the rest.
pub let drop_while
  : { it: Iter 'a, p: { x: 'a } -> Bool <...> } -> Iter 'a <...>
  = { it, p } -> __native_iter_drop_while { it = it, p = p }

## Pairs each element with its 0-based index.
pub let enumerate: { it: Iter 'a } -> Iter { i: Int, val: 'a } = { it } ->
  __native_iter_enumerate { it = it }

## Concatenates two iterators.
pub let chain: { a: Iter 'a, b: Iter 'a } -> Iter 'a = { a, b } ->
  __native_iter_chain { a = a, b = b }

## Zips two iterators element-wise. Stops at the shorter.
pub let zip: { a: Iter 'a, b: Iter 'b } -> Iter { fst: 'a, snd: 'b } = { a, b } ->
  __native_iter_zip { a = a, b = b }

## Applies `f` to each element, flattening the resulting iterators.
pub let flat_map
  : { it: Iter 'a, f: { x: 'a } -> Iter 'b <...> } -> Iter 'b <...>
  = { it, f } -> __native_iter_flat_map { it = it, f = f }

# Sinks (terminal — force evaluation)

## Left fold — the canonical terminal. All other sinks are fold variants.
pub let fold
  : { it: Iter 'a, init: 'b, f: { acc: 'b, x: 'a } -> 'b <...> }
  -> 'b <...>
  = { it, init, f } -> __native_iter_fold { it = it, init = init, f = f }

## Sum all elements (Int).
pub let sum: { it: Iter Int } -> Int = { it } ->
  __native_iter_sum { it = it }

## Execute `f` for each element, discarding results.
pub let for_each
  : { it: Iter 'a, f: { x: 'a } -> {} <...> }
  -> {} <...>
  = { it, f } -> __native_iter_for_each { it = it, f = f }

## Count elements.
pub let count: { it: Iter 'a } -> Int = { it } ->
  __native_iter_count_all { it = it }

## True if any element satisfies `p`.
pub let any
  : { it: Iter 'a, p: { x: 'a } -> Bool <...> }
  -> Bool <...>
  = { it, p } -> __native_iter_any { it = it, p = p }

## True if all elements satisfy `p`.
pub let all
  : { it: Iter 'a, p: { x: 'a } -> Bool <...> }
  -> Bool <...>
  = { it, p } -> __native_iter_all { it = it, p = p }

## Find the first element satisfying `p`.
pub let find
  : { it: Iter 'a, p: { x: 'a } -> Bool <...> }
  -> Option 'a <...>
  = { it, p } -> __native_iter_find { it = it, p = p }

## Reduce without an initial value. Returns None for empty iterators.
pub let reduce
  : { it: Iter 'a, f: { acc: 'a, x: 'a } -> 'a <...> }
  -> Option 'a <...>
  = { it, f } -> __native_iter_reduce { it = it, f = f }

## First element, or None.
pub let first: { it: Iter 'a } -> Option 'a = { it } ->
  __native_iter_first { it = it }

## Last element, or None.
pub let last: { it: Iter 'a } -> Option 'a = { it } ->
  __native_iter_last { it = it }

## Materialize the iterator into a Seq.
pub let to_seq: { it: Iter 'a } -> ['a] = { it } ->
  __native_iter_to_seq { it = it }

## Materialize the iterator into a List.
pub let to_list: { it: Iter 'a } -> List 'a = { it } ->
  __native_iter_to_list { it = it }

# Inherent methods for dot-chain syntax.

impl Iter 'a where {
  map = { it, f } -> map { it = it, f = f },
  filter = { it, p } -> filter { it = it, p = p },
  take = { it, n } -> take { it = it, n = n },
  drop = { it, n } -> drop { it = it, n = n },
  take_while = { it, p } -> take_while { it = it, p = p },
  drop_while = { it, p } -> drop_while { it = it, p = p },
  enumerate = { it } -> enumerate { it = it },
  chain = { it, b } -> chain { a = it, b = b },
  zip = { it, b } -> zip { a = it, b = b },
  flat_map = { it, f } -> flat_map { it = it, f = f },
  fold = { it, init, f } -> fold { it = it, init = init, f = f },
  for_each = { it, f } -> for_each { it = it, f = f },
  count = { it } -> count { it = it },
  any = { it, p } -> any { it = it, p = p },
  all = { it, p } -> all { it = it, p = p },
  find = { it, p } -> find { it = it, p = p },
  reduce = { it, f } -> reduce { it = it, f = f },
  first = { it } -> first { it = it },
  last = { it } -> last { it = it },
  to_seq = { it } -> to_seq { it = it },
  to_list = { it } -> to_list { it = it },
}

impl Iter Int where {
  sum = { it } -> sum { it = it },
}
