use std::abilities::iter::{ Iter, IterStep }
use std::int

## Descriptor for iterating a `['a]` — position `i` in sequence `xs`.
##
## `next` advances `i` by one; end-of-stream when `i >= len(xs)`. The
## representation is deliberately trivial (two Int fields, one seq ref) so
## the fusion peel can pattern-match on
## `iter::fold(iter::map(iter::filter(iter::from_seq(xs), p), f), init, g)`
## and rewrite it as the range-fused loop that backs
## `seq::fold(seq::map(seq::filter(xs, p), f), init, g)` — same
## bytes-in-flight, same wall time.
pub type SeqIter 'a = { xs: ['a], i: Int }

impl Iter for SeqIter 'a having 'elem = 'a where {
  next = { it } -> do
    let len = __native_seq_size { xs = it.xs }
    if it.i >= len then
      IterDone
    else
      IterStep {
        elem = __native_seq_get_unchecked { xs = it.xs, i = it.i },
        next_it = { xs = it.xs, i = it.i + 1 },
      }
}

## Build a `SeqIter` from a plain sequence.
##
## The fusion peel recognizes the four-layer chain
## `iter::fold(iter::map(iter::filter(iter::from_seq(xs), p), f), init, g)`
## and rewrites the whole chain into the same range-fused loop as
## `seq::fold(seq::map(seq::filter(xs, p), f), init, g)`. Zero descriptor
## allocation, zero `IterStep` boxing at runtime.
pub let from_seq : { xs: ['a] } -> SeqIter 'a = { xs } -> { xs = xs, i = 0 }

## Filter descriptor.
##
## Wraps a source iterator with a predicate. `next` on this walks the
## source until either an element satisfies `p` or the source runs out.
pub type FilterIter 'src 'a = { src: 'src, p: { x: 'a } -> Bool }

## Filter iterator over an `Iter` source. Returns a `FilterIter` — pass it
## on to `iter::map` / `iter::fold` etc. to compose.
##
## The `with Iter 'src having 'elem = 'a` constraint fails misuse at the
## stage constructor (before it composes into a fold) rather than at the
## terminal — so `iter::filter { src = 42, p = _ }` errors with an unmet
## Iter dictionary, not "type mismatch in fold".
pub let filter : { src: 'src, p: { x: 'a } -> Bool }
    with Iter 'src having 'elem = 'a -> FilterIter 'src 'a = { src, p } ->
  { src = src, p = p }

impl Iter for FilterIter 'src 'a having 'elem = 'a
  where {
  next = { it } -> do
    let step = Iter.next { it = it.src }
    match step is
      IterDone -> IterDone
      IterStep { elem, next_it } ->
        if it.p { x = elem } then
          IterStep { elem = elem, next_it = { src = next_it, p = it.p } }
        else
          Iter.next { it = { src = next_it, p = it.p } }
}

## Map descriptor.
pub type MapIter 'src 'a 'b = { src: 'src, f: { x: 'a } -> 'b }

## Map iterator: apply `f` to each element of `src`.
##
## The `with Iter 'src having 'elem = 'a` constraint binds `'a` to the
## source's element type so misuse (`iter::map` on a non-Iter) fails at
## the stage constructor rather than at the terminal.
pub let map : { src: 'src, f: { x: 'a } -> 'b }
    with Iter 'src having 'elem = 'a -> MapIter 'src 'a 'b = { src, f } ->
  { src = src, f = f }

impl Iter for MapIter 'src 'a 'b having 'elem = 'b
  where {
  next = { it } -> do
    let step = Iter.next { it = it.src }
    match step is
      IterDone -> IterDone
      IterStep { elem, next_it } ->
        IterStep { elem = it.f { x = elem }, next_it = { src = next_it, f = it.f } }
}

## Left fold over an iterator. Terminal operation — drives `next` until
## `IterDone`, threading the accumulator.
##
## The explicit `with Iter 'c having 'elem = 'elem` constraint binds the
## ability's associated `'elem` to the same variable used in `f`'s param
## type. Required so the folder callback sees the correct element type.
pub let fold : { src: 'c, init: 'acc, f: { acc: 'acc, x: 'elem } -> 'acc }
    with Iter 'c having 'elem = 'elem -> 'acc = { src, init, f } -> do
  let step = Iter.next { it = src }
  match step is
    IterDone -> init
    IterStep { elem, next_it } ->
      fold { src = next_it, init = f { acc = init, x = elem }, f = f }

## Sum an iterator of Int.
pub let sum : { src: 'c } with Iter 'c having 'elem = Int -> Int = { src } ->
  fold { src = src, init = 0, f = { acc, x } -> acc + x }

## Run `f` on each element for its side effect. Returns unit.
##
## Effect polymorphism (`<'e>`) on `for_each` is not yet expressible in the
## current signature form; use `fold` with a unit accumulator if you need
## effectful callbacks.
pub let for_each : { src: 'c, f: { x: 'elem } -> {} }
    with Iter 'c having 'elem = 'elem -> {} = { src, f } -> do
  let step = Iter.next { it = src }
  match step is
    IterDone -> {}
    IterStep { elem, next_it } -> do
      f { x = elem }
      for_each { src = next_it, f = f }
