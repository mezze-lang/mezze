# Bool utility functions
# This module provides utility functions for working with bools
# Note: The Bool type and basic operations (&&, ||) are built-in via Truffle nodes
# Built-in ability implementations (Eq, Inspect) are automatically available

# Type conversions
pub let to_string = { b: Bool } ->
    __native_bool_to_string { b = b }

# Bool logic operations
pub let and = { l: Bool, r: Bool } ->
    __native_bool_and { l = l, r = r }

pub let or = { l: Bool, r: Bool } ->
    __native_bool_or { l = l, r = r }

pub let not = { b: Bool } ->
    __native_bool_not { b = b }

pub let xor = { l: Bool, r: Bool } ->
    __native_bool_xor { l = l, r = r }

pub let implies = { l: Bool, r: Bool } ->
    __native_bool_or { l = __native_bool_not { b = l }, r = r }

pub let iff = { l: Bool, r: Bool } ->
    __native_bool_or {
        l = __native_bool_and { l = l, r = r },
        r = __native_bool_and { l = __native_bool_not { b = l }, r = __native_bool_not { b = r } }
    }

