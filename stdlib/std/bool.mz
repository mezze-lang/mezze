use std::abilities::compare::{ Eq, Hash, structural_hash }
use std::abilities::logic::{ LogicalAnd, LogicalOr }
use std::abilities::convert::{ Into }
use std::abilities::default::{ Default }

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for Bool where {
  hash: { it: Bool } -> Int = { it } -> structural_hash { it = it }
}


impl LogicalAnd for Bool where {
  and = { it, r } -> __native_bool_and { l = it, r = r }
}

impl LogicalOr for Bool where {
  or = { it, r } -> __native_bool_or { l = it, r = r }
}

impl Into Str for Bool where {
  into = { it } -> if it then "True" else "False"
}

impl Default for Bool where {
  default = {} -> False
}

## Convert a Bool to "True" or "False".
pub let to_str: { b: Bool } -> Str = { b } -> __native_bool_to_str { b = b }

## Logical AND.
pub let and: { l: Bool, r: Bool } -> Bool = { l, r } -> __native_bool_and { l = l, r = r }

## Logical OR.
pub let or: { l: Bool, r: Bool } -> Bool = { l, r } -> __native_bool_or { l = l, r = r }

## Logical NOT.
pub let not: { b: Bool } -> Bool = { b } -> __native_bool_not { b = b }

## Exclusive OR.
pub let xor: { l: Bool, r: Bool } -> Bool = { l, r } -> __native_bool_xor { l = l, r = r }

## Material implication: (l.not {}) || r.
pub let implies: { l: Bool, r: Bool } -> Bool = { l, r } ->
  __native_bool_or { l = __native_bool_not { b = l }, r = r }

## Biconditional: True when both values are equal.
pub let iff: { l: Bool, r: Bool } -> Bool = { l, r } ->
  __native_bool_or {
    l = __native_bool_and { l = l, r = r },
    r = __native_bool_and {
      l = __native_bool_not { b = l },
      r = __native_bool_not { b = r },
    },
  }

impl Bool where {
  not = { it } -> __native_bool_not { b = it },
  to_str = { it } -> __native_bool_to_str { b = it },
  to_int = { it } -> if it then 1 else 0,
  xor = { it, r } -> __native_bool_xor { l = it, r = r },
  iff = { it, r } ->
    __native_bool_or {
      l = __native_bool_and { l = it, r = r },
      r = __native_bool_and {
        l = __native_bool_not { b = it },
        r = __native_bool_not { b = r },
      },
    },
  implies = { it, r } -> if it then r else True,
}
