use std::abilities::numeric::{ NumAdd, NumSub, NumMul, NumDiv, NumZero, NumOne }
use std::abilities::compare::{ Eq, Ord }
use std::abilities::convert::{ Into }
use std::abilities::default::{ Default }

impl NumAdd Frac for Frac having 'out = Frac where {
  add = { it, r } -> __native_frac_add { l = it, r = r }
}

impl NumSub Frac for Frac having 'out = Frac where {
  sub = { it, r } -> __native_frac_subtract { l = it, r = r }
}

impl NumMul Frac for Frac having 'out = Frac where {
  mul = { it, r } -> __native_frac_multiply { l = it, r = r }
}

impl NumDiv Frac for Frac having 'out = Frac where {
  div = { it, r } -> __native_frac_divide { l = it, r = r }
}

impl Eq for Frac where {
  eq = { it, r } -> __native_frac_equals { l = it, r = r },
  neq = { it, r } -> if __native_frac_equals { l = it, r = r } then False else True,
}

impl Ord for Frac where {
  lt = { it, r } -> __native_frac_less_than { l = it, r = r },
  le = { it, r } -> if __native_frac_greater_than { l = it, r = r } then False else True,
  gt = { it, r } -> __native_frac_greater_than { l = it, r = r },
  ge = { it, r } -> if __native_frac_less_than { l = it, r = r } then False else True,
}

impl Into Float for Frac where {
  into = { it } -> __native_frac_to_float { n = it }
}

impl Into Str for Frac where {
  into = { it } -> __native_frac_to_str { n = it }
}

impl NumZero for Frac where {
  zero = {} -> __native_int_to_frac { n = 0 },
  is_zero = { it } -> __native_frac_equals { l = it, r = __native_int_to_frac { n = 0 } },
}

impl NumOne for Frac where {
  one = {} -> __native_int_to_frac { n = 1 }
}

impl Default for Frac where {
  default = {} -> __native_int_to_frac { n = 0 }
}

## Add two fractions.
pub let add: { l: Frac, r: Frac } -> Frac = { l, r } -> __native_frac_add { l = l, r = r }

## Subtract two fractions.
pub let subtract: { l: Frac, r: Frac } -> Frac = { l, r } ->
  __native_frac_subtract { l = l, r = r }

## Multiply two fractions.
pub let multiply: { l: Frac, r: Frac } -> Frac = { l, r } ->
  __native_frac_multiply { l = l, r = r }

## Divide two fractions.
pub let divide: { l: Frac, r: Frac } -> Frac = { l, r } -> __native_frac_divide { l = l, r = r }

## True if two fractions are equal.
pub let equals: { l: Frac, r: Frac } -> Bool = { l, r } -> __native_frac_equals { l = l, r = r }

## True if l is less than r.
pub let less_than: { l: Frac, r: Frac } -> Bool = { l, r } ->
  __native_frac_less_than { l = l, r = r }

## True if l is greater than r.
pub let greater_than: { l: Frac, r: Frac } -> Bool = { l, r } ->
  __native_frac_greater_than { l = l, r = r }

## Convert a fraction to a Float.
pub let to_float: { n: Frac } -> Float = { n } -> __native_frac_to_float { n = n }

## Convert a fraction to its string representation (e.g. "3/4").
pub let to_str: { n: Frac } -> Str = { n } -> __native_frac_to_str { n = n }

## Create a fraction from numerator and denominator. Auto-reduces.
pub let make: { numerator: Int, denominator: Int } -> Frac = { numerator, denominator } ->
  __native_make_frac { numerator = numerator, denominator = denominator }

## Convert an integer to a fraction.
pub let from_int: { n: Int } -> Frac = { n } -> __native_int_to_frac { n = n }

## Convert a natural number to a fraction.
pub let from_nat: { n: Nat } -> Frac = { n } -> __native_nat_to_frac { n = n }

## Get the numerator.
pub let numerator: { n: Frac } -> Int = { n } -> __native_frac_numerator { n = n }

## Get the denominator.
pub let denominator: { n: Frac } -> Int = { n } -> __native_frac_denominator { n = n }

## Reduce to lowest terms (fractions auto-reduce, but this is explicit).
pub let reduce: { n: Frac } -> Frac = { n } -> __native_reduce_frac { n = n }

## Absolute value of a fraction.
pub let abs: { n: Frac } -> Frac = { n } -> __native_abs_frac { n = n }

## Negate a fraction.
pub let negate: { n: Frac } -> Frac = { n } -> __native_negate_frac { n = n }

impl Frac where {
  neg: { it: Frac } -> Frac = { it } -> __native_negate_frac { n = it },
  to_float = { it } -> __native_frac_to_float { n = it },
  to_str = { it } -> __native_frac_to_str { n = it },
  abs = { it } -> __native_abs_frac { n = it },
  numerator = { it } -> __native_frac_numerator { n = it },
  denominator = { it } -> __native_frac_denominator { n = it },
  is_positive: { it: Frac } -> Bool = { it } ->
    __native_frac_greater_than { l = it, r = __native_int_to_frac { n = 0 } },
  is_negative: { it: Frac } -> Bool = { it } ->
    __native_frac_less_than { l = it, r = __native_int_to_frac { n = 0 } },
  reciprocal: { it: Frac } -> Frac = { it } ->
    __native_frac_divide { l = __native_int_to_frac { n = 1 }, r = it },
}
