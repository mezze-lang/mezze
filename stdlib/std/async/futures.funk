# std/effects/async.funk - Async operations as effects

effect Async {
    spawn: { task: {} -> 'a } -> Future 'a <Async>,
    await: { future: Future 'a } -> 'a <Async>,
    sleep: { millis: Int } -> {} <Async>,
    timeout: { millis: Int, task: {} -> 'a } -> 'a <Async>
}

# Thread-based async implementation
impl Async for ThreadPool where {
    spawn = { task } -> __native_async_spawn { task = task },
    await = { future } -> __native_async_await { future = future },
    sleep = { millis } -> __native_async_sleep { millis = millis },
    timeout = { millis, task } -> __native_async_timeout { millis = millis, task = task }
}