# =============================================================================
# std/async/async.mezze - Unified Async Effect with Multiple Handlers
# =============================================================================

use std::control::continuation

# =============================================================================
# Opaque Types for Native Values
# =============================================================================

# Promise wraps native CompletableFuture - opaque to user code
# Construction: Only via spawn or other async operations
# Pattern matching: Not allowed - use is_complete or await
# Note: Type parameter 'a is a placeholder - actual generics TBD
newtype Promise = Promise __NativePromise

# Thread wraps native Thread - opaque to user code
# Construction: Only via current_thread
# Pattern matching: Not allowed - use for unpark only
newtype Thread = Thread __NativeThread

# =============================================================================
# Core Async Effect
# =============================================================================

# Single async effect - can be implemented in multiple ways
# Note: Return type will be the unwrapped promise value
effect Async where {
    await: {promise: Promise} -> 'a <Async>
}

# =============================================================================
# Handler 1: FastAsync - Uses Loom Virtual Threads (Maximum Performance)
# =============================================================================

# Use this when:
# - High throughput is critical
# - Operations complete quickly
# - No need for durability or inspection
# - Heavy blocking I/O operations
#
# Example:
#   perform FastAsync in do
#       let response = Async.await {promise = http_request {}}
#       response
pub impl Async for FastAsync where {
    await = {promise} -> __native_loom_await {promise = promise}
}

# =============================================================================
# Handler 2: DurableAsync - Uses Continuations (Maximum Durability)
# =============================================================================

# Use this when:
# - Every operation must be serializable
# - Debugging/inspection is critical
# - Workflow durability is paramount
# - Need to resume after process restart
#
# Example:
#   perform DurableAsync {cont = continuation::new {}} in do
#       let payment = Async.await {promise = charge_card {}}
#       # Can serialize and resume even after crash!
#       payment
pub impl Async for DurableAsync {cont: continuation::Continuation} where {
    await = {promise} -> do
        # Suspend the continuation with the promise
        cont.suspend_with {value = promise}
}

# =============================================================================
# Handler 3: AdaptiveAsync - Hybrid (Intelligent Switching)
# =============================================================================

# Use this when:
# - Need both performance and durability
# - Want automatic optimization
# - Checkpoint at strategic points
#
# Strategies:
# - AlwaysContinuation: Max durability
# - AlwaysLoom: Max performance
# - PeriodicCheckpoint: Balanced (checkpoint every N ms)
# - OperationCountCheckpoint: Balanced (checkpoint every N operations)
# - ExplicitCheckpoint: Manual control
#
# Example:
#   perform AdaptiveAsync {
#       cont = continuation::new {},
#       strategy = "periodic",
#       interval = 5000  # Checkpoint every 5 seconds
#   } in do
#       # Fast operations use Loom
#       let data = Async.await {promise = read_cache {}}
#
#       # Every 5 seconds, checkpoints with continuation
#       let result = Async.await {promise = process {data = data}}
#       result
pub impl Async for AdaptiveAsync {
    cont: continuation::Continuation,
    strategy: String,
    interval: Option Int,
    count: Option Int
} where {
    await = {promise} -> do
        # Strategy decision is made by native implementation
        __native_adaptive_async_await {
            promise = promise,
            cont = cont,
            strategy = strategy,
            interval = interval,
            count = count
        }
}

# =============================================================================
# Helper Functions
# =============================================================================

# Spawn a computation on a virtual thread (returns immediately)
pub let spawn: {computation: {} -> 'a} -> Promise =
    {computation} -> __native_loom_spawn {computation = computation}

# Check if a promise is complete
pub let is_complete: {promise: Promise} -> Bool =
    {promise} -> __native_promise_is_complete {promise = promise}

# =============================================================================
# Convenience Functions for Common Patterns
# =============================================================================

# Run async computation with FastAsync handler
pub let run_fast: {f: {} -> 'a <Async>} -> 'a =
    {f} -> perform FastAsync in f {}

# Run async computation with DurableAsync handler
pub let run_durable: {f: {} -> 'a <Async>} -> 'a =
    {f} -> perform DurableAsync {cont = continuation::new {}} in f {}

# Run async computation with AdaptiveAsync handler (periodic checkpoints)
pub let run_adaptive: {f: {} -> 'a <Async>, interval_ms: Int} -> 'a =
    {f, interval_ms} ->
        perform AdaptiveAsync {
            cont = continuation::new {},
            strategy = "periodic",
            interval = Some {val = interval_ms},
            count = None
        } in f {}

# =============================================================================
# Examples
# =============================================================================

# Example 1: High-performance web server
let web_server_example: {} -> {} =
    {} -> run_fast {f = {} -> do
        let request = Async.await {promise = http_accept {}}
        let response = process_request {request = request}
        http_send {response = response}
    }

# Example 2: Durable workflow
let workflow_example: {} -> {} =
    {} -> run_durable {f = {} -> do
        let payment = Async.await {promise = charge_card {}}
        let shipment = Async.await {promise = ship_order {}}
        {payment = payment, shipment = shipment}
    }

# Example 3: Hybrid execution
let hybrid_example: {} -> {} =
    {} -> run_adaptive {
        f = {} -> do
            # Fast in-memory operations
            let data = Async.await {promise = read_cache {}}
            let processed = transform {data = data}

            # Checkpoint before expensive operation
            let saved = Async.await {promise = write_db {processed = processed}}
            saved
        ,
        interval_ms = 5000
    }
