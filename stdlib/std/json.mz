# std/json.mezze - JSON serialization format implementation
#
# This module provides a Json variant type and functions for
# serializing/deserializing JSON data.
#
# Example:
#   use std::json
#
#   let data = json::JObject {fields = [
#       {key = "name", value = json::JString {val = "Alice"}},
#       {key = "age", value = json::JInt {val = 30}}
#   ]}
#
#   let bytes = json::serialize {json = data}

use std::collections::array
use std::collections::list
use std::collections::set
use std::collections::map
use std::collections::bytes
use std::string
use std::float
use std::int
use std::codec::{EncodeFormat, DecodeFormat, EncodeError, DecodeError, CodecConfig}

# ============================================================================
# JSON INTERMEDIATE REPRESENTATION
# ============================================================================

# The Json type represents any JSON value
# Note: JArray and JObject use Array for efficient construction with [...] literals
# Using anonymous record {key: String, value: Json} for structural compatibility with codec
pub type Json = | JNull, JBool { val: Bool }, JInt { val: Int }, JFloat { val: Float }, JString { val: String }, JArray { items: Array Json }, JObject { fields: Array {key: String, value: Json}} |

# ============================================================================
# CONFIGURATION
# ============================================================================

# Import FieldTransform from codec for field transformations
use std::codec::{FieldTransform}

# JSON encoding configuration
pub type JsonConfig = {
    pretty: Bool,
    indent: Int,
    field_transform: FieldTransform,
    skip_null: Bool
}

# Default JSON configuration
pub let default_config: JsonConfig = {
    pretty = False,
    indent = 2,
    field_transform = Identity,
    skip_null = False
}

# Create a config with custom settings
pub let config = {pretty: Bool, indent: Int, field_transform: FieldTransform, skip_null: Bool} -> {
    pretty = pretty,
    indent = indent,
    field_transform = field_transform,
    skip_null = skip_null
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Get the type name of a Json value (for error messages)
let json_type_name: {json: Json} -> String = {json} ->
    match json is
        JNull -> "null"
        JBool {val} -> "boolean"
        JInt {val} -> "integer"
        JFloat {val} -> "float"
        JString {val} -> "string"
        JArray {items} -> "array"
        JObject {fields} -> "object"

# ============================================================================
# SERIALIZATION (Json -> Bytes)
# ============================================================================

# Serialize Json to string with config
pub let serialize_to_string: {json: Json, config: JsonConfig} -> String = {json, config} ->
    if config.pretty then
        serialize_pretty {json = json, indent = 0, indent_size = config.indent}
    else
        serialize_compact {json = json}

# Serialize with default config
pub let to_string: {json: Json} -> String = {json} ->
    serialize_compact {json = json}

# Compact serialization (no whitespace)
let serialize_compact: {json: Json} -> String = {json} ->
    match json is
        JNull -> "null"
        JBool {val} -> if val then "true" else "false"
        JInt {val} -> int::to_string {n = val}
        JFloat {val} -> float::to_string {n = val}
        JString {val} -> "\"$(escape_string {s = val})\""
        JArray {items} -> do
            let inner = array::map {xs = items, f = {x} -> serialize_compact {json = x}}
            "[$(string::join {strings = inner, separator = ","})]"
        JObject {fields} -> do
            let inner = array::map {
                xs = fields,
                f = {x} -> "\"$(escape_string {s = x.key})\":$(serialize_compact {json = x.value})"
            }
            "{$(string::join {strings = inner, separator = ","})}"

# Pretty serialization (with indentation)
let serialize_pretty: {json: Json, indent: Int, indent_size: Int} -> String = {json, indent, indent_size} -> do
    let indent_str = string::repeat {s = " ", n = indent}
    let next_indent = indent + indent_size
    let next_indent_str = string::repeat {s = " ", n = next_indent}
    match json is
        JNull -> "null"
        JBool {val} -> if val then "true" else "false"
        JInt {val} -> int::to_string {n = val}
        JFloat {val} -> float::to_string {n = val}
        JString {val} -> "\"$(escape_string {s = val})\""
        JArray {items} ->
            if array::is_empty {xs = items} then
                "[]"
            else do
                let inner = array::map {
                    xs = items,
                    f = {x} -> "$(next_indent_str)$(serialize_pretty {json = x, indent = next_indent, indent_size = indent_size})"
                }
                "[\n$(string::join {strings = inner, separator = ",\n"})\n$(indent_str)]"
        JObject {fields} ->
            if array::is_empty {xs = fields} then
                "{}"
            else do
                let inner = array::map {
                    xs = fields,
                    f = {x} -> do
                        let val_str = serialize_pretty {json = x.value, indent = next_indent, indent_size = indent_size}
                        "$(next_indent_str)\"$(escape_string {s = x.key})\": $(val_str)"
                }
                "{\n$(string::join {strings = inner, separator = ",\n"})\n$(indent_str)}"

# Escape special characters in JSON strings
# TODO: Implement proper escape when string::replace is available
# For now, return string as-is (not correct for strings with special chars)
let escape_string: {s: String} -> String = {s} ->
    s

# ============================================================================
# PARSING (Bytes -> Json)
# ============================================================================

# Parse Bytes to Json
# Note: This uses a native function for actual JSON parsing
pub let parse = {bytes} ->
    __native_json_from_bytes {bytes = bytes}

# ============================================================================
# HIGH-LEVEL API
# ============================================================================
# JSON encoding uses the Encode ability which auto-derives for any type.
# This module provides EncodeFormat and DecodeFormat implementations for Json.
#
# Example:
#   use std::json
#   use std::codec::{Encode}
#
#   let person = {name = "Alice", age = 30}
#   let result = Encode.encode {val = person, config = {field_transform = Identity}}
#   match result is
#       Ok {val = json} -> json::to_string {json = json}
#       Err {error} -> "encoding failed"
#
# For snake_case field names (e.g., user_name instead of userName):
#   let result = Encode.encode {val = person, config = {field_transform = SnakeCase}}

# Parse a JSON string to Json value
pub let parse_str = {s: String} ->
    __native_json_parse {s = s}

# ============================================================================
# FIELD TRANSFORMATION FUNCTIONS
# ============================================================================

# Transform a field name based on the FieldTransform config
pub let transform_field_name = {name: String, transform: FieldTransform} ->
    match transform is
        Identity -> name
        SnakeCase -> __native_string_to_snake_case {s = name}
        CamelCase -> __native_string_to_camel_case {s = name}
        KebabCase -> __native_string_to_kebab_case {s = name}
        ScreamingSnakeCase -> __native_string_to_screaming_snake_case {s = name}

# Inverse transform (for decoding - e.g., snake_case JSON -> camelCase Mezze)
pub let inverse_transform_field_name = {name: String, transform: FieldTransform} ->
    match transform is
        Identity -> name
        SnakeCase -> __native_string_to_camel_case {s = name}  # snake_case -> camelCase
        CamelCase -> __native_string_to_snake_case {s = name}  # camelCase -> snake_case
        KebabCase -> __native_string_to_camel_case {s = name}  # kebab-case -> camelCase
        ScreamingSnakeCase -> __native_string_to_camel_case {s = name}  # SCREAMING -> camelCase

# ============================================================================
# ENCODE/DECODE WITH CONFIG
# ============================================================================
# These functions allow encoding/decoding with a runtime config.
# They transform field names in the JSON after encoding / before decoding.
#
# Example usage:
#   use std::json
#   use std::codec::{Encode, Decode}
#
#   let person = {userName = "Alice", createdAt = "2024-01-01"}
#
#   # Encode with snake_case field names (config handles transformation)
#   let result = Encode.encode {val = person, config = {field_transform = SnakeCase}}
#   # Result: Ok {val = {"user_name": "Alice", "created_at": "2024-01-01"}}
#
#   # Decode back (config handles inverse transformation)
#   let json_input: Json = ...  # {"user_name": "Alice", "created_at": "2024-01-01"}
#   let decoded: Result {userName: String, createdAt: String} DecodeError =
#       Decode.decode {val = json_input, config = {field_transform = SnakeCase}}

# Transform all field names in a Json value according to the config
pub let transform_fields: {json: Json, transform: FieldTransform} -> Json = {json, transform} ->
    match transform is
        Identity -> json
        _ -> transform_fields_impl {j = json, t = transform}

# Recursive implementation (uses short param names to avoid shadowing issues)
let transform_fields_impl: {j: Json, t: FieldTransform} -> Json = {j, t} ->
    match j is
        JNull -> JNull
        JBool {val} -> JBool {val = val}
        JInt {val} -> JInt {val = val}
        JFloat {val} -> JFloat {val = val}
        JString {val} -> JString {val = val}
        JArray {items} -> JArray {items = array::map {xs = items, f = {x} -> transform_fields_impl {j = x, t = t}}}
        JObject {fields} -> JObject {fields = array::map {xs = fields, f = {x} -> {
            key = transform_field_name {name = x.key, transform = t},
            value = transform_fields_impl {j = x.value, t = t}
        }}}

# Inverse transform all field names (for decoding)
pub let inverse_transform_fields: {json: Json, transform: FieldTransform} -> Json = {json, transform} ->
    match transform is
        Identity -> json
        _ -> inverse_transform_fields_impl {j = json, t = transform}

# Recursive implementation (uses short param names to avoid shadowing issues)
let inverse_transform_fields_impl: {j: Json, t: FieldTransform} -> Json = {j, t} ->
    match j is
        JNull -> JNull
        JBool {val} -> JBool {val = val}
        JInt {val} -> JInt {val = val}
        JFloat {val} -> JFloat {val = val}
        JString {val} -> JString {val = val}
        JArray {items} -> JArray {items = array::map {xs = items, f = {x} -> inverse_transform_fields_impl {j = x, t = t}}}
        JObject {fields} -> JObject {fields = array::map {xs = fields, f = {x} -> {
            key = inverse_transform_field_name {name = x.key, transform = t},
            value = inverse_transform_fields_impl {j = x.value, t = t}
        }}}

# ============================================================================
# MODULE-LEVEL ENCODING/DECODING API
# ============================================================================
# Convenience functions for JSON encoding/decoding with default config.
#
# Example usage:
#   use std::json
#
#   let person = {name = "Alice", age = 30}
#
#   # Encode to JSON (uses default Identity transform)
#   let result = json::encode {val = person}
#
#   # Encode with custom config (snake_case fields)
#   let result = json::encode_with {val = person, config = {field_transform = SnakeCase}}
#
#   # Decode from JSON (requires type annotation)
#   let json_data = json::parse_str {s = "{\"name\": \"Alice\", \"age\": 30}"}
#   let person: Result {name: String, age: Int} DecodeError = match json_data is
#       Ok {val} -> json::decode {val = val}
#       Err {error} -> Err {error = {path = [], message = "parse failed", expected = "Json", found = None}}

# TODO: Add helper functions for encode/decode with default config
# The constraint syntax for polymorphic functions with ability constraints
# needs to be investigated for the decode case where 'a only appears in output.

# ============================================================================
# ENCODE FORMAT IMPLEMENTATION
# ============================================================================
# The EncodeFormat implementation for Json is defined here (where Json is defined)
# to satisfy the orphan rule: impl must be in the module that defines the type.

impl EncodeFormat Json where {
    encode_int = {val, path} ->
        Ok {val = JInt {val = val}},

    encode_float = {val, path} ->
        Ok {val = JFloat {val = val}},

    encode_string = {val, path} ->
        Ok {val = JString {val = val}},

    encode_bool = {val, path} ->
        Ok {val = JBool {val = val}},

    encode_frac = {val, path} -> do
        # JSON doesn't support fractions natively, convert to float
        let f = __native_frac_to_float {n = val}
        Ok {val = JFloat {val = f}},

    encode_bytes = {val, path} -> do
        # Encode bytes as base64 string
        let b64 = bytes::to_base64 {b = val}
        Ok {val = JString {val = b64}},

    encode_record = {fields, path} ->
        # fields is Array {key: String, value: Json}, matching JObject.fields
        Ok {val = JObject {fields = fields}},

    encode_variant = {tag, payload, path} -> do
        let fields = match payload is
            Some {val = p} ->
                [{key = "tag", value = JString {val = tag}}, {key = "value", value = p}]
            None ->
                [{key = "tag", value = JString {val = tag}}]
        Ok {val = JObject {fields = fields}},

    encode_list = {elems, path} ->
        # Convert List to Array for JArray
        Ok {val = JArray {items = list::to_array {xs = elems}}},

    encode_set = {elems, path} -> do
        # Sets encoded as arrays in JSON
        Ok {val = JArray {items = set::to_array {s = elems}}},

    encode_map = {entries, path} -> do
        # Maps encoded as array of {key, value} objects
        let items = list::map {xs = entries, f = {x} ->
            JObject {fields = [
                {key = "key", value = x.key},
                {key = "value", value = x.value}
            ]}
        }
        Ok {val = JArray {items = list::to_array {xs = items}}},

    encode_option = {val, path} ->
        match val is
            Some {val = v} -> Ok {val = v}
            None -> Ok {val = JNull},

    # Transform field names according to the codec config
    # Uses the FieldTransform from config (Identity, SnakeCase, CamelCase, etc.)
    transform_field = {name, config} ->
        transform_field_name {name = name, transform = config.field_transform}
}

# ============================================================================
# DECODE FORMAT IMPLEMENTATION
# ============================================================================

impl DecodeFormat Json where {
    decode_int = {val, path} ->
        match val is
            JInt {val = v} -> Ok {val = v}
            _ -> Err {error = {
                path = path,
                message = "Expected integer",
                expected = "Int",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_float = {val, path} ->
        match val is
            JFloat {val = v} -> Ok {val = v}
            JInt {val = v} -> Ok {val = __native_int_to_float {n = v}}
            _ -> Err {error = {
                path = path,
                message = "Expected float",
                expected = "Float",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_string = {val, path} ->
        match val is
            JString {val = v} -> Ok {val = v}
            _ -> Err {error = {
                path = path,
                message = "Expected string",
                expected = "String",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_bool = {val, path} ->
        match val is
            JBool {val = v} -> Ok {val = v}
            _ -> Err {error = {
                path = path,
                message = "Expected boolean",
                expected = "Bool",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_frac = {val, path} ->
        match val is
            JFloat {val = v} -> do
                let f = __native_float_to_frac {f = v}
                Ok {val = f}
            JInt {val = v} -> do
                let f = __native_int_to_frac {n = v}
                Ok {val = f}
            _ -> Err {error = {
                path = path,
                message = "Expected fraction (number)",
                expected = "Frac",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_bytes = {val, path} ->
        match val is
            JString {val = v} ->
                match bytes::from_base64 {s = v} is
                    Some {val = b} -> Ok {val = b}
                    None -> Err {error = {
                        path = path,
                        message = "Invalid base64 encoding",
                        expected = "Bytes (base64)",
                        found = Some {val = "invalid base64"}
                    }}
            _ -> Err {error = {
                path = path,
                message = "Expected string (base64 encoded bytes)",
                expected = "Bytes",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_record_field = {val, key, path} ->
        match val is
            JObject {fields} ->
                find_field {fields = fields, key = key, path = path}
            _ -> Err {error = {
                path = path,
                message = "Expected object",
                expected = "Object",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_variant = {val, path} ->
        match val is
            JObject {fields} -> do
                match find_field_value {fields = fields, key = "tag", idx = 0} is
                    Some {val = tag_json} ->
                        match tag_json is
                            JString {val = tag} -> do
                                let payload = find_field_value {fields = fields, key = "value", idx = 0}
                                Ok {val = {tag = tag, payload = payload}}
                            _ -> Err {error = {
                                path = path,
                                message = "Variant tag must be a string",
                                expected = "String",
                                found = Some {val = json_type_name {json = tag_json}}
                            }}
                    None -> Err {error = {
                        path = path,
                        message = "Variant object missing 'tag' field",
                        expected = "Object with 'tag'",
                        found = Some {val = "Object without 'tag'"}
                    }}
            _ -> Err {error = {
                path = path,
                message = "Expected variant object",
                expected = "Object",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_list = {val, path} ->
        match val is
            # JArray.items is now Array, convert to List for codec
            JArray {items} -> Ok {val = __native_list_from_array {xs = items}}
            _ -> Err {error = {
                path = path,
                message = "Expected array",
                expected = "Array",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_set = {val, path} ->
        match val is
            # JArray.items is Array, use set::from_array
            JArray {items} -> Ok {val = set::from_array {xs = items}}
            _ -> Err {error = {
                path = path,
                message = "Expected array (for set)",
                expected = "Array",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_map = {val, path} ->
        match val is
            JObject {fields} -> do
                # Convert object fields (Array {key: String, value: Json}) to List {key: Json, value: Json}
                let as_list = __native_list_from_array {xs = fields}
                let converted = list::map {xs = as_list, f = {x} ->
                    {key = JString {val = x.key}, value = x.value}
                }
                Ok {val = converted}
            _ -> Err {error = {
                path = path,
                message = "Expected object (for map)",
                expected = "Object",
                found = Some {val = json_type_name {json = val}}
            }},

    decode_option = {val, path} ->
        match val is
            JNull -> Ok {val = None}
            _ -> Ok {val = Some {val = val}},

    # Transform field names according to the codec config (inverse transform for decoding)
    # Uses the FieldTransform from config (Identity, SnakeCase, CamelCase, etc.)
    transform_field = {name, config} ->
        inverse_transform_field_name {name = name, transform = config.field_transform}
}

# ============================================================================
# DECODE HELPER FUNCTIONS
# ============================================================================

# Find a field in an array of entries
let find_field = {fields, key, path} -> do
    match find_field_value {fields = fields, key = key, idx = 0} is
        Some {val = v} -> Ok {val = v}
        None -> Err {error = {
            path = path,
            message = "Missing field: $(key)",
            expected = key,
            found = None
        }}

# Find a field value without returning error (using array indexing)
let find_field_value = {fields, key, idx} ->
    if idx >= __native_arraylist_length {xs = fields} then
        None
    else
        match __native_arraylist_get {xs = fields, i = idx} is
            Some {val = entry} ->
                if entry.key == key then
                    Some {val = entry.value}
                else
                    find_field_value {fields = fields, key = key, idx = idx + 1}
            None ->
                None
