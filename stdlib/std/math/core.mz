# Core mathematical functions
# This module provides core mathematical functions and constants
# Mathematical constants
pub let pi = 3.141592653589793

pub let e = 2.718281828459045
# Polymorphic mathematical functions

pub let min: { l: 'a, r: 'a } with Ord 'a -> 'a = { l, r } -> if l < r then l else r

pub let max: { l: 'a, r: 'a } with Ord 'a -> 'a = { l, r } -> if l > r then l else r
# Float-specific mathematical functions

pub let pow: { base: Float, exp: Float } -> Float = { base, exp } -> __native_float_pow { base = base, exp = exp }

pub let pow_int: { base: Int, exp: Int } -> Int = { base, exp } -> __native_int_pow { base = base, exp = exp }

pub let pow_nat: { base: Nat, exp: Nat } -> Nat = { base, exp } -> __native_nat_pow { base = base, exp = exp }

pub let sqrt: { n: Float } -> Float = { n } -> __native_float_sqrt { n = n }

pub let ln: { n: Float } -> Float = { n } -> __native_float_ln { n = n }

pub let log10: { n: Float } -> Float = { n } -> __native_float_log10 { n = n }

pub let exp: { n: Float } -> Float = { n } -> __native_float_exp { n = n }

pub let floor: { n: Float } -> Float = { n } -> __native_float_floor { n = n }

pub let ceil: { n: Float } -> Float = { n } -> __native_float_ceil { n = n }

pub let round: { n: Float } -> Float = { n } -> __native_float_round { n = n }

pub let is_nan: { n: Float } -> Bool = { n } -> __native_float_is_nan { n = n }

pub let is_infinite: { n: Float } -> Bool = { n } -> __native_float_is_infinite { n = n }

pub let is_finite: { n: Float } -> Bool = { n } -> __native_float_is_finite { n = n }

pub let sign: { n: Float } -> Float = { n } -> __native_float_sign { n = n }

pub let sign_int: { n: Int } -> Int = { n } -> __native_int_sign { n = n }
