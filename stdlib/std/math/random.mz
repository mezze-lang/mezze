# std/math/random.mezze - Pure mathematical distribution functions

use std::math::core
use std::math::trig

# Box-Muller transform for normal distribution
# Takes two uniform random values and returns a normal distributed value
pub let box_muller = { u1: Float, u2: Float, mean: Float, std_dev: Float } -> do
    let z0 = core::sqrt { n = -2.0 * core::ln { n = u1 } } * trig::cos { n = 2.0 * trig::pi * u2 }
    mean + (std_dev * z0)

# Inverse transform for exponential distribution
pub let exponential_inverse = { u: Float, rate: Float } ->
    (-1.0 / rate) * core::ln { n = u }

# Linear interpolation for uniform distribution
pub let uniform_transform = { u: Float, min: Float, max: Float } ->
    min + (u * (max - min))

# Probability density function for normal distribution
pub let normal_pdf = { x: Float, mean: Float, std_dev: Float } -> do
    let variance = std_dev * std_dev
    let coefficient = 1.0 / core::sqrt { n = 2.0 * trig::pi * variance }
    let exponent = -((x - mean) * (x - mean)) / (2.0 * variance)
    coefficient * core::exp { n = exponent }

# Cumulative distribution function approximation for normal distribution
pub let normal_cdf_approx = { x: Float, mean: Float, std_dev: Float } -> do
    # Simplified approximation - in practice would use more accurate methods
    let z = (x - mean) / std_dev
    0.5 * (1.0 + trig::tanh { n = z * core::sqrt { n = 2.0 / trig::pi } })

# Probability density function for exponential distribution
pub let exponential_pdf = { x: Float, rate: Float } ->
    if x < 0.0 then 0.0 else rate * core::exp { n = NumSub.neg { n = rate } * x }

# Cumulative distribution function for exponential distribution
pub let exponential_cdf = { x: Float, rate: Float } ->
    if x < 0.0 then 0.0 else 1.0 - core::exp { n = NumSub.neg { n = rate } * x }