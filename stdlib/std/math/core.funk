# Core mathematical functions
# This module provides core mathematical functions and constants

# Mathematical constants
pub let pi = 3.141592653589793
pub let e = 2.718281828459045

# Polymorphic mathematical functions
pub let abs : { x: 'a } -> 'a with Ord 'a = {x} ->
    if x < 0 then -x else x

pub let min : { l: 'a, r: 'a } -> 'a with Ord 'a = {l, r} ->
    if l < r then l else r

pub let max : { l: 'a, r: 'a } -> 'a with Ord 'a = {l, r} ->
    if l > r then l else r

# Float-specific mathematical functions
pub let pow : { base: Float, exp: Float } -> Float = { base, exp } ->
    __native_float_pow { base = base, exp = exp }

pub let pow_int : { base: Int, exp: Int } -> Int = { base, exp } ->
    __native_int_pow { base = base, exp = exp }

pub let pow_nat : { base: Nat, exp: Nat } -> Nat = { base, exp } ->
    __native_nat_pow { base = base, exp = exp }

pub let sqrt : { val: Float } -> Float = {val} ->
    __native_float_sqrt { val = val }

pub let ln : { val: Float } -> Float = {val} ->
    __native_float_ln { val = val }

pub let log10 : { val: Float } -> Float = {val} ->
    __native_float_log10 { val = val }

pub let exp : { val: Float } -> Float = {val} ->
    __native_float_exp { val = val }

pub let floor : { val: Float } -> Float = {val} ->
    __native_float_floor { val = val }

pub let ceil : { val: Float } -> Float = {val} ->
    __native_float_ceil { val = val }

pub let round : { val: Float } -> Float = {val} ->
    __native_float_round { val = val }

pub let is_nan : { x: Float } -> Bool = {x} ->
    __native_float_is_nan { x = x }

pub let is_infinite : { x: Float } -> Bool = {x} ->
    __native_float_is_infinite { x = x }

pub let is_finite : { x: Float } -> Bool = {x} ->
    __native_float_is_finite { x = x }

pub let sign : { x: Float } -> Float = {x} ->
    __native_float_sign { x = x }

pub let sign_int : { x: Int } -> Int = {x} ->
    __native_int_sign { x = x }