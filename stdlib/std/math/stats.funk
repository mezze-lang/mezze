# std/math/stats.funk - Statistical functions

use std::collections::arraylist
use std::types::float
use std::math::basic

# Calculate the mean (average) of a list of numbers
pub let mean = { values: ArrayList Float } -> Option Float =
    let length = arraylist::length { arr = values }
    if length == 0 then
        None
    else
        let sum = arraylist::fold { arr = values, init = 0.0, f = { acc, val } -> acc + val }
        Some { val = sum / (float::from_int { value = length }) }

# Calculate the median of a list of numbers
pub let median = { values: ArrayList Float } -> Option Float =
    let length = arraylist::length { arr = values }
    if length == 0 then
        None
    else
        # Note: This is a simplified implementation
        # In a real implementation, we'd need to sort the array first
        let middle_index = length / 2
        if length % 2 == 1 then
            arraylist::get { arr = values, index = middle_index }
        else
            match arraylist::get { arr = values, index = middle_index - 1 } is
                Some { val = val1 } -> match arraylist::get { arr = values, index = middle_index } is
                    Some { val = val2 } -> Some { val = (val1 + val2) / 2.0 }
                    None -> None
                None -> None

# Calculate the variance of a list of numbers
pub let variance = { values: ArrayList Float } -> Option Float =
    match mean { values = values } is
        None -> None
        Some { val = mean_val } ->
            let length = arraylist::length { arr = values }
            if length <= 1 then
                Some { val = 0.0 }
            else
                let sum_squares = arraylist::fold { 
                    arr = values, 
                    init = 0.0, 
                    f = { acc, val } -> 
                        let diff = val - mean_val
                        acc + (diff * diff)
                }
                Some { val = sum_squares / (float::from_int { value = length - 1 }) }

# Calculate the standard deviation of a list of numbers
pub let standard_deviation = { values: ArrayList Float } -> Option Float =
    match variance { values = values } is
        None -> None
        Some { val = var_val } -> Some { val = sqrt { value = var_val } }

# Find the minimum value in a list
pub let min_value = { values: ArrayList Float } -> Option Float =
    let length = arraylist::length { arr = values }
    if length == 0 then
        None
    else
        match arraylist::get { arr = values, index = 0 } is
            None -> None
            Some { val = first } ->
                let result = arraylist::fold { 
                    arr = values, 
                    init = first, 
                    f = { acc, val } -> if val < acc then val else acc 
                }
                Some { val = result }

# Find the maximum value in a list
pub let max_value = { values: ArrayList Float } -> Option Float =
    let length = arraylist::length { arr = values }
    if length == 0 then
        None
    else
        match arraylist::get { arr = values, index = 0 } is
            None -> None
            Some { val = first } ->
                let result = arraylist::fold { 
                    arr = values, 
                    init = first, 
                    f = { acc, val } -> if val > acc then val else acc 
                }
                Some { val = result }