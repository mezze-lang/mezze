# std/math/trig.funk - Trigonometric functions

use std::math::core

# Basic trigonometric functions
pub let sin = { val: Float } ->
    __native_float_sin { val = val }

pub let cos = { val: Float } ->
    __native_float_cos { val = val }

pub let tan = { val: Float } ->
    __native_float_tan { val = val }

# Inverse trigonometric functions
pub let asin = { val: Float } ->
    __native_float_asin { val = val }

pub let acos = { val: Float } ->
    __native_float_acos { val = val }

pub let atan = { val: Float } ->
    __native_float_atan { val = val }

pub let atan2 = { y: Float, x: Float } ->
    __native_float_atan2 { y = y, x = x }

# Mathematical constants
pub let pi = 3.141592653589793
pub let e = 2.718281828459045

# Utility functions
pub let degrees_to_radians = { degrees: Float } ->
    degrees * (pi / 180.0)

pub let radians_to_degrees = { radians: Float } ->
    radians * (180.0 / pi)

# Additional trigonometric functions
pub let tanh = { val: Float } -> do
    let exp_pos = core::exp { val = val }
    let exp_neg = core::exp { val = -val }
    (exp_pos - exp_neg) / (exp_pos + exp_neg)

pub let sinh = { val: Float } -> do
    let exp_pos = core::exp { val = val }
    let exp_neg = core::exp { val = -val }
    (exp_pos - exp_neg) / 2.0

pub let cosh = { val: Float } -> do
    let exp_pos = core::exp { val = val }
    let exp_neg = core::exp { val = -val }
    (exp_pos + exp_neg) / 2.0