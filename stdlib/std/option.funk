# Option utility functions
# Note: Option type is now built-in to the language

# Map a function over the Option value
pub let map: { opt: (Option 'a), f: 'a -> 'b } -> (Option 'b) = { opt, f } ->
    match opt is
        Some { val } -> Some { val = f { val } }
        None -> None

# Get the value or return a default
pub let get_or_else: { opt: (Option 'a), def: 'a } -> 'a = { opt, def } ->
    match opt is
        Some { val } -> val
        None -> def

# Check if Option contains a value
pub let is_some: { opt: (Option 'a) } -> Bool = { opt } ->
    match opt is
        Some { val } -> true
        None -> false

# Check if Option is empty
pub let is_none: { opt: (Option 'a) } -> Bool = { opt } ->
    match opt is
        Some { val } -> false
        None -> true

# Filter Option based on predicate
pub let filter: { opt: (Option 'a), p: 'a -> Bool } -> (Option 'a) = { opt, p } ->
    match opt is
        Some { val } -> if p { val } then Some { val = val } else None
        None -> None

# Chain operations that return Options
pub let flat_map: { opt: (Option 'a), f: 'a -> (Option 'b) } -> (Option 'b) = { opt, f } ->
    match opt is
        Some { val } -> f { val }
        None -> None

# Return the first Some value, or None if both are None
pub let or_else: { opt1: (Option 'a), opt2: (Option 'a) } -> (Option 'a) = { opt1, opt2 } ->
    match opt1 is
        Some { val } -> opt1
        None -> opt2

# Combine two Options with a function
pub let map2: { opt_a: (Option 'a), opt_b: (Option 'b), f: { a: 'a, b: 'b } -> 'c } -> (Option 'c) = { opt_a, opt_b, f } ->
    match opt_a is
        Some { val = a } -> match opt_b is
            Some { val = b } -> Some { val = f { a = a, b = b } }
            None -> None
        None -> None

# Execute an action if Option contains a value
pub let if_some: { opt: (Option 'a), action: 'a -> Unit } -> Unit = { opt, action } ->
    match opt is
        Some { val } -> action { val }
        None -> {}

# Execute an action if Option is None
pub let if_none: { opt: (Option 'a), action: Unit -> Unit } -> Unit = { opt, action } ->
    match opt is
        Some { val } -> {}
        None -> action {}

# Execute different actions based on Option state
pub let fold: { opt: (Option 'a), on_none: {} -> 'b, on_some: 'a -> 'b } -> 'b = { opt, on_none, on_some } ->
    match opt is
        Some { val } -> on_some { val }
        None -> on_none {}