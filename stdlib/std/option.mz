use std::abilities::compare::{ Eq, Ord }
use std::abilities::default::{ Default }
use std::abilities::tryable::{ Tryable }
use std::effects::exception::{ Exception }

## Tryable for Option — extract Some, throw `NoneOpt` on None.
##
## `Option` carries no error information, so the throw is a synthetic
## variant `NoneOpt` that downstream code can match on. In a do-block
## that mixes `Option` and `Result` `.try {}` calls, the `<Exception>` row's
## `'error` parameter unifies to include both the `Result`s error types
## and `NoneOpt` for the `Option`s.
impl Tryable for Option 'a having 'inner = 'a where {
  try = { it } -> match it is
    Some { val } -> val
    None -> Exception.throw { error = NoneOpt }

}

impl Eq for Option 'a where {
  eq = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l == r_val
      None -> False
    None -> match r is
      Some { val = _ } -> False
      None -> True,
  neq = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l != r_val
      None -> True
    None -> match r is
      Some { val = _ } -> True
      None -> False,
}

## Lexicographic ordering for options, requiring the element to be Ord.
## `None < Some _`. The `with Ord 'a` preconditions prevent `Option T < Option T`
## from type-checking for a T with no Ord and crashing in the element compare (#224).
impl Ord for Option 'a where {
  lt: { it: Option 'a, r: Option 'a } with Ord 'a -> Bool = { it, r } -> match it is
    None -> match r is
      Some { val = _ } -> True
      None -> False
    Some { val = l } -> match r is
      None -> False
      Some { val = r_val } -> l < r_val,
  le: { it: Option 'a, r: Option 'a } with Ord 'a -> Bool = { it, r } -> match it is
    None -> True
    Some { val = l } -> match r is
      None -> False
      Some { val = r_val } -> l <= r_val,
  gt: { it: Option 'a, r: Option 'a } with Ord 'a -> Bool = { it, r } -> match it is
    None -> False
    Some { val = l } -> match r is
      None -> True
      Some { val = r_val } -> l > r_val,
  ge: { it: Option 'a, r: Option 'a } with Ord 'a -> Bool = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l >= r_val
      None -> True
    None -> match r is
      None -> True
      Some { val = _ } -> False,
}

impl Default for Option where {
  default = {} -> None
}

## Apply f to the inner value, or return None.
pub let map: { opt: Option 'a, f: { val: 'a } -> 'b <...> } -> Option 'b <...> = { opt, f } ->
  match opt is
    Some { val } -> Some { val = f { val } }
    None -> None


## Unwrap the value, or return def if None.
pub let get_or: { opt: Option 'a, def: 'a } -> 'a = { opt, def } -> match opt is
  Some { val } -> val
  None -> def


## True if the option contains a value.
pub let is_some: { opt: Option 'a } -> Bool = { opt } -> match opt is
  Some { val } -> True
  None -> False


## True if the option is empty.
pub let is_none: { opt: Option 'a } -> Bool = { opt } -> match opt is
  Some { val } -> False
  None -> True


## Keep the value only if predicate p holds.
pub let filter: { opt: Option 'a, p: { val: 'a } -> Bool <...> } -> Option 'a <...> = { opt, p } ->
  match opt is
    Some { val } -> if p { val } then Some { val = val } else None
    None -> None


## Apply f to the inner value (f itself returns an Option).
pub let flat_map
  : { opt: Option 'a, f: { val: 'a } -> Option 'b <...> }
  -> Option 'b <...>
  = { opt, f } -> match opt is
    Some { val } -> f { val }
    None -> None


## Return opt1 if Some, otherwise opt2.
pub let or_else: { opt1: Option 'a, opt2: Option 'a } -> Option 'a = { opt1, opt2 } ->
  match opt1 is
    Some { val } -> opt1
    None -> opt2


## Combine two Options with f. None if either is None.
pub let map2
  : { opt_a: Option 'a, opt_b: Option 'b, f: { a: 'a, b: 'b } -> 'c <...> }
  -> Option 'c <...>
  = { opt_a, opt_b, f } -> match opt_a is
    Some { val = a } -> match opt_b is
      Some { val = b } -> Some { val = f { a = a, b = b } }
      None -> None
    None -> None


## Run action if Some; do nothing if None.
pub let if_some: { opt: Option 'a, action: { val: 'a } -> {} <...> } -> {} <...> = { opt, action } ->
  match opt is
    Some { val } -> action { val }
    None -> {}


## Run action if None; do nothing if Some.
pub let if_none: { opt: Option 'a, action: {} -> {} <...> } -> {} <...> = { opt, action } ->
  match opt is
    Some { val } -> {}
    None -> action {}


## Fold over the Option with separate handlers for None and Some.
pub let fold
  : { opt: Option 'a, on_none: {} -> 'b <...>, on_some: { val: 'a } -> 'b <...> }
  -> 'b <...>
  = { opt, on_none, on_some } -> match opt is
    Some { val } -> on_some { val }
    None -> on_none {}


## Flatten a nested Option into a single layer.
pub let flatten: { opt: Option (Option 'a) } -> Option 'a = { opt } -> match opt is
  Some { val } -> val
  None -> None


## Convert to Result, using the given error for None.
pub let to_result: { opt: Option 'a, error: 'e } -> Result 'a 'e = { opt, error } ->
  match opt is
    Some { val } -> Ok { val = val }
    None -> Err { error = error }


## Convert to a single-element list, or empty list if None.
pub let to_list: { opt: Option 'a } -> ['a] = { opt } -> match opt is
  Some { val } -> [val]
  None -> []


## Zip two Options into an Option of a pair.
pub let zip
  : { a: Option 'a, b: Option 'b }
  -> Option { fst: 'a, snd: 'b }
  = { a, b } -> match a is
    Some { val = av } -> match b is
      Some { val = bv } -> Some { val = { fst = av, snd = bv } }
      None -> None
    None -> None


## Zip two Options, combining their values with f.
pub let zip_with
  : { a: Option 'a, b: Option 'b, f: { x: 'a, y: 'b } -> 'c <...> }
  -> Option 'c <...>
  = { a, b, f } -> match a is
    Some { val = av } -> match b is
      Some { val = bv } -> Some { val = f { x = av, y = bv } }
      None -> None
    None -> None


impl Option 'a where {
  map = { it, f } -> map { opt = it, f = f },
  flat_map = { it, f } -> flat_map { opt = it, f = f },
  get_or = { it, def } -> get_or { opt = it, def = def },
  is_some = { it } -> is_some { opt = it },
  is_none = { it } -> is_none { opt = it },
  filter = { it, p } -> filter { opt = it, p = p },
  or_else = { it, opt2 } -> or_else { opt1 = it, opt2 = opt2 },
  fold = { it, on_none, on_some } -> fold { opt = it, on_none = on_none, on_some = on_some },
  flatten = { it } -> flatten { opt = it },
  to_result = { it, error } -> to_result { opt = it, error = error },
  to_list = { it } -> to_list { opt = it },
}

## Wrap any value in Some via method syntax: `x.some {}` → `Some { val = x }`.
## Generic impl — covers every type. Cannot be specialized per-type.
ability Somable for 'a where {
  some: { it: 'a } -> Option 'a
}

impl Somable for 'a where {
  some = { it } -> Some { val = it }
}
