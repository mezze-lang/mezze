use std::abilities::compare::{ Eq, Ord }
use std::abilities::default::{ Default }

impl Eq 'a for Option 'a where {
  eq = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l == r_val
      None -> False
    None -> match r is
      Some { val = _ } -> False
      None -> True,
  neq = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l != r_val
      None -> True
    None -> match r is
      Some { val = _ } -> True
      None -> False,
}

impl Ord 'a for Option 'a where {
  lt = { it, r } -> match it is
    None -> match r is
      Some { val = _ } -> True
      None -> False
    Some { val = l } -> match r is
      None -> False
      Some { val = r_val } -> l < r_val,
  le = { it, r } -> match it is
    None -> True
    Some { val = l } -> match r is
      None -> False
      Some { val = r_val } -> l <= r_val,
  gt = { it, r } -> match it is
    None -> False
    Some { val = l } -> match r is
      None -> True
      Some { val = r_val } -> l > r_val,
  ge = { it, r } -> match it is
    Some { val = l } -> match r is
      Some { val = r_val } -> l >= r_val
      None -> True
    None -> match r is
      None -> True
      Some { val = _ } -> False,
}

impl Default for Option where {
  default = {} -> None
}

# Map a function over the Option value
pub let map : { opt: Option 'a, f: { val: 'a } -> 'b <...> } -> Option 'b <...> = { opt, f } ->
  match opt is
    Some { val } -> Some { val = f { val } }
    None -> None


pub let get_or_else : { opt: Option 'a, def: 'a } -> 'a = { opt, def } -> match opt is
  Some { val } -> val
  None -> def


pub let is_some : { opt: Option 'a } -> Bool = { opt } -> match opt is
  Some { val } -> True
  None -> False


pub let is_none : { opt: Option 'a } -> Bool = { opt } -> match opt is
  Some { val } -> False
  None -> True


pub let filter : { opt: Option 'a, p: { val: 'a } -> Bool <...> } -> Option 'a <...> = { opt, p } ->
  match opt is
    Some { val } -> if p { val } then Some { val = val } else None
    None -> None


pub let flat_map : { opt: Option 'a, f: { val: 'a } -> Option 'b <...> } -> Option 'b <...> = { opt, f } ->
  match opt is
    Some { val } -> f { val }
    None -> None


pub let or_else : { opt1: Option 'a, opt2: Option 'a } -> Option 'a = { opt1, opt2 } ->
  match opt1 is
    Some { val } -> opt1
    None -> opt2


pub let map2 : { opt_a: Option 'a, opt_b: Option 'b, f: { a: 'a, b: 'b } -> 'c <...> } -> Option 'c <...> = { opt_a, opt_b, f } ->
  match opt_a is
    Some { val = a } -> match opt_b is
      Some { val = b } -> Some { val = f { a = a, b = b } }
      None -> None
    None -> None


pub let if_some : { opt: Option 'a, action: { val: 'a } -> {} <...> } -> {} <...> = { opt, action } ->
  match opt is
    Some { val } -> action { val }
    None -> {}


pub let if_none : { opt: Option 'a, action: {} -> {} <...> } -> {} <...> = { opt, action } ->
  match opt is
    Some { val } -> {}
    None -> action {}


pub let fold : { opt: Option 'a, on_none: {} -> 'b <...>, on_some: { val: 'a } -> 'b <...> } -> 'b <...> = { opt, on_none, on_some } ->
  match opt is
    Some { val } -> on_some { val }
    None -> on_none {}


pub let flatten : { opt: Option (Option 'a) } -> Option 'a = { opt } -> match opt is
  Some { val } -> val
  None -> None


pub let to_result : { opt: Option 'a, error: 'e } -> Result 'a 'e = { opt, error } ->
  match opt is
    Some { val } -> Ok { val = val }
    None -> Err { error = error }


pub let to_list : { opt: Option 'a } -> ['a] = { opt } -> match opt is
  Some { val } -> [val]
  None -> []


pub let zip : { a: Option 'a, b: Option 'b } -> Option { fst: 'a, snd: 'b } = { a, b } ->
  match a is
    Some { val = av } -> match b is
      Some { val = bv } -> Some { val = { fst = av, snd = bv } }
      None -> None
    None -> None


pub let zip_with : { a: Option 'a, b: Option 'b, f: { x: 'a, y: 'b } -> 'c <...> } -> Option 'c <...> = { a, b, f } ->
  match a is
    Some { val = av } -> match b is
      Some { val = bv } -> Some { val = f { x = av, y = bv } }
      None -> None
    None -> None


impl Option 'a where {
  map = { it, f } -> map { opt = it, f = f },
  flat_map = { it, f } -> flat_map { opt = it, f = f },
  get_or_else = { it, def } -> get_or_else { opt = it, def = def },
  is_some = { it } -> is_some { opt = it },
  is_none = { it } -> is_none { opt = it },
  filter = { it, p } -> filter { opt = it, p = p },
  or_else = { it, opt2 } -> or_else { opt1 = it, opt2 = opt2 },
  fold = { it, on_none, on_some } -> fold { opt = it, on_none = on_none, on_some = on_some },
  flatten = { it } -> flatten { opt = it },
  to_result = { it, error } -> to_result { opt = it, error = error },
  to_list = { it } -> to_list { opt = it },
}
