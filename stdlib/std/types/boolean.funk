# std/types/boolean.funk - Boolean type operations and conversions

# Comparison operations
pub let equals = { left: Boolean, right: Boolean } -> Boolean
    __native_boolean_equals { left = left, right = right }

# String conversion
pub let to_string = { value: Boolean } -> String
    __native_boolean_to_string { value = value }

# Logical operations
pub let and = { left: Boolean, right: Boolean } -> Boolean
    __native_boolean_and { left = left, right = right }

pub let or = { left: Boolean, right: Boolean } -> Boolean
    __native_boolean_or { left = left, right = right }

pub let not = { value: Boolean } -> Boolean
    __native_boolean_not { value = value }

pub let xor = { left: Boolean, right: Boolean } -> Boolean
    __native_boolean_xor { left = left, right = right }

# Type conversions
pub let from_string = { str: String } -> Boolean
    __native_boolean_from_string { str = str }

# Utility functions
pub let if_then_else = { condition: Boolean, then_value: 'a, else_value: 'a } -> 'a
    if condition then then_value else else_value