# std/types/float.funk - Float type operations and conversions

# Core arithmetic operations (hidden native implementations)
pub let add = { left: Float, right: Float } -> Float
    __native_float_add { left = left, right = right }

pub let subtract = { left: Float, right: Float } -> Float
    __native_float_subtract { left = left, right = right }

pub let multiply = { left: Float, right: Float } -> Float
    __native_float_multiply { left = left, right = right }

pub let divide = { left: Float, right: Float } -> Float
    __native_float_divide { left = left, right = right }

pub let modulo = { left: Float, right: Float } -> Float
    __native_float_modulo { left = left, right = right }

# Comparison operations
pub let equals = { left: Float, right: Float } -> Boolean
    __native_float_equals { left = left, right = right }

pub let less_than = { left: Float, right: Float } -> Boolean
    __native_float_less_than { left = left, right = right }

pub let greater_than = { left: Float, right: Float } -> Boolean
    __native_float_greater_than { left = left, right = right }

# String conversion
pub let to_string = { value: Float } -> String
    __native_float_to_string { value = value }

# Type conversions
pub let from_int = { value: Int } -> Float
    __native_float_from_int { value = value }

pub let from_nat = { value: Nat } -> Float
    __native_float_from_nat { value = value }

pub let from_string = { value: String } -> Float
    __native_float_from_string { value = value }

# Mathematical functions
pub let abs = { value: Float } -> Float
    if value < 0.0 then subtract { left = 0.0, right = value } else value

pub let min = { left: Float, right: Float } -> Float
    if left < right then left else right

pub let max = { left: Float, right: Float } -> Float
    if left > right then left else right

pub let pow = { base: Float, exp: Float } -> Float
    __native_float_pow { base = base, exp = exp }

pub let sqrt = { value: Float } -> Float
    __native_float_sqrt { value = value }

pub let floor = { value: Float } -> Float
    __native_float_floor { value = value }

pub let ceil = { value: Float } -> Float
    __native_float_ceil { value = value }

pub let round = { value: Float } -> Float
    __native_float_round { value = value }