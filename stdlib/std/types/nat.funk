# std/types/nat.funk - Nat (natural number) type operations and conversions

# Core arithmetic operations (hidden native implementations)
pub let add = { left: Nat, right: Nat } -> Nat
    __native_nat_add { left = left, right = right }

pub let subtract = { left: Nat, right: Nat } -> Nat
    __native_nat_subtract { left = left, right = right }

pub let multiply = { left: Nat, right: Nat } -> Nat
    __native_nat_multiply { left = left, right = right }

pub let divide = { left: Nat, right: Nat } -> Nat
    __native_nat_divide { left = left, right = right }

pub let modulo = { left: Nat, right: Nat } -> Nat
    __native_nat_modulo { left = left, right = right }

# Special subtraction that returns Int (since Nat - Nat can be negative)
pub let subtract_to_int = { left: Nat, right: Nat } -> Int
    __native_nat_subtract_to_int { left = left, right = right }

# Comparison operations
pub let equals = { left: Nat, right: Nat } -> Boolean
    __native_nat_equals { left = left, right = right }

pub let less_than = { left: Nat, right: Nat } -> Boolean
    __native_nat_less_than { left = left, right = right }

pub let greater_than = { left: Nat, right: Nat } -> Boolean
    __native_nat_greater_than { left = left, right = right }

# String conversion
pub let to_string = { value: Nat } -> String
    __native_nat_to_string { value = value }

# Type conversions
pub let from_int = { value: Int } -> Nat
    __native_nat_from_int { value = value }

pub let from_float = { value: Float } -> Nat
    __native_nat_from_float { value = value }

pub let from_string = { value: String } -> Nat
    __native_nat_from_string { value = value }

# Utility functions
pub let min = { left: Nat, right: Nat } -> Nat
    if left < right then left else right

pub let max = { left: Nat, right: Nat } -> Nat
    if left > right then left else right

pub let is_zero = { value: Nat } -> Boolean
    equals { left = value, right = 0 }

pub let is_even = { value: Nat } -> Boolean
    equals { left = modulo { left = value, right = 2 }, right = 0 }

pub let is_odd = { value: Nat } -> Boolean
    not (is_even { value = value })