# String utility functions
# This module provides utility functions for working with strings
# Note: The String type and basic operations are now built-in
# Built-in ability implementations (Eq, Display) are automatically available

# String concatenation
pub let concat = { l: String, r: String } ->
    __native_string_concat { l = l, r = r }

# String utility functions
pub let to_string = { s: String } ->
    s

pub let length = { s: String } ->
    __native_string_length { s = s }

pub let is_empty = { s: String } ->
    length { s = s } == 0

pub let to_upper = { s: String } ->
    __native_string_to_upper { s = s }

pub let to_lower = { s: String } ->
    __native_string_to_lower { s = s }

pub let trim = { s: String } ->
    __native_string_trim { s = s }

pub let reverse = { s: String } ->
    __native_string_reverse { s = s }

# Additional string utilities
pub let starts_with = { s: String, prefix: String } ->
    __native_string_starts_with { s = s, prefix = prefix }

pub let ends_with = { s: String, suffix: String } ->
    __native_string_ends_with { s = s, suffix = suffix }

pub let contains = { s: String, substring: String } ->
    __native_string_contains { s = s, substring = substring }

pub let repeat = { s: String, n: Int } ->
    if n <= 0 then ""
    else if n == 1 then s
    else concat { l = s, r = repeat { s = s, n = n - 1 } }

# Split string by delimiter into an array of strings
pub let split = { s: String, delimiter: String } ->
    __native_string_split { s = s, delimiter = delimiter }

# Join array of strings with separator
pub let join = { strings: [String], separator: String } ->
    __native_string_join { strings = strings, separator = separator }

# =============================================================================
# Substring and Slicing
# =============================================================================

# Extract substring from start (inclusive) to end (exclusive)
# Returns empty string if indices are out of bounds
# Example: substring {s = "hello", start = 1, end = 4} -> "ell"
pub let substring = { s: String, start: Int, end: Int } ->
    __native_string_substring { s = s, start = start, end = end }

# =============================================================================
# Replace Operations
# =============================================================================

# Replace first occurrence of old with new
# Example: replace {s = "hello world", old = "o", new = "0"} -> "hell0 world"
pub let replace = { s: String, old: String, new: String } ->
    __native_string_replace { s = s, old = old, new = new }

# Replace all occurrences of old with new
# Example: replace_all {s = "hello world", old = "o", new = "0"} -> "hell0 w0rld"
pub let replace_all = { s: String, old: String, new: String } ->
    __native_string_replace_all { s = s, old = old, new = new }

# =============================================================================
# Character Access
# =============================================================================

# Get character at index, returns None if out of bounds
# Example: char_at {s = "hello", i = 1} -> Some {val = 'e'}
pub let char_at = { s: String, i: Int } ->
    __native_string_char_at { s = s, i = i }

# =============================================================================
# Index Search
# =============================================================================

# Find first index of substring, returns None if not found
# Example: index_of {s = "hello", sub = "ll"} -> Some {val = 2}
pub let index_of = { s: String, sub: String } ->
    __native_string_index_of { s = s, sub = sub }

# Find last index of substring, returns None if not found
# Example: last_index_of {s = "hello hello", sub = "ll"} -> Some {val = 8}
pub let last_index_of = { s: String, sub: String } ->
    __native_string_last_index_of { s = s, sub = sub }

# =============================================================================
# Additional Trimming
# =============================================================================

# Trim leading whitespace only
# Example: trim_start {s = "  hello  "} -> "hello  "
pub let trim_start = { s: String } ->
    __native_string_trim_start { s = s }

# Trim trailing whitespace only
# Example: trim_end {s = "  hello  "} -> "  hello"
pub let trim_end = { s: String } ->
    __native_string_trim_end { s = s }

# =============================================================================
# Splitting Utilities
# =============================================================================

# Split string by newlines
# Example: lines {s = "a\nb\nc"} -> ["a", "b", "c"]
pub let lines = { s: String } ->
    __native_string_lines { s = s }

# Split string by whitespace (removes empty strings)
# Example: words {s = "hello  world"} -> ["hello", "world"]
pub let words = { s: String } ->
    __native_string_words { s = s }

# Convert string to array of characters
# Example: chars {s = "abc"} -> ['a', 'b', 'c']
pub let chars = { s: String } ->
    __native_string_chars { s = s }

# =============================================================================
# Padding
# =============================================================================

# Pad string on the left to reach target length
# Example: pad_left {s = "42", len = 5, c = '0'} -> "00042"
pub let pad_left = { s: String, len: Int, c: Char } ->
    __native_string_pad_left { s = s, len = len, c = c }

# Pad string on the right to reach target length
# Example: pad_right {s = "hi", len = 5, c = '.'} -> "hi..."
pub let pad_right = { s: String, len: Int, c: Char } ->
    __native_string_pad_right { s = s, len = len, c = c }

# =============================================================================
# Glob Pattern Matching
# =============================================================================

# Match a string against a glob pattern
#
# Supported patterns:
#   *      - matches any characters except /
#   **     - matches any characters including /
#   ?      - matches a single character (not /)
#   [abc]  - matches any character in the set
#   [!abc] - matches any character not in the set
#   [a-z]  - matches any character in the range
#
# Examples:
#   glob_match { pattern = "/users/*", text = "/users/123" }           -> True
#   glob_match { pattern = "/users/*", text = "/users/123/posts" }     -> False (stops at /)
#   glob_match { pattern = "/api/**/health", text = "/api/v1/health" } -> True
#   glob_match { pattern = "*.json", text = "config.json" }            -> True
#   glob_match { pattern = "file?.txt", text = "file1.txt" }           -> True
#   glob_match { pattern = "[abc].txt", text = "a.txt" }               -> True
#   glob_match { pattern = "[!abc].txt", text = "d.txt" }              -> True
#
pub let glob_match = { pattern: String, text: String } ->
    __native_string_glob_match { pattern = pattern, text = text }