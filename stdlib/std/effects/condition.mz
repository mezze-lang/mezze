# Unlike `Exception`, a handler may resume, so one run can collect every problem. `fallback` comes
# from the call site so the op is polymorphic in it and a handler cannot invent a value (V0503/T0210).
## Resumable conditions: signal a recoverable problem; the handler decides whether to carry on.
## Each site offers its own fallback, e.g. `signal { ctx = "bad age", fallback = 0 }`.
effect Condition having 'ctx where {
  ## Signal `ctx`, offering `fallback` as the value to carry on with.
  signal: { ctx: 'ctx, fallback: 'a } -> 'a <Condition>
}

# A bare value instead of `cont.resume { val = fallback }`: same op, ~2.4x cheaper (no @TruffleBoundary).
## Carry on at every signal with the offered fallback, so the run reflects ALL recoveries.
impl Condition for UseFallback having 'ctx = 'c where {
  signal = { ctx, fallback } -> fallback
}

## Give up at the first signal, with the context as the error.
## The body's tail must be a `Result` too: `perform FirstErr in do … Ok { val = … }`.
impl Condition for FirstErr having 'ctx = 'c where {
  signal = { ctx, fallback } -> cont.abort { val = Err { error = ctx } }
}

## Give up at the first signal, discarding the context.
impl Condition for FirstNone having 'ctx = 'c where {
  signal = { ctx, fallback } -> cont.abort { val = None }
}

## Signal a condition. Shorthand for `Condition.signal`.
pub let signal = { ctx, fallback } -> Condition.signal { ctx = ctx, fallback = fallback }
