## Routing — PURE code that folds a route table into ONE handler.
##
## Nothing here performs an effect. A `Route` matches a method and a path; `or`
## joins two routes; `otherwise` supplies the fallback and closes the table into
## a plain `{ req: Request } -> Response`. That function is what `serve` takes,
## so routing never appears in the `HttpServer` effect and never grows an
## operation.
##
## Because it is pure, a route table is tested by calling it with a `Request`.
## No server, no mock, no socket.
##
## Calls here are QUALIFIED (`seq::size`, `str::starts_with`) rather than
## method-style. A stdlib inherent method needs its ability in scope at the use
## site, and this module should not impose that on its consumers.
##
## PATH PARAMETERS. A segment written `:name` matches any one segment and binds
## it. `/users/:id` matches `/users/7` and binds `id` to `"7"`. The handler
## receives the bindings as a `Map Str Str` alongside the request.

use std::effects::http::{ Method, Request, Response, IntoResponse, IntoErrorResponse, not_found, response_status }
use std::effects::exception::{ ExceptionToResult }
use std::collections::map
use std::collections::iter
use std::collections::seq
use std::collections::bytes
use std::str
use std::codec::url::{ url_decode_component }
pub use std::codec::query::{ FromQuery }
use std::codec::core::{ DecodeError }
## `path_of` does index arithmetic, and `+` on Int needs int's `NumAdd` impl in
## scope — an impl arrives with its module, not with the prelude.
use std::int

## What a matched route hands its handler: the request, plus the path
## parameters the pattern bound.
pub type Matched = {
  req: Request,
  params: Map Str Str,
}

## A route table. `run` is the only thing a consumer needs; the variants exist
## so `or` can build a chain without a mutable list.
##
## The row on `run` is open, so the HANDLERS a table carries may perform effects
## even though the routing around them performs none. A route that reads a
## database or a clock is the normal case, not an exception, and the row that
## says so travels with the table rather than being discharged by it.
pub type Routes = {
  run: { req: Request } -> Option Response <...>,
}

## Split a path into segments, dropping the empty pieces a leading or trailing
## slash produces, so `/users/7/` and `users/7` agree.
pub let segments: { path: Str } -> [Str] = { path } ->
  seq::filter { xs = str::split { s = path, delimiter = "/" }, p = { x } -> x != "" }

## ── Request targets ─────────────────────────────────────────────────────────

## Drop a query string, if there is one.
let strip_query: { s: Str } -> Str = { s } ->
  match str::index_of { s = s, sub = "?" } is
    None -> s
    Some { val = q } -> str::substring { s = s, start = 0, end = q }

## The path of an authority-relative remainder: everything from its first
## slash. A URL with no path at all (`https://host`) means the root.
let slash_onward: { s: Str } -> Str = { s } ->
  match str::index_of { s = s, sub = "/" } is
    None -> "/"
    Some { val = j } -> str::substring { s = s, start = j, end = str::size { s = s } }

## Drop a `scheme://authority` prefix, if there is one.
let strip_authority: { s: Str } -> Str = { s } ->
  match str::index_of { s = s, sub = "://" } is
    None -> s
    Some { val = i } ->
      slash_onward { s = str::substring { s = s, start = i + 3, end = str::size { s = s } } }

## The path part of a request target: no scheme, no authority, no query.
##
## The two sides of the web story spell a target differently. A server hands the
## handler what arrived on the wire — `/users/7?page=2`. A client's `Request.url`
## is absolute — `https://api.example.com/users/7`. Routing cares about neither
## the authority nor the query, so both reduce to `/users/7` here and ONE route
## table matches requests from either side.
pub let path_of: { url: Str } -> Str = { url } ->
  strip_query { s = strip_authority { s = url } }

## The raw query string of a request target, or `""` when it carries none.
##
## Raw: still percent-encoded, still `&`-joined. Turning it into typed values is
## the query codec's job, not the router's.
pub let query_of: { url: Str } -> Str = { url } ->
  match str::index_of { s = url, sub = "?" } is
    None -> ""
    Some { val = q } -> str::substring { s = url, start = q + 1, end = str::size { s = url } }

## Match one pattern against one path, returning the bound parameters.
##
## Returns `None` when the lengths differ or a literal segment disagrees. A
## `:name` segment always matches and binds.
pub let match_path: { pattern: Str, path: Str } -> Option (Map Str Str) = { pattern, path } ->
  match_prepared { pat = prepare { pattern = pattern }, url = path }

## A pattern taken apart once, when the route table is built.
##
## `segs` serves the binding path. `literal` is the pattern's slash-trimmed form,
## present ONLY when the pattern binds no `:name` — and then matching is one
## STRING COMPARISON instead of splitting the request path into a seq, filtering
## it, zipping it against the pattern and folding a map that comes back empty.
## For a static route that was 5.3% of throughput.
let prepare: { pattern: Str } -> { segs: [Str], literal: Option Str } = { pattern } -> do
  let segs = segments { path = pattern }
  let binds = seq::any { xs = segs, p = { x } -> str::starts_with { s = x, prefix = ":" } }
  {
    segs = segs,
    literal = if binds then None else Some { val = trim_slashes { s = pattern } },
  }

## Drop one leading and one trailing `/`, so `/users` and `users/` agree the way
## `segments` makes them agree. `"/"` trims to `""`, which is the root's zero
## segments.
let trim_slashes: { s: Str } -> Str = { s } -> do
  let n = str::size { s = s }
  let start = if str::starts_with { s = s, prefix = "/" } then 1 else 0
  let end = if n > start then (if str::ends_with { s = s, suffix = "/" } then n - 1 else n) else n
  str::substring { s = s, start = start, end = end }

let match_prepared
  : { pat: { segs: [Str], literal: Option Str }, url: Str }
  -> Option (Map Str Str)
  = { pat, url } -> do
    let path = path_of { url = url }
    match pat.literal is
      None -> match_on_path { ps = pat.segs, path = path }
      Some { val = lit } ->
        ## `//` inside the path makes a comparison disagree with `segments`,
        ## which drops empty pieces — so that case takes the segment path. It is
        ## the only shape where the two could differ.
        if str::contains { s = path, substring = "//" } then
          match_on_path { ps = pat.segs, path = path }
        else
          if trim_slashes { s = path } == lit then Some { val = map::empty {} } else None

## Bind a prepared pattern's segments against an already-extracted path.
##
## A pattern cannot change between requests, so splitting it again on every one
## is work that can only produce the same answer. `route` splits its pattern
## when the table is BUILT and calls this; doing it per request cost 7% of
## throughput on a two-segment route.
##
## Measured and NOT worth it on its own: skipping just the zip and the parameter
## map for a static route, while still SPLITTING the path (457.5k -> 457.3k). The
## split is the expensive half, which is why `prepare`'s `literal` avoids it
## entirely rather than only the fold.
let match_on_path: { ps: [Str], path: Str } -> Option (Map Str Str) = { ps, path } -> do
  let xs = segments { path = path }
  if seq::size { xs = ps } != seq::size { xs = xs } then None
  else
    ## `iter`, not `seq`: this walks the pattern and the path TOGETHER once and
    ## keeps only the bindings. `seq::zip` would materialise a whole seq of pairs
    ## for the fold to consume and discard — a lazy pipeline has no business
    ## allocating one. Zipping lazily, nothing exists but the accumulator.
    iter::fold {
      it = iter::zip {
        a = iter::from_seq { xs = ps },
        b = iter::from_seq { xs = xs },
      },
      init = Some { val = map::empty {} },
      f = { acc, x } -> match acc is
        None -> None
        Some { val = bound } ->
          if str::starts_with { s = x.fst, prefix = ":" } then
            Some { val = map::insert {
              m = bound,
              k = str::substring { s = x.fst, start = 1, end = str::size { s = x.fst } },
              v = x.snd,
            } }
          else
            if x.fst == x.snd then Some { val = bound } else None
    }

## One route: a method, a path pattern, and a handler that receives the bound
## parameters.
pub let route: { method: Method, path: Str, handler: { m: Matched } -> Response <...> } -> Routes =
  { method, path, handler } -> do
    ## Taken apart once, here, not on every request.
    let pat = prepare { pattern = path }
    {
      run = { req } ->
        if req.method != method then None
        else match match_prepared { pat = pat, url = req.url } is
          None -> None
          Some { val = params } ->
            Some { val = handler { m = { req = req, params = params } } },
    }

# A handler may answer with anything convertible to a Response — a Str, a
# Json, or a Response it built itself:
#
#   on_get  { path = "/ping",      handler = { m } -> "pong" }
#   on_post { path = "/users",     handler = { m } -> created { body = "ok" } }
#   on_get  { path = "/users/:id", handler = { m } -> m.param_or { name = "id", default = "?" } }
#
# `route` remains and still takes a Response-returning handler: these are a
# layer over it, not a replacement, so nothing written against it changes.
#
# The conversion happens INSIDE the wrapped handler, not at table-build time,
# because the handler has not run yet — and it runs under the handler's own
# effect row, which is why the row stays open here.
## Route one method and path to a handler, converting whatever it answers and
## sending whatever Response it throws.
##
## The handler row is `<Exception? having 'error = Response, ...>`: it MAY
## perform Exception, and if it does the thrown value must be a `Response`. A
## pure handler passes — that is what the `?` buys — and a handler that throws
## something else is refused while compiling, naming the row.
##
## Written bare (`<...>`) this slot absorbed the thrown type without checking
## it, so `throw { error = { why = "…" } }` compiled and died at run time with
## `Field not found: status`. Written `<Exception, ...>` every handler would
## have had to throw, because a named effect before `...` is a lower bound. The
## `?` is the upper bound neither could express, and it is what lets the catch
## live here instead of being written at every call site.
##
## `RouteGroup`'s `get`/`post`/… methods are a SECOND family doing the same job
## for `group { … }.get { … }`, and they carry the same row for the same reason.
## They are not thin wrappers over this function — each calls `group_add` with
## the group's prefix — so the row has to be written in both places, and a
## throwing handler reaching only one of them is the bug this comment exists to
## stop happening again.
pub let on_method
  : { method: Method, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  =
  { method, path, handler } ->
    route { method = method, path = path, handler = catching { handler = handler } }

## Route a GET at `path`.
pub let on_get
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Get, path = path, handler = handler }

## Route a POST at `path`.
pub let on_post
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Post, path = path, handler = handler }

## Route a PUT at `path`.
pub let on_put
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Put, path = path, handler = handler }

## Route a PATCH at `path`.
pub let on_patch
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Patch, path = path, handler = handler }

## Route a DELETE at `path`.
pub let on_delete
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Delete, path = path, handler = handler }

## Route a HEAD at `path`.
pub let on_head
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Head, path = path, handler = handler }

## Route a OPTIONS at `path`.
pub let on_options
  : { path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> Routes
  = { path, handler } -> on_method { method = Options, path = path, handler = handler }

# ---- handler-side adapters ------------------------------------------------
#
# A group's verbs take the handler DIRECTLY and convert whatever it answers:
#
#   .get { path = "/ping",   handler = { m } -> "pong" }           # Str
#   .get { path = "/made",   handler = { m } -> created { … } }    # Response
#   .get { path = "/j",      handler = { m } -> payload }          # Json
#   .get { path = "/u/:id",  handler = { m } -> load { id = … } }  # Result
#
# all in ONE chain, each route answering a different type. Nothing wraps
# anything, and there is no `try_get` beside `get`.
#
# A Result needs no adapter either: `impl IntoResponse for Result` sends the
# Ok through IntoResponse and the Err through IntoErrorResponse, so an error
# picks its own status. (A `Result Str HttpError` used to die in a native here
# — one dictionary slot was filled from a sibling constraint's type. Fixed in
# the compiler's dict evidence, not worked around.)
#
# The verbs apply this themselves, so a route reads `handler = { m } -> …`
# whether or not it throws. Writing `catching` is still accepted and still
# means the same thing; it is no longer needed.
#
# That took two tries. The first fold was REVERTED, and the note left behind
# said why and what would be needed to bring it back: "it can come back when a
# row can say MAY perform Exception, and if so with 'error = Response — an
# upper bound `<E, ...>` cannot express, since it means AT LEAST." The verb's
# slot had to be a bare `<...>` for a pure handler to pass, and a bare row
# absorbs the thrown type unchecked, so a handler throwing a NON-Response
# compiled and died at run time with `Field not found: status`.
#
# `<Exception? having 'error = Response, ...>` is that row, and the `?` is new
# notation added for it: an effect written `Name?` is exempt from the lower
# bound, while its instance is still unified when the effect IS performed.
# A pure handler passes, a Response-throwing handler passes, and a handler
# throwing anything else is refused while compiling — which is the measurement
# the revert turned on. HttpIntoResponseTest pins all three.
#
# It stays a free function because it carries an ability constraint, and a
# constraint on an inherent impl method only works for an IMPORTED impl (a
# locally declared one is not re-instantiated per call, so its constrained
# variable collapses to the first use's type).

# The handler runs inside ExceptionToResult, so a throw short-circuits to the
# Response it threw. The conversion happens INSIDE the region, where the answer
# is still typed `'r`: done outside, on the Ok payload, the IntoResponse
# constraint lands on a different variable and the annotation is rejected.
#
# The thrown channel is a concrete Response rather than any error with an
# IntoErrorResponse impl, because naming that error type here means
# `having 'error = 'e` plus `with IntoErrorResponse 'e` — and the signature's
# `'e` does not tie to the one bound in the body's Err arm (T0210). Convert at
# the throw site instead: `throw { error = e.into_error_response {} }`, or let
# `or_throw` do it for a Result.
## Adapt a handler that may THROW a Response into one answering a Response.
##
## The verbs do this for you, so this is rarely written by hand:
##
##   .get { path = "/u/:id", handler = { m } -> … }       # the usual form
##   .get { path = "/u/:id", handler = catching { handler = { m } -> … } }
##
## It is still useful where a handler value is built and passed around on its
## own, away from the route that will carry it.
pub let catching
  : { handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
  with IntoResponse 'r
  -> { m: Matched } -> Response <...>
  =
  { handler } -> { m } -> do
    let outcome = perform ExceptionToResult in do
      let answered = handler { m = m }
      Ok { val = answered.into_response {} }
    match outcome is
      Ok { val } -> val
      Err { error } -> error

## Like `catching`, for a handler that throws its OWN error type.
##
## `catching` takes a handler that throws a `Response` — it has already decided
## the status and the body. This one takes a handler that throws whatever its
## domain uses and converts it on the way out, so a route can speak in
## `NotFound { id }` and let `IntoErrorResponse` decide what that is on the wire:
##
##   impl IntoErrorResponse for NotFound where {
##     into_error_response = { it } -> response_status { code = 404, body = it.id },
##   }
##
##   .get { path = "/u/:id", handler = catching_any { handler = { m } -> do
##     let id = m.params.get_or { k = "id", default = "" }
##     if id == "" then throw { error = NotFound { id = id } } else show { id = id }
##   } }
##
## The thrown type has to reach three places, which is why this did not exist
## before: the `Err` arm's binding, the call site's dictionary for
## `IntoErrorResponse`, and — for an INLINE handler — the lambda's own stamped
## effect row, which used to carry this function's variable rather than what the
## handler actually threw.
##
## A RECORD-typed error does not dispatch yet: against an ANONYMOUS record the
## operation resolves as a FIELD rather than an ability op, and a record's open
## row lets the missing field past the checker, so it fails at run time instead
## of while compiling. Throw a named type, a `Str`, or a `Response` through
## `catching`. `HttpCatchingAnyTest` pins each case.
pub let catching_any
  : { handler: { m: Matched } -> 'r <Exception having 'error = 'e, ...> }
  with IntoResponse 'r, IntoErrorResponse 'e
  -> { m: Matched } -> Response <...>
  =
  { handler } -> { m } -> do
    let outcome = perform ExceptionToResult in do
      let answered = handler { m = m }
      Ok { val = answered.into_response {} }
    match outcome is
      Ok { val } -> val
      Err { error } -> error.into_error_response {}

# ---- route groups --------------------------------------------------------
#
# A group is a path prefix plus the routes under it, and groups NEST:
#
#   let users = group { prefix = "/users" }
#     .get  { path = "/:id", handler = show }
#     .post { path = "",     handler = create }
#
#   let app = group { prefix = "/api" }
#     .nest { group = users }
#     .get { path = "/health", handler = respond { handler = { m } -> "ok" } }
#     .otherwise { fallback = fallback }
#
# giving /api/users/:id, /api/users and /api/health.
#
# Entries are kept as DATA rather than folded into a Routes as they are added,
# because `nest` has to re-prefix a child's routes and a folded Routes is an
# opaque function by then.
#
# A NEWTYPE, not a record alias, and that is load-bearing. `get` is declared by
# a dozen inherent impls (Seq, List, Map, Deque, SortedMap, NonEmptyList,
# Bytes, Client, MockRule, …), so the receiver has to carry a nominal identity
# for `.get {}` to reach THIS one. As a record alias it does not: the receiver
# arrives as an anonymous record (a field whose type never solved is enough to
# stop alias adoption labelling it), no candidate matches, and the call
# compiles to a field read that fails at RUNTIME with `Field not found: get`.
# A newtype is nominal by construction.

## One route in a group: a method, a full path, and a Response-answering handler.
pub type RouteEntry = {
  method: Method,
  path: Str,
  handler: { m: Matched } -> Response <...>,
}

## A path prefix and the routes under it. Build with `group`, nest with `nest`.
##
## A group is a route TABLE, not yet a handler. Close it with `handler` for a
## 404 on anything unmatched, or `otherwise` to answer that yourself. Passing
## the group itself to `serve` is a type error naming this.
pub newtype RouteGroup = { prefix: Str, entries: [RouteEntry] }

## An empty group rooted at `prefix`. Use `""` for no prefix.
pub let group: { prefix: Str } -> RouteGroup = { prefix } ->
  RouteGroup.({ prefix = prefix, entries = [] })

let group_inner: { g: RouteGroup } -> { prefix: Str, entries: [RouteEntry] } = { g } ->
  match g is
    RouteGroup.(v) -> v

# Every entry folded into one table, first added winning. `table`, `otherwise`
# and `handler` all want exactly this, and each had its own copy.
let fold_entries: { g: RouteGroup } -> Routes = { g } ->
  seq::fold {
    xs = group_inner { g = g }.entries,
    init = { run = { req } -> None },
    f = { acc, x } -> or_else {
      a = acc,
      b = route { method = x.method, path = x.path, handler = x.handler },
    },
  }

# Join a prefix and a path with exactly one slash between them, so "/users" and
# "/:id" give "/users/:id" and "/users" with "" stays "/users".
let join_prefix: { prefix: Str, path: Str } -> Str = { prefix, path } ->
  if str::is_empty { s = prefix } then path
  else if str::is_empty { s = path } then prefix
  else if str::ends_with { s = prefix, suffix = "/" } && str::starts_with { s = path, prefix = "/" }
  then str::concat {
    l = prefix,
    r = str::substring { s = path, start = 1, end = str::size { s = path } },
  }
  else if str::ends_with { s = prefix, suffix = "/" } || str::starts_with { s = path, prefix = "/" }
  then str::concat { l = prefix, r = path }
  else str::concat { l = str::concat { l = prefix, r = "/" }, r = path }

let group_add
  : { g: RouteGroup, method: Method, path: Str, handler: { m: Matched } -> Response <...> }
  -> RouteGroup
  =
  { g, method, path, handler } -> do
    let inner = group_inner { g = g }
    RouteGroup.({
      prefix = inner.prefix,
      entries = seq::push {
        xs = inner.entries,
        x = {
          method = method,
          path = join_prefix { prefix = inner.prefix, path = path },
          handler = handler,
        },
      },
    })

impl RouteGroup where {
  ## Append a GET under this group's prefix, answering whatever the handler returns.
  get: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Get,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append a POST under this group's prefix, answering whatever the handler returns.
  post: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Post,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append a PUT under this group's prefix, answering whatever the handler returns.
  put: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Put,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append a PATCH under this group's prefix, answering whatever the handler returns.
  patch: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Patch,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append a DELETE under this group's prefix, answering whatever the handler returns.
  delete: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Delete,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append a HEAD under this group's prefix, answering whatever the handler returns.
  head: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Head,
      path = path,
      handler = catching { handler = handler },
    },
  ## Append an OPTIONS under this group's prefix, answering whatever the handler returns.
  options: { it: 'it, path: Str, handler: { m: Matched } -> 'r <Exception? having 'error = Response, ...> }
    with IntoResponse 'r -> RouteGroup =
    { it, path, handler } -> group_add {
      g = it,
      method = Options,
      path = path,
      handler = catching { handler = handler },
    },

  # The child's entries already carry the child's own prefix, so one more
  # prepend nests them — and nesting a group that itself nested one works for
  # the same reason, to any depth.
  ## Mount another group's routes under this group's prefix.
  nest = { it: 'it, group: RouteGroup } -> do
    let outer = group_inner { g = it }
    let child = group_inner { g = group }
    RouteGroup.({
      prefix = outer.prefix,
      entries = seq::concat {
        xs = outer.entries,
        ys = seq::map {
          xs = child.entries,
          f = { x } -> {
            method = x.method,
            path = join_prefix { prefix = outer.prefix, path = x.path },
            handler = x.handler,
          },
        },
      },
    }),

  ## Fold this group into a route table. First added wins.
  table = { it: 'it } -> fold_entries { g = it },

  ## Close the group, answering anything unmatched with 404.
  # The only answer a table has for a request it does not match, so requiring
  # every group to spell out a fallback is ceremony. `otherwise` says otherwise.
  handler = { it: 'it } ->
    otherwise { routes = fold_entries { g = it }, fallback = { req } -> not_found { body = "no route matched" } },

  ## Close the group with a fallback, producing the handler `serve` takes.
  otherwise = { it: 'it, fallback: { req: Request } -> Response <Exception? having 'error = Response, ...> } ->
    otherwise { routes = fold_entries { g = it }, fallback = fallback },
}

# A route table is a LIST, and reads like one:
#
#   let app = routes { of = [
#     on_get    { path = "/ping",      handler = { m } -> "pong" },
#     on_post   { path = "/users",     handler = { m } -> created { body = "made" } },
#     on_get    { path = "/users/:id", handler = catching { handler = show } },
#   ] }.otherwise { fallback = fallback }
#
# rather than the first route bare and every later one wrapped in
# `.or_else { b = … }`. First match still wins, so order is still the priority.
#
# This is a free function taking a seq, NOT a chain of `.get {}.post {}`
# methods on Routes. I built the chain first and it does not work: those
# methods need `with IntoResponse 'r`, and a constraint on an inherent impl
# method does not get its dictionary — the call silently selects
# `impl IntoResponse for Str`, hands it a Response and dies in a native
# (`Expected String for field 's'`). The known `with C 'a` dict-plumbing
# family again. Here every constraint stays on the free `on_*`/`try_*`
# functions, where it already works, and this only folds finished Routes.
## Fold routes into one table; the first to match wins.
pub let routes: { of: [Routes] } -> Routes = { of } ->
  seq::fold {
    xs = of,
    init = { run = { req } -> None },
    f = { acc, x } -> or_else { a = acc, b = x },
  }

## Try `a`, then `b`. First match wins, so declaration order is the priority.
##
## Named `or_else`, not `or`: `or` is the infix boolean operator's name and the
## parser does not take it as a plain identifier here.
pub let or_else: { a: Routes, b: Routes } -> Routes = { a, b } -> {
  run = { req } -> match a.run { req = req } is
    Some { val } -> Some { val = val }
    None -> b.run { req = req },
}

## Close the table: everything unmatched goes to `fallback`.
##
## The result is a plain function, which is exactly what `HttpServer.serve`
## takes — the route table has disappeared by this point.
## A fallback may THROW its Response too, for the same reason a handler may:
## written bare, the slot absorbed the thrown type unchecked and the mistake
## surfaced on the wire. `catching` is not reusable here because its handler
## takes a `Matched`, and a fallback takes the unmatched `Request`.
pub let otherwise
  : { routes: Routes, fallback: { req: Request } -> Response <Exception? having 'error = Response, ...> }
  -> { req: Request } -> Response <...>
  =
  { routes, fallback } -> { req } -> match routes.run { req = req } is
    Some { val } -> val
    None -> do
      let outcome = perform ExceptionToResult in Ok { val = fallback { req = req } }
      match outcome is
        Ok { val } -> val
        Err { error } -> error

## ── Query parameters ────────────────────────────────────────────────────────

## Parse a request target's query into its parameters.
##
## Repeated keys COLLECT: `?tags=a&tags=b` gives `tags` two values. That is the
## encoding `with_query`'s `QList` produces and the one the widest range of
## servers parse, so the two halves of the story agree on it.
##
## A fragment with no `=` is a key with one empty value, which is how a flag
## like `?debug` arrives. Keys and values are percent-decoded.
pub let query_params: { url: Str } -> Map Str [Str] = { url } ->
  ## `iter`, not `seq`: the fold is the only consumer, so the filtered fragments
  ## never need to exist as a collection. Filtering eagerly built one for the
  ## fold to walk once and drop.
  iter::fold {
    it = iter::filter {
      it = iter::from_seq { xs = str::split { s = query_of { url = url }, delimiter = "&" } },
      p = { x } -> x != "",
    },
    init = map::empty {},
    f = { acc, x } -> do
      let cut = str::index_of { s = x, sub = "=" }
      let k = match cut is
        None -> url_decode_component { s = x }
        Some { val = i } -> url_decode_component { s = str::substring { s = x, start = 0, end = i } }
      let v = match cut is
        None -> ""
        Some { val = i } ->
          url_decode_component { s = str::substring { s = x, start = i + 1, end = str::size { s = x } } }
      let prior = match map::get { m = acc, k = k } is
        Some { val } -> val
        None -> []
      map::insert { m = acc, k = k, v = seq::push { xs = prior, x = v } },
  }

## Every value a query gave for `name`, in the order they appeared. No such key
## is the empty sequence, not an error — a parameter nobody sent and a
## parameter sent zero times are the same thing to a handler.
pub let query_all: { url: Str, name: Str } -> [Str] = { url, name } ->
  match map::get { m = query_params { url = url }, k = name } is
    Some { val } -> val
    None -> []

## The FIRST value a query gave for `name`.
##
## First, not last, and not an error on a repeat: a handler that wants one
## value should not have to care that a client sent two, and the first is what
## a reader of the URL would say it is.
pub let query_param: { url: Str, name: Str } -> Option Str = { url, name } ->
  seq::first { xs = query_all { url = url, name = name } }

## The query, decoded into whatever the use site asks for.
##
## The exact mirror of the client's `with_query`: a record goes out as a query,
## and the same record shape comes back here. Target-directed, so the type
## comes from the annotation at the use site and no schema is declared.
##
##   let page: Result { q: Str, page: Int } DecodeError = query_decoded { url = req.url }
##
## `FromQuery` is re-exported from this module, and a `pub use` carries the
## instance as well as the name — so importing anything from here is enough to
## call this.
## What the request carried where something else was wanted.
##
## Decoding a path parameter or a query is the one failure a handler meets
## without asking for it: it reads what the caller sent, and what the caller
## sent is whatever they liked.
pub type BadInput = {
  at: [Str],
  message: Str,
  expected: Str,
  found: Option Str,
}

# The codec's DecodeError says the same thing, and an impl for it would be the
# obvious move — but it reaches this module under a `use … as` alias, and an
# impl whose target arrived aliased registers under the LOCAL spelling and
# never matches the declaration. So the router states its own input error,
# which is better anyway: it knows the parameter's NAME, which a scalar
# decode's empty path does not.
let bad_input_of: { e: DecodeError, at: [Str] } -> BadInput = { e, at } -> {
  at = if seq::is_empty { xs = e.path } then at else e.path,
  message = e.message,
  expected = e.expected,
  found = e.found,
}

## 400, naming where, what was wanted and what arrived.
# A 400 whose body is only "bad request" sends the caller to read the route's
# source.
impl IntoErrorResponse for BadInput where {
  into_error_response = { it } -> do
    let where_ = if seq::is_empty { xs = it.at } then ""
      else str::concat { l = str::join { strings = it.at, separator = "." }, r = ": " }
    let got = match it.found is
      Some { val } -> str::concat { l = ", found ", r = val }
      None -> ""
    response_status {
      code = 400,
      body = str::concat {
        l = where_,
        r = str::concat { l = str::concat { l = "expected ", r = it.expected }, r = got },
      },
    },
}

pub let query_decoded = { url: Str } ->
  match query_of { url = url }.from_query {} is
    Ok { val } -> Ok { val = val }
    Err { error = e } -> Err { error = bad_input_of { e = e, at = [] } }

## One value, decoded into whatever the use site asks for.
#
# A path parameter is a Str, so a handler wanting `/users/:id` as an Int parsed
# it by hand. No new ability is needed for that: QueryC already decodes a
# SCALAR, and a scalar is a pair whose key is relative to nothing — `k = ""`.
# So one value is a one-pair list, and the existing
# `impl FromQuery 'a for [{ k: Str, v: Str }]` does the rest, which is why this
# gets Int, Bool, a newtype and anything else with a QueryC decoder for free.
pub let one_decoded = { v: Str, at: [Str] } ->
  match [{ k = "", v = v }].from_query {} is
    Ok { val } -> Ok { val = val }
    Err { error = e } -> Err { error = bad_input_of { e = e, at = at } }

## The error for a name the route never bound.
let no_such_param: { name: Str } -> BadInput = { name } -> {
  at = [name],
  message = "the route bound no parameter by this name",
  expected = "a path parameter the pattern declares",
  found = None,
}

## ── Dot-chaining surface ──────────────────────────────────────────────────
##
## Inherent impls on the two types this module declares, so a route table reads
## as a chain instead of a nest. These are legal here precisely because `Routes`
## and `Matched` are declared in this module — an inherent impl must live with
## its type.
##
##   route { method = Get, path = "/users/:id", handler = { m } ->
##     m.ok { text = m.param_or { name = "id", default = "?" } } }
##     .or_else { b = route { method = Post, path = "/users",
##                            handler = { m } -> m.reply { status = 201, text = "created" } } }
##     .otherwise { fallback = not_found }

impl Routes where {
  ## Try this table, then `b`. First match wins.
  or_else = { it: 'it, b: Routes } -> or_else { a = it, b = b },

  ## Close the table with a fallback, producing the handler `serve` takes.
  otherwise = { it: 'it, fallback: { req: Request } -> Response <Exception? having 'error = Response, ...> } ->
    otherwise { routes = it, fallback = fallback },
}

impl Matched where {
  ## A bound path parameter, if the pattern bound one by that name.
  param = { it: 'it, name: Str } -> map::get { m = it.params, k = name },
  ## The first value the query gave for `name`.
  query = { it: 'it, name: Str } -> query_param { url = it.req.url, name = name },
  ## The first value the query gave for `name`, or `default`.
  query_or = { it: 'it, name: Str, default: Str } ->
    match query_param { url = it.req.url, name = name } is
      Some { val } -> val
      None -> default,
  ## Every value the query gave for `name`.
  query_all = { it: 'it, name: Str } -> query_all { url = it.req.url, name = name },
  ## The query, decoded into whatever the use site asks for.
  query_as = { it } -> query_decoded { url = it.req.url },
  ## A bound path parameter, decoded into whatever the use site asks for.
  ##
  ##   let show = { id: Int } -> …
  ##   .get { path = "/users/:id", handler = { m } -> match m.param_as { name = "id" } is
  ##     Ok { val } -> show { id = val }
  ##     Err { error = _ } -> bad_request { body = "id must be a number" } }
  param_as = { it: 'it, name: Str } -> match map::get { m = it.params, k = name } is
    Some { val } -> one_decoded { v = val, at = [name] }
    None -> Err { error = no_such_param { name = name } },

  ## A bound path parameter, or `default` when the pattern bound none.
  ##
  ## Most handlers want this: a `:name` in the pattern always binds, so the
  ## `None` arm is unreachable for a parameter the route itself declared, and
  ## making every handler write the match obscured the interesting line.
  param_or = { it: 'it, name: Str, default: Str } ->
    match map::get { m = it.params, k = name } is
      Some { val } -> val
      None -> default,
  ## A 200 carrying `text`, with the request's own url echoed back.
  ok = { it: 'it, text: Str } -> {
    status = 200,
    headers = map::empty {},
    body = bytes::from_str { s = text },
    url = it.req.url,
    chunks = None,
  },
  ## Any status carrying `text`.
  reply = { it: 'it, status: Int, text: Str } -> {
    status = status,
    headers = map::empty {},
    body = bytes::from_str { s = text },
    url = it.req.url,
    chunks = None,
  },
}
