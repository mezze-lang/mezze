# std/stm.mezze - Software Transactional Memory
#
# STM provides composable, lock-free concurrent programming with transactions.
# All reads and writes to shared memory happen atomically within transactions.
#
# Key features:
# - Optimistic concurrency: transactions run in parallel, retry on conflict
# - Composability: transactions can be nested and combined
# - No deadlocks: no locks means no deadlock cycles
# - Retry: block until watched TVars change
# - OrElse: try alternatives if first transaction retries
#
# Implementation uses:
# - Multi-Version Concurrency Control (MVCC) for snapshot isolation
# - Bloom filters for fast conflict detection
# - Optimistic reads with validation at commit time
#
# Available implementations:
# - OptimisticSTM: Default, uses virtual threads for blocking operations
# - SequentialSTM: Single-threaded, for testing/debugging
#
# Usage:
#   use std::effects::stm::{STM, OptimisticSTM, TVar, tvar}
#
#   let account = tvar {init = 1000}
#
#   perform OptimisticSTM in do
#       let balance = STM.read {var = account}
#       STM.write {var = account, val = balance - 100}

# TVar - Transactional Variable
# A mutable reference that can only be read/written inside transactions.
# Outside transactions, use tvar to create and deref to read (without consistency).
pub newtype TVar 'a = TVar __NativeTVar

# Create a new TVar with an initial value
#
# Example:
#   let counter = tvar {init = 0}
#   let accounts = tvar {init = {alice = 1000, bob = 500}}
pub let tvar: {init: 'a} -> TVar 'a =
    {init} -> __native_tvar_new {init = init}

# Read TVar value outside of transaction (non-transactional)
# WARNING: This read is NOT part of any transaction!
# Use only for debugging or when you don't need consistency.
#
# Example:
#   let current = deref {var = account}  # Non-transactional read
pub let deref: {var: TVar 'a} -> 'a =
    {var} -> __native_tvar_deref {var = var}

# STM effect - Transactional operations
effect STM where {
    # Read a TVar's value within the transaction
    # Tracked for conflict detection at commit time
    #
    # Example:
    #   let balance = STM.read {var = account}
    read: {var: TVar 'a} -> 'a <STM>,

    # Write a value to a TVar within the transaction
    # Buffered until commit, visible to subsequent reads in same transaction
    #
    # Example:
    #   STM.write {var = account, val = 500}
    write: {var: TVar 'a, val: 'a} -> {} <STM>,

    # Read, apply function, write back - all atomically
    # Equivalent to: let v = read; write {val = f {val = v}}
    #
    # Example:
    #   STM.modify {var = counter, f = {val} -> val + 1}
    modify: {var: TVar 'a, f: {val: 'a} -> 'a} -> {} <STM>,

    # Write new value, return old value
    # Equivalent to: let old = read; write {val = new}; old
    #
    # Example:
    #   let old_balance = STM.swap {var = account, val = 0}
    swap: {var: TVar 'a, val: 'a} -> 'a <STM>,

    # Mark TVar as protected from outside modification
    # If another transaction modifies this TVar, current transaction retries.
    # Returns current value. Use when you need strong consistency on reads.
    #
    # Example:
    #   let balance = STM.ensure {var = account}  # Protected read
    ensure: {var: TVar 'a} -> 'a <STM>,

    # Retry current transaction until a watched TVar changes
    # All TVars read so far are "watched" - transaction restarts when any changes.
    #
    # Example:
    #   let balance = STM.read {var = account}
    #   match balance < amount is
    #       True -> STM.retry {}  # Wait for more funds
    #       False -> STM.write {var = account, val = balance - amount}
    retry: {} -> 'a <STM>,

    # Try first alternative, if it retries, run second
    # Combines two STM computations with fallback semantics.
    #
    # Example:
    #   STM.or_else {
    #       primary = {} -> withdraw {from = checking, amount = 100},
    #       fallback = {} -> withdraw {from = savings, amount = 100}
    #   }
    or_else: {primary: {} -> 'a <STM>, fallback: {} -> 'a <STM>} -> 'a <STM>,

    # Retry if condition is false
    # Equivalent to: match cond is True -> {} | False -> retry {}
    #
    # Example:
    #   STM.check {cond = balance >= amount}
    check: {cond: Bool} -> {} <STM>
}

# =============================================================================
# OptimisticSTM Implementation - Default
# =============================================================================
#
# Uses optimistic concurrency with MVCC and bloom filter conflict detection.
# Transactions run in parallel and validate at commit time.
# On conflict, transactions automatically retry with fresh data.
#
# Blocking operations (retry) use virtual threads to wait efficiently.
#
# Example:
#   perform OptimisticSTM in do
#       let balance = STM.read {var = account}
#       STM.write {var = account, val = balance + deposit}

pub impl STM for OptimisticSTM where {
    read = {var} -> __native_stm_read {var = var},
    write = {var, val} -> __native_stm_write {var = var, val = val},
    modify = {var, f} -> __native_stm_modify {var = var, f = f},
    swap = {var, val} -> __native_stm_swap {var = var, val = val},
    ensure = {var} -> __native_stm_ensure {var = var},
    retry = {} -> __native_stm_retry {},
    or_else = {primary, fallback} -> __native_stm_or_else {primary = primary, fallback = fallback},
    check = {cond} -> __native_stm_check {cond = cond}
}

# =============================================================================
# OptimisticSTMWith Implementation - Configurable
# =============================================================================
#
# Like OptimisticSTM but with tuning parameters.
#
# Parameters:
#   max_retries: Maximum automatic retries before failing (0 = unlimited)
#   spin_count: Spins before parking thread on retry (higher = more CPU, lower latency)
#
# Example:
#   perform OptimisticSTMWith {max_retries = 100, spin_count = 10} in do
#       STM.read {var = account}

pub impl STM for OptimisticSTMWith { max_retries: Int, spin_count: Int } where {
    read = {var} -> __native_stm_read_cfg {var = var, max_retries = max_retries, spin_count = spin_count},
    write = {var, val} -> __native_stm_write_cfg {var = var, val = val, max_retries = max_retries, spin_count = spin_count},
    modify = {var, f} -> __native_stm_modify_cfg {var = var, f = f, max_retries = max_retries, spin_count = spin_count},
    swap = {var, val} -> __native_stm_swap_cfg {var = var, val = val, max_retries = max_retries, spin_count = spin_count},
    ensure = {var} -> __native_stm_ensure_cfg {var = var, max_retries = max_retries, spin_count = spin_count},
    retry = {} -> __native_stm_retry_cfg {max_retries = max_retries, spin_count = spin_count},
    or_else = {primary, fallback} -> __native_stm_or_else_cfg {primary = primary, fallback = fallback, max_retries = max_retries, spin_count = spin_count},
    check = {cond} -> __native_stm_check_cfg {cond = cond, max_retries = max_retries, spin_count = spin_count}
}

# =============================================================================
# SequentialSTM Implementation - Single-Threaded
# =============================================================================
#
# Executes transactions sequentially, no parallelism.
# Useful for testing and debugging STM code.
#
# Example:
#   perform SequentialSTM in do
#       STM.read {var = account}

pub impl STM for SequentialSTM where {
    read = {var} -> __native_stm_seq_read {var = var},
    write = {var, val} -> __native_stm_seq_write {var = var, val = val},
    modify = {var, f} -> __native_stm_seq_modify {var = var, f = f},
    swap = {var, val} -> __native_stm_seq_swap {var = var, val = val},
    ensure = {var} -> __native_stm_seq_ensure {var = var},
    retry = {} -> __native_stm_seq_retry {},
    or_else = {primary, fallback} -> __native_stm_seq_or_else {primary = primary, fallback = fallback},
    check = {cond} -> __native_stm_seq_check {cond = cond}
}

# =============================================================================
# Helper Functions
# =============================================================================

# Run a transaction and return the result
# Convenience wrapper that runs perform automatically
#
# Example:
#   let balance = atomically {f = {} -> STM.read {var = account}}
pub let atomically: {f: {} -> 'a <STM>} -> 'a =
    {f} -> perform OptimisticSTM in f {}

# Transfer amount from one TVar to another
# Returns True if successful, False if insufficient funds
#
# Example:
#   let success = transfer {from = alice, to = bob, amount = 100}
pub let transfer: {from: TVar Int, to: TVar Int, amount: Int} -> Bool <STM> =
    {from, to, amount} -> do
        let from_balance = STM.read {var = from}
        match from_balance >= amount is
            True -> do
                STM.write {var = from, val = from_balance - amount}
                let to_balance = STM.read {var = to}
                STM.write {var = to, val = to_balance + amount}
                True
            False -> False

# Transfer or block until sufficient funds
# Uses retry to wait for funds if insufficient
#
# Example:
#   transfer_or_wait {from = alice, to = bob, amount = 100}
pub let transfer_or_wait: {from: TVar Int, to: TVar Int, amount: Int} -> {} <STM> =
    {from, to, amount} -> do
        let from_balance = STM.read {var = from}
        STM.check {cond = from_balance >= amount}
        STM.write {var = from, val = from_balance - amount}
        let to_balance = STM.read {var = to}
        STM.write {var = to, val = to_balance + amount}

# Read multiple TVars atomically, returns list
pub let read_all: {vars: [TVar 'a]} -> ['a] <STM> =
    {vars} -> __native_stm_read_all {vars = vars}

# Write to multiple TVars atomically
pub let write_all: {pairs: [{var: TVar 'a, val: 'a}]} -> {} <STM> =
    {pairs} -> __native_stm_write_all {pairs = pairs}

# =============================================================================
# TMVar - Blocking Transactional Variable
# =============================================================================
#
# TMVar is like a TVar that can be empty or full.
# - take: blocks if empty, returns value and empties the TMVar
# - put: blocks if full, fills the TMVar with a value
# - read: blocks if empty, returns value without taking it
#
# This is useful for:
# - Synchronization (handoff between threads)
# - One-shot events
# - Locks (empty = locked, full = unlocked)
#
# Implementation: TMVar is a TVar holding Option 'a
#
# Example:
#   let mvar = tmvar_empty {}
#
#   # Thread 1: puts a value
#   STM.put_tmvar {var = mvar, val = 42}
#
#   # Thread 2: takes the value (blocks until available)
#   let value = STM.take_tmvar {var = mvar}

# TMVar type - a TVar that can be empty or full
pub newtype TMVar 'a = TMVar (TVar (Option 'a))

# Internal helper to unwrap the TMVar to get the underlying TVar
let unwrap_tmvar: {var: TMVar 'a} -> TVar (Option 'a) =
    {var} -> match var is
        TMVar {val} -> val

# Create an empty TMVar
#
# Example:
#   let mvar = tmvar_empty {}
pub let tmvar_empty: {} -> TMVar 'a =
    {} -> do
        let inner = tvar {init = None}
        TMVar {val = inner}

# Create a TMVar with an initial value
#
# Example:
#   let mvar = tmvar {init = 42}
pub let tmvar: {init: 'a} -> TMVar 'a =
    {init} -> do
        let inner = tvar {init = Some {val = init}}
        TMVar {val = inner}

# Take a value from a TMVar, leaving it empty
# Blocks (retries) if the TMVar is empty
#
# Example:
#   let value = STM.take_tmvar {var = mvar}
pub let take_tmvar: {var: TMVar 'a} -> 'a <STM> =
    {var} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val} -> do
                STM.write {var = inner, val = None}
                val
            None -> STM.retry {}

# Put a value into a TMVar
# Blocks (retries) if the TMVar is already full
#
# Example:
#   STM.put_tmvar {var = mvar, val = 42}
pub let put_tmvar: {var: TMVar 'a, val: 'a} -> {} <STM> =
    {var, val} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val = _} -> STM.retry {}
            None -> STM.write {var = inner, val = Some {val = val}}

# Read a value from a TMVar without taking it
# Blocks (retries) if the TMVar is empty
#
# Example:
#   let value = STM.read_tmvar {var = mvar}
pub let read_tmvar: {var: TMVar 'a} -> 'a <STM> =
    {var} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val} -> val
            None -> STM.retry {}

# Try to take a value from a TMVar
# Returns None immediately if empty (doesn't block)
#
# Example:
#   match STM.try_take_tmvar {var = mvar} is
#       Some {val} -> use_value {v = val}
#       None -> handle_empty {}
pub let try_take_tmvar: {var: TMVar 'a} -> Option 'a <STM> =
    {var} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val} -> do
                STM.write {var = inner, val = None}
                Some {val = val}
            None -> None

# Try to put a value into a TMVar
# Returns False immediately if full (doesn't block)
#
# Example:
#   let success = STM.try_put_tmvar {var = mvar, val = 42}
pub let try_put_tmvar: {var: TMVar 'a, val: 'a} -> Bool <STM> =
    {var, val} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val = _} -> False
            None -> do
                STM.write {var = inner, val = Some {val = val}}
                True

# Swap the contents of a TMVar
# Takes the current value and puts a new one atomically
# Blocks if empty
#
# Example:
#   let old = STM.swap_tmvar {var = mvar, val = new_value}
pub let swap_tmvar: {var: TMVar 'a, val: 'a} -> 'a <STM> =
    {var, val} -> do
        let old = take_tmvar {var = var}
        put_tmvar {var = var, val = val}
        old

# Check if a TMVar is empty
#
# Example:
#   let empty = STM.is_empty_tmvar {var = mvar}
pub let is_empty_tmvar: {var: TMVar 'a} -> Bool <STM> =
    {var} -> do
        let inner = unwrap_tmvar {var = var}
        let contents = STM.read {var = inner}
        match contents is
            Some {val = _} -> False
            None -> True

# =============================================================================
# TQueue - Unbounded STM Queue
# =============================================================================
#
# TQueue is an unbounded FIFO queue that can be used within STM transactions.
# This enables composing queue operations with other STM operations atomically.
#
# Key operations:
# - write_tqueue: add an element to the end
# - read_tqueue: remove and return the first element (blocks if empty)
# - try_read_tqueue: non-blocking read that returns Option
# - peek_tqueue: read without removing (blocks if empty)
# - is_empty_tqueue: check if queue is empty
#
# Implementation: Uses two lists (front/back) for O(1) amortized operations.
# Based on Haskell's Data.TQueue implementation.
#
# Example:
#   let queue = tqueue {}
#
#   perform OptimisticSTM in do
#       write_tqueue {q = queue, val = "first"}
#       write_tqueue {q = queue, val = "second"}
#       let first = read_tqueue {q = queue}  # "first"

# TQueue type - stores items in two lists for O(1) enqueue/dequeue
# read: items to be dequeued (reversed)
# write: items recently enqueued
pub newtype TQueue 'a = TQueue (TVar {read: List 'a, write: List 'a})

# Internal helper to unwrap TQueue
let unwrap_tqueue: {q: TQueue 'a} -> TVar {read: List 'a, write: List 'a} =
    {q} -> match q is
        TQueue {val} -> val

# Create a new empty TQueue
#
# Example:
#   let queue = tqueue {}
pub let tqueue: {} -> TQueue 'a =
    {} -> do
        let empty_list = __native_list_empty {}
        let inner = tvar {init = {read = empty_list, write = empty_list}}
        TQueue {val = inner}

# Create a new TQueue from a list
#
# Example:
#   let queue = tqueue_from_list {items = [1, 2, 3]}
pub let tqueue_from_list: {items: List 'a} -> TQueue 'a =
    {items} -> do
        let empty_list = __native_list_empty {}
        let inner = tvar {init = {read = items, write = empty_list}}
        TQueue {val = inner}

# Write a value to the end of the queue
#
# Example:
#   write_tqueue {q = queue, val = 42}
pub let write_tqueue: {q: TQueue 'a, val: 'a} -> {} <STM> =
    {q, val} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        let new_write = __native_list_cons {head = val, tail = state.write}
        STM.write {var = inner, val = {read = state.read, write = new_write}}

# Read and remove a value from the front of the queue
# Blocks (retries) if the queue is empty
#
# Example:
#   let value = read_tqueue {q = queue}
pub let read_tqueue: {q: TQueue 'a} -> 'a <STM> =
    {q} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> do
                STM.write {var = inner, val = {read = pair.tail, write = state.write}}
                pair.head
            None -> match __native_list_is_empty {xs = state.write} is
                True -> STM.retry {}
                False -> do
                    # Reverse write list into read list
                    let reversed = __native_list_reverse {xs = state.write}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> do
                            STM.write {var = inner, val = {read = pair.tail, write = empty_list}}
                            pair.head
                        None -> STM.retry {}

# Try to read from the queue without blocking
# Returns None if empty
#
# Example:
#   match try_read_tqueue {q = queue} is
#       Some {val} -> use_value {v = val}
#       None -> queue_is_empty {}
pub let try_read_tqueue: {q: TQueue 'a} -> Option 'a <STM> =
    {q} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> do
                STM.write {var = inner, val = {read = pair.tail, write = state.write}}
                Some {val = pair.head}
            None -> match __native_list_is_empty {xs = state.write} is
                True -> None
                False -> do
                    let reversed = __native_list_reverse {xs = state.write}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> do
                            STM.write {var = inner, val = {read = pair.tail, write = empty_list}}
                            Some {val = pair.head}
                        None -> None

# Peek at the first value without removing it
# Blocks (retries) if empty
#
# Example:
#   let first = peek_tqueue {q = queue}
pub let peek_tqueue: {q: TQueue 'a} -> 'a <STM> =
    {q} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> pair.head
            None -> match __native_list_is_empty {xs = state.write} is
                True -> STM.retry {}
                False -> do
                    let reversed = __native_list_reverse {xs = state.write}
                    # Write back the normalized form for future reads
                    STM.write {var = inner, val = {read = reversed, write = empty_list}}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> pair.head
                        None -> STM.retry {}

# Check if the queue is empty
#
# Example:
#   let empty = is_empty_tqueue {q = queue}
pub let is_empty_tqueue: {q: TQueue 'a} -> Bool <STM> =
    {q} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        match __native_list_is_empty {xs = state.read} is
            True -> __native_list_is_empty {xs = state.write}
            False -> False

# Get the current length of the queue
# Note: This requires traversing both lists, O(n)
#
# Example:
#   let len = length_tqueue {q = queue}
pub let length_tqueue: {q: TQueue 'a} -> Int <STM> =
    {q} -> do
        let inner = unwrap_tqueue {q = q}
        let state = STM.read {var = inner}
        __native_list_length {xs = state.read} + __native_list_length {xs = state.write}

# =============================================================================
# TBQueue - Bounded STM Queue
# =============================================================================
#
# TBQueue is a bounded FIFO queue with a maximum capacity.
# write_tbqueue blocks if the queue is at capacity.
#
# Useful when you need backpressure - producers will wait when
# the queue is full rather than consuming unlimited memory.
#
# Example:
#   let queue = tbqueue {capacity = 10}
#
#   # Producer
#   perform OptimisticSTM in do
#       write_tbqueue {q = queue, val = item}  # blocks if queue has 10 items
#
#   # Consumer
#   perform OptimisticSTM in do
#       let item = read_tbqueue {q = queue}    # blocks if queue is empty

# TBQueue type - bounded queue with capacity
pub newtype TBQueue 'a = TBQueue (TVar {read: List 'a, write: List 'a, size: Int, capacity: Int})

# Internal helper to unwrap TBQueue
let unwrap_tbqueue: {q: TBQueue 'a} -> TVar {read: List 'a, write: List 'a, size: Int, capacity: Int} =
    {q} -> match q is
        TBQueue {val} -> val

# Create a new empty bounded queue with given capacity
#
# Example:
#   let queue = tbqueue {capacity = 100}
pub let tbqueue: {capacity: Int} -> TBQueue 'a =
    {capacity} -> do
        let empty_list = __native_list_empty {}
        let inner = tvar {init = {read = empty_list, write = empty_list, size = 0, capacity = capacity}}
        TBQueue {val = inner}

# Write a value to the bounded queue
# Blocks (retries) if queue is at capacity
#
# Example:
#   write_tbqueue {q = queue, val = 42}
pub let write_tbqueue: {q: TBQueue 'a, val: 'a} -> {} <STM> =
    {q, val} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        match state.size >= state.capacity is
            True -> STM.retry {}  # Queue is full, wait
            False -> do
                let new_write = __native_list_cons {head = val, tail = state.write}
                STM.write {var = inner, val = {
                    read = state.read,
                    write = new_write,
                    size = state.size + 1,
                    capacity = state.capacity
                }}

# Read and remove a value from the bounded queue
# Blocks (retries) if empty
#
# Example:
#   let value = read_tbqueue {q = queue}
pub let read_tbqueue: {q: TBQueue 'a} -> 'a <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> do
                STM.write {var = inner, val = {
                    read = pair.tail,
                    write = state.write,
                    size = state.size - 1,
                    capacity = state.capacity
                }}
                pair.head
            None -> match __native_list_is_empty {xs = state.write} is
                True -> STM.retry {}  # Queue is empty
                False -> do
                    let reversed = __native_list_reverse {xs = state.write}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> do
                            STM.write {var = inner, val = {
                                read = pair.tail,
                                write = empty_list,
                                size = state.size - 1,
                                capacity = state.capacity
                            }}
                            pair.head
                        None -> STM.retry {}

# Try to read from bounded queue without blocking
#
# Example:
#   match try_read_tbqueue {q = queue} is
#       Some {val} -> process {v = val}
#       None -> queue_empty {}
pub let try_read_tbqueue: {q: TBQueue 'a} -> Option 'a <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> do
                STM.write {var = inner, val = {
                    read = pair.tail,
                    write = state.write,
                    size = state.size - 1,
                    capacity = state.capacity
                }}
                Some {val = pair.head}
            None -> match __native_list_is_empty {xs = state.write} is
                True -> None
                False -> do
                    let reversed = __native_list_reverse {xs = state.write}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> do
                            STM.write {var = inner, val = {
                                read = pair.tail,
                                write = empty_list,
                                size = state.size - 1,
                                capacity = state.capacity
                            }}
                            Some {val = pair.head}
                        None -> None

# Try to write to bounded queue without blocking
# Returns True if successful, False if queue is full
#
# Example:
#   let success = try_write_tbqueue {q = queue, val = 42}
pub let try_write_tbqueue: {q: TBQueue 'a, val: 'a} -> Bool <STM> =
    {q, val} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        match state.size >= state.capacity is
            True -> False  # Queue is full
            False -> do
                let new_write = __native_list_cons {head = val, tail = state.write}
                STM.write {var = inner, val = {
                    read = state.read,
                    write = new_write,
                    size = state.size + 1,
                    capacity = state.capacity
                }}
                True

# Peek at first value without removing it
# Blocks if empty
#
# Example:
#   let first = peek_tbqueue {q = queue}
pub let peek_tbqueue: {q: TBQueue 'a} -> 'a <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        let empty_list = __native_list_empty {}
        match __native_list_uncons {xs = state.read} is
            Some {val = pair} -> pair.head
            None -> match __native_list_is_empty {xs = state.write} is
                True -> STM.retry {}
                False -> do
                    let reversed = __native_list_reverse {xs = state.write}
                    STM.write {var = inner, val = {
                        read = reversed,
                        write = empty_list,
                        size = state.size,
                        capacity = state.capacity
                    }}
                    match __native_list_uncons {xs = reversed} is
                        Some {val = pair} -> pair.head
                        None -> STM.retry {}

# Check if bounded queue is empty
#
# Example:
#   let empty = is_empty_tbqueue {q = queue}
pub let is_empty_tbqueue: {q: TBQueue 'a} -> Bool <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        state.size == 0

# Check if bounded queue is full
#
# Example:
#   let full = is_full_tbqueue {q = queue}
pub let is_full_tbqueue: {q: TBQueue 'a} -> Bool <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        state.size >= state.capacity

# Get current size of bounded queue (O(1))
#
# Example:
#   let size = size_tbqueue {q = queue}
pub let size_tbqueue: {q: TBQueue 'a} -> Int <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        state.size

# Get capacity of bounded queue (O(1))
#
# Example:
#   let cap = capacity_tbqueue {q = queue}
pub let capacity_tbqueue: {q: TBQueue 'a} -> Int <STM> =
    {q} -> do
        let inner = unwrap_tbqueue {q = q}
        let state = STM.read {var = inner}
        state.capacity
