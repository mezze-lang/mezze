# std/effects/inspect.mezze - Inspect ability for converting values to strings

# Inspect is a special ability that is available for ALL types
# It's automatically implemented for all types (similar to Debug in Rust)
# NOTE: This is an ABILITY, not an effect! Abilities are always available without imports.
ability Inspect 'a where {
    to_str: { val: 'a } -> String
}

# Universal implementation - works for any type
# This is automatically available without needing a performer
pub impl Inspect for Universal where {
    to_str: { val: 'a } -> String = { val } -> __native_inspect_to_str { val = val }
}
