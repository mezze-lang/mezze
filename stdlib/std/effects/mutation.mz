# =============================================================================
# Looping - Imperative loops for mutation
# =============================================================================

# Loop while condition is true - built on Mut.loop primitive
pub let while: {cond: {} -> Bool <Mut>, body: {} -> {} <Mut>} -> {} <Mut> = {cond, body} ->
    Mut.loop {cond = cond, body = body}

# Loop with index from start to end (exclusive) with step
# Built on top of while using MutInt for the loop counter
pub let for_range: {start: Int, end: Int, step: Int, body: {i: Int} -> {} <Mut>} -> {} <Mut> = {start, end, step, body} -> do
    let i = int_to_mut {n = start}
    while {
        cond = {} -> do
            let current = read_int {n = i}
            if step > 0 then current < end else current > end,
        body = {} -> do
            let current = read_int {n = i}
            body {i = current}
            incr {n = i, delta = step}
    }

# Convenience: for_range with step = 1
pub let for_range1: {start: Int, end: Int, body: {i: Int} -> {} <Mut>} -> {} <Mut> = {start, end, body} ->
    for_range {start = start, end = end, step = 1, body = body}

# =============================================================================
# Convenience: Create with initial capacity
# =============================================================================

pub let seq_with_capacity: {capacity: Int} -> MutSeq 'a <Mut> = {capacity} ->
    Mut.mutate {act = {} -> __native_mut_seq_with_capacity {capacity = capacity}}
