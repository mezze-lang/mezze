# =============================================================================
# Mutable Ability - Operations on Mutable Containers
# =============================================================================

# The Mutable ability defines operations for in-place mutation.
# All operations have the <Mutation> effect.
ability Mutable 'c having 'elem where {
    # Get element at index (returns Option for bounds safety)
    get: {c: 'c, i: Int} -> Option 'elem <Mutation>,

    # Set element at index (returns True if in bounds)
    set: {c: 'c, i: Int, v: 'elem} -> Bool <Mutation>,

    # Get length
    len: {c: 'c} -> Int <Mutation>,

    # Swap elements at two indices
    swap: {c: 'c, i: Int, j: Int} -> Bool <Mutation>
}

