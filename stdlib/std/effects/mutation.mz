use std::int

## Safe in-place mutation effect with loop support.
effect Mut where {
  ## Wrap an act to mark it as performing mutation.
  mutate: { act: {} -> 'a } -> 'a <Mut>,
  ## Imperative loop with mutable condition and body.
  loop: { cond: {} -> Bool <Mut>, body: {} -> {} <Mut> } -> {} <Mut>
}

## Production handler -- mutations run directly on memory.
## Safety is enforced by the type system (hermetic rule), not runtime checks.
impl Mut for LocalMut where {
  mutate = { act } -> act {},
  loop = { cond, body } -> __native_mutation_loop { cond = cond, body = body },
}

## Debug handler that logs mutation operations via content-hash addressing.
impl Mut for DebugLocalMut where {
  mutate = { act } -> __native_debug_mutation_mutate { act = act },
  loop = { cond, body } -> __native_debug_mutation_loop { cond = cond, body = body },
}

## Mutable sequence wrapping a native mutable array.
pub newtype MutSeq 'a = __NativeMutSeq

## Mutable map wrapping a native mutable hash map.
pub newtype MutMap 'k 'v = __NativeMutMap

## Mutable set wrapping a native mutable hash set.
pub newtype MutSet 'a = __NativeMutSet

## Mutable byte array.
pub newtype MutBytes = __NativeMutBytes

## Mutable double-ended queue.
pub newtype MutDeque 'a = __NativeMutDeque

## Mutable Int for counters and accumulators.
pub newtype MutInt = __NativeMutInt

## Mutable Float for accumulators.
pub newtype MutFloat = __NativeMutFloat

## Mutable Bool for flags.
pub newtype MutBool = __NativeMutBool

## Mutable String for string building.
pub newtype MutString = __NativeMutString

## Mutable Char for character manipulation.
pub newtype MutChar = __NativeMutChar

## Convert immutable sequence to mutable (copies).
pub let seq_to_mut: { seq: ['a] } -> MutSeq 'a <Mut> = { seq } ->
  Mut.mutate { act = {} -> __native_seq_to_mut { seq = seq } }

## Freeze mutable sequence back to immutable (zero-copy).
pub let seq_to_immut: { seq: MutSeq 'a } -> ['a] <Mut> = { seq } ->
  Mut.mutate { act = {} -> __native_seq_to_immut { seq = seq } }

## Alias for seq_to_mut.
pub let to_mut = seq_to_mut

## Alias for seq_to_immut.
pub let to_immut = seq_to_immut

