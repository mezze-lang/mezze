# =============================================================================
# Mutable Ability - Operations on Mutable Containers
# =============================================================================

# The Mutable ability defines operations for in-place mutation.
# All operations have the <Mutation> effect.
ability Mutable 'c having 'elem where {
    # Get element at index (returns Option for bounds safety)
    get: {c: 'c, i: Int} -> Option 'elem <Mutation>,

    # Set element at index (returns True if in bounds)
    set: {c: 'c, i: Int, v: 'elem} -> Bool <Mutation>,

    # Get length
    len: {c: 'c} -> Int <Mutation>,

    # Swap elements at two indices
    swap: {c: 'c, i: Int, j: Int} -> Bool <Mutation>
}

# =============================================================================
# MutSeq Operations - Sequence-specific mutations
# =============================================================================

# Sort in place (natural ordering)
pub let sort: {seq: MutSeq Int} -> {} <Mutation> = {seq} -> do
    Mutation.mutate {}
    __native_mut_seq_sort {seq = seq}

# Sort in place with comparator
pub let sort_by: {seq: MutSeq 'a, cmp: {a: 'a, b: 'a} -> Int} -> {} <Mutation> = {seq, cmp} -> do
    Mutation.mutate {}
    __native_mut_seq_sort_by {seq = seq, cmp = cmp}

# Reverse in place
pub let reverse: {seq: MutSeq 'a} -> {} <Mutation> = {seq} -> do
    Mutation.mutate {}
    __native_mut_seq_reverse {seq = seq}

# Fill with value
pub let fill: {seq: MutSeq 'a, v: 'a} -> {} <Mutation> = {seq, v} -> do
    Mutation.mutate {}
    __native_mut_seq_fill {seq = seq, v = v}

# Fill range with value
pub let fill_range: {seq: MutSeq 'a, start: Int, end: Int, v: 'a} -> {} <Mutation> = {seq, start, end, v} -> do
    Mutation.mutate {}
    __native_mut_seq_fill_range {seq = seq, start = start, end = end, v = v}

# =============================================================================
# MutInt Operations - Primitive int mutations
# =============================================================================

# Read value
pub let read_int: {n: MutInt} -> Int <Mutation> = {n} -> do
    Mutation.mutate {}
    __native_mut_int_read {n = n}

# Write value
pub let write_int: {n: MutInt, v: Int} -> {} <Mutation> = {n, v} -> do
    Mutation.mutate {}
    __native_mut_int_write {n = n, v = v}

# Increment by delta
pub let incr: {n: MutInt, delta: Int} -> {} <Mutation> = {n, delta} -> do
    Mutation.mutate {}
    __native_mut_int_incr {n = n, delta = delta}

# Decrement by delta
pub let decr: {n: MutInt, delta: Int} -> {} <Mutation> = {n, delta} -> do
    Mutation.mutate {}
    __native_mut_int_decr {n = n, delta = delta}

# =============================================================================
# Looping - Imperative loops for mutation
# =============================================================================

# Loop with index from 0 to n-1
# This is the primary looping construct for mutation
pub let for_range: {start: Int, end: Int, body: {i: Int} -> {} <Mutation>} -> {} <Mutation> = {start, end, body} -> do
    Mutation.mutate {}
    __native_for_range {start = start, end = end, body = body}

# Loop while condition is true
pub let while: {cond: {} -> Bool <Mutation>, body: {} -> {} <Mutation>} -> {} <Mutation> = {cond, body} -> do
    Mutation.mutate {}
    __native_while {cond = cond, body = body}

# =============================================================================
# Convenience: Create with initial capacity
# =============================================================================

# Create empty mutable sequence with capacity
pub let seq_with_capacity: {capacity: Int} -> MutSeq 'a <Mutation> = {capacity} -> do
    Mutation.mutate {}
    __native_mut_seq_with_capacity {capacity = capacity}

# Create empty mutable map with capacity
pub let map_with_capacity: {capacity: Int} -> MutMap 'k 'v <Mutation> = {capacity} -> do
    Mutation.mutate {}
    __native_mut_map_with_capacity {capacity = capacity}

# Create empty mutable set with capacity
pub let set_with_capacity: {capacity: Int} -> MutSet 'a <Mutation> = {capacity} -> do
    Mutation.mutate {}
    __native_mut_set_with_capacity {capacity = capacity}
