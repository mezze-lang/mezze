# =============================================================================
# COMMON HEADERS
# =============================================================================

# Create bearer auth header
pub let bearer_auth: { token: String } -> Map String String = { token } ->
    map::insert { m = map::empty {}, k = "Authorization", v = string::concat { l = "Bearer ", r = token } }

# Create basic auth header
pub let basic_auth: { username: String, password: String } -> Map String String = { username, password } -> do
    let credentials = string::concat { l = username, r = string::concat { l = ":", r = password } }
    let encoded = __native_base64_encode { s = credentials }
    map::insert { m = map::empty {}, k = "Authorization", v = string::concat { l = "Basic ", r = encoded } }

# Create API key header
pub let api_key_header: { key: String, value: String } -> Map String String = { key, value } ->
    map::insert { m = map::empty {}, k = key, v = value }

# Create X-API-Key header
pub let x_api_key: { key: String } -> Map String String = { key } ->
    map::insert { m = map::empty {}, k = "X-API-Key", v = key }

