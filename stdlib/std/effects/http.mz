            let req = make_request_with_body { method = Patch, url = url, body = body_bytes }
            let req = with_content_type { req = req, content_type = "application/json" }
            Http.request { req = req, config = default_http_config }
        Err { error } -> Err { error = EncodeError { url = url, message = error.message } }

# POST typed body with custom config
pub let post_body_with: { url: String, body: 'a, config: HttpConfig } -> Result Response HttpError <Http> with Encode Json 'a = { url, body, config } -> do
    match Encode.encode { val = body, config = default_config } is
        Ok { val = json } -> do
