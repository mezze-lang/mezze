# =============================================================================
# CONCURRENT FETCH
# =============================================================================

# Fetch multiple URLs concurrently (returns array in same order)
pub let fetch_all: { urls: [String] } -> [Result Response HttpError] <Http, Async> = { urls } ->
    Async.map { xs = urls, f = { x } -> get { url = x } }

# Fetch multiple URLs, fail if any fail
pub let fetch_all_ok: { urls: [String] } -> Result [Response] HttpError <Http, Async> = { urls } -> do
    let results = fetch_all { urls = urls }
    collect_results { results = results }

# Helper to collect array of Results into Result of array
let collect_results: { results: [Result 'a 'e] } -> Result ['a] 'e = { results } -> do
    let len = array::length { xs = results }
    collect_results_loop { results = results, idx = 0, len = len, acc = [] }

let collect_results_loop: { results: [Result 'a 'e], idx: Int, len: Int, acc: ['a] } -> Result ['a] 'e = { results, idx, len, acc } ->
    if idx >= len then
        Ok { val = acc }
    else
        match array::get { xs = results, i = idx } is
            Some { val } ->
                match val is
                    Ok { val = v } -> collect_results_loop { results = results, idx = idx + 1, len = len, acc = array::add { xs = acc, x = v } }
                    Err { error } -> Err { error = error }
            None -> Ok { val = acc }  # Should not happen

# =============================================================================
# ERROR HELPERS
# =============================================================================

# Format error for display
pub let format_error: { err: HttpError } -> String = { err } ->
    match err is
        ConnectionFailed { url, reason } ->
            string::concat { l = "Connection failed to ", r = string::concat { l = url, r = string::concat { l = ": ", r = reason } } }
        Timeout { url, ms } ->
            string::concat { l = "Request timed out after ", r = string::concat { l = int::to_string { n = ms }, r = string::concat { l = "ms: ", r = url } } }
        InvalidUrl { url, reason } ->
            string::concat { l = "Invalid URL '", r = string::concat { l = url, r = string::concat { l = "': ", r = reason } } }
        TlsError { url, reason } ->
            string::concat { l = "TLS error for ", r = string::concat { l = url, r = string::concat { l = ": ", r = reason } } }
        RequestFailed { url, status, body } ->
            string::concat { l = "Request failed with status ", r = string::concat { l = int::to_string { n = status }, r = string::concat { l = ": ", r = body } } }
        DecodeError { url, message } ->
            string::concat { l = "Failed to decode response from ", r = string::concat { l = url, r = string::concat { l = ": ", r = message } } }
        EncodeError { url, message } ->
            string::concat { l = "Failed to encode request for ", r = string::concat { l = url, r = string::concat { l = ": ", r = message } } }
        Cancelled -> "Request was cancelled"

# Check if error is retryable
pub let is_retryable: { err: HttpError } -> Bool = { err } ->
    match err is
        ConnectionFailed { url, reason } -> True
        Timeout { url, ms } -> True
        TlsError { url, reason } -> False
        InvalidUrl { url, reason } -> False
        RequestFailed { url, status, body } -> status >= 500
        DecodeError { url, message } -> False
        EncodeError { url, message } -> False
        Cancelled -> False

# Check if error is due to client issue (4xx or validation)
pub let is_client_issue: { err: HttpError } -> Bool = { err } ->
    match err is
        InvalidUrl { url, reason } -> True
        EncodeError { url, message } -> True
        RequestFailed { url, status, body } -> status >= 400 && status < 500
        _ -> False

# Check if error is due to server issue (5xx)
pub let is_server_issue: { err: HttpError } -> Bool = { err } ->
    match err is
        RequestFailed { url, status, body } -> status >= 500
        ConnectionFailed { url, reason } -> True
        Timeout { url, ms } -> True
        TlsError { url, reason } -> True
        _ -> False
