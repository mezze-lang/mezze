pub let fetch_all : { urls: [Str] } -> [Result Response HttpError] <Http, Async> = { urls } ->
  Async.map { xs = urls, f = { x } -> get { url = x } }

pub let fetch_all_ok : { urls: [Str] } -> Result [Response] HttpError <Http, Async> = { urls } ->
  do
    let results = fetch_all { urls = urls }
    collect_results { results = results }

let collect_results : { results: [Result 'a 'e] } -> Result ['a] 'e = { results } ->
  do
    let len = seq::size { xs = results }
    collect_results_loop {
      results = results,
      idx = 0,
      len = len,
      acc = [],
    }

let collect_results_loop : { results: [Result 'a 'e], idx: Int, len: Int, acc: ['a] } -> Result ['a] 'e = { results, idx, len, acc } ->
  if idx >= len then Ok { val = acc } else match seq::get { xs = results, i = idx } is
    Some { val } -> match val is
      Ok { val = v } -> collect_results_loop {
        results = results,
        idx = idx + 1,
        len = len,
        acc = seq::add { xs = acc, x = v },
      }
      Err { error } -> Err { error = error }
    None -> Ok { val = acc }


pub let format_error : { err: HttpError } -> Str = { err } -> match err is
  ConnectionFailed { url, reason } -> str::concat {
    l = "Connection failed to ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  Timeout { url, ms } -> str::concat {
    l = "Request timed out after ",
    r = str::concat {
      l = int::to_str { n = ms },
      r = str::concat { l = "ms: ", r = url },
    },
  }
  InvalidUrl { url, reason } -> str::concat {
    l = "Invalid URL '",
    r = str::concat { l = url, r = str::concat { l = "': ", r = reason } },
  }
  TlsError { url, reason } -> str::concat {
    l = "TLS error for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  RequestFailed { url, status, body } -> str::concat {
    l = "Request failed with status ",
    r = str::concat {
      l = int::to_str { n = status },
      r = str::concat { l = ": ", r = body },
    },
  }
  DecodeError { url, message } -> str::concat {
    l = "Failed to decode response from ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  EncodeError { url, message } -> str::concat {
    l = "Failed to encode request for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  Cancelled -> "Request was cancelled"


pub let is_retryable : { err: HttpError } -> Bool = { err } -> match err is
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> False
  InvalidUrl { url, reason } -> False
  RequestFailed { url, status, body } -> status >= 500
  DecodeError { url, message } -> False
  EncodeError { url, message } -> False
  Cancelled -> False


pub let is_client_issue : { err: HttpError } -> Bool = { err } -> match err is
  InvalidUrl { url, reason } -> True
  EncodeError { url, message } -> True
  RequestFailed { url, status, body } -> status >= 400 && status < 500
  _ -> False


pub let is_server_issue : { err: HttpError } -> Bool = { err } -> match err is
  RequestFailed { url, status, body } -> status >= 500
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> True
  _ -> False
