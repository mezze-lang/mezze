pub let get_headers : { url: Str, headers: Map Str Str } -> Result Response HttpError <Http> = { url, headers } ->
  do
    let req = make_request { method = Get, url = url }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

