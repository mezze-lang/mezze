use std::codec::json::{ Json, to_str, parse_str, FromJson, JsonC }
use std::collections::iter
use std::effects::filesystem::{ FileStreaming, FsError, Read }
use std::codec::core::{ DecodeError as CodecDecodeError, Decode }
## Re-exported, not merely imported: `with_query` is constrained on `ToQuery`,
## and that constraint is settled at the CALL SITE, so the blanket impl has to be
## in scope wherever someone adds a query parameter. A `pub use` carries the
## instance along with the name, so importing anything from this module is
## enough.
pub use std::codec::query::{ ToQuery }
use std::collections::map
use std::collections::seq
use std::collections::bytes
use std::str
use std::int
use std::bool
use std::result::{ flat_map, map_err }

## HTTP request methods.
pub type Method = | Get, Post, Put, Delete, Patch, Head, Options |

## HTTP client configuration.
pub type HttpConfig = {
  timeout_ms: Int,
  connect_timeout_ms: Int,
  follow_redirects: Bool,
  max_redirects: Int,
  verify_ssl: Bool,
  auto_decompress: Bool,
  keep_alive: Bool,
}

## Sensible defaults for HTTP configuration.
pub let default_http_config: HttpConfig = {
  timeout_ms = 30000,
  connect_timeout_ms = 10000,
  follow_redirects = True,
  max_redirects = 10,
  verify_ssl = True,
  auto_decompress = True,
  keep_alive = True,
}

## HTTP request record.
pub type Request = {
  method: Method,
  url: Str,
  headers: Map Str Str,
  body: Option Bytes,
  timeout_ms: Option Int,
}

## HTTP response record. `url` is the URL of the request that produced
## this response — preserved so error promotion (e.g. `ensure_ok`'s
## `RequestFailed { url, ... }`) can identify the source without an
## out-of-band thread.
pub type Response = {
  status: Int,
  # Both natives lowercase what comes off the wire (IONatives for a client
  # response, HttpServerNatives for a request), so a builder storing
  # "Content-Type" makes an entry nothing can read — response_json did exactly
  # that and its own .content_type {} answered None. Every setter here
  # lowercases; a hand-written literal must too.
  ## Lowercase-keyed, always: `get_header` lowercases only the needle.
  headers: Map Str Str,
  body: Bytes,
  url: Str,
  # An extra FIELD rather than making `body` a variant, deliberately: a variant
  # would change what every reader of resp.body gets back — the client, the
  # router, user code — while this only touches the few places that construct a
  # Response.
  #
  # The iterator is walked once as the response goes out, and a source with
  # effects in it performs during that walk, on the connection thread. Only the
  # server honours this; HttpClient responses always arrive as None with a
  # whole body.
  ## A streamed body, pulled chunk by chunk as the response is written, which
  ## makes `body` ignored. Single-shot. `None` is the ordinary case.
  chunks: Option (Iter Bytes),
}

## HTTP error variants.
pub type HttpError = |
  ConnectionFailed { url: Str, reason: Str },
  Timeout { url: Str, ms: Int },
  InvalidUrl { url: Str, reason: Str },
  TlsError { url: Str, reason: Str },
  RequestFailed { url: Str, status: Int, body: Str },
  DecodeError { url: Str, message: Str },
  EncodeError { url: Str, message: Str },
  Cancelled,
|

## URL pattern for mock matching.
pub type UrlPattern = | Glob { pattern: Str } |

## A mock rule matching methods and URL pattern to a canned response.
pub type MockRule = {
  methods: [Method],
  url: UrlPattern,
  response: Result Response HttpError,
}

## HTTP client effect.
effect HttpClient where {
  ## Send an HTTP request with the given config.
  request: { req: Request, config: HttpConfig } -> Result Response HttpError <HttpClient>
}

## Connection-pooling HTTP client (scoped -- creates/closes client per handler).
impl HttpClient for PooledHttpClient where {
  initialize_scope = {} -> do
    let client = __native_http_client_create { config = default_http_config }
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req, config } ->
    __native_http_request { req = req, config = config, client = scope.client },
}

## Connection-pooling HTTP client with a fixed config override.
##
## The field is `overrides`, not `config`. The operation's own parameter is
## named `config`, and inside the operation body that parameter SHADOWS a
## performer field of the same name — so a field called `config` was dead and
## the override silently did not happen. The name also says what the value
## does: these WIN over whatever the call site passed, which is the point of
## fixing a config on the performer. A call site that wants to decide per
## request uses `PooledHttpClient` and `send_with`.
impl HttpClient for PooledHttpClientWith { overrides: HttpConfig } where {
  initialize_scope = {} -> do
    let client = __native_http_client_create { config = overrides }
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req, config } ->
    __native_http_request { req = req, config = overrides, client = scope.client },
}

## Simple HTTP client that creates a new connection per request.
impl HttpClient for SimpleHttpClient where {
  request = { req, config } -> do
    let client = __native_http_client_create { config = config }
    let result = __native_http_request { req = req, config = config, client = client }
    __native_http_client_close { client = client }
    result
}

## Simple HTTP client with a fixed config override. See
## `PooledHttpClientWith` for why the field is `overrides`.
impl HttpClient for SimpleHttpClientWith { overrides: HttpConfig } where {
  request = { req, config } -> do
    let client = __native_http_client_create { config = overrides }
    let result = __native_http_request { req = req, config = overrides, client = client }
    __native_http_client_close { client = client }
    result
}

## Mock HTTP client for testing with canned responses.
impl HttpClient for MockHttpClient { rules: [MockRule] } where {
  request = { req, config } -> __native_http_mock_request { req = req, rules = rules }
}

## Build a minimal request with method and URL.
pub let make_request: { method: Method, url: Str } -> Request = { method, url } ->
  {
    method = method,
    url = url,
    headers = map::empty {},
    body = None,
    timeout_ms = None,
  }

## Build a fully specified request. Used by impl Client's verb shortcuts;
## the explicit Request return type pins the impl op so cross-module
## chain dispatch can recover the nominal shape (see #182 notes on the
## Client impl).
pub let make_full_request
  : { method: Method, url: Str, headers: Map Str Str, body: Option Bytes, timeout_ms: Option Int }
  -> Request
  = { method, url, headers, body, timeout_ms } ->
    {
      method = method,
      url = url,
      headers = headers,
      body = body,
      timeout_ms = timeout_ms,
    }

## Add a single header to a request.
pub let with_header: { req: Request, key: Str, value: Str } -> Request = { req, key, value } ->
  {
    method = req.method,
    url = req.url,
    headers = map::insert { m = req.headers, k = key, v = value },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Merge additional headers into a request.
pub let with_headers: { req: Request, headers: Map Str Str } -> Request = { req, headers } ->
  {
    method = req.method,
    url = req.url,
    headers = map::merge { m1 = req.headers, m2 = headers },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Set the body of a request.
pub let with_body: { req: Request, body: Bytes } -> Request = { req, body } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = Some { val = body },
    timeout_ms = req.timeout_ms,
  }

## Set a per-request timeout in milliseconds.
pub let with_timeout: { req: Request, ms: Int } -> Request = { req, ms } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = Some { val = ms },
  }

## Set the Content-Type header.
pub let with_content_type: { req: Request, content_type: Str } -> Request = { req, content_type } ->
  with_header { req = req, key = "Content-Type", value = content_type }

## Set the Accept header.
pub let with_accept: { req: Request, accept: Str } -> Request = { req, accept } ->
  with_header { req = req, key = "Accept", value = accept }

## An authentication scheme. `with_auth` renders it to the right header;
## the `with_bearer` / `with_basic` / `with_api_key` shortcuts build the
## common cases so callers rarely construct the variant by hand.
pub type Auth =
  | Bearer { token: Str },
    Basic { username: Str, password: Str },
    ApiKey { name: Str, val: Str } |

## Render an `Auth` to its header name and value.
##
## `Bearer` and `Basic` set `Authorization`; `ApiKey` sets a custom header
## (e.g. `X-API-Key`). `Basic` base64-encodes `username:password` via the
## bytes codec.
pub let auth_header: { auth: Auth } -> { key: Str, value: Str } = { auth } ->
  match auth is
    Bearer { token } ->
      { key = "Authorization", value = str::concat { l = "Bearer ", r = token } }
    Basic { username, password } -> do
      let credentials =
        str::concat { l = username, r = str::concat { l = ":", r = password } }
      let encoded = bytes::to_base64 { b = bytes::from_str { s = credentials } }
      { key = "Authorization", value = str::concat { l = "Basic ", r = encoded } }
    ApiKey { name, val } ->
      { key = name, value = val }

## Set the request's authentication from a typed `Auth`.
pub let with_auth: { req: Request, auth: Auth } -> Request = { req, auth } -> do
  let h = auth_header { auth = auth }
  with_header { req = req, key = h.key, value = h.value }

## Shortcut: Bearer-token auth.
pub let with_bearer: { req: Request, token: Str } -> Request = { req, token } ->
  with_auth { req = req, auth = Bearer { token = token } }

## Shortcut: HTTP Basic auth.
pub let with_basic: { req: Request, username: Str, password: Str } -> Request =
  { req, username, password } ->
    with_auth { req = req, auth = Basic { username = username, password = password } }

## Shortcut: an API key in a named header (e.g. `X-API-Key`).
pub let with_api_key: { req: Request, name: Str, val: Str } -> Request =
  { req, name, val } ->
    with_auth { req = req, auth = ApiKey { name = name, val = val } }

## Decode response body as a UTF-8 string.
##
## The error is an `HttpError.DecodeError`, not a bare `Str`. Every other
## failure in this module is an `HttpError`, and this one odd `Result Str Str`
## forced a `map_err` at each site that wanted to keep the error channel, while
## `format_error` could not name it at all. The url it carries is the
## response's own — the only thing that identifies which body failed to decode.
pub let body_str: { resp: Response } -> Result Str HttpError = { resp } ->
  map_err {
    result = bytes::to_str { b = resp.body },
    f = { error } -> DecodeError { url = resp.url, message = error },
  }

## Decode response body as JSON.
## `body_json` reads the bytes directly rather than through `body_str`: it needs
## the raw decode message for its own `CodecDecodeError`, and `body_str` now
## wraps that message in an `HttpError`.
pub let body_json: { resp: Response } -> Result Json CodecDecodeError = { resp } -> do
  match bytes::to_str { b = resp.body } is
    Ok { val } -> match parse_str { s = val } is
      Ok { val = j } -> Ok { val = j }
      Err { error } -> Err {
        error = {
          path = error.path,
          message = error.reason,
          expected = "JSON",
          found = error.input_ref,
        },
      }
    Err { error } -> Err {
      error = {
        path = [],
        message = error,
        expected = "UTF-8",
        found = None,
      },
    }


## Check if response status is 2xx.
pub let is_success: { resp: Response } -> Bool = { resp } -> resp.status >= 200 && resp.status < 300

## Check if response status is 3xx.
pub let is_redirect: { resp: Response } -> Bool = { resp } ->
  resp.status >= 300 && resp.status < 400

## Check if response status is 4xx.
pub let is_client_error: { resp: Response } -> Bool = { resp } ->
  resp.status >= 400 && resp.status < 500

## Check if response status is 5xx.
pub let is_server_error: { resp: Response } -> Bool = { resp } ->
  resp.status >= 500 && resp.status < 600

## Get a response header by name (case-insensitive).
pub let get_header: { resp: Response, name: Str } -> Option Str = { resp, name } ->
  map::get { m = resp.headers, k = str::to_lower { s = name } }

## Get the Content-Type header.
pub let get_content_type: { resp: Response } -> Option Str = { resp } ->
  get_header { resp = resp, name = "content-type" }

## Get the Content-Length header as Int.
pub let get_content_length: { resp: Response } -> Option Int = { resp } -> match get_header { resp = resp, name = "content-length" } is
  Some { val } -> int::from_str { s = val }
  None -> None


# ─── Chainable surface ────────────────────────────────────────────────
#
# The chainable API lets you build a request via dot-method composition:
#
#   request { url = "https://api.acme.com/users" }
#     .with_method   { val = Post }
#     .with_auth     { val = "Bearer xyz" }
#     .with_json     { val = my_json }
#     .with_timeout  { ms = 5000 }
#     .send {}
#
# Underneath every impl method delegates to the corresponding free
# function — they're not duplicate logic, just chain-friendly aliases.
## Build a fresh GET Request for a URL. All fields zero-initialized
## (no headers, no body, default timeout). Configure further with
## `req.with_*` methods, then `req.send {}`.
pub let request: { url: Str } -> Request = { url } -> make_request { method = Get, url = url }

## Body setter — wrap raw bytes (already encoded).
pub let with_text: { req: Request, val: Str } -> Request = { req, val } ->
  with_body { req = req, body = bytes::from_str { s = val } }

## Body setter — encode JSON, set Content-Type: application/json.
pub let with_json: { req: Request, val: Json } -> Request = { req, val } -> do
  let body_text = to_str { json = val }
  let body_bytes = bytes::from_str { s = body_text }
  let r = with_body { req = req, body = body_bytes }
  with_content_type { req = r, content_type = "application/json" }

## Method setter — alias of with_method.
pub let with_method: { req: Request, val: Method } -> Request = { req, val } ->
  {
    method = val,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Append `?k1=v1&k2=v2&...` (or `&...` if the URL already has a query) from
## ANY value the query codec can encode — in practice a record.
##
##   req.with_query { params = { page = 2, tags = ["a", "b"] } }
##   -- ?page=2&tags=a&tags=b
##
## This used to take a `Map Str QueryValue`, where `QueryValue` was a
## three-constructor variant — `QStr`, `QInt`, `QList` — that existed only
## because no format could encode a structured query. `std::codec::query` is
## that format now, so the variant is gone: a record says `{ page = 2 }`
## instead of `map::insert { m = map::empty {}, k = "page", v = QInt { n = 2 } }`,
## nests, and decodes back on the server with `from_query`.
##
## Keys and values are percent-encoded. A value that encodes to nothing — an
## empty record, a `None` — is a no-op.
##
## A constraint is settled at the CALL SITE, so the `ToQuery` instance has to be
## in scope there — and it is, through this module's `pub use` below. Importing
## anything from here brings it, so adding `?page=2` needs no knowledge of which
## codec module makes it work.
pub let with_query: { req: Request, params: 'a } with ToQuery 'a -> Request = { req, params } -> do
  let qs = params.query_string {}
  if str::is_empty { s = qs } then req else do
    let sep = if str::contains { s = req.url, substring = "?" } then "&" else "?"
    {
      method = req.method,
      url = str::concat { l = req.url, r = str::concat { l = sep, r = qs } },
      headers = req.headers,
      body = req.body,
      timeout_ms = req.timeout_ms,
    }

## Promote a non-2xx Response to an HttpError. Used to short-circuit
## chains that want to treat any failure (transport OR status) as an
## error in one shape.
##
##   request { url }.send {}.then { ... } -- needs uniform Err on 4xx/5xx
##   ensure_ok { resp = req.send {} }
pub let ensure_ok
  : { resp: Result Response HttpError }
  -> Result Response HttpError
  = { resp } -> match resp is
    Err { error = _ } -> resp
    Ok { val } -> if is_success { resp = val } then resp else do
      let body_text = match body_str { resp = val } is
        Ok { val = s } -> s
        Err { error = _ } -> ""

      Err {
        error = RequestFailed { url = val.url, status = val.status, body = body_text },
      }


## Impl Request gives the chainable surface. Every method is a thin
## delegator to a free function above — the impl block is just an
## ergonomic wrapper. Method calls return new Requests (immutable
## builder).
impl Request where {
  with_method = { it: 'it, val: Method } -> with_method { req = it, val = val },
  with_url = { it: 'it, val: Str } ->
    {
      method = it.method,
      url = val,
      headers = it.headers,
      body = it.body,
      timeout_ms = it.timeout_ms,
    },
  with_header = { it: 'it, key: Str, value: Str } ->
    with_header { req = it, key = key, value = value },
  with_headers = { it: 'it, headers: Map Str Str } -> with_headers { req = it, headers = headers },
  with_body = { it: 'it, val: Bytes } -> with_body { req = it, body = val },
  with_text = { it: 'it, val: Str } -> with_text { req = it, val = val },
  with_json = { it: 'it, val: Json } -> with_json { req = it, val = val },
  with_query = { it, params } -> with_query { req = it, params = params },
  with_timeout = { it: 'it, ms: Int } -> with_timeout { req = it, ms = ms },
  with_auth = { it: 'it, auth: Auth } -> with_auth { req = it, auth = auth },
  with_bearer = { it: 'it, token: Str } -> with_bearer { req = it, token = token },
  with_basic = { it: 'it, username: Str, password: Str } -> with_basic { req = it, username = username, password = password },
  with_api_key = { it: 'it, name: Str, val: Str } -> with_api_key { req = it, name = name, val = val },
  with_content_type = { it: 'it, val: Str } -> with_content_type { req = it, content_type = val },
  with_accept = { it: 'it, val: Str } -> with_accept { req = it, accept = val },
  ## Terminal — perform the request via the ambient HttpClient handler.
  send = { it } -> HttpClient.request { req = it, config = default_http_config },
  ## Terminal with config override.
  send_with = { it: 'it, config: HttpConfig } -> HttpClient.request { req = it, config = config },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  retry = { it, max_attempts, backoff_ms } -> retry { req = it, max_attempts = max_attempts, backoff_ms = backoff_ms },
}

## Impl Response gives chainable decoders + predicates + header lookup.
## Direct field access (resp.status, resp.body, resp.headers) still
## works for raw projection — the impl methods only add operations
## that aren't just field reads.
impl Response where {
  ## Decode body as UTF-8 string.
  text = { it } -> body_str { resp = it },
  ## Decode body as JSON.
  json = { it } -> body_json { resp = it },
  ## 2xx status check.
  is_ok = { it } -> is_success { resp = it },
  is_success = { it } -> is_success { resp = it },
  is_redirect = { it } -> is_redirect { resp = it },
  is_client_err = { it } -> is_client_error { resp = it },
  is_server_err = { it } -> is_server_error { resp = it },
  ## Promote a non-2xx status to an Err on a bare Response. Most callers
  ## want the `Result Response HttpError`-shaped variant — use the free
  ## `ensure_ok` function for that. This method is useful when you
  ## already have an unwrapped Response (e.g. from `match resp is Ok ...`)
  ## and want a Result back without re-wrapping.
  ensure_ok = { it } -> ensure_ok { resp = Ok { val = it } },
  ## Case-insensitive header lookup.
  header = { it: 'it, name: Str } -> get_header { resp = it, name = name },
  content_type = { it } -> get_content_type { resp = it },
  content_length = { it } -> get_content_length { resp = it },

  # `with_`-prefixed because a method may not share a name with a FIELD
  # (V0419), and status/headers/body/url are all fields. The short names live
  # as free builders (no_content, redirect, …) where nothing collides.
  #
  # Each delegates to a Response-ANNOTATED free builder rather than spreading
  # `it` here: a receiver is `it: 'it`, so `{ ...it, status = code }` answers
  # the OPEN row `{ status: 'a, ... }` — not a Response — and the next
  # `.with_header {}` in the chain then has no method to find. Same reason
  # Request's setters are free functions.
  ## Set the status, keeping every other field.
  with_status = { it: 'it, code: Int } -> resp_with_status { resp = it, code = code },
  ## Set one header, lowercasing its key.
  with_header = { it: 'it, key: Str, value: Str } ->
    resp_with_header { resp = it, key = key, value = value },
  ## Merge headers in; `headers` wins on a key both carry.
  with_headers = { it: 'it, headers: Map Str Str } ->
    resp_with_headers { resp = it, headers = headers },
  ## Set the body, dropping a streamed one.
  with_body = { it: 'it, val: Bytes } -> resp_with_body { resp = it, body = val },
  ## Set a text body.
  with_text = { it: 'it, val: Str } -> resp_with_text { resp = it, val = val },
  ## Set a JSON body and the json content type.
  with_json = { it: 'it, val: Json } -> resp_with_json { resp = it, val = val },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  body_str = { it } -> body_str { resp = it },
  body_json = { it } -> body_json { resp = it },
  is_client_error = { it } -> is_client_error { resp = it },
  is_server_error = { it } -> is_server_error { resp = it },
  get_header = { it, name } -> get_header { resp = it, name = name },
  get_content_type = { it } -> get_content_type { resp = it },
  get_content_length = { it } -> get_content_length { resp = it },
}

# A route handler's job is to answer, and most answers are a string or some
# JSON — spelling out a five-field Response record for each was the tax this
# removes:
#
#   on_get { path = "/ping",      handler = { m } -> "pong" }
#   on_get { path = "/users/:id", handler = { m } -> user_json { m = m } }
#   on_get { path = "/raw",       handler = { m } -> not_found { body = "" } }
#
# Declared here beside Response rather than in the router: converting a value
# to a Response is not a routing idea, and a mock rule or test double wants the
# same conversion. Response implements it as the identity, so a handler that
# builds its own response is unchanged and pays nothing.
## What a route handler may answer with.
ability IntoResponse for 'a where {
  into_response: { it: 'a } -> Response
}

impl IntoResponse for Response where {
  into_response = { it } -> it,
}

impl IntoResponse for Str where {
  into_response = { it } -> response_ok_text { body = it },
}

impl IntoResponse for Json where {
  into_response = { it } -> response_json { body = it },
}

# A separate ability from IntoResponse, because the two answer different
# questions about the same type: Str means a 200 with that text when a handler
# SUCCEEDS with it, and a 500 when a handler FAILS with it. One ability cannot
# hold both meanings, and picking either would make the other silently wrong.
# The split is what lets Result be a handler's return type — Ok through
# IntoResponse, Err through this.
## How a failure becomes a response.
ability IntoErrorResponse for 'e where {
  into_error_response: { it: 'e } -> Response
}

impl IntoErrorResponse for Str where {
  into_error_response = { it } -> response_status { code = 500, body = it },
}

# An HttpError a handler got from calling something ELSE, so these are gateway
# statuses: our failure to get an answer, not the upstream's own reply.
#
# RequestFailed deliberately does NOT pass its status through. An upstream 404
# is not this service's 404, and conflating them makes a client retry or cache
# against the wrong system. A handler wanting passthrough has the error in hand
# and can match it.
#
# The bodies carry no url or upstream text either: these go to a CLIENT, and
# the url in an HttpError is an internal endpoint. Match the error to log the
# detail.
## Gateway statuses for a failed upstream call.
impl IntoErrorResponse for HttpError where {
  into_error_response = { it } -> match it is
    ConnectionFailed { url = _, reason = _ } ->
      response_status { code = 502, body = "upstream connection failed" }
    Timeout { url = _, ms = _ } ->
      response_status { code = 504, body = "upstream timed out" }
    TlsError { url = _, reason = _ } ->
      response_status { code = 502, body = "upstream TLS failure" }
    RequestFailed { url = _, status = _, body = _ } ->
      response_status { code = 502, body = "upstream returned an error" }
    DecodeError { url = _, message = _ } ->
      response_status { code = 502, body = "could not decode the upstream reply" }
    # The remaining three are THIS service's own mistakes, not the upstream's:
    # a url we built wrong, a body we failed to encode, a request we gave up on.
    InvalidUrl { url = _, reason = _ } ->
      response_status { code = 500, body = "internal error" }
    EncodeError { url = _, message = _ } ->
      response_status { code = 500, body = "internal error" }
    Cancelled -> response_status { code = 503, body = "request cancelled" },
}

# This is what carries the Exception sugar into a route. ExceptionToResult
# turns a region's throws into an Err, so a handler writes straight-line code
# and each failure picks its own status:
#
#   on_get { path = "/users/:id", handler = { m } -> do
#     let outcome = perform ExceptionToResult in do
#       let id   = unwrap { result = parse_id { m = m } }
#       let user = unwrap { result = load { id = id } }
#       Ok { val = user.name }
#     outcome.into_response {}
#   }
#
# Each unwrap early-returns the way `?` does. A thrown Str lands as a 500
# carrying it; a thrown HttpError picks a gateway status. Failure stays a VALUE
# the whole way — the region answers a Result and this impl reads it.
#
# Two things about that shape. The region's body ends in Ok, because the
# handler only replaces the THROW path. And .into_response {} is called INSIDE
# the handler rather than letting the route convert a Result return — that part
# is a workaround, not a preference: returning the Result straight out
# typechecks and then selects the wrong impl at run time, because the route's
# `with IntoResponse 'r` hits the known `with C 'a` dictionary-plumbing family
# (the Result comes back through impl IntoResponse for Str). Converting here
# dispatches on a concrete Result, which works. Pinned by HttpIntoResponseTest;
# when that test starts failing, this paragraph and the extra call can go.
## Ok answers through IntoResponse, Err through IntoErrorResponse.
impl IntoResponse for Result 'a 'e where {
  into_response: { it: Result 'a 'e } with IntoResponse 'a, IntoErrorResponse 'e -> Response
    = { it } -> match it is
        Ok { val } -> val.into_response {}
        Err { error } -> error.into_error_response {},
}

## A reusable HTTP client value. Bind a service's base URL, default
## headers (auth, accept, etc.), and default timeout once — derive
## requests from it for each call.
##
##   let api = client { base_url = "https://api.acme.com" }
##     .with_bearer  { token = token }
##     .with_timeout { ms = 30000 }
##   let user = api.get { path = "/users/42" }.send {}
pub type Client = {
  base_url: Str,
  default_headers: Map Str Str,
  default_timeout_ms: Int,
}

## Build a fresh Client. Empty base URL means use absolute URLs in
## each request.
pub let client: { base_url: Str } -> Client = { base_url } ->
  {
    base_url = base_url,
    default_headers = map::empty {},
    default_timeout_ms = 30000,
  }

## Build a Client with no base URL — every request uses an absolute URL.
pub let no_base_client: {} -> Client = {} -> client { base_url = "" }

## Join base_url + path. If path is absolute (starts with http:// or
## https://) it overrides base_url; otherwise base_url + path with
## one slash between.
let join_url: { base: Str, path: Str } -> Str = { base, path } -> if str::starts_with { s = path, prefix = "http://" } || str::starts_with { s = path, prefix = "https://" } then path else if str::is_empty { s = base } then path else if str::ends_with { s = base, suffix = "/" } && str::starts_with { s = path, prefix = "/" } then str::concat {
  l = base,
  r = str::substring { s = path, start = 1, end = str::size { s = path } },
} else if str::ends_with { s = base, suffix = "/" } || str::starts_with { s = path, prefix = "/" } then str::concat { l = base, r = path } else str::concat { l = str::concat { l = base, r = "/" }, r = path }

## Impl Client gives configuration + verb shortcuts. Each verb method
## produces a Request pre-filled with the client's defaults (headers,
## timeout, base_url + path).
impl Client where {
  ## Configuration setters.
  with_base_url = { it: 'it, val: Str } ->
    {
      base_url = val,
      default_headers = it.default_headers,
      default_timeout_ms = it.default_timeout_ms,
    },
  with_default_header = { it: 'it, key: Str, value: Str } ->
    {
      base_url = it.base_url,
      default_headers = map::insert { m = it.default_headers, k = key, v = value },
      default_timeout_ms = it.default_timeout_ms,
    },
  with_default_headers = { it: 'it, headers: Map Str Str } ->
    {
      base_url = it.base_url,
      default_headers = map::merge { m1 = it.default_headers, m2 = headers },
      default_timeout_ms = it.default_timeout_ms,
    },
  with_default_timeout = { it: 'it, ms: Int } ->
    {
      base_url = it.base_url,
      default_headers = it.default_headers,
      default_timeout_ms = ms,
    },
  ## Convenience: set a typed `Auth` in default_headers so every derived
  ## request carries it. `Bearer`/`Basic` set `Authorization`; `ApiKey`
  ## sets its own header name.
  with_auth = { it: 'it, auth: Auth } -> do
    let h = auth_header { auth = auth }
    {
      base_url = it.base_url,
      default_headers = map::insert { m = it.default_headers, k = h.key, v = h.value },
      default_timeout_ms = it.default_timeout_ms,
    },
  ## Verb shortcuts — return a Request pre-filled with the client's defaults.
  ## Verb shortcuts — delegate to make_full_request so the impl op's
  ## return type stays pinned to Request (a nominal TypeApplication)
  ## instead of an open structural record. Without this, the lambda's
  ## body type at the home module collapses field types to bare
  ## TypeVars and the chain `c.get { path }.send {}` can't unify the
  ## structural result against `Request` in the importer module.
  get = { it: 'it, path: Str } ->
    make_full_request {
      method = Get,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  post = { it: 'it, path: Str } ->
    make_full_request {
      method = Post,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  put = { it: 'it, path: Str } ->
    make_full_request {
      method = Put,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  delete = { it: 'it, path: Str } ->
    make_full_request {
      method = Delete,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  patch = { it: 'it, path: Str } ->
    make_full_request {
      method = Patch,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  head = { it: 'it, path: Str } ->
    make_full_request {
      method = Head,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  options = { it: 'it, path: Str } ->
    make_full_request {
      method = Options,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
  ## Verb-free request builder — set method later via .with_method.
  request = { it: 'it, path: Str } ->
    make_full_request {
      method = Get,
      url = join_url { base = it.base_url, path = path },
      headers = it.default_headers,
      body = None,
      timeout_ms = Some { val = it.default_timeout_ms },
    },
}

use std::effects::async::{ Async, par_map, sleep }
use std::effects::time::{ Time }

## Internal: retry loop. Self-recursive — kept top-level because Mezze
## doesn't bind nested `let` names to themselves.
let retry_loop
  : { req: Request, attempt: Int, max_attempts: Int, backoff_ms: Int }
  -> Result Response HttpError <HttpClient, Async, Time>
  = { req, attempt, max_attempts, backoff_ms } -> do
    let resp = HttpClient.request { req = req, config = default_http_config }
    match resp is
      Ok { val } -> resp
      Err { error } -> if attempt >= max_attempts || (is_retryable { err = error }).not {} then resp else do
        sleep { ms = backoff_ms }
        retry_loop {
          req = req,
          attempt = attempt + 1,
          max_attempts = max_attempts,
          backoff_ms = backoff_ms,
        }


## Send a Request with retry on transient failures. A failure is
## considered retryable when `is_retryable { err }` returns True —
## namely ConnectionFailed, Timeout, and 5xx RequestFailed (see the
## predicate below). Sleeps `backoff_ms` between attempts.
##
##   request { url = "https://api.acme.com/users/42" }
##     .with_bearer { token = "xyz" }
##     .send {}
##     -- becomes:
##   retry { req = request{...}.with_bearer{...}, max_attempts = 3, backoff_ms = 250 }
##
## Returns the first Ok or the last Err. `max_attempts` includes the
## initial attempt — `max_attempts = 1` is a single shot with no retry.
pub let retry
  : { req: Request, max_attempts: Int, backoff_ms: Int }
  -> Result Response HttpError <HttpClient, Async, Time>
  = { req, max_attempts, backoff_ms } ->
    retry_loop {
      req = req,
      attempt = 1,
      max_attempts = max_attempts,
      backoff_ms = backoff_ms,
    }

## Fetch multiple URLs concurrently, returning a list of Results.
##
## `par_map` returns `[Result Response AsyncError]` per spawn; we collapse
## each AsyncError into a single HTTP-level ConnectionFailed so callers
## see a uniform `[Result Response HttpError]`.
pub let fetch_all: { urls: [Str] } -> [Result Response HttpError] <HttpClient, Async> = { urls } ->
  seq::map {
    xs = par_map { xs = urls, f = { x } -> request { url = x }.send {} },
    f = { x } -> match x is
      Ok { val = inner } -> inner
      Err { error = e } -> Err {
        error = ConnectionFailed { url = "<spawn>", reason = "async task failed" },
      }
,
  }

## Fetch multiple URLs concurrently, failing on the first error.
pub let fetch_all_ok: { urls: [Str] } -> Result [Response] HttpError <HttpClient, Async> = { urls } ->
  do
    let results = fetch_all { urls = urls }
    collect_results { results = results }

let collect_results: { results: [Result 'a 'e] } -> Result ['a] 'e = { results } ->
  do
    let len = seq::size { xs = results }
    collect_results_loop {
      results = results,
      idx = 0,
      len = len,
      acc = [],
    }

let collect_results_loop
  : { results: [Result 'a 'e], idx: Int, len: Int, acc: ['a] }
  -> Result ['a] 'e
  = { results, idx, len, acc } -> if idx >= len then Ok { val = acc } else match seq::get { xs = results, i = idx } is
    Some { val } -> match val is
      Ok { val = v } -> collect_results_loop {
        results = results,
        idx = idx + 1,
        len = len,
        acc = seq::add { xs = acc, x = v },
      }
      Err { error } -> Err { error = error }
    None -> Ok { val = acc }


## Format an HttpError as a human-readable string.
pub let format_error: { err: HttpError } -> Str = { err } -> match err is
  ConnectionFailed { url, reason } -> str::concat {
    l = "Connection failed to ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  Timeout { url, ms } -> str::concat {
    l = "Request timed out after ",
    r = str::concat {
      l = int::to_str { n = ms },
      r = str::concat { l = "ms: ", r = url },
    },
  }
  InvalidUrl { url, reason } -> str::concat {
    l = "Invalid URL '",
    r = str::concat { l = url, r = str::concat { l = "': ", r = reason } },
  }
  TlsError { url, reason } -> str::concat {
    l = "TLS error for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  RequestFailed { url, status, body } -> str::concat {
    l = "Request failed with status ",
    r = str::concat {
      l = int::to_str { n = status },
      r = str::concat { l = ": ", r = body },
    },
  }
  DecodeError { url, message } -> str::concat {
    l = "Failed to decode response from ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  EncodeError { url, message } -> str::concat {
    l = "Failed to encode request for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  Cancelled -> "Request was cancelled"


## Check if an HTTP error is retryable (connection/timeout/5xx).
pub let is_retryable: { err: HttpError } -> Bool = { err } -> match err is
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> False
  InvalidUrl { url, reason } -> False
  RequestFailed { url, status, body } -> status >= 500
  DecodeError { url, message } -> False
  EncodeError { url, message } -> False
  Cancelled -> False


## Check if the error is a client-side issue (4xx / bad input).
pub let is_client_issue: { err: HttpError } -> Bool = { err } -> match err is
  InvalidUrl { url, reason } -> True
  EncodeError { url, message } -> True
  RequestFailed { url, status, body } -> status >= 400 && status < 500
  _ -> False


## Check if the error is a server-side issue (5xx / network).
pub let is_server_issue: { err: HttpError } -> Bool = { err } -> match err is
  RequestFailed { url, status, body } -> status >= 500
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> True
  _ -> False
  # ─── Response builders ────────────────────────────────────────────────

#
# Build a full Response without hand-writing the
# `{ status, headers, body, url }` record. Used directly, and by the mock
# builders below so a canned reply is a one-liner.
## A Response with an arbitrary status code and a plain-text body.
pub let response_status: { code: Int, body: Str } -> Response = { code, body } ->
  {
    status = code,
    headers = map::empty {},
    body = bytes::from_str { s = body },
    url = "",
    chunks = None,
  }

## A 200 OK response with a plain-text body.
pub let response_ok_text: { body: Str } -> Response = { body } ->
  response_status { code = 200, body = body }

## A 200 OK response whose body is the encoded JSON, with
## `Content-Type: application/json`.
pub let response_json: { body: Json } -> Response = { body } ->
  {
    status = 200,
    headers = map::insert {
      m = map::empty {},
      k = "content-type",
      v = "application/json",
    },
    body = bytes::from_str { s = to_str { json = body } },
    url = "",
    chunks = None,
  }

# Response setters, each preserving every other field so a chain reads in
# whatever order you think of it. Module-private: the public surface is the
# `impl Response` methods, and keeping these unexported leaves the short names
# free for the status builders below — `with_header` as a free name already
# belongs to Request.
#
# Written field by field rather than with a spread because the annotation is
# what keeps the result a Response; see the note in `impl Response`.
let resp_with_status: { resp: Response, code: Int } -> Response = { resp, code } ->
  {
    status = code,
    headers = resp.headers,
    body = resp.body,
    url = resp.url,
    chunks = resp.chunks,
  }

let resp_with_header: { resp: Response, key: Str, value: Str } -> Response = { resp, key, value } ->
  {
    status = resp.status,
    headers = map::insert { m = resp.headers, k = str::to_lower { s = key }, v = value },
    body = resp.body,
    url = resp.url,
    chunks = resp.chunks,
  }

# Merge, like Request's — `headers` wins on a key both carry. Incoming keys are
# lowercased first, or a caller passing { "Content-Type": ... } would add a
# second entry alongside a lowercase one and get_header would read whichever it
# found.
let resp_with_headers: { resp: Response, headers: Map Str Str } -> Response = { resp, headers } ->
  {
    status = resp.status,
    headers = map::merge {
      m1 = resp.headers,
      m2 = map::map_keys { m = headers, f = { val } -> str::to_lower { s = val } },
    },
    body = resp.body,
    url = resp.url,
    chunks = resp.chunks,
  }

# Setting a body drops a streamed one: chunks would otherwise win and the bytes
# just set would never reach the socket. Silently keeping both is the bug this
# avoids.
let resp_with_body: { resp: Response, body: Bytes } -> Response = { resp, body } ->
  {
    status = resp.status,
    headers = resp.headers,
    body = body,
    url = resp.url,
    chunks = None,
  }

let resp_with_text: { resp: Response, val: Str } -> Response = { resp, val } ->
  resp_with_body { resp = resp, body = bytes::from_str { s = val } }

let resp_with_json: { resp: Response, val: Json } -> Response = { resp, val } -> do
  let bodied = resp_with_body {
    resp = resp,
    body = bytes::from_str { s = to_str { json = val } },
  }
  resp_with_header { resp = bodied, key = "Content-Type", value = "application/json" }

# The statuses a handler reaches for by name. Free functions, not methods:
# there is no receiver to chain from when you are creating the response, and
# the short names are free here precisely because they would collide with
# Response's own fields as methods.
#
#   not_found { body = "no such user" }
#   redirect  { to = "/login" }
#   no_content {}

## 201 Created with a plain-text body.
pub let created: { body: Str } -> Response = { body } ->
  response_status { code = 201, body = body }

## 204 No Content — no body, which is what 204 MEANS, so there is no
## `body` parameter to get wrong.
pub let no_content: {} -> Response = {} ->
  {
    status = 204,
    headers = map::empty {},
    body = bytes::empty {},
    url = "",
    chunks = None,
  }

## 400 Bad Request with a plain-text body.
pub let bad_request: { body: Str } -> Response = { body } ->
  response_status { code = 400, body = body }

## 404 Not Found with a plain-text body.
pub let not_found: { body: Str } -> Response = { body } ->
  response_status { code = 404, body = body }

## 500 Internal Server Error with a plain-text body.
pub let server_error: { body: Str } -> Response = { body } ->
  response_status { code = 500, body = body }

## A redirect. 302 by default — `redirect_with` takes the code for a 301
## or a 307, so the common case needs no number and the uncommon one is
## still one call.
pub let redirect: { to: Str } -> Response = { to } ->
  redirect_with { to = to, code = 302 }

## A redirect with an explicit status code.
pub let redirect_with: { to: Str, code: Int } -> Response = { to, code } ->
  {
    status = code,
    headers = map::insert { m = map::empty {}, k = "location", v = to },
    body = bytes::empty {},
    url = "",
    chunks = None,
  }

## A response whose body is STREAMED from an iterator of chunks.
##
## `body` is ignored when `chunks` is `Some`, so it is left empty here. The
## server pulls one `Bytes` at a time and writes each straight to the socket:
## peak heap is one chunk, not the whole body. Serving a 2GB file with
## `response_ok_text` costs 2GB; with this it costs a chunk.
##
## The iterator is walked ONCE, as the response goes out, on the connection
## thread. A source with effects in it performs during that walk — which is
## how `with_lines` or a `map_concurrent_lazy` pipeline can feed a response
## directly.
##
## Only the server honours `chunks`. A `MockHttpServer` reply and every
## `HttpClient` response are whole bodies.
pub let response_stream
  : { status: Int, headers: Map Str Str, chunks: Iter Bytes } -> Response
  = { status, headers, chunks } ->
    {
      status = status,
      headers = headers,
      body = bytes::from_str { s = "" },
      url = "",
      chunks = Some { val = chunks },
    }


## A 200 whose body streams a file from disk, a chunk at a time.
##
## The motivating case for `response_stream`: a download handler that does not
## read the file into memory first. `chunk_bytes` is the read size, so the peak
## is one chunk plus the socket buffer regardless of the file's size.
##
## Needs `<FileStreaming>` because it holds a handle for the life of the
## response — which is also why the handle cannot be closed here: the body is
## written after this function returns. A caller that needs the close
## guaranteed should use `with_lines`-style scoping and buffer, or accept that
## the handle is released when the context goes (see `OpenResources`).
pub let response_file
  : { path: Str, chunk_bytes: Int } -> Result Response FsError <FileStreaming>
  = { path, chunk_bytes } -> match FileStreaming.open { path = path, mode = Read } is
    Err { error } -> Err { error = error }
    Ok { val = h } -> Ok {
      val = response_stream {
        status = 200,
        headers = map::empty {},
        chunks = iter::unfold {
          state = {},
          step = { s } -> match FileStreaming.read_chunk { handle = h, max_bytes = chunk_bytes } is
            Err { error = _ } -> Done
            Ok { val = b } -> if bytes::size { b = b } == 0 then Done
              else Yield { val = b, next = {} }
        },
      },
    }


# ─── Mock rules, chained ──────────────────────────────────────────────
#
# A hand-built `MockRule` is a nested literal with a `Response` inside it, and
# the `Response` has five fields:
#
#     { methods = [Get], url = Glob { pattern = "**" },
#       response = Ok { val = {
#         status = 200, headers = map::empty {}, body = bytes::from_str { s = "ok" },
#         url = "", chunks = None,
#       } } }
#
# Six lines to say "a GET returns 200 ok", and every field added to `Response`
# makes it longer — `chunks` did exactly that. The chain says the same thing in
# one line and reads in the order you think of it: WHICH requests, then WHAT
# comes back.
#
#     mock { url = "**" }.get {}.text { body = "ok" }
#     mock { url = "/users/*" }.post {}.status { code = 201 }.json { body = payload }
#     mock { url = "**" }.times_out { ms = 30 }
#
# Every step answers a `MockRule`, so there is no terminal call to forget and a
# half-built rule is still a usable one. `mock` on its own matches ANY method
# and returns an empty 200.

## Start a rule matching any method whose URL matches the glob `url`.
##
## `*` matches within a path segment and `**` across segments, as
## `UrlPattern.Glob` defines. Narrow it with `.get {}` and friends; shape the
## reply with `.status`, `.text`, `.json`, `.raw`, `.header`; or replace the
## reply with a transport failure using `.fails`, `.times_out`,
## `.unreachable`.
pub let mock: { url: Str } -> MockRule = { url } ->
  {
    methods = [],
    url = Glob { pattern = url },
    response = Ok { val = response_status { code = 200, body = "" } },
  }


## The response a rule currently answers with, or a bare 200 if the rule is
## set to fail. Used by the chain so `.status` can keep the body and `.text`
## can keep the status, rather than each one resetting the other.
let mock_response_of: { rule: MockRule } -> Response = { rule } ->
  match rule.response is
    Ok { val } -> val
    Err { error = _ } -> response_status { code = 200, body = "" }


let mock_with_response: { rule: MockRule, resp: Response } -> MockRule = { rule, resp } ->
  { methods = rule.methods, url = rule.url, response = Ok { val = resp } }


let mock_with_methods: { rule: MockRule, methods: [Method] } -> MockRule = { rule, methods } ->
  { methods = methods, url = rule.url, response = rule.response }


impl MockRule where {
  ## ---- which requests this rule answers ----
  ## Restrict to one method. Replaces any previous restriction rather than
  ## adding to it: `.get {}.post {}` matches POST, which is what reading it
  ## left to right suggests. Use `.for_methods` for a set.
  get = { it: 'it } -> mock_with_methods { rule = it, methods = [Get] },
  post = { it: 'it } -> mock_with_methods { rule = it, methods = [Post] },
  put = { it: 'it } -> mock_with_methods { rule = it, methods = [Put] },
  delete = { it: 'it } -> mock_with_methods { rule = it, methods = [Delete] },
  patch = { it: 'it } -> mock_with_methods { rule = it, methods = [Patch] },
  head = { it: 'it } -> mock_with_methods { rule = it, methods = [Head] },
  options = { it: 'it } -> mock_with_methods { rule = it, methods = [Options] },
  ## Match any of several methods.
  for_methods = { it: 'it, methods: [Method] } ->
    mock_with_methods { rule = it, methods = methods },
  ## Match every method — the default a bare `mock` starts with.
  any_method = { it: 'it } -> mock_with_methods { rule = it, methods = [] },

  ## ---- what comes back ----
  ## Set the status, keeping the body and headers.
  status = { it: 'it, code: Int } -> do
    let r = mock_response_of { rule = it }
    mock_with_response {
      rule = it,
      resp = { status = code, headers = r.headers, body = r.body, url = r.url, chunks = None },
    },
  ## Set a UTF-8 text body, keeping the status and headers.
  text = { it: 'it, body: Str } -> do
    let r = mock_response_of { rule = it }
    mock_with_response {
      rule = it,
      resp = {
        status = r.status, headers = r.headers,
        body = bytes::from_str { s = body }, url = r.url, chunks = None,
      },
    },
  ## Set a JSON body AND `Content-Type: application/json`, keeping the status.
  json = { it: 'it, body: Json } -> do
    let r = mock_response_of { rule = it }
    mock_with_response {
      rule = it,
      resp = {
        status = r.status,
        headers = map::insert { m = r.headers, k = "content-type", v = "application/json" },
        body = bytes::from_str { s = to_str { json = body } },
        url = r.url,
        chunks = None,
      },
    },
  ## Set a raw byte body, keeping the status and headers.
  raw = { it: 'it, body: Bytes } -> do
    let r = mock_response_of { rule = it }
    mock_with_response {
      rule = it,
      resp = { status = r.status, headers = r.headers, body = body, url = r.url, chunks = None },
    },
  ## Add one response header, keeping everything else.
  # The key is lowercased, like every other Response header setter — a mocked
  # response has to answer get_header the same way a real one does, or a test
  # passes against a header the production reader cannot see.
  ## Set a response header on the rule.
  header = { it: 'it, name: Str, value: Str } -> do
    let r = mock_response_of { rule = it }
    mock_with_response {
      rule = it,
      resp = {
        status = r.status,
        headers = map::insert { m = r.headers, k = str::to_lower { s = name }, v = value },
        body = r.body, url = r.url, chunks = None,
      },
    },

  ## ---- failing instead of answering ----
  ## These were impossible before. `MockRule.response` is a
  ## `Result Response HttpError`, so a rule could always have carried an
  ## error — but no builder produced one, which left every error path in
  ## every caller untestable without hand-writing the literal.
  ## Answer with a transport error rather than a response.
  fails = { it: 'it, error: HttpError } ->
    { methods = it.methods, url = it.url, response = Err { error = error } },
  ## Answer with a timeout after `ms`. The url is filled in by the client, so
  ## it is left empty here.
  times_out = { it: 'it, ms: Int } ->
    { methods = it.methods, url = it.url, response = Err { error = Timeout { url = "", ms = ms } } },
  ## Answer as though the connection never opened.
  unreachable = { it: 'it, reason: Str } ->
    { methods = it.methods, url = it.url,
      response = Err { error = ConnectionFailed { url = "", reason = reason } } },
}


# ─── Mock rule builders (shorthands over the chain) ───────────────────
#
# One-call forms of the commonest rules:
#
#   perform MockHttpClient { rules = [ mock_get { url = "*", body = "pong" } ] } in ...
#
# Each is a one-liner over the chain above, so the two surfaces cannot drift.
# Anything these do not cover — headers, a failure, a non-GET JSON reply — is
# the chain's job: `mock { url = "*" }.post {}.json { body = payload }`.
## A rule: any GET matching `url` returns a 200 text `body`.
pub let mock_get: { url: Str, body: Str } -> MockRule = { url, body } ->
  mock { url = url }.get {}.text { body = body }

## A rule: any POST matching `url` returns a 201 text `body`.
pub let mock_post: { url: Str, body: Str } -> MockRule = { url, body } ->
  mock { url = url }.post {}.status { code = 201 }.text { body = body }

## A rule: any PUT matching `url` returns a 200 text `body`.
pub let mock_put: { url: Str, body: Str } -> MockRule = { url, body } ->
  mock { url = url }.put {}.text { body = body }

## A rule: any DELETE matching `url` returns a 200 text `body`.
pub let mock_delete: { url: Str, body: Str } -> MockRule = { url, body } ->
  mock { url = url }.delete {}.text { body = body }

## A rule: any GET matching `url` returns a 200 JSON `body`
## (`Content-Type: application/json`).
pub let mock_json: { url: Str, body: Json } -> MockRule = { url, body } ->
  mock { url = url }.get {}.json { body = body }

## A rule: any of `methods` matching `url` returns `code` with a text `body`.
## The general form — the verb helpers above are shorthands for it.
pub let mock_status
  : { url: Str, methods: [Method], code: Int, body: Str }
  -> MockRule
  = { url, methods, code, body } ->
    mock { url = url }.for_methods { methods = methods }.status { code = code }.text { body = body }

# ─── Result chain terminals ───────────────────────────────────────────
#
# Chain-friendly finishers for the `Result Response HttpError` a `.send {}`
# returns, so a fetch is one expression instead of a `match`:
#
#   request { url }.send {}.text_or { def = "offline" }
#
# The impl lives here (not in std::result) because these decoders are
# Response-specific; the generic `impl Result 'a 'e` stays untouched.
## Decode the Ok Response body as UTF-8; return `def` on any Err OR a
## decode failure. The one-call replacement for
## `match resp is Ok {..} -> body_str{..}.get_or{..}  Err -> def`.
pub let text_or: { resp: Result Response HttpError, def: Str } -> Str = { resp, def } ->
  match resp is
    Ok { val } -> match body_str { resp = val } is
      Ok { val = s } -> s
      Err { error = _ } -> def
    Err { error = _ } -> def


## Decode the Ok Response body as JSON; return `def` on any Err OR a
## decode failure.
pub let json_or: { resp: Result Response HttpError, def: Json } -> Json = { resp, def } ->
  match resp is
    Ok { val } -> match body_json { resp = val } is
      Ok { val = j } -> j
      Err { error = _ } -> def
    Err { error = _ } -> def


## Run `f` on the Ok Response (for its effects); a no-op on Err.
pub let on_ok
  : { resp: Result Response HttpError, f: { resp: Response } -> {} <...> }
  -> {} <...>
  = { resp, f } -> match resp is
    Ok { val } -> f { resp = val }
    Err { error = _ } -> {}


## Run `f` on the Err (for its effects); a no-op on Ok.
pub let on_err
  : { resp: Result Response HttpError, f: { err: HttpError } -> {} <...> }
  -> {} <...>
  = { resp, f } -> match resp is
    Ok { val } -> {}
    Err { error } -> f { err = error }


## Decode the Ok Response body as UTF-8, staying inside `Result`. Unlike
## `text_or` (which needs a `def` and collapses to a bare `Str`), this keeps
## the error channel: a network `Err` passes through unchanged, and a body that
## is not valid UTF-8 becomes an `HttpError.DecodeError`. So the whole fetch is
## still one `Result Str HttpError` to `match` or chain on.
##
##   request { url }.send {}.text {}    # Result Str HttpError
pub let text_result: { resp: Result Response HttpError } -> Result Str HttpError = { resp } ->
  flat_map { result = resp, f = { val } -> body_str { resp = val } }


## Decode the Ok Response body as JSON, staying inside `Result`. A network `Err`
## passes through; a body that is not valid JSON becomes an
## `HttpError.DecodeError`. Returns a raw `Json` value — use `.decode {}` to go
## straight to a typed value.
##
##   request { url }.send {}.json {}    # Result Json HttpError
pub let json_result: { resp: Result Response HttpError } -> Result Json HttpError = { resp } ->
  match resp is
    Ok { val } -> match body_json { resp = val } is
      Ok { val = j } -> Ok { val = j }
      Err { error = e } -> Err { error = DecodeError { url = val.url, message = e.message } }
    Err { error } -> Err { error = error }


## Decode the Ok Response body straight into a typed value via `from_json`,
## staying inside `Result`. The target type is inferred from the use site (the
## same target-directed decode as `body.from_json {}`), so no schema is
## declared. A network `Err` passes through; JSON that does not fit the inferred
## shape becomes an `HttpError.DecodeError`. This is the typed counterpart to
## `.json {}` and the `Result`-keeping counterpart to `json_or`.
##
##   let user: Result { name: Str } HttpError =
##     request { url }.send {}.from_json {}
pub let from_json_result: { resp: Result Response HttpError } with FromJson 'a Str -> Result 'a HttpError = { resp } ->
  # This used to be three nested `flat_map`/`map_err` calls, under a comment
  # forbidding a hand-written `Ok { val = d } -> Ok { val = d }` re-wrap: a
  # re-wrap dropped the target-directed decode's dictionary and crashed with
  # UnsupportedSpecialization, and the generic combinators threaded it because
  # they are separately compiled. The dictionary-evidence fix settled that —
  # need is now decided by the operation's unresolved dispatch rather than by
  # its receiver — so the plain form works, and `HttpChainTest` runs it both
  # ways round to say so. The combinators also had nowhere to get the url from
  # and reported the decode failure against `""`.
  match resp is
    Err { error } -> Err { error = error }
    Ok { val } -> match body_str { resp = val } is
      Err { error } -> Err { error = error }
      Ok { val = s } -> match s.from_json {} is
        Ok { val = d } -> Ok { val = d }
        Err { error } -> Err { error = DecodeError { url = val.url, message = error.message } }


## Chainable finishers on the `Result Response HttpError` from `.send {}`.
## A specialized inherent impl on the concrete Result — the generic
## `impl Result 'a 'e` (map/get_or/…) still applies to every other
## Result. Each method delegates to the free function above.
impl Result Response HttpError where {
  text_or = { it: 'it, def: Str } -> text_or { resp = it, def = def },
  json_or = { it: 'it, def: Json } -> json_or { resp = it, def = def },
  on_ok = { it, f } -> on_ok { resp = it, f = f },
  on_err = { it, f } -> on_err { resp = it, f = f },

  ## Body decoders that KEEP the Result (error channel preserved), as opposed to
  ## the `*_or` finishers that collapse to a bare value. `.from_json {}` is
  ## target-directed — the type it decodes into is inferred from the use site.
  text = { it } -> text_result { resp = it },
  json = { it } -> json_result { resp = it },
  from_json = { it } -> from_json_result { resp = it },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  ensure_ok = { it } -> ensure_ok { resp = it },
}
