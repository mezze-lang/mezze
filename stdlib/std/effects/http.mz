# ASYNC WRAPPERS
# =============================================================================

use std::effects::async::{Async}

# Async GET
pub let async_get: { url: String } -> Result Response HttpError <Http, Async> = { url } -> do
    let promise = Async.spawn { f = {} -> get { url = url } }
    Async.await { p = promise }

# Async POST
pub let async_post: { url: String, body: Bytes } -> Result Response HttpError <Http, Async> = { url, body } -> do
    let promise = Async.spawn { f = {} -> post { url = url, body = body } }
    Async.await { p = promise }

# Async PUT
pub let async_put: { url: String, body: Bytes } -> Result Response HttpError <Http, Async> = { url, body } -> do
