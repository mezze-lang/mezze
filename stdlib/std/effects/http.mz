pub let bearer_auth : { token: Str } -> Map Str Str = { token } ->
  map::insert {
    m = map::empty {},
    k = "Authorization",
    v = str::concat { l = "Bearer ", r = token },
  }

pub let basic_auth : { username: Str, password: Str } -> Map Str Str = { username, password } ->
  do
    let credentials = str::concat {
      l = username,
      r = str::concat { l = ":", r = password },
    }
    let encoded = __native_base64_encode { s = credentials }
    map::insert {
      m = map::empty {},
      k = "Authorization",
      v = str::concat { l = "Basic ", r = encoded },
    }

pub let api_key_header : { key: Str, value: Str } -> Map Str Str = { key, value } ->
  map::insert { m = map::empty {}, k = key, v = value }

pub let x_api_key : { key: Str } -> Map Str Str = { key } ->
  map::insert { m = map::empty {}, k = "X-API-Key", v = key }

use std::effects::async::{ Async }

pub let async_get : { url: Str } -> Result Response HttpError <Http, Async> = { url } ->
  do
    let promise = Async.spawn { f = {} -> get { url = url } }
    Async.await { p = promise }

