# std/effects/http.mz - HTTP client effect
#
# Provides HTTP client functionality as an effect with a single core operation.
# All convenience methods (get, post, etc.) are helper functions that build
# Request records and call Http.request.
#
# Implementations:
# - HttpClient: Production implementation using Vert.x WebClient
# - MockHttpClient: Testing implementation with configurable responses (future)
#
# Example:
#   use std::effects::http::{Http, HttpClient, get, post_json}
#
#   perform HttpClient in do
#       let resp = get { url = "https://api.example.com/users" }
#       match resp is
#           Ok { val } -> val.body
#           Err { error } -> handle_error { error }

use std::codec::json::{Json, to_string, parse_str}
use std::codec::core::{Encode, Decode, DecodeError, EncodeError, CodecConfig, FieldTransform, default_config, EncodeFormat, DecodeFormat}
use std::collections::map
use std::collections::array
use std::collections::bytes
use std::string
use std::int

# =============================================================================
# TYPES
# =============================================================================

# HTTP methods
pub type Method = | Get, Post, Put, Delete, Patch, Head, Options |

# HTTP configuration (comprehensive settings for production use)
pub type HttpConfig = {
    # Timeouts (in milliseconds)
    timeout_ms: Int,              # Total request timeout (default: 30000)
    connect_timeout_ms: Int,      # Connection timeout (default: 10000)

    # Redirects
    follow_redirects: Bool,       # Follow HTTP redirects (default: True)
    max_redirects: Int,           # Maximum redirect hops (default: 10)

    # SSL/TLS
    verify_ssl: Bool,             # Verify SSL certificates (default: True)

    # Compression
    auto_decompress: Bool,        # Auto decompress gzip/deflate responses (default: True)

    # Connection
    keep_alive: Bool              # Use HTTP keep-alive (default: True)
}

# Default HTTP configuration
pub let default_http_config: HttpConfig = {
    timeout_ms = 30000,
    connect_timeout_ms = 10000,
    follow_redirects = True,
    max_redirects = 10,
    verify_ssl = True,
    auto_decompress = True,
    keep_alive = True
}

# HTTP request
pub type Request = {
    method: Method,
    url: String,
    headers: Map String String,
    body: Option Bytes,
    timeout_ms: Option Int
}

# HTTP response
pub type Response = {
    status: Int,
    headers: Map String String,
    body: Bytes
}

# HTTP errors
pub type HttpError = | ConnectionFailed { url: String, reason: String }, Timeout { url: String, ms: Int }, InvalidUrl { url: String, reason: String }, TlsError { url: String, reason: String }, RequestFailed { url: String, status: Int, body: String }, DecodeError { url: String, message: String }, EncodeError { url: String, message: String }, Cancelled |

# =============================================================================
# MOCK TYPES
# =============================================================================

# URL pattern for mock matching
# Glob patterns support:
#   *  - matches any characters except /
#   ** - matches any characters including /
#   ?  - matches single character
# Examples:
#   Glob { pattern = "/users/*" }           # /users/123, /users/abc
#   Glob { pattern = "/api/**/health" }     # /api/health, /api/v1/health
#   Glob { pattern = "/files/*.json" }      # /files/config.json
#   Glob { pattern = "/exact/path" }        # exact match (no wildcards)
#   Glob { pattern = "**" }                 # catch-all
pub type UrlPattern = | Glob { pattern: String } |

# Mock rule for matching requests
# - methods: list of methods to match, empty [] matches any method
# - url: URL pattern to match
# - response: the response to return when matched
pub type MockRule = {
    methods: [Method],
    url: UrlPattern,
    response: Result Response HttpError
}

# =============================================================================
# HTTP EFFECT (single core operation)
# =============================================================================

effect Http where {
    # Core request function - all HTTP operations go through this
    # Takes a Request and HttpConfig, returns Result Response HttpError
    request: { req: Request, config: HttpConfig } -> Result Response HttpError <Http>
}

# =============================================================================
# IMPLEMENTATIONS
# =============================================================================

# Production HTTP client using Vert.x WebClient
pub impl Http for HttpClient where {
    request = { req, config } -> __native_http_request { req = req, config = config }
}

# Mock HTTP client for testing
# Rules are matched in order - first match wins
# Example:
#   perform MockHttpClient { rules = [
#       { methods = [Get], url = Glob { pattern = "/users/*" }, response = Ok { val = user_resp } },
#       { methods = [Post], url = Glob { pattern = "/users" }, response = Ok { val = created_resp } },
#       { methods = [], url = Glob { pattern = "**" }, response = Err { error = ConnectionFailed { url = "", reason = "No mock" } } }
#   ] } in do ...
pub impl Http for MockHttpClient { rules: [MockRule] } where {
    request = { req, config } -> __native_http_mock_request { req = req, rules = rules }
}

# =============================================================================
# REQUEST BUILDERS
# =============================================================================

# Create a basic request (no body)
pub let make_request: { method: Method, url: String } -> Request = { method, url } -> {
    method = method,
    url = url,
    headers = map::empty {},
    body = None,
    timeout_ms = None
}

# Create request with body
pub let make_request_with_body: { method: Method, url: String, body: Bytes } -> Request = { method, url, body } -> {
    method = method,
    url = url,
    headers = map::empty {},
    body = Some { val = body },
    timeout_ms = None
}

# Create request with headers
pub let make_request_with_headers: { method: Method, url: String, headers: Map String String } -> Request = { method, url, headers } -> {
    method = method,
    url = url,
    headers = headers,
    body = None,
    timeout_ms = None
}

# Create a full request
pub let make_full_request: { method: Method, url: String, headers: Map String String, body: Option Bytes, timeout_ms: Option Int } -> Request =
    { method, url, headers, body, timeout_ms } -> {
        method = method,
        url = url,
        headers = headers,
        body = body,
        timeout_ms = timeout_ms
    }

# Add header to request (immutable - returns new request)
pub let with_header: { req: Request, key: String, value: String } -> Request = { req, key, value } -> {
    method = req.method,
    url = req.url,
    headers = map::insert { m = req.headers, k = key, v = value },
    body = req.body,
    timeout_ms = req.timeout_ms
}

# Add multiple headers (immutable - returns new request)
pub let with_headers: { req: Request, headers: Map String String } -> Request = { req, headers } -> {
    method = req.method,
    url = req.url,
    headers = map::merge { m1 = req.headers, m2 = headers },
    body = req.body,
    timeout_ms = req.timeout_ms
}

# Set request body (immutable - returns new request)
pub let with_body: { req: Request, body: Bytes } -> Request = { req, body } -> {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = Some { val = body },
    timeout_ms = req.timeout_ms
}

# Set request timeout (immutable - returns new request)
pub let with_timeout: { req: Request, ms: Int } -> Request = { req, ms } -> {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = Some { val = ms }
}

# Add Content-Type header
pub let with_content_type: { req: Request, content_type: String } -> Request = { req, content_type } ->
    with_header { req = req, key = "Content-Type", value = content_type }

# Add Accept header
pub let with_accept: { req: Request, accept: String } -> Request = { req, accept } ->
    with_header { req = req, key = "Accept", value = accept }

# Add Authorization header
pub let with_auth: { req: Request, auth: String } -> Request = { req, auth } ->
    with_header { req = req, key = "Authorization", value = auth }

# =============================================================================
# CONFIG BUILDERS
# =============================================================================

# Create config with custom timeout
pub let config_with_timeout: { timeout_ms: Int } -> HttpConfig = { timeout_ms } -> {
    timeout_ms = timeout_ms,
    connect_timeout_ms = default_http_config.connect_timeout_ms,
    follow_redirects = default_http_config.follow_redirects,
    max_redirects = default_http_config.max_redirects,
    verify_ssl = default_http_config.verify_ssl,
    auto_decompress = default_http_config.auto_decompress,
    keep_alive = default_http_config.keep_alive
}

# Create config with no redirect following
pub let config_no_redirects: {} -> HttpConfig = {} -> {
    timeout_ms = default_http_config.timeout_ms,
    connect_timeout_ms = default_http_config.connect_timeout_ms,
    follow_redirects = False,
    max_redirects = 0,
    verify_ssl = default_http_config.verify_ssl,
    auto_decompress = default_http_config.auto_decompress,
    keep_alive = default_http_config.keep_alive
}

# Create config with SSL verification disabled (for testing only!)
pub let config_insecure: {} -> HttpConfig = {} -> {
    timeout_ms = default_http_config.timeout_ms,
    connect_timeout_ms = default_http_config.connect_timeout_ms,
    follow_redirects = default_http_config.follow_redirects,
    max_redirects = default_http_config.max_redirects,
    verify_ssl = False,
    auto_decompress = default_http_config.auto_decompress,
    keep_alive = default_http_config.keep_alive
}

# =============================================================================
# BASIC REQUEST HELPERS (use default config)
# =============================================================================

# GET request
pub let get: { url: String } -> Result Response HttpError <Http> = { url } ->
    Http.request { req = make_request { method = Get, url = url }, config = default_http_config }

# POST request with body
pub let post: { url: String, body: Bytes } -> Result Response HttpError <Http> = { url, body } ->
    Http.request { req = make_request_with_body { method = Post, url = url, body = body }, config = default_http_config }

# PUT request with body
pub let put: { url: String, body: Bytes } -> Result Response HttpError <Http> = { url, body } ->
    Http.request { req = make_request_with_body { method = Put, url = url, body = body }, config = default_http_config }

# DELETE request
pub let delete: { url: String } -> Result Response HttpError <Http> = { url } ->
    Http.request { req = make_request { method = Delete, url = url }, config = default_http_config }

# PATCH request with body
pub let patch: { url: String, body: Bytes } -> Result Response HttpError <Http> = { url, body } ->
    Http.request { req = make_request_with_body { method = Patch, url = url, body = body }, config = default_http_config }

# HEAD request
pub let head: { url: String } -> Result Response HttpError <Http> = { url } ->
    Http.request { req = make_request { method = Head, url = url }, config = default_http_config }

# OPTIONS request
pub let options: { url: String } -> Result Response HttpError <Http> = { url } ->
    Http.request { req = make_request { method = Options, url = url }, config = default_http_config }

