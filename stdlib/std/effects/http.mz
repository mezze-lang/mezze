# POST with custom config
pub let post_with: { url: String, body: Bytes, config: HttpConfig } -> Result Response HttpError <Http> = { url, body, config } ->
    Http.request { req = make_request_with_body { method = Post, url = url, body = body }, config = config }

# PUT with custom config
pub let put_with: { url: String, body: Bytes, config: HttpConfig } -> Result Response HttpError <Http> = { url, body, config } ->
    Http.request { req = make_request_with_body { method = Put, url = url, body = body }, config = config }

# DELETE with custom config
pub let delete_with: { url: String, config: HttpConfig } -> Result Response HttpError <Http> = { url, config } ->
    Http.request { req = make_request { method = Delete, url = url }, config = config }

# PATCH with custom config
pub let patch_with: { url: String, body: Bytes, config: HttpConfig } -> Result Response HttpError <Http> = { url, body, config } ->
    Http.request { req = make_request_with_body { method = Patch, url = url, body = body }, config = config }

# HEAD with custom config
pub let head_with: { url: String, config: HttpConfig } -> Result Response HttpError <Http> = { url, config } ->
    Http.request { req = make_request { method = Head, url = url }, config = config }

# OPTIONS with custom config
pub let options_with: { url: String, config: HttpConfig } -> Result Response HttpError <Http> = { url, config } ->
    Http.request { req = make_request { method = Options, url = url }, config = config }

# =============================================================================
# REQUEST HELPERS WITH HEADERS
# =============================================================================

# GET with headers
pub let get_headers: { url: String, headers: Map String String } -> Result Response HttpError <Http> = { url, headers } -> do
    let req = make_request { method = Get, url = url }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

# POST with headers
pub let post_headers: { url: String, body: Bytes, headers: Map String String } -> Result Response HttpError <Http> = { url, body, headers } -> do
    let req = make_request_with_body { method = Post, url = url, body = body }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

# PUT with headers
pub let put_headers: { url: String, body: Bytes, headers: Map String String } -> Result Response HttpError <Http> = { url, body, headers } -> do
    let req = make_request_with_body { method = Put, url = url, body = body }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

# DELETE with headers
pub let delete_headers: { url: String, headers: Map String String } -> Result Response HttpError <Http> = { url, headers } -> do
    let req = make_request { method = Delete, url = url }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

# PATCH with headers
pub let patch_headers: { url: String, body: Bytes, headers: Map String String } -> Result Response HttpError <Http> = { url, body, headers } -> do
    let req = make_request_with_body { method = Patch, url = url, body = body }
    let req = with_headers { req = req, headers = headers }
    Http.request { req = req, config = default_http_config }

# =============================================================================
# RESPONSE HELPERS
# =============================================================================

# Get response body as string (returns Result because of UTF-8 decoding)
pub let body_string: { resp: Response } -> Result String String = { resp } ->
    bytes::to_string { b = resp.body }

# Get response body as JSON
pub let body_json: { resp: Response } -> Result Json DecodeError = { resp } -> do
    match body_string { resp = resp } is
        Ok { val } -> parse_str { s = val }
        Err { error } -> Err { error = { path = [], message = error, expected = "UTF-8", found = None } }

# Check if response is successful (2xx)
pub let is_success: { resp: Response } -> Bool = { resp } ->
    resp.status >= 200 && resp.status < 300

# Check if response is redirect (3xx)
pub let is_redirect: { resp: Response } -> Bool = { resp } ->
    resp.status >= 300 && resp.status < 400

# Check if response is client error (4xx)
pub let is_client_error: { resp: Response } -> Bool = { resp } ->
    resp.status >= 400 && resp.status < 500

# Check if response is server error (5xx)
pub let is_server_error: { resp: Response } -> Bool = { resp } ->
    resp.status >= 500 && resp.status < 600

# Get header value (case-insensitive)
pub let get_header: { resp: Response, name: String } -> Option String = { resp, name } ->
    map::get { m = resp.headers, k = string::to_lower { s = name } }

# Get Content-Type header
pub let get_content_type: { resp: Response } -> Option String = { resp } ->
    get_header { resp = resp, name = "content-type" }

# Get Content-Length header as Int
pub let get_content_length: { resp: Response } -> Option Int = { resp } ->
    match get_header { resp = resp, name = "content-length" } is
        Some { val } -> match int::from_string { s = val } is
            Ok { val = n } -> Some { val = n }
            Err { error } -> None
        None -> None

# =============================================================================
# JSON HELPERS
# =============================================================================

# Create JSON headers map
pub let json_headers: {} -> Map String String = {} -> do
    let m = map::empty {}
    let m = map::insert { m = m, k = "Content-Type", v = "application/json" }
    map::insert { m = m, k = "Accept", v = "application/json" }

# GET expecting JSON response
pub let get_json: { url: String } -> Result Json HttpError <Http> = { url } -> do
    let resp = get { url = url }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json } -> Ok { val = json }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# POST with JSON body
pub let post_json: { url: String, json: Json } -> Result Response HttpError <Http> = { url, json } -> do
    let body_str = to_string { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Post, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = default_http_config }

# PUT with JSON body
pub let put_json: { url: String, json: Json } -> Result Response HttpError <Http> = { url, json } -> do
    let body_str = to_string { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Put, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = default_http_config }

# PATCH with JSON body
pub let patch_json: { url: String, json: Json } -> Result Response HttpError <Http> = { url, json } -> do
    let body_str = to_string { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Patch, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = default_http_config }

# POST JSON body, expect JSON response
pub let post_json_json: { url: String, json: Json } -> Result Json HttpError <Http> = { url, json } -> do
    let resp = post_json { url = url, json = json }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json_resp } -> Ok { val = json_resp }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# PUT JSON body, expect JSON response
pub let put_json_json: { url: String, json: Json } -> Result Json HttpError <Http> = { url, json } -> do
    let resp = put_json { url = url, json = json }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json_resp } -> Ok { val = json_resp }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# PATCH JSON body, expect JSON response
pub let patch_json_json: { url: String, json: Json } -> Result Json HttpError <Http> = { url, json } -> do
    let resp = patch_json { url = url, json = json }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json_resp } -> Ok { val = json_resp }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# GET JSON with custom config
pub let get_json_with: { url: String, config: HttpConfig } -> Result Json HttpError <Http> = { url, config } -> do
    let resp = get_with { url = url, config = config }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json } -> Ok { val = json }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# POST JSON with custom config
pub let post_json_with: { url: String, json: Json, config: HttpConfig } -> Result Response HttpError <Http> = { url, json, config } -> do
    let body_str = to_string { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Post, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = config }

# POST JSON, expect JSON with custom config
pub let post_json_json_with: { url: String, json: Json, config: HttpConfig } -> Result Json HttpError <Http> = { url, json, config } -> do
    let resp = post_json_with { url = url, json = json, config = config }
    match resp is
        Ok { val } -> match body_json { resp = val } is
            Ok { val = json_resp } -> Ok { val = json_resp }
            Err { error } -> Err { error = DecodeError { url = url, message = error.message } }
        Err { error } -> Err { error = error }

# =============================================================================
# TYPED BODY HELPERS (using Encode/Decode abilities)
# =============================================================================

# POST any encodable type as JSON body
pub let post_body: { url: String, body: 'a } -> Result Response HttpError <Http> with Encode Json 'a = { url, body } -> do
    match Encode.encode { val = body, config = default_config } is
        Ok { val = json } -> do
            let body_str = to_string { json = json }
            let body_bytes = bytes::from_string { s = body_str }
            let req = make_request_with_body { method = Post, url = url, body = body_bytes }
            let req = with_content_type { req = req, content_type = "application/json" }
            Http.request { req = req, config = default_http_config }
        Err { error } -> Err { error = EncodeError { url = url, message = error.message } }

# PUT any encodable type as JSON body
pub let put_body: { url: String, body: 'a } -> Result Response HttpError <Http> with Encode Json 'a = { url, body } -> do
    match Encode.encode { val = body, config = default_config } is
        Ok { val = json } -> do
            let body_str = to_string { json = json }
            let body_bytes = bytes::from_string { s = body_str }
            let req = make_request_with_body { method = Put, url = url, body = body_bytes }
            let req = with_content_type { req = req, content_type = "application/json" }
            Http.request { req = req, config = default_http_config }
        Err { error } -> Err { error = EncodeError { url = url, message = error.message } }

# PATCH any encodable type as JSON body
pub let patch_body: { url: String, body: 'a } -> Result Response HttpError <Http> with Encode Json 'a = { url, body } -> do
    match Encode.encode { val = body, config = default_config } is
        Ok { val = json } -> do
            let body_str = to_string { json = json }
