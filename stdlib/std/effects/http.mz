# HTTP methods
# HTTP methods
# HTTP methods
# HTTP methods
pub type Method = | Get, Post, Put, Delete, Patch, Head, Options |

# HTTP configuration (comprehensive settings for production use)
pub type HttpConfig = {
  timeout_ms: Int,
  connect_timeout_ms: Int,
  follow_redirects: Bool,
  max_redirects: Int,
  verify_ssl: Bool,
  auto_decompress: Bool,
  keep_alive: Bool,
}

# Timeouts (in milliseconds)
pub let default_http_config : HttpConfig = {
  timeout_ms = 30000,
  connect_timeout_ms = 10000,
  follow_redirects = True,
  max_redirects = 10,
  verify_ssl = True,
  auto_decompress = True,
  keep_alive = True,
}

pub type Request = {
  method: Method,
  url: Str,
  headers: Map Str Str,
  body: Option Bytes,
  timeout_ms: Option Int,
}

pub type Response = { status: Int, headers: Map Str Str, body: Bytes }

pub type HttpError = |
  ConnectionFailed { url: Str, reason: Str },
  Timeout { url: Str, ms: Int },
  InvalidUrl { url: Str, reason: Str },
  TlsError { url: Str, reason: Str },
  RequestFailed { url: Str, status: Int, body: Str },
  DecodeError { url: Str, message: Str },
  EncodeError { url: Str, message: Str },
  Cancelled,
|

pub type UrlPattern = | Glob { pattern: Str } |

pub type MockRule = {
  methods: [Method],
  url: UrlPattern,
  response: Result Response HttpError,
}

effect Http where {
  request: { req: Request, config: HttpConfig } -> Result Response HttpError <Http>
}

impl Http for HttpClient where {
  initialize_scope = {} -> do
    let client = __native_http_client_create {}
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req, config } ->
    __native_http_request { req = req, config = config, client = scope.client },
}

impl Http for HttpClientWith { config: HttpConfig } where {
  initialize_scope = {} -> do
    let client = __native_http_client_create {}
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req: 'req, config: default_config } ->
    __native_http_request { req = req, config = config, client = scope.client },
}

impl Http for SimpleHttpClient where {
  request = { req, config } -> do
    let client = __native_http_client_create {}
    let result = __native_http_request { req = req, config = config, client = client }
    __native_http_client_close { client = client }
    result
}

impl Http for SimpleHttpClientWith { config: HttpConfig } where {
  request = { req: 'req, config: default_config } -> do
    let client = __native_http_client_create {}
    let result = __native_http_request { req = req, config = config, client = client }
    __native_http_client_close { client = client }
    result
}

impl Http for MockHttpClient { rules: [MockRule] } where {
  request = { req, config } -> __native_http_mock_request { req = req, rules = rules }
}

pub let make_request : { method: Method, url: Str } -> Request = { method, url } ->
  {
    method = method,
    url = url,
    headers = map::empty {},
    body = None,
    timeout_ms = None,
  }

pub let make_request_with_body : { method: Method, url: Str, body: Bytes } -> Request = { method, url, body } ->
  {
    method = method,
    url = url,
    headers = map::empty {},
    body = Some { val = body },
    timeout_ms = None,
  }

pub let make_request_with_headers : { method: Method, url: Str, headers: Map Str Str } -> Request = { method, url, headers } ->
  {
    method = method,
    url = url,
    headers = headers,
    body = None,
    timeout_ms = None,
  }

pub let make_full_request : { method: Method, url: Str, headers: Map Str Str, body: Option Bytes, timeout_ms: Option Int } -> Request = { method, url, headers, body, timeout_ms } ->
  {
    method = method,
    url = url,
    headers = headers,
    body = body,
    timeout_ms = timeout_ms,
  }

pub let with_header : { req: Request, key: Str, value: Str } -> Request = { req, key, value } ->
  {
    method = req.method,
    url = req.url,
    headers = map::insert { m = req.headers, k = key, v = value },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

pub let with_headers : { req: Request, headers: Map Str Str } -> Request = { req, headers } ->
  {
    method = req.method,
    url = req.url,
    headers = map::merge { m1 = req.headers, m2 = headers },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

pub let with_body : { req: Request, body: Bytes } -> Request = { req, body } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = Some { val = body },
    timeout_ms = req.timeout_ms,
  }

pub let with_timeout : { req: Request, ms: Int } -> Request = { req, ms } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = Some { val = ms },
  }

pub let with_content_type : { req: Request, content_type: Str } -> Request = { req, content_type } ->
  with_header { req = req, key = "Content-Type", value = content_type }

pub let with_accept : { req: Request, accept: Str } -> Request = { req, accept } ->
  with_header { req = req, key = "Accept", value = accept }

pub let with_auth : { req: Request, auth: Str } -> Request = { req, auth } ->
  with_header { req = req, key = "Authorization", value = auth }

pub let get : { url: Str } -> Result Response HttpError <Http> = { url } ->
  Http.request {
    req = make_request { method = Get, url = url },
    config = default_http_config,
  }

pub let post : { url: Str, body: Bytes } -> Result Response HttpError <Http> = { url, body } ->
  Http.request {
    req = make_request_with_body { method = Post, url = url, body = body },
    config = default_http_config,
  }

pub let put : { url: Str, body: Bytes } -> Result Response HttpError <Http> = { url, body } ->
  Http.request {
    req = make_request_with_body { method = Put, url = url, body = body },
    config = default_http_config,
  }

