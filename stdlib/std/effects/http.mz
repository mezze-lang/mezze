pub let body_string : { resp: Response } -> Result Str Str = { resp } ->
  bytes::to_str { b = resp.body }

pub let body_json : { resp: Response } -> Result Json DecodeError = { resp } -> do
  match body_string { resp = resp } is
    Ok { val } -> parse_str { s = val }
    Err { error } -> Err {
      error = {
        path = [],
        message = error,
        expected = "UTF-8",
        found = None,
      },
    }


pub let is_success : { resp: Response } -> Bool = { resp } ->
  resp.status >= 200 && resp.status < 300

pub let is_redirect : { resp: Response } -> Bool = { resp } ->
  resp.status >= 300 && resp.status < 400

pub let is_client_error : { resp: Response } -> Bool = { resp } ->
  resp.status >= 400 && resp.status < 500

pub let is_server_error : { resp: Response } -> Bool = { resp } ->
  resp.status >= 500 && resp.status < 600

pub let get_header : { resp: Response, name: Str } -> Option Str = { resp, name } ->
  map::get { m = resp.headers, k = str::to_lower { s = name } }

pub let get_content_type : { resp: Response } -> Option Str = { resp } ->
  get_header { resp = resp, name = "content-type" }

pub let get_content_length : { resp: Response } -> Option Int = { resp } -> match get_header { resp = resp, name = "content-length" } is
  Some { val } -> int::from_string { s = val }
  None -> None


pub let json_headers : {} -> Map Str Str = {} -> do
  let m = map::empty {}
  let m = map::insert { m = m, k = "Content-Type", v = "application/json" }
  map::insert { m = m, k = "Accept", v = "application/json" }

pub let get_json : { url: Str } -> Result Json HttpError <Http> = { url } -> do
  let resp = get { url = url }
  match resp is
    Ok { val } -> match body_json { resp = val } is
      Ok { val = json } -> Ok { val = json }
      Err { error } -> Err {
        error = DecodeError { url = url, message = error.message },
      }
    Err { error } -> Err { error = error }


pub let post_json : { url: Str, json: Json } -> Result Response HttpError <Http> = { url, json } ->
  do
    let body_str = to_str { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Post, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = default_http_config }

pub let put_json : { url: Str, json: Json } -> Result Response HttpError <Http> = { url, json } ->
  do
    let body_str = to_str { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Put, url = url, body = body_bytes }
    let req = with_content_type { req = req, content_type = "application/json" }
    Http.request { req = req, config = default_http_config }

pub let patch_json : { url: Str, json: Json } -> Result Response HttpError <Http> = { url, json } ->
  do
    let body_str = to_str { json = json }
    let body_bytes = bytes::from_string { s = body_str }
    let req = make_request_with_body { method = Patch, url = url, body = body_bytes }
