use std::codec::json::{ Json, JsonFmt, json_fmt, to_str, parse_str }
use std::codec::core::{ EncodeRepr, Decode, DecodeError, EncodeError, CodecConfig, FieldTransform, default_config, Format, DecodeFormat }
use std::collections::map
use std::collections::seq
use std::collections::bytes
use std::str
use std::int

## HTTP request methods.
pub type Method = | Get, Post, Put, Delete, Patch, Head, Options |

## HTTP client configuration.
pub type HttpConfig = {
  timeout_ms: Int,
  connect_timeout_ms: Int,
  follow_redirects: Bool,
  max_redirects: Int,
  verify_ssl: Bool,
  auto_decompress: Bool,
  keep_alive: Bool,
}

## Sensible defaults for HTTP configuration.
pub let default_http_config : HttpConfig = {
  timeout_ms = 30000,
  connect_timeout_ms = 10000,
  follow_redirects = True,
  max_redirects = 10,
  verify_ssl = True,
  auto_decompress = True,
  keep_alive = True,
}

## HTTP request record.
pub type Request = {
  method: Method,
  url: Str,
  headers: Map Str Str,
  body: Option Bytes,
  timeout_ms: Option Int,
}

## HTTP response record.
pub type Response = { status: Int, headers: Map Str Str, body: Bytes }

## HTTP error variants.
pub type HttpError = |
  ConnectionFailed { url: Str, reason: Str },
  Timeout { url: Str, ms: Int },
  InvalidUrl { url: Str, reason: Str },
  TlsError { url: Str, reason: Str },
  RequestFailed { url: Str, status: Int, body: Str },
  DecodeError { url: Str, message: Str },
  EncodeError { url: Str, message: Str },
  Cancelled,
|

## URL pattern for mock matching.
pub type UrlPattern = | Glob { pattern: Str } |

## A mock rule matching methods and URL pattern to a canned response.
pub type MockRule = {
  methods: [Method],
  url: UrlPattern,
  response: Result Response HttpError,
}

## HTTP client effect.
effect Http where {
  ## Send an HTTP request with the given config.
  request: { req: Request, config: HttpConfig } -> Result Response HttpError <Http>
}

## Connection-pooling HTTP client (scoped -- creates/closes client per handler).
impl Http for HttpClient where {
  initialize_scope = {} -> do
    let client = __native_http_client_create {}
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req, config } ->
    __native_http_request { req = req, config = config, client = scope.client },
}

## Connection-pooling HTTP client with a fixed config override.
impl Http for HttpClientWith { config: HttpConfig } where {
  initialize_scope = {} -> do
    let client = __native_http_client_create {}
    { client = client },
  finalize_scope = {} -> do
    __native_http_client_close { client = scope.client }
    {},
  request = { req: 'req, config: default_config } ->
    __native_http_request { req = req, config = config, client = scope.client },
}

## Simple HTTP client that creates a new connection per request.
impl Http for SimpleHttpClient where {
  request = { req, config } -> do
    let client = __native_http_client_create {}
    let result = __native_http_request { req = req, config = config, client = client }
    __native_http_client_close { client = client }
    result
}

## Simple HTTP client with a fixed config override.
impl Http for SimpleHttpClientWith { config: HttpConfig } where {
  request = { req: 'req, config: default_config } -> do
    let client = __native_http_client_create {}
    let result = __native_http_request { req = req, config = config, client = client }
    __native_http_client_close { client = client }
    result
}

## Mock HTTP client for testing with canned responses.
impl Http for MockHttpClient { rules: [MockRule] } where {
  request = { req, config } -> __native_http_mock_request { req = req, rules = rules }
}

## Build a minimal request with method and URL.
pub let make_request : { method: Method, url: Str } -> Request = { method, url } ->
  {
    method = method,
    url = url,
    headers = map::empty {},
    body = None,
    timeout_ms = None,
  }

## Build a fully specified request. Used by impl Client's verb shortcuts;
## the explicit Request return type pins the impl op so cross-module
## chain dispatch can recover the nominal shape (see #182 notes on the
## Client impl).
pub let make_full_request : { method: Method, url: Str, headers: Map Str Str, body: Option Bytes, timeout_ms: Option Int } -> Request = { method, url, headers, body, timeout_ms } ->
  {
    method = method,
    url = url,
    headers = headers,
    body = body,
    timeout_ms = timeout_ms,
  }

## Add a single header to a request.
pub let with_header : { req: Request, key: Str, value: Str } -> Request = { req, key, value } ->
  {
    method = req.method,
    url = req.url,
    headers = map::insert { m = req.headers, k = key, v = value },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Merge additional headers into a request.
pub let with_headers : { req: Request, headers: Map Str Str } -> Request = { req, headers } ->
  {
    method = req.method,
    url = req.url,
    headers = map::merge { m1 = req.headers, m2 = headers },
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Set the body of a request.
pub let with_body : { req: Request, body: Bytes } -> Request = { req, body } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = Some { val = body },
    timeout_ms = req.timeout_ms,
  }

## Set a per-request timeout in milliseconds.
pub let with_timeout : { req: Request, ms: Int } -> Request = { req, ms } ->
  {
    method = req.method,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = Some { val = ms },
  }

## Set the Content-Type header.
pub let with_content_type : { req: Request, content_type: Str } -> Request = { req, content_type } ->
  with_header { req = req, key = "Content-Type", value = content_type }

## Set the Accept header.
pub let with_accept : { req: Request, accept: Str } -> Request = { req, accept } ->
  with_header { req = req, key = "Accept", value = accept }

## Set the Authorization header.
pub let with_auth : { req: Request, auth: Str } -> Request = { req, auth } ->
  with_header { req = req, key = "Authorization", value = auth }

## Decode response body as a UTF-8 string.
pub let body_string : { resp: Response } -> Result Str Str = { resp } ->
  bytes::to_str { b = resp.body }

## Decode response body as JSON.
pub let body_json : { resp: Response } -> Result Json DecodeError = { resp } -> do
  match body_string { resp = resp } is
    Ok { val } -> parse_str { s = val }
    Err { error } -> Err {
      error = {
        path = [],
        message = error,
        expected = "UTF-8",
        found = None,
      },
    }


## Check if response status is 2xx.
pub let is_success : { resp: Response } -> Bool = { resp } ->
  resp.status >= 200 && resp.status < 300

## Check if response status is 3xx.
pub let is_redirect : { resp: Response } -> Bool = { resp } ->
  resp.status >= 300 && resp.status < 400

## Check if response status is 4xx.
pub let is_client_error : { resp: Response } -> Bool = { resp } ->
  resp.status >= 400 && resp.status < 500

## Check if response status is 5xx.
pub let is_server_error : { resp: Response } -> Bool = { resp } ->
  resp.status >= 500 && resp.status < 600

## Get a response header by name (case-insensitive).
pub let get_header : { resp: Response, name: Str } -> Option Str = { resp, name } ->
  map::get { m = resp.headers, k = str::to_lower { s = name } }

## Get the Content-Type header.
pub let get_content_type : { resp: Response } -> Option Str = { resp } ->
  get_header { resp = resp, name = "content-type" }

## Get the Content-Length header as Int.
pub let get_content_length : { resp: Response } -> Option Int = { resp } -> match get_header { resp = resp, name = "content-length" } is
  Some { val } -> int::from_string { s = val }
  None -> None


## Create a Bearer token Authorization header map.
pub let bearer_auth : { token: Str } -> Map Str Str = { token } ->
  map::insert {
    m = map::empty {},
    k = "Authorization",
    v = str::concat { l = "Bearer ", r = token },
  }

## Create a Basic auth Authorization header map.
pub let basic_auth : { username: Str, password: Str } -> Map Str Str = { username, password } ->
  do
    let credentials = str::concat {
      l = username,
      r = str::concat { l = ":", r = password },
    }
    let encoded = __native_base64_encode { s = credentials }
    map::insert {
      m = map::empty {},
      k = "Authorization",
      v = str::concat { l = "Basic ", r = encoded },
    }

## Create a custom API key header map.
pub let api_key_header : { key: Str, value: Str } -> Map Str Str = { key, value } ->
  map::insert { m = map::empty {}, k = key, v = value }

## Create an X-API-Key header map.
pub let x_api_key : { key: Str } -> Map Str Str = { key } ->
  map::insert { m = map::empty {}, k = "X-API-Key", v = key }

# ─── Chainable surface ────────────────────────────────────────────────
#
# The chainable API lets you build a request via dot-method composition:
#
#   request { url = "https://api.acme.com/users" }
#     .with_method   { val = Post }
#     .with_auth     { val = "Bearer xyz" }
#     .with_json     { val = my_json }
#     .with_timeout  { ms = 5000 }
#     .send {}
#
# Underneath every impl method delegates to the corresponding free
# function — they're not duplicate logic, just chain-friendly aliases.

## Build a fresh GET Request for a URL. All fields zero-initialized
## (no headers, no body, default timeout). Configure further with
## `req.with_*` methods, then `req.send {}`.
pub let request : { url: Str } -> Request = { url } ->
  make_request { method = Get, url = url }

## Body setter — wrap raw bytes (already encoded).
pub let with_text : { req: Request, val: Str } -> Request = { req, val } ->
  with_body { req = req, body = bytes::from_string { s = val } }

## Body setter — encode JSON, set Content-Type: application/json.
pub let with_json : { req: Request, val: Json } -> Request = { req, val } -> do
  let body_str = to_str { json = val }
  let body_bytes = bytes::from_string { s = body_str }
  let r = with_body { req = req, body = body_bytes }
  with_content_type { req = r, content_type = "application/json" }

## Method setter — alias of with_method.
pub let with_method : { req: Request, val: Method } -> Request = { req, val } ->
  {
    method = val,
    url = req.url,
    headers = req.headers,
    body = req.body,
    timeout_ms = req.timeout_ms,
  }

## Impl Request gives the chainable surface. Every method is a thin
## delegator to a free function above — the impl block is just an
## ergonomic wrapper. Method calls return new Requests (immutable
## builder).
impl Request where {
  with_method      = { it, val: Method }  -> with_method      { req = it, val = val },
  with_url         = { it, val: Str }     -> { method = it.method, url = val, headers = it.headers, body = it.body, timeout_ms = it.timeout_ms },
  with_header      = { it, key: Str, value: Str } -> with_header      { req = it, key = key, value = value },
  with_headers     = { it, headers: Map Str Str } -> with_headers     { req = it, headers = headers },
  with_body        = { it, val: Bytes }   -> with_body        { req = it, body = val },
  with_text        = { it, val: Str }     -> with_text        { req = it, val = val },
  with_json        = { it, val: Json }    -> with_json        { req = it, val = val },
  with_timeout     = { it, ms: Int }      -> with_timeout     { req = it, ms = ms },
  with_auth        = { it, val: Str }     -> with_auth        { req = it, auth = val },
  with_content_type = { it, val: Str }    -> with_content_type { req = it, content_type = val },
  with_accept      = { it, val: Str }     -> with_accept      { req = it, accept = val },
  ## Terminal — perform the request via the ambient Http handler.
  send             = { it } -> Http.request { req = it, config = default_http_config },
  ## Terminal with config override.
  send_with        = { it, config: HttpConfig } -> Http.request { req = it, config = config },
}

## Impl Response gives chainable decoders + predicates + header lookup.
## Direct field access (resp.status, resp.body, resp.headers) still
## works for raw projection — the impl methods only add operations
## that aren't just field reads.
impl Response where {
  ## Decode body as UTF-8 string.
  text          = { it } -> body_string { resp = it },
  ## Decode body as JSON.
  json          = { it } -> body_json { resp = it },
  ## 2xx status check.
  is_ok         = { it } -> is_success { resp = it },
  is_success    = { it } -> is_success { resp = it },
  is_redirect   = { it } -> is_redirect { resp = it },
  is_client_err = { it } -> is_client_error { resp = it },
  is_server_err = { it } -> is_server_error { resp = it },
  ## Case-insensitive header lookup.
  header        = { it, name: Str } -> get_header { resp = it, name = name },
  content_type  = { it } -> get_content_type { resp = it },
  content_length = { it } -> get_content_length { resp = it },
}

## A reusable HTTP client value. Bind a service's base URL, default
## headers (auth, accept, etc.), and default timeout once — derive
## requests from it for each call.
##
##   let api = client { base_url = "https://api.acme.com" }
##     .with_auth    { val = "Bearer " ++ token }
##     .with_timeout { ms = 30000 }
##   let user = api.get { path = "/users/42" }.send {}
pub type Client = {
  base_url: Str,
  default_headers: Map Str Str,
  default_timeout_ms: Int,
}

## Build a fresh Client. Empty base URL means use absolute URLs in
## each request.
pub let client : { base_url: Str } -> Client = { base_url } ->
  {
    base_url = base_url,
    default_headers = map::empty {},
    default_timeout_ms = 30000,
  }

## Build a Client with no base URL — every request uses an absolute URL.
pub let no_base_client : {} -> Client = {} ->
  client { base_url = "" }

## Join base_url + path. If path is absolute (starts with http:// or
## https://) it overrides base_url; otherwise base_url + path with
## one slash between.
let join_url : { base: Str, path: Str } -> Str = { base, path } ->
  if str::starts_with { s = path, prefix = "http://" } || str::starts_with { s = path, prefix = "https://" }
  then path
  else if str::is_empty { s = base }
  then path
  else if str::ends_with { s = base, suffix = "/" } && str::starts_with { s = path, prefix = "/" }
  then str::concat { l = base, r = str::substring { s = path, start = 1, end = str::size { s = path } } }
  else if str::ends_with { s = base, suffix = "/" } || str::starts_with { s = path, prefix = "/" }
  then str::concat { l = base, r = path }
  else str::concat { l = str::concat { l = base, r = "/" }, r = path }

## Impl Client gives configuration + verb shortcuts. Each verb method
## produces a Request pre-filled with the client's defaults (headers,
## timeout, base_url + path).
impl Client where {
  ## Configuration setters.
  with_base_url        = { it, val: Str } -> { base_url = val, default_headers = it.default_headers, default_timeout_ms = it.default_timeout_ms },
  with_default_header  = { it, key: Str, value: Str } -> { base_url = it.base_url, default_headers = map::insert { m = it.default_headers, k = key, v = value }, default_timeout_ms = it.default_timeout_ms },
  with_default_headers = { it, headers: Map Str Str } -> { base_url = it.base_url, default_headers = map::merge { m1 = it.default_headers, m2 = headers }, default_timeout_ms = it.default_timeout_ms },
  with_default_timeout = { it, ms: Int } -> { base_url = it.base_url, default_headers = it.default_headers, default_timeout_ms = ms },
  ## Convenience: set Authorization in default_headers.
  with_auth            = { it, val: Str } -> { base_url = it.base_url, default_headers = map::insert { m = it.default_headers, k = "Authorization", v = val }, default_timeout_ms = it.default_timeout_ms },
  ## Verb shortcuts — return a Request pre-filled with the client's defaults.
  ## Verb shortcuts — delegate to make_full_request so the impl op's
  ## return type stays pinned to Request (a nominal TypeApplication)
  ## instead of an open structural record. Without this, the lambda's
  ## body type at the home module collapses field types to bare
  ## TypeVars and the chain `c.get { path }.send {}` can't unify the
  ## structural result against `Request` in the importer module.
  get     = { it, path: Str } -> make_full_request {
    method = Get, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  post    = { it, path: Str } -> make_full_request {
    method = Post, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  put     = { it, path: Str } -> make_full_request {
    method = Put, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  delete  = { it, path: Str } -> make_full_request {
    method = Delete, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  patch   = { it, path: Str } -> make_full_request {
    method = Patch, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  head    = { it, path: Str } -> make_full_request {
    method = Head, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  options = { it, path: Str } -> make_full_request {
    method = Options, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
  ## Verb-free request builder — set method later via .with_method.
  request = { it, path: Str } -> make_full_request {
    method = Get, url = join_url { base = it.base_url, path = path },
    headers = it.default_headers, body = None,
    timeout_ms = Some { val = it.default_timeout_ms },
  },
}

use std::effects::async::{ Async, AsyncError, par_map }

## Fetch multiple URLs concurrently, returning a list of Results.
##
## `par_map` returns `[Result Response AsyncError]` per spawn; we collapse
## each AsyncError into a single HTTP-level ConnectionFailed so callers
## see a uniform `[Result Response HttpError]`.
pub let fetch_all : { urls: [Str] } -> [Result Response HttpError] <Http, Async> = { urls } ->
  seq::map {
    xs = par_map { xs = urls, f = { x } -> request { url = x }.send {} },
    f = { x } -> match x is
      Ok  { val = inner } -> inner
      Err { error = e }   -> Err { error = ConnectionFailed { url = "<spawn>", reason = "async task failed" } },
  }

## Fetch multiple URLs concurrently, failing on the first error.
pub let fetch_all_ok : { urls: [Str] } -> Result [Response] HttpError <Http, Async> = { urls } ->
  do
    let results = fetch_all { urls = urls }
    collect_results { results = results }

let collect_results : { results: [Result 'a 'e] } -> Result ['a] 'e = { results } ->
  do
    let len = seq::size { xs = results }
    collect_results_loop {
      results = results,
      idx = 0,
      len = len,
      acc = [],
    }

let collect_results_loop : { results: [Result 'a 'e], idx: Int, len: Int, acc: ['a] } -> Result ['a] 'e = { results, idx, len, acc } ->
  if idx >= len then Ok { val = acc } else match seq::get { xs = results, i = idx } is
    Some { val } -> match val is
      Ok { val = v } -> collect_results_loop {
        results = results,
        idx = idx + 1,
        len = len,
        acc = seq::add { xs = acc, x = v },
      }
      Err { error } -> Err { error = error }
    None -> Ok { val = acc }


## Format an HttpError as a human-readable string.
pub let format_error : { err: HttpError } -> Str = { err } -> match err is
  ConnectionFailed { url, reason } -> str::concat {
    l = "Connection failed to ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  Timeout { url, ms } -> str::concat {
    l = "Request timed out after ",
    r = str::concat {
      l = int::to_str { n = ms },
      r = str::concat { l = "ms: ", r = url },
    },
  }
  InvalidUrl { url, reason } -> str::concat {
    l = "Invalid URL '",
    r = str::concat { l = url, r = str::concat { l = "': ", r = reason } },
  }
  TlsError { url, reason } -> str::concat {
    l = "TLS error for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = reason } },
  }
  RequestFailed { url, status, body } -> str::concat {
    l = "Request failed with status ",
    r = str::concat {
      l = int::to_str { n = status },
      r = str::concat { l = ": ", r = body },
    },
  }
  DecodeError { url, message } -> str::concat {
    l = "Failed to decode response from ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  EncodeError { url, message } -> str::concat {
    l = "Failed to encode request for ",
    r = str::concat { l = url, r = str::concat { l = ": ", r = message } },
  }
  Cancelled -> "Request was cancelled"


## Check if an HTTP error is retryable (connection/timeout/5xx).
pub let is_retryable : { err: HttpError } -> Bool = { err } -> match err is
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> False
  InvalidUrl { url, reason } -> False
  RequestFailed { url, status, body } -> status >= 500
  DecodeError { url, message } -> False
  EncodeError { url, message } -> False
  Cancelled -> False


## Check if the error is a client-side issue (4xx / bad input).
pub let is_client_issue : { err: HttpError } -> Bool = { err } -> match err is
  InvalidUrl { url, reason } -> True
  EncodeError { url, message } -> True
  RequestFailed { url, status, body } -> status >= 400 && status < 500
  _ -> False


## Check if the error is a server-side issue (5xx / network).
pub let is_server_issue : { err: HttpError } -> Bool = { err } -> match err is
  RequestFailed { url, status, body } -> status >= 500
  ConnectionFailed { url, reason } -> True
  Timeout { url, ms } -> True
  TlsError { url, reason } -> True
  _ -> False
