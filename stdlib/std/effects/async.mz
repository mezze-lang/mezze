# =============================================================================
# Helper Functions
# =============================================================================
# Short alias for spawn + wait (run synchronously)
# Spawn and immediately detach (fire and forget)
# =============================================================================
# Convenience Wrappers
# =============================================================================
# Run computation with CoopAsync handler (cooperative scheduling)
# Equivalent to: perform CoopAsync in computation {}
# =============================================================================
# Scope Functions - Helpers for Structured Concurrency Scopes
# =============================================================================
#
# These functions help with spawning tasks within a structured concurrency scope.
# Tasks spawned via scope_spawn are tracked by the scope and automatically
# awaited when the scope ends.
#
# Usage:
#   perform LoomAsync in do
#       Async.scoped {f = {sc} -> do
#           let p1 = scope_spawn {sc = sc, f = {} -> task1 {}}
#           let p2 = scope_spawn {sc = sc, f = {} -> task2 {}}
#           # p1 and p2 are awaited automatically before scoped returns
#           process {p1 = Async.await {p = p1}, p2 = Async.await {p = p2}}
#       }
# Spawn a task within a scope
# The scope will wait for this task to complete before exiting
# Note: f accepts any effects (<...>) for effect polymorphism
#
# Example:
#   scope_spawn {sc = sc, f = {} -> expensive_computation {}}
# Cancel all tasks in the scope
#
# Example:
#   scope_cancel_all {sc = sc}
# Get the CancellationToken for a scope
#
# Each scope has an associated CancellationToken that tasks can use
# to check for cancellation or register cleanup callbacks.
#
# Example:
#   Async.scoped {f = {sc} -> do
#       let token = scope_get_token {sc = sc}
#       scope_spawn {sc = sc, f = {} -> do
#           # Periodically check for cancellation
#           while not (Cancellation.is_cancelled {token = token}) do
#               process_batch {}
#       }
#   }
# Check if a scope has been cancelled
#
# Example:
#   if scope_is_cancelled {sc = sc} then
#       cleanup {}
#   else
#       continue_work {}
