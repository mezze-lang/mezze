use std::collections::seq
use std::collections::iter
use std::abilities::compare::{ Eq, Hash, structural_hash }
use std::result
use std::effects::exception::{ Exception, unwrap }
use std::effects::time::{ Time }
use std::datetime::{ duration_millis }
use std::int
use std::bool

## Opaque promise representing an asynchronous computation.
pub newtype Promise 'a = __NativePromise

## Opaque scope for structured concurrency.
pub newtype Scope 'a = __NativeScope

pub let promise_eq: { l: Promise 'a, r: Promise 'a } -> Bool = { l, r } ->
  __native_ref_eq { l = l, r = r }

pub let promise_neq: { l: Promise 'a, r: Promise 'a } -> Bool = { l, r } ->
  __native_ref_neq { l = l, r = r }

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for Promise 'a where {
  hash: { it: Promise 'a } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for Promise 'a where {
  eq = { it, r } -> promise_eq { l = it, r = r },
  neq = { it, r } -> promise_neq { l = it, r = r },
}

pub let scope_eq: { l: Scope 'a, r: Scope 'a } -> Bool = { l, r } ->
  __native_ref_eq { l = l, r = r }

pub let scope_neq: { l: Scope 'a, r: Scope 'a } -> Bool = { l, r } ->
  __native_ref_neq { l = l, r = r }

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for Scope 'a where {
  hash: { it: Scope 'a } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for Scope 'a where {
  eq = { it, r } -> scope_eq { l = it, r = r },
  neq = { it, r } -> scope_neq { l = it, r = r },
}

## Block until the Promise resolves, returning success or AsyncError.
pub let await: { p: Promise 'a } -> Result 'a AsyncError <Async> = { p } ->
  __native_promise_await_result { p = p }

## Non-blocking snapshot of the Promise's state.
pub let inspect: { p: Promise 'a } -> PromiseState 'a = { p } ->
  __native_promise_inspect { p = p }

pub let is_done: { p: Promise 'a } -> Bool = { p } -> match __native_promise_inspect { p = p } is
  Pending -> False
  _ -> True


pub let is_pending: { p: Promise 'a } -> Bool = { p } -> match __native_promise_inspect { p = p } is
  Pending -> True
  _ -> False


pub let is_failed: { p: Promise 'a } -> Bool = { p } -> match __native_promise_inspect { p = p } is
  Failed { err = _ } -> True
  _ -> False


pub let is_cancelled: { p: Promise 'a } -> Bool = { p } -> match __native_promise_inspect { p = p } is
  Failed { err = AsyncCancelled { reason = _ } } -> True
  _ -> False


## Request cancellation. `reason` is mandatory — every cancel names why.
##
## The reason is propagated into the cancelled Promise's error state as
## `AsyncCancelled { reason }`, visible to awaiters and `inspect`
## observers. If you don't have a natural category, pass
## `Custom { tag = "...", detail = "..." }`.
pub let cancel: { p: Promise 'a, reason: CancelReason } -> CancelOutcome <Async> = { p, reason } ->
  __native_promise_cancel { p = p, reason = reason }

## ==================================================================
## User-space Promise constructors (#77, #80)
##
## Three constructors — one primitive + two sugars. `promise_from` is
## the general form: it invokes `setup` with a
## { complete, fail, on_cancel } capability record. Whichever
## resolve-capability setup invokes atomically transitions the promise
## to that state; subsequent transitions are no-ops (CAS on the state
## field). If setup raises, the promise is auto-failed so it doesn't
## leak in Pending forever.
##
## `setup` may invoke:
##   - `complete { val = ... }` — resolve the promise successfully.
##   - `fail { err = ... }` — resolve with an AsyncError.
##   - `on_cancel { hook = { reason } -> ... }` — register a cancel
##     hook. Fires with the CancelReason when the promise is cancelled
##     (via Async.cancel or scope teardown). Last-writer-wins if called
##     multiple times. Not required — omit if the backend has no cancel
##     channel of its own.
##
## `setup` may call neither resolve capability — the async case, where
## a background task fulfills the promise later. That's exactly how a
## third-party async backend (Kotlin coroutines, CompletableFuture,
## Vert.x, ...) plugs in: build the promise, launch work on the
## foreign scheduler, register `complete`/`fail` as the completion
## callbacks, and route Mezze's cancel back to the foreign scheduler
## via `on_cancel`.
## ==================================================================
## Construct a Promise via a setup callback that receives three
## write-side capabilities. See module comment above for semantics.
pub let promise_from
  : { setup: { complete: { val: 'a } -> {}, fail: { err: AsyncError } -> {}, on_cancel: { hook: { reason: CancelReason } -> {} <...> } -> {} <...> } -> {} <...> }
  -> Promise 'a
  = { setup } -> __native_promise_from { setup = setup }

## A Promise already resolved with `val`. Sugar over promise_from.
pub let promise_of: { val: 'a } -> Promise 'a = { val } -> __native_promise_succeed { val = val }

## A Promise already failed with `err`. Sugar over promise_from.
pub let promise_failed: { err: AsyncError } -> Promise 'a = { err } ->
  __native_promise_fail { err = err }

## Sleep for the given milliseconds. Delegates to Time.sleep.
pub let sleep: { ms: Int } -> {} <Time> = { ms } ->
  Time.sleep { d = duration_millis { n = ms } }

## Voluntarily yield the current task's execution slot.
pub let yield_now: {} -> {} <Async> = {} -> __native_async_yield_now {}

## Suspend until predicate returns True.
pub let park: { predicate: {} -> Bool <...> } -> {} <Async, ...> = { predicate } ->
  __native_async_park_until { predicate = predicate }

## Suspend until `predicate` returns True, or until `ms` milliseconds pass.
## True means the predicate won; False means the deadline did. `ms = 0` is a
## poll: check once and report.
##
## The deadline is measured by the thread that WAITS, which is what makes a
## timeout built on this predictable. The alternative — spawn a task that
## sleeps, then park until either it or the target is done — makes the answer
## depend on a second promise being scheduled, and on it SUCCEEDING: `is_done`
## holds for a failed promise too, so a sleeper that died reported a deadline
## that had not elapsed. Worse, `sleep` performs `Time`, and the effect row of a
## spawned callback is absorbed at the spawn, so a caller with no `Time`
## performer installed hit that case with nothing in the types to warn them.
pub let park_until: { predicate: {} -> Bool <...>, ms: Int } -> Bool <Async, ...> =
  { predicate, ms } -> __native_async_park_until_deadline { predicate = predicate, ms = ms }

## Run f within a structured concurrency scope.
pub let scoped: { f: { sc: Scope 'a } -> 'b <...> } -> 'b <Async, ...> = { f } ->
  __native_async_scoped { f = f }

## Chain another async step. Runs f only if p succeeded; on upstream Err
## the new Promise fails with AsyncFailed (the specific AsyncError variant
## from p is flattened — use `await` + match on `inspect` if you need
## error fidelity).
## Equivalent to Java's CompletableFuture.thenCompose / Rust's and_then.
## (named `and_then` because `then` is a reserved keyword.)
pub let and_then
  : { p: Promise 'a, f: { val: 'a } -> Promise 'b <Async, ...> }
  -> Promise 'b <Async, ...>
  = { p, f } -> Async.spawn { f = {} -> do
    let v = unwrap { result = await { p = p } }
    unwrap { result = await { p = f { val = v } } } }

## Apply a pure transform to the success value. On upstream Err, the new
## Promise fails with AsyncFailed (lossy on error variant).
## Equivalent to Java's CompletableFuture.thenApply / Rust's map_ok.
pub let map_ok: { p: Promise 'a, f: { val: 'a } -> 'b <...> } -> Promise 'b <Async, ...> = { p, f } ->
  Async.spawn { f = {} -> f { val = unwrap { result = await { p = p } } } }

## Recover from failure. f runs only on Err; Ok values pass through.
## Equivalent to Java's CompletableFuture.exceptionally / Scala's recover.
pub let recover
  : { p: Promise 'a, f: { err: AsyncError } -> 'a <...> }
  -> Promise 'a <Async, ...>
  = { p, f } -> Async.spawn { f = {} -> match await { p = p } is
    Ok { val } -> val
    Err { error = e } -> f { err = e }
 }

## Side-effecting observer that sees both branches. Returns a Promise
## resolving to the same value as p (or failing the same way), after f
## has run. Equivalent to Java's CompletableFuture.whenComplete.
pub let on_complete
  : { p: Promise 'a, f: { result: Result 'a AsyncError } -> {} <...> }
  -> Promise 'a <Async, ...>
  = { p, f } -> Async.spawn { f = {} -> do
    let r = await { p = p }
    f { result = r }
    unwrap { result = r } }

## Block on the Promise; return None on any failure, dropping error info.
pub let try_await: { p: Promise 'a } -> Option 'a <Async> = { p } -> match await { p = p } is
  Ok { val } -> Some { val = val }
  Err { error = _ } -> None


impl Promise 'a where {
  await = { it } -> await { p = it },
  inspect = { it } -> inspect { p = it },
  is_done = { it } -> is_done { p = it },
  is_pending = { it } -> is_pending { p = it },
  is_failed = { it } -> is_failed { p = it },
  is_cancelled = { it } -> is_cancelled { p = it },
  cancel = { it, reason } -> cancel { p = it, reason = reason },
  and_then = { it, f } -> and_then { p = it, f = f },
  map_ok = { it, f } -> map_ok { p = it, f = f },
  recover = { it, f } -> recover { p = it, f = f },
  on_complete = { it, f } -> on_complete { p = it, f = f },
  try_await = { it } -> try_await { p = it },
}

## Method surface for a seq of promises. Mirrors the top-level
## combinators so user code can write `ps.race {}`, `ps.all {}`, etc.
## instead of the prefix form `race { ps }`. Lives here because Promise
## is declared in this module — the impl-locality rule allows an
## inherent impl on a parametric container as long as some nominal type
## in the receiver tree is local.
impl [Promise 'a] where {
  race = { it } -> race { ps = it },
  await_all = { it } -> all { ps = it },
  await_settle = { it } -> settle { ps = it },
  try_all = { it } -> try_all { ps = it },
}

## Why a cancellation happened. Every cancel path names a category —
## there is no "no reason" case. Consumers pattern-match on the variant.
##
## - `UserRequested`   — direct caller cancel with a human message.
## - `Timeout`         — a deadline elapsed (with_timeout, scope_join_until).
## - `ScopeTeardown`   — implicit propagation from a closing scope
##                       (scope_cancel_all, exit-on-failure paths).
## - `SiblingFailed`   — a peer under a join policy failed and dragged
##                       this task down. `at` is the failed peer's index
##                       in the input order.
## - `LostRace`        — a peer settled first under `race` / `OnSuccess`
##                       / `OnFirst` and the losers are being torn down.
##                       The winner's index is not tracked to keep the
##                       combinator's inner loop cheap; if you need it,
##                       reconstruct via `inspect` on all siblings.
## - `ExternalInterrupt` — the underlying thread was interrupted by a
##                       source Mezze doesn't own (Ctrl-C, JVM shutdown,
##                       native code Thread.interrupt).
## - `Custom`          — escape hatch for application-defined reasons
##                       that don't fit the above. Both `tag` and
##                       `detail` are load-bearing — pick a stable tag
##                       for programmatic matching, put the specifics in
##                       detail.
pub type CancelReason = |
  UserRequested { msg: Str },
  Timeout { deadline_ms: Int },
  ScopeTeardown,
  SiblingFailed { at: Int },
  LostRace,
  ExternalInterrupt,
  Custom { tag: Str, detail: Str },
|

## Error type for async operations.
##
## `AsyncCancelled.reason` is mandatory — every cancel path names why.
## No `Option` here: if you don't have a category to pass, use
## `Custom { tag = "…", detail = "…" }`. Awaiters and `inspect` observers
## see the reason via `AsyncCancelled { reason }`.
pub type AsyncError = |
  AsyncFailed { msg: Str },
  AsyncCancelled { reason: CancelReason },
  AsyncTimedOut { ms: Int },
|

## Snapshot of a Promise's state at one moment in time.
## Returned by `Promise.inspect {}` — never blocks, never raises.
pub type PromiseState 'a = |
  Pending,
  Completed { val: 'a },
  Failed { err: AsyncError },
|

## What happened when you tried to cancel a Promise.
## Returned by `Promise.cancel {}` — never loses information about
## whether the cancellation actually took effect.
pub type CancelOutcome = |
  Cancelled,
  AlreadyCompleted,
  AlreadyFailed,
  NotCancellable,
|

## How `scoped_with` decides when to stop waiting for its children.
##
## - `OnFailure`    — wait for everyone; bail early on the first failure
## - `OnSuccess`    — first success wins; cancel the rest
## - `OnAllSettled` — wait for everyone; return per-item Results
## - `OnFirst`      — first to settle (success or failure) wins; cancel the rest
pub type JoinPolicy = | OnFailure, OnSuccess, OnAllSettled, OnFirst |

## Per-policy outcome of `scoped_with`. Pattern-match exhaustiveness
## guarantees you handle every case the chosen policy can produce.
pub type JoinOutcome 'a = |
  OnFailureOutcome { results: ['a] },
  OnFailureCaught { failed_at: Int, err: AsyncError, partial: [Option 'a] },
  OnSuccessOutcome { winner: 'a, losers_cancelled: Int },
  OnSuccessAllFailed { errs: [AsyncError] },
  OnAllOutcome { results: [Result 'a AsyncError] },
  OnFirstOutcome { result: Result 'a AsyncError, settled_at: Int, cancelled: Int },
|

## Unified async effect for spawning, awaiting, and structured concurrency.
##
## The effect carries only the primitives that a handler must implement.
## The Async effect declares a single primitive: `spawn`. Every other
## async operation (`await`, `cancel`, `sleep`, `yield_now`, `park`,
## `scoped`) lives as a stdlib free function above, either delegating
## to a native or riding on another effect (Time). Derived operations
## (race, all, any, settle, join, join3, par_map, par_for_each,
## par_filter, with_timeout, try_*) live as free functions below —
## each expressible in terms of `spawn` + the primitives.
##
## This keeps the ability surface minimal: implementers pick a
## scheduler (Loom vs OS threads), everything else composes on top.
##
## Cancellation observation is Promise-side (`p.is_cancelled {}`);
## delivery inside a task rides on the JDK's blocking-primitive
## interrupt (sleep, await, park, mutex/channel/latch waits are all
## cancellation points). Pure CPU-bound tasks are not interruptible
## by design — sprinkle a natural yield point (await, sleep, or the
## like) if you need cooperative cancel.
#{ unhandled: "Wrap it in `perform LoomAsync in …` (virtual threads), or `OSThreadAsync` for a thread pool." }
effect Async where {
  ## Spawn a computation, returning a Promise immediately.
  ##
  ## The callback's own effects reach the spawn site through the `<...>` on its
  ## arrow — `{} -> 'a <...>` — so a caller is still answerable for them:
  ## `spawn { f = {} -> sleep { ms } }` inside a function annotated `<Async>`
  ## alone is a T0210, naming `<Time>`. Writing `<Async, ...>` on the result
  ## instead was tried and changes nothing observable; the row already travels.
  ##
  ## Where it does NOT travel is a bare top-level expression, which has neither
  ## an annotation nor the entry check to answer to. A spawned task's unhandled
  ## effect is then dropped at runtime unless somebody awaits — see
  ## `planned_features/runtime/concurrency-and-context-bugs.md` C1, and the
  ## report `AsyncNatives.SuspendedOps` prints when a context closes holding one.
  spawn: { f: {} -> 'a <...> } -> Promise 'a <Async>
}

## Default handler using Project Loom virtual threads.
##
## initialize_scope / finalize_scope are runtime plumbing — not declared
## in the ability but expected by the effect driver to bracket the
## structured concurrency scope. Kept as impl-only fields.
impl Async for LoomAsync where {
  initialize_scope = {} -> __native_async_init_scope {},
  finalize_scope = {} -> __native_async_finalize_scope { tracker = scope },
  spawn = { f } -> __native_async_spawn_tracked { f = f, max_concurrent = 0, tracker = scope },
}

## LoomAsync with configurable concurrency limit (0 = unbounded).
impl Async for LoomAsyncWith { max_concurrent: Int } where {
  initialize_scope = {} -> __native_async_init_scope {},
  finalize_scope = {} -> __native_async_finalize_scope { tracker = scope },
  spawn = { f } ->
    __native_async_spawn_tracked {
      f = f,
      max_concurrent = max_concurrent,
      tracker = scope,
    },
}

## OS platform thread implementation for true parallelism on CPU-bound work.
impl Async for OSThreadAsync where {
  initialize_scope = {} -> __native_async_init_scope_os {},
  finalize_scope = {} -> __native_async_finalize_scope_os { tracker = scope },
  spawn = { f } -> __native_async_spawn_tracked_os { f = f, pool_size = 0, tracker = scope },
}

## OSThreadAsync with configurable thread pool size (0 = unbounded).
impl Async for OSThreadAsyncWith { pool_size: Int } where {
  initialize_scope = {} -> __native_async_init_scope_os {},
  finalize_scope = {} -> __native_async_finalize_scope_os { tracker = scope },
  spawn = { f } ->
    __native_async_spawn_tracked_os { f = f, pool_size = pool_size, tracker = scope },
}

## Spawn and immediately await (synchronous helper).
## Returns the Result from `await` — callers decide how to handle failure.
pub let run: { f: {} -> 'a <...> } -> Result 'a AsyncError <Async, ...> = { f } ->
  do
    let p = Async.spawn { f = f }
    await { p = p }

## Spawn and detach (fire and forget).
pub let go: { f: {} -> 'a <...> } -> {} <Async, ...> = { f } -> do
  let _ = Async.spawn { f = f }
  {}

## ==================================================================
## Park-based helpers — derived from spawn + park + await primitives.
## These are equivalent to the Async.* ops of the same name and exist
## as plain functions so the Async effect can eventually shrink to
## just the primitives. For now both paths coexist.
## ==================================================================
## Wait for any of a list of promises to settle, returning the first
## non-cancelled outcome as `Result 'a AsyncError`. Losing siblings are
## auto-cancelled when the winner commits.
##
## Built on `park` (suspend until predicate True) + `inspect` (pure
## non-blocking state read) + `cancel`.
pub let race: { ps: [Promise 'a] } -> Result 'a AsyncError <Async, ...> = { ps } ->
  do
    park { predicate = {} -> seq::any { xs = ps, p = { x } -> is_done { p = x } } }
    match seq::find { xs = ps, p = { x } -> is_done { p = x } } is
      None -> Err {
        error = AsyncFailed { msg = "race: park woke but no promise settled" },
      }
      Some { val = winner } -> do
        seq::for_each { xs = ps, f = { x } -> match is_done { p = x } is
          True -> {}
          False -> do
            cancel { p = x, reason = LostRace }
            {}
 }
        match inspect { p = winner } is
          Completed { val = v } -> Ok { val = v }
          Failed { err = e } -> Err { error = e }
          Pending -> Err {
            error = AsyncFailed { msg = "race: winner reverted to Pending" },
          }


## Wait for all promises; return each one's Result in input order. Never
## raises; the per-promise Result carries success/failure information.
pub let all: { ps: [Promise 'a] } -> [Result 'a AsyncError] <Async, ...> = { ps } ->
  seq::map { xs = ps, f = { x } -> await { p = x } }

## Run two thunks concurrently, return both Results.
pub let join
  : { l: {} -> 'a <...>, r: {} -> 'b <...> }
  -> { l: Result 'a AsyncError, r: Result 'b AsyncError } <Async, ...>
  = { l, r } -> do
    let pl = Async.spawn { f = l }
    let pr = Async.spawn { f = r }
    { l = await { p = pl }, r = await { p = pr } }

## Run three thunks concurrently, return all Results.
pub let join3
  : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> }
  -> { a: Result 'a AsyncError, b: Result 'b AsyncError, c: Result 'c AsyncError } <Async, ...>
  = { a, b, c } -> do
    let pa = Async.spawn { f = a }
    let pb = Async.spawn { f = b }
    let pc = Async.spawn { f = c }
    {
      a = await { p = pa },
      b = await { p = pb },
      c = await { p = pc },
    }

## Identical to `all` — kept under the `settle` name for callers that
## think of "wait for everyone, see each result" as settle semantics.
pub let settle: { ps: [Promise 'a] } -> [Result 'a AsyncError] <Async, ...> = { ps } ->
  all { ps = ps }

## Map over a sequence concurrently; each result wrapped in
## `Result 'b AsyncError` so per-element failure is visible. Use
## `try_par_map` if you want fail-fast + unwrap semantics.
pub let par_map: { xs: ['a], f: { x: 'a } -> 'b <...> } -> [Result 'b AsyncError] <Async, ...> = { xs, f } ->
  do
    let ps = seq::map { xs = xs, f = { x } -> Async.spawn { f = {} -> f { x = x } } }
    all { ps = ps }

## ---------- Bounded concurrency over a LAZY source ----------
##
## `par_map` takes a Seq, so the whole input has to exist before any work
## starts. These take an `Iter` and never materialise it: the source is walked
## ONCE, at most `max_in_flight` tasks are alive at a time, and a window of
## that many promises is the only thing held.
##
## That is the case `par_map` and `chunk_fold` cannot serve — a source you
## cannot materialise. Walk a directory tree and read every file sixteen at a
## time without first building a list of two million paths; drain a paginated
## cursor whose page N+1 needs page N; follow a log. Measured for the finite
## case in `bench/cases/concurrent_map_compare`: `chunk_fold` with `min_chunk`
## lowered is the fastest option when the input fits in memory, so reach for
## these when it does NOT, or when the source is effectful and must be walked
## exactly once.
##
## Bounded means bounded: the window fills, the oldest promise is awaited, and
## only then is another task spawned. Nothing here lets the in-flight count
## drift above `max_in_flight`, which is what makes it safe to point at a
## directory of unknown size.
##
## `map_concurrent_lazy` below answers a lazy `Iter 'b`, built on
## `iter::cursor`. The two eager forms stay because they are the common case
## and cheaper: a fold over the push walk fuses, while the lazy form pays for a
## cursor frame per stage and a window record per element.

## Walk `it`, running `f` on each element with at most `max_in_flight`
## concurrent tasks, for side effects.
##
## Results are discarded, so a task that fails fails silently — use
## `map_concurrent` when you need to see per-element outcomes. Pair with
## `iter::take` to bound an endless source.
pub let for_each_concurrent
  : { it: Iter 'a, f: { x: 'a } -> 'b <...>, max_in_flight: Int } -> {} <Async, ...>
  = { it, f, max_in_flight } -> do
    ## The fold threads the WINDOW as its accumulator: a Seq of in-flight
    ## promises, oldest first. One walk, no materialised input.
    let leftover = iter::fold {
      it = it,
      init = [],
      f = { acc, x } -> do
        let w = seq::push { xs = acc, x = Async.spawn { f = {} -> f { x = x } } }
        if seq::size { xs = w } < max_in_flight then w
        else match seq::first { xs = w } is
          Some { val = oldest } -> do
            ## Await the OLDEST before spawning the next, which is what keeps
            ## the count at the limit rather than merely near it.
            let _ = await { p = oldest }
            seq::tail { xs = w }
          None -> w
    }
    ## Drain what the window still holds when the source ran out.
    seq::for_each { xs = leftover, f = { x } -> do
      let _ = await { p = x }
      {}
    }


## Walk `it`, running `f` on each element with at most `max_in_flight`
## concurrent tasks, and collect the results IN SOURCE ORDER.
##
## Ordered, not completion-ordered: a slow element holds up the ones behind it
## in the output, exactly as `par_map` does. Unordered yielding would be a
## different combinator — it needs to return results as they settle, which
## means it cannot also be a fold.
##
## The INPUT is never materialised; the output is a Seq, so it is bounded by
## the number of elements. For an endless source, bound it with `iter::take`.
## Per-element failures are visible as `Err`, like `par_map`.
pub let map_concurrent
  : { it: Iter 'a, f: { x: 'a } -> 'b <...>, max_in_flight: Int }
  -> [Result 'b AsyncError] <Async, ...>
  = { it, f, max_in_flight } -> do
    ## `window` is the in-flight promises, `done` the settled results so far.
    let final = iter::fold {
      it = it,
      init = { window = [], done = [] },
      f = { acc, x } -> do
        let w = seq::push { xs = acc.window, x = Async.spawn { f = {} -> f { x = x } } }
        if seq::size { xs = w } < max_in_flight then { window = w, done = acc.done }
        else match seq::first { xs = w } is
          Some { val = oldest } -> {
            window = seq::tail { xs = w },
            done = seq::push { xs = acc.done, x = await { p = oldest } },
          }
          None -> { window = w, done = acc.done }
    }
    ## `all` awaits the remaining window in order, so the tail keeps its place.
    seq::concat { xs = final.done, ys = all { ps = final.window } }


## Map concurrently and yield LAZILY — bounded in flight, bounded in memory,
## and finite output is never required.
##
## The difference from `map_concurrent` is which side is lazy. That one
## consumes an `Iter` lazily and answers a Seq, so the output has to fit in
## memory and the whole source is drained before the caller sees anything.
## This one answers an `Iter`, so a consumer can `take` from it, stop early,
## and never pay for the rest — which is what makes it usable against an
## endless source on both sides.
##
## How it works: the source is opened as a CURSOR, because a push walk owns
## its loop and cannot hand an element out and be resumed. Each step tops the
## in-flight window up to `max_in_flight` by pulling from the cursor and
## spawning, then awaits the OLDEST promise and yields its result. When the
## cursor is exhausted the window drains; when both are empty it is `Done`.
##
## Source order, like the eager forms. `Skip` is never needed: every step
## either yields a settled result or finishes, because a step that has a
## non-empty window always has something to await.
##
## The cost is real — a cursor frame per stage and a window record per element,
## against a fused fold for the eager forms. Reach for this when the output
## must stream, and for `map_concurrent` when it need not.
pub let map_concurrent_lazy
  : { it: Iter 'a, f: { x: 'a } -> 'b <...>, max_in_flight: Int }
  -> Iter (Result 'b AsyncError) <Async, ...>
  = { it, f, max_in_flight } -> iter::unfold {
    state = { c = iter::cursor { it = it }, window = [], drained = False },
    step = { s } -> do
      ## Top the window up first, so the limit is what is in flight rather
      ## than what has been asked for.
      let filled = fill_window { c = s.c, window = s.window, drained = s.drained, f = f, want = max_in_flight }
      match seq::first { xs = filled.window } is
        None -> Done
        Some { val = oldest } -> Yield {
          val = await { p = oldest },
          next = { c = s.c, window = seq::tail { xs = filled.window }, drained = filled.drained },
        }
  }


## Pull from the cursor until the window holds `want` promises or the source
## runs out. Separate because `unfold`'s step is one expression and this needs
## to loop.
let fill_window
  : { c: IterCursor 'a, window: [Promise 'b], drained: Bool, f: { x: 'a } -> 'b <...>, want: Int }
  -> { window: [Promise 'b], drained: Bool } <Async, ...>
  = { c, window, drained, f, want } ->
    if drained then { window = window, drained = True }
    else if seq::size { xs = window } >= want then { window = window, drained = False }
    else match iter::cursor_next { c = c } is
      None -> { window = window, drained = True }
      Some { val = x } -> fill_window {
        c = c,
        window = seq::push { xs = window, x = Async.spawn { f = {} -> f { x = x } } },
        drained = False,
        f = f,
        want = want,
      }


## Run f over each element concurrently for side effects; per-element
## Results returned (any failures visible to the caller). Use
## `try_par_for_each` if you want fail-fast unit-returning semantics.
pub let par_for_each
  : { xs: ['a], f: { x: 'a } -> 'b <...> }
  -> [Result 'b AsyncError] <Async, ...>
  = { xs, f } -> par_map { xs = xs, f = f }

## Filter a sequence with concurrent predicate evaluation; each retained
## element wrapped in `Result 'a AsyncError` so per-element predicate
## failures are visible. Use `try_par_filter` if you want fail-fast unwrap.
pub let par_filter
  : { xs: ['a], f: { x: 'a } -> Bool <...> }
  -> [Result 'a AsyncError] <Async, ...>
  = { xs, f } -> do
    let tagged = par_map { xs = xs, f = { x } -> { elem = x, keep = f { x = x } } }
    seq::map {
      xs = seq::filter { xs = tagged, p = { x } -> match x is
        Ok { val = r } -> r.keep
        Err { error = _ } -> True
 },
      f = { x } -> match x is
        Ok { val = r } -> Ok { val = r.elem }
        Err { error = e } -> Err { error = e }
,
    }

## Wait for p up to ms milliseconds; None if it didn't finish in time.
##
## One `park_until` and nothing else: the deadline belongs to the thread that is
## waiting. There is no sleeper task, so no second promise has to be scheduled
## for a timeout to be right, and `with_timeout` performs no `Time` — see
## `park_until` for what the sleeper version got wrong.
##
## A `Result`, not an `Option`, because there are two ways not to get a value and
## a caller usually has to tell them apart: `AsyncTimedOut { ms }` when the
## deadline won, and the promise's own error when it failed or was cancelled.
## `Option` collapsed both into `None` and sent the caller back to `inspect` —
## a second observation of a promise that had already answered. The variant for
## this was in `AsyncError` from the start.
##
## This is the same shape `await` returns, so the two compose: `with_timeout` is
## `await` with a deadline.
pub let with_timeout: { ms: Int, p: Promise 'a } -> Result 'a AsyncError <Async, ...> = { ms, p } ->
  match park_until { predicate = {} -> is_done { p = p }, ms = ms } is
    True -> match inspect { p = p } is
      Completed { val = v } -> Ok { val = v }
      Failed { err = e } -> Err { error = e }
      Pending -> Err { error = AsyncTimedOut { ms = ms } }
    False -> do
      cancel { p = p, reason = Timeout { deadline_ms = ms } }
      Err { error = AsyncTimedOut { ms = ms } }


## ==================================================================
## try_* — fail-fast variants. On first Err, cancel the rest and
## return that error. On success of every input, return the unwrapped
## values. Matches Rust `try_join_all` / `try_join!` semantics.
## ==================================================================
## Wait for all promises; if any fails, cancel the rest and return
## the first error. Otherwise return the unwrapped values in input order.
##
## Implementation: await each in turn; collect Results into a seq. After
## all awaits complete (or short-circuit doesn't happen because we already
## awaited them all sequentially), scan for the first error and either
## return Ok of unwrapped values or Err with the first error.
##
## TODO #169: switch to a fail-fast spawn-of-spawns implementation that
## cancels siblings as soon as one errs, rather than the current
## "await everything, then check" approach.
pub let try_all: { ps: [Promise 'a] } -> Result ['a] AsyncError <Async, ...> = { ps } ->
  do
    let results = seq::map { xs = ps, f = { x } -> await { p = x } }
    match seq::find { xs = results, p = { x } -> result::is_err { result = x } } is
      Some { val = first_err } -> match first_err is
        Err { error = e } -> Err { error = e }
        Ok { val = _ } -> Err { error = AsyncFailed { msg = "try_all: impossible" } }
      None -> Ok {
        val = seq::map { xs = results, f = { x } -> match x is
          Ok { val = v } -> v
          Err { error = _ } -> crash { msg = "try_all: impossible" }
 },
      }


## Run two thunks concurrently. On the first Err, cancel the surviving
## sibling and return that error. Otherwise return both unwrapped values.
pub let try_join
  : { l: {} -> 'a <...>, r: {} -> 'b <...> }
  -> Result { l: 'a, r: 'b } AsyncError <Async, ...>
  = { l, r } -> do
    let pl = Async.spawn { f = l }
    let pr = Async.spawn { f = r }
    match await { p = pl } is
      Err { error = e } -> do
        cancel { p = pr, reason = SiblingFailed { at = 0 } }
        await { p = pr }
        Err { error = e }
      Ok { val = vl } -> match await { p = pr } is
        Err { error = e } -> Err { error = e }
        Ok { val = vr } -> Ok { val = { l = vl, r = vr } }


## Run three thunks concurrently with fail-fast + auto-cancel semantics.
pub let try_join3
  : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> }
  -> Result { a: 'a, b: 'b, c: 'c } AsyncError <Async, ...>
  = { a, b, c } -> do
    let pa = Async.spawn { f = a }
    let pb = Async.spawn { f = b }
    let pc = Async.spawn { f = c }
    match await { p = pa } is
      Err { error = e } -> do
        cancel { p = pb, reason = SiblingFailed { at = 0 } }
        cancel { p = pc, reason = SiblingFailed { at = 0 } }
        await { p = pb }
        await { p = pc }
        Err { error = e }
      Ok { val = va } -> match await { p = pb } is
        Err { error = e } -> do
          cancel { p = pc, reason = SiblingFailed { at = 1 } }
          await { p = pc }
          Err { error = e }
        Ok { val = vb } -> match await { p = pc } is
          Err { error = e } -> Err { error = e }
          Ok { val = vc } -> Ok { val = { a = va, b = vb, c = vc } }


## Map over a sequence concurrently. On first failure, cancel siblings
## and return that error. Otherwise return the unwrapped output values
## in input order.
pub let try_par_map
  : { xs: ['a], f: { x: 'a } -> 'b <...> }
  -> Result ['b] AsyncError <Async, ...>
  = { xs, f } -> do
    let ps = seq::map { xs = xs, f = { x } -> Async.spawn { f = {} -> f { x = x } } }
    try_all { ps = ps }

## Run f over each element concurrently; short-circuit on first error,
## cancel siblings, return the error. On all-Ok, returns {}.
pub let try_par_for_each
  : { xs: ['a], f: { x: 'a } -> 'b <...> }
  -> Result {} AsyncError <Async, ...>
  = { xs, f } -> match try_par_map { xs = xs, f = f } is
    Ok { val = _ } -> Ok { val = {} }
    Err { error = e } -> Err { error = e }


## Filter a sequence with concurrent predicate evaluation; fail-fast
## on first predicate error.
pub let try_par_filter
  : { xs: ['a], f: { x: 'a } -> Bool <...> }
  -> Result ['a] AsyncError <Async, ...>
  = { xs, f } -> do
    let tagged = try_par_map { xs = xs, f = { x } -> { elem = x, keep = f { x = x } } }
    match tagged is
      Err { error = e } -> Err { error = e }
      Ok { val = ts } -> Ok {
        val = seq::map {
          xs = seq::filter { xs = ts, p = { x } -> x.keep },
          f = { x } -> x.elem,
        },
      }


## Wait for the first successful promise. If every one fails, returns
## the first error seen. Built on `try_all` semantics — but since `any`
## wants first-success-wins, we await sequentially: as soon as one is
## Ok, return its value (cancelling the rest).
pub let try_any: { ps: [Promise 'a] } -> Result 'a AsyncError <Async, ...> = { ps } ->
  do
    let results = seq::map { xs = ps, f = { x } -> await { p = x } }
    match seq::find { xs = results, p = { x } -> result::is_ok { result = x } } is
      Some { val = winner } -> match winner is
        Ok { val = v } -> Ok { val = v }
        Err { error = _ } -> Err { error = AsyncFailed { msg = "try_any: impossible" } }
      None -> match seq::find { xs = results, p = { x } -> result::is_err { result = x } } is
        Some { val = first_err } -> match first_err is
          Err { error = e } -> Err { error = e }
          Ok { val = _ } -> Err { error = AsyncFailed { msg = "try_any: impossible" } }
        None -> Err { error = AsyncFailed { msg = "try_any: empty input" } }


## Spawn a task within a structured concurrency scope.
pub let scope_spawn: { sc: Scope 'a, f: {} -> 'b <...> } -> Promise 'b <Async, ...> = { sc, f } ->
  __native_async_scope_spawn { sc = sc, f = f }

## Cancel all tasks in a scope.
pub let scope_cancel_all: { sc: Scope 'a } -> {} <Async, ...> = { sc } ->
  __native_async_scope_cancel_all { sc = sc }

## Get the CancellationToken for a scope.
pub let scope_get_token: { sc: Scope 'a } -> CancellationToken <Async, ...> = { sc } ->
  __native_async_scope_get_token { sc = sc }

## Check if a scope has been cancelled.
pub let scope_is_cancelled: { sc: Scope 'a } -> Bool <Async, ...> = { sc } ->
  __native_async_scope_is_cancelled { sc = sc }

## Wait for every Promise in `ps` to settle, or `ms` milliseconds to elapse —
## whichever comes first. Returns True if all settled in time; False if the
## deadline fired (and the scope is cancelled so remaining children unwind).
## #253: single-call deadline join over a Scope's spawned children.
pub let scope_join_until
  : { sc: Scope 'a, ps: [Promise 'b], ms: Int }
  -> Bool <Async, ...>
  = { sc, ps, ms } ->
    match park_until {
      predicate = {} -> seq::all { xs = ps, p = { x } -> is_done { p = x } },
      ms = ms,
    } is
      True -> True
      False -> do
        scope_cancel_all { sc = sc }
        False


## Method surface for Scope. Mirrors the `scope_*` free functions so
## user code can write `sc.spawn { f }` / `sc.cancel_all {}` / etc.
## instead of the prefixed forms.
impl Scope 'a where {
  spawn = { it, f } -> scope_spawn { sc = it, f = f },
  cancel_all = { it } -> scope_cancel_all { sc = it },
  is_cancelled = { it } -> scope_is_cancelled { sc = it },
  get_token = { it } -> scope_get_token { sc = it },
  join_until = { it, ps, ms } -> scope_join_until { sc = it, ps = ps, ms = ms },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  scope_spawn = { it, f } -> scope_spawn { sc = it, f = f },
  scope_cancel_all = { it } -> scope_cancel_all { sc = it },
  scope_get_token = { it } -> scope_get_token { sc = it },
  scope_is_cancelled = { it } -> scope_is_cancelled { sc = it },
  scope_join_until = { it, ps, ms } -> scope_join_until { sc = it, ps = ps, ms = ms },
  join_on_success = { it, ps } -> join_on_success { sc = it, ps = ps },
  join_on_failure = { it, ps } -> join_on_failure { sc = it, ps = ps },
  join_on_first = { it, ps } -> join_on_first { sc = it, ps = ps },
}

# ============================================================================
# scoped_with — policy-driven structured concurrency over scoped
#
# Wraps scoped: the body spawns children into `sc` and returns the
# [Promise 'a] list of what it spawned. scoped_with parks on those
# promises according to `policy`, cancels losers, and constructs the
# appropriate JoinOutcome arm.
#
# - OnAllSettled — wait for everyone, return per-item Results.
# - OnFailure    — wait for everyone; on first failure, cancel rest and
#                  return OnFailureCaught; if everyone succeeds, return
#                  OnFailureOutcome with the unwrapped values.
# - OnSuccess    — first success wins; cancel rest and return
#                  OnSuccessOutcome; if all fail, return OnSuccessAllFailed.
# - OnFirst      — first to settle (any way) wins; cancel rest and return
#                  OnFirstOutcome carrying the result.
# ============================================================================
pub let scoped_with
  : { policy: JoinPolicy, body: { sc: Scope 'a } -> [Promise 'a] <Async, ...> }
  -> JoinOutcome 'a <Async, ...>
  = { policy, body } -> scoped { f = { sc } -> do
    let ps = body { sc = sc }
    match policy is
      OnAllSettled -> OnAllOutcome { results = all { ps = ps } }
      OnFailure -> join_on_failure { sc = sc, ps = ps }
      OnSuccess -> join_on_success { sc = sc, ps = ps }
      OnFirst -> join_on_first { sc = sc, ps = ps }
 }

## OnSuccess: park until at least one promise succeeds OR all fail. On first
## success: cancel everyone else, return OnSuccessOutcome with the winner +
## the count of cancelled siblings. If everyone failed, return
## OnSuccessAllFailed with the per-task errors in input order.
pub let join_on_success
  : { sc: Scope 'a, ps: [Promise 'b] }
  -> JoinOutcome 'b <Async, ...>
  = { sc, ps } -> do
    park { predicate = {} ->
      seq::any { xs = ps, p = { x } -> is_done { p = x } && (is_failed { p = x }).not {} } || seq::all { xs = ps, p = { x } ->
        is_done { p = x } } }
    let winner_opt = seq::find { xs = ps, p = { x } ->
      is_done { p = x } && (is_failed { p = x }).not {} }
    match winner_opt is
      Some { val = winner } -> do
        let winner_val = match inspect { p = winner } is
          Completed { val = v } -> v
          Failed { err = _ } -> crash { msg = "on_success: winner reverted to Failed" }
          Pending -> crash { msg = "on_success: winner reverted to Pending" }

        scope_cancel_all { sc = sc }
        let cancelled = seq::fold { xs = ps, init = 0, f = { acc, x } -> match promise_eq { l = x, r = winner } is
          True -> acc
          False -> match is_done { p = x } is
            True -> acc
            False -> acc + 1
 }
        OnSuccessOutcome { winner = winner_val, losers_cancelled = cancelled }
      None -> OnSuccessAllFailed {
        errs = seq::map { xs = ps, f = { x } -> match inspect { p = x } is
          Failed { err = e } -> e
          Completed { val = _ } -> AsyncFailed { msg = "on_success: expected Failed, got Completed" }
          Pending -> AsyncFailed { msg = "on_success: expected Failed, got Pending" }
 },
      }


## OnFailure: wait for every promise; if any fail, cancel rest and return
## OnFailureCaught with partial successes; otherwise return OnFailureOutcome
## with the unwrapped values in input order.
pub let join_on_failure
  : { sc: Scope 'a, ps: [Promise 'b] }
  -> JoinOutcome 'b <Async, ...>
  = { sc, ps } -> do
    let results = all { ps = ps }
    match seq::find_index { xs = results, p = { x } -> match x is
      Err { error = _ } -> True
      Ok { val = _ } -> False
 } is
      None -> OnFailureOutcome {
        results = seq::map { xs = results, f = { x } -> match x is
          Ok { val = v } -> v
          Err { error = _ } -> crash { msg = "on_failure: find_index=None but Err in seq" }
 },
      }
      Some { val = idx } -> do
        scope_cancel_all { sc = sc }
        let nth_res = seq::nth { xs = results, i = idx }
        let err = match nth_res is
          Some { val = Err { error = e } } -> e
          Some { val = Ok { val = _ } } -> AsyncFailed { msg = "on_failure: nth=Ok at failed idx" }
          None -> AsyncFailed { msg = "on_failure: nth=None at failed idx" }

        OnFailureCaught {
          failed_at = idx,
          err = err,
          partial = seq::map { xs = results, f = { x } -> match x is
            Ok { val = v } -> Some { val = v }
            Err { error = _ } -> None
 },
        }


## OnFirst: first to settle (success or failure) wins. Cancel rest, return
## OnFirstOutcome carrying the winner's Result, its input index, and the
## count of cancelled siblings.
pub let join_on_first: { sc: Scope 'a, ps: [Promise 'b] } -> JoinOutcome 'b <Async, ...> = { sc, ps } ->
  do
    park { predicate = {} -> seq::any { xs = ps, p = { x } -> is_done { p = x } } }
    let idx_opt = seq::find_index { xs = ps, p = { x } -> is_done { p = x } }
    match idx_opt is
      None -> OnFirstOutcome {
        result = Err {
          error = AsyncFailed { msg = "on_first: park woke but no promise settled" },
        },
        settled_at = 0,
        cancelled = 0,
      }
      Some { val = idx } -> do
        let winner_opt = seq::nth { xs = ps, i = idx }
        let winner = match winner_opt is
          Some { val = w } -> w
          None -> crash { msg = "on_first: nth=None at idx" }

        let result = match inspect { p = winner } is
          Completed { val = v } -> Ok { val = v }
          Failed { err = e } -> Err { error = e }
          Pending -> Err {
            error = AsyncFailed { msg = "on_first: winner reverted" },
          }

        scope_cancel_all { sc = sc }
        let cancelled = seq::fold { xs = ps, init = 0, f = { acc, x } -> match promise_eq { l = x, r = winner } is
          True -> acc
          False -> match is_done { p = x } is
            True -> acc
            False -> acc + 1
 }
        OnFirstOutcome {
          result = result,
          settled_at = idx,
          cancelled = cancelled,
        }
  # ============================================================================

# Cancellation tokens
#
# Cooperative cancellation primitive: a flag that tasks can check (via
# `is_token_cancelled`) at safe points and bail out early. Cancelling the
# token doesn't kill any running code — it only signals; watchers must
# respect the signal themselves. Mirrors Go's context.Cancel(), .NET's
# CancellationTokenSource.Cancel(), Kotlin's Job.cancel().
#
# Used to live in std::effects::async::cancellation but moved here
# because cancel returns CancelOutcome (which talks about token
# cancellation semantics) and `Scope` exposes `scope_get_token` — the
# token type belongs with the rest of the async surface, not in a
# separate module.
#
# The `_token` suffix on `cancel_token` and `is_token_cancelled` is to
# disambiguate from `cancel { p = ... }` / `Promise.is_cancelled
# { p = ... }`, which operate on Promises (different shape, different
# return type).
# ============================================================================
## Cooperative cancellation token supporting hierarchical cancellation.
pub newtype CancellationToken = __NativeCancellationToken

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for CancellationToken where {
  hash: { it: CancellationToken } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for CancellationToken where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl CancellationToken where {
  cancel_token = { it, reason } -> cancel_token { token = it, reason = reason },
  cancel_default = { it } -> cancel_default { token = it },
  is_token_cancelled = { it } -> is_token_cancelled { token = it },
  get_reason = { it } -> get_reason { token = it },
  check_cancelled = { it } -> check_cancelled { token = it },
  on_cancel = { it, callback } -> on_cancel { token = it, callback = callback },
  remove_callback = { it, id } -> remove_callback { token = it, id = id },
  create_child = { it } -> create_child { token = it },
  with_cancellation = { it, f } -> with_cancellation { token = it, f = f },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  throw_if_cancelled = { it } -> throw_if_cancelled { token = it },
  on_cancellation = { it, callback } -> on_cancellation { token = it, callback = callback },
}

## Create a new cancellation token.
pub let token: {} -> CancellationToken <Async> = {} -> __native_cancellation_token_new {}

## Alias for token.
pub let new: {} -> CancellationToken <Async> = token

## Cancel the token with a reason, invoking all registered callbacks.
pub let cancel_token: { token: CancellationToken, reason: Str } -> {} <Async> = { token, reason } ->
  __native_cancellation_token_cancel { token = token, reason = reason }

## Cancel with a default reason.
pub let cancel_default: { token: CancellationToken } -> {} <Async> = { token } ->
  cancel_token { token = token, reason = "Operation cancelled" }

## Check if the token has been cancelled.
pub let is_token_cancelled: { token: CancellationToken } -> Bool <Async> = { token } ->
  __native_cancellation_token_is_cancelled { token = token }

## Get the cancellation reason, or None if not cancelled.
pub let get_reason: { token: CancellationToken } -> Option Str <Async> = { token } ->
  __native_cancellation_token_get_reason { token = token }

## Throw an exception if the token is cancelled (cancellation checkpoint).
pub let check_cancelled: { token: CancellationToken } -> {} <Async> = { token } ->
  __native_cancellation_token_throw_if_cancelled { token = token }

## Alias for check_cancelled.
pub let throw_if_cancelled: { token: CancellationToken } -> {} <Async> = check_cancelled

## Register a callback invoked on cancellation. Returns a callback ID.
pub let on_cancel
  : { token: CancellationToken, callback: {} -> {} <...> }
  -> Str <Async>
  = { token, callback } ->
    __native_cancellation_token_on_cancellation { token = token, callback = callback }

## Alias for on_cancel.
pub let on_cancellation: { token: CancellationToken, callback: {} -> {} <...> } -> Str <Async> = on_cancel

## Remove a previously registered callback by ID.
pub let remove_callback: { token: CancellationToken, id: Str } -> {} <Async> = { token, id } ->
  __native_cancellation_token_remove_callback { token = token, id = id }

## Create a child token cancelled when the parent is cancelled.
pub let create_child: { token: CancellationToken } -> CancellationToken <Async> = { token } ->
  __native_cancellation_token_create_child { token = token }

## Run f if not cancelled, returning Some on success, None if cancelled.
pub let with_cancellation
  : { token: CancellationToken, f: {} -> 'a <...> }
  -> Option 'a <...>
  = { token, f } -> if is_token_cancelled { token = token } then None else Some { val = f {} }

## Park until any predicate is True; return the index of the first to fire.
## Returns None if the predicates list is empty (otherwise would deadlock).
##
## Predicates MUST be idempotent — they're polled twice on a successful
## wake (once by the park, once to identify the index). Reading atoms,
## promise.is_done, and try_send {} are all safe. Consuming reads like
## channel try_recv {} are NOT safe to use directly — wrap the consume
## in the corresponding branch's `run` and use a non-consuming check
## (e.g. spawn a recv promise and use is_done) in the `when`.
pub let park_any: { predicates: [{} -> Bool <...>] } -> Option Int <Async, ...> = { predicates } ->
  match seq::is_empty { xs = predicates } is
    True -> None
    False -> do
      park { predicate = {} -> seq::any { xs = predicates, p = { x } -> x {} } }
      seq::find_index { xs = predicates, p = { x } -> x {} }


## A select branch: predicate + action. (`then` is reserved; use `run`.)
pub type SelectBranch 'a = { when: {} -> Bool <...>, run: {} -> 'a <...> }

## Wait on multiple sources; run the action for whichever fires first.
## Returns None if branches is empty (otherwise would deadlock).
pub let select: { branches: [SelectBranch 'a] } -> Option 'a <Async, ...> = { branches } ->
  do
    let preds = seq::map { xs = branches, f = { x } -> x.when }
    match park_any { predicates = preds } is
      None -> None
      Some { val = i } -> match seq::get { xs = branches, i = i } is
        Some { val = b } -> Some { val = b.run {} }
        None -> None
