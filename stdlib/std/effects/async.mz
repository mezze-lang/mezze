use std::collections::seq
use std::effects::concurrent::cancellation::{ CancellationToken }
use std::abilities::compare::{ Eq }
use std::result

## Opaque promise representing an asynchronous computation.
pub newtype Promise 'a = Promise __NativePromise

## Opaque scope for structured concurrency.
pub newtype Scope 'a = Scope __NativeScope

pub let promise_eq : { l: Promise 'a, r: Promise 'a } -> Bool = { l, r } ->
  __native_ref_eq { l = l, r = r }

pub let promise_neq : { l: Promise 'a, r: Promise 'a } -> Bool = { l, r } ->
  __native_ref_neq { l = l, r = r }

impl Eq 'a for Promise 'a where {
  eq  = { it, r } -> promise_eq  { l = it, r = r },
  neq = { it, r } -> promise_neq { l = it, r = r },
}

pub let scope_eq : { l: Scope 'a, r: Scope 'a } -> Bool = { l, r } ->
  __native_ref_eq { l = l, r = r }

pub let scope_neq : { l: Scope 'a, r: Scope 'a } -> Bool = { l, r } ->
  __native_ref_neq { l = l, r = r }

impl Eq 'a for Scope 'a where {
  eq  = { it, r } -> scope_eq  { l = it, r = r },
  neq = { it, r } -> scope_neq { l = it, r = r },
}

## Block until the Promise resolves, returning success or AsyncError.
pub let await : { p: Promise 'a } -> Result 'a AsyncError <Async> = { p } ->
  Async.await { p = p }

## Non-blocking snapshot of the Promise's state.
pub let inspect : { p: Promise 'a } -> PromiseState 'a = { p } ->
  __native_promise_inspect { p = p }

pub let is_done : { p: Promise 'a } -> Bool = { p } ->
  match __native_promise_inspect { p = p } is
    Pending -> False
    _ -> True

pub let is_pending : { p: Promise 'a } -> Bool = { p } ->
  match __native_promise_inspect { p = p } is
    Pending -> True
    _ -> False

pub let is_failed : { p: Promise 'a } -> Bool = { p } ->
  match __native_promise_inspect { p = p } is
    Failed { err = _ } -> True
    _ -> False

pub let is_cancelled : { p: Promise 'a } -> Bool = { p } ->
  match __native_promise_inspect { p = p } is
    Failed { err = AsyncCancelled } -> True
    _ -> False

## Request cancellation; returns the actual outcome.
pub let cancel : { p: Promise 'a } -> CancelOutcome <Async> = { p } ->
  Async.cancel { p = p }

impl Promise 'a where {
  await        = { it } -> await        { p = it },
  inspect      = { it } -> inspect      { p = it },
  is_done      = { it } -> is_done      { p = it },
  is_pending   = { it } -> is_pending   { p = it },
  is_failed    = { it } -> is_failed    { p = it },
  is_cancelled = { it } -> is_cancelled { p = it },
  cancel       = { it } -> cancel       { p = it },
}

## Error type for async operations.
pub type AsyncError = |
  AsyncFailed { msg: Str },
  AsyncCancelled,
  AsyncTimedOut { ms: Int },
|

## Snapshot of a Promise's state at one moment in time.
## Returned by `Promise.inspect {}` — never blocks, never raises.
pub type PromiseState 'a = |
  Pending,
  Completed { val: 'a },
  Failed { err: AsyncError },
|

## What happened when you tried to cancel a Promise.
## Returned by `Promise.cancel {}` — never loses information about
## whether the cancellation actually took effect.
pub type CancelOutcome = |
  Cancelled,
  AlreadyCompleted,
  AlreadyFailed,
  NotCancellable,
|

## Unified async effect for spawning, awaiting, and structured concurrency.
effect Async where {
  ## Spawn a computation, returning a Promise immediately.
  spawn: { f: {} -> 'a <...> } -> Promise 'a <Async, ...>,
  ## Await a Promise. Returns `Result 'a AsyncError`:
  ##   Ok { val }                  — the spawned task produced a value.
  ##   Err { error = AsyncCancelled }      — the promise was cancelled.
  ##   Err { error = AsyncTimedOut { ms }} — only if the await itself
  ##                                         was bounded; not used by
  ##                                         the bare effect op.
  ##   Err { error = AsyncFailed { msg } } — the spawned task crashed.
  ## Never raises; non-raising failure surfaces are part of the contract.
  await: { p: Promise 'a } -> Result 'a AsyncError <Async>,
  ## Wait for the first Promise to settle as Ok or Err, auto-cancelling
  ## the losing siblings. Returns `Result 'a AsyncError`:
  ##   Ok { val }                          — the winner produced a value.
  ##   Err { error = AsyncFailed { msg } } — the winner crashed.
  ##   Err { error = AsyncCancelled }      — every promise was cancelled,
  ##                                         or the race itself was
  ##                                         interrupted.
  ## Cancelled promises in the input are skipped; race waits for a
  ## non-cancelled outcome.
  race: { ps: [Promise 'a] } -> Result 'a AsyncError <Async>,
  ## Wait for all Promises to complete.
  all: { ps: [Promise 'a] } -> ['a] <Async>,
  ## Await with timeout, returning None if it expires.
  timeout: { ms: Int, p: Promise 'a } -> Option 'a <Async>,
  ## Request cancellation of a Promise; returns CancelOutcome describing
  ## what actually happened (Cancelled, AlreadyCompleted, AlreadyFailed,
  ## NotCancellable). Cancellation is effectful: it can interrupt
  ## in-flight I/O in the spawned task.
  cancel: { p: Promise 'a } -> CancelOutcome <Async>,
  ## Sleep for the given milliseconds.
  sleep: { ms: Int } -> {} <Async>,
  ## Check if a Promise is complete (non-blocking).
  is_done: { p: Promise 'a } -> Bool <Async>,
  ## Check if current computation was cancelled.
  is_cancelled: {} -> Bool <Async>,
  ## Cancellation checkpoint -- throws if cancelled.
  check: {} -> {} <Async>,
  ## Run two computations concurrently. Each side is reported as
  ## `Result 'x AsyncError`. On first failure, the surviving sibling is
  ## cancelled (auto-cancel #122) — observers see it as
  ## `Err { error = AsyncCancelled }`.
  join: { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: Result 'a AsyncError, r: Result 'b AsyncError } <Async, ...>,
  ## Run three computations concurrently. Same cancel-on-first-failure
  ## semantics as join.
  join3: { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> } -> { a: Result 'a AsyncError, b: Result 'b AsyncError, c: Result 'c AsyncError } <Async, ...>,
  ## Map over a sequence concurrently, results in input order.
  map: { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <Async, ...>,
  ## Run f on each element concurrently for side effects.
  for_each: { xs: ['a], f: { x: 'a } -> {} <...> } -> {} <Async, ...>,
  ## Filter elements with concurrent predicate evaluation.
  filter: { xs: ['a], f: { x: 'a } -> Bool <...> } -> ['a] <Async, ...>,
  ## Return first successful result; fail only if all fail.
  any: { ps: [Promise 'a] } -> 'a <Async>,
  ## Await all promises, returning Results (never throws).
  settle: { ps: [Promise 'a] } -> [Result 'a AsyncError] <Async>,
  ## Run f within a structured concurrency scope.
  scoped: { f: { sc: Scope 'a } -> 'a <...> } -> 'a <Async, ...>,
  ## Suspend until {@code predicate} returns True. How "suspend" is
  ## realized depends on the handler.
  park: { predicate: {} -> Bool <...> } -> {} <Async, ...>
}

## Default handler using Project Loom virtual threads.
impl Async for LoomAsync where {
  initialize_scope = {} -> __native_loom_init_scope {},
  finalize_scope = {} -> __native_loom_finalize_scope { tracker = scope },
  spawn = { f } -> __native_loom_spawn_tracked { f = f, max_concurrent = 0, tracker = scope },
  await = { p } -> __native_promise_await_result { p = p },
  race = { ps } -> __native_loom_race { ps = ps },
  all = { ps } -> __native_loom_all { ps = ps },
  timeout = { ms, p } -> __native_loom_timeout { ms = ms, p = p },
  cancel = { p } -> __native_promise_cancel { p = p },
  sleep = { ms } -> __native_loom_sleep { ms = ms },
  is_done = { p } -> __native_loom_is_done { p = p },
  is_cancelled = {} -> __native_loom_is_cancelled {},
  check = {} -> __native_loom_check {},
  join = { l, r } -> __native_loom_join { l = l, r = r },
  join3 = { a, b, c } -> __native_loom_join3 { a = a, b = b, c = c },
  map = { xs, f } -> __native_loom_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_loom_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_loom_filter { xs = xs, f = f },
  any = { ps } -> __native_loom_any { ps = ps },
  settle = { ps } -> __native_loom_settle { ps = ps },
  scoped = { f } -> __native_loom_scoped { f = f },
  park = { predicate } -> __native_loom_park_until { predicate = predicate },
}

## LoomAsync with configurable concurrency limit (0 = unbounded).
impl Async for LoomAsyncWith { max_concurrent: Int } where {
  initialize_scope = {} -> __native_loom_init_scope {},
  finalize_scope = {} -> __native_loom_finalize_scope { tracker = scope },
  spawn = { f } ->
    __native_loom_spawn_tracked {
      f = f,
      max_concurrent = max_concurrent,
      tracker = scope,
    },
  await = { p } -> __native_promise_await_result { p = p },
  race = { ps } -> __native_loom_race { ps = ps },
  all = { ps } -> __native_loom_all { ps = ps },
  timeout = { ms, p } -> __native_loom_timeout { ms = ms, p = p },
  cancel = { p } -> __native_promise_cancel { p = p },
  sleep = { ms } -> __native_loom_sleep { ms = ms },
  is_done = { p } -> __native_loom_is_done { p = p },
  is_cancelled = {} -> __native_loom_is_cancelled {},
  check = {} -> __native_loom_check {},
  join = { l, r } -> __native_loom_join { l = l, r = r },
  join3 = { a, b, c } -> __native_loom_join3 { a = a, b = b, c = c },
  map = { xs, f } -> __native_loom_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_loom_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_loom_filter { xs = xs, f = f },
  any = { ps } -> __native_loom_any { ps = ps },
  settle = { ps } -> __native_loom_settle { ps = ps },
  scoped = { f } -> __native_loom_scoped { f = f },
  park = { predicate } -> __native_loom_park_until { predicate = predicate },
}

## OS platform thread implementation for true parallelism on CPU-bound work.
impl Async for OSThreadAsync where {
  initialize_scope = {} -> __native_os_init_scope {},
  finalize_scope = {} -> __native_os_finalize_scope { tracker = scope },
  spawn = { f } -> __native_os_spawn_tracked { f = f, pool_size = 0, tracker = scope },
  # Stateless ops operate on MezzePromise values (which carry their own
  # thread reference). They share implementation with LoomAsync.
  await = { p } -> __native_promise_await_result { p = p },
  race = { ps } -> __native_loom_race { ps = ps },
  all = { ps } -> __native_loom_all { ps = ps },
  timeout = { ms, p } -> __native_loom_timeout { ms = ms, p = p },
  cancel = { p } -> __native_promise_cancel { p = p },
  sleep = { ms } -> __native_loom_sleep { ms = ms },
  is_done = { p } -> __native_loom_is_done { p = p },
  is_cancelled = {} -> __native_loom_is_cancelled {},
  check = {} -> __native_loom_check {},
  any = { ps } -> __native_loom_any { ps = ps },
  settle = { ps } -> __native_loom_settle { ps = ps },
  park = { predicate } -> __native_loom_park_until { predicate = predicate },
  # Stateful ops genuinely create platform threads — keep dedicated natives.
  join = { l, r } -> __native_os_join { l = l, r = r },
  join3 = { a, b, c } -> __native_os_join3 { a = a, b = b, c = c },
  map = { xs, f } -> __native_os_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_os_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_os_filter { xs = xs, f = f },
  scoped = { f } -> __native_loom_scoped { f = f },
}

## OSThreadAsync with configurable thread pool size (0 = unbounded).
impl Async for OSThreadAsyncWith { pool_size: Int } where {
  initialize_scope = {} -> __native_os_init_scope {},
  finalize_scope = {} -> __native_os_finalize_scope { tracker = scope },
  spawn = { f } -> __native_os_spawn_tracked { f = f, pool_size = pool_size, tracker = scope },
  # Same sharing as OSThreadAsync above — stateless ops route to Loom natives.
  await = { p } -> __native_promise_await_result { p = p },
  race = { ps } -> __native_loom_race { ps = ps },
  all = { ps } -> __native_loom_all { ps = ps },
  timeout = { ms, p } -> __native_loom_timeout { ms = ms, p = p },
  cancel = { p } -> __native_promise_cancel { p = p },
  sleep = { ms } -> __native_loom_sleep { ms = ms },
  is_done = { p } -> __native_loom_is_done { p = p },
  is_cancelled = {} -> __native_loom_is_cancelled {},
  check = {} -> __native_loom_check {},
  any = { ps } -> __native_loom_any { ps = ps },
  settle = { ps } -> __native_loom_settle { ps = ps },
  park = { predicate } -> __native_loom_park_until { predicate = predicate },
  join = { l, r } -> __native_os_join { l = l, r = r },
  join3 = { a, b, c } -> __native_os_join3 { a = a, b = b, c = c },
  map = { xs, f } -> __native_os_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_os_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_os_filter { xs = xs, f = f },
  scoped = { f } -> __native_loom_scoped { f = f },
}

## Cooperative single-threaded scheduler using continuations.
## Tasks interleave at await points. Good for testing and deterministic execution.
impl Async for CoopAsync where {
  initialize_scope = {} -> __native_scheduler_new {},
  finalize_scope = {} -> __native_scheduler_drain { sched = scope },
  spawn = { f } -> Promise {
    val = __native_scheduler_spawn { sched = scope, f = f },
  },
  ## CoopAsync's await blocks the cooperative scheduler — running other
  ## ready tasks until the target promise completes. The scheduler's await
  ## native still throws on task failure today (technical debt — same as
  ## pre-#143). Wrap in Ok for the common case; failure propagation
  ## through Coop is a separate follow-up.
  await = { p } -> match p is
    Promise { val = native_p } -> Ok {
      val = __native_scheduler_await { sched = scope, p = native_p },
    },
  race = { ps } -> do
    let native_ps = seq::map { xs = ps, f = { x } -> match x is
      Promise { val = p } -> p
 }
    __native_scheduler_race { sched = scope, ps = native_ps },
  all = { ps } -> do
    let native_ps = seq::map { xs = ps, f = { x } -> match x is
      Promise { val = p } -> p
 }
    __native_scheduler_all { sched = scope, ps = native_ps },
  timeout = { ms, p } -> match p is
    Promise { val = native_p } -> Some {
      val = __native_scheduler_await { sched = scope, p = native_p },
    },
  cancel = { p } -> __native_promise_cancel { p = p },
  sleep = { ms } -> __native_scheduler_sleep { sched = scope, ms = ms },
  is_done = { p } -> match p is
    Promise { val = native_p } -> __native_scheduler_is_done { p = native_p },
  is_cancelled = {} -> False,
  check = {} -> {},
  ## Coop join: wraps each side's result in Ok. The scheduler's await
  ## still throws on task failure today (#122e tech debt — Coop
  ## doesn't yet observe AsyncError); when that's fixed both sides
  ## will report as proper Result.
  join = { l, r } -> do
    let p_l = __native_scheduler_spawn { sched = scope, f = l }
    let p_r = __native_scheduler_spawn { sched = scope, f = r }
    let r_l = __native_scheduler_await { sched = scope, p = p_l }
    let r_r = __native_scheduler_await { sched = scope, p = p_r }
    { l = Ok { val = r_l }, r = Ok { val = r_r } },
  join3 = { a, b, c } -> do
    let p_a = __native_scheduler_spawn { sched = scope, f = a }
    let p_b = __native_scheduler_spawn { sched = scope, f = b }
    let p_c = __native_scheduler_spawn { sched = scope, f = c }
    let r_a = __native_scheduler_await { sched = scope, p = p_a }
    let r_b = __native_scheduler_await { sched = scope, p = p_b }
    let r_c = __native_scheduler_await { sched = scope, p = p_c }
    { a = Ok { val = r_a }, b = Ok { val = r_b }, c = Ok { val = r_c } },
  map = { xs, f } -> do
    let promises = seq::map { xs = xs, f = { x } ->
      __native_scheduler_spawn { sched = scope, f = {} -> f { x = x } } }
    seq::map { xs = promises, f = { x } -> __native_scheduler_await { sched = scope, p = x } },
  for_each = { xs, f } -> do
    let promises = seq::map { xs = xs, f = { x } ->
      __native_scheduler_spawn { sched = scope, f = {} -> f { x = x } } }
    seq::for_each { xs = promises, f = { x } -> __native_scheduler_await { sched = scope, p = x } }
    {},
  filter = { xs, f } -> do
    let checks = seq::map { xs = xs, f = { x } ->
      {
        elem = x,
        promise = __native_scheduler_spawn { sched = scope, f = {} -> f { x = x } },
      } }
    let filtered = seq::filter { xs = checks, p = { x } ->
      __native_scheduler_await { sched = scope, p = x.promise } }
    seq::map { xs = filtered, f = { x } -> x.elem },
  any = { ps } -> do
    let native_ps = seq::map { xs = ps, f = { x } -> match x is
      Promise { val = p } -> p
 }
    __native_scheduler_race { sched = scope, ps = native_ps },
  settle = { ps } -> do
    seq::map { xs = ps, f = { x } -> match x is
      Promise { val = native_p } -> Ok {
        val = __native_scheduler_await { sched = scope, p = native_p },
      }
 },
  scoped = { f } -> f { sc = Scope { val = {} } },
  ## Park: run ready tasks until predicate returns True.
  park = { predicate } -> __native_scheduler_park_until { sched = scope, predicate = predicate },
}

## Spawn and immediately await (synchronous helper).
## Returns the Result from `Async.await` — callers decide how to handle failure.
pub let run : { f: {} -> 'a <...> } -> Result 'a AsyncError <Async, ...> = { f } -> do
  let p = Async.spawn { f = f }
  Async.await { p = p }

## Spawn and detach (fire and forget).
pub let go : { f: {} -> 'a <...> } -> {} <Async, ...> = { f } -> do
  let _ = Async.spawn { f = f }
  {}

## ==================================================================
## Park-based helpers — derived from spawn + park + await primitives.
## These are equivalent to the Async.* ops of the same name and exist
## as plain functions so the Async effect can eventually shrink to
## just the primitives. For now both paths coexist.
## ==================================================================

## Wait for any of a list of promises to settle, returning the first
## non-cancelled outcome as `Result 'a AsyncError`. Losing siblings are
## auto-cancelled when the winner commits.
pub let race : { ps: [Promise 'a] } -> Result 'a AsyncError <Async, ...> = { ps } ->
  Async.race { ps = ps }

## Wait for all promises; return each one's Result in input order. Never
## raises; the per-promise Result carries success/failure information.
pub let all : { ps: [Promise 'a] } -> [Result 'a AsyncError] <Async, ...> = { ps } ->
  seq::map { xs = ps, f = { x } -> Async.await { p = x } }

## Run two thunks concurrently, return both Results.
pub let join : { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: Result 'a AsyncError, r: Result 'b AsyncError } <Async, ...> =
  { l, r } -> do
    let pl = Async.spawn { f = l }
    let pr = Async.spawn { f = r }
    { l = Async.await { p = pl }, r = Async.await { p = pr } }

## Run three thunks concurrently, return all Results.
pub let join3 : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> } -> { a: Result 'a AsyncError, b: Result 'b AsyncError, c: Result 'c AsyncError } <Async, ...> = { a, b, c } -> do
  let pa = Async.spawn { f = a }
  let pb = Async.spawn { f = b }
  let pc = Async.spawn { f = c }
  { a = Async.await { p = pa }, b = Async.await { p = pb }, c = Async.await { p = pc } }

## Map over a sequence concurrently; results in input order.
pub let par_map : { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <Async, ...> =
  { xs, f } -> do
    let ps = seq::map { xs = xs, f = { x } -> Async.spawn { f = {} -> f { x = x } } }
    all { ps = ps }

## Run f over each element concurrently, discard results.
pub let par_for_each : { xs: ['a], f: { x: 'a } -> {} <...> } -> {} <Async, ...> =
  { xs, f } -> do
    let _ = par_map { xs = xs, f = f }
    {}

## Filter a sequence with concurrent predicate evaluation.
pub let par_filter : { xs: ['a], f: { x: 'a } -> Bool <...> } -> ['a] <Async, ...> =
  { xs, f } -> do
    let tagged = par_map {
      xs = xs,
      f = { x } -> { elem = x, keep = f { x = x } },
    }
    seq::map {
      xs = seq::filter { xs = tagged, p = { x } -> x.keep },
      f = { x } -> x.elem,
    }

## Wait for p up to ms milliseconds; None if it didn't finish in time.
pub let with_timeout : { ms: Int, p: Promise 'a } -> Option 'a <Async, ...> = { ms, p } ->
  Async.timeout { ms = ms, p = p }

## ==================================================================
## try_* — fail-fast variants. On first Err, cancel the rest and
## return that error. On success of every input, return the unwrapped
## values. Matches Rust `try_join_all` / `try_join!` semantics.
## ==================================================================

## Wait for all promises; if any fails, cancel the rest and return
## the first error. Otherwise return the unwrapped values in input order.
##
## Implementation: await each in turn; collect Results into a seq. After
## all awaits complete (or short-circuit doesn't happen because we already
## awaited them all sequentially), scan for the first error and either
## return Ok of unwrapped values or Err with the first error.
##
## TODO #169: switch to a fail-fast spawn-of-spawns implementation that
## cancels siblings as soon as one errs, rather than the current
## "await everything, then check" approach.
pub let try_all : { ps: [Promise 'a] } -> Result ['a] AsyncError <Async, ...> = { ps } -> do
  let results = seq::map { xs = ps, f = { x } -> Async.await { p = x } }
  match seq::find { xs = results, p = { x } -> result::is_err { result = x } } is
    Some { val = first_err } -> match first_err is
      Err { error = e } -> Err { error = e }
      Ok  { val = _ }   -> Err { error = AsyncFailed { msg = "try_all: impossible" } }
    None ->
      Ok { val = seq::map { xs = results, f = { x } ->
        match x is
          Ok  { val = v }   -> v
          Err { error = _ } -> crash { msg = "try_all: impossible" }
      } }

## Run two thunks concurrently. On the first Err, cancel the surviving
## sibling and return that error. Otherwise return both unwrapped values.
pub let try_join : { l: {} -> 'a <...>, r: {} -> 'b <...> } -> Result { l: 'a, r: 'b } AsyncError <Async, ...> =
  { l, r } -> do
    let pl = Async.spawn { f = l }
    let pr = Async.spawn { f = r }
    match Async.await { p = pl } is
      Err { error = e } -> do
        Async.cancel { p = pr }
        Async.await { p = pr }
        Err { error = e }
      Ok { val = vl } ->
        match Async.await { p = pr } is
          Err { error = e } -> Err { error = e }
          Ok  { val = vr }  -> Ok { val = { l = vl, r = vr } }

## Run three thunks concurrently with fail-fast + auto-cancel semantics.
pub let try_join3 : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> } -> Result { a: 'a, b: 'b, c: 'c } AsyncError <Async, ...> =
  { a, b, c } -> do
    let pa = Async.spawn { f = a }
    let pb = Async.spawn { f = b }
    let pc = Async.spawn { f = c }
    match Async.await { p = pa } is
      Err { error = e } -> do
        Async.cancel { p = pb }
        Async.cancel { p = pc }
        Async.await { p = pb }
        Async.await { p = pc }
        Err { error = e }
      Ok { val = va } ->
        match Async.await { p = pb } is
          Err { error = e } -> do
            Async.cancel { p = pc }
            Async.await { p = pc }
            Err { error = e }
          Ok { val = vb } ->
            match Async.await { p = pc } is
              Err { error = e } -> Err { error = e }
              Ok  { val = vc }  -> Ok { val = { a = va, b = vb, c = vc } }

## Run a computation with cooperative scheduling.
pub let run_coop : { computation: {} -> 'a <Async> } -> 'a = { computation } -> perform CoopAsync in computation {}

## Spawn a task within a structured concurrency scope.
pub let scope_spawn : { sc: Scope 'a, f: {} -> 'b <...> } -> Promise 'b = { sc, f } ->
  __native_loom_scope_spawn { sc = sc, f = f }

## Cancel all tasks in a scope.
pub let scope_cancel_all : { sc: Scope 'a } -> {} = { sc } ->
  __native_loom_scope_cancel_all { sc = sc }

## Get the CancellationToken for a scope.
pub let scope_get_token : { sc: Scope 'a } -> CancellationToken = { sc } ->
  __native_loom_scope_get_token { sc = sc }

## Check if a scope has been cancelled.
pub let scope_is_cancelled : { sc: Scope 'a } -> Bool = { sc } ->
  __native_loom_scope_is_cancelled { sc = sc }
