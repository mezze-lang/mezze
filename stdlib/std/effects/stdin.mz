# Standard input effect.
# All operations block until input or EOF. Wrap in <Async> for non-blocking reads.

## Read operations on the process's stdin.
effect Stdin where {
  ## Trailing newline is stripped. None on EOF.
  read_line: {} -> Option Str <Stdin>,
  ## None on EOF.
  read_char: {} -> Option Char <Stdin>,
  ## Returns up to `max` bytes; may return fewer if EOF reached mid-read. Empty Bytes signals EOF.
  read_bytes: { max: Int } -> Bytes <Stdin>,
  ## True if stdin is connected to a terminal (vs. piped or redirected from a file).
  is_tty: {} -> Bool <Stdin>,
  ## Disables terminal echo for the duration of the read. None on EOF or when stdin isn't a terminal.
  read_password: {} -> Option Str <Stdin>
}

## Real stdin backed by the process's System.in.
impl Stdin for SystemStdin where {
  read_line = {} -> __native_stdin_read_line {},
  read_char = {} -> __native_stdin_read_char {},
  read_bytes = { max } -> __native_stdin_read_bytes { max = max },
  is_tty = {} -> __native_stdin_is_tty {},
  read_password = {} -> __native_stdin_read_password {},
}

## In-memory stdin for testing. Reads share one cursor across all ops.
impl Stdin for MockStdin { lines: [Str] } where {
  read_line = {} -> __native_mock_stdin_read_line { lines = lines },
  read_char = {} -> __native_mock_stdin_read_char { lines = lines },
  read_bytes = { max } -> __native_mock_stdin_read_bytes { lines = lines, max = max },
  is_tty = {} -> False,
  read_password = {} -> __native_mock_stdin_read_password { lines = lines },
}

## Read a line from stdin. Trailing newline stripped. None on EOF.
pub let read_line : {} -> Option Str <Stdin> = {} -> Stdin.read_line {}

## Read a single character from stdin. None on EOF.
pub let read_char : {} -> Option Char <Stdin> = {} -> Stdin.read_char {}

## Read up to `max` bytes from stdin. Empty Bytes signals EOF.
pub let read_bytes : { max: Int } -> Bytes <Stdin> = { max } -> Stdin.read_bytes { max = max }

## True if stdin is a terminal.
pub let is_tty : {} -> Bool <Stdin> = {} -> Stdin.is_tty {}

## Read a password with terminal echo disabled. None on EOF or non-terminal stdin.
pub let read_password : {} -> Option Str <Stdin> = {} -> Stdin.read_password {}
