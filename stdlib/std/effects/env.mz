# Environment variables effect (HOME, PATH, etc).
# Mirrors Rust's std::env::var / set_var / vars iter.
## Read/write the process's environment variables.
effect Env where {
  ## Returns None if the variable isn't set.
  lookup: { name: Str } -> Option Str <Env>,
  ## Sets a variable for the current process. Doesn't propagate to the parent shell.
  set: { name: Str, value: Str } -> {} <Env>,
  ## All key/value pairs currently in the environment.
  all: {} -> [{ k: Str, v: Str }] <Env>
}

## Real env-var access via the running JVM/native process.
impl Env for SystemEnv where {
  lookup = { name } -> __native_env_get { name = name },
  set = { name, value } -> __native_env_set { name = name, value = value },
  all = {} -> __native_env_get_all {},
}

## Test-friendly env. Reads return values from `vars`; writes are silent no-ops.
impl Env for MockEnv { vars: [{ k: Str, v: Str }] } where {
  lookup = { name } -> __native_mock_env_get { env_vars = vars, name = name },
  set = { name, value } -> {},
  all = {} -> vars,
}

## Look up one variable. None if unset.
pub let lookup: { name: Str } -> Option Str <Env> = { name } -> Env.lookup { name = name }

## All variables as key/value pairs.
pub let all: {} -> [{ k: Str, v: Str }] <Env> = {} -> Env.all {}
