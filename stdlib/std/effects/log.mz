## Extensible log level type, open for user-defined levels.
pub type LogLevel = | Error, Warn, Info, Debug, Trace, Print, ... |

## Logging effect with a single operation dispatching on level.
effect Log where {
  ## Write a log message at the given level.
  log: { level: LogLevel, msg: Str } -> {} <Log>
}

## Default formatter that prefixes known levels.
pub let default_formatter : { level: LogLevel, msg: Str } -> Str = { level, msg } ->
  match level is
    Error -> "[ERROR] $(msg)\n"
    Warn -> "[WARN] $(msg)\n"
    Info -> "[INFO] $(msg)\n"
    Debug -> "[DEBUG] $(msg)\n"
    Trace -> "[TRACE] $(msg)\n"
    _ -> msg


## ANSI color formatter for terminal output.
pub let color_formatter : { level: LogLevel, msg: Str } -> Str = { level, msg } ->
  match level is
    Error -> "\\x1b[31m[ERROR]\\x1b[0m $(msg)\n"
    Warn -> "\\x1b[33m[WARN]\\x1b[0m $(msg)\n"
    Info -> "\\x1b[32m[INFO]\\x1b[0m $(msg)\n"
    Debug -> "\\x1b[36m[DEBUG]\\x1b[0m $(msg)\n"
    Trace -> "\\x1b[90m[TRACE]\\x1b[0m $(msg)\n"
    _ -> msg


## Console handler that prints to stdout with the default formatter.
impl Log for Console where {
  log = { level, msg } ->
    __native_console_print { msg = default_formatter { level = level, msg = msg } }
}

## Console handler with a user-supplied formatter.
impl Log for ConsoleWith { formatter: { level: LogLevel, msg: Str } -> Str } where {
  log = { level, msg } ->
    __native_console_print { msg = formatter { level = level, msg = msg } }
}

## Silent handler that discards all output, useful for testing.
impl Log for QuietConsole where {
  log = { level, msg } -> {}
}

## Log at Error level.
pub let error : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Error, msg = msg }

## Log at Warn level.
pub let warn : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Warn, msg = msg }

## Log at Info level.
pub let info : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Info, msg = msg }

## Log at Debug level.
pub let debug : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Debug, msg = msg }

## Log at Trace level.
pub let trace : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Trace, msg = msg }

## Print a raw message without level prefix.
pub let print : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Print, msg = msg }

## Print a raw message with trailing newline.
pub let println : { msg: Str } -> {} <Log> = { msg } -> Log.log { level = Print, msg = "$(msg)\n" }
