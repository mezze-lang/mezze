# std/effects/log.mz - Logging effects
#
# A simple, extensible logging effect with a single operation.
# Log levels are open variants, allowing users to define custom levels.
#
# Usage:
#   use std::effects::log::{Log, Console, println, info, debug}
#
#   perform Console in do
#       println {msg = "Hello world"}
#       info {msg = "Starting application"}
#       debug {msg = "Debug info"}

# =============================================================================
# Log Level - Open variant type for extensibility
# =============================================================================

pub type LogLevel = | Error, Warn, Info, Debug, Trace, Print, ... |

# =============================================================================
# Log Effect - Single operation with open variant levels
# =============================================================================

effect Log where {
    log: {level: LogLevel, msg: String} -> {} <Log>
}

# =============================================================================
# Formatters - Users can use these or create their own
# =============================================================================

# Default formatter - adds prefix for known levels, unknown pass through as-is
pub let default_formatter: {level: LogLevel, msg: String} -> String =
    {level, msg} -> match level is
        Error -> "[ERROR] $(msg)\n"
        Warn -> "[WARN] $(msg)\n"
        Info -> "[INFO] $(msg)\n"
        Debug -> "[DEBUG] $(msg)\n"
        Trace -> "[TRACE] $(msg)\n"
        _ -> msg

# Color formatter - ANSI colors for terminal output
pub let color_formatter: {level: LogLevel, msg: String} -> String =
    {level, msg} -> match level is
        Error -> "\x1b[31m[ERROR]\x1b[0m $(msg)\n"
        Warn -> "\x1b[33m[WARN]\x1b[0m $(msg)\n"
        Info -> "\x1b[32m[INFO]\x1b[0m $(msg)\n"
        Debug -> "\x1b[36m[DEBUG]\x1b[0m $(msg)\n"
        Trace -> "\x1b[90m[TRACE]\x1b[0m $(msg)\n"
        _ -> msg

# =============================================================================
# Implementations
# =============================================================================

# Console - default implementation using default_formatter
impl Log for Console where {
    log = {level, msg} -> __native_console_print {msg = default_formatter {level = level, msg = msg}}
}

# ConsoleWith - customizable formatter
impl Log for ConsoleWith {formatter: {level: LogLevel, msg: String} -> String} where {
    log = {level, msg} -> __native_console_print {msg = formatter {level = level, msg = msg}}
}

# QuietConsole - for testing, suppresses all output
impl Log for QuietConsole where {
    log = {level, msg} -> {}
}

# =============================================================================
# Helper Functions - Convenient wrappers
# =============================================================================

# Level-specific helpers
pub let error: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Error, msg = msg}
pub let warn: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Warn, msg = msg}
pub let info: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Info, msg = msg}
pub let debug: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Debug, msg = msg}
pub let trace: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Trace, msg = msg}

# Print helpers - use Print level (falls through to raw message in default_formatter)
pub let print: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Print, msg = msg}
pub let println: {msg: String} -> {} <Log> = {msg} -> Log.log {level = Print, msg = "$(msg)\n"}
