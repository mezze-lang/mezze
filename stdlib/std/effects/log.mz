# std/effects/log.mezze - Logging effects

effect Log where {
    info: { msg: String } -> {} <Log>,
    warn: { msg: String } -> {} <Log>,
    error: { msg: String } -> {} <Log>,
    debug: { msg: String } -> {} <Log>,
    trace: { msg: String } -> {} <Log>,
    print: { msg: String } -> {} <Log>,
    println: { msg: String } -> {} <Log>
}

# Console-based logging implementation (runs in virtual threads)
pub impl Log for Console where {
    info: { msg: String } -> {} = { msg } -> __native_log_info { msg = msg },
    warn: { msg: String } -> {} = { msg } -> __native_log_warn { msg = msg },
    error: { msg: String } -> {} = { msg } -> __native_log_error { msg = msg },
    debug: { msg: String } -> {} = { msg } -> __native_log_debug { msg = msg },
    trace: { msg: String } -> {} = { msg } -> __native_log_trace { msg = msg },
    print: { msg: String } -> {} = { msg } -> __native_console_print { msg = msg },
    println: { msg: String } -> {} = { msg } -> __native_console_println { msg = msg }
}

# Quiet logging implementation (for testing - suppresses output)
pub impl Log for QuietConsole where {
    info: { msg: String } -> {} = { msg } -> {},
    warn: { msg: String } -> {} = { msg } -> {},
    error: { msg: String } -> {} = { msg } -> {},
    debug: { msg: String } -> {} = { msg } -> {},
    trace: { msg: String } -> {} = { msg } -> {},
    print: { msg: String } -> {} = { msg } -> {},
    println: { msg: String } -> {} = { msg } -> {}
}

# Convenience functions
pub let info: { msg: String } -> {} <Log> = { msg } -> Log.info { msg = msg }
pub let println: { msg: String } -> {} <Log> = { msg } -> Log.println { msg = msg }
