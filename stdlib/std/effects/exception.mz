## Typed exception effect for recoverable errors.
effect Exception having 'error where {
  ## Throw an error, aborting normal control flow.
  throw: { error: 'error } -> 'a <Exception>
}

## Converts exceptions to Result values (Ok on success, Err on throw).
impl Exception for ExceptionToResult having 'error = 'e where {
  throw = { error } -> abort { val = Err { error } }
}

## Converts exceptions to Option (Some on success, None on throw).
impl Exception for ExceptionToOption having 'error = 'e where {
  throw = { error } -> abort { val = None }
}

## Aborts current computation on throw, returning unit.
impl Exception for AbortException having 'error = 'e where {
  throw = { error } -> abort { val = {} }
}

## Silently ignores all errors, returning unit on throw.
impl Exception for IgnoreException having 'error = 'e where {
  throw = { error } -> abort { val = {} }
}

## Terminates the program immediately on throw. Use for fatal errors only.
impl Exception for CrashException having 'error = 'e where {
  throw = { error } -> crash { msg = "Unhandled exception" }
}

## Shorthand for Exception.throw.
pub let throw = { error } -> Exception.throw { error }

## Unwrap a Result, throwing on Err.
pub let unwrap = { result } -> match result is
  Ok { val } -> val
  Err { error } -> Exception.throw { error }
