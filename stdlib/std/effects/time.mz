# Time effect definition

effect Time where {
  now: {} -> Int <Time>,
  now_nanos: {} -> Int <Time>,
  sleep: { millis: Int } -> {} <Time>,
  sleep_nanos: { nanos: Int } -> {} <Time>,
  current_year: {} -> Int <Time>,
  current_month: {} -> Int <Time>,
  current_day: {} -> Int <Time>,
  current_hour: {} -> Int <Time>,
  current_minute: {} -> Int <Time>,
  current_second: {} -> Int <Time>,
  format_timestamp: { timestamp: Int, format: Str } -> Str <Time>,
  parse_timestamp: { date_string: Str, format: Str } -> Int <Time>
}
