# std/effects/generator.mz - Generator effect for yielding values
#
# Provides generator functionality via algebraic effects.
# The Generator effect has a single operation: yield.
#
# Usage:
#   use std::effects::generator::{Generator, Collect}
#
#   let values = perform Collect in do
#       Generator.yield {value = 1}
#       Generator.yield {value = 2}
#       Generator.yield {value = 3}
#   # values = [1, 2, 3]
use std::control::continuation
use std::control::continuation::{ Continuation }
# Generator effect with yield operation

effect Generator having 'a where {
  yield: { value: 'a } -> {} <Generator>
}
# =============================================================================
# Handlers
# =============================================================================
# Collect handler - collects all yielded values into a Seq
#
# Uses suspend_and_resume to collect values without escaping,
# then finalize_scope returns all collected values via suspend_with.
#
# Example:
#   let values = perform Collect in do
#       Generator.yield {value = 1}
#       Generator.yield {value = 2}
#       Generator.yield {value = 3}
#   # values = [1, 2, 3]

impl Generator for Collect having 'a = 'x where {
  initialize_scope = {} -> { cont = continuation::new {} },
  finalize_scope = {} -> do
    let collected = scope.cont.take_collected {}
    scope.cont.suspend_with { value = collected },
  yield = { value } -> scope.cont.suspend_and_resume { value = value },
}
# =============================================================================
# Helpers
# =============================================================================
# Shorthand for Generator.yield

pub let yield = { value } -> Generator.yield { value }
