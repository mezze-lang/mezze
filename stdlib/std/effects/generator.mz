## Generator effect for yielding values from a computation.
##
## NON-FUNCTIONAL: this module type-checks but does not work at runtime.
## The AsStream handler captures `resume` inside an abort payload and
## calls it lazily to drive the body forward — but the runtime's `resume`
## is fall-through only (returns its `val` argument, does not re-enter the
## suspended continuation). Fixing this requires exposing the BDSL
## beginYield/endYield continuation primitive to user-level handlers.
##
## Design intent (for when the runtime supports it):
## A generator body performs `Generator.yield`. The `AsStream` impl
## converts the body into a lazy `Stream`: each call to `Stream.next`
## resumes the body until its next yield (or completion), returning
## `Yield {val, rest}` per yielded value and `Done` when the body
## completes.
use std::collections::seq

effect Generator having 'a where {
  ## Yield a value to the caller. Body suspends; the consumer's next call
  ## resumes here with `{}` (yield's return value is unit).
  yield: { value: 'a } -> {} <Generator>
}

## Shorthand for Generator.yield.
pub let yield = { value } -> Generator.yield { value }

## One step of stream iteration: either a value with a continuation,
## or the end of the stream.
pub type Step 'a = | Yield { val: 'a, rest: Stream 'a }, Done |

## Lazy stream of `'a`. The thunk returns `Done` when exhausted, or
## `Yield { val, rest }` with the next element and a continuation stream.
pub newtype Stream 'a = { next: {} -> Step 'a }

## Materialize a stream eagerly into a finite Seq. Stops at the first
## `Done` (so unsafe to call on infinite streams).
pub let to_seq: { stream: Stream 'a } -> ['a] = { stream } -> match stream is
  Stream.({ next }) -> match next {} is
    Done -> []
    Yield { val, rest } -> seq::push_front { xs = to_seq { stream = rest }, x = val }


## Convert a `Generator`-using body into a lazy `Stream`. Each call to
## `Stream.next` runs the body up to the next yield (or to completion).
##
## Implementation: `yield` aborts the surrounding perform with
## `Yield { val, rest }` where `rest` is a Stream whose `next` thunk calls
## `resume {val = {}}`. When body completes naturally (no more yields),
## the body's final expression — must be `Done` — becomes resume's
## return value, which becomes the stream's next value.
impl Generator for AsStream having 'a = 'a where {
  yield = { value } -> abort {
    val = Yield { val = value, rest = Stream.({ next = {} -> resume { val = {} } }) },
  }
}

## Build a `Stream` from a generator body.
##
## Performs `AsStream` on the body. If the body yields immediately, the
## perform's result is `Yield {val, rest}`. If the body completes
## without yielding, the body's final expression must be `Done` and the
## resulting stream is empty.
pub let make_stream
  : { f: {} -> Step 'a <Generator, ...> }
  -> Stream 'a
  = { f } -> Stream.({ next = {} -> perform AsStream in f {} })

## Run a generator body and return all values as a Seq.
## Equivalent to `to_seq { stream = make_stream { f = f } }`.
pub let collect
  : { f: {} -> Step 'a <Generator, ...> }
  -> ['a]
  = { f } -> to_seq { stream = make_stream { f = f } }
