# std/effects/generator.mezze - Generator library built on Continuation effect

# Generators provide a yield/resume pattern for creating lazy sequences.
# Built entirely on top of the Continuation effect - no special language support needed!
#
# This is a pure userland library. Generators are just functions that use
# Continuation.suspend_with to yield values. No effect declaration needed!

use std::control::continuation
use std::control::continuation::{Continuation}

# =============================================================================
# Creating Generators
# =============================================================================

# Create a generator continuation context
# This should be called once at the start of a generator function
# Returns a Continuation record that can be used to yield values
pub let new_generator: {} -> Continuation 'suspend 'resume 'result = {} ->
    continuation::new {}

# Yield a value from a generator
# Creates its own continuation context and suspends with the given value
pub let yield = { value } -> do
    let cont = continuation::new {}
    cont.suspend_with { value = value }

# To create a generator, write a function that calls yield to produce values.
# For example:
#
# use std::effects::generator::{yield, to_list}
#
# let yield_helper = { i, n } -> do
#     if i < n then do
#         yield { value = i }
#         yield_helper { i = i + 1, n = n }
#     else {}
#
# let count_up_to = { n } ->
#     yield_helper { i = 0, n = n }
#
# # Then consume it:
# let my_gen = count_up_to { n = 5 }
# let values = to_list { gen = my_gen }

# =============================================================================
# Generator Consumption Functions
# =============================================================================

# Get the next value from a generator
# Takes a suspended generator state
# Returns { value: Option 'a, gen: next_state }
# - value is Some { val } if there's a yielded value, None if done
# - gen is the next generator state to use for subsequent calls
pub let next = { gen } -> do
    let cont = continuation::new {}
    let extracted = cont.extract_suspended { suspended = gen }
    match extracted is
        Some { val = { value, cont = k } } -> do
            # Resume the continuation to get the next state
            let next_state = cont.resume { cont = k, value = {} }
            { value = Some { val = value }, gen = next_state }
        None -> { value = None, gen = {} }

# Consume entire generator into an array
# Warning: Will not terminate for infinite generators!
# Implemented using recursion over next
pub let to_list_helper = { gen, acc } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            to_list_helper { gen = result.gen, acc = __native_arraylist_concat { xs = acc, ys = [val] } }
        None -> acc

pub let to_list = { gen } ->
    to_list_helper { gen = gen, acc = [] }

# Take first n values from a generator
# Returns { values: ['elem], gen: remaining_state }
# - values is an array of up to n yielded values
# - gen is the remaining generator state (can be used to continue)
pub let take_helper = { gen, n, acc } -> do
    if n <= 0 then
        { values = acc, gen = gen }
    else do
        let result = next { gen = gen }
        match result.value is
            Some { val } ->
                take_helper { gen = result.gen, n = n - 1, acc = __native_arraylist_concat { xs = acc, ys = [val] } }
            None -> { values = acc, gen = {} }

pub let take = { gen, n } -> take_helper { gen = gen, n = n, acc = [] }

# =============================================================================
# Generator Transformation Functions
# =============================================================================

# Internal helper for map - accumulates transformed values
pub let map_helper = { gen, f, acc } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            map_helper { gen = result.gen, f = f, acc = __native_arraylist_concat { xs = acc, ys = [f { x = val }] } }
        None -> acc

# Map a function over all values from a generator
# Consumes the generator and returns an array of transformed values
# Example: map { gen = int_gen, f = { x } -> x * 2 }
pub let map = { gen, f } -> map_helper { gen = gen, f = f, acc = [] }

# Internal helper for filter - accumulates filtered values
pub let filter_helper = { gen, p, acc } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then filter_helper { gen = result.gen, p = p, acc = __native_arraylist_concat { xs = acc, ys = [val] } }
            else filter_helper { gen = result.gen, p = p, acc = acc }
        None -> acc

# Filter values from a generator based on a predicate
# Consumes the generator and returns an array of filtered values
# Example: filter { gen = int_gen, p = { x } -> x % 2 == 0 }
pub let filter = { gen, p } -> filter_helper { gen = gen, p = p, acc = [] }

# Fold over a generator
# Consumes the generator and accumulates a value
# Example: fold { gen = int_gen, init = 0, f = { acc, x } -> acc + x }
pub let fold = { gen, init, f } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            fold { gen = result.gen, init = f { acc = init, x = val }, f = f }
        None -> init

# Internal helper for count - accumulates count
pub let count_helper = { gen, cnt } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } -> count_helper { gen = result.gen, cnt = cnt + 1 }
        None -> cnt

# Count the number of values in a generator
# Consumes the generator
pub let count = { gen } -> count_helper { gen = gen, cnt = 0 }

# Find first value matching predicate
# Returns Option 'a - Some if found, None otherwise
pub let find = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then Some { val = val }
            else find { gen = result.gen, p = p }
        None -> None

# Check if any value matches predicate
pub let any = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then True
            else any { gen = result.gen, p = p }
        None -> False

# Check if all values match predicate
pub let all = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then all { gen = result.gen, p = p }
            else False
        None -> True
