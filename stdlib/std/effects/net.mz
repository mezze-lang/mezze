# Raw TCP and UDP: bytes in, bytes out. Framing and protocols are functions over
# the ops, so the same code runs on real sockets or on an in-memory `Network`.
use std::collections::bytes
use std::int
use std::option
use std::result
use std::effects::async::{ Async }

## A host name or IP literal and a port. Names resolve at `connect` or `bind`.
pub type Addr = { host: Str, port: Int }

## Loopback on `port`.
pub let local: { port: Int } -> Addr = { port } -> { host = "127.0.0.1", port = port }

## `"host:port"`.
pub let addr_to_str: { addr: Addr } -> Str = { addr } -> "$(addr.host):$(int::to_str { n = addr.port })"

## Why a socket op failed. `NetIo` carries the runtime's message for anything the others do not name.
pub type NetError = |
  NetRefused { addr: Addr },
  NetUnresolved { host: Str },
  NetUnreachable { addr: Addr },
  NetTimeout,
  NetBindFailed { addr: Addr, reason: Str },
  NetClosed,
  NetIo { reason: Str },
|

## `connect_timeout_ms` bounds `connect`; `receive_timeout_ms` bounds each `receive` (`0` waits
## forever; a timed-out receive leaves the connection usable). `no_delay` turns Nagle's algorithm off.
pub type TcpConfig = { connect_timeout_ms: Int, receive_timeout_ms: Int, no_delay: Bool }

## Ten seconds to connect, receives wait forever, no delay.
pub let default_tcp_config: TcpConfig = { connect_timeout_ms = 10000, receive_timeout_ms = 0, no_delay = True }

## One TCP connection, either side.
pub newtype TcpConn = __NativeTcpConn

## Connect out and move bytes over an open connection.
effect Tcp where {
  connect: { addr: Addr, config: TcpConfig } -> Result TcpConn NetError <Tcp>,
  ## At most `max_bytes` of what has arrived; blocks until something has. `None` once the peer closed its side.
  receive: { conn: TcpConn, max_bytes: Int } -> Result (Option Bytes) NetError <Tcp>,
  send: { conn: TcpConn, data: Bytes } -> Result {} NetError <Tcp>,
  ## Half-close: the peer's `receive` sees `None`; receiving here still works.
  shutdown_write: { conn: TcpConn } -> Result {} NetError <Tcp>,
  close: { conn: TcpConn } -> {} <Tcp>,
}

## The JDK's sockets, blocking the calling thread.
impl Tcp for NativeTcp where {
  connect = { addr, config } -> __native_tcp_connect { addr = addr, config = config },
  receive = { conn, max_bytes } -> __native_net_conn_receive { conn = conn, max_bytes = max_bytes },
  send = { conn, data } -> __native_net_conn_send { conn = conn, data = data },
  shutdown_write = { conn } -> __native_net_conn_shutdown_write { conn = conn },
  close = { conn } -> __native_net_conn_close { conn = conn },
}

## A bound, listening TCP socket.
pub newtype TcpListener = __NativeTcpListener

## An accepted connection and who opened it.
pub type Accepted = { conn: TcpConn, peer: Addr }

## Listen and accept. Port `0` binds a free port; `listener_port` tells which.
## Accepted connections get the listener's `TcpConfig`.
effect TcpServer where {
  bind: { addr: Addr, config: TcpConfig } -> Result TcpListener NetError <TcpServer>,
  ## The next connection; blocks. `Err NetClosed` once the listener is closed.
  accept: { listener: TcpListener } -> Result Accepted NetError <TcpServer>,
  close: { listener: TcpListener } -> {} <TcpServer>,
}

## The JDK's server sockets. A listener never closed is closed when the program ends.
impl TcpServer for NativeTcpServer where {
  bind = { addr, config } -> __native_tcp_bind { addr = addr, config = config },
  accept = { listener } -> __native_net_listener_accept { listener = listener },
  close = { listener } -> __native_net_listener_close { listener = listener },
}

## The port a listener is bound to.
pub let listener_port: { listener: TcpListener } -> Int = { listener } -> __native_net_listener_port { listener = listener }

## A bound UDP socket.
pub newtype UdpSocket = __NativeUdpSocket

## One datagram and who sent it.
pub type Datagram = { data: Bytes, from: Addr }

## Datagrams: no connection, no order, no delivery promise. Port `0` binds a free port.
effect Udp where {
  ## `receive_timeout_ms` bounds each `recv_from` (`0` waits forever).
  bind: { addr: Addr, receive_timeout_ms: Int } -> Result UdpSocket NetError <Udp>,
  send_to: { sock: UdpSocket, addr: Addr, data: Bytes } -> Result {} NetError <Udp>,
  ## The next datagram, cut to `max_bytes`; blocks. `Err NetClosed` once the socket is closed.
  recv_from: { sock: UdpSocket, max_bytes: Int } -> Result Datagram NetError <Udp>,
  close: { sock: UdpSocket } -> {} <Udp>,
}

## The JDK's datagram sockets. A socket never closed is closed when the program ends.
impl Udp for NativeUdp where {
  bind = { addr, receive_timeout_ms } -> __native_udp_bind { addr = addr, receive_timeout_ms = receive_timeout_ms },
  send_to = { sock, addr, data } -> __native_net_udp_send_to { sock = sock, addr = addr, data = data },
  recv_from = { sock, max_bytes } -> __native_net_udp_recv_from { sock = sock, max_bytes = max_bytes },
  close = { sock } -> __native_net_udp_close { sock = sock },
}

## The port a UDP socket is bound to.
pub let udp_port: { sock: UdpSocket } -> Int = { sock } -> __native_net_udp_port { sock = sock }

## An in-memory network. Mock performers handed the same `Network` see the same hosts and ports;
## hosts are compared as written, nothing resolves.
pub newtype Network = __NativeMockNetwork

## A fresh, empty network.
pub let mock_network: {} -> Network = {} -> __native_mock_net_new {}

## `Tcp` over a `Network`: `connect` to an address nothing listens on is `NetRefused`.
## A blocked `receive` parks the task, so other tasks run meanwhile under `CoopAsync`.
impl Tcp for MockTcp { net: Network } where {
  connect = { addr, config } -> __native_mock_net_connect { net = net, addr = addr, config = config },
  receive = { conn, max_bytes } -> __native_net_conn_receive { conn = conn, max_bytes = max_bytes },
  send = { conn, data } -> __native_net_conn_send { conn = conn, data = data },
  shutdown_write = { conn } -> __native_net_conn_shutdown_write { conn = conn },
  close = { conn } -> __native_net_conn_close { conn = conn },
}

## `TcpServer` over a `Network`. Closing a listener closes the connections it has not handed out yet.
impl TcpServer for MockTcpServer { net: Network } where {
  bind = { addr, config } -> __native_mock_net_bind { net = net, addr = addr, config = config },
  accept = { listener } -> __native_net_listener_accept { listener = listener },
  close = { listener } -> __native_net_listener_close { listener = listener },
}

## `Udp` over a `Network`. A datagram to an address nothing is bound to is dropped.
impl Udp for MockUdp { net: Network } where {
  bind = { addr, receive_timeout_ms } -> __native_mock_net_udp_bind { net = net, addr = addr, receive_timeout_ms = receive_timeout_ms },
  send_to = { sock, addr, data } -> __native_net_udp_send_to { sock = sock, addr = addr, data = data },
  recv_from = { sock, max_bytes } -> __native_net_udp_recv_from { sock = sock, max_bytes = max_bytes },
  close = { sock } -> __native_net_udp_close { sock = sock },
}

## Connect to `addr`, run `f` on the connection, close it when `f` returns. An abort out of `f` skips the close.
pub let with_conn
  : { addr: Addr, config: TcpConfig, f: { conn: TcpConn } -> 'a <...> }
  -> Result 'a NetError <Tcp, ...>
  = { addr, config, f } -> match Tcp.connect { addr = addr, config = config } is
    Ok { val = c } -> do
      let out = f { conn = c }
      Tcp.close { conn = c }
      Ok { val = out }
    Err { error } -> Err { error = error }

## Send a string as UTF-8.
pub let send_str: { conn: TcpConn, s: Str } -> Result {} NetError <Tcp> =
  { conn, s } -> Tcp.send { conn = conn, data = bytes::from_str { s = s } }

## Fold `f` over what arrives, at most `max_bytes` at a time, until the peer closes its side.
## Stop early with `std::effects::early_return`.
pub let chunks
  : { conn: TcpConn, max_bytes: Int, init: 'acc, f: { acc: 'acc, x: Bytes } -> 'acc <...> }
  -> Result 'acc NetError <Tcp, ...>
  = { conn, max_bytes, init, f } -> match Tcp.receive { conn = conn, max_bytes = max_bytes } is
    Ok { val = None } -> Ok { val = init }
    Ok { val = Some { val = x } } -> chunks { conn = conn, max_bytes = max_bytes, init = f { acc = init, x = x }, f = f }
    Err { error } -> Err { error = error }

# Folds every complete frame in `buf`; what follows the last delimiter stays buffered.
let split_delimited
  : { buf: Bytes, delim: Bytes, acc: 'acc, f: { acc: 'acc, x: Bytes } -> 'acc <...> }
  -> { buf: Bytes, acc: 'acc } <...>
  = { buf, delim, acc, f } -> match bytes::index_of { b = buf, pattern = delim } is
    None -> { buf = buf, acc = acc }
    Some { val = i } -> split_delimited {
      buf = bytes::drop { b = buf, n = i + bytes::size { b = delim } },
      delim = delim,
      acc = f { acc = acc, x = bytes::take { b = buf, n = i } },
      f = f,
    }

## Fold `f` over the frames between occurrences of `delim` (excluded), across chunk boundaries.
## An unterminated last frame is delivered too, unless empty.
pub let delimited
  : { conn: TcpConn, delim: Bytes, init: 'acc, f: { acc: 'acc, x: Bytes } -> 'acc <...> }
  -> Result 'acc NetError <Tcp, ...>
  = { conn, delim, init, f } -> match chunks {
      conn = conn,
      max_bytes = 65536,
      init = { buf = bytes::empty {}, acc = init },
      f = { acc, x } -> split_delimited { buf = bytes::concat { b1 = acc.buf, b2 = x }, delim = delim, acc = acc.acc, f = f },
    } is
    Err { error } -> Err { error = error }
    Ok { val = final } ->
      if bytes::is_empty { b = final.buf } then Ok { val = final.acc }
      else Ok { val = f { acc = final.acc, x = final.buf } }

# A line as text with a trailing `\r` dropped, or `NetIo` when it is not UTF-8.
let line_text: { x: Bytes } -> Result Str NetError = { x } ->
  match bytes::to_str { b = x } is
    Err { error } -> Err { error = NetIo { reason = "a line is not UTF-8: $(error)" } }
    Ok { val = s } ->
      if bytes::ends_with { b = x, suffix = bytes::from_str { s = "\r" } }
      then Ok { val = result::get_or { result = bytes::to_str { b = bytes::take { b = x, n = bytes::size { b = x } - 1 } }, def = s } }
      else Ok { val = s }

# One step of `lines`: decode and fold, unless an earlier line already failed.
let line_step
  : { acc: Result 'acc NetError, x: Bytes, f: { acc: 'acc, x: Str } -> 'acc <...> }
  -> Result 'acc NetError <...>
  = { acc, x, f } -> match acc is
    Err { error } -> Err { error = error }
    Ok { val = a } -> match line_text { x = x } is
      Err { error } -> Err { error = error }
      Ok { val = s } -> Ok { val = f { acc = a, x = s } }

## Fold `f` over `\n`-terminated lines as text; a trailing `\r` is dropped and an unterminated last
## line still counts. A line that is not UTF-8 makes the result `Err NetIo`.
pub let lines
  : { conn: TcpConn, init: 'acc, f: { acc: 'acc, x: Str } -> 'acc <...> }
  -> Result 'acc NetError <Tcp, ...>
  = { conn, init, f } -> match delimited {
      conn = conn,
      delim = bytes::from_str { s = "\n" },
      init = Ok { val = init },
      f = { acc, x } -> line_step { acc = acc, x = x, f = f },
    } is
    Err { error } -> Err { error = error }
    Ok { val = folded } -> folded

## A length-prefixed frame: four big-endian length bytes, then `data`. `frames` reads them back.
pub let frame: { data: Bytes } -> Bytes = { data } -> do
  let n = bytes::size { b = data }
  bytes::concat {
    b1 = bytes::from_seq { arr = [n / 16777216 % 256, n / 65536 % 256, n / 256 % 256, n % 256] },
    b2 = data,
  }

let byte_at: { b: Bytes, i: Int } -> Int = { b, i } -> option::get_or { opt = bytes::get { b = b, i = i }, def = 0 }

# Folds every complete length-prefixed frame in `buf`; a partial one stays buffered.
let split_prefixed
  : { buf: Bytes, acc: 'acc, f: { acc: 'acc, x: Bytes } -> 'acc <...> }
  -> { buf: Bytes, acc: 'acc } <...>
  = { buf, acc, f } ->
    if bytes::size { b = buf } < 4 then { buf = buf, acc = acc }
    else do
      let n = byte_at { b = buf, i = 0 } * 16777216 + byte_at { b = buf, i = 1 } * 65536 +
        byte_at { b = buf, i = 2 } * 256 + byte_at { b = buf, i = 3 }
      if bytes::size { b = buf } < n + 4 then { buf = buf, acc = acc }
      else split_prefixed {
        buf = bytes::drop { b = buf, n = n + 4 },
        acc = f { acc = acc, x = bytes::slice { b = buf, start = 4, end = n + 4 } },
        f = f,
      }

## Fold `f` over length-prefixed frames (see `frame`) until the peer closes its side.
## A frame the peer cut off makes the result `Err NetIo`.
pub let frames
  : { conn: TcpConn, init: 'acc, f: { acc: 'acc, x: Bytes } -> 'acc <...> }
  -> Result 'acc NetError <Tcp, ...>
  = { conn, init, f } -> match chunks {
      conn = conn,
      max_bytes = 65536,
      init = { buf = bytes::empty {}, acc = init },
      f = { acc, x } -> split_prefixed { buf = bytes::concat { b1 = acc.buf, b2 = x }, acc = acc.acc, f = f },
    } is
    Err { error } -> Err { error = error }
    Ok { val = final } ->
      if bytes::is_empty { b = final.buf } then Ok { val = final.acc }
      else Err { error = NetIo { reason = "the peer closed inside a frame, $(int::to_str { n = bytes::size { b = final.buf } }) byte(s) in" } }

## Accept on `listener` until it is closed, running `handler` for each connection in an `Async.spawn`
## task and closing the connection when it returns. `Ok` once the listener is closed.
pub let serve_on
  : { listener: TcpListener, handler: { conn: TcpConn, peer: Addr } -> {} <...> }
  -> Result {} NetError <Tcp, TcpServer, Async, ...>
  = { listener, handler } -> match TcpServer.accept { listener = listener } is
    Err { error = NetClosed } -> Ok { val = {} }
    Err { error } -> Err { error = error }
    Ok { val = a } -> do
      let _ = Async.spawn { f = {} -> do
        handler { conn = a.conn, peer = a.peer }
        Tcp.close { conn = a.conn } }
      serve_on { listener = listener, handler = handler }

## Bind `addr` and `serve_on` it. Returns only on an accept failure; to keep control of the
## listener, bind it yourself and spawn `serve_on`.
pub let serve
  : { addr: Addr, config: TcpConfig, handler: { conn: TcpConn, peer: Addr } -> {} <...> }
  -> Result {} NetError <Tcp, TcpServer, Async, ...>
  = { addr, config, handler } -> match TcpServer.bind { addr = addr, config = config } is
    Err { error } -> Err { error = error }
    Ok { val = l } -> serve_on { listener = l, handler = handler }
