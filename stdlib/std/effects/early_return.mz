## Early return effect for escaping computations with a value.
effect Return having 'result where {
  ## Return a value, exiting the current perform block.
  return: { val: 'result } -> 'a <Return>
}

## Handler that implements early return by aborting the perform.
impl Return for EarlyReturn having 'result = 'r where {
  return = { val } -> abort { val = val },
}

## Shorthand for Return.return.
pub let return = { val } -> Return.return { val }

## Return early if condition is true.
pub let return_if = { condition, val } -> if condition then Return.return { val } else {}

## Return early if option is Some, otherwise continue.
pub let return_some = { option } -> match option is
  Some { val } -> Return.return { val = val }
  None -> {}


## Unwrap Some or return default on None.
pub let return_none = { option, default } -> match option is
  Some { val } -> val
  None -> Return.return { val = default }


## Unwrap Ok or return default on Err.
pub let return_err = { result, default } -> match result is
  Ok { val } -> val
  Err { error } -> Return.return { val = default }
