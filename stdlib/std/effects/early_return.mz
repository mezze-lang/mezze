# std/effects/early_return.mezze - Early return from computations

use std::control::continuation
use std::control::continuation::{Continuation}

effect Return having 'result where {
    return: {val: 'result} -> 'a <Return>
}

# =============================================================================
# Built-in Handlers
# =============================================================================

# Returns the value immediately (RECOMMENDED)
# Uses suspend_with to package the return value, signaling early return
# NOTE: Requires a continuation to be passed as parameter
pub impl Return for WithReturn { cont: Continuation } having 'result = 'r where {
    return = {val} -> cont.suspend_with {value = val}
}

# Wraps the return value in Some (for optional early returns)
pub impl Return for WithSome { cont: Continuation } having 'result = 'r where {
    return = {val} -> cont.suspend_with {value = Some {val = val}}
}

# Aborts computation, discarding return value
pub impl Return for DiscardReturn { cont: Continuation } having 'result = 'r where {
    return = {val} -> cont.abort {}
}

# =============================================================================
# Helpers
# =============================================================================

# Shorthand for Return.return
pub let return = {val} -> Return.return {val}

# Return if condition is true
pub let return_if = {condition, val} ->
    if condition then
        Return.return {val}
    else
        {}

# Return early unless value is None
pub let return_some = {option} ->
    match option is
        Some {val} -> Return.return {val = val}
        None -> {}
