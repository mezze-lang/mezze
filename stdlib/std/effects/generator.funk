# std/effects/generator.funk - Generator effect for lazy sequences

# Generator effect provides yield/resume pattern for creating lazy sequences.
# Built on top of the Continuation effect.
#
# Generators allow you to yield values one at a time, suspending execution
# between yields. This enables lazy evaluation and infinite sequences.

use std::effects::continuation::{Continuation, Delimited}

# Generator effect - allows yielding values from a computation
# Now with associated types! The 'item type determines what values are yielded
pub effect Generator having 'item where {
    # Yield a value and suspend execution
    # Returns control to the caller with the yielded value
    # Can be resumed to continue generating more values
    yield: { value: 'item } -> {} <Generator>
}

# Yieldable performer - implements Generator using continuations
# When you yield, it suspends the computation and returns the yielded value
# Note: With associated types, each generator implementation specifies its item type
pub impl Generator for Yieldable having 'item = 'a where {
    yield = { value } -> __native_generator_yield { value = value }
}

# =============================================================================
# Generator Utility Functions
# =============================================================================

# Get the next value from a generator
# Returns { value: Option, gen: next_state }
# - value is Some { val } if there's a yielded value, None if done
# - gen is the next generator state to use for subsequent calls
pub let next = { gen } ->
    __native_generator_next { gen = gen }

# Consume entire generator into a list
# Warning: Will not terminate for infinite generators!
pub let to_list = { gen } ->
    __native_generator_to_list { gen = gen }

# Take first n values from a generator
# Returns { values: List, gen: remaining_state }
# - values is a list of up to n yielded values
# - gen is the remaining generator state (can be used to continue)
pub let take = { gen, n } ->
    __native_generator_take { gen = gen, n = n }

# =============================================================================
# Generator Transformation Functions
# =============================================================================

# Internal helper for map - accumulates transformed values
let map_helper = { gen, f, acc } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            map_helper { gen = result.gen, f = f, acc = __native_arraylist_concat { xs = acc, ys = [f { x = val }] } }
        None -> acc

# Map a function over all values from a generator
# Consumes the generator and returns a list of transformed values
# Example: map { gen = int_gen, f = { x } -> x * 2 }
pub let map = { gen, f } -> map_helper { gen = gen, f = f, acc = [] }

# Internal helper for filter - accumulates filtered values
let filter_helper = { gen, p, acc } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then filter_helper { gen = result.gen, p = p, acc = __native_arraylist_concat { xs = acc, ys = [val] } }
            else filter_helper { gen = result.gen, p = p, acc = acc }
        None -> acc

# Filter values from a generator based on a predicate
# Consumes the generator and returns a list of filtered values
# Example: filter { gen = int_gen, p = { x } -> x % 2 == 0 }
pub let filter = { gen, p } -> filter_helper { gen = gen, p = p, acc = [] }

# Fold over a generator
# Consumes the generator and accumulates a value
# Example: fold { gen = int_gen, init = 0, f = { acc, x } -> acc + x }
pub let fold = { gen, init, f } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            fold { gen = result.gen, init = f { acc = init, x = val }, f = f }
        None -> init

# Internal helper for count - accumulates count
let count_helper = { gen, cnt } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } -> count_helper { gen = result.gen, cnt = cnt + 1 }
        None -> cnt

# Count the number of values in a generator
# Consumes the generator
pub let count = { gen } -> count_helper { gen = gen, cnt = 0 }

# Find first value matching predicate
# Returns Option 'a - Some if found, None otherwise
pub let find = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then Some { val = val }
            else find { gen = result.gen, p = p }
        None -> None

# Check if any value matches predicate
pub let any = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then true
            else any { gen = result.gen, p = p }
        None -> false

# Check if all values match predicate
pub let all = { gen, p } -> do
    let result = next { gen = gen }
    match result.value is
        Some { val } ->
            if p { x = val }
            then all { gen = result.gen, p = p }
            else false
        None -> true
