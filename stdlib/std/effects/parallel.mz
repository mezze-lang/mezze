use std::collections::seq
use std::int

# Measured (160 items parked 2ms): min_chunk=1024 331ms (no forks), min_chunk=1 6ms; but for CPU
# work fork-per-element is slower than sequential. The threshold depends on the body, so no one default.
# Backends bracket per-scope state via initialize_scope / finalize_scope.
## Data parallelism over one primitive, `join`; combinators split in half down to `min_chunk` (default 1024).
## Inputs under `min_chunk` never fork; for I/O use `LoomParallelWith { max_concurrent = 16, min_chunk = 1 }`.
effect Parallel where {
  ## Runs `l` and `r` in parallel and returns both results.
  join: { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: 'a, r: 'b } <Parallel>
}

## Default backend: each `join` runs `r` on a fresh Loom virtual thread and `l` inline.
## `min_chunk` is 1024, so I/O-bound work under 1024 items runs sequentially.
impl Parallel for LoomParallel where {
  initialize_scope = {} -> __native_loom_parallel_init { max_concurrent = 0, min_chunk = 1024 },
  finalize_scope = {} -> __native_loom_parallel_finalize {},
  join = { l, r } -> __native_loom_parallel_join { l = l, r = r },
}

## `LoomParallel` with at most `max_concurrent` join sub-tasks at once (0 = unbounded).
## Combinators stop splitting at `min_chunk` items and run the leaf sequentially; 1 forks to singletons.
impl Parallel for LoomParallelWith { max_concurrent: Int, min_chunk: Int } where {
  initialize_scope = {} ->
    __native_loom_parallel_init { max_concurrent = max_concurrent, min_chunk = min_chunk },
  finalize_scope = {} -> __native_loom_parallel_finalize {},
  join = { l, r } -> __native_loom_parallel_join { l = l, r = r },
}

# Spawns via `env.newTruffleThreadBuilder(...).virtual(false)`.
## Backend with one platform OS thread per fork, for coarse CPU-bound joins.
## Spawning costs more than Loom (~50µs vs ~14µs) but avoids virtual-thread scheduler churn.
impl Parallel for OSThreadParallel where {
  initialize_scope = {} -> __native_osthread_parallel_init { pool_size = 0, min_chunk = 1024 },
  finalize_scope = {} -> __native_osthread_parallel_finalize {},
  join = { l, r } -> __native_osthread_parallel_join { l = l, r = r },
}

## `OSThreadParallel` with `pool_size` workers (0 or negative = available processors).
## `min_chunk` as in `LoomParallelWith`; 1 forks down to singletons.
impl Parallel for OSThreadParallelWith { pool_size: Int, min_chunk: Int } where {
  initialize_scope = {} ->
    __native_osthread_parallel_init { pool_size = pool_size, min_chunk = min_chunk },
  finalize_scope = {} -> __native_osthread_parallel_finalize {},
  join = { l, r } -> __native_osthread_parallel_join { l = l, r = r },
}

## No-concurrency backend for tests: runs `l` then `r` inline; results match the concurrent backends.
impl Parallel for DeterministicSequential where {
  join = { l, r } -> do
    let lv = l {}
    let rv = r {}
    { l = lv, r = rv }
}

# ── Derived combinators: binary split; empty → identity, n <= min_chunk → sequential seq:: call ──
## The current scope's `min_chunk` hint, or 1 when none is set.
let min_chunk: {} -> Int = {} -> __native_parallel_min_chunk_hint {}

## Apply f to each element in parallel, results in input order.
pub let map: { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then [] else if seq::size { xs = xs } <= min_chunk {} then seq::map { xs = xs, f = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> map { xs = left, f = f }, r = {} ->
      map { xs = right, f = f } }
    seq::concat { xs = both.l, ys = both.r }

## Run f on each element in parallel, discarding results.
pub let for_each: { xs: ['a], f: { x: 'a } -> {} <...> } -> {} <Parallel, ...> = { xs, f } ->
  do
    let _ = map { xs = xs, f = { x } -> do
      f { x = x }
      0 }
    {}

pub let filter: { xs: ['a], f: { x: 'a } -> Bool <...> } -> ['a] <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then [] else if seq::size { xs = xs } <= min_chunk {} then seq::filter { xs = xs, p = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> filter { xs = left, f = f }, r = {} ->
      filter { xs = right, f = f } }
    seq::concat { xs = both.l, ys = both.r }

pub let partition
  : { xs: ['a], f: { x: 'a } -> Bool <...> }
  -> { pass: ['a], fail: ['a] } <Parallel, ...>
  = { xs, f } -> if seq::size { xs = xs } == 0 then {
    pass = [],
    fail = [],
  } else if seq::size { xs = xs } <= min_chunk {} then seq::partition { xs = xs, p = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> partition { xs = left, f = f }, r = {} ->
      partition { xs = right, f = f } }
    {
      pass = seq::concat { xs = both.l.pass, ys = both.r.pass },
      fail = seq::concat { xs = both.l.fail, ys = both.r.fail },
    }

# Merging groups across halves is O(N * K); parallel group_by needs a hash-merge helper first.
## Groups elements by key. Runs sequentially (wraps `seq::group_by`); it does not fork.
pub let group_by: { xs: ['a], f: { x: 'a } -> 'k <...> } with Eq 'k, Hash 'k -> [{ key: 'k, values: ['a] }] <Parallel, ...> = { xs, f } ->
  seq::group_by { xs = xs, f = f }

## Reduce with an associative operation. Empty input → None.
pub let reduce
  : { xs: ['a], f: { l: 'a, r: 'a } -> 'a <...> }
  -> Option 'a <Parallel, ...>
  = { xs, f } -> if seq::size { xs = xs } == 0 then None else if seq::size { xs = xs } <= min_chunk {} then seq::reduce { xs = xs, f = { acc, x } ->
    f { l = acc, r = x } } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> reduce { xs = left, f = f }, r = {} ->
      reduce { xs = right, f = f } }
    match both.l is
      Some { val = a } -> match both.r is
        Some { val = b } -> Some { val = f { l = a, r = b } }
        None -> Some { val = a }
      None -> both.r


## Parallel fold: map each element then combine with associative combiner.
pub let fold
  : { xs: ['a], zero: 'b, map_fn: { x: 'a } -> 'b <...>, combine: { l: 'b, r: 'b } -> 'b <...> }
  -> 'b <Parallel, ...>
  = { xs, zero, map_fn, combine } -> if seq::size { xs = xs } == 0 then zero else if seq::size { xs = xs } <= min_chunk {} then seq::fold { xs = xs, init = zero, f = { acc, x } ->
    combine { l = acc, r = map_fn { x = x } } } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} ->
      fold {
        xs = left,
        zero = zero,
        map_fn = map_fn,
        combine = combine,
      }, r = {} -> fold {
      xs = right,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
    } }
    combine { l = both.l, r = both.r }

pub let find: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Option 'a <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then None else if seq::size { xs = xs } <= min_chunk {} then seq::find { xs = xs, p = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> find { xs = left, f = f }, r = {} ->
      find { xs = right, f = f } }
    match both.l is
      Some { val } -> Some { val = val }
      None -> both.r


pub let any: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then False else if seq::size { xs = xs } <= min_chunk {} then seq::any { xs = xs, p = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> any { xs = left, f = f }, r = {} ->
      any { xs = right, f = f } }
    both.l || both.r

pub let all: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then True else if seq::size { xs = xs } <= min_chunk {} then seq::all { xs = xs, p = f } else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join { l = {} -> all { xs = left, f = f }, r = {} ->
      all { xs = right, f = f } }
    both.l && both.r

## Runs `l` and `r` in parallel; a direct wrapper on `Parallel.join`.
pub let both: { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: 'a, r: 'b } <Parallel, ...> = { l, r } ->
  Parallel.join { l = l, r = r }

pub let both3
  : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> }
  -> { a: 'a, b: 'b, c: 'c } <Parallel, ...>
  = { a, b, c } -> do
    let ab_and_c = Parallel.join { l = {} -> Parallel.join { l = a, r = b }, r = c }
    { a = ab_and_c.l.l, b = ab_and_c.l.r, c = ab_and_c.r }

# ── Numeric / convenience helpers ──
# Chunks the long[] across the pool, SIMD-sums each chunk, combines; scalar loop if not LongSeqStorage.
## Parallel sum of a Seq of Ints, in one flat level of chunks (much faster than `reduce`).
pub let sum: { xs: [Int] } -> Int <Parallel> = { xs } -> __native_parallel_sum_long { xs = xs }

## Parallel product of a Seq of Ints. Same shape as `sum`.
pub let product: { xs: [Int] } -> Int <Parallel> = { xs } ->
  __native_parallel_product_long { xs = xs }

pub let count: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Int <Parallel, ...> = { xs, f } ->
  fold {
    xs = xs,
    zero = 0,
    map_fn = { x } -> if f { x = x } then 1 else 0,
    combine = { l, r } -> l + r,
  }

pub let flatten: { xs: [['a]] } -> ['a] <Parallel> = { xs } ->
  fold {
    xs = xs,
    zero = [],
    map_fn = { x } -> x,
    combine = { l, r } -> seq::concat { xs = l, ys = r },
  }

pub let flat_map
  : { xs: ['a], f: { x: 'a } -> ['b] <...> }
  -> ['b] <Parallel, ...>
  = { xs, f } -> flatten { xs = map { xs = xs, f = f } }

# ── Fused chunk combinators: one parallel pass, a whole Iter pipeline per chunk, no intermediate Seq ──

## Splits into parallel sub-batches, applies `f` to each, and merges with an associative `combine`.
## Inside `f`, an Iter pipeline fuses into one loop: `f = { xs } -> xs.to_iter{}.map { f = g }.sum{}`.
pub let chunk_fold
  : { xs: ['a], zero: 'b, f: { xs: ['a] } -> 'b <...>, combine: { l: 'b, r: 'b } -> 'b <...> }
  -> 'b <Parallel, ...>
  = { xs, zero, f, combine } ->
    if seq::size { xs = xs } == 0 then zero
    else if seq::size { xs = xs } <= min_chunk {} then f { xs = xs }
    else do
      let n = seq::size { xs = xs }
      let mid = n / 2
      let left = seq::take { xs = xs, n = mid }
      let right = seq::drop { xs = xs, n = mid }
      let both = Parallel.join {
        l = {} -> chunk_fold { xs = left, zero = zero, f = f, combine = combine },
        r = {} -> chunk_fold { xs = right, zero = zero, f = f, combine = combine },
      }
      combine { l = both.l, r = both.r }

## Applies a per-chunk transform `['a] -> ['b]` in parallel and concatenates the results in order.
pub let chunk_map
  : { xs: ['a], f: { xs: ['a] } -> ['b] <...> }
  -> ['b] <Parallel, ...>
  = { xs, f } ->
    chunk_fold {
      xs = xs,
      zero = [],
      f = f,
      combine = { l, r } -> seq::concat { xs = l, ys = r },
    }
