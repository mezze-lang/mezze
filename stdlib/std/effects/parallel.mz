use std::collections::seq
use std::int

## Data parallelism effect for parallel collection operations.
##
## Callbacks are effect-polymorphic (`<...>`) so they can perform other
## effects (Exception, Async, etc.) and have the surrounding handler chain
## dispatch them. The runtime captures the chain at spawn time; an op-call
## that propagates past all inherited handlers re-issues on the parent
## fiber when the parallel op joins.
effect Parallel where {
  ## Apply f to each element in parallel, results in input order.
  map: { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <Parallel, ...>,
  ## Run f on each element in parallel for side effects.
  for_each: { xs: ['a], f: { x: 'a } -> {} <...> } -> {} <Parallel, ...>,
  ## Filter elements with predicate evaluated in parallel.
  filter: { xs: ['a], f: { x: 'a } -> Bool <...> } -> ['a] <Parallel, ...>,
  ## Reduce with an associative operation in parallel.
  reduce: { xs: ['a], f: { l: 'a, r: 'a } -> 'a <...> } -> Option 'a <Parallel, ...>,
  ## Parallel fold: map each element then combine with associative combiner.
  fold: { xs: ['a], zero: 'b, map_fn: { x: 'a } -> 'b <...>, combine: { l: 'b, r: 'b } -> 'b <...> } -> 'b <Parallel, ...>,
  ## Run two computations in parallel.
  both: { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: 'a, r: 'b } <Parallel, ...>,
  ## Run three computations in parallel.
  both3: { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> } -> { a: 'a, b: 'b, c: 'c } <Parallel, ...>,
  ## Find first element matching predicate (short-circuits).
  find: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Option 'a <Parallel, ...>,
  ## Check if any element matches predicate (short-circuits).
  any: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...>,
  ## Check if all elements match predicate (short-circuits).
  all: { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...>,
  ## Partition elements by predicate into {pass, fail}.
  partition: { xs: ['a], f: { x: 'a } -> Bool <...> } -> { pass: ['a], fail: ['a] } <Parallel, ...>,
  ## Group elements by key function.
  group_by: { xs: ['a], f: { x: 'a } -> 'k <...> } -> [{ key: 'k, values: ['a] }] <Parallel, ...>
}

## Default implementation using virtual threads for parallelism.
impl Parallel for VirtualParallel where {
  map = { xs, f } -> __native_parallel_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_parallel_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_parallel_filter { xs = xs, f = f },
  reduce = { xs, f } -> __native_parallel_reduce { xs = xs, f = f },
  fold = { xs, zero, map_fn, combine } ->
    __native_parallel_fold {
      xs = xs,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
    },
  both = { l, r } -> __native_parallel_both { l = l, r = r },
  both3 = { a, b, c } -> __native_parallel_both3 { a = a, b = b, c = c },
  find = { xs, f } -> __native_parallel_find { xs = xs, f = f },
  any = { xs, f } -> __native_parallel_any { xs = xs, f = f },
  all = { xs, f } -> __native_parallel_all { xs = xs, f = f },
  partition = { xs, f } -> __native_parallel_partition { xs = xs, f = f },
  group_by = { xs, f } -> __native_parallel_group_by { xs = xs, f = f },
}

## Configurable virtual-thread parallelism with concurrency and chunk limits.
impl Parallel for VirtualParallelWith { parallelism: Int, chunk_size: Int } where {
  map = { xs, f } ->
    __native_parallel_map_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  for_each = { xs, f } ->
    __native_parallel_for_each_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  filter = { xs, f } ->
    __native_parallel_filter_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  reduce = { xs, f } ->
    __native_parallel_reduce_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  fold = { xs, zero, map_fn, combine } ->
    __native_parallel_fold_cfg {
      xs = xs,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  both = { l, r } -> __native_parallel_both { l = l, r = r },
  both3 = { a, b, c } -> __native_parallel_both3 { a = a, b = b, c = c },
  find = { xs, f } ->
    __native_parallel_find_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  any = { xs, f } ->
    __native_parallel_any_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  all = { xs, f } ->
    __native_parallel_all_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  partition = { xs, f } ->
    __native_parallel_partition_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
  group_by = { xs, f } ->
    __native_parallel_group_by_cfg {
      xs = xs,
      f = f,
      parallelism = parallelism,
      chunk_size = chunk_size,
    },
}

## ForkJoin work-stealing implementation for CPU-bound workloads.
impl Parallel for ForkJoinParallel where {
  map = { xs, f } -> __native_forkjoin_map { xs = xs, f = f, threshold = 64, parallelism = 0 },
  for_each = { xs, f } ->
    __native_forkjoin_for_each { xs = xs, f = f, threshold = 64, parallelism = 0 },
  filter = { xs, f } ->
    __native_forkjoin_filter { xs = xs, f = f, threshold = 64, parallelism = 0 },
  reduce = { xs, f } ->
    __native_forkjoin_reduce { xs = xs, f = f, threshold = 64, parallelism = 0 },
  fold = { xs, zero, map_fn, combine } ->
    __native_forkjoin_fold {
      xs = xs,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
      threshold = 64,
      parallelism = 0,
    },
  both = { l, r } -> __native_forkjoin_both { l = l, r = r, parallelism = 0 },
  both3 = { a, b, c } -> __native_forkjoin_both3 { a = a, b = b, c = c, parallelism = 0 },
  find = { xs, f } -> __native_forkjoin_find { xs = xs, f = f, threshold = 64, parallelism = 0 },
  any = { xs, f } -> __native_forkjoin_any { xs = xs, f = f, threshold = 64, parallelism = 0 },
  all = { xs, f } -> __native_forkjoin_all { xs = xs, f = f, threshold = 64, parallelism = 0 },
  partition = { xs, f } ->
    __native_forkjoin_partition { xs = xs, f = f, threshold = 64, parallelism = 0 },
  group_by = { xs, f } ->
    __native_forkjoin_group_by { xs = xs, f = f, threshold = 64, parallelism = 0 },
}

## Configurable ForkJoin with explicit threshold and parallelism.
impl Parallel for ForkJoinParallelWith { threshold: Int, parallelism: Int } where {
  map = { xs, f } ->
    __native_forkjoin_map {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  for_each = { xs, f } ->
    __native_forkjoin_for_each {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  filter = { xs, f } ->
    __native_forkjoin_filter {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  reduce = { xs, f } ->
    __native_forkjoin_reduce {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  fold = { xs, zero, map_fn, combine } ->
    __native_forkjoin_fold {
      xs = xs,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
      threshold = threshold,
      parallelism = parallelism,
    },
  both = { l, r } -> __native_forkjoin_both { l = l, r = r, parallelism = parallelism },
  both3 = { a, b, c } ->
    __native_forkjoin_both3 { a = a, b = b, c = c, parallelism = parallelism },
  find = { xs, f } ->
    __native_forkjoin_find {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  any = { xs, f } ->
    __native_forkjoin_any {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  all = { xs, f } ->
    __native_forkjoin_all {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  partition = { xs, f } ->
    __native_forkjoin_partition {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
  group_by = { xs, f } ->
    __native_forkjoin_group_by {
      xs = xs,
      f = f,
      threshold = threshold,
      parallelism = parallelism,
    },
}

## Sequential implementation for testing or small collections.
impl Parallel for Sequential where {
  map = { xs, f } -> __native_sequential_map { xs = xs, f = f },
  for_each = { xs, f } -> __native_sequential_for_each { xs = xs, f = f },
  filter = { xs, f } -> __native_sequential_filter { xs = xs, f = f },
  reduce = { xs, f } -> __native_sequential_reduce { xs = xs, f = f },
  fold = { xs, zero, map_fn, combine } ->
    __native_sequential_fold {
      xs = xs,
      zero = zero,
      map_fn = map_fn,
      combine = combine,
    },
  both = { l, r } -> __native_sequential_both { l = l, r = r },
  both3 = { a, b, c } -> __native_sequential_both3 { a = a, b = b, c = c },
  find = { xs, f } -> __native_sequential_find { xs = xs, f = f },
  any = { xs, f } -> __native_sequential_any { xs = xs, f = f },
  all = { xs, f } -> __native_sequential_all { xs = xs, f = f },
  partition = { xs, f } -> __native_sequential_partition { xs = xs, f = f },
  group_by = { xs, f } -> __native_sequential_group_by { xs = xs, f = f },
}

## Sum a list of integers in parallel.
pub let sum : { xs: [Int] } -> Int <Parallel> = { xs } -> match Parallel.reduce { xs = xs, f = { l, r } ->
  l + r } is
  Some { val } -> val
  None -> 0


## Multiply a list of integers in parallel.
pub let product : { xs: [Int] } -> Int <Parallel> = { xs } -> match Parallel.reduce { xs = xs, f = { l, r } ->
  l * r } is
  Some { val } -> val
  None -> 1


## Count elements matching a predicate in parallel.
pub let count : { xs: ['a], f: { x: 'a } -> Bool <...> } -> Int <Parallel, ...> = { xs, f } ->
  Parallel.fold {
    xs = xs,
    zero = 0,
    map_fn = { x } -> match f { x = x } is
      True -> 1
      False -> 0
,
    combine = { l, r } -> l + r,
  }

## Flatten nested sequences in parallel.
pub let flatten : { xs: [['a]] } -> ['a] <Parallel> = { xs } ->
  Parallel.fold {
    xs = xs,
    zero = [],
    map_fn = { x } -> x,
    combine = { l, r } -> seq::concat { xs = l, ys = r },
  }

## Map then flatten in parallel.
pub let flat_map : { xs: ['a], f: { x: 'a } -> ['b] <...> } -> ['b] <Parallel, ...> = { xs, f } ->
  flatten { xs = Parallel.map { xs = xs, f = f } }
