use std::collections::seq
use std::int

## Data parallelism, Rayon-shape: one runtime primitive, everything else
## derived.
##
## Runtime primitive:
##   Parallel.join { l, r } — run l and r in parallel, return both.
##
## Every derived combinator (map, reduce, filter, find, ...) is a
## threshold-based recursive split over the input, ending in a
## sequential leaf. This is exactly how Rayon's ParallelIterator works.
##
## Backends:
##   - ForkJoinParallel — ForkJoinPool + RecursiveTask (default,
##     fastest for CPU-bound work with irregular sizes).
##   - VirtualParallel  — one virtual thread per side (good for
##     I/O-bound work where subtasks park).
##
## Both backends bracket their per-scope state via the impl-only
## initialize_scope / finalize_scope convention.

effect Parallel where {
  ## Fork two computations. The runtime decides scheduling; the caller
  ## just declares "these two are independent."
  join: { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: 'a, r: 'b } <Parallel, ...>
}

## ==================================================================
## ForkJoinParallel — Rayon-shape work-stealing pool. Default.
## ==================================================================

## Uses ForkJoinPool.commonPool() — cheap, shared across scopes.
impl Parallel for ForkJoinParallel where {
  initialize_scope = {} -> __native_fjpool_init { parallelism = 0 },
  finalize_scope   = {} -> __native_fjpool_finalize {},
  join             = { l, r } -> __native_fjpool_join { l = l, r = r },
}

## Fresh private pool with the given worker count. Shut down on scope exit.
impl Parallel for ForkJoinParallelWith { parallelism: Int } where {
  initialize_scope = {} -> __native_fjpool_init { parallelism = parallelism },
  finalize_scope   = {} -> __native_fjpool_finalize {},
  join             = { l, r } -> __native_fjpool_join { l = l, r = r },
}

## ==================================================================
## VirtualParallel — virtual threads. For I/O-bound work.
## ==================================================================

## Unbounded — every join spawns one vthread. Cheap because vthreads
## are cheap; useful when subtasks block on I/O.
impl Parallel for VirtualParallel where {
  initialize_scope = {} -> __native_vthread_init { max_concurrent = 0 },
  finalize_scope   = {} -> __native_vthread_finalize {},
  join             = { l, r } -> __native_vthread_join { l = l, r = r },
}

## Backpressure cap. At most `max_concurrent` join sub-tasks run at
## once (semaphore-based). Useful when you'd otherwise spawn thousands
## of vthreads and starve I/O.
impl Parallel for VirtualParallelWith { max_concurrent: Int } where {
  initialize_scope = {} -> __native_vthread_init { max_concurrent = max_concurrent },
  finalize_scope   = {} -> __native_vthread_finalize {},
  join             = { l, r } -> __native_vthread_join { l = l, r = r },
}

## Split threshold for derived combinators: below this size, the leaf
## runs sequentially (no join call). Rayon uses ~1000 as its default;
## same value here. Inlined at each use because module-scope globals
## don't cross the Truffle worker-thread context boundary cleanly.

## ==================================================================
## Derived map — the workhorse. Threshold-based recursive split.
## ==================================================================

## Apply f to each element in parallel, results in input order.
pub let map : { xs: ['a], f: { x: 'a } -> 'b <...> } -> ['b] <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::map { xs = xs, f = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> map { xs = left,  f = f },
      r = {} -> map { xs = right, f = f },
    }
    seq::concat { xs = both.l, ys = both.r }

## Run f on each element in parallel, discarding results.
pub let for_each : { xs: ['a], f: { x: 'a } -> {} <...> } -> {} <Parallel, ...> = { xs, f } -> do
  let _ = map { xs = xs, f = { x } -> do
    f { x = x }
    0
  }
  {}

## ==================================================================
## Derived filter/partition/group_by — recursive split, seq op at leaf,
## concat on the way up.
## ==================================================================

pub let filter : { xs: ['a], f: { x: 'a } -> Bool <...> } -> ['a] <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::filter { xs = xs, p = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> filter { xs = left,  f = f },
      r = {} -> filter { xs = right, f = f },
    }
    seq::concat { xs = both.l, ys = both.r }

pub let partition : { xs: ['a], f: { x: 'a } -> Bool <...> } -> { pass: ['a], fail: ['a] } <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::partition { xs = xs, p = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> partition { xs = left,  f = f },
      r = {} -> partition { xs = right, f = f },
    }
    {
      pass = seq::concat { xs = both.l.pass, ys = both.r.pass },
      fail = seq::concat { xs = both.l.fail, ys = both.r.fail },
    }

## group_by delegates to seq::group_by at the leaf. The parallel
## variant just splits, group_bys each half, and merges by matching
## keys — that merge is O(N_left * N_right_keys) worst-case, so we
## use a moderate threshold. For very large groupings a hash-merge
## helper in seq would be a natural addition.
pub let group_by : { xs: ['a], f: { x: 'a } -> 'k <...> } -> [{ key: 'k, values: ['a] }] <Parallel, ...> = { xs, f } ->
  seq::group_by { xs = xs, f = f }

## ==================================================================
## Derived reduce/fold — threshold-based tree reduce.
## ==================================================================

## Reduce with an associative operation. Empty input → None.
##
## The user-facing combiner is `{ l, r } -> ...` (Parallel shape).
## seq::reduce uses `{ acc, x }`; we adapt at the leaf.
pub let reduce : { xs: ['a], f: { l: 'a, r: 'a } -> 'a <...> } -> Option 'a <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } == 0 then None
  else if seq::size { xs = xs } <= 1000 then
    seq::reduce { xs = xs, f = { acc, x } -> f { l = acc, r = x } }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> reduce { xs = left,  f = f },
      r = {} -> reduce { xs = right, f = f },
    }
    match { l = both.l, r = both.r } is
      { l = Some { val = a }, r = Some { val = b } } -> Some { val = f { l = a, r = b } }
      { l = Some { val = a }, r = None } -> Some { val = a }
      { l = None, r = Some { val = b } } -> Some { val = b }
      { l = None, r = None } -> None

## Parallel fold: map each element then combine with associative combiner.
## The single-pass fused version — map+reduce in one recursive walk.
pub let fold : { xs: ['a], zero: 'b, map_fn: { x: 'a } -> 'b <...>, combine: { l: 'b, r: 'b } -> 'b <...> } -> 'b <Parallel, ...> = { xs, zero, map_fn, combine } ->
  if seq::size { xs = xs } == 0 then zero
  else if seq::size { xs = xs } <= 1000 then
    seq::fold {
      xs = xs,
      init = zero,
      f = { acc, x } -> combine { l = acc, r = map_fn { x = x } },
    }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> fold { xs = left,  zero = zero, map_fn = map_fn, combine = combine },
      r = {} -> fold { xs = right, zero = zero, map_fn = map_fn, combine = combine },
    }
    combine { l = both.l, r = both.r }

## ==================================================================
## Derived short-circuit — find/any/all.
##
## Note: not truly short-circuiting across the parallel tree. We do
## the parallel work then find/any/all sequentially over results.
## For cheap predicates this is fine; for expensive predicates
## consider seq::find on a subset first.
## ==================================================================

pub let find : { xs: ['a], f: { x: 'a } -> Bool <...> } -> Option 'a <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::find { xs = xs, p = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> find { xs = left,  f = f },
      r = {} -> find { xs = right, f = f },
    }
    match both.l is
      Some { val } -> Some { val = val }
      None -> both.r

pub let any : { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::any { xs = xs, p = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> any { xs = left,  f = f },
      r = {} -> any { xs = right, f = f },
    }
    both.l || both.r

pub let all : { xs: ['a], f: { x: 'a } -> Bool <...> } -> Bool <Parallel, ...> = { xs, f } ->
  if seq::size { xs = xs } <= 1000 then
    seq::all { xs = xs, p = f }
  else do
    let n = seq::size { xs = xs }
    let mid = n / 2
    let left  = seq::take { xs = xs, n = mid }
    let right = seq::drop { xs = xs, n = mid }
    let both = Parallel.join {
      l = {} -> all { xs = left,  f = f },
      r = {} -> all { xs = right, f = f },
    }
    both.l && both.r

## ==================================================================
## Derived both/both3 — direct wrappers on join.
## ==================================================================

pub let both : { l: {} -> 'a <...>, r: {} -> 'b <...> } -> { l: 'a, r: 'b } <Parallel, ...> = { l, r } ->
  Parallel.join { l = l, r = r }

pub let both3 : { a: {} -> 'a <...>, b: {} -> 'b <...>, c: {} -> 'c <...> } -> { a: 'a, b: 'b, c: 'c } <Parallel, ...> = { a, b, c } -> do
  let ab_and_c = Parallel.join {
    l = {} -> Parallel.join { l = a, r = b },
    r = c,
  }
  { a = ab_and_c.l.l, b = ab_and_c.l.r, c = ab_and_c.r }

## ==================================================================
## Numeric / convenience helpers.
## ==================================================================

pub let sum : { xs: [Int] } -> Int <Parallel> = { xs } -> match reduce { xs = xs, f = { l, r } -> l + r } is
  Some { val } -> val
  None -> 0

pub let product : { xs: [Int] } -> Int <Parallel> = { xs } -> match reduce { xs = xs, f = { l, r } -> l * r } is
  Some { val } -> val
  None -> 1

pub let count : { xs: ['a], f: { x: 'a } -> Bool <...> } -> Int <Parallel, ...> = { xs, f } ->
  fold {
    xs = xs,
    zero = 0,
    map_fn = { x } -> if f { x = x } then 1 else 0,
    combine = { l, r } -> l + r,
  }

pub let flatten : { xs: [['a]] } -> ['a] <Parallel> = { xs } ->
  fold {
    xs = xs,
    zero = [],
    map_fn = { x } -> x,
    combine = { l, r } -> seq::concat { xs = l, ys = r },
  }

pub let flat_map : { xs: ['a], f: { x: 'a } -> ['b] <...> } -> ['b] <Parallel, ...> = { xs, f } ->
  flatten { xs = map { xs = xs, f = f } }
