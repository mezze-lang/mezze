# Sampling — the mechanism a generated value is drawn from.

use std::effects::random::{ Random, SeededRandom, random_int }
use std::nat::{ Nat }
# The arithmetic below needs Int's numeric impls in scope. Importing `std::nat`
# alone brings only Nat's, and `bound - 1` then reports no `NumSub` for Int —
# the same trap `std::abilities::arbitrary` documents.
use std::int
use std::option::{ get_or }
use std::collections::seq

## Where a generated value's choices come from — and NOTHING about types.
##
## `Arbitrary` says how a value of a given type is assembled, and which values of
## that type are interesting: that `0`, `1` and `-1` matter for an `Int`, that the
## empty string matters for a `Str`. All of that is knowledge ABOUT a type, so it
## lives with the type. This effect only answers "give me a number below N", which
## is the same question whatever is being built.
##
## ## One draw, and why it is `bound` rather than `min`/`max`
##
## Every generated value of every type bottoms out in `choose`, so a whole
## generation is a sequence of Ints — which is what makes a run recordable and
## replayable without any per-type machinery.
##
## The draw is `[0, bound)` rather than `[min, max]` so that **0 is always the
## simplest answer**. That ordering is the entire basis of shrinking: a shrinker
## walks the recorded sequence pushing choices toward zero and replays it. With a
## `min`/`max` primitive there is no canonical simplest value and that ordering has
## nothing to stand on. `int_between` is an ordinary function on top.
effect Sample where {
  ## A non-negative Int below `bound`. 0 is the simplest answer.
  choose: { bound: Int } -> Int <Sample>,
  ## The current budget for recursion depth and collection length.
  size: {} -> Nat <Sample>,
  ## Run `call` with the budget lowered to `n`.
  resize: { n: Nat, call: {} -> 'a <Sample, ...> } -> 'a <Sample>
}

## A recipe for an `'a` — the thing you CALL to get one.
##
## Deferred and re-runnable, which is the whole point: `g {}` twice gives two
## values, where a plain `'a` would be one frozen value. Because the draws are
## ambient, this needs no generator data type and no threaded seed — it is just a
## thunk, and every combinator below is an ordinary function.
##
## `Arbitrary.arbitrary` is the canonical `Sampler 'a` for a type. Anything you
## write by hand is another one, and you pass it explicitly where you want it.
pub type Sampler 'a = {} -> 'a <Sample>

## The default budget.
##
## Small on purpose. A sample exists to be READ, and a 40-element list nested four
## deep is not read, it is scrolled past.
pub let default_size: Nat = 5n

## Entropy from whatever `Random` handler is installed above.
##
## `Random` is RAISED OUT, not handled, so the caller chooses: a seeded stream for a
## reproducible run, real entropy, or a recorded one. [with_seed] makes that choice
## for you in the common case.
impl Sample for RandomSample where {
  ## `bound <= 1` has exactly one legal answer, and asking `random_int` for a range
  ## of `[0, -1]` would be asking it for something that does not exist.
  choose = { bound } -> if bound <= 1 then 0 else random_int { min = 0, max = bound - 1 },
  size = {} -> default_size,
  resize = { n, call } -> perform RandomSampleWith { size = n } in call {},
}

## `RandomSample` with a budget you choose.
##
## Note `resize` installs THIS performer rather than recursing into itself, which is
## what lets a nested draw inherit a lowered budget without touching the `Random`
## handler above it. Re-installing entropy per level would reset the stream and every
## subtree would come out identical.
impl Sample for RandomSampleWith { size: Nat } where {
  choose = { bound } -> if bound <= 1 then 0 else random_int { min = 0, max = bound - 1 },
  size = {} -> size,
  resize = { n, call } -> perform RandomSampleWith { size = n } in call {},
}

## Run `call` against a seeded stream: the same seed gives the same values.
##
## A plain FUNCTION rather than an effect, which is a deliberate simplification —
## there used to be a `Sampler` effect whose only operation existed to install these
## two performers as one scope. Late binding bought nothing there: the caller already
## chooses by calling this or not.
##
## `SeededRandom` is installed ONCE, around the whole generation, and that is the
## point. Its stream resets at scope entry, so a performer that installed it per
## draw would hand back the same number every time — a generator that looks like it
## works and produces constants.
pub let with_seed: { seed: Int, call: {} -> 'a <Sample, ...> } -> 'a <*> = { seed, call } ->
  perform SeededRandom { seed = seed } in perform RandomSample in call {}

## Seeded, with a budget you choose.
pub let with_seed_sized: { seed: Int, size: Nat, call: {} -> 'a <Sample, ...> } -> 'a <*> =
  { seed, size, call } ->
    perform SeededRandom { seed = seed } in
      perform RandomSampleWith { size = size } in call {}

## A non-negative Int below `bound`.
pub let choose: { bound: Int } -> Int <Sample> = { bound } -> Sample.choose { bound = bound }

## The current size budget.
pub let size: {} -> Nat <Sample> = {} -> Sample.size {}

## Lower the budget for a nested draw.
pub let resize: { n: Nat, call: {} -> 'a <Sample, ...> } -> 'a <Sample> = { n, call } ->
  Sample.resize { n = n, call = call }

# ---------------------------------------------------------------------------
# Combinators — ordinary functions over `Sampler`, not operations.
#
# This is the vocabulary you write a generator in. They are functions because
# nothing about combining recipes needs to be swappable; only the draw does.
# ---------------------------------------------------------------------------

## An Int in [min, max], inclusive.
pub let int_between: { min: Int, max: Int } -> Int <Sample> = { min, max } ->
  min + Sample.choose { bound = (max - min) + 1 }

## One element of `xs`. `def` is returned only for an empty `xs`, which is a
## generator that cannot produce anything and is the caller's mistake, not a case
## worth making every call site unwrap an Option for.
pub let one_of: { xs: ['a], def: 'a } -> 'a <Sample> = { xs, def } ->
  get_or {
    opt = seq::get { xs = xs, i = Sample.choose { bound = seq::size { xs = xs } } },
    def = def,
  }
