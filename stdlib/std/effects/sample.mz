# Sampling — the mechanism a generated value is drawn from.

use std::effects::random::{ Random, random_int }
use std::nat::{ Nat }
use std::int
use std::collections::seq

# Arbitrary owns per-type knowledge; this effect only answers "a number below N".
# `[0, bound)` makes a generation a replayable Int sequence with 0 simplest: the basis of shrinking.
## Where a generated value's choices come from: a recordable sequence of `[0, bound)` draws.
## 0 is always the simplest answer, which is what shrinking pushes choices toward.
effect Sample where {
  ## A non-negative Int below `bound`. 0 is the simplest answer.
  choose: { bound: Int } -> Int <Sample>,
  ## The current budget for recursion depth and collection length.
  size: {} -> Nat <Sample>,
  ## Run `call` with the budget lowered to `n`.
  resize: { n: Nat, call: {} -> 'a <Sample, ...> } -> 'a <Sample>
}

# A generator for 'a is a thunk `{} -> 'a <Sample>`: re-runnable, no data type or threaded seed.
# Written out at each use, not aliased: an alias hides the named effect row (T0219 refuses it).

## The default budget. Small on purpose: a sample exists to be read.
pub let default_size: Nat = 5n

# One record rather than one `…With` performer per combination of knobs: a new
# knob is a new field, not a new set of performers.
## Every knob a sampling performer takes: `size` (length/depth budget, halved per recursive level)
## and `enumerate` (leading choices [CoveringSampleWith] steers; ignored by random performers).
pub type SampleConfig = { size: Nat, enumerate: Nat }

## The defaults the plain performers use.
pub let default_config: SampleConfig = { size = default_size, enumerate = 12n }

## Entropy from whatever `Random` handler is installed above (raised out, not handled).
## Use [SeededSample] for a reproducible run.
impl Sample for RandomSample where {
  # `bound <= 1` has exactly one legal answer, and asking `random_int` for a range
  # of `[0, -1]` would be asking it for something that does not exist.
  choose = { bound } -> if bound <= 1 then 0 else random_int { min = 0, max = bound - 1 },
  size = {} -> default_size,
  resize = { n, call } ->
    perform RandomSampleWith { config = { size = n, enumerate = default_config.enumerate } } in call {},
}

# `resize` installs this performer so nested draws inherit a lowered budget without resetting
# the Random stream (a reset would make every subtree identical).
## `RandomSample` with a [SampleConfig] you choose.
impl Sample for RandomSampleWith { config: SampleConfig } where {
  choose = { bound } -> if bound <= 1 then 0 else random_int { min = 0, max = bound - 1 },
  size = {} -> config.size,
  resize = { n, call } ->
    perform RandomSampleWith { config = { size = n, enumerate = config.enumerate } } in call {},
}

# A performer, not a `with_seed` function: the function didn't compose (effects in its callback
# escaped the handler). It owns the stream rather than raising Random because a performer
# handles exactly ONE effect (V0701), so one scope can't be both Sample and Random.
## A seeded stream: the same seed gives the same values.
## e.g. `perform SeededSample { seed = 7 } in …`
impl Sample for SeededSample { seed: Int } where {
  # Reset ONCE at scope entry: a reset per draw would return the same number every time.
  initialize_scope = {} -> do
    __native_reset_seeded_random { seed = seed }
    {},
  finalize_scope = {} -> {},
  # `bound <= 1` has exactly one legal answer, and asking for a range of `[0, -1]`
  # would be asking for something that does not exist.
  choose = { bound } ->
    if bound <= 1 then 0
    else __native_seeded_random_int { seed = seed, min = 0, max = bound - 1 },
  size = {} -> default_size,
  resize = { n, call } ->
    perform SeededSampleWith { seed = seed, config = { size = n, enumerate = default_config.enumerate } } in call {},
}

# Deliberately no `initialize_scope`: `resize` re-installs this, so re-entry must CONTINUE the
# seed-keyed stream; a reset per nested draw would make every subtree identical.
## The same seeded stream with a [SampleConfig] you choose.
impl Sample for SeededSampleWith { seed: Int, config: SampleConfig } where {
  choose = { bound } ->
    if bound <= 1 then 0
    else __native_seeded_random_int { seed = seed, min = 0, max = bound - 1 },
  size = {} -> config.size,
  resize = { n, call } ->
    perform SeededSampleWith { seed = seed, config = { size = n, enumerate = config.enumerate } } in call {},
}

# A draw strategy, so it lives here: the first few choices decide which constructor/branch comes out.
# `resize` hands off to [CoveringSampleAt] so nested draws continue (and keep covering) the row.
## A seeded stream whose LEADING choices are enumerated, so a set of rows covers the shapes.
## `run` is the row index (mixed-radix digits over the leading choices); row 0 is plain random.
## Past a fixed depth, or once the digits run out, draws come from the seeded stream.
impl Sample for CoveringSample { seed: Int, run: Int } where {
  # Resets the enumeration and seeded stream once, at entry, as [SeededSample] does.
  initialize_scope = {} -> do
    __native_reset_covering_sample { seed = seed, run = run, depth = default_config.enumerate }
    {},
  finalize_scope = {} -> {},
  choose = { bound } ->
    if bound <= 1 then 0
    else __native_covering_choose { seed = seed, bound = bound },
  size = {} -> default_size,
  resize = { n, call } ->
    perform CoveringSampleAt { seed = seed, config = { size = n, enumerate = default_config.enumerate } } in call {},
}

# `resize` hands off to [CoveringSampleAt] carrying the SAME config with only
# `size` lowered, so a nested draw continues the row — and its enumeration.
## [CoveringSample] with a [SampleConfig] you choose — `enumerate` sets how many
## leading choices are steered, `size` the budget. Nested draws keep your settings.
impl Sample for CoveringSampleWith { seed: Int, run: Int, config: SampleConfig } where {
  initialize_scope = {} -> do
    __native_reset_covering_sample { seed = seed, run = run, depth = config.enumerate }
    {},
  finalize_scope = {} -> {},
  choose = { bound } ->
    if bound <= 1 then 0
    else __native_covering_choose { seed = seed, bound = bound },
  size = {} -> config.size,
  resize = { n, call } ->
    perform CoveringSampleAt { seed = seed, config = { size = n, enumerate = config.enumerate } } in call {},
}

# No `initialize_scope`, so the enumeration carries on from where the enclosing
# draw left it, only the size lowered.
## A covering run continued inside a resized draw; installed by `resize`, not for direct use.
impl Sample for CoveringSampleAt { seed: Int, config: SampleConfig } where {
  choose = { bound } ->
    if bound <= 1 then 0
    else __native_covering_choose { seed = seed, bound = bound },
  size = {} -> config.size,
  resize = { n, call } ->
    perform CoveringSampleAt { seed = seed, config = { size = n, enumerate = config.enumerate } } in call {},
}

## A non-negative Int below `bound`.
pub let choose: { bound: Int } -> Int <Sample> = { bound } -> Sample.choose { bound = bound }

## The current size budget.
pub let size: {} -> Nat <Sample> = {} -> Sample.size {}

## Lower the budget for a nested draw.
pub let resize: { n: Nat, call: {} -> 'a <Sample, ...> } -> 'a <Sample> = { n, call } ->
  Sample.resize { n = n, call = call }

# This is what `mez sample` hands a performer it generates for an effect nothing
# handles — every value the function sees is one the row drew and shows.
## A scripted operation's next value: `values` in call order, repeating once used up.
## Position is tracked per row `key` and operation `op`.
pub let scripted: { values: ['a], key: Int, op: Int } -> 'a = { values, key, op } ->
  __native_scripted_next { values = values, key = key, op = op }

# Combinators — ordinary functions over `Sampler`, not operations.

## An Int in [min, max], inclusive.
pub let int_between: { min: Int, max: Int } -> Int <Sample> = { min, max } ->
  min + Sample.choose { bound = (max - min) + 1 }

# `def`, not Option: an empty `xs` is the caller's mistake, not worth unwrapping everywhere.
## Pick one element of `xs` at random, or `def` when it is empty.
pub let one_of: { xs: ['a], def: 'a } -> 'a <Sample> = { xs, def } ->
  match seq::get { xs = xs, i = Sample.choose { bound = seq::size { xs = xs } } } is
    Some { val } -> val
    None -> def

# Elements draw at half the budget: without halving, one `[[[Int]]]` at size 100 held 127 746 ints.
## A list of `g`, length drawn from `[0, size]` (empty included); elements drawn at half the size.
pub let list_of: { g: {} -> 'a <Sample> } -> ['a] <Sample> = { g } -> do
  let budget = Sample.size {}
  let n = Sample.choose { bound = int::from_nat { n = budget } + 1 }
  Sample.resize { n = budget / 2n, call = {} -> seq::map { xs = seq::range { start = 0, end = n }, f = { x } -> g {} } }

## One of `choices`, picked in proportion to `weight`; a non-positive weight is never selected.
## Returns `def` when `choices` is empty or all weights are zero.
pub let frequency: { choices: [{ weight: Int, gen: {} -> 'a <Sample> }], def: 'a } -> 'a <Sample> =
  { choices, def } -> do
    let total = seq::fold { xs = choices, init = 0, f = { acc, x } -> acc + int::max { l = x.weight, r = 0 } }
    let target = Sample.choose { bound = int::max { l = total, r = 1 } }
    # Walk the weights, carrying the remaining distance and the first choice that
    # covers it. `chosen` latching on the first hit is what makes this a selection
    # rather than a last-one-wins fold.
    let walked = seq::fold {
      xs = choices,
      init = { left = target, chosen = None },
      f = { acc, x } -> match acc.chosen is
        Some { ... } -> acc
        None -> do
          let w = int::max { l = x.weight, r = 0 }
          if acc.left < w
            then { left = acc.left, chosen = Some { val = x.gen } }
            else { left = acc.left - w, chosen = None },
    }
    match walked.chosen is
      Some { val = g } -> g {}
      None -> def
