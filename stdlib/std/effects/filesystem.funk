# std/effects/filesystem.funk - File system effects

effect FileSystem {
    read_file: { path: String } -> String <FileSystem>,
    write_file: { path: String, content: String } -> {} <FileSystem>
}

# Local disk implementation
impl FileSystem for LocalDisk where {
    read_file = { path } -> __native_fs_read_file { path = path },
    write_file = { path, content } -> __native_fs_write_file { path = path, content = content }
}