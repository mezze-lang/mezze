# std/effects/filesystem.funk - File system effects (async by default)

pub effect FileSystem {
    read_file: { path: String } -> Result String | FileNotFound { path: String }, PermissionDenied { path: String, operation: String }, IOError { path: String, message: String } | <FileSystem>,
    write_file: { path: String, content: String } -> Result {} | FileNotFound { path: String }, PermissionDenied { path: String, operation: String }, IOError { path: String, message: String }, DiskFull { path: String, bytes_needed: Int } | <FileSystem>,
    exists: { path: String } -> Result Bool | PermissionDenied { path: String, operation: String }, IOError { path: String, message: String } | <FileSystem>,
    delete: { path: String } -> Result {} | FileNotFound { path: String }, PermissionDenied { path: String, operation: String }, DirectoryNotEmpty { path: String }, IOError { path: String, message: String } | <FileSystem>,
    list_directory: { path: String } -> Result [String] | FileNotFound { path: String }, PermissionDenied { path: String, operation: String }, NotADirectory { path: String }, IOError { path: String, message: String } | <FileSystem>,
    create_directory: { path: String } -> Result {} | AlreadyExists { path: String }, PermissionDenied { path: String, operation: String }, InvalidPath { path: String }, IOError { path: String, message: String } | <FileSystem>,
    file_size: { path: String } -> Result Int | FileNotFound { path: String }, PermissionDenied { path: String, operation: String }, IOError { path: String, message: String } | <FileSystem>
}

# Local disk implementation (runs in virtual threads transparently)
pub impl FileSystem for LocalDisk where {
    read_file = { path } -> __native_fs_read_file { path = path },
    write_file = { path, content } -> __native_fs_write_file { path = path, content = content },
    exists = { path } -> __native_fs_exists { path = path },
    delete = { path } -> __native_fs_delete { path = path },
    list_directory = { path } -> __native_fs_list_directory { path = path },
    create_directory = { path } -> __native_fs_create_directory { path = path },
    file_size = { path } -> __native_fs_file_size { path = path }
}

# Memory-based file system (for testing)
pub impl FileSystem for MemoryFS where {
    read_file = { path } -> __native_memfs_read_file { path = path },
    write_file = { path, content } -> __native_memfs_write_file { path = path, content = content },
    exists = { path } -> __native_memfs_exists { path = path },
    delete = { path } -> __native_memfs_delete { path = path },
    list_directory = { path } -> __native_memfs_list_directory { path = path },
    create_directory = { path } -> __native_memfs_create_directory { path = path },
    file_size = { path } -> __native_memfs_file_size { path = path }
}