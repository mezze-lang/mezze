# An effect so the shutdown TRIGGER can be swapped: Ctrl-C in production, immediate in tests.
# Its thunk is what a server's `with_graceful_shutdown` (std::effects::http) takes.

## A one-shot shutdown trigger.
effect Signal where {
  ## Park until a shutdown is requested, then return.
  interrupt: {} -> {} <Signal>
}

## Park until the OS sends SIGINT (Ctrl-C) or SIGTERM.
## Under `mez dev` the CLI owns SIGINT and cancels the program, which also releases this.
impl Signal for SystemSignal where {
  interrupt = {} -> __native_signal_await_interrupt {},
}

## Return immediately, so a guarded server stops at once (for tests).
impl Signal for ImmediateSignal where {
  interrupt = {} -> {},
}

## Park until a shutdown signal; hand `{ } -> ctrl_c {}` to `with_graceful_shutdown`.
pub let ctrl_c: {} -> {} <Signal> = {} -> Signal.interrupt {}

## Same as `ctrl_c`, named for triggers that are not a keystroke.
pub let await_shutdown: {} -> {} <Signal> = {} -> Signal.interrupt {}
