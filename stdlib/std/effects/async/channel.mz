use std::abilities::compare::{ Eq, Hash, structural_hash }
use std::effects::async::{ Async, park, wait_on }
use std::effects::async::atom::{ atom, deref, reset }

## Typed channel for thread-safe message passing.
pub newtype Chan 'a = __NativeChannel

# `Eq` and `Hash` are written together or not at all: a hash that disagrees
# with equality makes a hash container keep a value twice.
impl Hash for Chan 'a where {
  hash: { it: Chan 'a } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for Chan 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Chan 'a where {
  send = { it, val } -> send { ch = it, val = val },
  recv = { it } -> recv { ch = it },
  try_send = { it, val } -> try_send { ch = it, val = val },
  try_recv = { it } -> try_recv { ch = it },
  close = { it } -> close { ch = it },
  is_closed = { it } -> is_closed { ch = it },
}

## Create an unbounded channel.
pub let chan: {} -> Chan 'a <Async> = {} -> __native_channel_make {}

## Create a bounded channel with the given capacity.
pub let chan_bounded: { cap: Int } -> Chan 'a <Async> = { cap } ->
  __native_channel_make_buffered { capacity = cap }

## Send a value, parking until the channel has capacity.
pub let send: { ch: Chan 'a, val: 'a } -> {} <Async, ...> = { ch, val } -> do
  park { predicate = wait_on { on = ch, test = {} -> __native_channel_try_send { ch = ch, val = val } } }

## Receive a value, parking until the channel has one.
pub let recv: { ch: Chan 'a } -> 'a <Async, ...> = { ch } -> do
  # The predicate stashes the polled value in an atom; a receiver that
  # loses a race keeps None in its slot and retries.
  let slot = atom { val = None }
  park { predicate = wait_on { on = ch, test = {} -> match __native_channel_try_recv { ch = ch } is
    Some { val } -> do
      let _ = reset { atom = slot, val = Some { val = val } }
      True
    None -> False } }
  match deref { atom = slot } is
    Some { val } -> val
    None -> recv { ch = ch }


## Try to send without blocking. Returns True on success.
pub let try_send: { ch: Chan 'a, val: 'a } -> Bool <Async> = { ch, val } ->
  __native_channel_try_send { ch = ch, val = val }

## Try to receive without blocking. Returns None if the channel is empty.
pub let try_recv: { ch: Chan 'a } -> Option 'a <Async> = { ch } ->
  __native_channel_try_recv { ch = ch }

## Close the channel. Subsequent sends fail; pending receivers wake.
pub let close: { ch: Chan 'a } -> {} <Async> = { ch } -> __native_channel_close { ch = ch }

## Check whether the channel is closed.
pub let is_closed: { ch: Chan 'a } -> Bool <Async> = { ch } ->
  __native_channel_is_closed { ch = ch }

## Receive from the first available channel.
pub let recv_any: { channels: [Chan 'a] } -> { index: Int, val: 'a } <Async> = { channels } ->
  __native_channel_recv_any { channels = channels }

## Receive from the first available channel, or None on timeout.
pub let recv_any_timeout
  : { channels: [Chan 'a], ms: Int }
  -> Option { index: Int, val: 'a } <Async>
  = { channels, ms } -> __native_channel_recv_any_timeout { channels = channels, ms = ms }
