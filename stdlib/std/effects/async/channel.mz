use std::abilities::compare::{ Eq }
use std::effects::async::{ Async }
use std::effects::async::atom::{ atom, deref, reset }

## Typed channel for thread-safe message passing.
pub newtype Chan 'a = Chan __NativeChannel

impl Eq 'a for Chan 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Chan 'a where {
  send = { it, value } -> send { ch = it, value = value },
  recv = { it } -> recv { ch = it },
  try_send = { it, value } -> try_send { ch = it, value = value },
  try_recv = { it } -> try_recv { ch = it },
  close = { it } -> close { ch = it },
  is_closed = { it } -> is_closed { ch = it },
}

## Create an unbounded channel.
pub let chan : {} -> Chan 'a <Async> = {} -> __native_channel_make {}

## Create a bounded channel with the given capacity.
pub let chan_bounded : { cap: Int } -> Chan 'a <Async> = { cap } ->
  __native_channel_make_buffered { capacity = cap }

## Send a value, parking until the channel has capacity.
pub let send : { ch: Chan 'a, value: 'a } -> {} <Async, ...> = { ch, value } -> do
  Async.park {
    predicate = {} -> __native_channel_try_send { ch = ch, value = value },
  }

## Receive a value, parking until the channel has one.
pub let recv : { ch: Chan 'a } -> 'a <Async, ...> = { ch } -> do
  # The predicate stashes the polled value in a closure-captured atom
  # so the outer call doesn't need to re-poll. If two racing receivers
  # both see Some at the same instant but only one wins the queue
  # element, the loser's slot stays None and we recurse.
  let slot = atom { value = None }
  Async.park {
    predicate = {} -> match __native_channel_try_recv { ch = ch } is
      Some { val } -> do
        let _ = reset { atom = slot, value = Some { val = val } }
        True
      None -> False,
  }
  match deref { atom = slot } is
    Some { val } -> val
    None -> recv { ch = ch }

## Try to send without blocking. Returns True on success.
pub let try_send : { ch: Chan 'a, value: 'a } -> Bool <Async> = { ch, value } ->
  __native_channel_try_send { ch = ch, value = value }

## Try to receive without blocking. Returns None if the channel is empty.
pub let try_recv : { ch: Chan 'a } -> Option 'a <Async> = { ch } ->
  __native_channel_try_recv { ch = ch }

## Close the channel. Subsequent sends fail; pending receivers wake.
pub let close : { ch: Chan 'a } -> {} <Async> = { ch } ->
  __native_channel_close { ch = ch }

## Check whether the channel is closed.
pub let is_closed : { ch: Chan 'a } -> Bool <Async> = { ch } ->
  __native_channel_is_closed { ch = ch }

## Receive from the first available channel.
pub let recv_any : { channels: [Chan 'a] } -> { index: Int, value: 'a } <Async> = { channels } ->
  __native_channel_recv_any { channels = channels }

## Receive from the first available channel, or None on timeout.
pub let recv_any_timeout : { channels: [Chan 'a], ms: Int } -> Option { index: Int, value: 'a } <Async> = { channels, ms } ->
  __native_channel_recv_any_timeout { channels = channels, ms = ms }
