use std::abilities::compare::{ Eq, Hash, structural_hash }
use std::effects::async::{ Async, park }

## Reentrant mutual exclusion lock.
pub newtype Mutex = __NativeLock

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for Mutex where {
  hash: { it: Mutex } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for Mutex where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Mutex where {
  with_lock = { it, f } -> with_lock { mutex = it, f = f },
  lock = { it } -> lock { mutex = it },
  unlock = { it } -> unlock { mutex = it },
  try_lock = { it } -> try_lock { mutex = it },
  is_held_by_current_thread = { it } -> is_held_by_current_thread { mutex = it },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  lock_async = { it } -> lock_async { mutex = it },
}

## Create a new mutex.
pub let mutex: {} -> Mutex <Async> = {} -> __native_mutex_new {}

## Acquire lock, run f, release lock automatically (recommended).
pub let with_lock: { mutex: Mutex, f: {} -> 'a <...> } -> 'a <Async, ...> = { mutex, f } ->
  __native_mutex_with_lock { mutex = mutex, f = f }

## Acquire the lock (blocking). You must call unlock when done.
pub let lock: { mutex: Mutex } -> {} <Async> = { mutex } -> __native_mutex_lock { mutex = mutex }

## Park-aware lock: routes through park.
pub let lock_async: { mutex: Mutex } -> {} <Async, ...> = { mutex } ->
  park { predicate = {} -> __native_mutex_try_lock { mutex = mutex } }

## Release the lock. Must be called by the thread that holds it.
pub let unlock: { mutex: Mutex } -> {} <Async> = { mutex } ->
  __native_mutex_unlock { mutex = mutex }

## Try to acquire the lock without blocking. Returns True if acquired.
pub let try_lock: { mutex: Mutex } -> Bool <Async> = { mutex } ->
  __native_mutex_try_lock { mutex = mutex }

## Check if the current thread holds this mutex.
pub let is_held_by_current_thread: { mutex: Mutex } -> Bool <Async> = { mutex } ->
  __native_mutex_is_held_by_current_thread { mutex = mutex }
