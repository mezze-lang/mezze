use std::abilities::compare::{ Eq }
use std::effects::async::{ Async }

## Lock-free atomic reference for shared mutable state.
pub newtype Atom 'a = __NativeAtomicRef

impl Eq for Atom 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Atom 'a where {
  deref = { it } -> deref { atom = it },
  reset = { it, val } -> reset { atom = it, val = val },
  swap = { it, f } -> swap { atom = it, f = f },
  compare_and_set = { it, expected, new } ->
    compare_and_set { atom = it, expected = expected, new = new },
  swap_with = { it, f, arg } -> swap_with { atom = it, f = f, arg = arg },
  get_and_swap = { it, f } -> get_and_swap { atom = it, f = f },
  add_watch = { it, key, f } -> add_watch { atom = it, key = key, f = f },
  remove_watch = { it, key } -> remove_watch { atom = it, key = key },
  set_validator = { it, validator } -> set_validator { atom = it, validator = validator },
}

## Create a new atom with an initial value.
pub let atom: { val: 'a } -> Atom 'a <Async> = { val } -> __native_atom_new { val = val }

## Read the current value of an atom (non-blocking).
pub let deref: { atom: Atom 'a } -> 'a <Async> = { atom } -> __native_atom_deref { atom = atom }

## Set the atom to a new value directly (not atomic with reads -- use swap for CAS).
pub let reset: { atom: Atom 'a, val: 'a } -> 'a <Async> = { atom, val } ->
  __native_atom_reset { atom = atom, val = val }

## Atomically apply f to the atom's value, retrying on contention.
pub let swap: { atom: Atom 'a, f: { current: 'a } -> 'a } -> 'a <Async> = { atom, f } ->
  __native_atom_swap { atom = atom, f = f }

## Compare-and-set: update only if current value equals expected.
pub let compare_and_set: { atom: Atom 'a, expected: 'a, new: 'a } -> Bool <Async> = { atom, expected, new } ->
  __native_atom_cas { atom = atom, expected = expected, new = new }

## Atomically apply f with an extra argument.
pub let swap_with
  : { atom: Atom 'a, f: { current: 'a, arg: 'b } -> 'a, arg: 'b }
  -> 'a <Async>
  = { atom, f, arg } -> __native_atom_swap_with { atom = atom, f = f, arg = arg }

## Atomically apply f, returning both old and new values.
pub let get_and_swap
  : { atom: Atom 'a, f: { current: 'a } -> 'a }
  -> { old: 'a, new: 'a } <Async>
  = { atom, f } -> __native_atom_get_and_swap { atom = atom, f = f }

## Register a watch callback invoked on every state change.
pub let add_watch
  : { atom: Atom 'a, key: Str, f: { key: Str, old: 'a, new: 'a } -> {} <...> }
  -> {} <Async, ...>
  = { atom, key, f } -> __native_atom_add_watch { atom = atom, key = key, f = f }

## Remove a watch by its key.
pub let remove_watch: { atom: Atom 'a, key: Str } -> {} <Async> = { atom, key } ->
  __native_atom_remove_watch { atom = atom, key = key }

## Create an atom with a validator that rejects invalid updates.
pub let atom_validated
  : { val: 'a, validator: { val: 'a } -> Bool }
  -> Atom 'a <Async>
  = { val, validator } -> __native_atom_new_validated { val = val, validator = validator }

## Set a validator on an existing atom. Future updates must pass it.
pub let set_validator
  : { atom: Atom 'a, validator: { val: 'a } -> Bool }
  -> {} <Async>
  = { atom, validator } -> __native_atom_set_validator { atom = atom, validator = validator }
