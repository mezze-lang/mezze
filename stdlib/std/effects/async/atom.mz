use std::abilities::compare::{ Eq }
use std::effects::async::{ Async }

## Error returned by a `ValidatedAtom` mutation when the validator rejects
## the proposed new value. Carries the rejected value so callers can inspect
## what was refused. The atom is left unchanged on rejection.
pub type AtomError 'a = |
  ValidatorRejected { val: 'a },
|

## Lock-free atomic reference for shared mutable state.
##
## `Atom` is UNVALIDATED and TOTAL: its mutations (`swap`, `reset`,
## `swap_with`, `get_and_swap`) return values directly and never fail.
pub newtype Atom 'a = __NativeAtomicRef

## Lock-free atomic reference guarded by a validator.
##
## `ValidatedAtom` mutations run the validator on the proposed value and
## return a `Result`: `Ok` with the installed value on success, or
## `Err { error = ValidatorRejected { val } }` when rejected (atom unchanged).
pub newtype ValidatedAtom 'a = __NativeAtomicRef

impl Eq for Atom 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Eq for ValidatedAtom 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Atom 'a where {
  deref = { it } -> deref { atom = it },
  reset = { it, val } -> reset { atom = it, val = val },
  swap = { it, f } -> swap { atom = it, f = f },
  compare_and_set = { it, expected, new } ->
    compare_and_set { atom = it, expected = expected, new = new },
  swap_with = { it, f, arg } -> swap_with { atom = it, f = f, arg = arg },
  get_and_swap = { it, f } -> get_and_swap { atom = it, f = f },
  add_watch = { it, key, f } -> add_watch { atom = it, key = key, f = f },
  remove_watch = { it, key } -> remove_watch { atom = it, key = key },
}

impl ValidatedAtom 'a where {
  deref = { it } -> deref_validated { atom = it },
  reset = { it, val } -> reset_validated { atom = it, val = val },
  swap = { it, f } -> swap_validated { atom = it, f = f },
  compare_and_set = { it, expected, new } ->
    compare_and_set_validated { atom = it, expected = expected, new = new },
  swap_with = { it, f, arg } -> swap_with_validated { atom = it, f = f, arg = arg },
  get_and_swap = { it, f } -> get_and_swap_validated { atom = it, f = f },
  add_watch = { it, key, f } -> add_watch_validated { atom = it, key = key, f = f },
  remove_watch = { it, key } -> remove_watch_validated { atom = it, key = key },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  deref_validated = { it } -> deref_validated { atom = it },
  reset_validated = { it, val } -> reset_validated { atom = it, val = val },
  swap_validated = { it, f } -> swap_validated { atom = it, f = f },
  compare_and_set_validated = { it, expected, new } -> compare_and_set_validated { atom = it, expected = expected, new = new },
  swap_with_validated = { it, f, arg } -> swap_with_validated { atom = it, f = f, arg = arg },
  get_and_swap_validated = { it, f } -> get_and_swap_validated { atom = it, f = f },
  add_watch_validated = { it, key, f } -> add_watch_validated { atom = it, key = key, f = f },
  remove_watch_validated = { it, key } -> remove_watch_validated { atom = it, key = key },
}

## Create a new atom with an initial value.
pub let atom: { val: 'a } -> Atom 'a <Async> = { val } -> __native_atom_new { val = val }

## Read the current value of an atom (non-blocking).
pub let deref: { atom: Atom 'a } -> 'a <Async> = { atom } -> __native_atom_deref { atom = atom }

## Set the atom to a new value directly (not atomic with reads -- use swap for CAS).
pub let reset: { atom: Atom 'a, val: 'a } -> 'a <Async> = { atom, val } ->
  __native_atom_reset { atom = atom, val = val }

## Atomically apply f to the atom's value, retrying on contention.
pub let swap: { atom: Atom 'a, f: { current: 'a } -> 'a } -> 'a <Async> = { atom, f } ->
  __native_atom_swap { atom = atom, f = f }

## Compare-and-set: update only if current value equals expected.
pub let compare_and_set: { atom: Atom 'a, expected: 'a, new: 'a } -> Bool <Async> = { atom, expected, new } ->
  __native_atom_cas { atom = atom, expected = expected, new = new }

## Atomically apply f with an extra argument.
pub let swap_with
  : { atom: Atom 'a, f: { current: 'a, arg: 'b } -> 'a, arg: 'b }
  -> 'a <Async>
  = { atom, f, arg } -> __native_atom_swap_with { atom = atom, f = f, arg = arg }

## Atomically apply f, returning both old and new values.
pub let get_and_swap
  : { atom: Atom 'a, f: { current: 'a } -> 'a }
  -> { old: 'a, new: 'a } <Async>
  = { atom, f } -> __native_atom_get_and_swap { atom = atom, f = f }

## Register a watch callback invoked on every state change.
pub let add_watch
  : { atom: Atom 'a, key: Str, f: { key: Str, old: 'a, new: 'a } -> {} <...> }
  -> {} <Async, ...>
  = { atom, key, f } -> __native_atom_add_watch { atom = atom, key = key, f = f }

## Remove a watch by its key.
pub let remove_watch: { atom: Atom 'a, key: Str } -> {} <Async> = { atom, key } ->
  __native_atom_remove_watch { atom = atom, key = key }

## Create a validated atom whose mutations must pass `validator`.
## The initial value must pass too, so construction returns a `Result`:
## `Ok { val }` with the atom when the initial value passes, or
## `Err { error = ValidatorRejected { val } }` when the initial value is
## rejected (no atom is created). Mutations also return a `Result`.
pub let atom_validated
  : { val: 'a, validator: { val: 'a } -> Bool }
  -> Result (ValidatedAtom 'a) (AtomError 'a) <Async>
  = { val, validator } -> __native_atom_new_validated { val = val, validator = validator }

## Read the current value of a validated atom (non-blocking, total).
pub let deref_validated: { atom: ValidatedAtom 'a } -> 'a <Async> = { atom } ->
  __native_atom_deref { atom = atom }

## Set a validated atom directly. Returns `Ok { val }` on success or
## `Err { error = ValidatorRejected { val } }` if the validator rejects.
pub let reset_validated
  : { atom: ValidatedAtom 'a, val: 'a }
  -> Result 'a (AtomError 'a) <Async>
  = { atom, val } -> __native_atom_reset_validated { atom = atom, val = val }

## Atomically apply f to a validated atom, returning a `Result`.
pub let swap_validated
  : { atom: ValidatedAtom 'a, f: { current: 'a } -> 'a }
  -> Result 'a (AtomError 'a) <Async>
  = { atom, f } -> __native_atom_swap_validated { atom = atom, f = f }

## Compare-and-set on a validated atom (validator still applies).
pub let compare_and_set_validated
  : { atom: ValidatedAtom 'a, expected: 'a, new: 'a }
  -> Bool <Async>
  = { atom, expected, new } ->
    __native_atom_cas { atom = atom, expected = expected, new = new }

## Atomically apply f with an extra argument on a validated atom.
pub let swap_with_validated
  : { atom: ValidatedAtom 'a, f: { current: 'a, arg: 'b } -> 'a, arg: 'b }
  -> Result 'a (AtomError 'a) <Async>
  = { atom, f, arg } -> __native_atom_swap_with_validated { atom = atom, f = f, arg = arg }

## Atomically apply f on a validated atom, returning old and new on success.
pub let get_and_swap_validated
  : { atom: ValidatedAtom 'a, f: { current: 'a } -> 'a }
  -> Result { old: 'a, new: 'a } (AtomError 'a) <Async>
  = { atom, f } -> __native_atom_get_and_swap_validated { atom = atom, f = f }

## Register a watch callback on a validated atom.
pub let add_watch_validated
  : { atom: ValidatedAtom 'a, key: Str, f: { key: Str, old: 'a, new: 'a } -> {} <...> }
  -> {} <Async, ...>
  = { atom, key, f } -> __native_atom_add_watch { atom = atom, key = key, f = f }

## Remove a watch by its key from a validated atom.
pub let remove_watch_validated: { atom: ValidatedAtom 'a, key: Str } -> {} <Async> = { atom, key } ->
  __native_atom_remove_watch { atom = atom, key = key }
