# =============================================================================
# std/async/osthread.mezze - OS Platform Thread Concurrency
# =============================================================================

# OS platform threads provide true parallelism for CPU-bound work.
# Use when:
# - You need true parallelism for CPU-bound work
# - Thread-locals must work correctly
# - Limited scale is acceptable (thousands, not millions of threads)
#
# For I/O-bound or high-scale concurrency, prefer Loom virtual threads.

# =============================================================================
# Opaque Types
# =============================================================================

# Promise wraps native CompletableFuture
newtype OSPromise 'a = OSPromise __NativePromise

# Thread wraps native OS Thread
newtype OSThread = OSThread __NativeThread

# =============================================================================
# Core Functions
# =============================================================================

## Spawn a computation on an OS platform thread.
## Returns immediately with a promise.
pub let os_spawn: {f: {} -> 'a} -> OSPromise 'a = {f} -> __native_os_spawn {f = f}

## Wait for a promise to complete and return its value.
## Blocks the current thread until complete.
pub let os_await: {p: OSPromise 'a} -> 'a = {p} -> __native_os_await {p = p}

## Wait for the first of multiple promises to complete.
pub let os_race: {ps: [OSPromise 'a]} -> 'a = {ps} -> __native_os_race {ps = ps}

## Wait for all promises to complete and return results.
pub let os_all: {ps: [OSPromise 'a]} -> ['a] = {ps} -> __native_os_all {ps = ps}

## Wait for a promise with timeout.
## Returns Some if completed, None if timeout expired.
pub let os_timeout: {p: OSPromise 'a, ms: Int} -> Option 'a = {p, ms} -> __native_os_timeout {p = p, ms = ms}

## Cancel a promise.
pub let os_cancel: {p: OSPromise 'a} -> {} = {p} -> __native_os_cancel {p = p}

## Sleep for specified milliseconds.
pub let os_sleep: {ms: Int} -> {} = {ms} -> __native_os_sleep {ms = ms}

## Check if a promise is complete.
pub let os_is_done: {p: OSPromise 'a} -> Bool = {p} -> __native_os_is_done {p = p}

## Check if current computation was cancelled.
pub let os_is_cancelled: {} -> Bool = {} -> __native_os_is_cancelled {}

## Cancellation checkpoint - throws if cancelled.
pub let os_check: {} -> {} = {} -> __native_os_check {}

# =============================================================================
# Thread Coordination
# =============================================================================

## Get the current OS thread handle.
pub let os_current_thread: {} -> OSThread = {} -> __native_os_current_thread {}

## Park (suspend) the current thread until unparked.
pub let os_park: {} -> {} = {} -> __native_os_park {}

## Unpark (resume) a parked thread.
pub let os_unpark: {thread: OSThread} -> {} = {thread} -> __native_os_unpark {thread = thread}
