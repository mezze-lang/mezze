# =============================================================================
# std/async/structured.mezze - Structured Concurrency Helpers
# =============================================================================

use std::effects::async::{Async, Promise, AsyncError, Scope}

# =============================================================================
# Parallel Execution
# =============================================================================

# Run all tasks in parallel and wait for all to complete
# Returns list of results in same order as input tasks
#
# Example:
#   let tasks = [
#       {} -> expensive_op1 {},
#       {} -> expensive_op2 {},
#       {} -> expensive_op3 {}
#   ]
#   let results = parallel {tasks = tasks}
#   # results = [result1, result2, result3]
#
# Note: Uses native spawn_all which spawns all tasks and waits for completion
pub let parallel: {tasks: [{} -> 'a]} -> ['a] <Async> =
    {tasks} -> __native_loom_spawn_all {fs = tasks}

# =============================================================================
# Race Execution
# =============================================================================

# Run all tasks in parallel, return result of first to complete
# Other tasks continue running (no cancellation yet)
#
# Example:
#   let tasks = [
#       {} -> fetch_from_cache {},
#       {} -> fetch_from_db {},
#       {} -> fetch_from_api {}
#   ]
#   let fastest = race {tasks = tasks}
#   # Returns whichever completes first
#
# Note: Uses native spawn_race which spawns all tasks and returns first result
pub let race: {tasks: [{} -> 'a]} -> 'a <Async> =
    {tasks} -> __native_loom_spawn_race {fs = tasks}

# =============================================================================
# Timeout
# =============================================================================

# Run a task with a timeout
# Returns Option: Some {val} if completed, None if timeout
#
# Example:
#   let result = with_timeout {
#       f = {} -> slow_operation {},
#       ms = 5000
#   }
#   match result is
#       Some {val} -> val
#       None -> "Timeout!"
pub let with_timeout: {f: {} -> 'a, ms: Int} -> Option 'a <Async> =
    {f, ms} -> do
        let p = Async.spawn {f = f}
        Async.timeout {ms = ms, p = p}

# =============================================================================
# Fan-out / Fan-in Patterns
# =============================================================================

# Map a function over a list in parallel
# Like map, but runs all computations concurrently
#
# Example:
#   let urls = ["url1", "url2", "url3"]
#   let responses = parallel_map {
#       f = {x} -> fetch {url = x},
#       xs = urls
#   }
pub let parallel_map: {f: {x: 'a} -> 'b, xs: ['a]} -> ['b] <Async> =
    {f, xs} -> Async.map {xs = xs, f = f}

# Filter a list in parallel
# Predicate function runs concurrently for all elements
#
# Example:
#   let urls = ["url1", "url2", "url3"]
#   let valid = parallel_filter {
#       f = {x} -> is_reachable {url = x},
#       xs = urls
#   }
pub let parallel_filter: {f: {x: 'a} -> Bool, xs: ['a]} -> ['a] <Async> =
    {f, xs} -> Async.filter {xs = xs, f = f}

# =============================================================================
# Structured Concurrency Scopes
# =============================================================================

# Run computation in a structured scope
# All spawned tasks are awaited before scope exits
#
# Example:
#   scoped {f = {scope} -> do
#       let p1 = scope_spawn {scope = scope, f = {} -> task1 {}}
#       let p2 = scope_spawn {scope = scope, f = {} -> task2 {}}
#       # Both are awaited automatically
#   }
pub let scoped: {f: {scope: Scope 'a} -> 'a} -> 'a <Async> =
    {f} -> Async.scoped {f = f}

# =============================================================================
# Join Patterns
# =============================================================================

# Run two computations in parallel and wait for both
#
# Example:
#   let result = join2 {
#       left = {} -> fetch_user {},
#       right = {} -> fetch_orders {}
#   }
#   # result.left and result.right contain the values
pub let join2: {left: {} -> 'a, right: {} -> 'b} -> {left: 'a, right: 'b} <Async> =
    {left, right} -> Async.join {left = left, right = right}

# Run three computations in parallel and wait for all
pub let join3: {a: {} -> 'a, b: {} -> 'b, c: {} -> 'c} -> {a: 'a, b: 'b, c: 'c} <Async> =
    {a, b, c} -> Async.join3 {a = a, b = b, c = c}

# =============================================================================
# For-each Pattern
# =============================================================================

# Run a side-effecting function on each element in parallel
#
# Example:
#   parallel_for_each {
#       f = {x} -> send_notification {user_id = x},
#       xs = user_ids
#   }
pub let parallel_for_each: {f: {x: 'a} -> {}, xs: ['a]} -> {} <Async> =
    {f, xs} -> Async.for_each {xs = xs, f = f}

# =============================================================================
# Error Handling
# =============================================================================

# Wait for first successful result, fail only if ALL fail
pub let any: {ps: [Promise 'a]} -> 'a <Async> =
    {ps} -> Async.any {ps = ps}

# Wait for all promises, return list of Results (never throws)
pub let settle: {ps: [Promise 'a]} -> [Result 'a AsyncError] <Async> =
    {ps} -> Async.settle {ps = ps}

# =============================================================================
# Examples (in comments)
# =============================================================================
#
# Example 1: Fetch multiple URLs in parallel
#   let responses = parallel_map {
#       f = {x} -> http_get {url = x},
#       xs = urls
#   }
#
# Example 2: Race multiple data sources
#   let fastest = race {
#       tasks = [
#           {} -> fetch_from_cache {},
#           {} -> fetch_from_db {},
#           {} -> fetch_from_api {}
#       ]
#   }
#
# Example 3: Process with timeout
#   let result = with_timeout {
#       f = {} -> slow_external_api {},
#       ms = 5000
#   }
#
# Example 4: Structured concurrency scope
#   scoped {f = {scope} -> do
#       let p1 = std::async::scope_spawn {scope = scope, f = {} -> task1 {}}
#       let p2 = std::async::scope_spawn {scope = scope, f = {} -> task2 {}}
#       Async.await {p = p1} + Async.await {p = p2}
#   }
