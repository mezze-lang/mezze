# std/effects/compile_time.mezze - Compile-time evaluation effect

# CompileTime effect - execute code during compilation
effect CompileTime where {
  # Evaluate computation at compile time
  # Result is embedded in bytecode
  eval: {computation: {} -> 'a} -> 'a <CompileTime>,

  # Expand tagged template at compile time
  # Used by tagged template syntax sugar
  expand: {language: String, code: String} -> Dynamic <CompileTime>
}

# Compiler implementation - recognized specially by compiler
# When compiler sees "perform CompilerEval in ...", it executes at compile time
pub impl CompileTime for CompilerEval where {
  eval = {computation} ->
    __compiler_eval_at_compile_time {computation = computation}

  expand = {language, code} ->
    __compiler_expand_template {language = language, code = code}
}

# Usage examples:
#
# Explicit compile-time evaluation:
# let config = perform CompilerEval in
#   CompileTime.eval {computation = {
#     perform LocalDisk in FileSystem.read_file {path = "config.json"}
#   }}
# # config contains file contents embedded at compile time
#
# With tagged templates (desugars to expand):
# let matrix = perform CompilerEval in
#   CompileTime.expand {language = "python", code = "numpy.array([1, 2, 3])"}
#
# Or using tagged template syntax (sugar):
# let matrix = python```numpy.array([1, 2, 3])```
# # Desugars to above
