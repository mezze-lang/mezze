## Environment and system information effect.
effect Environment where {
  ## Get an environment variable by name.
  get_env: { name: Str } -> Option Str <Environment>,
  ## Set an environment variable for the current process.
  set_env: { name: Str, value: Str } -> {} <Environment>,
  ## Get all environment variables as key-value pairs.
  get_all_env: {} -> [{ key: Str, value: Str }] <Environment>,
  ## Get the current working directory.
  current_dir: {} -> Str <Environment>,
  ## Change the current working directory.
  change_dir: { path: Str } -> {} <Environment>,
  ## Get the operating system name.
  os_name: {} -> Str <Environment>,
  ## Get the operating system version.
  os_version: {} -> Str <Environment>,
  ## Get the CPU architecture.
  arch: {} -> Str <Environment>,
  ## Get the current process ID.
  process_id: {} -> Int <Environment>,
  ## Get command-line arguments.
  process_args: {} -> [Str] <Environment>,
  ## Exit the process with a status code.
  exit: { code: Int } -> {} <Environment>
}

## System environment implementation using real OS calls.
impl Environment for SystemEnvironment where {
  get_env = { name } -> __native_env_get { name = name },
  set_env = { name, value } -> __native_env_set { name = name, value = value },
  get_all_env = {} -> __native_env_get_all {},
  current_dir = {} -> __native_env_current_dir {},
  change_dir = { path } -> __native_env_change_dir { path = path },
  os_name = {} -> __native_env_os_name {},
  os_version = {} -> __native_env_os_version {},
  arch = {} -> __native_env_arch {},
  process_id = {} -> __native_env_process_id {},
  process_args = {} -> __native_env_process_args {},
  exit = { code } -> __native_env_exit { code = code },
}

## Mock environment for testing with fixed values. process_args is a field
## so tests can drive the user program with any argv they want (including
## --, -, --flag=value, etc — everything in the Seq is verbatim).
impl Environment for MockEnvironment { env_vars: [{ key: Str, value: Str }], current_directory: Str, mock_os: Str, mock_args: [Str] } where {
  get_env = { name } -> __native_mock_env_get { env_vars = env_vars, name = name },
  set_env = { name, value } -> {},
  get_all_env = {} -> env_vars,
  current_dir = {} -> current_directory,
  change_dir = { path } -> {},
  os_name = {} -> mock_os,
  os_version = {} -> "Mock 1.0",
  arch = {} -> "mock64",
  process_id = {} -> 12345,
  process_args = {} -> mock_args,
  exit = { code } -> {},
}

## Get an environment variable by name.
pub let get_env : { name: Str } -> Option Str <Environment> = { name } ->
  Environment.get_env { name = name }

## Get the current working directory.
pub let current_dir : {} -> Str <Environment> = {} -> Environment.current_dir {}

## Get OS name, version, and architecture as a record.
pub let os_info : {} -> { name: Str, version: Str, arch: Str } <Environment> = {} ->
  do
    let name = Environment.os_name {}
    let version = Environment.os_version {}
    let architecture = Environment.arch {}
    { name = name, version = version, arch = architecture }
