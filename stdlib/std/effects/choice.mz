# std/effects/choice.mezze - Nondeterministic choice with backtracking

use std::control::continuation

# Choice effect - explore multiple computation paths
# When you choose between options, all paths are explored
# When you fail, that path is abandoned (backtracking)
effect Choice where {
    # Choose one value from multiple options
    # Returns a single value (the effect handler explores all paths)
    choose: { options: ['a] } -> 'a <Choice>,

    # Fail the current branch (triggers backtracking)
    fail: {} -> 'b <Choice>
}

# AllPaths performer - explores all possible paths through choices
# Takes a Continuation record parameter created at the perform boundary
pub impl Choice for AllPaths { cont: Continuation 'a 'b 'c } where {
    choose = { options } -> do
        # Capture the current continuation
        let k = cont.capture {}

        # Use fork to resume continuation once for each option (multishot!)
        # This is the key to nondeterministic choice
        # Fork will handle empty arrays by returning empty results
        cont.fork { cont = k, values = options },

    fail = {} ->
        cont.abort {}
}

# Helper function to run a computation that uses Choice effect
# Returns an array with results from all successful paths
pub let run_all_paths: { computation: {} -> 'a <Choice> } -> ['a] = { computation } -> do
    # continuation::new {} is called here to capture at the perform boundary
    perform AllPaths {cont = continuation::new {}} in do
        computation {}
