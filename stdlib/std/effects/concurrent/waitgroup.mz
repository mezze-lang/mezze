use std::abilities::compare::{ Eq }

## Resettable counter for waiting on a group of tasks to complete.
pub newtype WaitGroup = WaitGroup __NativeWaitGroup

impl Eq for WaitGroup where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl WaitGroup where {
  add = { it, delta } -> add { wg = it, delta = delta },
  done = { it } -> done { wg = it },
  wait = { it } -> wait { wg = it },
  wait_timeout = { it, ms } -> wait_timeout { wg = it, ms = ms },
  get_count = { it } -> get_count_wg { wg = it },
}

## Create a new wait group with count 0.
pub let wait_group : {} -> WaitGroup = {} -> __native_waitgroup_new {}

## Add delta to the counter (positive to register tasks, negative to complete).
pub let add : { wg: WaitGroup, delta: Int } -> {} = { wg, delta } ->
  __native_waitgroup_add { wg = wg, delta = delta }

## Decrement the counter by 1 (call when a task completes).
pub let done : { wg: WaitGroup } -> {} = { wg } -> __native_waitgroup_done { wg = wg }

## Wait until the counter reaches zero.
pub let wait : { wg: WaitGroup } -> {} = { wg } -> __native_waitgroup_wait { wg = wg }

## Wait with timeout. Returns True if counter reached zero, False on timeout.
pub let wait_timeout : { wg: WaitGroup, ms: Int } -> Bool = { wg, ms } ->
  __native_waitgroup_wait_timeout { wg = wg, ms = ms }

## Get the current count.
pub let get_count_wg : { wg: WaitGroup } -> Int = { wg } ->
  __native_waitgroup_get_count { wg = wg }
