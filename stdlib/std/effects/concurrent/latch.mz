use std::abilities::compare::{ Eq }

## One-shot countdown barrier that releases waiting threads when count reaches zero.
pub newtype Latch = Latch __NativeLatch

impl Eq for Latch where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Latch where {
  count_down = { it } -> count_down { latch = it },
  await = { it } -> await_latch { latch = it },
  await_timeout = { it, ms } -> await_latch_timeout { latch = it, ms = ms },
  get_count = { it } -> get_count { latch = it },
}

## Create a new latch with the given count (must be non-negative).
pub let latch : { count: Int } -> Latch = { count } -> __native_latch_new { count = count }

## Decrement the count by one. Releases waiters when count reaches zero.
pub let count_down : { latch: Latch } -> {} = { latch } ->
  __native_latch_count_down { latch = latch }

## Wait until the count reaches zero.
pub let await_latch : { latch: Latch } -> {} = { latch } -> __native_latch_await { latch = latch }

## Wait until count reaches zero or timeout expires. Returns True if released.
pub let await_latch_timeout : { latch: Latch, ms: Int } -> Bool = { latch, ms } ->
  __native_latch_await_timeout { latch = latch, ms = ms }

## Get the current count.
pub let get_count : { latch: Latch } -> Int = { latch } ->
  __native_latch_get_count { latch = latch }
