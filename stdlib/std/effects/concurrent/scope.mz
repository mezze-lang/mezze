use std::effects::concurrency::{ Concurrency, Loom }
use std::collections::seq

## Structured concurrency effect -- forked tasks are automatically awaited on exit.
effect Scope where {
  ## Fork a task within the scope (automatically awaited when scope exits).
  fork: { task: {} -> 'a } -> {} <Scope, Concurrency>
}

## AutoScope handler -- awaits all forked tasks when the scope exits.
impl Scope for AutoScope where {
  fork = { task } -> do
    let _ = Concurrency.spawn { computation = task }
    {}
}

## Run a scoped computation where all forked tasks complete before returning.
pub let with_scope : { computation: {} -> 'a <Scope, Concurrency> } -> 'a <Concurrency> = { computation } ->
  perform AutoScope in do
    computation {}
