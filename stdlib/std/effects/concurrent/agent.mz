use std::abilities::compare::{ Eq }

## Serialized async state agent -- actions are queued and applied one at a time.
pub newtype Agent 'a = Agent __NativeAgent

impl Eq 'a for Agent 'a where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Agent 'a where {
  deref = { it } -> deref_agent { agent = it },
  send = { it, f } -> send { agent = it, f = f },
  send_off = { it, f } -> send_off { agent = it, f = f },
  await = { it } -> await_agent { agent = it },
  await_timeout = { it, timeout_ms } ->
    await_agent_timeout { agent = it, timeout_ms = timeout_ms },
  error = { it } -> agent_error { agent = it },
  has_error = { it } -> has_error { agent = it },
  restart = { it, value } -> restart_agent { agent = it, value = value },
  set_error_handler = { it, handler } -> set_error_handler { agent = it, handler = handler },
}

## Create a new agent with the given initial value.
pub let agent : { value: 'a } -> Agent 'a = { value } -> __native_agent_new { value = value }

## Read the current value of the agent (non-blocking snapshot).
pub let deref_agent : { agent: Agent 'a } -> 'a = { agent } ->
  __native_agent_deref { agent = agent }

## Queue an action on the shared thread pool (good for CPU-bound work).
pub let send : { agent: Agent 'a, f: { current: 'a } -> 'a } -> {} = { agent, f } ->
  __native_agent_send { agent = agent, f = f }

## Queue an action on unbounded threads (good for I/O-bound work).
pub let send_off : { agent: Agent 'a, f: { current: 'a } -> 'a } -> {} = { agent, f } ->
  __native_agent_send_off { agent = agent, f = f }

## Wait until all pending actions have completed.
pub let await_agent : { agent: Agent 'a } -> {} = { agent } -> do
  let _ = __native_agent_await { agent = agent, timeout_ms = 0 }
  {}

## Wait with a timeout. Returns True if completed, False if timed out.
pub let await_agent_timeout : { agent: Agent 'a, timeout_ms: Int } -> Bool = { agent, timeout_ms } ->
  __native_agent_await { agent = agent, timeout_ms = timeout_ms }

## Get the error message if the agent is in error state.
pub let agent_error : { agent: Agent 'a } -> Option Str = { agent } ->
  __native_agent_error { agent = agent }

## Check if the agent is in error state.
pub let has_error : { agent: Agent 'a } -> Bool = { agent } -> match agent_error { agent = agent } is
  Some { val = _ } -> True
  None -> False


## Restart an agent with a new value, clearing any error state.
pub let restart_agent : { agent: Agent 'a, value: 'a } -> {} = { agent, value } ->
  __native_agent_restart { agent = agent, value = value }

## Set a custom error handler invoked when an action throws.
pub let set_error_handler : { agent: Agent 'a, handler: { agent: Agent 'a, error: Str } -> {} } -> {} = { agent, handler } ->
  __native_agent_set_error_handler { agent = agent, handler = handler }
