# std/concurrent/semaphore.mezze - Counting semaphores
#
# Semaphores control access to a resource with limited capacity.
# Unlike mutexes (which allow only 1), semaphores allow N concurrent accessors.
#
# Common use cases:
# - Connection pools (limit concurrent DB connections)
# - Rate limiting (limit concurrent requests)
# - Producer/consumer with bounded buffer
#
# Usage:
#   use std::effects::concurrent::semaphore::{Semaphore, semaphore, acquire, release}
#
#   # Allow max 3 concurrent operations
#   let pool = semaphore {permits = 3}
#
#   let _ = acquire {sem = pool}
#   # ... do work with limited resource ...
#   let _ = release {sem = pool}

use std::abilities::compare::{Eq}

# Semaphore type wrapping Java's Semaphore
pub newtype Semaphore = Semaphore __NativeSemaphore

impl Eq for Semaphore where {
    eq = {it, r} -> __native_ref_eq {l = it, r = r},
    neq = {it, r} -> __native_ref_neq {l = it, r = r}
}

# Create a new semaphore with specified number of permits
#
# Example:
#   let pool = semaphore {permits = 5}  # Allow 5 concurrent
pub let semaphore: {permits: Int} -> Semaphore =
    {permits} -> __native_semaphore_new {permits = permits}

# Acquire one permit (blocks until available)
#
# Example:
#   let _ = acquire {sem = pool}
#   # ... use resource ...
#   let _ = release {sem = pool}
pub let acquire: {sem: Semaphore} -> {} =
    {sem} -> __native_semaphore_acquire {sem = sem}

# Acquire multiple permits (blocks until all available)
#
# Example:
#   let _ = acquire_n {sem = pool, permits = 2}  # Need 2 resources
pub let acquire_n: {sem: Semaphore, permits: Int} -> {} =
    {sem, permits} -> __native_semaphore_acquire_n {sem = sem, permits = permits}

# Release one permit
#
# Example:
#   release {sem = pool}
pub let release: {sem: Semaphore} -> {} =
    {sem} -> __native_semaphore_release {sem = sem}

# Release multiple permits
#
# Example:
#   release_n {sem = pool, permits = 2}
pub let release_n: {sem: Semaphore, permits: Int} -> {} =
    {sem, permits} -> __native_semaphore_release_n {sem = sem, permits = permits}

# Try to acquire one permit without blocking
# Returns true if acquired, false if no permits available
#
# Example:
#   if try_acquire {sem = pool} then do
#       # Got permit
#       let result = do_work {}
#       let _ = release {sem = pool}
#       Some {val = result}
#   else
#       None  # Resource busy
pub let try_acquire: {sem: Semaphore} -> Bool =
    {sem} -> __native_semaphore_try_acquire {sem = sem}

# Try to acquire multiple permits without blocking
pub let try_acquire_n: {sem: Semaphore, permits: Int} -> Bool =
    {sem, permits} -> __native_semaphore_try_acquire_n {sem = sem, permits = permits}

# Get number of currently available permits
#
# Example:
#   let free = available {sem = pool}
pub let available: {sem: Semaphore} -> Int =
    {sem} -> __native_semaphore_available {sem = sem}

# RAII-style acquire/release - acquire, run function, release automatically
#
# Example:
#   let result = with_permit {sem = pool, f = {} -> do
#       # ... use resource ...
#       compute_result {}
#   }
pub let with_permit: {sem: Semaphore, f: {} -> 'a} -> 'a =
    {sem, f} -> __native_semaphore_with_permit {sem = sem, f = f}
