use std::abilities::compare::{ Eq }

## Counting semaphore for limiting concurrent access.
pub newtype Semaphore = Semaphore __NativeSemaphore

impl Eq for Semaphore where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Semaphore where {
  acquire = { it } -> acquire { sem = it },
  acquire_n = { it, permits } -> acquire_n { sem = it, permits = permits },
  release = { it } -> release { sem = it },
  release_n = { it, permits } -> release_n { sem = it, permits = permits },
  try_acquire = { it } -> try_acquire { sem = it },
  try_acquire_n = { it, permits } -> try_acquire_n { sem = it, permits = permits },
  available = { it } -> available { sem = it },
  with_permit = { it, f } -> with_permit { sem = it, f = f },
}

## Create a semaphore with the given number of permits.
pub let semaphore : { permits: Int } -> Semaphore = { permits } ->
  __native_semaphore_new { permits = permits }

## Acquire one permit (blocks until available).
pub let acquire : { sem: Semaphore } -> {} = { sem } -> __native_semaphore_acquire { sem = sem }

## Acquire n permits (blocks until all available).
pub let acquire_n : { sem: Semaphore, permits: Int } -> {} = { sem, permits } ->
  __native_semaphore_acquire_n { sem = sem, permits = permits }

## Release one permit.
pub let release : { sem: Semaphore } -> {} = { sem } -> __native_semaphore_release { sem = sem }

## Release n permits.
pub let release_n : { sem: Semaphore, permits: Int } -> {} = { sem, permits } ->
  __native_semaphore_release_n { sem = sem, permits = permits }

## Try to acquire one permit without blocking.
pub let try_acquire : { sem: Semaphore } -> Bool = { sem } ->
  __native_semaphore_try_acquire { sem = sem }

## Try to acquire n permits without blocking.
pub let try_acquire_n : { sem: Semaphore, permits: Int } -> Bool = { sem, permits } ->
  __native_semaphore_try_acquire_n { sem = sem, permits = permits }

## Get the number of currently available permits.
pub let available : { sem: Semaphore } -> Int = { sem } ->
  __native_semaphore_available { sem = sem }

## Acquire a permit, run f, release automatically.
pub let with_permit : { sem: Semaphore, f: {} -> 'a } -> 'a = { sem, f } ->
  __native_semaphore_with_permit { sem = sem, f = f }
