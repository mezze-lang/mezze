use std::abilities::compare::{ Eq }

## Reentrant mutual exclusion lock.
pub newtype Mutex = Mutex __NativeLock

impl Eq for Mutex where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl Mutex where {
  with_lock = { it, f } -> with_lock { mutex = it, f = f },
  lock = { it } -> lock { mutex = it },
  unlock = { it } -> unlock { mutex = it },
  try_lock = { it } -> try_lock { mutex = it },
  is_held_by_current_thread = { it } -> is_held_by_current_thread { mutex = it },
}

## Create a new mutex.
pub let mutex : {} -> Mutex = {} -> __native_mutex_new {}

## Acquire lock, run f, release lock automatically (recommended).
pub let with_lock : { mutex: Mutex, f: {} -> 'a <...> } -> 'a <...> = { mutex, f } ->
  __native_mutex_with_lock { mutex = mutex, f = f }

## Acquire the lock (blocking). You must call unlock when done.
pub let lock : { mutex: Mutex } -> {} = { mutex } -> __native_mutex_lock { mutex = mutex }

## Release the lock. Must be called by the thread that holds it.
pub let unlock : { mutex: Mutex } -> {} = { mutex } -> __native_mutex_unlock { mutex = mutex }

## Try to acquire the lock without blocking. Returns True if acquired.
pub let try_lock : { mutex: Mutex } -> Bool = { mutex } ->
  __native_mutex_try_lock { mutex = mutex }

## Check if the current thread holds this mutex.
pub let is_held_by_current_thread : { mutex: Mutex } -> Bool = { mutex } ->
  __native_mutex_is_held_by_current_thread { mutex = mutex }
