use std::abilities::compare::{ Eq }

## Cooperative cancellation token supporting hierarchical cancellation.
pub newtype CancellationToken = CancellationToken __NativeCancellationToken

impl Eq for CancellationToken where {
  eq = { it, r } -> __native_ref_eq { l = it, r = r },
  neq = { it, r } -> __native_ref_neq { l = it, r = r },
}

impl CancellationToken where {
  cancel = { it, reason } -> cancel { token = it, reason = reason },
  cancel_default = { it } -> cancel_default { token = it },
  is_cancelled = { it } -> is_cancelled { token = it },
  get_reason = { it } -> get_reason { token = it },
  check_cancelled = { it } -> check_cancelled { token = it },
  on_cancel = { it, callback } -> on_cancel { token = it, callback = callback },
  remove_callback = { it, id } -> remove_callback { token = it, id = id },
  create_child = { it } -> create_child { token = it },
  with_cancellation = { it, f } -> with_cancellation { token = it, f = f },
}

## Create a new cancellation token.
pub let token : {} -> CancellationToken = {} -> __native_cancellation_token_new {}

## Alias for token.
pub let new : {} -> CancellationToken = token

## Cancel the token with a reason, invoking all registered callbacks.
pub let cancel : { token: CancellationToken, reason: Str } -> {} = { token, reason } ->
  __native_cancellation_token_cancel { token = token, reason = reason }

## Cancel with a default reason.
pub let cancel_default : { token: CancellationToken } -> {} = { token } ->
  cancel { token = token, reason = "Operation cancelled" }

## Check if the token has been cancelled.
pub let is_cancelled : { token: CancellationToken } -> Bool = { token } ->
  __native_cancellation_token_is_cancelled { token = token }

## Get the cancellation reason, or None if not cancelled.
pub let get_reason : { token: CancellationToken } -> Option Str = { token } ->
  __native_cancellation_token_get_reason { token = token }

## Throw an exception if the token is cancelled (cancellation checkpoint).
pub let check_cancelled : { token: CancellationToken } -> {} = { token } ->
  __native_cancellation_token_throw_if_cancelled { token = token }

## Alias for check_cancelled.
pub let throw_if_cancelled : { token: CancellationToken } -> {} = check_cancelled

## Register a callback invoked on cancellation. Returns a callback ID.
pub let on_cancel : { token: CancellationToken, callback: {} -> {} } -> Str = { token, callback } ->
  __native_cancellation_token_on_cancellation { token = token, callback = callback }

## Alias for on_cancel.
pub let on_cancellation : { token: CancellationToken, callback: {} -> {} } -> Str = on_cancel

## Remove a previously registered callback by ID.
pub let remove_callback : { token: CancellationToken, id: Str } -> {} = { token, id } ->
  __native_cancellation_token_remove_callback { token = token, id = id }

## Create a child token cancelled when the parent is cancelled.
pub let create_child : { token: CancellationToken } -> CancellationToken = { token } ->
  __native_cancellation_token_create_child { token = token }

## Run f if not cancelled, returning Some on success, None if cancelled.
pub let with_cancellation : { token: CancellationToken, f: {} -> 'a <...> } -> Option 'a <...> = { token, f } ->
  if is_cancelled { token = token } then None else Some { val = f {} }
