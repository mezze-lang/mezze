# Boolean utility functions
# This module provides utility functions for working with booleans
# Note: The Boolean type and basic operations are now built-in
# Built-in ability implementations (Eq, Inspect) are automatically available

# Type conversions
pub let to_string = { val: Boolean } ->
    if val then "true" else "false"

# Boolean logic operations
pub let and = { l: Boolean, r: Boolean } ->
    if l then r else false

pub let or = { l: Boolean, r: Boolean } ->
    if l then true else r

pub let not = { x: Boolean } ->
    if x then false else true

pub let xor = { l: Boolean, r: Boolean } ->
    (l && not { x = r }) || (not { x = l } && r)

pub let implies = { l: Boolean, r: Boolean } ->
    not { x = l } || r

pub let iff = { l: Boolean, r: Boolean } ->
    (l && r) || (not { x = l } && not { x = r })

