use std::abilities::compare::{ Eq, Ord, Hash, structural_hash }
use std::abilities::convert::{ Into, TryInto }
use std::int

## Structural hash, paired with the `Eq` below.
## `Eq` and `Hash` are written together or not at all: a hash container
## buckets by one and compares by the other, so a value whose hash
## disagrees with its equality is silently kept twice.
impl Hash for Char where {
  hash: { it: Char } -> Int = { it } -> structural_hash { it = it }
}

impl Eq for Char where {
  eq = { it, r } -> __native_char_eq { a = it, b = r },
  neq = { it, r } -> if __native_char_eq { a = it, b = r } then False else True,
}

impl Ord for Char where {
  lt = { it, r } -> __native_char_compare_int { a = it, b = r } == (0 - 1),
  le = { it, r } -> __native_char_compare_int { a = it, b = r } != 1,
  gt = { it, r } -> __native_char_compare_int { a = it, b = r } == 1,
  ge = { it, r } -> __native_char_compare_int { a = it, b = r } != (0 - 1),
}

impl Into Int for Char where {
  into = { it } -> __native_char_to_int { c = it }
}

impl Into Str for Char where {
  into = { it } -> __native_char_to_str { c = it }
}

impl TryInto Char | ConversionError { msg: Str } | for Int where {
  try_into = { it } -> match __native_char_from_int { code = it } is
    Some { val } -> Ok { val = val }
    None -> Err {
      error = ConversionError { msg = "invalid char code point" },
    }

}

impl TryInto Char | ConversionError { msg: Str } | for Str where {
  try_into = { it } -> match __native_char_from_string { s = it } is
    Some { val } -> Ok { val = val }
    None -> Err {
      error = ConversionError { msg = "string must be exactly one character" },
    }

}

## Create a Char from a Unicode code point. Returns None if invalid.
pub let from_int: { code: Int } -> Option Char = { code } ->
  __native_char_from_int { code = code }

## Get the first character of a string. Returns None if empty.
pub let from_str: { s: Str } -> Option Char = { s } -> __native_char_from_string { s = s }

## Get the Unicode code point of a character.
pub let to_int: { c: Char } -> Int = { c } -> __native_char_to_int { c = c }

## Convert a character to a single-character string.
pub let to_str: { c: Char } -> Str = { c } -> __native_char_to_str { c = c }

## Convert to uppercase.
pub let to_upper: { c: Char } -> Char = { c } -> __native_char_to_upper { c = c }

## Convert to lowercase.
pub let to_lower: { c: Char } -> Char = { c } -> __native_char_to_lower { c = c }

## True if the character is a digit (0-9).
pub let is_digit: { c: Char } -> Bool = { c } -> __native_char_is_digit { c = c }

## True if the character is a letter.
pub let is_letter: { c: Char } -> Bool = { c } -> __native_char_is_letter { c = c }

## True if the character is a letter or digit.
pub let is_alpha_numeric: { c: Char } -> Bool = { c } -> __native_char_is_alpha_numeric { c = c }

## True if the character is whitespace.
pub let is_whitespace: { c: Char } -> Bool = { c } -> __native_char_is_whitespace { c = c }

## True if the character is uppercase.
pub let is_upper: { c: Char } -> Bool = { c } -> __native_char_is_upper { c = c }

## True if the character is lowercase.
pub let is_lower: { c: Char } -> Bool = { c } -> __native_char_is_lower { c = c }

## True if two characters are equal.
pub let eq: { a: Char, b: Char } -> Bool = { a, b } -> __native_char_eq { a = a, b = b }

## Convert a digit char to its numeric value in the given radix. Returns None if invalid.
pub let digit_to_int: { c: Char, radix: Int } -> Option Int = { c, radix } ->
  __native_char_digit_to_int { c = c, radix = radix }

impl Char where {
  to_int = { it } -> __native_char_to_int { c = it },
  to_str = { it } -> __native_char_to_str { c = it },
  to_upper = { it } -> __native_char_to_upper { c = it },
  to_lower = { it } -> __native_char_to_lower { c = it },
  is_letter = { it } -> __native_char_is_letter { c = it },
  is_digit = { it } -> __native_char_is_digit { c = it },
  is_whitespace = { it } -> __native_char_is_whitespace { c = it },
  is_upper = { it } -> __native_char_is_upper { c = it },
  is_lower = { it } -> __native_char_is_lower { c = it },

  ## dot-chain parity: inherent method for every receiver-taking free
  ## function not already covered by an ability, so `x.op {}` works.
  is_alpha_numeric = { it } -> is_alpha_numeric { c = it },
  digit_to_int = { it, radix } -> digit_to_int { c = it, radix = radix },
}
