use std::effects::exception::{ Exception }

## Types `.try {}` can unwrap, short-circuiting on failure via `Exception.throw`.
## Use inside `perform ExceptionToResult`, which turns the throw into an `Err`.
#{ missing: "`.try {}` unwraps `Option`, `Result`, or any type with an `impl Tryable`." }
ability Tryable for 'm having 'inner where {
  ## Return the success value, or `Exception.throw` the failure.
  try: { it: 'm } -> 'inner <Exception>
}
