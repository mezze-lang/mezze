## Infallible conversion from 'a into 'b.
ability Into 'b for 'a where {
  ## Convert this value into the target type.
  into: { it: 'a } -> 'b
}

## Fallible conversion from 'a into 'b, returning Result 'b 'err.
ability TryInto 'b 'err for 'a where {
  ## Attempt conversion, returning Ok on success or Err on failure.
  try_into: { it: 'a } -> Result 'b 'err
}
