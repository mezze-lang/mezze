# std/abilities/logic.mz - Logical abilities
#
# Defines logical operations as abilities.
# Operators are desugared to method-call syntax:
#   x && y  ->  x.and {r = y}
#   x || y  ->  x.or {r = y}
#   !x      ->  x.not {}

ability LogicalAnd for 'a where {
    and: {r: 'a} -> 'a
}

ability LogicalOr for 'a where {
    or: {r: 'a} -> 'a
}

ability LogicalNot for 'a where {
    not: {} -> 'a
}
