## Logical AND. Desugars the `&&` operator.
ability LogicalAnd for 'a where {
  ## Logical conjunction of it and r.
  and: { it: 'a, r: 'a } -> 'a
}

## Logical OR. Desugars the `||` operator.
ability LogicalOr for 'a where {
  ## Logical disjunction of it and r.
  or: { it: 'a, r: 'a } -> 'a
}

## Logical NOT. Desugars the `!` operator.
ability LogicalNot for 'a where {
  ## Logical negation.
  not: { it: 'a } -> 'a
}
