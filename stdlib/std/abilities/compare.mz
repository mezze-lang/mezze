## Equality comparison; desugars `==` and `!=`.
## Not auto-derived for a `newtype`: its author must say what equality means.
#{ missing: "`Eq` and `Hash` are ONE decision — a hash container buckets by hash and settles ties by equality, so a `Map` key or `Set` element needs both, and writing only `Eq` is refused. Implement both: `impl Eq for T where { eq = { it, r } -> ..., neq = { it, r } -> ... }` and `impl Hash for T where { hash = { it } -> ... }`. For a newtype, unwrap to compare the payload: `eq = { it, r } -> match it is T.(a) -> match r is T.(b) -> a == b`." }
ability Eq for 'a where {
  ## Returns True if the two values are equal.
  eq: { it: 'a, r: 'a } -> Bool,
  ## Returns True if the two values are not equal.
  neq: { it: 'a, r: 'a } -> Bool
}

## Ordering comparison. Desugars `<`, `<=`, `>`, `>=` operators.
ability Ord for 'a where {
  ## Less than.
  lt: { it: 'a, r: 'a } -> Bool,
  ## Less than or equal.
  le: { it: 'a, r: 'a } -> Bool,
  ## Greater than.
  gt: { it: 'a, r: 'a } -> Bool,
  ## Greater than or equal.
  ge: { it: 'a, r: 'a } -> Bool
}


# A typed `pub let`, not a bare native: an unsigned native leaves every `impl X.hash` open-typed.
## The structural hash of a value, i.e. what a derived `Hash` computes.
pub let structural_hash: { it: 'a } -> Int = { it } -> __native_structural_hash { it = it }

## Hash code used by hash containers; `a == b` must imply equal hashes.
## Derived for every type (newtypes too); a type that writes its own `Eq` must write `Hash`.
ability Hash for 'a where {
  ## A hash code for this value. Equal values MUST return equal codes.
  hash: { it: 'a } -> Int
}
