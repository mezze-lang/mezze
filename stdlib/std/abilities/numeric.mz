## Addition. Desugars the `+` operator.
##
## `'r` is the right-operand type (a class parameter, so each ordered `(l, r)`
## pair is a distinct impl) and `'out` the result. This lets heterogeneous
## additions coexist — e.g. `Int + Float -> Float` — while the same-type impls
## bind `'r`/`'out` to the receiver, so `Int + Int -> Int`.
ability NumAdd 'r for 'l having 'out where {
  ## Add two values.
  add: { it: 'l, r: 'r } -> 'out
}

## Subtraction. Desugars the binary `-` operator.
ability NumSub for 'a where {
  ## Subtract r from it.
  sub: { it: 'a, r: 'a } -> 'a
}

## Multiplication. Desugars the `*` operator.
ability NumMul for 'a where {
  ## Multiply two values.
  mul: { it: 'a, r: 'a } -> 'a
}

## Division. Desugars the `/` operator.
ability NumDiv for 'a where {
  ## Divide it by r.
  div: { it: 'a, r: 'a } -> 'a
}

## Modulo. Desugars the `%` operator.
ability NumMod for 'a where {
  ## Remainder of it divided by r.
  mod: { it: 'a, r: 'a } -> 'a
}

## Additive identity -- zero value and zero check.
ability NumZero for 'a where {
  ## Construct the zero value for this type.
  zero: {} -> 'a,
  ## Returns True if the value is zero.
  is_zero: { it: 'a } -> Bool
}

## Multiplicative identity -- the one value.
ability NumOne for 'a where {
  ## Construct the one value for this type.
  one: {} -> 'a
}
