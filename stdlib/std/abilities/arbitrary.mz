# Arbitrary — how a value of a type is assembled.

use std::effects::sample::{ Sample, choose, one_of, list_of, frequency }
use std::math::core
use std::nat::{ Nat }
use std::nat
# The arithmetic below needs the Int and Float numeric impls in scope; without
# these, `0 - 100` reports no `NumSub` for Int because only Nat's were imported.
use std::int
use std::float
use std::frac
# The container impls below build each container from a generated sequence, so
# every one of these is a constructor, not a convenience.
use std::collections::seq
use std::collections::set
use std::collections::list
use std::collections::map
use std::collections::deque
use std::collections::sorted_set
use std::collections::sorted_map
use std::collections::nonemptylist

## A type that can be generated.
##
## The ability says HOW a value is assembled, which is structure — so the
## compiler derives it for records and non-recursive variants the same way it
## derives `Eq`. Where the numbers come from is not part of any type, so that
## lives in the `Sample` effect instead, and a derived impl performs only
## `<Sample>`: it never mentions `Random`, and the sampler decides whether
## entropy is seeded or live.
##
## Containers are WRITTEN rather than derived, because a container's identity is a
## reserved name rather than a declaration, so there is no structure to walk. They
## are written below for all of them: sequences, `List`, `Set`, `SortedSet`,
## `Deque`, `NonEmptyList`, `Map` and `SortedMap`.
##
## ## What this makes possible
##
## A Mezze function takes a single RECORD. So "generate arguments for `f`" is not
## a special mechanism — it is `arbitrary` at `f`'s parameter type, which is an
## ordinary record and derives like any other. That is why `mez sample` needs no
## type-directed code of its own, and why a field whose type has no impl produces
## an ordinary missing-impl diagnostic naming that type rather than a hand-written
## list of what the tool cannot handle.
##
## Property testing is the other consumer, and wants the same generators.
##
## ## Dispatch is on the RETURN type
##
## `arbitrary` takes no arguments, so there is nothing to dispatch on but the type
## being produced. Like a `decode`-style operation, the call site's expected type
## is what selects the impl — which means `arbitrary {}` needs its target pinned,
## and an unannotated `let x = arbitrary {}` is ambiguous rather than wrong.
##
## ## Newtypes must opt in
##
## As with `Embeddable`, and for the same reason plus a stronger one. A newtype is
## opaque, so deriving would pierce that wall — but generation also has a domain
## question the representation cannot answer: `newtype Email = Str` does not want
## arbitrary strings and `newtype Age = Int` does not want negative ones. The
## author opting in is where they say what a valid value IS.
ability Arbitrary for 'a where {
  arbitrary: {} -> 'a <Sample>
}

## The ability operation under a plain name, so callers write `arbitrary {}`.
##
## This was rejected before S-1 with "Annotation declares effects Sample which are
## not used in the implementation" — the op's declared `<Sample>` never reached the
## call site, so the body looked pure and contradicted the annotation. The
## constraint is what carries `'a` out to the caller, whose expected type pins it.
pub let arbitrary: {} with Arbitrary 'a -> 'a <Sample> = {} -> Arbitrary.arbitrary {}

## ## Why these are not uniform draws, and where the numbers come from
##
## A uniform draw over a wide range is close to the worst generator there is: every
## value it produces is unremarkable, and the ones that break code are the ones it
## will almost never pick. Drawing uniformly over the whole Int range hits `0` with
## probability 2^-64.
##
## The weights and the special values below are ScalaCheck's, read off
## `Gen.chooseNum`:
##
##     val basics = List(minT, maxT, zero, one, -one)
##     val basicsAndSpecials = ... yield (1, const(t))
##     val other = (basicsAndSpecials.length, c.choose(minT, maxT))
##     frequency(allGens*)
##
## So: FIVE specials — min, max, 0, 1, -1 — one weight each, and the uniform draw
## weighted equal to their count. A 50/50 split, 10% per special, and the random
## half spans the FULL range.
##
## Three corrections that came from reading it rather than guessing:
##
##  - the special set is only the canonical five. An earlier thirteen (2, -2, 3, 4,
##    10, -10, ±100) diluted the ones that matter without adding a case anyone's
##    code distinguishes.
##  - the random half must be WIDE. It was [-1000, 1000], which cannot find an
##    overflow in arithmetic — the thing a big random Int is for.
##  - 50/50, not 70/30. Over-weighting the table starves the random half, which is
##    what finds the bugs no table anticipated.
pub let interesting_percent: Int = 50

## `0 - max - 1` because the bare literal for the minimum is one past the largest
## POSITIVE literal the lexer accepts.
pub let int_max: Int = 9223372036854775807
pub let int_min: Int = 0 - 9223372036854775807 - 1

let take_interesting: {} -> Bool <Sample> = {} -> choose { bound = 100 } < interesting_percent

## A sign, drawn separately so the magnitude draw stays non-negative.
let negate_sometimes: { n: Int } -> Int <Sample> = { n } ->
  if choose { bound = 2 } == 0 then n else 0 - n

## The DRAW for an `Int`, with no `impl` around it.
##
## The instance is written by the compiler, exactly as `impl Eq for Int` is — a
## builtin type does not get a hand-written impl in a stdlib file. What the compiler
## cannot supply is which values are interesting, so that stays here, and the
## generated impl forwards to this. `impl Eq for Int`'s generated body forwards to
## `__native_int_eq` for the same reason: the instance is the compiler's, the
## behaviour is not.
##
## Module-local rather than `pub`: the generated impl lands in THIS module, so it
## needs no export, and `arbitrary {}` is the public way to reach it.
let arbitrary_int: {} -> Int <Sample> = {} ->
  if take_interesting {}
    then one_of { xs = [int_min, int_max, 0, 1, 0 - 1], def = 0 }
    ## The widest magnitude one `choose` can express, with a sign on top.
    ## `choose` draws `[0, bound)`, so a genuinely full-range draw would need the
    ## bound to be 2^64 — which does not fit. Magnitude-plus-sign reaches
    ## ±(2^63 - 2), and the two values it cannot produce are `int_min` and
    ## `int_max`, which are in the table above.
    else negate_sometimes { n = choose { bound = int_max } }

## ## Float spans EXPONENTS, not a narrow band
##
## ScalaCheck builds a Double from its bit pattern — sign, exponent and mantissa
## drawn separately — so denormals and huge magnitudes arise naturally. Mezze has no
## float-from-bits native, so the same coverage is composed arithmetically:
## `mantissa * 2^exponent` with the exponent drawn over [-60, 60].
##
## That is the part that matters. The previous `(unit {} * 200.0) - 100.0` could only
## ever produce a mid-range float — never 1e-18, never 1e18 — so it could not find a
## precision loss, an underflow, or a comparison that only fails at scale.
let arbitrary_float: {} -> Float <Sample> = {} ->
  if take_interesting {}
    then one_of { xs = [0.0, 1.0, 0.0 - 1.0, 0.5, 0.0 - 0.5], def = 0.0 }
    else do
      let mantissa = float::from_int { n = negate_sometimes { n = choose { bound = 1000000 } } }
      let exponent = float::from_int { n = choose { bound = 121 } - 60 }
      mantissa * core::pow { base = 2.0, exp = exponent }

let arbitrary_bool: {} -> Bool <Sample> = {} -> choose { bound = 2 } == 1

## ## `Frac` is exact, so its interesting values are the ones exactness is FOR
##
## The point of a rational is that `1//3` is not `0.333…`, so the table leans on
## the fractions a float cannot hold: thirds, sixths, sevenths. The boundaries are
## still the canonical five from `Gen.chooseNum`, written as fractions.
##
## The random half draws numerator and denominator separately, and the denominator
## is `choose + 1` so it is never zero — `frac::make` auto-reduces, so no further
## normalisation is wanted here. The magnitudes stay near a million rather than
## spanning `Int`: reduction multiplies, and a numerator near `int_max` would
## overflow inside the constructor rather than producing a large fraction.
let arbitrary_frac: {} -> Frac <Sample> = {} ->
  if take_interesting {}
    then one_of { xs = [0//1, 1//1, -1//1, 1//2, -1//2, 1//3, 2//3, 1//6, 22//7], def = 0//1 }
    else frac::make {
      numerator = negate_sometimes { n = choose { bound = 1000000 } },
      denominator = choose { bound = 1000 } + 1,
    }

## NO `Arbitrary for Char` yet, and the reason is a language fact worth recording.
##
## Mezze has no character literal: `'a` is a TYPE VARIABLE, so `'a'` does not
## parse. A total impl needs a `Char` to fall back to when a partial conversion
## comes back empty, and there is no way to write one. Every route was checked:
##
##  - `char::from_int`, `char::from_str` — both return `Option Char`.
##  - `str::chars` then `seq::get` — `Option Char` again.
##  - `char::to_upper`, `to_lower` — total, and both TAKE a `Char`.
##  - `MutChar` via `read_char` / `char_to_immut` — total, but the only way to make
##    a `MutChar` is `char_to_mut { c: Char }`.
##
## The circle closes every way round: a `Char` can be OBTAINED by discharging an
## `Option` and constructed no other way. That is a language hole rather than a
## sampling one — any code wanting a known character meets it too.
##
## Closing it needs one of two things, and both are language decisions rather than
## fixes: a character literal, or a total `Char`-producing primitive (which would
## have to answer somehow for an out-of-range code point). Until one exists, a
## record with a `Char` field reports a missing impl — accurate, and better than
## inventing an answer here.

## ## Readable usually, pathological often enough
##
## The awkward values matter — the empty string breaks parsers, a bare quote and a
## newline break naive escaping, and non-ASCII breaks "it worked on my ASCII" — but
## they cannot be the TYPICAL draw. One `Arbitrary` instance serves both consumers,
## and they want opposite things: a sample is read by a person deciding whether a
## function does what they think, where a lone `"` looks like the tool is broken
## rather than like information. A property test runs a hundred cases and only needs
## the awkward ones to appear.
##
## Weighting serves both. At 15%, a hundred-case property run sees roughly fifteen
## pathological inputs — ample — while a single sample reads as an ordinary word
## about two times in three.
let arbitrary_str: {} -> Str <Sample> = {} -> frequency {
  choices = [
    ## Short and alphabetic: what a person reading one sample wants to see.
    { weight = 65, gen = {} ->
      one_of { xs = ["alpha", "beta", "gamma", "mezze", "sample", "hello", "world"], def = "" } },
    ## The boundaries. Cheap to produce, and the ones most code forgets.
    { weight = 20, gen = {} -> one_of { xs = ["", " ", "a"], def = "" } },
    ## The genuinely hostile set, kept rare rather than removed.
    { weight = 15, gen = {} ->
      one_of { xs = ["\"", "\n", "\t", "ünïcödé", "  padded  ", "a,b;c"], def = "" } },
  ],
  def = "",
}

# ---------------------------------------------------------------------------
# Containers.
#
# Every one of these has to be WRITTEN rather than derived, and for a reason that
# is not about generation: a container's identity is carried by a reserved NAME
# (see `BuiltinTypes`) rather than a declaration, so there is no structure for the
# deriver to walk. That same absence is what lets them be written at all — the
# coherence rule keys on a declaration, finds none, and does not apply. `Option`
# and `Result` DO have declarations, which is the whole of why they are still
# stuck (S-4, below).
#
# Each impl carries `with Arbitrary 'a`, so the call site must pass a dictionary
# for the ELEMENT's instance. For a receiver-less operation there is no argument to
# read that type off, and the dictionary used to be omitted entirely — the call
# reached a slot nobody filled and died as
# `DictFallback[arbitrary]: record has no 'it' field`. The instance head now binds
# against the type the call PRODUCES, which plays exactly the receiver's role, so
# the element's dictionary arrives. `ArbitraryContainerTest` holds that line.
#
# The shape is the same throughout: draw a sequence, then convert. The length comes
# from the size budget, so nesting terminates rather than multiplying out, and the
# element draw is an ordinary recursive `Arbitrary.arbitrary {}` — which is why
# `[[Set Int]]` needs no special case anywhere.
#
# These were briefly held out, and the reason is worth keeping because it was a
# WRONG diagnosis twice over. Adding the two map impls appeared to break
# `Arbitrary` for the whole program, `Int` included, which read as a two-variable
# impl head poisoning the operation's dictionary slots. It was neither: the arity
# was innocent and nothing was poisoned. A parameterised impl of a receiver-less
# operation simply could not be entered at all (S-10) — the monomorphizer rewrote a
# constraint-driven call only when the function position was `receiver.method`, and
# a receiver-less operation has no receiver to be a field access of. The whole
# module failed, and a failure inside this module takes every consumer with it,
# which is what made a local bug look global.
# ---------------------------------------------------------------------------

impl Arbitrary for ['a] where {
  arbitrary: {} with Arbitrary 'a -> ['a] <Sample> = {} ->
    list_of { g = {} -> Arbitrary.arbitrary {} }
}

impl Arbitrary for List 'a where {
  arbitrary: {} with Arbitrary 'a -> List 'a <Sample> = {} ->
    list::from_seq { xs = list_of { g = {} -> Arbitrary.arbitrary {} } }
}

impl Arbitrary for Deque 'a where {
  arbitrary: {} with Arbitrary 'a -> Deque 'a <Sample> = {} ->
    deque::from_seq { xs = list_of { g = {} -> Arbitrary.arbitrary {} } }
}

## A drawn sequence may repeat, so the set is usually SHORTER than the draw. That
## is the correct behaviour rather than a flaw: a `Set` of a two-valued type can
## only have three inhabitants, and a generator that insisted on a requested length
## could not produce them.
impl Arbitrary for Set 'a where {
  arbitrary: {} with Arbitrary 'a, Eq 'a, Hash 'a -> Set 'a <Sample> = {} ->
    set::from_seq { xs = list_of { g = {} -> Arbitrary.arbitrary {} } }
}

impl Arbitrary for SortedSet 'a where {
  arbitrary: {} with Arbitrary 'a, Ord 'a -> SortedSet 'a <Sample> = {} ->
    sorted_set::from_seq { xs = list_of { g = {} -> Arbitrary.arbitrary {} } }
}

## ## The maps INSERT rather than converting
##
## `map::from_list` would be the obvious constructor and folding `insert` is the
## one chosen, because it needs no intermediate `List` at all — `map::empty` with
## `map::insert` is total and the draw is already a sequence.
##
## TWO element dictionaries are live at once here, for the key and the value
## independently — the only impls in this file whose head binds more than one
## variable — and the pair is drawn inside a LAMBDA, so both have to be CAPTURED
## rather than read from the operation's own parameters. That combination was S-11:
## the capture lookup dropped the ability segment from its request, missed the exact
## per-variable slot, and fell through to a prefix scan answering with whichever
## variable came first, so one dictionary served both. Fixing it also fixed `List`,
## whose draw had been coming back as the wrong runtime shape for the same reason.
##
## Keys deduplicate on the way in, so a drawn map is usually smaller than the draw,
## for the same reason a `Set` is.
impl Arbitrary for Map 'k 'v where {
  arbitrary: {} with Arbitrary 'k, Arbitrary 'v, Eq 'k, Hash 'k -> Map 'k 'v <Sample> = {} ->
    seq::fold {
      xs = list_of { g = {} -> { k = Arbitrary.arbitrary {}, v = Arbitrary.arbitrary {} } },
      init = map::empty {},
      f = { acc, x } -> map::insert { m = acc, k = x.k, v = x.v },
    }
}

impl Arbitrary for SortedMap 'k 'v where {
  arbitrary: {} with Arbitrary 'k, Arbitrary 'v, Ord 'k -> SortedMap 'k 'v <Sample> = {} ->
    seq::fold {
      xs = list_of { g = {} -> { k = Arbitrary.arbitrary {}, v = Arbitrary.arbitrary {} } },
      init = sorted_map::empty {},
      f = { acc, x } -> sorted_map::insert { m = acc, k = x.k, v = x.v },
    }
}

## The one container whose emptiness is a TYPE error rather than a value, so it
## cannot be built from a drawn sequence alone — `from_seq` returns an `Option` and
## unwrapping it would need an answer for a case the type forbids. Built instead
## from a guaranteed element, with the drawn sequence consed on top: total by
## construction, no option to discharge.
impl Arbitrary for NonEmptyList 'a where {
  arbitrary: {} with Arbitrary 'a -> NonEmptyList 'a <Sample> = {} ->
    seq::fold {
      xs = list_of { g = {} -> Arbitrary.arbitrary {} },
      init = nonemptylist::singleton { x = Arbitrary.arbitrary {} },
      f = { acc, x } -> nonemptylist::cons { x = x, xs = acc },
    }
}

## NO `Arbitrary for Option` / `for Result`, and the reason is a RULE collision
## rather than a missing feature.
##
## Both would work — the dictionary fix that made `['a]` work covers them, measured.
## But the coherence rule refuses a hand-written impl for any type that is
## STRUCTURALLY derivable, and a variant is; while the thing that would derive it
## never runs, because `std::option` and `std::result` cannot import `Arbitrary`
## (the prelude is built from them). So the type gets NEITHER instance: refused a
## written one, never given a generated one.
##
## `['a]` escapes only by accident — it has no declaration, so
## `coherenceReceiverName` returns null for it and the rule does not apply.
##
## The honest rule is "refuse a second instance", and for that the question is
## whether derivation WILL produce one — structural derivability AND the ability
## being nameable where the type is declared — not whether it could in principle.
## Weakening it to "an instance already exists" was tried and is WRONG: derivation
## deliberately steps aside when an explicit impl is present, so that condition is
## false in precisely the case the rule must catch, and three coherence tests said
## so. See S-4.

## `Nat` is a newtype over `Int`, so it does not derive — the stdlib opts it in,
## exactly as it does for `Embeddable`.
##
## A `Nat` cannot go below zero, so its interesting values are the low boundary and
## a spread upward: there are no negatives to mirror. `nat::from_int` is partial and
## its `None` arm is unreachable here because the range starts at zero, so the
## fallback is `0n` rather than a branch that cannot happen.
impl Arbitrary for Nat where {
  arbitrary = {} ->
    if take_interesting {}
      then one_of { xs = [0n, 1n], def = 0n }
      ## Matched rather than `get_or`'d so this module does not depend on
      ## `std::option` — see the note in `sample.mz`'s `one_of`. The `None` arm is
      ## unreachable because the draw starts at zero, which is why it answers `0n`
      ## rather than branching on something that cannot happen.
      else match nat::from_int { n = choose { bound = int_max } } is
        Some { val } -> val
        None -> 0n
}

