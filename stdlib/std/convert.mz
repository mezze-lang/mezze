# std/convert.mz - Generic conversion abilities
#
# Provides generic type conversion abilities similar to Rust's From/Into/TryFrom/TryInto.
# These are fundamental building blocks used throughout the stdlib.
#
# Example:
#   # Infallible conversion
#   impl From for Str Int where {
#       from = {} -> int::to_str {n = it}
#   }
#   let s: Str = 42.from {}
#
#   # Fallible conversion
#   impl TryFrom for Int ParseError Str where {
#       try_from = {} -> int::parse {val = it}
#   }
#   let n: Result Int ParseError = "42".try_from {}

use std::int
use std::float
use std::collections::bytes

# =============================================================================
# INFALLIBLE CONVERSIONS
# =============================================================================

# Convert from type 'a to type 'b (infallible)
# Like Rust's From trait
ability From 'b for 'a where {
    from: {} -> 'b
}

# Convert to type 'b from type 'a (infallible)
# Like Rust's Into trait - typically auto-derived from From
ability To 'b for 'a where {
    to: {} -> 'b
}

# =============================================================================
# FALLIBLE CONVERSIONS
# =============================================================================

# Fallible conversion from type 'a to type 'b
# Like Rust's TryFrom trait
ability TryFrom 'b 'err for 'a where {
    try_from: {} -> Result 'b 'err
}

# Fallible conversion to type 'b from type 'a
# Like Rust's TryInto trait
ability TryTo 'b 'err for 'a where {
    try_to: {} -> Result 'b 'err
}

# =============================================================================
# COMMON IMPLEMENTATIONS
# =============================================================================

# Identity conversions
impl From for 'a 'a where {
    from = {} -> it
}

impl To for 'a 'a where {
    to = {} -> it
}

# Int -> Str
impl To for Str Int where {
    to = {} -> int::to_str {n = it}
}

# Float -> Str
impl To for Str Float where {
    to = {} -> float::to_str {n = it}
}

# Bool -> Str
impl To for Str Bool where {
    to = {} -> if it then "True" else "False"
}

# Str -> Bytes
impl To for Bytes Str where {
    to = {} -> bytes::from_string {s = it}
}

# Note: TryFrom Bytes Str is defined in std/codec/core.mz
# to avoid circular dependencies (it uses DecodeError)
