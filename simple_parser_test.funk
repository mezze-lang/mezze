# Simple Parser Completeness Test - Core Features Only

# Module system
mod utils
access utils::add

# Type declarations
expose type Color = | Red, Blue, Green |
expose type Person = { name: String, age: Int }

# Let bindings
expose let greeting = "Hello, World!"
let count = 42
let isActive = true
let pi = 3.14159

# Lambda expressions
let add = { x, y } -> x + y
let multiply = { x, y } -> x * y

# Record operations
let person = { name = "Alice", age = 30 }
let updated = person { age = 31 }
let personName = person.name

# Variant operations
let red = Red
let blue = Blue

# Function calls
let sum = add { x = 5, y = 3 }

# Binary operations
let arithmetic = 10 + 5 * 2
let comparison = 10 > 5
let stringConcat = "Hello" ++ " " ++ "World"

# If expressions
let result = if true then "yes" else "no"

# Pattern matching
let colorName = match red {
  Red -> "red"
  Blue -> "blue"
  Green -> "green"
}

# Do expressions
let computation = do
  let x = 10
  let y = 20
  x + y

# Block expressions  
let blockResult = do
  let a = 5
  let b = 10
  a * b

# Pipe expressions
let piped = 10 |> { x } -> x * 2

# All literal types
let intVal = 42
let floatVal = 3.14
let stringVal = "test"
let boolVal = true
