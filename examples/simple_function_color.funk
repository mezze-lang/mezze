# Simple function that adds numbers and returns a color based on result
# Simplified to work with current parser capabilities

let addNumbers = { x, y } -> x + y

let result1 = addNumbers { x = 8, y = 5 }
let result2 = addNumbers { x = 3, y = 4 }

let color1 = if result1 == 13 then "Red" else "Blue"
let color2 = if result2 == 7 then "Blue" else "Red"

let final = color1 ++ " and " ++ color2
