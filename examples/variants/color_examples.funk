// Variant Examples with Colors

// Simple color function using pattern matching
let addColor = {x, y, color} -> match color {
  Red -> x + y
  Blue {val} -> val * 2
  Yellow -> x * y
  _ -> 0
}

// Using the function
let result1 = addColor {x = 4, y = 5, color = Red}
let result2 = addColor {x = 4, y = 5, color = Blue {val = 10}}
let result3 = addColor {x = 4, y = 5, color = Yellow}

// More complex variant matching
let processColor = {color} -> match color {
  Red -> "Primary: Red"
  Blue {val} -> "Primary: Blue with value " ++ val
  Yellow -> "Primary: Yellow"
}
