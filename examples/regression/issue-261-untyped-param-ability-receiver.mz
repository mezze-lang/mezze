use std::effects::log::{ Console, println }
ability Describe for 'a where { describe: { it: 'a } -> Str }
impl Describe for Int where { describe = { it } -> "an int" }
impl Describe for Str where { describe = { it } -> "a string" }

## HOF with a DECLARED callback type. `f`'s param is pushed to { x: Int }.
let apply: { f: { x: Int } -> Str } -> Str = { f } -> f { x = 7 }

let main = {} -> perform Console in do
  ## untyped callback `{ x } -> ...`; x's type is PUSHED from apply's { x: Int }.
  ## x used as ability receiver — the #261 crash locus.
  let r = apply { f = { x } -> Describe.describe { it = x } }
  println { msg = "result: $(r)" }
