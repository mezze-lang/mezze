# Multiple Patterns with | Operator
# Demonstrates grouping patterns for cleaner code

# Traffic light states
type TrafficLight = | Red, Yellow, Green |

# Group similar cases with |
let canGo = {light: TrafficLight} -> match light is
  Green -> "Go!"
  Yellow | Red -> "Stop!"

# HTTP status codes
type HttpStatus = | Ok, Created, NotFound, ServerError, BadRequest |

# Group successful vs error statuses
let isSuccess = {status: HttpStatus} -> match status is
  Ok | Created -> true
  NotFound | ServerError | BadRequest -> false

# More complex grouping with data
type Weather = | Sunny { temp: Int }, Rainy { temp: Int }, Cloudy, Snowy { temp: Int } |

let needsJacket = {weather: Weather} -> match weather is
  Sunny { temp } | Rainy { temp } | Snowy { temp } if temp < 15 -> "Yes, wear a jacket"
  Sunny { temp } | Rainy { temp } | Snowy { temp } -> "No jacket needed"
  Cloudy -> "Maybe bring a light jacket"

# Priority levels
type Priority = | Low, Medium, High, Critical, Emergency |

let urgencyLevel = {priority: Priority} -> match priority is
  Low | Medium -> "Normal processing"
  High | Critical | Emergency -> "Urgent attention required"

# Testing the functions
let trafficResult = canGo {light = Yellow}
let statusResult = isSuccess {status = Created} 
let weatherResult = needsJacket {weather = Sunny {temp = 10}}

# Result showing multiple pattern matching
"Traffic: " ++ trafficResult ++ ", Weather advice: " ++ weatherResult
