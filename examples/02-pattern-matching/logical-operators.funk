# Logical Operators in Guards
# Demonstrates && and || operators in guard conditions

# Grade calculation with complex conditions
type Score = | Score { points: Int, bonus: Int } |

let calculateGrade = {score: Score} -> match score is
  Score { points, bonus } if points >= 90 && bonus >= 5 -> "A+ (Excellent with bonus!)"
  Score { points, bonus } if points >= 90 && bonus >= 0 -> "A (Excellent)"
  Score { points, bonus } if points >= 80 && points < 90 -> "B (Good)"
  Score { points, bonus } if points >= 70 && points < 80 -> "C (Satisfactory)"
  Score { points, bonus } if points < 60 || bonus < 0 -> "F (Failing or penalty)"
  Score { points, bonus } -> "D (Needs improvement)"

# Event handling with multiple conditions
type Event = | Click { x: Int, y: Int, button: String } |

let handleClick = {event: Event} -> match event is
  Click { x, y, button } if (x >= 0 && x <= 100) && (y >= 0 && y <= 50) && button == "left" -> "Button area clicked"
  Click { x, y, button } if (x < 0 || x > 200) || (y < 0 || y > 200) -> "Click outside bounds"
  Click { x, y, button } if button == "right" || button == "middle" -> "Special button clicked"
  Click { x, y, button } -> "Regular click at (" ++ intToString {val = x} ++ ", " ++ intToString {val = y} ++ ")"

# User validation with complex logic
type User = | User { name: String, age: Int, verified: Boolean, premium: Boolean } |

let getUserAccess = {user: User} -> match user is
  User { name, age, verified, premium } if age >= 18 && verified && premium -> 
    name ++ " has full premium access"
  User { name, age, verified, premium } if age >= 18 && verified -> 
    name ++ " has standard verified access"
  User { name, age, verified, premium } if age >= 13 && (verified || premium) -> 
    name ++ " has limited access"
  User { name, age, verified, premium } if age < 13 || (!verified && !premium) -> 
    name ++ " has restricted access"
  User { name, age, verified, premium } -> 
    name ++ " has basic access"

# Weather decision making
type Weather = | Weather { temp: Int, humidity: Int, windSpeed: Int } |

let outdoorActivity = {weather: Weather} -> match weather is
  Weather { temp, humidity, windSpeed } if (temp >= 20 && temp <= 25) && humidity < 60 && windSpeed < 15 -> 
    "Perfect weather for outdoor activities!"
  Weather { temp, humidity, windSpeed } if (temp < 10 || temp > 35) || humidity > 80 || windSpeed > 30 -> 
    "Stay indoors - weather is too extreme"
  Weather { temp, humidity, windSpeed } if temp >= 15 && temp <= 30 -> 
    "Good weather for light outdoor activities"
  Weather { temp, humidity, windSpeed } -> 
    "Weather is okay but not ideal for outdoor activities"

# Testing complex logical conditions
let studentScore = calculateGrade {score = Score {points = 92, bonus = 6}}
let clickEvent = handleClick {event = Click {x = 50, y = 25, button = "left"}}
let userAccess = getUserAccess {user = User {name = "Alice", age = 25, verified = true, premium = true}}
let weatherAdvice = outdoorActivity {weather = Weather {temp = 22, humidity = 45, windSpeed = 8}}

# Result
"Grade: " ++ studentScore ++ " | Weather: " ++ weatherAdvice
