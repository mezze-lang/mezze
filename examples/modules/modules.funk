# Rust-Style Module System Example

# Declare submodules
mod math_utils
mod string_utils

# Import specific functions
access math_utils::add
access math_utils::multiply
access string_utils::concat

# Private helper function
let square = { x: Int } -> x * x

# Public functions using Rust-style expose prefix
expose let add = { x: Int, y: Int } -> x + y
expose let multiply = { x: Int, y: Int } -> x * y
expose let factorial = { n: Int } -> n  # Simplified for demo

expose let concat = { a: String, b: String } -> a ++ b
let length = { s: String } -> 0  # Private - not exposed

# Using imported functions
let result = add { x = 5, y = 10 }
let product = multiply { x = 3, y = 4 }
let joined = concat { a = "Hello", b = "World" }
