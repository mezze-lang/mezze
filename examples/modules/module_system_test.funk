# Rust-Style Module System Comprehensive Test

# Declare submodules
mod math_utils
mod data_types
mod graphics

# Import specific items
access math_utils::square
access math_utils::add
access data_types::Person
access data_types::Point

# Math utilities with expose prefix
expose let PI = 3  # Simplified to Int for now
expose let square = { x: Int } -> x * x
expose let add = { x: Int, y: Int } -> x + y
let private_helper = { x: Int } -> x * 2  # Not exposed

# Data types with expose prefix
expose type Person = { name: String, age: Int }
expose type Point = { x: Int, y: Int }

expose let createPerson = { name: String, age: Int } -> { name = name, age = age }

# Graphics types
expose type Circle = { radius: Int, center: Point }
expose type Rectangle = { width: Int, height: Int }

expose let circleArea = { c: Circle } -> 3 * c.radius * c.radius  # Simplified PI

# Color types
expose type Color = | Red, Green, Blue |

expose let rgb = { r: Int, g: Int, b: Int } -> "RGB(" ++ "values" ++ ")"

# Test basic usage
let testSquare = square { x = 5 }
let testAdd = add { x = 3, y = 7 }
let testPerson = createPerson { name = "Alice", age = 30 }

let result1 = testSquare   # Should be 25
let result2 = testAdd     # Should be 10
