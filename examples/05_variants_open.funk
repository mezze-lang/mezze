# Example: Open variants
# Open variants can be extended with wildcard patterns

use std::effects::log::{Log, Console}

# Define a basic Message variant (open)
type Message = | Text { content: String }, Number { value: Int }, ... |

# Process known message types with wildcard for unknown
let process_message = { msg: Message } ->
    match msg is
      Text { content } -> "Got text: $(content)"
      Number { value } -> "Got number"
      _ -> "Unknown message type"

let msg1 = Text { content = "Hello" }
let msg2 = Number { value = 42 }

let result1 = process_message { msg = msg1 }
let result2 = process_message { msg = msg2 }

# Handle specific cases with wildcard fallback
type Status = | Active, Inactive, ... |

let is_active = { status: Status } ->
    match status is
      Active -> true
      _ -> false

let active = Active
let inactive = Inactive

let check1 = is_active { status = active }
let check2 = is_active { status = inactive }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Open Variants Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Message processing:" }
        Log.println { msg = "  $(result1)" }
        Log.println { msg = "  $(result2)" }
        Log.println { msg = "" }

        Log.println { msg = "Status checks:" }
        Log.println { msg = "  Active: $(if check1 then "true" else "false")" }
        Log.println { msg = "  Inactive: $(if check2 then "true" else "false")" }
