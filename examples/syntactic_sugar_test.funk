# Pure Lambda Function Test

# All functions are lambdas
let square = { n: Int } -> n * n
let add = { x: Int, y: Int } -> x + y
let greet = { name: String, age: String } -> "Hello, " ++ name ++ "! You are " ++ age ++ " years old."

# Lambda syntax with explicit types
let multiply = { x: Int, y: Int } -> x * y

# Multi-line lambda with do block
let complexCalc = { a: Int, b: Int, c: Int } -> do
  let temp1 = a * b
  let temp2 = temp1 + c
  temp2 / 2

# Resume statements (for effect handlers)
let exampleHandler = do
  let value = 42
  value

# Test function calls
let result1 = square { n = 5 }
let result2 = add { x = 10, y = 20 }
let result3 = greet { name = "Alice", age = "25" }
let result4 = multiply { x = 3, y = 7 }
let result5 = complexCalc { a = 2, b = 4, c = 6 }
