# Example: Open records
# Open records can accept additional fields beyond those specified

use std::int
use std::effects::log::{Log, Console}

# Function that works with any record that has 'name' field
let greet = { person: { name: String, ... } } ->
    "Hello, " ++ person.name ++ "!"

# Works with records that have extra fields
let alice = { name = "Alice", age = 30 }
let bob = { name = "Bob", age = 25, email = "bob@example.com" }

let alice_greeting = greet { person = alice }
let bob_greeting = greet { person = bob }

# Function that extracts common fields
let get_name_and_age = { p: { name: String, age: Int, ... } } ->
    { name = p.name, age = p.age }

# Works with records with different extra fields
let person1 = { name = "Charlie", age = 35, city = "NYC" }
let person2 = { name = "Diana", age = 28, country = "USA", zip = 10001 }

let extracted1 = get_name_and_age { p = person1 }
let extracted2 = get_name_and_age { p = person2 }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Open Records Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Greetings (works with any record with 'name'):" }
        Log.println { msg = "  " ++ alice_greeting }
        Log.println { msg = "  " ++ bob_greeting }
        Log.println { msg = "" }

        Log.println { msg = "Extracted common fields:" }
        Log.println { msg = "  " ++ extracted1.name ++ ": " ++ int::to_string { val = extracted1.age } }
        Log.println { msg = "  " ++ extracted2.name ++ ": " ++ int::to_string { val = extracted2.age } }
