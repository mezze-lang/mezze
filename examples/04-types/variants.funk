# Variant Types in Funk
# Algebraic data types for modeling different states

# Simple enumeration variant
type Color = | Red, Green, Blue |

let primaryColor = Red
let secondaryColor = Green

# Variant with associated data
type Shape = | Circle { radius: Int }, Rectangle { width: Int, height: Int }, Triangle { base: Int, height: Int } |

# Calculate area for different shapes
let calculateArea = {shape: Shape} -> match shape is
  Circle { radius } -> 3 * radius * radius  # π ≈ 3
  Rectangle { width, height } -> width * height
  Triangle { base, height } -> (base * height) / 2

# Result types for error handling
type Result = | Success { value: String }, Error { message: String } |

let divide = {a, b} -> 
  if b == 0 
  then Error { message = "Cannot divide by zero" }
  else Success { value = intToString {val = a / b} }

# Option types for nullable values
type Option = | Some { value: Int }, None |

let safeDivide = {a, b} -> 
  if b == 0 
  then None
  else Some { value = a / b }

# State machine with variants
type ConnectionState = | Disconnected, Connecting, Connected { sessionId: String }, Failed { error: String } |

let handleConnection = {state} -> match state is
  Disconnected -> "Ready to connect"
  Connecting -> "Establishing connection..."
  Connected { sessionId } -> "Connected with session: " ++ sessionId
  Failed { error } -> "Connection failed: " ++ error

# Testing variant functions
let circleArea = calculateArea {shape = Circle { radius = 3 }}
let divisionResult = divide {a = 10, b = 2}
let safeDivisionResult = safeDivide {a = 10, b = 0}
let connectionStatus = handleConnection {state = Connected { sessionId = "abc123" }}

# Pattern matching with variants
let resultMessage = match divisionResult is
  Success { value } -> "Division result: " ++ value
  Error { message } -> "Error occurred: " ++ message

# Result
"Circle area: " ++ intToString {val = circleArea} ++ ", " ++ resultMessage
