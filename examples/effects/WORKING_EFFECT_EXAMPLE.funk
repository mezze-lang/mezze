# ✅ WORKING EFFECT EXAMPLE

# 1. Effect = Interface (what operations exist)
effect Log {
  print : {msg: String} -> {}
}

# 2. Implementation = Record of Functions  
impl Log for Console {
  print : {msg: String} -> {} = {msg} -> {}
}

# 3. Effect Call with Handler
let result = handle Log.print {msg = "Hello World!"} with Console

result
