# Concurrent Effects Demo

# Declare concurrent effects
effect Concurrent {
  par : {computations: List<{} -> 'a <'effects>}} -> List<'a> <'effects>
  race : {computations: List<{} -> 'a <'effects>}} -> 'a <'effects>
}

# Declare HTTP effects
effect AsyncHTTP {
  fetch : {url: String} -> String
  post : {url: String, body: String} -> String
}

# Implementations
impl AsyncHTTP for HttpClient {
  fetch : {url: String} -> String = {url} ->
    native_async_http_get {url = url}
  
  post : {url: String, body: String} -> String = {url, body} ->
    native_async_http_post {url = url, body = body}
}

impl Concurrent for VirtualThreads {
  par : {computations: List<{} -> 'a <'effects>}} -> List<'a> <'effects> = {computations} ->
    native_parallel_execute {computations = computations}
  
  race : {computations: List<{} -> 'a <'effects>}} -> 'a <'effects> = {computations} ->
    native_race_execute {computations = computations}
}

# Concurrent web scraping
let scrapeUrls : {urls: List<String>} -> List<String> <AsyncHTTP, Concurrent> = {urls} ->
  Concurrent.par {
    computations = urls.map {url -> {} -> AsyncHTTP.fetch {url = url}}
  }

# Race for fastest response
let fastestResponse : {urls: List<String>} -> String <AsyncHTTP, Concurrent> = {urls} ->
  Concurrent.race {
    computations = urls.map {url -> {} -> AsyncHTTP.fetch {url = url}}
  }

# Test concurrent execution
let urls = ["http://api1.com", "http://api2.com", "http://api3.com"]

let allResponses = handle scrapeUrls {urls = urls} with HttpClient, VirtualThreads
let firstResponse = handle fastestResponse {urls = urls} with HttpClient, VirtualThreads

allResponses
