# Built-in Effects Test

# 1. Declare effects that will use native implementations
effect Log {
  print : {msg: String} -> {}
  debug : {msg: String} -> {}
}

effect Random {
  nextInt : {min: Int, max: Int} -> Int
  nextDouble : {} -> Float
}

# 2. Implementations using native handlers (these will be built-in)
impl Log for NativeConsole {
  print : {msg: String} -> {} = {msg} -> native_print {msg = msg}
  debug : {msg: String} -> {} = {msg} -> native_debug {msg = msg}
}

impl Random for NativeRandom {
  nextInt : {min: Int, max: Int} -> Int = {min, max} -> native_random_int {min = min, max = max}
  nextDouble : {} -> Float = {} -> native_random_double {}
}

# 3. Test the effects
let test_logging = {name} ->
  do
    Log.print {msg = "Hello " + name}
    Log.debug {msg = "Debug message"}
    "Logging complete"

let test_random = {} ->
  do
    let num = Random.nextInt {min = 1, max = 10}
    let decimal = Random.nextDouble {}
    num

# 4. Execute with native handlers
let log_result = handle test_logging {name = "World"} with NativeConsole
let random_result = handle test_random {} with NativeRandom

log_result
