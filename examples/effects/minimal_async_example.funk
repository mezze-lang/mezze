# Minimal Working Async Effect Example

# 1. Declare a simple effect
effect Log {
  print : {msg: String} -> {}
}

# 2. Implementation as a record of functions
impl Log for Console {
  print : {msg: String} -> {} = {msg} -> {}  # Simple unit return
}

# 3. Pure function (no effects)
let add = {x, y} -> x + y

# 4. Effectful function (uses Log effect)
let loggedAdd : {x: Int, y: Int} -> Int <Log> = {x, y} ->
  do
    Log.print {msg = "Computing sum"}
    let result = add {x = x, y = y}
    Log.print {msg = "Done"}
    result

# 5. Execute with handler
let result = handle loggedAdd {x = 5, y = 3} with Console

result
