# Simple working effect system demo

# Declare a Log effect
effect Log {
  log : {msg: String} -> {}
}

# Implementation for Console logging
impl Log for Console {
  log : {msg: String} -> {} = {msg} -> {}
}

# Pure function (no effects)
let pureAdd = {x, y} -> x + y

# Test the pure function
let result1 = pureAdd {x = 10, y = 20}

result1
