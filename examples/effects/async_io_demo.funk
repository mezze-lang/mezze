# Async I/O Effect System Demo

# Declare async I/O effects
effect AsyncIO {
  readFile : {path: String} -> String
  writeFile : {path: String, content: String} -> {}
}

# Implementation using virtual threads
impl AsyncIO for FileSystem {
  readFile : {path: String} -> String = {path} -> 
    # This will suspend the virtual thread during I/O
    native_async_read_file {path = path}
  
  writeFile : {path: String, content: String} -> {} = {path, content} ->
    # This will also suspend during I/O
    native_async_write_file {path = path, content = content}
}

# Pure function for processing content
let processContent : {content: String} -> String = {content} ->
  "Processed: " + content

# Effectful function that uses async I/O
let fileProcessor : {inputPath: String, outputPath: String} -> {} <AsyncIO> = {inputPath, outputPath} ->
  do
    let content = AsyncIO.readFile {path = inputPath}     # Suspension point 1
    let processed = processContent {content = content}    # Pure computation
    AsyncIO.writeFile {path = outputPath, content = processed}  # Suspension point 2

# Execute with async handler
let result = handle fileProcessor {inputPath = "input.txt", outputPath = "output.txt"} with FileSystem

result
