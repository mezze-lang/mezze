# Example: Array operations
# Shows working with arrays using stdlib functions

use std::int
use std::collections::array
use std::effects::log::{Log, Console}

# Array operations
let numbers = [1, 2, 3, 4, 5]

# Map: transform each element
let doubled = array::map { xs = numbers, f = { x } -> x * 2 }

# Filter: keep only elements matching predicate
let evens = array::filter { xs = numbers, p = { x } -> x % 2 == 0 }

# Fold: reduce to single value
let sum = array::fold { xs = numbers, init = 0, f = { acc, x } -> acc + x }

# Length
let length = array::length { xs = numbers }

# Get element
let third = array::get { xs = numbers, i = 2 }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Array Operations Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Original array: [1, 2, 3, 4, 5]" }
        Log.println { msg = "Length: $(int::to_string { val = length })" }
        Log.println { msg = "" }

        Log.println { msg = "Map (x * 2):" }
        let str = int::to_string { val = doubled }
        Log.println { msg = "  Result: $(str)" }
        Log.println { msg = "" }

        Log.println { msg = "Filter (evens only):" }
        let str2 = int::to_string { val = evens }
        Log.println { msg = "  Result: $(str2)" }
        Log.println { msg = "" }

        Log.println { msg = "Fold (sum):" }
        Log.println { msg = "  Result: $(int::to_string { val = sum })" }
        Log.println { msg = "" }

        Log.println { msg = "Get element at index 2:" }
        Log.println { msg = "  Result: $(int::to_string { val = third })" }
