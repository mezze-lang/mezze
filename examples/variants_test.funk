# Variant Types and Pattern Matching Test

# Sum type definition
type Result = | Ok { value: Int }, Error { message: String } |

# Simple variant type
type Color = | Red, Green, Blue |

# Create variant instances
let success = Ok { value = 42 }
let failure = Error { message = "Something went wrong" }
let myColor = Red

# Pattern matching
let handleResult = { result: Result } ->
  match result {
    Ok { value } -> "Success"
    Error { message } -> "Error"
  }

let describeColor = { color: Color } ->
  match color {
    Red -> "It's red"
    Green -> "It's green"
    Blue -> "It's blue"
  }
