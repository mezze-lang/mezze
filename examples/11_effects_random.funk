# Example: Random effect
# Shows random number generation with seeded handler for reproducibility

use std::int
use std::effects::random::{Random, SeededRandom}
use std::effects::log::{Log, Console}

# Function that generates random numbers
let generate_random_values = {} -> do
    let int_val = Random.random_int { min = 1, max = 100 }
    let bool_val = Random.random_bool { }
    let float_val = Random.random_float { }

    { int_val = int_val, bool_val = bool_val, float_val = float_val }

# Function that simulates a coin flip game
let coin_flip_game = { guesses: Int } ->
    if guesses <= 0 then
        "Game over!"
    else do
        let result = Random.random_bool { }
        if result then
            "You win!"
        else
            coin_flip_game { guesses = guesses - 1 }

# Main function for execution
let main = {} ->
    perform Console in
    perform SeededRandom { seed = 42 } in do
        Log.println { msg = "=== Random Effect Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Random values (seed = 42):" }
        let values = generate_random_values { }
        Log.println { msg = "  Random int (1-100): $(int::to_string { val = values.int_val })" }
        Log.println { msg = "  Random bool: $(if values.bool_val then "true" else "false")" }
        Log.println { msg = "" }

        Log.println { msg = "Coin flip game:" }
        let game_result = coin_flip_game { guesses = 3 }
        Log.println { msg = "  $(game_result)" }
