# Lambda Functions and Function Calls

# Simple lambda
let add = {x, y} -> x + y

# Lambda with typed parameters
let multiply = {x: Int, y: Int} -> x * y

# Function calls
let sum = add {x = 5, y = 3}
let product = multiply {x = 4, y = 6}

# Higher-order functions
let applyTwice = {f, x} -> f {x = f {x = x}}
let double = {x} -> x * 2
let result = applyTwice {f = double, x = 5}
