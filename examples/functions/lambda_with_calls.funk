# Lambda Functions with Function Calls

let add = { x: Int, y: Int } -> x + y
let multiply = { a: Int, b: Int } -> a * b
let greet = { name: String } -> "Hello, " ++ name ++ "!"

# Function calls (should work the same as before)
let sum = add { x = 5, y = 10 }
let product = multiply { a = 3, b = 4 }
let greeting = greet { name = "Alice" }

# Partial application should still work
let add5 = add { x = 5 }
let result = add5 { y = 7 }
