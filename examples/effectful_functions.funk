# Effectful Function Type Signatures Examples

# Effects declarations
effect ReadFile : { path: String } -> | Ok { content: String }, NotFound |
effect WriteFile : { path: String, content: String } -> | Ok, Error { message: String } |
effect Log : { message: String } -> | Ok |

# Abilities declarations
ability Console where
    print : { text: String } -> | Ok |
    readLine : {} -> | Ok { input: String } |

ability Database where
    query : { sql: String } -> | Ok { rows: String }, Error { message: String } |
    insert : { table: String, data: String } -> | Ok { id: Int }, Error { message: String } |

# Functions with effect type annotations
let readConfig : { path: String } -> | Ok { config: String }, NotFound | [ReadFile] =
    ReadFile { path = path }

let writeLog : { message: String } -> | Ok | [Log] = 
    Log { message = message }

let copyFile : { src: String, dest: String } -> | Ok, NotFound, Error { message: String } | [ReadFile, WriteFile] = {
    let readResult = ReadFile { src = src }
    match readResult {
        Ok { content } -> 
            let writeResult = WriteFile { path = dest, content = content }
            match writeResult {
                Ok -> Ok
                Error { message } -> Error { message = message }
            }
        NotFound -> NotFound
    }
}

let processUser : { id: Int } -> | Ok { user: String }, Error { message: String } | [Database, Log] = {
    Log { message = "Processing user " ++ id }
    let result = Database.query { sql = "SELECT * FROM users WHERE id = " ++ id }
    match result {
        Ok { rows } -> 
            Log { message = "Found user: " ++ rows }
            Ok { user = rows }
        Error { message } ->
            Log { message = "Database error: " ++ message }
            Error { message = message }
    }
}

let interactiveApp : {} -> | Ok | [Console, Database, Log] = {
    Console.print { text = "Welcome to the app!" }
    let inputResult = Console.readLine {}
    match inputResult {
        Ok { input } ->
            Log { message = "User input: " ++ input }
            let dbResult = Database.query { sql = "SELECT * FROM data WHERE name = '" ++ input ++ "'" }
            match dbResult {
                Ok { rows } -> 
                    Console.print { text = "Found: " ++ rows }
                    Ok
                Error { message } ->
                    Console.print { text = "Error: " ++ message }
                    Ok
            }
    }
}

# Higher-order functions with effects
let withLogging : { operation: {} -> | a | [E], message: String } -> | a | [Log, E] = { operation, message } -> {
    Log { message = "Starting: " ++ message }
    let result = operation {}
    Log { message = "Completed: " ++ message }
    result
}

let safeOperation : { operation: {} -> | a | [E] } -> | Ok { value: a }, Error { message: String } | [E] = { operation } -> {
    # This would need proper error handling in real implementation
    let result = operation {}
    Ok { value = result }
}

# Function composition with effects
let loggedFileRead : { path: String } -> | Ok { content: String }, NotFound | [ReadFile, Log] = { path } -> {
    Log { message = "Reading file: " ++ path }
    let result = ReadFile { path = path }
    match result {
        Ok { content } ->
            Log { message = "Successfully read " ++ path }
            Ok { content = content }
        NotFound ->
            Log { message = "File not found: " ++ path }
            NotFound
    }
}

# Polymorphic effects
let processMany : { items: String, processor: { item: String } -> | a | [E] } -> | Ok | [E] = { items, processor } -> {
    # Conceptual processing of multiple items
    let result = processor { item = items }
    Ok
}
