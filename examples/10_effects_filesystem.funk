# Example: FileSystem effect
# Shows how to use filesystem operations with effects

use std::effects::filesystem::{FileSystem, MemoryFS}
use std::effects::log::{Log, Console}

# Function that writes and reads a file
let file_operations = {} -> do
    # Write to a file
    FileSystem.write_file { path = "test.txt", content = "Hello from Funk!" }

    # Read the file back
    let content = FileSystem.read_file { path = "test.txt" }

    # Write another file
    FileSystem.write_file { path = "data.txt", content = "Important data" }

    # Check if file exists
    let exists = FileSystem.file_exists { path = "test.txt" }

    { content, exists }

# Main function for execution
let main = {} ->
    perform Console in
    perform MemoryFS in do
        Log.println { msg = "=== FileSystem Effect Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Performing file operations..." }
        let result = file_operations { }

        Log.println { msg = "File content: $(result.content)" }
        Log.println { msg = "File exists: $(if result.exists then "true" else "false")" }
