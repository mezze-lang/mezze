# Comments and Documentation in Funk

# This is a single-line comment
# Comments start with # and continue to the end of the line

# You can use comments to explain your code
let meaningOfLife = 42  # The answer to everything

# Multi-line explanations can use multiple comment lines:
# This function demonstrates how to document
# your code effectively in Funk programs
# Always explain the 'why', not just the 'what'

let documentedValue = "Well documented code"

# Comments can be used for:
# 1. Explaining complex logic
# 2. Providing context for decisions
# 3. Adding examples of usage
# 4. Noting TODOs or future improvements

# TODO: Add more sophisticated commenting features
# NOTE: Comments are ignored by the compiler

# Use comments to make your code readable
let result = documentedValue ++ " is easier to maintain"

result
