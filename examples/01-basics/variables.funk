# Variables and Data Types in Funk

# String values
let greeting = "Welcome to Funk!"
let language = "Funk Programming Language"

# Integer values  
let year = 2024
let version = 1
let count = 42

# Boolean values
let isAwesome = true
let isComplicated = false

# Float values (if supported)
let pi = 3.14159
let temperature = 23.5

# Expressions with variables
let fullMessage = greeting ++ " You're learning " ++ language
let nextYear = year + 1
let isRecent = year > 2020

# The result
fullMessage
