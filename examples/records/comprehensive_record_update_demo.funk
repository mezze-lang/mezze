# Comprehensive Record Update Demo - All Features

# ========== BASIC RECORD UPDATES ==========

# Closed records - traditional updates only
let person = {name = "Alice", age = 30}
let olderAlice = {person | age = 31, name = "Alice Smith"}

# Open records - updates + extensions
let flexiblePerson = {name = "Bob", age = 25, ...}
let enrichedBob = {flexiblePerson | age = 26, city = "NYC", salary = 75000, department = "Engineering"}

# ========== NESTED RECORD UPDATES ==========

# Closed nested records
let employee = {personal = {name = "Carol", age = 28}, work = {title = "Developer", level = 3}}
let promotedCarol = {employee | work.title = "Senior Developer", work.level = 4}

# Open nested records (with existing fields)
let openEmployee = {info = {name = "Dave", age = 32, active = true}, department = "Backend", ...}
let updatedDave = {openEmployee | info.active = false, location = "Remote", status = "Active"}

# ========== COMPLEX SCENARIOS ==========

# Mixed open/closed with type inference
let config = {server = {port = 8080, host = "localhost"}, features = {cache = true, debug = false, metrics = false}, ...}
let prodConfig = {config | server.port = 443, features.metrics = true, environment = "production"}

# Function working with open records
let addMetadata = {record} -> {record | timestamp = 1234567890, version = "1.0"}
let userRecord = {id = 123, name = "Eve", active = true, ...}
let enrichedUser = addMetadata {record = userRecord}

# ========== ERROR PREVENTION ==========

# These would fail with helpful errors:
# let invalidClosed = {person | salary = 50000}  # Error: Field doesn't exist in closed record
# let invalidType = {flexiblePerson | age = "thirty"}  # Error: Type mismatch

# ========== EMPTY UPDATES ==========

# Empty updates preserve record types
let samePerson = {person | }
let sameFlexible = {flexiblePerson | }

# ========== TYPE PRESERVATION ==========

# Closed records stay closed after updates
let stillClosed = {person | name = "Updated Alice"}

# Open records stay open after updates  
let stillOpen = {flexiblePerson | newField = "added"}

# ========== DEMONSTRATION COMPLETE ==========
# All features working: closed/open records, nested updates, type safety, inference
