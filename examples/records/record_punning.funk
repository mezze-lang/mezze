# Record Punning Examples

# Basic punning
let x = 5
let y = 10
let basic = {x, y}

# Mixed syntax
let name = "Alice"
let age = 30
let mixed = {name, id = 123, age}

# Punning in do blocks
let person = do
  let firstName = "Bob"
  let lastName = "Smith"
  let age = 25
  {firstName, lastName, age}

# Using punned records in functions
let add = { a, b } -> a + b
let a = 5
let b = 10
let result = add {a, b}
