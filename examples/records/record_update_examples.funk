# Record Update Examples - New Syntax

# Basic record update
let person = {name = "Bob", age = 32, city = "London"}
let updatedPerson = {person | age = 35, city = "Amsterdam"}

# Single field update  
let nameChange = {person | name = "Alice"}

# Empty update (returns same record)
let unchanged = {person | }

# Nested record updates
let company = {name = "TechCorp", address = {street = "123 Main St", city = "Boston", zip = "02101"}, employees = 150}

# Update nested fields
let movedCompany = {company | address.city = "New York", address.zip = "10001"}

# Update multiple levels
let expandedCompany = {company | employees = 200, address.street = "456 Broadway", address.city = "San Francisco"}

# Using expressions in updates
let user = {id = 1, score = 100, level = 5}
let leveledUp = {user | score = user.score + 50, level = user.level + 1}

# Complex nested structure (2-level nesting only for now)
let player = {name = "Hero", health = 100, mana = 50}
let world = {time = 0, weather = "sunny"}

# Nested updates work with 2-level paths
let updatedPlayer = {player | health = 80, mana = 40}
let updatedWorld = {world | time = 1}
