// Record Examples

// Simple record
let person = {
  name = "Alice"
  age = 30
  city = "New York"
}

// Record with functions
let calculator = {
  add = {x, y} -> x + y
  multiply = {x, y} -> x * y
}

// Using records
let name = person.name
let sum = calculator.add {x = 10, y = 20}

// Record punning
let x = 42
let y = 24
let point = {x, y}  // Same as {x = x, y = y}
