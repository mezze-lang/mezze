# Advanced Calculator with Pattern Matching
# Demonstrates recursive data structures and complex pattern matching

# Expression type for mathematical operations
type Expr = 
  | Num { value: Int }
  | Add { left: Expr, right: Expr }
  | Mul { left: Expr, right: Expr }
  | Sub { left: Expr, right: Expr }
  | Div { left: Expr, right: Expr }
  |

# Evaluate expressions recursively
let eval = {expr: Expr} -> match expr is
  Num { value } -> value
  Add { left, right } -> eval {expr = left} + eval {expr = right}
  Sub { left, right } -> eval {expr = left} - eval {expr = right}
  Mul { left, right } -> eval {expr = left} * eval {expr = right}
  Div { left, right } -> 
    let rightVal = eval {expr = right}
    if rightVal == 0 
    then 0  # Handle division by zero
    else eval {expr = left} / rightVal

# Pretty print expressions
let printExpr = {expr: Expr} -> match expr is
  Num { value } -> intToString {val = value}
  Add { left, right } -> "(" ++ printExpr {expr = left} ++ " + " ++ printExpr {expr = right} ++ ")"
  Sub { left, right } -> "(" ++ printExpr {expr = left} ++ " - " ++ printExpr {expr = right} ++ ")"
  Mul { left, right } -> "(" ++ printExpr {expr = left} ++ " * " ++ printExpr {expr = right} ++ ")"
  Div { left, right } -> "(" ++ printExpr {expr = left} ++ " / " ++ printExpr {expr = right} ++ ")"

# Expression simplification
let simplify = {expr: Expr} -> match expr is
  # Simplify additions with zero
  Add { left, right } if eval {expr = left} == 0 -> simplify {expr = right}
  Add { left, right } if eval {expr = right} == 0 -> simplify {expr = left}
  
  # Simplify multiplications with zero and one
  Mul { left, right } if eval {expr = left} == 0 || eval {expr = right} == 0 -> Num { value = 0 }
  Mul { left, right } if eval {expr = left} == 1 -> simplify {expr = right}
  Mul { left, right } if eval {expr = right} == 1 -> simplify {expr = left}
  
  # Recursively simplify sub-expressions
  Add { left, right } -> Add { left = simplify {expr = left}, right = simplify {expr = right} }
  Sub { left, right } -> Sub { left = simplify {expr = left}, right = simplify {expr = right} }
  Mul { left, right } -> Mul { left = simplify {expr = left}, right = simplify {expr = right} }
  Div { left, right } -> Div { left = simplify {expr = left}, right = simplify {expr = right} }
  
  # Numbers are already simple
  Num { value } -> expr

# Example expressions
let expr1 = Add { 
  left = Num { value = 5 }, 
  right = Mul { 
    left = Num { value = 3 }, 
    right = Num { value = 2 } 
  } 
}

let expr2 = Div { 
  left = Add { 
    left = Num { value = 10 }, 
    right = Num { value = 5 } 
  }, 
  right = Num { value = 3 } 
}

let expr3 = Mul { 
  left = Num { value = 0 }, 
  right = Add { 
    left = Num { value = 5 }, 
    right = Num { value = 10 } 
  } 
}

# Evaluate expressions
let result1 = eval {expr = expr1}
let result2 = eval {expr = expr2}
let result3 = eval {expr = expr3}

# Simplify expressions
let simplified3 = simplify {expr = expr3}

# Print results
let expr1Str = printExpr {expr = expr1}
let result1Str = intToString {val = result1}

# Result
expr1Str ++ " = " ++ result1Str
