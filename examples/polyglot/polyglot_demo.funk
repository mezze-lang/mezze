# Funk Polyglot Interop Demo
# This demonstrates how Funk can interop with other GraalVM languages

# Simple Funk function that can be called from other languages
let add = { x: Int, y: Int } -> x + y

# Function that works with records
let greet = { person: { name: String, age: Int } } -> 
    "Hello " + person.name + ", you are " + person.age + " years old!"

# Function that returns a record
let createPerson = { name: String, age: Int } -> 
    { name = name, age = age }

# Variant example
type Status = | Success { message: String } | Error { code: Int } |

let processData = { input: String } -> 
    if input == "good" then
        Success { message = "All good!" }
    else
        Error { code = 404 }

# Export these for other languages to use
let main = {
    add = add,
    greet = greet,
    createPerson = createPerson,
    processData = processData
}
