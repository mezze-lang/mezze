# Example: Closed variants
# Closed variants have a fixed set of constructors

use std::float
use std::effects::log::{Log, Console}

# Define a Shape variant (closed)
type Shape = | Circle { radius: Float }, Rectangle { width: Float, height: Float }, Triangle { base: Float, height: Float } |

# Calculate area using pattern matching
let area = { shape: Shape } ->
    match shape is
      Circle { radius } -> 3.14159 * radius * radius
      Rectangle { width, height } -> width * height
      Triangle { base, height } -> 0.5 * base * height

# Create shapes
let circle = Circle { radius = 5.0 }
let rectangle = Rectangle { width = 4.0, height = 6.0 }
let triangle = Triangle { base = 3.0, height = 4.0 }

# Calculate areas
let circle_area = area { shape = circle }
let rectangle_area = area { shape = rectangle }
let triangle_area = area { shape = triangle }

# Result type example (using concrete types)
type DivResult = | DivOk { val: Float }, DivErr { err: String } |

let divide = { a: Float, b: Float } ->
    if b == 0.0 then
        DivErr { err = "Division by zero" }
    else
        DivOk { val = a / b }

let result1 = divide { a = 10.0, b = 2.0 }
let result2 = divide { a = 10.0, b = 0.0 }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Closed Variants Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Shape areas:" }
        Log.println { msg = "  Circle: $(float::to_string { val = circle_area })" }
        Log.println { msg = "  Rectangle: $(float::to_string { val = rectangle_area })" }
        Log.println { msg = "  Triangle: $(float::to_string { val = triangle_area })" }
        Log.println { msg = "" }

        Log.println { msg = "Division results:" }
        let msg1 = match result1 is
          DivOk { val } -> "  10.0 / 2.0 = $(float::to_string { val = val })"
          DivErr { err } -> "  Error: $(err)"
        let msg2 = match result2 is
          DivOk { val } -> "  10.0 / 0.0 = $(float::to_string { val = val })"
          DivErr { err } -> "  Error: $(err)"
        Log.println { msg = msg1 }
        Log.println { msg = msg2 }
