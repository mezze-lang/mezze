# Do Syntax Test

# Helper function for converting integers to strings
let intToString = { n: Int } -> "42"  # Simplified implementation for testing

# Simple lambda without do
let simple = { x: Int } -> x + 1

# Multi-line lambda with do block
let myFunc = { x: Int } -> do
  let y = x + 1
  let z = y * 5
  z / 4

# Complex do block with multiple operations
let processData = { input: String, multiplier: Int } -> do
  let trimmed = input
  let processed = "Processed: " ++ trimmed
  let multiplierStr = intToString { n = multiplier }
  let repeated = processed ++ " x" ++ multiplierStr
  repeated ++ "!"

# Nested do blocks
let complex = { a: Int, b: Int } -> do
  let first = do
    let temp = a * 2
    temp + 5
  let second = b + first
  second * 3

# Test function calls
let result1 = myFunc { x = 10 }
let result2 = processData { input = "hello", multiplier = 3 }
let result3 = complex { a = 2, b = 4 }

