let addAndColor = { x, y } -> {
    let sum = x + y
    if sum > 10 then
        Red { value = sum }
    else
        Blue { value = sum }
}

let result1 = addAndColor { x = 5, y = 8 }
let result2 = addAndColor { x = 3, y = 4 }

let message1 = match result1 {
    Red { value } -> "Red color"
    Blue { value } -> "Blue color"
}

let message2 = match result2 {
    Red { value } -> "Red color"
    Blue { value } -> "Blue color"
}

let final = message1 ++ " and " ++ message2
