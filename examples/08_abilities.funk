# Example: Abilities (type classes/traits)
# Abilities define operations that types must implement

use std::int
use std::effects::log::{Log, Console}

# Define an ability for types that can be shown as strings
ability Show T {
    show: { val: T } -> String
}

# Implement Show for Int
impl Show Int where {
    show = { val } -> int::to_string { val = val }
}

# Implement Show for Boolean
impl Show Boolean where {
    show = { val } -> if val then "true" else "false"
}

# Generic function that works with any type that has Show
let display = { value: 'a } with Show 'a ->
    "Value: " ++ Show.show { val = value }

# Use with different types
let int_display = display { value = 42 }
let bool_display = display { value = true }

# Ability with multiple operations
ability NumOps T {
    add: { l: T, r: T } -> T,
    multiply: { l: T, r: T } -> T,
    zero: T
}

# Generic function using NumOps
let sum_of_squares = { x: 'a, y: 'a } with NumOps 'a -> do
    let x_sq = NumOps.multiply { l = x, r = x }
    let y_sq = NumOps.multiply { l = y, r = y }
    NumOps.add { l = x_sq, r = y_sq }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Abilities Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Show ability:" }
        Log.println { msg = "  " ++ int_display }
        Log.println { msg = "  " ++ bool_display }
        Log.println { msg = "" }

        Log.println { msg = "NumOps ability:" }
        Log.println { msg = "  sum_of_squares(3, 4) = " ++ int::to_string { val = sum_of_squares { x = 3, y = 4 } } }
