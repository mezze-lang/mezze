use std::effects::stm::{ STM, OptimisticSTM, TVar, tvar, deref }
use std::effects::log::{ Console, println }

# Transfer between two accounts atomically
let transfer = { from, to, amount } -> do
  let bal = STM.read { var = from }
  if bal >= amount then do
    STM.write { var = from, val = bal - amount }
    STM.modify { var = to, f = { val } -> val + amount } else {}

let main = {} -> perform Console in do
  let alice = tvar { init = 1000 }
  let bob = tvar { init = 500 }
  let a0 = deref { var = alice }
  let b0 = deref { var = bob }
  println { msg = "Before:" }
  println { msg = "  alice = $(a0.to_dbg {})" }
  println { msg = "  bob   = $(b0.to_dbg {})" }
  perform OptimisticSTM in transfer { from = alice, to = bob, amount = 100 }
  perform OptimisticSTM in transfer { from = alice, to = bob, amount = 200 }
  perform OptimisticSTM in transfer { from = alice, to = bob, amount = 150 }
  let a1 = deref { var = alice }
  let b1 = deref { var = bob }
  println { msg = "After transfers (100 + 200 + 150 = 450):" }
  println { msg = "  alice = $(a1.to_dbg {})" }
  println { msg = "  bob   = $(b1.to_dbg {})" }
  let total = perform OptimisticSTM in do
    let a = STM.read { var = alice }
    let b = STM.read { var = bob }
    a + b
  println { msg = "  total = $(total.to_dbg {}) (should be 1500)" }
