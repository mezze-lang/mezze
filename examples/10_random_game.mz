# 10 — Random Effect + composing effects
#
# SeededRandom provides deterministic randomness — same seed, same results.
# Multiple effects compose by nesting perform blocks.

use std::effects::log::{Console, println}
use std::effects::random::{Random, SeededRandom, random_int, random_float}
use std::collections::seq

let roll_die = {} -> random_int {min = 1, max = 6}

let flip_coin = {} -> do
    let r = random_float {}
    if r < 0.5 then "Heads" else "Tails"

let main = {} ->
    perform Console in do
        println {msg = "--- Dice Rolls (seed=42) ---"}
        let r1 = perform SeededRandom {seed = 42} in roll_die {}
        let r2 = perform SeededRandom {seed = 42} in roll_die {}
        println {msg = "  same seed -> $(r1.to_dbg_str {}), $(r2.to_dbg_str {}) (equal!)"}

        println {msg = "--- Multiple rolls (seed=99) ---"}
        let rolls = perform SeededRandom {seed = 99} in
            seq::map {xs = seq::range {start = 0, end = 5}, f = {x} -> roll_die {}}
        println {msg = "  rolls = $(rolls.to_dbg_str {})"}

        println {msg = "--- Coin Flips (seed=7) ---"}
        let flips = perform SeededRandom {seed = 7} in
            seq::map {xs = seq::range {start = 0, end = 5}, f = {x} -> flip_coin {}}
        println {msg = "  flips = $(flips.to_dbg_str {})"}

        println {msg = "--- Determinism check ---"}
        let a = perform SeededRandom {seed = 123} in random_int {min = 1, max = 1000}
        let b = perform SeededRandom {seed = 123} in random_int {min = 1, max = 1000}
        println {msg = "  seed 123 -> $(a.to_dbg_str {}), $(b.to_dbg_str {}) (equal!)"}
