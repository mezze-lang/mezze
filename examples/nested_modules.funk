# Rust-Style Nested Modules Example

# Declare top-level modules
mod core
mod utils
mod application

# Import from nested modules
access core::http::get
access core::http::post
access core::auth::login
access utils::string_utils::capitalize
access utils::math_utils::square
access application::services::database::findUser

# HTTP utilities
expose let get = { url: String } -> "GET " ++ url
expose let post = { url: String, body: String } -> "POST " ++ url ++ " with " ++ body
expose let put = { url: String, body: String } -> "PUT " ++ url ++ " with " ++ body

# Auth utilities
expose let login = { username: String, password: String } -> "Logged in: " ++ username
expose let logout = { token: String } -> "Logged out: " ++ token
expose let verify = { token: String } -> "Verified: " ++ token

# String utilities
expose let capitalize = { text: String } -> "CAPITALIZED: " ++ text
expose let reverse = { text: String } -> "REVERSED: " ++ text

# Math utilities
expose let square = { x: Int } -> x * x
expose let cube = { x: Int } -> x * x * x
expose let factorial = { n: Int } -> n  # Simplified for demo

# Database utilities
expose let findUser = { id: Int } -> "SELECT * FROM users WHERE id = 123"
expose let createUser = { name: String, email: String } -> "INSERT INTO users (name, email) VALUES (" ++ name ++ ", " ++ email ++ ")"

# Application code using imported functions
let userLogin = login { username = "alice", password = "secret123" }
let userData = get { url = "/users/alice" }
let squaredAge = square { x = 25 }
let factorialResult = factorial { n = 5 }

# Database operations
let user = findUser { id = 123 }
let newUser = createUser { name = "Bob", email = "bob@example.com" }
