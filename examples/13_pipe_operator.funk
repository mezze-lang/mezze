# Example: Pipe Operator and Function Composition
#
# The pipe operator (|>) allows you to write data transformations in a left-to-right
# pipeline style. It's syntactic sugar that gets desugared during parsing.

use std::int
use std::string
use std::collections::array
use std::effects::log::{Log, Console}

# ============================================================================
# Pipe Operator Syntax
# ============================================================================
#
# Syntax: value |> function { param = @ }
#
# The @ placeholder gets replaced with the piped value during parsing.
# This allows you to specify exactly where the value goes in the function call.
#
# Examples:
# - Simple: 5 |> square { x = @ }  becomes  square { x = 5 }
# - Chain: 5 |> add { x = @, y = 10 } |> multiply { x = @, y = 2 }
#          becomes  multiply { x = add { x = 5, y = 10 }, y = 2 }
#
# IMPORTANT: Only ONE @ placeholder is allowed per |> stage.

# ============================================================================
# Using the Pipe Operator
# ============================================================================

let square = { x } -> x * x
let add_ten = { x } -> x + 10
let multiply_by_two = { x } -> x * 2

# Example 1: Simple pipe
let example1 = 5 |> square { x = @ }
# Desugars to: square { x = 5 }
# Result: 25

# Example 2: Chained pipe
let example2 = 5 |> add_ten { x = @ } |> multiply_by_two { x = @ } |> square { x = @ }
# Desugars to: square { x = multiply_by_two { x = add_ten { x = 5 } } }
# Result: ((5 + 10) * 2)^2 = 900

# Example 3: Pipe with multiple parameters
let add = { x, y } -> x + y
let example3 = 5 |> add { x = @, y = 10 } |> multiply_by_two { x = @ }
# Desugars to: multiply_by_two { x = add { x = 5, y = 10 } }
# Result: (5 + 10) * 2 = 30

# ============================================================================
# String transformations with pipe
# ============================================================================

let to_upper = { s } -> string::to_upper { s = s }
let add_prefix = { s } -> ">>> " ++ s

# Using pipe operator
let example4 = "hello" |> to_upper { s = @ } |> add_prefix { s = @ }
# Desugars to: add_prefix { s = to_upper { s = "hello" } }
# Result: ">>> HELLO"

# ============================================================================
# Array transformations with pipe
# ============================================================================

let double_fn = { x } -> x * 2
let is_greater_than_10 = { x } -> x > 10
let add_five = { x } -> x + 5

let example5 = [3, 5, 7, 9, 11]
    |> array::map { xs = @, f = double_fn }
    |> array::filter { xs = @, p = is_greater_than_10 }
    |> array::map { xs = @, f = add_five }
# [3,5,7,9,11] -> [6,10,14,18,22] -> [14,18,22] -> [19,23,27]

# ============================================================================
# Complex pipeline with fold
# ============================================================================

let example6 = [1, 2, 3, 4, 5]
    |> array::map { xs = @, f = { x } -> x * x }
    |> array::filter { xs = @, p = { x } -> x > 5 }
    |> array::fold { xs = @, init = 0, f = { acc, x } -> acc + x }
# [1,2,3,4,5] -> [1,4,9,16,25] -> [9,16,25] -> 50

# ============================================================================
# Main function
# ============================================================================

let main = {} -> do
    Log.println { msg = "=== Pipe Operator Examples ===" }
    Log.println { msg = "" }

    Log.println { msg = "Example 1 - Simple pipe:" }
    Log.println { msg = "  5 |> square { x = @ } = " ++ int::to_string { val = example1 } }
    Log.println { msg = "" }

    Log.println { msg = "Example 2 - Chained pipe:" }
    Log.println { msg = "  5 |> add_ten |> multiply_by_two |> square = " ++
        int::to_string { val = example2 } }
    Log.println { msg = "" }

    Log.println { msg = "Example 3 - Pipe with multiple parameters:" }
    Log.println { msg = "  5 |> add { x = @, y = 10 } |> multiply_by_two = " ++
        int::to_string { val = example3 } }
    Log.println { msg = "" }

    Log.println { msg = "Example 4 - String transformation:" }
    Log.println { msg = "  \"hello\" |> to_upper |> add_prefix = " ++ example4 }
    Log.println { msg = "" }

    Log.println { msg = "Example 5 - Array pipeline:" }
    Log.println { msg = "  [3,5,7,9,11] |> map double |> filter >10 |> map +5" }
    Log.println { msg = "  Result length: " ++ int::to_string { val = array::length { xs = example5 } } }
    Log.println { msg = "" }

    Log.println { msg = "Example 6 - Complex array pipeline:" }
    Log.println { msg = "  [1,2,3,4,5] |> map square |> filter >5 |> fold sum = " ++
        int::to_string { val = example6 } }
    Log.println { msg = "" }

    Log.println { msg = "Pipe operator syntax:" }
    Log.println { msg = "  value |> function { param = @ }" }
    Log.println { msg = "  @ is a placeholder that gets replaced with the piped value" }
    Log.println { msg = "  Only ONE @ placeholder is allowed per |> stage" }
    Log.println { msg = "" }

    Log.println { msg = "The pipe operator is desugared during parsing:" }
    Log.println { msg = "  5 |> add { x = @, y = 10 }  ->  add { x = 5, y = 10 }" }

perform Console in main
