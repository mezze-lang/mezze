# Example: Closed records
# Closed records have a fixed set of fields

use std::int
use std::effects::log::{Log, Console}

# Define a person record (closed)
let person = {
    name = "Alice",
    age = 30,
    email = "alice@example.com"
}

# Access record fields
let person_name = person.name
let person_age = person.age

# Update a record (creates new record)
let older_person = { ...person, age = 31 }

# Nested records
let address = {
    street = "123 Main St",
    city = "Springfield",
    zip = 12345
}

let person_with_address = {
    name = "Bob",
    age = 25,
    address = address
}

# Access nested fields
let city = person_with_address.address.city

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Closed Records Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Original person:" }
        Log.println { msg = "  name: $(person.name)" }
        Log.println { msg = "  age: $(int::to_string { val = person.age })" }
        Log.println { msg = "  email: $(person.email)" }
        Log.println { msg = "" }

        Log.println { msg = "After update:" }
        Log.println { msg = "  age: $(int::to_string { val = older_person.age })" }
        Log.println { msg = "" }

        Log.println { msg = "Nested record:" }
        Log.println { msg = "  name: $(person_with_address.name)" }
        Log.println { msg = "  city: $(city)" }
        Log.println { msg = "  street: $(address.street)" }
