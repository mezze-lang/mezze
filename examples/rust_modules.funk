# Rust-style module system example

# Declare submodules
mod utils
mod data

# Import specific items
access utils::string::capitalize
access data::list::IntList

# Re-export items
expose access utils::math::add

# Use imported items
expose let demo = { text: String } ->
  capitalize { text }

# Use module path directly (when implemented)
expose let demo2 = { text: String } ->
  utils::string::uppercase { text }

expose let numbers = data::list::empty
