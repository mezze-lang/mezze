# Polyglot Interop Examples - Real User Syntax

# ============================================================================
# BASIC FOREIGN CALLS
# ============================================================================

# Simple Python function call
use foreign::python

let result = perform Python where {
  # Inline syntax - most common case
  let arr = python! "numpy.array([1, 2, 3, 4])"
  let sum = python! "numpy.sum($(arr))"  # String interpolation for args
  sum
}

# Explicit call syntax for type safety
let typed_call = perform Python where {
  let data: [Int] = python_call! {
    module = "json",
    function = "loads",
    args = ['[1, 2, 3]']
  }
  data
}

# ============================================================================
# JAVASCRIPT INTEROP
# ============================================================================

use foreign::javascript

let web_scrape = perform JavaScript where {
  # Import JS module
  let cheerio = js_import! "cheerio"

  # Call method on object
  let html = "<html><body><h1>Hello</h1></body></html>"
  let $ = cheerio.load(html)  # Direct method call syntax
  let title = $("h1").text()

  title
}

# Async JavaScript (returns Promise)
let fetch_data: {url: String} -> String <JavaScript> = {url} ->
  # await! converts Promise to Funk value
  let response = await! js! "fetch($(url))"
  let data = await! response.json()
  data

# ============================================================================
# JAVA/JVM INTEROP
# ============================================================================

use foreign::jvm

# Static method call
let uuid = jvm! "java.util.UUID.randomUUID().toString()"

# Create Java object
let create_http_client = perform JVM where {
  let client = jvm_new! {
    class = "java.net.http.HttpClient",
    builder = True  # Use builder pattern
  }
  .version("HTTP_2")
  .followRedirects("NORMAL")
  .build()

  client
}

# Instance method call
let make_request: {url: String} -> String <JVM> = {url} ->
  let client = create_http_client {}
  let request = jvm_new! {
    class = "java.net.http.HttpRequest",
    builder = True
  }
  .uri(jvm! "java.net.URI.create($(url))")
  .GET()
  .build()

  # This is BLOCKING! See blocking I/O section below
  let response = client.send(request, jvm! "java.net.http.HttpResponse.BodyHandlers.ofString()")
  response.body()

# ============================================================================
# TYPE-SAFE FOREIGN DEFINITIONS
# ============================================================================

# Define foreign function with types
foreign python def numpy_sum: {arr: [Float]} -> Float = "numpy.sum"

foreign javascript def fetch: {url: String} -> Promise String = "fetch"

foreign jvm def http_get: {url: String} -> String =
  "java.net.http.HttpClient::newHttpClient"
  |> "send"

# Use like regular Funk functions
let sum1 = perform Python where {
  numpy_sum {arr = [1.0, 2.0, 3.0]}
}

# ============================================================================
# SAFE ERROR HANDLING
# ============================================================================

# Foreign calls can fail - use Result
let safe_python_call: {code: String} -> Result Dynamic PythonError <Python> = {code} ->
  try_python! code  # Returns Result automatically

let example = perform Python where {
  match safe_python_call {code = "1 / 0"} is
    Ok {val} -> "Success: $(val)"
    Err {error} -> "Failed: $(error)"
}

# ============================================================================
# RESOURCE MANAGEMENT
# ============================================================================

# Python context manager (with statement)
let read_file_python: {path: String} -> Result String IOError <Python> = {path} ->
  with_python! {
    resource = python! "open($(path), 'r')",
    action = {file} -> file.read(),
    cleanup = {file} -> file.close()
  }

# Java try-with-resources
let read_file_java: {path: String} -> Result String IOError <JVM> = {path} ->
  with_jvm! {
    resource = jvm_new! {class = "java.io.FileReader", args = [path]},
    action = {reader} -> reader.read(),
    cleanup = {reader} -> reader.close()
  }

# ============================================================================
# CALLBACK INTEGRATION
# ============================================================================

# Pass Funk function to JavaScript callback
let setup_callback = perform JavaScript where {
  let button = js! "document.getElementById('btn')"

  # funk_callback! wraps Funk function for JS
  button.addEventListener("click", funk_callback! {event} ->
    print "Button clicked: $(event.target.id)"
  )
}

# Pass Funk function to Java functional interface
let process_list = perform JVM where {
  let list = jvm! "java.util.Arrays.asList(1, 2, 3, 4)"

  # funk_lambda! creates Java lambda from Funk function
  list.forEach(funk_lambda! {item} ->
    print "Item: $(item)"
  )
}

# ============================================================================
# POLYGLOT COMPOSITION
# ============================================================================

# Use Python for ML, JavaScript for web, Java for systems
let full_stack_app = perform Python, JavaScript, JVM where {
  # 1. Python: Train model
  let model = python! "sklearn.linear_model.LogisticRegression()"
  model.fit([[1], [2], [3]], [0, 1, 0])

  # 2. JavaScript: Fetch data from API
  let response = await! js! "fetch('https://api.example.com/data')"
  let data = await! response.json()

  # 3. Java: Save to database
  let conn = jvm! "java.sql.DriverManager.getConnection($(db_url))"
  let stmt = conn.prepareStatement("INSERT INTO predictions VALUES (?)")

  # 4. Combine: Predict and save
  for item in data do
    let prediction = model.predict([[item.value]])
    stmt.setInt(1, prediction)
    stmt.executeUpdate()
  done
}

# ============================================================================
# MACROS FOR COMMON PATTERNS
# ============================================================================

# Syntactic sugar via macros
macro py! (code: String) {
  perform Python where { python! code }
}

macro js! (code: String) {
  perform JavaScript where { js! code }
}

# Usage - ultra concise
let x = py! "numpy.array([1, 2, 3])"
let y = js! "Math.random()"
