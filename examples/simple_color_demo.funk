# Simple function that adds numbers and returns a color based on result
# This demonstrates the interpreter features we've implemented

let addNumbers = { x, y } -> x + y

let result1 = addNumbers { x = 8, y = 3 }
let result2 = addNumbers { x = 2, y = 4 }

