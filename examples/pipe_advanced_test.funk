# Advanced Pipe Operator Tests
# Testing complex scenarios and edge cases

# Functions with do blocks
let processNumber = { n: Int } -> do
    let doubled = n * 2
    let squared = doubled * doubled
    squared + 1

let processString = { s: String } -> do
    let prefixed = "Processed: " ++ s
    let suffixed = prefixed ++ "!"
    suffixed

# Pipe with do block functions
let result1 = 3 |> processNumber { n = @ }             # Should be 37 ((3*2)² + 1)
let result2 = "test" |> processString { s = @ }        # Should be "Processed: test!"

# Nested function calls in pipe
let addThenSquare = { base: Int, extra: Int } -> do
    let sum = base + extra
    sum * sum

let result3 = 5 |> addThenSquare { base = 3, extra = @ } # Should be 64 ((3+5)²)

# Record operations with pipe
let person = { name = "Alice", age = 30 }
let getAge = { p: { name: String, age: Int } } -> p.age
let incrementAge = { age: Int } -> age + 1

let result4 = person |> getAge { p = @ } |> incrementAge { age = @ } # Should be 31

# Pipe with simpler functions (higher-order functions not fully supported yet)
let increment = { x: Int } -> x + 1
let applyIncrement = { value: Int } -> increment { x = increment { x = value } }

let result5 = 5 |> applyIncrement { value = @ } # Should be 7

# Complex chained operations
let multiStep = { n: Int } -> do
    let step1 = n * 3
    let step2 = step1 + 10
    let step3 = step2 / 2
    step3

let result6 = 4 |> multiStep { n = @ } |> processNumber { n = @ } # Complex chain
