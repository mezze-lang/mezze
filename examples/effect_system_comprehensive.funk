# Comprehensive Effect System Test

# Effect declarations
effect ReadFile : { path: String } -> | Ok { content: String }, NotFound |
effect WriteFile : { path: String, content: String } -> | Ok, PermissionDenied |
effect Log : { msg: String } -> | Ok |

# Ability declarations
ability FileSystem where
    read : { path: String } -> | Ok { content: String }, NotFound |
    write : { path: String, content: String } -> | Ok, PermissionDenied |

ability Console where
    print : { msg: String } -> | Ok |
    readLn : {} -> | Ok { line: String } |

# Functions using effects
let readConfig = { path: String } -> ReadFile { path = path }

let writeLog = { msg: String } -> Log { msg = msg }

let copyFile = { src: String, dest: String } -> do
  let content = read { path = src }
  write { path = dest, content = "copied" }

let interactive = { } -> do
  print { msg = "Enter name:" }
  readLn {}

# Handle expressions
let safeRead = { path: String } -> handle ReadFile { path = path } {
  NotFound -> "Default content"
}

let safeCopy = { src: String, dest: String } -> handle copyFile { src = src, dest = dest } {
  NotFound -> "Source not found"
  PermissionDenied -> "Permission denied"
}
