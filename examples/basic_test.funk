# Basic Funk Language Test
# Simple features that should parse correctly

# Basic let bindings
let x = 42
let message = "Hello, Funk!"
let isReady = true

# Simple function definition
let add = { x: Int, y: Int } -> x + y

# Record literal
let person = { name = "Alice", age = 30 }

# Record access
let personName = person.name

# Record update
let olderPerson = person with { age = 31 }

# If expression
let status = if isReady then "Ready" else "Not ready"

# Function call
let sum = add { x = 5, y = 10 }

# Type declaration
type Person = { name: String, age: Int }

# Simple arithmetic
let result = 10 + 5 * 2
