# Helper function for converting integers to strings (simplified for testing)
let intToString = { n: Int } -> "number"

# Define a new record type for a Person
type Person = { name: String, age: Int }

# Create an instance of the Person record
let person = { name = "Alice", age = 30 }

# Access a field from the record
let name = person.name

# Update a field in the record
let olderPerson = person with { age = 31 }

# Use a do expression to do multiple things
let message = do
    let currentName = olderPerson.name
    let currentAge = olderPerson.age
    "User " ++ currentName ++ " is now 30"
