# Simple Rust-Style Nested Module Test

# Declare nested modules
mod my_project

# Import from nested modules
access my_project::core::add
access my_project::multiply

# Core functionality
expose let add = { x: Int, y: Int } -> x + y

# Project-level functionality  
expose let multiply = { a: Int, b: Int } -> a * b

# Test usage
let sum = add { x = 5, y = 3 }
let product = multiply { a = 4, b = 6 }
