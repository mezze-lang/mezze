# Test file for correct variant usage
# All of these should pass

# ✅ Closed variant - no wildcard needed (all cases covered)
let describeAnimal = { animal: | Cat, Dog, Rat | } ->
  match animal {
    Cat -> "It's Cat"
    Dog -> "It's Dog"
    Rat -> "It's Rat"
  }

# ✅ Open variant - wildcard handles unknown cases
let describeColor = { color } ->
  match color {
    Red -> "It's red"
    Green -> "It's green"
    Blue -> "It's blue"
    _ -> "Unknown color"
  }

# ✅ Closed variant with exact coverage
let describeSize = { size: | S, M, L |} -> 
  match size {
    S -> "Small"
    M -> "Medium"
    L -> "Large"
  }
