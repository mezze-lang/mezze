# Example: Log effect
# Shows how to use the logging effect with different handlers

use std::effects::log::{Log, Console, QuietConsole}

# Function that uses the Log effect
let greet_with_log = { name: String } -> do
    Log.info { msg = "Starting greeting..." }
    Log.debug { msg = "Name parameter: " ++ name }
    let message = "Hello, " ++ name ++ "!"
    Log.println { msg = message }
    Log.info { msg = "Greeting complete!" }

# Function showing different log levels
let demonstrate_log_levels = {} -> do
    Log.trace { msg = "This is a TRACE message" }
    Log.debug { msg = "This is a DEBUG message" }
    Log.info { msg = "This is an INFO message" }
    Log.warn { msg = "This is a WARN message" }
    Log.error { msg = "This is an ERROR message" }

# Main function for execution
let main = {} ->
    perform Console in do
        Log.println { msg = "=== Log Effect Example ===" }
        Log.println { msg = "" }

        Log.println { msg = "Using Console handler:" }
        greet_with_log { name = "Funk" }
        Log.println { msg = "" }

        Log.println { msg = "Different log levels:" }
        demonstrate_log_levels { }
