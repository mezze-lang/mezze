# Test expose declaration parsing

module TestModule where
    expose testFunction
    
    let testFunction = { x: Int } -> x + 1
    let hiddenFunction = { x: Int } -> x + 2

# Try to access both functions
let test1 = testFunction { x = 5 }    # Should work
let test2 = hiddenFunction { x = 3 }  # Should fail if scoping works
