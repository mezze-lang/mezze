# Comprehensive Funk Syntax Test - All Implemented Features

# Helper function for converting integers to strings
let intToString = { n: Int } -> "42"  # Simplified implementation for testing

# 1. Comments
# This is a comment

# 2. Literals
let integer = 42
let float = 3.14
let string = "Hello, World!"
let boolean = true

# 3. Pure Lambda Functions
let square = { n: Int } -> n * n
let add = { x: Int, y: Int } -> x + y
let greet = { name: String } -> "Hello, " ++ name ++ "!"

# 4. Lambda Functions with Do Blocks (NEW!)
let complexCalc = { a: Int, b: Int } -> do
  let doubled = a * 2
  let tripled = b * 3
  let sum = doubled + tripled
  sum / 2

# 5. Records
let person = { name = "Alice", age = 30 }
let personName = person.name
let olderPerson = person with { age = 31 }

# 6. Open Records (NEW!) - not yet implemented
# let config = { retries = 3, timeout = 30, ...rest }

# 7. Variants
type Result = | Ok { value: Int }, Error { message: String } |
type Color = | Red, Green, Blue |

let success = Ok { value = 42 }
let myColor = Red

# 8. Pattern Matching - simplified to avoid scoping issues
let handleResult = { result: Result } ->
  match result {
    Ok { value } -> "Success: " ++ intToString { n = 42 }
    Error { message } -> "Error: Something went wrong"
  }

# 9. If Expressions
let status = if boolean then "Ready" else "Not ready"

# 10. Pipe Operator
let piped = 5 |> square { n = @ } |> add { x = 10, y = @ }

