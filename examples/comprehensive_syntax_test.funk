# 14. Resume Statements (NEW!) - simplified for now
let exampleResume = do
  let value = 42
  value

# 15. Function Calls and Partial Application
let result1 = square { n = 5 }
let result2 = add { x = 10, y = 20 }
let result3 = greet { name = "Bob" }
let add5 = add { x = 5 }
let result4 = add5 { y = 15 }

# 16. Complex Do Blocks with Nested Operations
let processData = { input: String, multiplier: Int } -> do
  let trimmed = input
  let processed = "Processed: " ++ trimmed
  let multiplied = do
    let temp = multiplier * 2
    temp + 1
  processed ++ " (x" ++ intToString { n = multiplied } ++ ")"
