# Simple Pattern Matching Test

expose type Color = | Red, Blue, Green |

let red = Red
let person = { name = "Alice", age = 30 }

# Variable pattern binding
let colorVar = match red {
  color -> "matched color"
}

# Record pattern matching
let personInfo = match person {
  { name, age } -> name ++ " is years old"
}

# Wildcard pattern
let isRed = match red {
  Red -> true
  _ -> false
}
