# Comprehensive JavaScript Compiler Test

# Basic types and literals
let number = 42
let text = "hello"
let flag = true

# Records
let person = { name = "Alice", age = 30 }
let updated = person { age = 31 }

# Variants
expose type Color = | Red, Blue { intensity: Int }, Green |
let red = Red
let blue = Blue { intensity = 80 }

# Functions
let add = { x, y } -> x + y
let multiply = { x: Int, y: Int } -> x * y

# Pattern matching
let colorName = match red {
  Red -> "red"
  Blue { intensity } -> "blue with " ++ "intensity"
  Green -> "green"
  _ -> "unknown"
}

# Complex pattern matching with records
let describe = match person {
  { name, age } -> name ++ " is " ++ "years old"
}

# If expressions
let result = if true then "yes" else "no"

# Do expressions
let computation = do
  let x = 10
  let y = 20
  x + y

# Pipe expressions with placeholder
let piped = 10 |> { x } -> x * 2 |> { y } -> y + 1

# Binary operations
let arithmetic = 10 + 5 * 2
let comparison = 10 > 5
let stringConcat = "Hello" ++ " " ++ "World"

# Function calls
let sum = add { x = 5, y = 3 }
let product = multiply { x = 4, y = 6 }

# Member access
let personName = person.name
let personAge = updated.age
