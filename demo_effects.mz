use std::effects::log::{ Log, Console, QuietConsole }
use std::effects::filesystem::{ FileSystem, LocalDisk, MemoryFS }
use std::int

# Create a greeting message
let create_greeting = { name } -> "Hello, $(name)! Welcome to Mezze programming."

# Process and log a greeting
let process_greeting = { name } -> do
  Log.info { msg = "Processing greeting..." }
  let greeting = create_greeting { name = name }
  Log.println { msg = "Generated greeting:" }
  Log.println { msg = greeting }
  Log.info { msg = "Greeting processed successfully!" }

let calculate_sum = { a, b } -> do
  Log.debug { msg = "Starting calculation..." }
  let result = a + b
  Log.info { msg = "Result: $(int::to_str { val = result })" }
  result

let write_greeting_to_file = { filename, content } -> do
  Log.info { msg = "Writing to file: $(filename)" }
  FileSystem.write_file { path = filename, content = content }
  Log.info { msg = "File written successfully!" }

let demo = {} -> do
  Log.println { msg = "=== Mezze Effects Demo ===" }
  Log.println { msg = "" }
  Log.println { msg = "Demo 1: Greeting Processing" }
  process_greeting { name = "Mezze Developer" }
  Log.println { msg = "" }
  Log.println { msg = "Demo 2: Calculation" }
  Log.println { msg = "Calculating 42 + 58..." }
  let sum = calculate_sum { a = 42, b = 58 }
  Log.println { msg = int::to_str { val = sum } }
  Log.println { msg = "Demo 3: FileSystem Effect" }
  let greeting = create_greeting { name = "World" }
  write_greeting_to_file { filename = "./mezze_greeting.txt", content = greeting }
  Log.println { msg = "" }
  Log.println { msg = "Demo 4: Log Levels" }
  Log.trace { msg = "This is a trace message" }
  Log.debug { msg = "This is a debug message" }
  Log.info { msg = "This is an info message" }
  Log.warn { msg = "This is a warning message" }
  Log.error { msg = "This is an error message" }
  Log.println { msg = "" }
  Log.println { msg = "=== Demo Complete ===" }

let main = {} -> perform LocalDisk in perform Console in demo {}
